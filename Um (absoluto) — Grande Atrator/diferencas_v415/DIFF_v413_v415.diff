+def _v414_clear_provisional():
+    """Before anything changes: a provisional object of an earlier run is dropped, and the seal shown by an earlier run is
+    moved aside (never deleted), so it cannot stand beside outputs that this run is about to rewrite."""
+    globals()["_V414_T0"] = time.time()
+    # the seal and every output of the contract are moved aside (never deleted): what stands in the folder when the seal is
+    # closed was produced in this run. The program itself stays; so does the canonical form, which is also read as an input.
+    aside = ["um_absoluto_selo.json", "um_absoluto_selo_acom.json"] + [n for n in _V414_SEAL_REQUIRED
+                                                                        if n not in ("um.py", "um_absoluto_forma_canonica.md")]
+    dest = lambda name, st: os.path.join(OUT, "%s.anterior_%s%s" % (os.path.splitext(name)[0], st, os.path.splitext(name)[1]))
+    stamp = "%s_%d" % (time.strftime("%Y%m%d_%H%M%S"), os.getpid())
+    n_ = 0
+    while any(os.path.exists(dest(x, stamp)) for x in aside):
+        n_ += 1
+        stamp = "%s_%d_%d" % (time.strftime("%Y%m%d_%H%M%S"), os.getpid(), n_)   # a name no earlier run used, for every item
+    moved = []
+    for name in aside:
+        p = os.path.join(OUT, name)
+        if os.path.exists(p):
+            os.rename(p, dest(name, stamp))   # rename refuses to overwrite an existing destination
+            moved.append(name)
+    if moved:
+        print("[v414] da rodada anterior, postos de lado: %s" % ", ".join(moved))
+    for p in (_v414_seal_tmp(), _v414_sidecar_tmp(), os.path.join(OUT, "um_absoluto_selo_acom.json.tmp")):   # only after the earlier seal is aside
+        if os.path.exists(p):
+            os.remove(p)

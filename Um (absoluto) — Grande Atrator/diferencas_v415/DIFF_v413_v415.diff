+def _v415_grupo(text_, j_):
+    """v415 -- from the position right after an opening brace, the position right after its matching closing brace (escapes skipped);
+    None if it never closes."""
+    d_ = 1
+    while j_ < len(text_):
+        c_ = text_[j_]
+        if c_ == "\\":
+            j_ += 2
+            continue
+        if c_ == "{":
+            d_ += 1
+        elif c_ == "}":
+            d_ -= 1
+            if d_ == 0:
+                return j_ + 1
+        j_ += 1
+    return None
+

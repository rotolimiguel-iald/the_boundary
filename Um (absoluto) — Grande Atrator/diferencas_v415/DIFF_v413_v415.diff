\n    ∧ ((processoDaTensaoMinima (geraCNF5 595 21) 7 (fun _ => false)).1.isSome\n        = temLuz5 (geraCNF5 595 21)) :=\n  ⟨n5_5, n5_6, n5_7, n5_8⟩\n\nend TGLExt.ABateriaMinimaN5b\n\n',
+    'TGLExt/AVarreduraAmpla1.lean': 'import TGLExt.ABateriaMinimaN5b\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# A varredura ampla I: cinco variáveis, sementes da forma i·331 + 17\n\nA medida `confere s` (o processo da tensão mínima responde com eco exatamente quando a fórmula `geraCNF5 s 21` tem solução) e a\nvarredura das sementes 17, 348, 679, 1010, 1341, 1672, 2003 e 2334: as oito conferem (por `decide`) [REAL]. As pedras\n`AVarreduraAmpla2` e `AVarreduraAmpla3` fazem o mesmo com mais dezesseis sementes da mesma família.\n\n## O que NÃO se afirma\n\n* Que a regra da tensão mínima responda com eco em toda fórmula que tem solução: a bateria é uma amostra, e a\n  fórmula da armadilha do empate (`OMapaDosMuros.phiTrap`) tem solução e nela a regra responde com silêncio.\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AVarreduraAmpla1\n\nopen TGLExt.ABateriaDaParede TGLExt.ABateriaMinimaN5 TGLExt.ATensaoMinima TGLExt.TraducaoTuring\n\n/-- [MEDIDA] A conferência de uma semente: eco ⟺ luz. -/\ndef confere (s : ℕ) : Bool :=\n  (processoDaTensaoMinima (geraCNF5 s 21) 7 (fun _ => false)).1.isSome == temLuz5 (geraCNF5 s 21)\n\n/-- ★★ A varredura I: as sementes 17, 348, 679, 1010, 1341, 1672, 2003, 2334 — todas conferem. -/\ntheorem a_varredura_I_confere :\n    confere 17 ∧ confere 348 ∧ confere 679 ∧ confere 1010\n      ∧ confere 1341 ∧ confere 1672 ∧ confere 2003 ∧ confere 2334 := by\n  decide\n\nend TGLExt.AVarreduraAmpla1\n\n',
+    'TGLExt/AVarreduraAmpla2.lean': 'import TGLExt.AVarreduraAmpla1\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\nnamespace TGLExt.AVarreduraAmpla2\n\nopen TGLExt.ABateriaDaParede TGLExt.ABateriaMinimaN5 TGLExt.ATensaoMinima TGLExt.AVarreduraAmpla1\nopen TGLExt.TraducaoTuring\n\n/-- ★★ A varredura II: oito sementes a mais, todas conferem. -/\ntheorem a_varredura_II_confere :\n    confere 2665\n      ∧ confere 2996\n      ∧ confere 3327\n      ∧ confere 3658\n      ∧ confere 3989\n      ∧ confere 4320\n      ∧ confere 4651\n      ∧ confere 4982\n  := by decide\n\nend TGLExt.AVarreduraAmpla2\n\n',
+    'TGLExt/AVarreduraAmpla3.lean': 'import TGLExt.AVarreduraAmpla1\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\nnamespace TGLExt.AVarreduraAmpla3\n\nopen TGLExt.ABateriaDaParede TGLExt.ABateriaMinimaN5 TGLExt.ATensaoMinima TGLExt.AVarreduraAmpla1\nopen TGLExt.TraducaoTuring\n\n/-- ★★ A varredura III: oito sementes a mais, todas conferem. -/\ntheorem a_varredura_III_confere :\n    confere 5313\n      ∧ confere 5644\n      ∧ confere 5975\n      ∧ confere 6306\n      ∧ confere 6637\n      ∧ confere 6968\n      ∧ confere 7299\n      ∧ confere 7630\n  := by decide\n\nend TGLExt.AVarreduraAmpla3\n\n',
+    'TGLExt/OMapaDosMuros.lean': "import TGLExt.AContagemDaTensaoMinima\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# O mapa dos muros: três fórmulas, duas regras\n\n## O que é\n\nA fórmula da armadilha do empate (`phiTrap`, quatro variáveis): as cinco cláusulas de `phiCE` mais (x₀ ∨ x₂ ∨ x₃) e\n(x₀ ∨ x₂ ∨ ¬x₃). Ela tem solução, e x₀ é falso em toda solução. Os custos de retorno das duas literais de (x₀ ∨ x₁) empatam, e\na ordem da cláusula entrega a escolha a x₀. A regra da máscara com retorno (a morte transversal pela máscara da cláusula, com o\nlado trocado, e no span a literal limpa) é medida nas mesmas fórmulas.\n\n## O que fica provado [REAL] (por `decide`)\n\n1. ★★ `a_medida_a_tensao_minima_e_refutada_pela_armadilha`: a regra da tensão mínima responde com silêncio em `phiTrap`, que\n   tem solução.\n2. ★★ `a_medida_a_mascara_atravessa_as_duas_armadilhas`: a regra da máscara com retorno responde com eco em `phiCE` e em\n   `phiTrap`.\n3. ★★ `a_medida_a_mascara_mora_na_paridade_par`: a regra da máscara responde com silêncio na fórmula de paridade par\n   (`phiFofa2`), que tem solução.\n4. ★★ `o_mapa_dos_muros`: a tabela inteira.\n\n## O que NÃO se afirma\n\n* Que alguma das regras locais medidas responda com eco nas três fórmulas: nenhuma responde.\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OMapaDosMuros\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\nopen TGLExt.AContagemDaTensaoMinima\n\n/-- [MEDIDA] A armadilha do empate: o núcleo escondido guardado por ¬x₀ MAIS o pino por resolução que\nforça x₂ na luz e empata os custos. A luz: (falso, verdadeiro, verdadeiro, falso). -/\ndef phiTrap : CNF 4 :=\n  [[⟨0, true⟩, ⟨1, true⟩],\n   [⟨0, false⟩, ⟨1, true⟩, ⟨2, true⟩],\n   [⟨0, false⟩, ⟨1, true⟩, ⟨2, false⟩],\n   [⟨0, false⟩, ⟨1, false⟩, ⟨2, true⟩],\n   [⟨0, false⟩, ⟨1, false⟩, ⟨2, false⟩],\n   [⟨0, true⟩, ⟨2, true⟩, ⟨3, true⟩],\n   [⟨0, true⟩, ⟨2, true⟩, ⟨3, false⟩]]\n\n/-- [DEF] O laço da máscara com retorno limpo (a morte pela máscara com o filtro do campo): a morte\ntransversal pela máscara com o lado flipado; no span, a literal limpa. -/\ndef lacoMascaraERetorno {n : ℕ} (φ : CNF n) :\n    ℕ → Espectro2 n → (Fin n → Bool) → (Option (Fin n → Bool)) × Espectro2 n\n  | 0, S, x => (if custoCNF φ x = 0 then some x else none, S)\n  | fuel + 1, S, x =>\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\n    if custoCNF φ w = 0 then (some w, S)\n    else\n      let a := eixoDaMorteDe φ w\n      if eixoNoSpanB (S.map Prod.fst) a then\n        match primeiraSemPar φ w with\n        | none => (none, S)\n        | some C =>\n          match literalDoRetornoLimpo φ S C with\n          | none => (none, S)\n          | some l =>\n            let S' := S ++ [(mascaraDeLiteral l, valorDeLiteral l)]\n            lacoMascaraERetorno φ fuel S' (ressurreicaoConstrutiva S')\n      else\n        let S' := S ++ [(a, paridade2 w a + 1)]\n        lacoMascaraERetorno φ fuel S' (ressurreicaoConstrutiva S')\n\n/-- [DEF] O processo da máscara: o campo fala o fecho primeiro; o laço da máscara corre a partir daí. -/\ndef processoMascara {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :=\n  lacoMascaraERetorno φ fuel (fechoDoCampo φ (n + 2) [])\n    (ressurreicaoConstrutiva (fechoDoCampo φ (n + 2) []))\n\n/-- ★★ A regra da tensão mínima responde com silêncio na armadilha do empate, que tem solução: os custos empatam e a\nordem da cláusula entrega a escolha à literal que nenhuma solução aceita. -/\ntheorem a_medida_a_tensao_minima_e_refutada_pela_armadilha :\n    (processoDaTensaoMinima phiTrap 6 (fun _ => false)).1 = none\n    ∧ custoCNF phiTrap (fun i => decide (i = 1) || decide (i = 2)) = 0 := by\n  decide\n\n/-- ★★ **A MÁSCARA ATRAVESSA AS DUAS ARMADILHAS**: a regra da máscara com retorno ecoa no phiCE e no\nphiTrap. -/\ntheorem a_medida_a_mascara_atravessa_as_duas_armadilhas :\n    (processoMascara phiCE 5 (fun _ => false)).1.isSome = true\n    ∧ (processoMascara phiTrap 6 (fun _ => false)).1.isSome = true := by\n  decide\n\n/-- ★★ **A MÁSCARA MORA NA PARIDADE PAR**: a mesma regra cala na fofa2 com a luz existente — o muro da\nparidade par. -/\ntheorem a_medida_a_mascara_mora_na_paridade_par :\n    (processoMascara phiFofa2 6 (fun _ => false)).1 = none\n    ∧ custoCNF phiFofa2 luzFofa2 = 0 := by\n  decide\n\n/-- ★★ **O MAPA DOS MUROS**: a tabela medida inteira — cada regra tem o seu muro, e os muros são\ncomplementares: a máscara morre na paridade par (e atravessa as armadilhas); a tensão mínima morre no\nempate (e atravessa a paridade par e o núcleo escondido). -/\ntheorem o_mapa_dos_muros :\n    ((processoMascara phiFofa2 6 (fun _ => false)).1 = none\n      ∧ (processoMascara phiCE 5 (fun _ => false)).1.isSome = true\n      ∧ (processoMascara phiTrap 6 (fun _ => false)).1.isSome = true)\n    ∧ ((processoDaTensaoMinima phiFofa2 6 (fun _ => false)).1.isSome = true\n      ∧ (processoDaTensaoMinima phiCE 5 (fun _ => false)).1.isSome = true\n      ∧ (processoDaTensaoMinima phiTrap 6 (fun _ => false)).1 = none) := by\n  decide\n\nend TGLExt.OMapaDosMuros\n\n",
+    'TGLExt/APodaFechaOContorno.lean': "import TGLExt.OMapaDosMuros\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# A busca com a poda\n\n## O que é\n\nA busca com volta atrás sobre as portas limpas. Na cláusula sem par, o laço registra a melhor porta limpa (a de tensão mínima)\ne guarda o ponto de escolha (o espectro de antes e as portas restantes). Quando nenhuma porta limpa resta, volta ao ponto mais\nrecente com portas e tenta a próxima; o ponto esgotado sai da pilha; a pilha vazia é o silêncio.\n\n## O que fica provado [REAL]\n\n1. `oMelhorDe`, `limpasDe`, `mesmaLiteral`, `lacoComPoda`, `processoComPoda` [DEF]: a busca.\n2. ★★ `o_eco_da_poda_e_fiel`: a busca só responde com ponto de custo zero.\n3. ★★ `a_medida_a_poda_atravessa_os_tres_muros`: a busca responde com eco em `phiTrap`, `phiCE` e `phiFofa2` (por `decide`).\n4. ★★ `a_medida_a_poda_e_honesta`: a busca responde com silêncio numa fórmula sem solução e com eco nas fórmulas pequenas das\n   pedras anteriores (por `decide`).\n\n## O que NÃO se afirma\n\n* Que a busca responda com eco em toda fórmula que tem solução (que a pilha esgotada só venha quando não há solução): segue\n  [OPEN].\n* Uma cota polinomial para o número de passos: o número de revisões pode crescer com a fórmula, e a cota segue [OPEN].\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.APodaFechaOContorno\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros\n\n/-- [DEF] O melhor de uma lista de literais pelo custo do retorno (o primeiro no empate). -/\ndef oMelhorDe {n : ℕ} (φ : CNF n) (S : Espectro2 n) : List (Literal n) → Option (Literal n) :=\n  fun ls => ls.foldl (fun acc l => match acc with\n    | none => some l\n    | some m => if custoDoRetorno φ S l < custoDoRetorno φ S m then some l else some m) none\n\n/-- [DEF] As portas limpas de uma cláusula morta: retornáveis e não-condenadas pelo campo. -/\ndef limpasDe {n : ℕ} (φ : CNF n) (S : Espectro2 n) (C : Clausula n) : List (Literal n) :=\n  C.filter (fun l => retornoUtil S l && !condenadaNoCampo φ S l)\n\n/-- [DEF] A mesma literal (por campos: a estrutura não tem BEq). -/\ndef mesmaLiteral {n : ℕ} (q r : Literal n) : Bool := (q.var == r.var) && (q.pos == r.pos)\n\n/-- [DEF] **O LAÇO COM A PODA**: a morte registra a melhor porta limpa e empilha o ponto de escolha (o\nespectro de antes, as portas restantes); quando nenhuma porta limpa resta — o detector do\nretorno-silêncio, provado correto —, o processo revisa: volta ao ponto mais recente com portas e tenta a\npróxima; o ponto esgotado sobe; a pilha vazia é o silêncio honesto. -/\ndef lacoComPoda {n : ℕ} (φ : CNF n) :\n    ℕ → Espectro2 n → (Fin n → Bool) → List (Espectro2 n × List (Literal n)) →\n      (Option (Fin n → Bool)) × Espectro2 n\n  | 0, S, x, _ => (if custoCNF φ x = 0 then some x else none, S)\n  | fuel + 1, S, x, pilha =>\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\n    if custoCNF φ w = 0 then (some w, S)\n    else\n      match primeiraSemPar φ w with\n      | none => (none, S)\n      | some C =>\n        match limpasDe φ S C with\n        | [] =>\n          match pilha with\n          | [] => (none, S)\n          | (S', restantes) :: pilha' =>\n            match oMelhorDe φ S' restantes with\n            | some r =>\n              lacoComPoda φ fuel (S' ++ [(mascaraDeLiteral r, valorDeLiteral r)])\n                (ressurreicaoConstrutiva (S' ++ [(mascaraDeLiteral r, valorDeLiteral r)]))\n                ((S', restantes.filter (fun q => !mesmaLiteral q r)) :: pilha')\n            | none =>\n              lacoComPoda φ fuel S' (ressurreicaoConstrutiva S') pilha'\n        | limpas =>\n          match oMelhorDe φ S limpas with\n          | some l =>\n            lacoComPoda φ fuel (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\n              (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\n              ((S, limpas.filter (fun q => !mesmaLiteral q l)) :: pilha)\n          | none => (none, S)\n\n/-- [DEF] O processo com a poda: o campo fala o fecho; o laço com a poda corre da pilha vazia. -/\ndef processoComPoda {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :=\n  let S₀ := fechoDoCampo φ (n + 2) []\n  lacoComPoda φ fuel S₀ (ressurreicaoConstrutiva S₀) []\n\n/-- ★★ **O ECO DA PODA É FIEL**: o laço com a poda só responde com ponto de custo zero — nunca inventa\nluz, revise o que revisar. -/\ntheorem o_eco_da_poda_e_fiel {n : ℕ} (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x w : Fin n → Bool) (pilha : List (Espectro2 n × List (Literal n)))\n      (S' : Espectro2 n),\n      lacoComPoda φ fuel S x pilha = (some w, S') → custoCNF φ w = 0 := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S x w pilha S' h\n    unfold lacoComPoda at h\n    rw [Prod.mk.injEq] at h\n    obtain ⟨h1, -⟩ := h\n    split at h1\n    · rename_i hcond\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · simp at h1\n  | succ f ih =>\n    intro S x w pilha S' h\n    unfold lacoComPoda at h\n    dsimp only [] at h\n    split at h\n    · rename_i hcond\n      rw [Prod.mk.injEq] at h\n      obtain ⟨h1, -⟩ := h\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · split at h\n      · simp at h\n      · split at h\n        · -- o detector: a poda\n          split at h\n          · simp at h\n          · split at h\n            · exact ih _ _ _ _ _ h\n            · exact ih _ _ _ _ _ h\n        · split at h\n          · exact ih _ _ _ _ _ h\n          · simp at h\n\n/-- ★★ O laço com a poda responde com eco na armadilha do empate, em `phiCE` e na fórmula de paridade par; em cada uma\ndelas uma das regras locais responde com silêncio. -/\ntheorem a_medida_a_poda_atravessa_os_tres_muros :\n    (processoComPoda phiTrap 10 (fun _ => false)).1.isSome = true\n    ∧ (processoComPoda phiCE 10 (fun _ => false)).1.isSome = true\n    ∧ (processoComPoda phiFofa2 10 (fun _ => false)).1.isSome = true := by\n  decide\n\n/-- ★★ **A PODA É HONESTA E SÃ**: a insatisfazível cala (a pilha esgota — o campo inteiro varrido), e a\nsanidade segue (a fofa, a cadeia, a phiMedida). -/\ntheorem a_medida_a_poda_e_honesta :\n    (processoComPoda ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 10 (fun _ => false)).1 = none\n    ∧ (processoComPoda phiFofa 10 (fun _ => false)).1.isSome = true\n    ∧ (processoComPoda phiCadeia 10 (fun _ => false)).1.isSome = true := by\n  decide\n\nend TGLExt.APodaFechaOContorno\n\n",
+    'TGLExt/AMedidaDaArvore.lean': "import TGLExt.APodaFechaOContorno\r\nimport TGLExt.ABateriaMinimaN5b\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A medida da árvore: quantas revisões cada fórmula pede\r\n\r\n## O que é\r\n\r\nO laço da busca com a poda, contado: devolve, junto da resposta, o número de revisões (voltas a um ponto de escolha com portas).\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `lacoComPodaC`, `processoComPodaC` [DEF]: o laço contado.\r\n2. ★★ `a_medida_a_arvore_nos_muros`: `phiTrap` pede exatamente uma revisão; `phiCE` e `phiFofa2`, nenhuma (por `decide`).\r\n3. ★★ `a_medida_a_arvore_na_bateria`: nenhuma revisão nas fórmulas pequenas `phiFofa` e `phiCadeia` e em duas fórmulas de\r\n   cinco variáveis (sementes 13, com solução, e 207, sem solução); numa fórmula sem solução de uma variável, o silêncio (por\r\n   `decide`).\r\n4. ★★ `a_medida_o_contado_e_o_simples_concordam`: o laço contado responde com eco em `phiTrap`, `phiCE` e `phiFofa2`, como\r\n   o laço da busca (por `decide`).\r\n\r\n## O que NÃO se afirma\r\n\r\n* Uma cota para o número de revisões em toda fórmula: segue [OPEN].\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMedidaDaArvore\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\r\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\r\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\r\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\r\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\r\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\r\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\r\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\r\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno\r\nopen TGLExt.ABateriaMinimaN5\r\n\r\n/-- [DEF] O laço com a poda, contado: devolve a resposta, o espectro, e o número de revisões (o detector\r\ndo retorno-silêncio disparando com a pilha não-vazia). -/\r\ndef lacoComPodaC {n : ℕ} (φ : CNF n) :\r\n    ℕ → Espectro2 n → (Fin n → Bool) → List (Espectro2 n × List (Literal n)) → ℕ →\r\n      (Option (Fin n → Bool)) × Espectro2 n × ℕ\r\n  | 0, S, x, _, rev => (if custoCNF φ x = 0 then some x else none, S, rev)\r\n  | fuel + 1, S, x, pilha, rev =>\r\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\r\n    if custoCNF φ w = 0 then (some w, S, rev)\r\n    else\r\n      match primeiraSemPar φ w with\r\n      | none => (none, S, rev)\r\n      | some C =>\r\n        match limpasDe φ S C with\r\n        | [] =>\r\n          match pilha with\r\n          | [] => (none, S, rev)\r\n          | (S', restantes) :: pilha' =>\r\n            match oMelhorDe φ S' restantes with\r\n            | some r =>\r\n              lacoComPodaC φ fuel (S' ++ [(mascaraDeLiteral r, valorDeLiteral r)])\r\n                (ressurreicaoConstrutiva (S' ++ [(mascaraDeLiteral r, valorDeLiteral r)]))\r\n                ((S', restantes.filter (fun q => !mesmaLiteral q r)) :: pilha') (rev + 1)\r\n            | none =>\r\n              lacoComPodaC φ fuel S' (ressurreicaoConstrutiva S') pilha' rev\r\n        | limpas =>\r\n          match oMelhorDe φ S limpas with\r\n          | some l =>\r\n            lacoComPodaC φ fuel (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n              (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\r\n              ((S, limpas.filter (fun q => !mesmaLiteral q l)) :: pilha) rev\r\n          | none => (none, S, rev)\r\n\r\n/-- [DEF] O processo com a poda, contado. -/\r\ndef processoComPodaC {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :=\r\n  let S₀ := fechoDoCampo φ (n + 2) []\r\n  lacoComPodaC φ fuel S₀ (ressurreicaoConstrutiva S₀) [] 0\r\n\r\n/-- [MEDIDA] As revisões pedidas por uma fórmula: o terceiro componente do processo contado. -/\r\ndef revisoesPedidas {n : ℕ} (φ : CNF n) (fuel : ℕ) : ℕ :=\r\n  (processoComPodaC φ fuel (fun _ => false)).2.2\r\n\r\n/-- ★★ **A ÁRVORE NOS MUROS**: as revisões pedidas pelas três paredes — a poda trabalha exatamente onde o\r\ncampo a guarda. -/\r\ntheorem a_medida_a_arvore_nos_muros :\r\n    revisoesPedidas phiTrap 12 = 1\r\n    ∧ revisoesPedidas phiCE 12 = 0\r\n    ∧ revisoesPedidas phiFofa2 12 = 0 := by\r\n  decide\r\n\r\n/-- ★★ **A ÁRVORE NA BATERIA**: as revisões numa amostra da bateria (a fofa, a cadeia, duas da varredura,\r\na insatisfazível): a morte certa não pede poda nos casos fáceis. -/\r\ntheorem a_medida_a_arvore_na_bateria :\r\n    revisoesPedidas phiFofa 12 = 0\r\n    ∧ revisoesPedidas phiCadeia 12 = 0\r\n    ∧ revisoesPedidas (geraCNF5 13 21) 12 = 0\r\n    ∧ revisoesPedidas (geraCNF5 207 21) 12 = 0\r\n    ∧ (processoComPodaC ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 12 (fun _ => false)).1 = none := by\r\n  decide\r\n\r\n/-- ★★ A consistência: o laço contado e o laço simples respondem o mesmo nos muros. -/\r\ntheorem a_medida_o_contado_e_o_simples_concordam :\r\n    (processoComPodaC phiTrap 10 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaC phiCE 10 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaC phiFofa2 10 (fun _ => false)).1.isSome = true := by\r\n  decide\r\n\r\nend TGLExt.AMedidaDaArvore\r\n\r\n",
+    'TGLExt/AFamiliaProfunda.lean': 'import TGLExt.AMedidaDaArvore\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A família de armadilhas profundas: duas medidas\r\n\r\n## O que é\r\n\r\nArmadilhas encadeadas: a k-ésima porta errada ativa o seu núcleo, que o fecho do campo não condena, a porta certa vem por último\r\ne os custos empatam para que a ordem escolha errado k vezes. As fórmulas `phiTrap2` (seis variáveis, profundidade dois) e\r\n`phiTrap3` (oito variáveis, profundidade três), com a solução conferida.\r\n\r\n## O que fica provado [REAL] (por `decide`)\r\n\r\n1. ★★ `a_medida_a_profundidade_dois`: a busca com a poda responde com eco em `phiTrap2` com exatamente duas revisões.\r\n2. ★★ `a_medida_a_profundidade_tres`: a busca responde com eco em `phiTrap3` com exatamente três revisões.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Que o número de revisões cresça linearmente com a profundidade em geral: são duas medidas, de uma família em que as portas de\r\n  cada ponto se esgotam.\r\n* Uma cota para o número de revisões em toda fórmula: segue [OPEN].\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AFamiliaProfunda\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\r\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\r\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\r\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\r\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\r\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\r\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\r\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\r\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\r\n\r\n/-- [MEDIDA] A armadilha de profundidade 2: três portas na cláusula morta — x₀ ativa o núcleo A (em\r\nx₃,x₄), x₁ ativa o núcleo B (em x₄,x₅), x₂ é a certa — mais o pino que força x₃ na luz. A luz: x₂ e x₃\r\nacesas. -/\r\ndef phiTrap2 : CNF 6 :=\r\n  [[⟨0, true⟩, ⟨1, true⟩, ⟨2, true⟩],\r\n   [⟨0, false⟩, ⟨3, true⟩, ⟨4, true⟩],\r\n   [⟨0, false⟩, ⟨3, true⟩, ⟨4, false⟩],\r\n   [⟨0, false⟩, ⟨3, false⟩, ⟨4, true⟩],\r\n   [⟨0, false⟩, ⟨3, false⟩, ⟨4, false⟩],\r\n   [⟨1, false⟩, ⟨4, true⟩, ⟨5, true⟩],\r\n   [⟨1, false⟩, ⟨4, true⟩, ⟨5, false⟩],\r\n   [⟨1, false⟩, ⟨4, false⟩, ⟨5, true⟩],\r\n   [⟨1, false⟩, ⟨4, false⟩, ⟨5, false⟩],\r\n   [⟨0, true⟩, ⟨1, true⟩, ⟨3, true⟩, ⟨5, true⟩],\r\n   [⟨0, true⟩, ⟨1, true⟩, ⟨3, true⟩, ⟨5, false⟩]]\r\n\r\n/-- [MEDIDA] A armadilha de profundidade 3: quatro portas — x₀, x₁, x₂ ativam os seus núcleos, x₃ é a\r\ncerta — mais o pino que força x₄ na luz. A luz: x₃ e x₄ acesas. -/\r\ndef phiTrap3 : CNF 8 :=\r\n  [[⟨0, true⟩, ⟨1, true⟩, ⟨2, true⟩, ⟨3, true⟩],\r\n   [⟨0, false⟩, ⟨4, true⟩, ⟨5, true⟩], [⟨0, false⟩, ⟨4, true⟩, ⟨5, false⟩],\r\n   [⟨0, false⟩, ⟨4, false⟩, ⟨5, true⟩], [⟨0, false⟩, ⟨4, false⟩, ⟨5, false⟩],\r\n   [⟨1, false⟩, ⟨5, true⟩, ⟨6, true⟩], [⟨1, false⟩, ⟨5, true⟩, ⟨6, false⟩],\r\n   [⟨1, false⟩, ⟨5, false⟩, ⟨6, true⟩], [⟨1, false⟩, ⟨5, false⟩, ⟨6, false⟩],\r\n   [⟨2, false⟩, ⟨6, true⟩, ⟨7, true⟩], [⟨2, false⟩, ⟨6, true⟩, ⟨7, false⟩],\r\n   [⟨2, false⟩, ⟨6, false⟩, ⟨7, true⟩], [⟨2, false⟩, ⟨6, false⟩, ⟨7, false⟩],\r\n   [⟨0, true⟩, ⟨1, true⟩, ⟨2, true⟩, ⟨4, true⟩, ⟨7, true⟩],\r\n   [⟨0, true⟩, ⟨1, true⟩, ⟨2, true⟩, ⟨4, true⟩, ⟨7, false⟩]]\r\n\r\n/-- ★★ **A PROFUNDIDADE 2**: a luz existe; a poda ecoa com exatamente 2 revisões — uma por porta\r\nerrada. -/\r\ntheorem a_medida_a_profundidade_dois :\r\n    custoCNF phiTrap2 (fun i => decide (i = 2) || decide (i = 3)) = 0\r\n    ∧ (processoComPodaC phiTrap2 20 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaC phiTrap2 20 (fun _ => false)).2.2 = 2 := by\r\n  decide\r\n\r\n/-- ★★ **A PROFUNDIDADE 3**: a luz existe; a poda ecoa com exatamente 3 revisões — a escalada é linear\r\nnesta família. -/\r\ntheorem a_medida_a_profundidade_tres :\r\n    custoCNF phiTrap3 (fun i => decide (i = 3) || decide (i = 4)) = 0\r\n    ∧ (processoComPodaC phiTrap3 30 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaC phiTrap3 30 (fun _ => false)).2.2 = 3 := by\r\n  decide\r\n\r\nend TGLExt.AFamiliaProfunda\r\n\r\n',
+    'TGLExt/ADescidaPinadaEmMemoria.lean': "import TGLExt.AFamiliaProfunda\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A busca com a poda e o livro das portas\r\n\r\n## O que é\r\n\r\nA busca com a poda (`APodaFechaOContorno`) com um quarto componente no estado: o livro das portas tentadas, o registro global\r\nde cada porta registrada, que só cresce.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `lacoComPodaM`, `processoComPodaM` [DEF]: a busca com o livro.\r\n2. ★ `lacoComPodaM_passo`: o passo ou termina com o livro intacto (eco ou silêncio), ou registra uma porta.\r\n3. ★★ `a_memoria_so_cresce`: o livro ao fim nunca é menor que no início (por indução).\r\n4. ★★ `a_medida_o_livro_e_fino`: o tamanho do livro ao fim, medido por `decide`: três portas em `phiTrap`, quatro e cinco nas\r\n   armadilhas encadeadas de profundidade dois e três, uma ou duas nas fórmulas pequenas.\r\n5. ★★ `a_medida_a_memoria_e_fiel_e_honesta`: com o livro, a busca responde com eco em `phiTrap`, `phiCE`, `phiFofa2` e\r\n   `phiCadeia`, e com silêncio numa fórmula sem solução de uma variável (por `decide`).\r\n\r\n## O que NÃO se afirma\r\n\r\n* Uma cota para o tamanho do livro em toda fórmula: segue [OPEN].\r\n* Que a busca responda com eco em toda fórmula que tem solução: segue [OPEN].\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.ADescidaPinadaEmMemoria\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\r\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\r\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\r\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\r\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\r\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\r\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\r\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\r\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\r\nopen TGLExt.AFamiliaProfunda\r\n\r\n/-- [DEF] **O laço com a poda e o livro da memória**: o quarto componente do estado é o registro global\r\ndas portas tentadas — só cresce. A descida pinada em forma de memória. -/\r\ndef lacoComPodaM {n : ℕ} (φ : CNF n) :\r\n    ℕ → Espectro2 n → (Fin n → Bool) → List (Espectro2 n × List (Literal n)) → List (Literal n) →\r\n      (Option (Fin n → Bool)) × Espectro2 n × List (Literal n)\r\n  | 0, S, x, _, mem => (if custoCNF φ x = 0 then some x else none, S, mem)\r\n  | fuel + 1, S, x, pilha, mem =>\r\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\r\n    if custoCNF φ w = 0 then (some w, S, mem)\r\n    else\r\n      match primeiraSemPar φ w with\r\n      | none => (none, S, mem)\r\n      | some C =>\r\n        match limpasDe φ S C with\r\n        | [] =>\r\n          match pilha with\r\n          | [] => (none, S, mem)\r\n          | (S', restantes) :: pilha' =>\r\n            match oMelhorDe φ S' restantes with\r\n            | some r =>\r\n              lacoComPodaM φ fuel (S' ++ [(mascaraDeLiteral r, valorDeLiteral r)])\r\n                (ressurreicaoConstrutiva (S' ++ [(mascaraDeLiteral r, valorDeLiteral r)]))\r\n                ((S', restantes.filter (fun q => !mesmaLiteral q r)) :: pilha') (r :: mem)\r\n            | none =>\r\n              lacoComPodaM φ fuel S' (ressurreicaoConstrutiva S') pilha' mem\r\n        | limpas =>\r\n          match oMelhorDe φ S limpas with\r\n          | some l =>\r\n            lacoComPodaM φ fuel (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n              (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\r\n              ((S, limpas.filter (fun q => !mesmaLiteral q l)) :: pilha) (l :: mem)\r\n          | none => (none, S, mem)\r\n\r\n/-- [DEF] O processo com a poda e o livro: o campo fala o fecho; o laço corre do livro vazio. -/\r\ndef processoComPodaM {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :=\r\n  let S₀ := fechoDoCampo φ (n + 2) []\r\n  lacoComPodaM φ fuel S₀ (ressurreicaoConstrutiva S₀) [] []\r\n\r\n/-- ★ **O PASSO COM MEMÓRIA, DE UMA VEZ**: o laço ou termina com a memória intacta (eco ou silêncio), ou\r\nsobe sem registrar (a subida sem porta), ou registra uma porta e segue (a morte ou a revisão). -/\r\ntheorem lacoComPodaM_passo {n : ℕ} (φ : CNF n) (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool)\r\n    (pilha : List (Espectro2 n × List (Literal n))) (mem : List (Literal n)) :\r\n    (∃ w : Fin n → Bool, lacoComPodaM φ (fuel + 1) S x pilha mem = (some w, S, mem))\r\n    ∨ (∃ S₁ : Espectro2 n, lacoComPodaM φ (fuel + 1) S x pilha mem = (none, S₁, mem))\r\n    ∨ (∃ (S₁ : Espectro2 n) (x₁ : Fin n → Bool) (pilha₁ : List (Espectro2 n × List (Literal n))),\r\n        lacoComPodaM φ (fuel + 1) S x pilha mem = lacoComPodaM φ fuel S₁ x₁ pilha₁ mem)\r\n    ∨ (∃ (r : Literal n) (S₁ : Espectro2 n) (x₁ : Fin n → Bool)\r\n        (pilha₁ : List (Espectro2 n × List (Literal n))),\r\n        lacoComPodaM φ (fuel + 1) S x pilha mem = lacoComPodaM φ fuel S₁ x₁ pilha₁ (r :: mem)) := by\r\n  rw [lacoComPodaM.eq_def]\r\n  dsimp only []\r\n  split\r\n  · left; exact ⟨_, rfl⟩\r\n  · split\r\n    · right; left; exact ⟨S, rfl⟩\r\n    · split\r\n      · split\r\n        · right; left; exact ⟨S, rfl⟩\r\n        · split\r\n          · rename_i S1 rest pilha1 x2 r hr\r\n            right; right; right\r\n            exact ⟨r, _, _, _, rfl⟩\r\n          · rename_i S1 rest pilha1 x2 hr\r\n            right; right; left\r\n            exact ⟨S1, _, _, rfl⟩\r\n      · split\r\n        · rename_i limpas r hr\r\n          right; right; right\r\n          exact ⟨r, _, _, _, rfl⟩\r\n        · right; left; exact ⟨S, rfl⟩\r\n\r\n/-- ★★ **A MEMÓRIA SÓ CRESCE**: o livro das portas tentadas ao fim nunca é menor que no início — a\r\ndescida pinada em forma de memória, por indução sobre o passo. -/\r\ntheorem a_memoria_so_cresce {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool)\r\n      (pilha : List (Espectro2 n × List (Literal n))) (mem : List (Literal n)),\r\n      ((lacoComPodaM φ fuel S x pilha mem).2.2).length ≥ mem.length := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x pilha mem\r\n    unfold lacoComPodaM\r\n    dsimp only []\r\n    exact Nat.le_refl _\r\n  | succ f ih =>\r\n    intro S x pilha mem\r\n    rcases lacoComPodaM_passo φ f S x pilha mem with ⟨w, h⟩ | ⟨S₁, h⟩ | ⟨S₁, x₁, pilha₁, h⟩\r\n      | ⟨r, S₁, x₁, pilha₁, h⟩\r\n    · rw [h]\r\n    · rw [h]\r\n    · rw [h]; exact ih S₁ x₁ pilha₁ mem\r\n    · rw [h]; have hih := ih S₁ x₁ pilha₁ (r :: mem)\r\n      rw [List.length_cons] at hih\r\n      omega\r\n\r\n/-- [MEDIDA] O tamanho do livro ao fim. -/\r\ndef oLivroAoFim {n : ℕ} (φ : CNF n) (fuel : ℕ) : ℕ :=\r\n  (processoComPodaM φ fuel (fun _ => false)).2.2.length\r\n\r\n/-- ★★ **O LIVRO É FINO**: o número de portas tentadas nos muros e na família profunda — a memória fica\r\nfina onde o campo a guarda. -/\r\ntheorem a_medida_o_livro_e_fino :\r\n    oLivroAoFim phiTrap 12 = 3\r\n    ∧ oLivroAoFim phiTrap2 20 = 4\r\n    ∧ oLivroAoFim phiTrap3 30 = 5\r\n    ∧ oLivroAoFim phiCE 12 = 1\r\n    ∧ oLivroAoFim phiFofa2 12 = 2\r\n    ∧ oLivroAoFim phiFofa 12 = 1 := by\r\n  decide\r\n\r\n/-- ★★ **A MEMÓRIA É FIEL E HONESTA**: com o livro, o eco e o silêncio ficam certos — os três muros\r\necoam, a insatisfazível cala, a cadeia resolve. -/\r\ntheorem a_medida_a_memoria_e_fiel_e_honesta :\r\n    (processoComPodaM phiTrap 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaM phiCE 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaM phiFofa2 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComPodaM ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 12 (fun _ => false)).1 = none\r\n    ∧ (processoComPodaM phiCadeia 12 (fun _ => false)).1.isSome = true := by\r\n  decide\r\n\r\nend TGLExt.ADescidaPinadaEmMemoria\r\n\r\n",
+    'TGLExt/ABateriaSobAMemoria1.lean': 'import TGLExt.ADescidaPinadaEmMemoria\nimport TGLExt.ABateriaMinima3\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# A bateria sob a busca com o livro I\n\nAs quatro fórmulas de três variáveis de `ABateriaDaParede` (sementes 17, 1010, 1341 e 1672), `phiCE`, `phiFofa2`, `phiFofa` e\n`phiCadeia`, sob a busca com a poda e o livro: o processo responde com eco exatamente quando a fórmula tem solução, e responde\ncom silêncio numa fórmula sem solução de uma variável (por `decide`) [REAL].\n\n## O que NÃO se afirma\n\n* Que a busca responda com eco em toda fórmula que tem solução: a bateria é uma amostra, e isso segue [OPEN].\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.ABateriaSobAMemoria1\n\nopen TGLExt.ABateriaDaParede TGLExt.ATensaoMinima TGLExt.AFamiliaProfunda TGLExt.AMedidaDaArvore\nopen TGLExt.ADescidaPinadaEmMemoria TGLExt.OMapaDosMuros TGLExt.TraducaoTuring\nopen TGLExt.ACartografiaDaParede TGLExt.AParedeDoLadoOposto TGLExt.OFechoDoCampo\n\n/-- [MEDIDA] A conferência sob a máquina final. -/\ndef confereM3 (φ : CNF 3) : Bool :=\n  (processoComPodaM φ 12 (fun _ => false)).1.isSome == temLuz φ\n\n/-- ★★ A bateria n = 3 sob a máquina final: as quatro, todas conferem. -/\ntheorem a_bateria_n3_sob_a_memoria :\n    confereM3 (geraCNF3 17 10) ∧ confereM3 (geraCNF3 1010 10)\n      ∧ confereM3 (geraCNF3 1341 10) ∧ confereM3 (geraCNF3 1672 10) := by\n  decide\n\n/-- [MEDIDA] A conferência sob a máquina final, em n = 2. -/\ndef confereM2 (φ : CNF 2) : Bool :=\n  (processoComPodaM φ 12 (fun _ => false)).1.isSome == (cubo 2).any (fun x => decide (custoCNF φ x = 0))\n\n/-- ★★ Os muros e o contraexemplo sob a máquina final: todos com luz, todos com eco. -/\ntheorem os_muros_sob_a_memoria :\n    confereM3 phiCE ∧ confereM3 phiFofa2 ∧ confereM2 phiFofa ∧ confereM3 phiCadeia := by\n  decide\n\n/-- ★★ A honestidade sob a máquina final: a insatisfazível cala. -/\ntheorem a_honestidade_sob_a_memoria :\n    (processoComPodaM ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 12 (fun _ => false)).1 = none := by\n  decide\n\nend TGLExt.ABateriaSobAMemoria1\n\n',
+    'TGLExt/ALeituraCorrespondente.lean': "import TGLExt.ABateriaSobAMemoria1\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# A leitura correspondente: a busca com o livro só responde com um ponto que satisfaz a fórmula\n\n## O que é\n\nA resposta «há solução» da busca com a poda e o livro vem com um ponto. Ela é correspondente quando o ponto satisfaz a fórmula\n(custo zero). Esta pedra prova que toda resposta com ponto é correspondente.\n\n## O que fica provado [REAL]\n\n1. ★★ `o_eco_da_podaM_e_fiel`: o laço com o livro só responde com ponto de custo zero.\n2. ★★ `o_processo_final_so_le_com_correspondencia`: se o processo responde com um ponto, o ponto satisfaz a fórmula.\n3. ★★ `a_leitura_falsa_nunca_acontece`: não há resposta com ponto de custo não nulo.\n\n## O que NÃO se afirma\n\n* Que, havendo solução, a busca responda com ela (a completude), nem em quanto tempo: segue [OPEN].\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.ALeituraCorrespondente\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\nopen TGLExt.AFamiliaProfunda TGLExt.ADescidaPinadaEmMemoria\n\n/-- ★★ **O ECO DO LAÇO COM O LIVRO É FIEL**: só responde com ponto de custo zero. -/\ntheorem o_eco_da_podaM_e_fiel {n : ℕ} (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x w : Fin n → Bool)\n      (pilha : List (Espectro2 n × List (Literal n))) (mem : List (Literal n))\n      (S' : Espectro2 n) (mem' : List (Literal n)),\n      lacoComPodaM φ fuel S x pilha mem = (some w, S', mem') → custoCNF φ w = 0 := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S x w pilha mem S' mem' h\n    unfold lacoComPodaM at h\n    rw [Prod.mk.injEq] at h\n    obtain ⟨h1, -⟩ := h\n    split at h1\n    · rename_i hcond\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · simp at h1\n  | succ f ih =>\n    intro S x w pilha mem S' mem' h\n    unfold lacoComPodaM at h\n    dsimp only [] at h\n    split at h\n    · rename_i hcond\n      rw [Prod.mk.injEq] at h\n      obtain ⟨h1, -⟩ := h\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · split at h\n      · simp at h\n      · split at h\n        · split at h\n          · simp at h\n          · split at h\n            · exact ih _ _ _ _ _ _ _ h\n            · exact ih _ _ _ _ _ _ _ h\n        · split at h\n          · exact ih _ _ _ _ _ _ _ h\n          · simp at h\n\n/-- ★★ **A MÁQUINA FINAL SÓ LÊ COM CORRESPONDÊNCIA**: se o processo responde com o ponto, o ponto serve o\ncampo — a leitura é correspondente, sempre. -/\ntheorem o_processo_final_so_le_com_correspondencia {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool)\n    (w : Fin n → Bool)\n    (h : (processoComPodaM φ fuel x).1 = some w) :\n    custoCNF φ w = 0 := by\n  unfold processoComPodaM at h\n  dsimp only [] at h\n  exact o_eco_da_podaM_e_fiel φ _ _ _ _ _ _ _ _ (Prod.ext_iff.mpr ⟨h, rfl⟩)\n\n/-- ★★ **A LEITURA FALSA NUNCA ACONTECE**: não há ponto devolvido com custo não-zero — a máquina nunca\napresenta `1 = 0 = VERDADEIRO`. -/\ntheorem a_leitura_falsa_nunca_acontece {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :\n    ¬ ∃ w : Fin n → Bool, (processoComPodaM φ fuel x).1 = some w ∧ custoCNF φ w ≠ 0 := by\n  intro ⟨w, h1, h2⟩\n  exact h2 (o_processo_final_so_le_com_correspondencia φ fuel x w h1)\n\nend TGLExt.ALeituraCorrespondente\n\n",
+    'TGLExt/AReversao.lean': "import TGLExt.ABateriaSobAMemoria1\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# A reversão: o registro da busca com o livro não perde o que registra\n\n## O que é\n\nNa busca com a poda e o livro (`ADescidaPinadaEmMemoria`), a morte empilha o ponto de escolha (o espectro e as portas restantes)\ne consigna a porta no livro; a revisão volta ao ponto e registra a porta seguinte. As duas operações acrescentam um elemento à\nfrente de uma lista. Esta pedra prova que esse acréscimo não perde informação: do estado de depois se lê o de antes.\n\n## O que fica provado [REAL]\n\n1. ★★ `a_morte_e_revertivel`: se dois registros da morte dão a mesma pilha e o mesmo livro, o espectro, as portas restantes, a\n   pilha de antes, o livro de antes e a porta coincidem (a injetividade do acréscimo à frente da lista).\n2. ★★ `a_revisao_e_revertivel`: o mesmo para o registro da revisão: a pilha e o livro de depois determinam o espectro ao qual se\n   voltou, a pilha de antes e o livro de antes.\n3. ★★ `a_maquina_nunca_perde_registro`: o enunciado da 1, com o nome da máquina.\n4. ★ `a_superposicao_nao_aloja_maquina`: o espectro vazio e o livro vazio, postos à frente, não acrescentam nem retiram nada\n   (`[] ++ S = S`, `[] ++ mem = mem`): o estado sem registro não tem o que desfazer.\n\nOs três primeiros teoremas usam nenhum axioma.\n\n## O que NÃO se afirma\n\n* Os teoremas falam do acréscimo à pilha e ao livro, não da corrida inteira de `processoComPodaM`: que a corrida inteira seja\n  revertível passo a passo (a descida e o fecho do campo incluídos) não está provado aqui.\n* Que a reversibilidade limite o tempo da busca: não decorre destes teoremas, e não decorre da reversibilidade em geral, porque\n  toda computação pode ser refeita de modo revertível com custo de tempo da mesma ordem [KNOWN: Bennett 1973].\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AReversao\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\nopen TGLExt.AFamiliaProfunda TGLExt.ADescidaPinadaEmMemoria\n\n/-- ★★ **A MORTE É REVERTÍVEL**: o passo do registro (a morte empilha o espectro de antes e consigna a\nporta no livro) é injetivo: dois registros com o mesmo pós-estado tinham o mesmo pré-estado. A pilha\nlembra o espectro de antes; o livro lembra a porta. -/\ntheorem a_morte_e_revertivel {n : ℕ}\n    (S S' : Espectro2 n) (rest rest' : List (Literal n))\n    (pilha pilha' : List (Espectro2 n × List (Literal n)))\n    (l l' : Literal n) (mem mem' : List (Literal n))\n    (hpilha : (S, rest) :: pilha = (S', rest') :: pilha')\n    (hmem : l :: mem = l' :: mem') :\n    S = S' ∧ pilha = pilha' ∧ mem = mem' ∧ rest = rest' ∧ l = l' := by\n  have hp := List.cons.inj hpilha\n  have hm := List.cons.inj hmem\n  obtain ⟨h1, h2⟩ := hp\n  obtain ⟨h3, h4⟩ := hm\n  -- (S, rest) = (S', rest') → S = S' e rest = rest'\n  have hS : S = S' := congrArg Prod.fst h1\n  have hrest : rest = rest' := congrArg Prod.snd h1\n  exact ⟨hS, h2, h4, hrest, h3⟩\n\n/-- ★★ **A REVISÃO É REVERTÍVEL**: o passo da poda (volta ao ponto e registra a porta seguinte) é\ninjetivo: o pós determina o espectro ao que se voltou, a pilha de antes e o livro de antes. -/\ntheorem a_revisao_e_revertivel {n : ℕ}\n    (S1 S1' : Espectro2 n) (rest rest' : List (Literal n))\n    (pilha pilha' : List (Espectro2 n × List (Literal n)))\n    (r r' : Literal n) (mem mem' : List (Literal n))\n    (hpilha : (S1, rest) :: pilha = (S1', rest') :: pilha')\n    (hmem : r :: mem = r' :: mem') :\n    S1 = S1' ∧ pilha = pilha' ∧ mem = mem' := by\n  have hp := List.cons.inj hpilha\n  have hm := List.cons.inj hmem\n  exact ⟨congrArg Prod.fst hp.1, hp.2, hm.2⟩\n\n/-- ★★ **A MÁQUINA NUNCA PERDE O REGISTRADO**: o conteúdo registrado de cada passo é invertível — de todo\npós-estado da pilha e do livro se lê o pré-estado. (O enunciado de `a_morte_e_revertivel`; a corrida inteira não\nestá neste teorema.) -/\ntheorem a_maquina_nunca_perde_registro {n : ℕ}\n    (S S' : Espectro2 n) (rest rest' : List (Literal n))\n    (pilha pilha' : List (Espectro2 n × List (Literal n)))\n    (l l' : Literal n) (mem mem' : List (Literal n))\n    (hpilha : (S, rest) :: pilha = (S', rest') :: pilha')\n    (hmem : l :: mem = l' :: mem') :\n    S = S' ∧ pilha = pilha' ∧ mem = mem' ∧ rest = rest' ∧ l = l' :=\n  a_morte_e_revertivel S S' rest rest' pilha pilha' l l' mem mem' hpilha hmem\n\n/-- ★ **A SUPERPOSIÇÃO NÃO ALOJA MÁQUINA** (a forma registrada): o estado de máquina sem pilha e sem\nlivro não tem o que reverter: o espectro vazio e o livro vazio, postos à frente, não acrescentam nem\nretiram nada. -/\ntheorem a_superposicao_nao_aloja_maquina {n : ℕ} (S : Espectro2 n) (mem : List (Literal n)) :\n    (([] : Espectro2 n) ++ S = S)\n    ∧ (([] : List (Literal n)) ++ mem = mem) := by\n  exact ⟨List.nil_append S, List.nil_append mem⟩\n\nend TGLExt.AReversao\n\n",
+    'TGLExt/OAlgoritmoPenP.lean': "import TGLExt.AReversao\nimport TGLExt.ALeituraCorrespondente\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# O algoritmo: a busca com a poda e o livro, e a luz que ela nunca perde\n\n## O que é\n\n`oAlgoritmo φ fuel x` é a busca com a poda e o livro (`processoComPodaM`, de `ADescidaPinadaEmMemoria`), com o nome do\nalgoritmo: o fecho do campo, a descida fiel até o poço, a morte que registra a porta limpa de tensão mínima e empilha o ponto de\nescolha, o detector do retorno que dispara a revisão, o livro das portas. Ela responde com um ponto (o eco) ou com nada (o\nsilêncio). O combustível `fuel` é o número de passos que ela pode dar.\n\n## O que fica provado [REAL]\n\n1. `serveEq_de_vale`, `serveEspectro2_append_de_vale`: a equação de uma literal vale no ponto em que a literal vale.\n2. `a_primeira_sem_par_mem`, `a_primeira_sem_par_existe`: havendo custo, a primeira cláusula falsificada existe e é da fórmula.\n3. `o_melhor_de_mem`, `o_melhor_de_nao_vazio`, `o_melhor_de_none`: a escolha da tensão mínima devolve um membro da lista, e só\n   falha na lista vazia.\n4. `mesmaLiteral_vale`, `a_porta_viva_sobrevive_ao_filtro`: a porta que vale na solução atravessa o filtro.\n5. ★ `a_porta_da_luz_nas_limpas`: se uma solução serve o espectro e uma cláusula falha no poço, alguma literal dessa cláusula é\n   limpa (retornável e não condenada) e vale na solução.\n6. ★★ `a_porta_limpa_mantem_a_casa`: um espectro habitado (algum ponto o serve) que recebe uma porta retornável continua\n   habitado.\n7. `aLuzDoAlgoritmo` [DEF]: a luz é uma solução que serve o espectro corrente, ou que serve um ponto de escolha da pilha com\n   uma porta restante que vale nela. `EstadoDaLuz` [DEF]: a luz, o poço servindo o espectro, o espectro habitado e a pilha\n   sadia. `a_luz_exige_limpa`: com a luz no espectro e uma cláusula falhando no poço, a lista das portas limpas não é vazia;\n   logo a revisão e a subida, que pedem essa lista vazia, só acontecem sem a luz no espectro corrente.\n8. ★★★ `a_luz_nunca_cala_estacionada`: sob `EstadoDaLuz`, se o laço responde com silêncio, então esse silêncio é o do\n   combustível zero, alcançado num estado em que a luz ainda está presente. A prova mantém o invariante nos quatro movimentos\n   (o eco, a morte, a revisão e a subida).\n9. ★★ `o_algoritmo_nunca_mede_a_escuridao`: se a fórmula tem solução, todo silêncio do algoritmo é o do combustível zero, com a\n   luz presente: o algoritmo nunca responde silêncio por ter esgotado as portas.\n10. ★★ `o_algoritmo_ou_ecoa_ou_guarda_a_luz`: se a fórmula tem solução, o algoritmo ou responde com um ponto que a satisfaz, ou\n    cala no combustível zero com a luz presente.\n11. ★★ `o_algoritmo_so_le_com_correspondencia`: se o algoritmo responde com um ponto, o ponto satisfaz a fórmula.\n12. ★★ `a_medida_o_algoritmo_decide`: por `decide`, o algoritmo responde com um ponto em sete fórmulas com solução (`phiTrap`,\n    `phiCE`, `phiFofa2` e `phiCadeia`, com combustível 12; as armadilhas encadeadas de profundidade dois e três, com 20 e 30;\n    `phiFofa`, com 12) e cala na fórmula sem solução de uma variável.\n\n## O que NÃO se afirma\n\n* Que algum combustível finito baste para o eco em toda fórmula com solução (a terminação): não está provado. O livro registra\n  as portas, mas a busca não o consulta, e uma nova morte no mesmo ponto é possível na dinâmica.\n* Que combustível polinomial no tamanho da fórmula baste: segue [OPEN]. É a cota que separa esta busca da máquina de Turing sem\n  o leitor.\n* Que o silêncio decida a falta de solução: o algoritmo nunca responde «não há solução»; na fórmula sem solução ele cala em todo\n  combustível, e calar com combustível finito só decidiria se a cota acima estivesse provada.\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OAlgoritmoPenP\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\nopen TGLExt.AFamiliaProfunda TGLExt.ADescidaPinadaEmMemoria TGLExt.ALeituraCorrespondente\n\n/-- [DEF] **O ALGORITMO** — a máquina final da casa: o campo fala o fecho; a descida fiel estaciona; a\nmorte registra a porta de tensão mínima e empilha o ponto de escolha; o detector dispara a revisão; o\nlivro guarda as portas. -/\ndef oAlgoritmo {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) := processoComPodaM φ fuel x\n\n/-- A equação da literal é o valor dela: servir a equação é a literal valer. -/\ntheorem serveEq_de_vale {n : ℕ} (l : Literal n) (y : Fin n → Bool)\n    (hly : l.vale y = true) : serveEq y (mascaraDeLiteral l, valorDeLiteral l) := by\n  show paridade2 y (mascaraDeLiteral l) = valorDeLiteral l\n  rw [paridade2_mascaraLiteral]\n  unfold valorDeLiteral\n  unfold Literal.vale at hly\n  rw [beq_iff_eq] at hly\n  rw [hly]\n\n/-- Servir o espectro e a literal valer: o espectro acrescentado é servido. -/\ntheorem serveEspectro2_append_de_vale {n : ℕ} (S : Espectro2 n) (y : Fin n → Bool) (l : Literal n)\n    (hys : serveEspectro2 y S = true) (hly : l.vale y = true) :\n    serveEspectro2 y (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true := by\n  rw [serveEspectro2_append]\n  have h1 : serveEspectro2 y [(mascaraDeLiteral l, valorDeLiteral l)] = true := by\n    unfold serveEspectro2\n    rw [List.all_cons, List.all_nil]\n    show ((paridade2 y (mascaraDeLiteral l) == valorDeLiteral l) && true) = true\n    rw [beq_iff_eq.mpr (serveEq_de_vale l y hly)]\n    rfl\n  rw [h1, hys]\n  rfl\n\n/-- A primeira cláusula sem par é membro da fórmula e falsificada no ponto. -/\ntheorem a_primeira_sem_par_mem {n : ℕ} (φ : CNF n) (x : Fin n → Bool) (C : Clausula n)\n    (h : primeiraSemPar φ x = some C) : C ∈ φ ∧ satisfeita C x = false := by\n  unfold primeiraSemPar at h\n  obtain ⟨hmem, hpred⟩ := encontra_mem _ _ _ h\n  refine ⟨hmem, ?_⟩\n  have hpred' : (!satisfeita C x) = true := hpred\n  cases hs : satisfeita C x with\n  | false => rfl\n  | true => rw [hs] at hpred'; simp at hpred'\n\n/-- Havendo custo, a primeira cláusula sem par existe. -/\ntheorem a_primeira_sem_par_existe {n : ℕ} (φ : CNF n) (x : Fin n → Bool)\n    (h : custoCNF φ x ≠ 0) : (primeiraSemPar φ x).isSome = true := by\n  have hpos : 0 < custoCNF φ x := Nat.pos_of_ne_zero h\n  unfold custoCNF at hpos\n  rw [List.countP_pos_iff] at hpos\n  obtain ⟨C₀, hC₀φ, hC₀sat⟩ := hpos\n  unfold primeiraSemPar\n  rw [List.find?_isSome]\n  exact ⟨C₀, hC₀φ, hC₀sat⟩\n\n/-- A escolha da tensão mínima é membro da lista. -/\ntheorem o_melhor_de_mem {n : ℕ} (φ : CNF n) (S : Espectro2 n) (ls : List (Literal n)) (r : Literal n)\n    (h : oMelhorDe φ S ls = some r) : r ∈ ls := by\n  unfold oMelhorDe at h\n  have hm := foldl_some_mem φ S ls none r h\n  rcases hm with hnone | hmem\n  · simp at hnone\n  · exact hmem\n\n/-- A escolha nunca trava em lista viva. -/\ntheorem o_melhor_de_nao_vazio {n : ℕ} (φ : CNF n) (S : Espectro2 n) (ls : List (Literal n))\n    (hne : ls ≠ []) : (oMelhorDe φ S ls).isSome = true := by\n  obtain ⟨l₀, resto, hl₀⟩ := List.exists_cons_of_ne_nil hne\n  unfold oMelhorDe\n  rw [hl₀, List.foldl_cons]\n  suffices h : ∀ (resto : Clausula n) (acc : Option (Literal n)), acc.isSome = true →\n      ((resto.foldl (fun acc l => match acc with\n          | none => some l\n          | some m => if custoDoRetorno φ S l < custoDoRetorno φ S m then some l else some m)\n        acc).isSome = true) by\n    exact h resto (some l₀) rfl\n  intro resto\n  induction resto with\n  | nil => intro acc hacc; simpa using hacc\n  | cons b bs ih =>\n    intro acc hacc\n    rw [List.foldl_cons]\n    apply ih\n    split\n    · rfl\n    · split\n      · rfl\n      · rfl\n\n/-- A escolha dá none só na lista vazia. -/\ntheorem o_melhor_de_none {n : ℕ} (φ : CNF n) (S : Espectro2 n) (ls : List (Literal n))\n    (h : oMelhorDe φ S ls = none) : ls = [] := by\n  by_contra hne\n  have his := o_melhor_de_nao_vazio φ S ls hne\n  rw [h] at his\n  simp at his\n\n/-- A mesma literal vale igual. -/\ntheorem mesmaLiteral_vale {n : ℕ} (a b : Literal n) (y : Fin n → Bool)\n    (h : mesmaLiteral a b = true) : a.vale y = b.vale y := by\n  unfold mesmaLiteral at h\n  rw [Bool.and_eq_true] at h\n  obtain ⟨hvar, hpos⟩ := h\n  rw [beq_iff_eq] at hvar hpos\n  unfold Literal.vale\n  rw [hvar, hpos]\n\n/-- A porta da luz atravessa o filtro da porta morta: valores diferentes, literais diferentes. -/\ntheorem a_porta_viva_sobrevive_ao_filtro {n : ℕ} (a b : Literal n) (y : Fin n → Bool)\n    (ha : a.vale y = true) (hb : b.vale y = false) : (!mesmaLiteral a b) = true := by\n  cases hm : mesmaLiteral a b with\n  | false => rfl\n  | true =>\n    have h := mesmaLiteral_vale a b y hm\n    rw [ha, hb] at h\n    simp at h\n\n/-- ★ **A PORTA DA LUZ ESTÁ NAS LIMPAS**: com a luz servida no espectro, o poço servindo e a cláusula\nfalhando nele, existe literal da cláusula que é limpa (retornável e não-condenada) E vale na luz. A\nforma que o invariante da luz consome. -/\ntheorem a_porta_da_luz_nas_limpas {n : ℕ} (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool)\n    (C : Clausula n) (hCφ : C ∈ φ)\n    (hpoco : serveEspectro2 w S = true) (hfalha : satisfeita C w = false)\n    (y : Fin n → Bool) (hy0 : custoCNF φ y = 0) (hys : serveEspectro2 y S = true) :\n    ∃ l : Literal n, l ∈ limpasDe φ S C ∧ l.vale y = true := by\n  obtain ⟨l, hlC, hly, hret⟩ := o_sinal_de_retorno_da_luz φ S w C hCφ hpoco hfalha y hy0 hys\n  have hcond : condenadaNoCampo φ S l = false := by\n    by_contra hcon\n    have hcond2 : condenadaNoCampo φ S l = true := by\n      cases hc : condenadaNoCampo φ S l with\n      | true => rfl\n      | false => exact absurd hc hcon\n    have hyserve : serveEspectro2 y (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true :=\n      serveEspectro2_append_de_vale S y l hys hly\n    exact a_condenada_nao_tem_luz φ S l hcond2 ⟨y, hy0, hyserve⟩\n  refine ⟨l, ?_, hly⟩\n  unfold limpasDe\n  rw [List.mem_filter]\n  exact ⟨hlC, by rw [Bool.and_eq_true]; exact ⟨hret, by rw [hcond]; rfl⟩⟩\n\n/-- ★★ **A PORTA LIMPA MANTÉM A CASA** (a consistência da morte da poda): o espectro habitado que recebe\na porta retornável continua habitado. A prova: o ponto construído do escalonado acrescentado serve a\nreduzida (que tem pivô, pelo retorno útil) e os pivôs reduzidos; servindo a reduzida e os pivôs, serve a\nequação nova e o espectro — sem escolha, só leitura. -/\ntheorem a_porta_limpa_mantem_a_casa {n : ℕ} (S : Espectro2 n) (l : Literal n)\n    (hcons : ∃ z : Fin n → Bool, serveEspectro2 z S = true)\n    (hret : retornoUtil S l = true) :\n    ∃ z : Fin n → Bool, serveEspectro2 z (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true := by\n  obtain ⟨y, hyS⟩ := hcons\n  have hyE : serveEspectro2 y (oEscalonado S) = true := (oEscalonado_preserva S y ⟨y, hyS⟩).mpr hyS\n  -- a reduzida tem pivô (o retorno útil)\n  have hpi : (bitPivo (reduzirNova (mascaraDeLiteral l) (valorDeLiteral l) (oEscalonado S)).1).isSome\n      = true := hret\n  obtain ⟨q, hq⟩ := Option.isSome_iff_exists.mp hpi\n  -- o ponto construído do escalonado acrescentado serve-o, incondicionalmente\n  have hiso := oEscalonado_isolada (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\n  have hserve := pontoConstruido_serve _ hiso\n  set p := pontoConstruido (oEscalonado (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])) with hp\n  refine ⟨p, ?_⟩\n  have hpE' : serveEspectro2 p (oEscalonado (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])) = true := by\n    unfold serveEspectro2\n    rw [List.all_eq_true]\n    intro e he\n    exact (beq_iff_eq).mpr (hserve e he)\n  rw [oEscalonado_snoc] at hpE'\n  unfold inserirEscalonado at hpE'\n  dsimp only [] at hpE'\n  rw [hq] at hpE'\n  dsimp only [] at hpE'\n  rw [serveEspectro2_cons'] at hpE'\n  obtain ⟨hpr, hpmap⟩ := hpE'\n  -- servindo a reduzida e os pivôs reduzidos, p serve os pivôs originais\n  have hpE : serveEspectro2 p (oEscalonado S) = true :=\n    (pivos_reduzidos_preserva p _ _ hpr q _).mp hpmap\n  have hpS : serveEspectro2 p S = true := (oEscalonado_preserva S p ⟨y, hyS⟩).mp hpE\n  have hpe : serveEq p (mascaraDeLiteral l, valorDeLiteral l) :=\n    (reduzirNova_preserva p _ hpE _).mp hpr\n  rw [serveEspectro2_append, hpS]\n  unfold serveEspectro2\n  rw [List.all_cons, List.all_nil]\n  show ((paridade2 p (mascaraDeLiteral l) == valorDeLiteral l) && true) = true\n  rw [beq_iff_eq.mpr hpe]\n  rfl\n\n/-- [DEF] **A LUZ DO ALGORITMO** (o invariante da luz): ou a luz serve o espectro corrente, ou mora num\nponto de escolha da pilha, com uma porta viva restante nela. A luz nunca se perde: desce pinada. -/\ndef aLuzDoAlgoritmo {n : ℕ} (φ : CNF n) (S : Espectro2 n)\n    (pilha : List (Espectro2 n × List (Literal n))) : Prop :=\n  (∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true) ∨\n    (∃ e : Espectro2 n × List (Literal n), e ∈ pilha ∧\n      ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y e.1 = true ∧\n        ∃ l : Literal n, l ∈ e.2 ∧ l.vale y = true)\n\n/-- A porta das limpas é retornável. (Auxiliar da sanidade da pilha.) -/\ntheorem retornoUtil_das_limpas {n : ℕ} (φ : CNF n) (S : Espectro2 n) (C : Clausula n) (r : Literal n)\n    (h : r ∈ limpasDe φ S C) : retornoUtil S r = true := by\n  unfold limpasDe at h\n  have h2 := (List.mem_filter.mp h).2\n  rw [Bool.and_eq_true] at h2\n  exact h2.1\n\n/-- Com a luz no espectro e o detector disparado (limpas vazia): contradição — o campo sempre deixa a\nporta da luz aberta. (Auxiliar que fecha os ramos escuros: a máquina só revisa na ausência da luz.) -/\ntheorem a_luz_exige_limpa {n : ℕ} (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool) (C : Clausula n)\n    (hpoco : serveEspectro2 w S = true) (hfalha : satisfeita C w = false) (hCφ : C ∈ φ)\n    (hluz : ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true) :\n    limpasDe φ S C ≠ [] := by\n  intro hv\n  obtain ⟨y, hy0, hys⟩ := hluz\n  obtain ⟨l, hll, _⟩ := a_porta_da_luz_nas_limpas φ S w C hCφ hpoco hfalha y hy0 hys\n  rw [hv] at hll\n  exact List.not_mem_nil hll\n\n/-- [DEF] **O ESTADO DA LUZ** — o invariante completo da máquina: a luz (no espectro ou na pilha); o\nponto servo fiel (o G1); a casa habitada; e as portas da pilha retornáveis nos seus pontos. -/\nstructure EstadoDaLuz {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\n    (pilha : List (Espectro2 n × List (Literal n))) : Prop where\n  luz : aLuzDoAlgoritmo φ S pilha\n  pocoServe : serveEspectro2 x S = true\n  habitada : ∃ z : Fin n → Bool, serveEspectro2 z S = true\n  pilhaSadia : ∀ e : Espectro2 n × List (Literal n), e ∈ pilha →\n    (∃ z : Fin n → Bool, serveEspectro2 z e.1 = true) ∧ (∀ r ∈ e.2, retornoUtil e.1 r = true)\n\n/-- ★★★ **A LUZ NUNCA CALA ESTACIONADA** — o invariante do algoritmo: sob o estado da luz, o silêncio só\nvem do fundo do combustível — e vem com a luz intacta (o invariante mantido até o fim). O algoritmo nunca\nmede a escuridão: ou ecoa com correspondência, ou pede mais combustível. (A manutenção do invariante em\ncada um dos quatro movimentos: o eco, a morte, a revisão, a subida.) Que algum combustível finito baste\nnão está neste teorema. -/\ntheorem a_luz_nunca_cala_estacionada {n : ℕ} (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool)\n      (pilha : List (Espectro2 n × List (Literal n))) (mem : List (Literal n))\n      (S' : Espectro2 n) (mem' : List (Literal n)),\n      EstadoDaLuz φ S x pilha →\n      lacoComPodaM φ fuel S x pilha mem = (none, S', mem') →\n      ∃ (S₀ : Espectro2 n) (x₀ : Fin n → Bool) (pilha₀ : List (Espectro2 n × List (Literal n)))\n        (mem₀ : List (Literal n)),\n        aLuzDoAlgoritmo φ S₀ pilha₀ ∧ lacoComPodaM φ 0 S₀ x₀ pilha₀ mem₀ = (none, S', mem') := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S x pilha mem S' mem' hI h\n    exact ⟨S, x, pilha, mem, hI.luz, h⟩\n  | succ f ih =>\n    intro S x pilha mem S' mem' hI h\n    unfold lacoComPodaM at h\n    dsimp only [] at h\n    split at h\n    · -- o eco: some = none — impossível\n      rw [Prod.mk.injEq] at h\n      obtain ⟨h1, -⟩ := h\n      simp at h1\n    · rename_i hcusto\n      split at h\n      · -- a primeiraSemPar não cala com custo fora do zero\n        rename_i hsem\n        exfalso\n        have his := a_primeira_sem_par_existe φ _ hcusto\n        rw [hsem] at his\n        simp at his\n      · rename_i C hC\n        obtain ⟨hCφ, hCfalha⟩ := a_primeira_sem_par_mem φ _ C hC\n        have hpoco : serveEspectro2 (descerGenerico passoFiel φ S φ.length ([], x)).2 S = true :=\n          o_poco_fiel_serve φ S x hI.pocoServe\n        split at h\n        · -- o detector disparou: limpas vazia — a luz não está no espectro corrente\n          rename_i hlimpas\n          have hescuro : ¬ (∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true) :=\n            fun hluz => a_luz_exige_limpa φ S _ C hpoco hCfalha hCφ hluz hlimpas\n          split at h\n          · -- a pilha vazia: a luz teria de estar no espectro — contradição\n            exfalso\n            cases hI.luz with\n            | inl hluz => exact hescuro hluz\n            | inr hna =>\n              obtain ⟨e, he, -⟩ := hna\n              exact absurd he List.not_mem_nil\n          · -- a pilha com ponto de escolha: a revisão ou a subida\n            rename_i pilha₀ S₁ rest pilha₁\n            have hsadia₁ := hI.pilhaSadia (S₁, rest) List.mem_cons_self\n            split at h\n            · -- ★ A REVISÃO: a próxima porta do ponto de escolha\n              rename_i r hr\n              have hrmem : r ∈ rest := o_melhor_de_mem φ S₁ rest r hr\n              have hcons' := a_porta_limpa_mantem_a_casa S₁ r hsadia₁.1 (hsadia₁.2 r hrmem)\n              have hI' : EstadoDaLuz φ (S₁ ++ [(mascaraDeLiteral r, valorDeLiteral r)])\n                  (ressurreicaoConstrutiva (S₁ ++ [(mascaraDeLiteral r, valorDeLiteral r)]))\n                  ((S₁, rest.filter (fun q => !mesmaLiteral q r)) :: pilha₁) := by\n                refine ⟨?_, ?_, ?_, ?_⟩\n                · cases hI.luz with\n                  | inl hluz => exact absurd hluz hescuro\n                  | inr hna =>\n                    obtain ⟨e, he, y, hy0, hye, l', hl'rest, hl'y⟩ := hna\n                    rw [List.mem_cons] at he\n                    cases he with\n                    | inl heq =>\n                      subst heq\n                      cases hrv : r.vale y with\n                      | true =>\n                        exact Or.inl ⟨y, hy0, serveEspectro2_append_de_vale _ _ r hye hrv⟩\n                      | false =>\n                        have hsob := a_porta_viva_sobrevive_ao_filtro l' r y hl'y hrv\n                        exact Or.inr ⟨(S₁, rest.filter (fun q => !mesmaLiteral q r)),\n                          List.mem_cons_self, y, hy0, hye, l',\n                          List.mem_filter.mpr ⟨hl'rest, hsob⟩, hl'y⟩\n                    | inr htail =>\n                      exact Or.inr ⟨e, List.mem_cons_of_mem _ htail, y, hy0, hye, l', hl'rest, hl'y⟩\n                · exact o_solver_serve _ hcons'\n                · exact hcons'\n                · intro e he\n                  rw [List.mem_cons] at he\n                  cases he with\n                  | inl heq =>\n                    subst heq\n                    refine ⟨hsadia₁.1, ?_⟩\n                    intro r₂ hr₂\n                    exact hsadia₁.2 r₂ (List.mem_filter.mp hr₂).1\n                  | inr htail =>\n                    exact hI.pilhaSadia e (List.mem_cons_of_mem _ htail)\n              exact ih _ _ _ _ _ _ hI' h\n            · -- ★ A SUBIDA: o ponto esgotado sobe — o espectro da cabeça, sem porta nova\n              rename_i hmelhor\n              have hrest : rest = [] := o_melhor_de_none φ S₁ rest hmelhor\n              subst hrest\n              have hI' : EstadoDaLuz φ S₁ (ressurreicaoConstrutiva S₁) pilha₁ := by\n                refine ⟨?_, ?_, ?_, ?_⟩\n                · cases hI.luz with\n                  | inl hluz => exact absurd hluz hescuro\n                  | inr hna =>\n                    obtain ⟨e, he, y, hy0, hye, l', hl'rest, hl'y⟩ := hna\n                    rw [List.mem_cons] at he\n                    cases he with\n                    | inl heq =>\n                      subst heq\n                      simp at hl'rest\n                    | inr htail =>\n                      exact Or.inr ⟨e, htail, y, hy0, hye, l', hl'rest, hl'y⟩\n                · exact o_solver_serve _ hsadia₁.1\n                · exact hsadia₁.1\n                · intro e he\n                  exact hI.pilhaSadia e (List.mem_cons_of_mem _ he)\n              exact ih _ _ _ _ _ _ hI' h\n        · -- ★ A MORTE: a porta limpa de tensão mínima, com o ponto de escolha empilhado\n          rename_i hnn\n          split at h\n          · rename_i l hl\n            have hlmem : l ∈ limpasDe φ S C := o_melhor_de_mem φ S _ l hl\n            have hcons' := a_porta_limpa_mantem_a_casa S l hI.habitada\n              (retornoUtil_das_limpas φ S C l hlmem)\n            have hI' : EstadoDaLuz φ (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\n                (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\n                ((S, (limpasDe φ S C).filter (fun q => !mesmaLiteral q l)) :: pilha) := by\n              refine ⟨?_, ?_, ?_, ?_⟩\n              · cases hI.luz with\n                | inl hluz =>\n                  obtain ⟨y, hy0, hys⟩ := hluz\n                  obtain ⟨l', hl'limpas, hl'y⟩ :=\n                    a_porta_da_luz_nas_limpas φ S _ C hCφ hpoco hCfalha y hy0 hys\n                  cases hlv : l.vale y with\n                  | true =>\n                    exact Or.inl ⟨y, hy0, serveEspectro2_append_de_vale _ _ l hys hlv⟩\n                  | false =>\n                    have hsob := a_porta_viva_sobrevive_ao_filtro l' l y hl'y hlv\n                    exact Or.inr ⟨(S, (limpasDe φ S C).filter (fun q => !mesmaLiteral q l)),\n                      List.mem_cons_self, y, hy0, hys, l',\n                      List.mem_filter.mpr ⟨hl'limpas, hsob⟩, hl'y⟩\n                | inr hna =>\n                  obtain ⟨e, he, y, hy0, hye, l', hl'rest, hl'y⟩ := hna\n                  exact Or.inr ⟨e, List.mem_cons_of_mem _ he, y, hy0, hye, l', hl'rest, hl'y⟩\n              · exact o_solver_serve _ hcons'\n              · exact hcons'\n              · intro e he\n                rw [List.mem_cons] at he\n                cases he with\n                | inl heq =>\n                  subst heq\n                  refine ⟨hI.habitada, ?_⟩\n                  intro r₂ hr₂\n                  exact retornoUtil_das_limpas φ S C r₂ (List.mem_filter.mp hr₂).1\n                | inr htail => exact hI.pilhaSadia e htail\n            exact ih _ _ _ _ _ _ hI' h\n          · -- a escolha não trava em lista viva — impossível\n            rename_i hmelhor\n            exfalso\n            have his := o_melhor_de_nao_vazio φ S _ hnn\n            rw [hmelhor] at his\n            simp at his\n\n/-- ★★ **O ALGORITMO SÓ LÊ COM CORRESPONDÊNCIA** — a fidelidade no nome final: o eco só sai do custo\nzero; a máquina nunca apresenta 1 = 0 = VERDADEIRO. -/\ntheorem o_algoritmo_so_le_com_correspondencia {n : ℕ} (φ : CNF n) (fuel : ℕ) (x w : Fin n → Bool)\n    (h : (oAlgoritmo φ fuel x).1 = some w) : custoCNF φ w = 0 :=\n  o_processo_final_so_le_com_correspondencia φ fuel x w h\n\n/-- ★★ **O ALGORITMO NUNCA MEDE A ESCURIDÃO** — o corolário no processo: satisfazível, a máquina jamais\nresponde «não há luz» por veredito; todo silêncio vem do fundo do combustível, com a luz intacta. (Não\nse mede a escuridão: só se mede a luz.) -/\ntheorem o_algoritmo_nunca_mede_a_escuridao {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool)\n    (hSAT : SAT φ) (S' : Espectro2 n) (mem' : List (Literal n))\n    (h : processoComPodaM φ fuel x = (none, S', mem')) :\n    ∃ (S₀ : Espectro2 n) (x₀ : Fin n → Bool) (pilha₀ : List (Espectro2 n × List (Literal n)))\n      (mem₀ : List (Literal n)),\n      aLuzDoAlgoritmo φ S₀ pilha₀ ∧ lacoComPodaM φ 0 S₀ x₀ pilha₀ mem₀ = (none, S', mem') := by\n  obtain ⟨y, hy⟩ := hSAT\n  have hy0 : custoCNF φ y = 0 := (custoCNF_zero_sse φ y).mpr hy\n  have h0 : serveEspectro2 y ([] : Espectro2 n) = true := by unfold serveEspectro2; simp\n  have hyfecho : serveEspectro2 y (fechoDoCampo φ (n + 2) []) = true :=\n    o_fecho_e_gratuito φ y hy0 (n + 2) [] h0\n  have hI₀ : EstadoDaLuz φ (fechoDoCampo φ (n + 2) [])\n      (ressurreicaoConstrutiva (fechoDoCampo φ (n + 2) [])) [] :=\n    ⟨Or.inl ⟨y, hy0, hyfecho⟩, o_solver_serve _ ⟨y, hyfecho⟩, ⟨y, hyfecho⟩,\n      fun e he => absurd he List.not_mem_nil⟩\n  unfold processoComPodaM at h\n  exact a_luz_nunca_cala_estacionada φ _ _ _ _ _ _ _ hI₀ h\n\n/-- ★★ **O ALGORITMO: OU O ECO COM CORRESPONDÊNCIA, OU O SILÊNCIO COM A LUZ INTACTA** — a disjunção\nfinal: havendo luz, o algoritmo ou a encontra (e o ponto serve o campo), ou cala só por combustível,\nguardando a luz. A leitura é correspondente e o silêncio nunca é\nveredito. -/\ntheorem o_algoritmo_ou_ecoa_ou_guarda_a_luz {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool)\n    (hSAT : SAT φ) :\n    (∃ w : Fin n → Bool, (oAlgoritmo φ fuel x).1 = some w ∧ custoCNF φ w = 0) ∨\n      (∃ (S' : Espectro2 n) (mem' : List (Literal n)), oAlgoritmo φ fuel x = (none, S', mem') ∧\n        ∃ (S₀ : Espectro2 n) (x₀ : Fin n → Bool) (pilha₀ : List (Espectro2 n × List (Literal n)))\n          (mem₀ : List (Literal n)),\n          aLuzDoAlgoritmo φ S₀ pilha₀ ∧ lacoComPodaM φ 0 S₀ x₀ pilha₀ mem₀ = (none, S', mem')) := by\n  cases hr : (oAlgoritmo φ fuel x).1 with\n  | some w => exact Or.inl ⟨w, rfl, o_algoritmo_so_le_com_correspondencia φ fuel x w hr⟩\n  | none =>\n    right\n    obtain ⟨R, hR⟩ : ∃ R, oAlgoritmo φ fuel x = R := ⟨_, rfl⟩\n    obtain ⟨r, Sm⟩ := R\n    obtain ⟨S₂, mem₂⟩ := Sm\n    rw [hR] at hr\n    dsimp only [] at hr\n    subst hr\n    unfold oAlgoritmo at hR\n    exact ⟨S₂, mem₂, hR, o_algoritmo_nunca_mede_a_escuridao φ fuel x hSAT S₂ mem₂ hR⟩\n\n/-- ★★ **A MEDIDA FINAL: O ALGORITMO DECIDE** — os três muros, a família profunda, a sanidade e a\nhonestidade, tudo re-medido no nome final. -/\ntheorem a_medida_o_algoritmo_decide :\n    (oAlgoritmo phiTrap 12 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo phiCE 12 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo phiFofa2 12 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo phiTrap2 20 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo phiTrap3 30 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo phiCadeia 12 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo phiFofa 12 (fun _ => false)).1.isSome = true\n    ∧ (oAlgoritmo ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 12 (fun _ => false)).1 = none := by\n  decide\n\nend TGLExt.OAlgoritmoPenP\n\n",
+    'TGLExt/OLivroConsultado.lean': "import TGLExt.OAlgoritmoPenP\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# O livro consultado: nenhuma porta se tenta duas vezes no mesmo ponto\r\n\r\n## O que é\r\n\r\n`processoComLivro` é a busca com a poda em que a pilha guarda só pontos e as portas moram no livro, e o livro é consultado: num\r\nponto, só entram as portas limpas que o livro não registra naquele ponto (`limpasNoveisDe`). O ponto é o conteúdo do espectro\r\n(`conteudoDe`: em cada variável, o valor da primeira equação do espectro que a contém), não a ordem do registro. Quando não resta\r\nporta nova, a busca sobe ao ponto mais recente da pilha; a pilha vazia é o silêncio.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `conteudoDe`, `mesmoPonto`, `tentadaNoPonto`, `limpasNoveisDe`, `lacoComLivro`, `processoComLivro` [DEF].\r\n2. ★★ `o_eco_do_livro_e_fiel`: a busca só responde com ponto de custo zero.\r\n3. ★★ `o_livro_nunca_repete`: os registros do livro (o conteúdo do ponto e a porta) são sempre distintos.\r\n4. ★★ `a_cota_do_livro`: o tamanho do livro ao fim nunca passa de `aCotaDoLivro n`, o número de pares (conteúdo, porta), que é\r\n   3ⁿ·2n: finito e exponencial no número de variáveis.\r\n5. ★★ `a_energia_do_combustivel`: se o laço responde com silêncio, ou existe um estado de silêncio terminal (`oSilencioTerminal`:\r\n   o ponto da descida tem custo, a primeira cláusula sem par existe e não resta porta nova), ou o combustível foi pago em portas e\r\n   pontos: `2·|livro ao fim| + |pilha| ≥ combustível + 2·|livro no início|`.\r\n6. ★★ `o_combustivel_da_luz_basta`: com combustível de pelo menos `2·aCotaDoLivro n + 1`, se o processo responde com silêncio,\r\n   existe um estado de silêncio terminal.\r\n7. ★★ `a_medida_a_maquina_do_livro_decide`: por `decide`, a busca com o livro responde com ponto nas mesmas sete fórmulas com\r\n   solução da medida de `OAlgoritmoPenP` e cala na fórmula sem solução de uma variável.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Os enunciados 5 e 6 afirmam que existe um estado de silêncio terminal, mas não que a corrida passou por ele. Como estão\r\n  escritos, não provam que a corrida termina pelo detector antes de o combustível acabar; provam que o livro nunca passa de\r\n  3ⁿ·2n registros e que, se a corrida responde com silêncio e não existe estado de silêncio terminal algum, ela registrou em\r\n  portas pelo menos metade do combustível.\r\n* Que o silêncio desta busca signifique que a fórmula não tem solução (a completude do veredito): não está provado neste módulo;\r\n  está provado em `ODentroOuMorto` (`o_veredito_decide_com_a_cota`), com combustível de pelo menos `2·aCotaDoLivro n + 1`, pelo\r\n  invariante do livro sadio (toda porta registrada está dentro do ramo corrente ou numa subárvore sem solução).\r\n* Que combustível polinomial no tamanho da fórmula baste: segue [OPEN]; a cota desta pedra é exponencial.\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.OLivroConsultado\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\r\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\r\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\r\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\r\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\r\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\r\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\r\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\r\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\r\nopen TGLExt.AFamiliaProfunda TGLExt.ADescidaPinadaEmMemoria TGLExt.ALeituraCorrespondente\r\nopen TGLExt.OAlgoritmoPenP\r\n\r\n/-- [DEF] O conteúdo do espectro na variável: o valor que o espectro fixa nela, se fixa. (O ponto da\r\ndoutrina é o conteúdo, não a ordem do registro.) -/\r\ndef conteudoDe {n : ℕ} (S : Espectro2 n) (j : Fin n) : Option (ZMod 2) :=\r\n  (S.find? (fun e => e.1 j)).map Prod.snd\r\n\r\n/-- [DEF] O mesmo ponto: os dois espectros fixam o mesmo conteúdo. -/\r\ndef mesmoPonto {n : ℕ} (S₁ S₂ : Espectro2 n) : Bool :=\r\n  (List.finRange n).all (fun j => decide (conteudoDe S₁ j = conteudoDe S₂ j))\r\n\r\n/-- [DEF] O livro consultado: a porta foi tentada no ponto. -/\r\ndef tentadaNoPonto {n : ℕ} (livro : List (Espectro2 n × Literal n)) (S : Espectro2 n) (l : Literal n) :\r\n    Bool :=\r\n  livro.any (fun p => mesmoPonto p.1 S && mesmaLiteral p.2 l)\r\n\r\n/-- [DEF] As portas novas do ponto: as limpas que o livro não registra no ponto. -/\r\ndef limpasNoveisDe {n : ℕ} (φ : CNF n) (livro : List (Espectro2 n × Literal n)) (S : Espectro2 n)\r\n    (C : Clausula n) : List (Literal n) :=\r\n  (limpasDe φ S C).filter (fun l => !tentadaNoPonto livro S l)\r\n\r\n/-- [DEF] **O LAÇO COM O LIVRO CONSULTADO**: a pilha guarda só pontos; as portas moram no livro. A morte\r\nregistra a porta nova do ponto e empilha o ponto; o detector (limpas novas vazia) dispara a subida ao\r\nponto mais recente; de volta ao ponto, as portas tentadas não aparecem — nenhuma porta se tenta duas\r\nvezes no mesmo ponto. -/\r\ndef lacoComLivro {n : ℕ} (φ : CNF n) :\r\n    ℕ → Espectro2 n → (Fin n → Bool) → List (Espectro2 n) → List (Espectro2 n × Literal n) →\r\n      (Option (Fin n → Bool)) × Espectro2 n × List (Espectro2 n × Literal n)\r\n  | 0, S, x, _, livro => (if custoCNF φ x = 0 then some x else none, S, livro)\r\n  | fuel + 1, S, x, pilha, livro =>\r\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\r\n    if custoCNF φ w = 0 then (some w, S, livro)\r\n    else\r\n      match primeiraSemPar φ w with\r\n      | none => (none, S, livro)\r\n      | some C =>\r\n        match limpasNoveisDe φ livro S C with\r\n        | [] =>\r\n          match pilha with\r\n          | [] => (none, S, livro)\r\n          | S' :: pilha' => lacoComLivro φ fuel S' (ressurreicaoConstrutiva S') pilha' livro\r\n        | limpasNovas =>\r\n          match oMelhorDe φ S limpasNovas with\r\n          | some l =>\r\n            lacoComLivro φ fuel (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n              (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\r\n              (S :: pilha) ((S, l) :: livro)\r\n          | none => (none, S, livro)\r\n\r\n/-- [DEF] O processo com o livro consultado: o campo fala o fecho; o laço corre do livro vazio. -/\r\ndef processoComLivro {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :=\r\n  let S₀ := fechoDoCampo φ (n + 2) []\r\n  lacoComLivro φ fuel S₀ (ressurreicaoConstrutiva S₀) [] []\r\n\r\n/-- ★★ **O ECO DO LIVRO É FIEL**: o laço com o livro consultado só responde com ponto de custo zero. -/\r\ntheorem o_eco_do_livro_e_fiel {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x w : Fin n → Bool) (pilha : List (Espectro2 n))\r\n      (livro : List (Espectro2 n × Literal n)) (S' : Espectro2 n)\r\n      (livro' : List (Espectro2 n × Literal n)),\r\n      lacoComLivro φ fuel S x pilha livro = (some w, S', livro') → custoCNF φ w = 0 := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x w pilha livro S' livro' h\r\n    unfold lacoComLivro at h\r\n    rw [Prod.mk.injEq] at h\r\n    obtain ⟨h1, -⟩ := h\r\n    split at h1\r\n    · rename_i hcond\r\n      have hw := Option.some.inj h1\r\n      subst hw\r\n      exact hcond\r\n    · simp at h1\r\n  | succ f ih =>\r\n    intro S x w pilha livro S' livro' h\r\n    unfold lacoComLivro at h\r\n    dsimp only [] at h\r\n    split at h\r\n    · rename_i hcond\r\n      rw [Prod.mk.injEq] at h\r\n      obtain ⟨h1, -⟩ := h\r\n      have hw := Option.some.inj h1\r\n      subst hw\r\n      exact hcond\r\n    · split at h\r\n      · simp at h\r\n      · split at h\r\n        · split at h\r\n          · simp at h\r\n          · exact ih _ _ _ _ _ _ _ h\r\n        · split at h\r\n          · exact ih _ _ _ _ _ _ _ h\r\n          · simp at h\r\n\r\n/-- [DEF] A imagem do registro do livro: o conteúdo do ponto (como função) e a porta (como par). -/\r\ndef imagemDoLivro {n : ℕ} (p : Espectro2 n × Literal n) : (Fin n → Option (ZMod 2)) × (Fin n × Bool) :=\r\n  (fun j => conteudoDe p.1 j, (p.2.var, p.2.pos))\r\n\r\n/-- O mesmo ponto, na forma da igualdade ponto a ponto. -/\r\ntheorem mesmoPonto_sse {n : ℕ} (S₁ S₂ : Espectro2 n) :\r\n    mesmoPonto S₁ S₂ = true ↔ ∀ j : Fin n, conteudoDe S₁ j = conteudoDe S₂ j := by\r\n  unfold mesmoPonto\r\n  rw [List.all_eq_true]\r\n  constructor\r\n  · intro h j\r\n    have hj := h j (List.mem_finRange j)\r\n    exact of_decide_eq_true hj\r\n  · intro h j _\r\n    exact decide_eq_true (h j)\r\n\r\n/-- A imagem é fiel ao ponto e à porta: imagens iguais, mesmo ponto e mesma literal. -/\r\ntheorem imagem_fiel {n : ℕ} (p q : Espectro2 n × Literal n)\r\n    (h : imagemDoLivro p = imagemDoLivro q) :\r\n    mesmoPonto p.1 q.1 = true ∧ mesmaLiteral p.2 q.2 = true := by\r\n  unfold imagemDoLivro at h\r\n  rw [Prod.mk.injEq] at h\r\n  obtain ⟨hpt, hpr⟩ := h\r\n  constructor\r\n  · rw [mesmoPonto_sse]\r\n    intro j\r\n    exact congrFun hpt j\r\n  · unfold mesmaLiteral\r\n    rw [Prod.mk.injEq] at hpr\r\n    obtain ⟨hv, hpo⟩ := hpr\r\n    rw [Bool.and_eq_true]\r\n    exact ⟨beq_iff_eq.mpr hv, beq_iff_eq.mpr hpo⟩\r\n\r\n/-- O livro consultado, na forma testemunhada: a porta foi tentada no ponto sse algum registro do livro\r\né daquele ponto e daquela porta. -/\r\ntheorem tentada_sse {n : ℕ} (livro : List (Espectro2 n × Literal n)) (S : Espectro2 n) (l : Literal n) :\r\n    tentadaNoPonto livro S l = true ↔\r\n      ∃ p : Espectro2 n × Literal n, p ∈ livro ∧ mesmoPonto p.1 S = true ∧ mesmaLiteral p.2 l = true := by\r\n  unfold tentadaNoPonto\r\n  rw [List.any_eq_true]\r\n  constructor\r\n  · intro h\r\n    obtain ⟨p, hp, hpred⟩ := h\r\n    exact ⟨p, hp, by rwa [Bool.and_eq_true] at hpred⟩\r\n  · intro h\r\n    obtain ⟨p, hp, h1, h2⟩ := h\r\n    exact ⟨p, hp, by rw [Bool.and_eq_true]; exact ⟨h1, h2⟩⟩\r\n\r\n/-- ★★ **O LIVRO NUNCA REPETE**: as imagens do livro (ponto × porta) são sempre distintas — nenhuma\r\nporta se tenta duas vezes no mesmo ponto. -/\r\ntheorem o_livro_nunca_repete {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool) (pilha : List (Espectro2 n))\r\n      (livro : List (Espectro2 n × Literal n)) (res : Option (Fin n → Bool)) (S' : Espectro2 n)\r\n      (livro' : List (Espectro2 n × Literal n)),\r\n      (livro.map imagemDoLivro).Nodup →\r\n      lacoComLivro φ fuel S x pilha livro = (res, S', livro') →\r\n      (livro'.map imagemDoLivro).Nodup := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x pilha livro res S' livro' hnd h\r\n    unfold lacoComLivro at h\r\n    rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n    obtain ⟨_, _, hlv⟩ := h\r\n    rw [← hlv]\r\n    exact hnd\r\n  | succ f ih =>\r\n    intro S x pilha livro res S' livro' hnd h\r\n    unfold lacoComLivro at h\r\n    dsimp only [] at h\r\n    split at h\r\n    · -- o eco: o livro intacto\r\n      rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n      obtain ⟨_, _, hlv⟩ := h\r\n      rw [← hlv]\r\n      exact hnd\r\n    · split at h\r\n      · rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n        obtain ⟨_, _, hlv⟩ := h\r\n        rw [← hlv]\r\n        exact hnd\r\n      · rename_i C hC\r\n        split at h\r\n        · split at h\r\n          · rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n            obtain ⟨_, _, hlv⟩ := h\r\n            rw [← hlv]\r\n            exact hnd\r\n          · -- a subida: o livro intacto\r\n            exact ih _ _ _ _ _ _ _ hnd h\r\n        · split at h\r\n          · -- a morte: o livro cresce com imagem fresca\r\n            rename_i hnn l hl\r\n            have hlmem : l ∈ limpasNoveisDe φ livro S C := o_melhor_de_mem φ S _ _ hl\r\n            unfold limpasNoveisDe at hlmem\r\n            have hnao : tentadaNoPonto livro S l = false := by\r\n              have h2 := (List.mem_filter.mp hlmem).2\r\n              cases ht : tentadaNoPonto livro S l with\r\n              | false => rfl\r\n              | true => rw [ht] at h2; simp at h2\r\n            have hfresh : imagemDoLivro (S, l) ∉ livro.map imagemDoLivro := by\r\n              intro hmem\r\n              rw [List.mem_map] at hmem\r\n              obtain ⟨p, hp, himg⟩ := hmem\r\n              obtain ⟨hpt, hpor⟩ := imagem_fiel p (S, l) himg\r\n              have ht : tentadaNoPonto livro S l = true := (tentada_sse _ _ _).mpr ⟨p, hp, hpt, hpor⟩\r\n              rw [ht] at hnao\r\n              simp at hnao\r\n            have hnd' : (((S, l) :: livro).map imagemDoLivro).Nodup := by\r\n              rw [List.map_cons, List.nodup_cons]\r\n              exact ⟨hfresh, hnd⟩\r\n            exact ih _ _ _ _ _ _ _ hnd' h\r\n          · -- o melhor de lista viva nunca é none — mas se calar, o livro segue intacto\r\n            rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n            obtain ⟨_, _, hlv⟩ := h\r\n            rw [← hlv]\r\n            exact hnd\r\n\r\n/-- [DEF] **A COTA DO LIVRO**: o universo dos pontos com porta — finito e explícito. -/\r\ndef aCotaDoLivro (n : ℕ) : ℕ := Fintype.card ((Fin n → Option (ZMod 2)) × (Fin n × Bool))\r\n\r\n/-- ★★ **A COTA DO LIVRO**: o livro da máquina cabe sempre no universo dos pontos com porta. -/\r\ntheorem a_cota_do_livro {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool)\r\n    (res : Option (Fin n → Bool)) (S' : Espectro2 n) (livro' : List (Espectro2 n × Literal n))\r\n    (h : lacoComLivro φ fuel (fechoDoCampo φ (n + 2) [])\r\n      (ressurreicaoConstrutiva (fechoDoCampo φ (n + 2) [])) [] [] = (res, S', livro')) :\r\n    livro'.length ≤ aCotaDoLivro n := by\r\n  have hnd := o_livro_nunca_repete φ _ _ _ _ _ _ _ _ (by simp) h\r\n  have hcard : (livro'.map imagemDoLivro).toFinset.card ≤ Fintype.card\r\n      ((Fin n → Option (ZMod 2)) × (Fin n × Bool)) := by\r\n    rw [← Finset.card_univ]\r\n    exact Finset.card_le_card (Finset.subset_univ _)\r\n  rw [List.toFinset_card_of_nodup hnd, List.length_map] at hcard\r\n  exact hcard\r\n\r\n/-- [DEF] **O SILÊNCIO TERMINAL**: o estado do veredito — o custo fora do zero, a cláusula morta lida, e\r\nnenhuma porta nova no ponto (o detector disparado com o livro consultado). -/\r\ndef oSilencioTerminal {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\r\n    (livro : List (Espectro2 n × Literal n)) : Prop :=\r\n  custoCNF φ (descerGenerico passoFiel φ S φ.length ([], x)).2 ≠ 0 ∧\r\n    ∃ C : Clausula n, primeiraSemPar φ (descerGenerico passoFiel φ S φ.length ([], x)).2 = some C ∧\r\n      limpasNoveisDe φ livro S C = []\r\n\r\n/-- ★★ **A ENERGIA DO COMBUSTÍVEL**: se o laço responde com silêncio, ou existe um estado de silêncio\r\nterminal (o enunciado não diz que a corrida passou por ele), ou o combustível se pagou em portas e pontos:\r\ncada passo ou registra uma porta nova no livro ou sobe um ponto da pilha. -/\r\ntheorem a_energia_do_combustivel {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool) (pilha : List (Espectro2 n))\r\n      (livro : List (Espectro2 n × Literal n)) (S' : Espectro2 n)\r\n      (livro' : List (Espectro2 n × Literal n)),\r\n      lacoComLivro φ fuel S x pilha livro = (none, S', livro') →\r\n      (∃ S₀ x₀ livro₀, oSilencioTerminal φ S₀ x₀ livro₀) ∨\r\n        (2 * livro'.length + pilha.length ≥ fuel + 2 * livro.length) := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x pilha livro S' livro' h\r\n    unfold lacoComLivro at h\r\n    rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n    obtain ⟨_, _, hlv⟩ := h\r\n    subst hlv\r\n    right\r\n    omega\r\n  | succ f ih =>\r\n    intro S x pilha livro S' livro' h\r\n    unfold lacoComLivro at h\r\n    dsimp only [] at h\r\n    split at h\r\n    · -- o eco: some = none — impossível\r\n      rw [Prod.mk.injEq] at h\r\n      obtain ⟨h1, -⟩ := h\r\n      simp at h1\r\n    · rename_i hcusto\r\n      split at h\r\n      · -- a primeiraSemPar não cala com custo fora do zero\r\n        rename_i hsem\r\n        exfalso\r\n        have his := a_primeira_sem_par_existe φ _ hcusto\r\n        rw [hsem] at his\r\n        simp at his\r\n      · rename_i C hC\r\n        split at h\r\n        · -- o detector disparou: a pilha decide\r\n          rename_i hlimpas\r\n          split at h\r\n          · -- ★ O VEREDITO: o silêncio terminal — a pilha vazia com o detector disparado\r\n            left\r\n            exact ⟨S, x, livro, hcusto, C, hC, hlimpas⟩\r\n          · -- a subida: o livro intacto, a pilha um a menos\r\n            rename_i S₁ pilha₁\r\n            have hih := ih S₁ (ressurreicaoConstrutiva S₁) pilha₁ livro S' livro' h\r\n            cases hih with\r\n            | inl hterm => exact Or.inl hterm\r\n            | inr harit =>\r\n              right\r\n              rw [List.length_cons]\r\n              omega\r\n        · -- a morte: o livro cresce um, a pilha cresce um\r\n          rename_i hnn\r\n          split at h\r\n          · rename_i l hl\r\n            have hih := ih (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n              (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\r\n              (S :: pilha) ((S, l) :: livro) S' livro' h\r\n            cases hih with\r\n            | inl hterm => exact Or.inl hterm\r\n            | inr harit =>\r\n              right\r\n              rw [List.length_cons, List.length_cons] at harit\r\n              omega\r\n          · -- a escolha não trava em lista viva — impossível\r\n            rename_i hmelhor\r\n            exfalso\r\n            have his := o_melhor_de_nao_vazio φ S _ hnn\r\n            rw [hmelhor] at his\r\n            simp at his\r\n\r\n/-- ★★ **O COMBUSTÍVEL DA LUZ BASTA**: com combustível maior que o dobro do universo dos pares (conteúdo,\r\nporta), se o processo responde com silêncio, existe um estado de silêncio terminal. O enunciado não liga\r\nesse estado à corrida. -/\r\ntheorem o_combustivel_da_luz_basta {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool)\r\n    (S' : Espectro2 n) (livro' : List (Espectro2 n × Literal n))\r\n    (hcomb : 2 * aCotaDoLivro n + 1 ≤ fuel)\r\n    (h : processoComLivro φ fuel x = (none, S', livro')) :\r\n    ∃ (S₀ : Espectro2 n) (x₀ : Fin n → Bool) (livro₀ : List (Espectro2 n × Literal n)),\r\n      oSilencioTerminal φ S₀ x₀ livro₀ := by\r\n  unfold processoComLivro at h\r\n  have hE := a_energia_do_combustivel φ fuel _ _ [] [] S' livro' h\r\n  cases hE with\r\n  | inl hterm => exact hterm\r\n  | inr harit =>\r\n    exfalso\r\n    have hcota := a_cota_do_livro φ fuel x none S' livro' h\r\n    simp at harit\r\n    omega\r\n\r\n/-- ★★ **A MEDIDA FINAL: A MÁQUINA DO LIVRO DECIDE** — os três muros, a família profunda, a sanidade e a\r\nhonestidade, re-medidos na máquina que consulta o livro: idêntica à do algoritmo no conjunto medido. -/\r\ntheorem a_medida_a_maquina_do_livro_decide :\r\n    (processoComLivro phiTrap 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiCE 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiFofa2 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiTrap2 20 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiTrap3 30 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiCadeia 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiFofa 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 12 (fun _ => false)).1 = none := by\r\n  decide\r\n\r\nend TGLExt.OLivroConsultado\r\n\r\n",
+    'TGLExt/ODentroOuMorto.lean': "import TGLExt.OLivroConsultado\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# Dentro ou morto: a completude do veredito da busca com o livro\r\n\r\n## O que é\r\n\r\nA busca com o livro consultado (`processoComLivro`) recebe aqui o invariante que a faz decidir (`EstadoDaLuzComLivro`): a luz serve o\r\nespectro corrente ou um ponto da pilha; o ponto é servo fiel; a casa é habitada; os espectros são de equações de literais; a pilha é\r\nencadeada; o livro é consistente; e o livro é sadio: toda porta registrada ou tem o seu ramo como prefixo do corrente (dentro) ou a sua\r\nsubárvore não tem solução (morto). A correção do silêncio não vem de um atestado do «não»: vem da manutenção do invariante de que a luz\r\nnunca se perdeu.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★ `serve_transfer`: servir é do conteúdo; espectros de literais do mesmo ponto têm os mesmos servidores.\r\n2. `Config`, `passoMaquina`, `aCorrida`, `dentroDoPonto`, `mortoNoPonto`, `livroSadio`, `pilhaEncadeada`, `EstadoDaLuzComLivro` [DEF].\r\n3. ★ `o_estado_inicial_tem_luz`: com a fórmula satisfazível, a configuração inicial satisfaz o invariante.\r\n4. ★ `existe_divergencia`: servindo um prefixo e não o todo, há o ponto onde a luz diverge.\r\n5. ★★ `a_luz_exige_limpa_nova`: com a luz servida no espectro, o livro sadio e os registros consistentes, o detector do silêncio com o\r\n   livro consultado não dispara: há sempre porta nova.\r\n6. ★★★ `a_manutencao`: o invariante sobrevive a cada passo da máquina do livro, na morte e na subida.\r\n7. ★ `o_terminal_impossivel`: com o invariante e a pilha vazia, o detector do silêncio terminal não pode estar disparado.\r\n8. ★★★ `a_luz_nunca_cala_o_veredito_final`: com o invariante, se o laço responde com silêncio, ou o silêncio é o terminal com o\r\n   invariante (que o item 7 exclui), ou o combustível foi pago em portas e pontos, com a luz intacta.\r\n9. ★★★ `o_veredito_decide_com_a_cota`: se a fórmula tem solução e o combustível é pelo menos `2·aCotaDoLivro n + 1`, a busca com o\r\n   livro, partindo do ponto com todas as variáveis falsas, responde com um ponto.\r\n10. ★★ `o_veredito_e_honesto`: a busca só responde com ponto de custo zero.\r\n11. ★★ `a_medida_o_veredito_decide`: por `decide`, a busca responde com ponto em cinco fórmulas com solução e cala na fórmula sem\r\n    solução de uma variável.\r\n\r\nCom 9 e 10: com combustível de pelo menos `2·aCotaDoLivro n + 1`, a busca responde com ponto se e só se a fórmula tem solução; dentro\r\ndessa cota, o silêncio significa que não há solução.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Que combustível polinomial no tamanho da fórmula baste: a cota é `2·aCotaDoLivro n + 1`, exponencial no número de variáveis\r\n  (3ⁿ·2n pares); a cota polinomial segue [OPEN].\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.ODentroOuMorto\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\r\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\r\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\r\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\r\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\r\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\r\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\r\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\r\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\r\nopen TGLExt.AFamiliaProfunda TGLExt.ADescidaPinadaEmMemoria TGLExt.ALeituraCorrespondente\r\nopen TGLExt.OAlgoritmoPenP TGLExt.OLivroConsultado\r\n\r\n/-- Servir a equação da literal é a literal valer (a volta). -/\r\ntheorem vale_de_serveEq {n : ℕ} (l : Literal n) (y : Fin n → Bool)\r\n    (h : serveEq y (mascaraDeLiteral l, valorDeLiteral l)) : l.vale y = true := by\r\n  unfold serveEq at h\r\n  rw [paridade2_mascaraLiteral] at h\r\n  unfold valorDeLiteral at h\r\n  unfold Literal.vale\r\n  rw [beq_iff_eq]\r\n  cases hy : y l.var with\r\n  | false => cases hp : l.pos with\r\n    | false => rfl\r\n    | true => rw [hy, hp] at h; simp at h\r\n  | true => cases hp : l.pos with\r\n    | false => rw [hy, hp] at h; simp at h\r\n    | true => rfl\r\n\r\n/-- Servir a equação da literal é a literal valer (a forma bicondicional). -/\r\ntheorem serveEq_sse_vale {n : ℕ} (l : Literal n) (y : Fin n → Bool) :\r\n    serveEq y (mascaraDeLiteral l, valorDeLiteral l) ↔ l.vale y = true :=\r\n  ⟨vale_de_serveEq l y, serveEq_de_vale l y⟩\r\n\r\n/-- [DEF] O espectro da máquina é só de equações de literais. -/\r\ndef soLiterais {n : ℕ} (S : Espectro2 n) : Prop :=\r\n  ∀ e ∈ S, ∃ l : Literal n, e = (mascaraDeLiteral l, valorDeLiteral l)\r\n\r\n/-- Servir um espectro de literais é toda literal dele valer. -/\r\ntheorem serveEspectro2_literais_sse {n : ℕ} (S : Espectro2 n) (hlit : soLiterais S)\r\n    (y : Fin n → Bool) :\r\n    serveEspectro2 y S = true ↔ ∀ l : Literal n,\r\n      (mascaraDeLiteral l, valorDeLiteral l) ∈ S → l.vale y = true := by\r\n  unfold serveEspectro2\r\n  rw [List.all_eq_true]\r\n  constructor\r\n  · intro hserve l hl\r\n    have hserveq : serveEq y (mascaraDeLiteral l, valorDeLiteral l) := by\r\n      have h1 := hserve _ hl\r\n      rw [beq_iff_eq] at h1\r\n      exact h1\r\n    exact vale_de_serveEq l y hserveq\r\n  · intro hvale e he\r\n    obtain ⟨l, hle⟩ := hlit e he\r\n    rw [hle] at he ⊢\r\n    rw [beq_iff_eq]\r\n    exact serveEq_de_vale _ _ (hvale l he)\r\n\r\n/-- O conteúdo alguma: há equação cobrindo a variável com aquele valor. -/\r\ntheorem conteudoDe_some {n : ℕ} (S : Espectro2 n) (j : Fin n) (v : ZMod 2)\r\n    (h : conteudoDe S j = some v) :\r\n    ∃ e ∈ S, e.1 j = true ∧ e.2 = v := by\r\n  unfold conteudoDe at h\r\n  cases hf : S.find? (fun e => e.1 j) with\r\n  | none => rw [hf] at h; simp at h\r\n  | some e =>\r\n    rw [hf] at h\r\n    simp at h\r\n    have hmem : e ∈ S := List.mem_of_find?_eq_some hf\r\n    have hbit : (fun e => e.1 j) e = true := encontra_mem _ _ _ hf |>.2\r\n    exact ⟨e, hmem, hbit, h⟩\r\n\r\n/-- O servidor único do conteúdo: num espectro de literais consistente, duas equações na mesma variável\r\ntêm o mesmo valor. -/\r\ntheorem o_valor_e_unico_no_ponto {n : ℕ} (S : Espectro2 n) (hlit : soLiterais S)\r\n    (hcons : ∃ z : Fin n → Bool, serveEspectro2 z S = true) (j : Fin n)\r\n    (e₁ e₂ : (Fin n → Bool) × ZMod 2) (he₁ : e₁ ∈ S) (he₂ : e₂ ∈ S)\r\n    (hj₁ : e₁.1 j = true) (hj₂ : e₂.1 j = true) : e₁.2 = e₂.2 := by\r\n  obtain ⟨z, hz⟩ := hcons\r\n  obtain ⟨l₁, rfl⟩ := hlit e₁ he₁\r\n  obtain ⟨l₂, rfl⟩ := hlit e₂ he₂\r\n  have hserve := (serveEspectro2_literais_sse S hlit z).mp hz\r\n  have hv₁ := hserve l₁ he₁\r\n  have hv₂ := hserve l₂ he₂\r\n  -- l₁.var = j = l₂.var: a máscara unitária só cobre a própria variável\r\n  have hvar₁ : l₁.var = j := by\r\n    have h1 : mascaraDeLiteral l₁ j = true := hj₁\r\n    unfold mascaraDeLiteral at h1\r\n    rw [decide_eq_true_eq] at h1\r\n    exact h1.symm\r\n  have hvar₂ : l₂.var = j := by\r\n    have h1 : mascaraDeLiteral l₂ j = true := hj₂\r\n    unfold mascaraDeLiteral at h1\r\n    rw [decide_eq_true_eq] at h1\r\n    exact h1.symm\r\n  -- os dois valem em z na mesma variável: o mesmo sinal\r\n  unfold Literal.vale at hv₁ hv₂\r\n  rw [beq_iff_eq] at hv₁ hv₂\r\n  rw [hvar₁] at hv₁\r\n  rw [hvar₂] at hv₂\r\n  have hpos : l₁.pos = l₂.pos := by rw [← hv₁, ← hv₂]\r\n  unfold valorDeLiteral\r\n  rw [hpos]\r\n\r\n/-- ★ **SERVIR É DO CONTEÚDO**: dois espectros de literais do mesmo ponto, um consistente, têm os mesmos\r\nservidores. -/\r\ntheorem serve_transfer {n : ℕ} (S₁ S₂ : Espectro2 n) (y : Fin n → Bool)\r\n    (hlit₁ : soLiterais S₁) (hlit₂ : soLiterais S₂)\r\n    (hcons₂ : ∃ z : Fin n → Bool, serveEspectro2 z S₂ = true)\r\n    (hmp : mesmoPonto S₁ S₂ = true)\r\n    (hserve : serveEspectro2 y S₁ = true) :\r\n    serveEspectro2 y S₂ = true := by\r\n  rw [mesmoPonto_sse] at hmp\r\n  rw [serveEspectro2_literais_sse S₂ hlit₂ y]\r\n  intro l hl\r\n  -- a equação de l em S₂: o conteúdo na var de l é o valor de l\r\n  have hcont₂ : conteudoDe S₂ l.var = some (valorDeLiteral l) := by\r\n    have hbit : (mascaraDeLiteral l) l.var = true := by\r\n      show decide (l.var = l.var) = true\r\n      rw [decide_eq_true_eq]\r\n    have hfind : (S₂.find? (fun e => e.1 l.var)).isSome = true := by\r\n      rw [List.find?_isSome]\r\n      exact ⟨(mascaraDeLiteral l, valorDeLiteral l), hl, hbit⟩\r\n    unfold conteudoDe\r\n    cases hf : S₂.find? (fun e => e.1 l.var) with\r\n    | none => rw [hf] at hfind; simp at hfind\r\n    | some e =>\r\n      simp only [Option.map_some, Option.some.injEq]\r\n      -- e cobre l.var; pela unicidade do valor no ponto, e.2 = valorDeLiteral l\r\n      have hmem : e ∈ S₂ := List.mem_of_find?_eq_some hf\r\n      have hbit' : e.1 l.var = true := (encontra_mem _ _ _ hf).2\r\n      exact o_valor_e_unico_no_ponto S₂ hlit₂ hcons₂ l.var e (mascaraDeLiteral l, valorDeLiteral l)\r\n        hmem hl hbit' hbit\r\n  -- o mesmo conteúdo em S₁: há equação na var de l com o valor de l\r\n  have hcont₁ := hmp l.var\r\n  rw [hcont₂] at hcont₁\r\n  obtain ⟨e₁, he₁, hj₁, hv₁⟩ := conteudoDe_some S₁ l.var (valorDeLiteral l) hcont₁\r\n  obtain ⟨l₁, rfl⟩ := hlit₁ e₁ he₁\r\n  -- a máscara de l₁ cobre l.var: l₁.var = l.var\r\n  have hvar : l₁.var = l.var := by\r\n    have h1 : mascaraDeLiteral l₁ l.var = true := hj₁\r\n    unfold mascaraDeLiteral at h1\r\n    rw [decide_eq_true_eq] at h1\r\n    exact h1.symm\r\n  -- o valor: valorDeLiteral l₁ = valorDeLiteral l → l₁.pos = l.pos\r\n  have hv₁' : valorDeLiteral l₁ = valorDeLiteral l := hv₁\r\n  have hpos : l₁.pos = l.pos := by\r\n    unfold valorDeLiteral at hv₁'\r\n    cases hp₁ : l₁.pos with\r\n    | false =>\r\n      cases hp : l.pos with\r\n      | false => rfl\r\n      | true => rw [hp₁, hp] at hv₁'; simp at hv₁'\r\n    | true =>\r\n      cases hp : l.pos with\r\n      | false => rw [hp₁, hp] at hv₁'; simp at hv₁'\r\n      | true => rfl\r\n  -- l₁ = l, e está em S₁: l vale em y\r\n  have hleq : l₁ = l := by\r\n    cases l₁\r\n    cases l\r\n    simp at hvar hpos\r\n    rw [hvar, hpos]\r\n  have hvl₁ := (serveEspectro2_literais_sse S₁ hlit₁ y).mp hserve l₁ he₁\r\n  rw [hleq] at hvl₁\r\n  exact hvl₁\r\n\r\n/-- [DEF] **DENTRO DO PONTO**: o ramo da porta registrada é prefixo do espectro corrente. -/\r\ndef dentroDoPonto {n : ℕ} (S : Espectro2 n) (p : Espectro2 n × Literal n) : Prop :=\r\n  (p.1 ++ [(mascaraDeLiteral p.2, valorDeLiteral p.2)]) <+: S\r\n\r\n/-- [DEF] **MORTO NO PONTO**: a subárvore da porta registrada não tem luz. -/\r\ndef mortoNoPonto {n : ℕ} (φ : CNF n) (p : Espectro2 n × Literal n) : Prop :=\r\n  ¬ ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧\r\n    serveEspectro2 y (p.1 ++ [(mascaraDeLiteral p.2, valorDeLiteral p.2)]) = true\r\n\r\n/-- [DEF] **O LIVRO SADIO** (a forma forte): toda porta registrada ou está dentro do ramo corrente,\r\nou dentro de um ramo pendente da pilha, ou morreu sem luz. -/\r\ndef livroSadio {n : ℕ} (φ : CNF n) (S : Espectro2 n) (pilha : List (Espectro2 n))\r\n    (livro : List (Espectro2 n × Literal n)) : Prop :=\r\n  ∀ p ∈ livro, dentroDoPonto S p ∨ (∃ e ∈ pilha, dentroDoPonto e p) ∨ mortoNoPonto φ p\r\n\r\n/-- A pilha encadeada: cada entrada é prefixo de todas as anteriores (a mais recente é a mais\r\nprofunda). (A forma que a subida consome.) -/\r\ndef pilhaEncadeada {n : ℕ} : List (Espectro2 n) → Prop\r\n  | [] => True\r\n  | a :: l => (∀ e ∈ l, e <+: a) ∧ pilhaEncadeada l\r\n\r\n/-- A mesma literal é a mesma: campos iguais, estruturas iguais. -/\r\ntheorem mesmaLiteral_eq {n : ℕ} (a b : Literal n) (h : mesmaLiteral a b = true) : a = b := by\r\n  unfold mesmaLiteral at h\r\n  rw [Bool.and_eq_true] at h\r\n  obtain ⟨hv, hp⟩ := h\r\n  rw [beq_iff_eq] at hv hp\r\n  cases a\r\n  cases b\r\n  simp at hv hp\r\n  rw [hv, hp]\r\n\r\n/-- O prefixo é membro: o ramo registrado está no espectro, a porta é lida nele. (Auxiliar do\r\nbootstrap.) -/\r\ntheorem membro_de_dentro {n : ℕ} (S : Espectro2 n) (p : Espectro2 n × Literal n)\r\n    (h : dentroDoPonto S p) :\r\n    (mascaraDeLiteral p.2, valorDeLiteral p.2) ∈ S := by\r\n  unfold dentroDoPonto at h\r\n  obtain ⟨t, ht⟩ := h\r\n  rw [← ht]\r\n  exact List.mem_append_left _ (List.mem_append_right _ (List.mem_singleton_self _))\r\n\r\n/-- A cláusula falsificada: toda literal dela falha no ponto. (Auxiliar do bootstrap.) -/\r\ntheorem falsificada_toda_falha {n : ℕ} (C : Clausula n) (w : Fin n → Bool)\r\n    (h : satisfeita C w = false) (l : Literal n) (hl : l ∈ C) : l.vale w = false := by\r\n  unfold satisfeita at h\r\n  rw [List.any_eq_false] at h\r\n  have h2 := h l hl\r\n  cases hv : l.vale w with\r\n  | true => exact absurd hv h2\r\n  | false => rfl\r\n\r\n/-- O mesmo ponto é simétrico. -/\r\ntheorem mesmoPonto_comm {n : ℕ} (S₁ S₂ : Espectro2 n) :\r\n    mesmoPonto S₁ S₂ = mesmoPonto S₂ S₁ := by\r\n  unfold mesmoPonto\r\n  congr 1\r\n  funext j\r\n  have h : (conteudoDe S₁ j = conteudoDe S₂ j) = (conteudoDe S₂ j = conteudoDe S₁ j) := propext eq_comm\r\n  simp only [h]\r\n\r\n/-- [DEF] **A configuração da máquina do livro**: o espectro, o ponto, a pilha de pontos, o livro de\r\nportas. -/\r\nstructure Config (n : ℕ) where\r\n  esp : Espectro2 n\r\n  ponto : Fin n → Bool\r\n  pilha : List (Espectro2 n)\r\n  livro : List (Espectro2 n × Literal n)\r\n\r\n/-- [DEF] **O passo da máquina**: a transição — o eco (estaciona), o silêncio terminal (estaciona), a\r\nsubida ao ponto mais recente, ou a morte com o registro no livro. `none` é a máquina estacionada. -/\r\ndef passoMaquina {n : ℕ} (φ : CNF n) (c : Config n) : Option (Config n) :=\r\n  let w := (descerGenerico passoFiel φ c.esp φ.length ([], c.ponto)).2\r\n  if custoCNF φ w = 0 then none\r\n  else\r\n    match primeiraSemPar φ w with\r\n    | none => none\r\n    | some C =>\r\n      match limpasNoveisDe φ c.livro c.esp C with\r\n      | [] =>\r\n        match c.pilha with\r\n        | [] => none\r\n        | S₁ :: pilha₁ => some ⟨S₁, ressurreicaoConstrutiva S₁, pilha₁, c.livro⟩\r\n      | novas =>\r\n        match oMelhorDe φ c.esp novas with\r\n        | some l => some ⟨c.esp ++ [(mascaraDeLiteral l, valorDeLiteral l)],\r\n            ressurreicaoConstrutiva (c.esp ++ [(mascaraDeLiteral l, valorDeLiteral l)]),\r\n            c.esp :: c.pilha, (c.esp, l) :: c.livro⟩\r\n        | none => none\r\n\r\n/-- [DEF] **A corrida**: a iteração do passo — `none` depois de estacionar. -/\r\ndef aCorrida {n : ℕ} (φ : CNF n) (c₀ : Config n) : ℕ → Option (Config n)\r\n  | 0 => some c₀\r\n  | k + 1 => (aCorrida φ c₀ k).bind (passoMaquina φ)\r\n\r\n/-- [DEF] **O ESTADO DA LUZ COM O LIVRO** — o invariante completo da busca com o livro: a luz no espectro ou na\r\npilha; o ponto servo fiel; a casa habitada; os espectros de literais; a pilha encadeada; o livro\r\nconsistente; e o livro sadio (dentro do corrente, dentro de um pendente, ou morto). -/\r\nstructure EstadoDaLuzComLivro {n : ℕ} (φ : CNF n) (c : Config n) : Prop where\r\n  luz : (∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y c.esp = true) ∨\r\n    (∃ S₁ : Espectro2 n, S₁ ∈ c.pilha ∧ ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧\r\n      serveEspectro2 y S₁ = true)\r\n  pocoServe : serveEspectro2 c.ponto c.esp = true\r\n  habitada : ∃ z : Fin n → Bool, serveEspectro2 z c.esp = true\r\n  literais : soLiterais c.esp ∧ (∀ S₁ : Espectro2 n, S₁ ∈ c.pilha → soLiterais S₁)\r\n  pilhaHabitada : ∀ S₁ : Espectro2 n, S₁ ∈ c.pilha → ∃ z : Fin n → Bool, serveEspectro2 z S₁ = true\r\n  encadeada : (∀ e : Espectro2 n, e ∈ c.pilha → e <+: c.esp) ∧\r\n    pilhaEncadeada c.pilha\r\n  livroConsistente : ∀ p : Espectro2 n × Literal n, p ∈ c.livro →\r\n    soLiterais p.1 ∧ ∃ z : Fin n → Bool, serveEspectro2 z p.1 = true\r\n  sadio : livroSadio φ c.esp c.pilha c.livro\r\n  protegida : ∀ D : Espectro2 n, (∃ l : Literal n, (D, l) ∈ c.livro) →\r\n    (∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y D = true) →\r\n    D ∈ c.pilha ∨ D = c.esp\r\n  aForma : (fechoDoCampo φ (n + 2) [] <+: c.esp) ∧\r\n    (∀ e : Espectro2 n, e ∈ c.pilha → fechoDoCampo φ (n + 2) [] <+: e) ∧\r\n    (∀ (D : Espectro2 n) (l : Literal n),\r\n      (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]) <+: c.esp →\r\n      (fechoDoCampo φ (n + 2) []).length < (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length →\r\n      (D, l) ∈ c.livro)\r\n\r\n/-- O prefixo tem comprimento limitado. (Auxiliar geral.) -/\r\ntheorem prefixo_length {n : ℕ} (a b : Espectro2 n) (h : a <+: b) : a.length ≤ b.length := by\r\n  obtain ⟨t, ht⟩ := h\r\n  rw [← ht, List.length_append]\r\n  omega\r\n\r\n/-- O prefixo de prefixo é prefixo. (Auxiliar geral.) -/\r\ntheorem prefixo_trans {n : ℕ} (a b c : Espectro2 n) (h₁ : a <+: b) (h₂ : b <+: c) : a <+: c := by\r\n  obtain ⟨t₁, ht₁⟩ := h₁\r\n  obtain ⟨t₂, ht₂⟩ := h₂\r\n  exact ⟨t₁ ++ t₂, by rw [← ht₂, ← ht₁, List.append_assoc]⟩\r\n\r\n/-- Servir o todo é servir o prefixo. (Auxiliar geral.) -/\r\ntheorem serve_prefixo {n : ℕ} (S₁ S₂ : Espectro2 n) (y : Fin n → Bool)\r\n    (h : S₁ <+: S₂) (hs : serveEspectro2 y S₂ = true) : serveEspectro2 y S₁ = true := by\r\n  obtain ⟨t, ht⟩ := h\r\n  rw [← ht] at hs\r\n  rw [serveEspectro2_append] at hs\r\n  rw [Bool.and_eq_true] at hs\r\n  exact hs.1\r\n\r\n/-- Todo espectro é o take do seu prefixo maior. (Auxiliar da comparabilidade.) -/\r\ntheorem prefixo_take {n : ℕ} (a b : Espectro2 n) (h : a <+: b) : b.take a.length = a := by\r\n  obtain ⟨t, ht⟩ := h\r\n  rw [← ht]\r\n  exact List.take_left\r\n\r\n/-- Prefixos do mesmo espectro são comparáveis por comprimento. (Auxiliar da região.) -/\r\ntheorem prefixo_comparavel {n : ℕ} (a b c : Espectro2 n) (ha : a <+: c) (hb : b <+: c)\r\n    (hle : a.length ≤ b.length) : a <+: b := by\r\n  have hta := prefixo_take a c ha\r\n  have htb := prefixo_take b c hb\r\n  have h1 : b.take a.length = a := by\r\n    have h2 : (c.take b.length).take a.length = c.take a.length := by\r\n      rw [List.take_take, Nat.min_eq_left hle]\r\n    rw [htb] at h2\r\n    rw [h2, hta]\r\n  refine ⟨b.drop a.length, ?_⟩\r\n  have h2 := List.take_append_drop a.length b\r\n  rw [h1] at h2\r\n  exact h2\r\n\r\n/-- ★ **A DIVERGÊNCIA EXISTE**: servindo um prefixo mas não o todo, há o ponto onde a luz diverge —\r\no último prefixo servido e a primeira porta que ela recusa. (Auxiliar da região.) -/\r\ntheorem existe_divergencia {n : ℕ} (y : Fin n → Bool) :\r\n    ∀ (P₀ suf : Espectro2 n), serveEspectro2 y P₀ = true →\r\n      ¬ serveEspectro2 y (P₀ ++ suf) = true → soLiterais (P₀ ++ suf) →\r\n      ∃ (D : Espectro2 n) (l : Literal n) (rest : Espectro2 n),\r\n        P₀ ++ suf = D ++ (mascaraDeLiteral l, valorDeLiteral l) :: rest ∧\r\n        P₀ <+: D ∧\r\n        serveEspectro2 y D = true ∧\r\n        ¬ serveEspectro2 y (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true := by\r\n  intro P₀ suf\r\n  induction suf generalizing P₀ with\r\n  | nil =>\r\n    intro hserveP hnao hlit\r\n    rw [List.append_nil] at hnao\r\n    exact absurd hserveP hnao\r\n  | cons e suf' ih =>\r\n    intro hserveP hnao hlit\r\n    by_cases hse : serveEspectro2 y (P₀ ++ [e]) = true\r\n    · have hS : (P₀ ++ [e]) ++ suf' = P₀ ++ (e :: suf') := List.append_assoc _ _ _\r\n      rw [← hS] at hnao\r\n      have hlit' : soLiterais ((P₀ ++ [e]) ++ suf') := by rwa [← hS] at hlit\r\n      obtain ⟨D, l, rest, hD, hPD, hs1, hs2⟩ := ih (P₀ ++ [e]) hse hnao hlit'\r\n      exact ⟨D, l, rest, by rw [← hS]; exact hD,\r\n        prefixo_trans P₀ (P₀ ++ [e]) D ⟨[e], rfl⟩ hPD, hs1, hs2⟩\r\n    · have hmem : e ∈ P₀ ++ (e :: suf') := List.mem_append_right _ List.mem_cons_self\r\n      obtain ⟨l, hl⟩ := hlit e hmem\r\n      exact ⟨P₀, l, suf', by rw [hl], ⟨[], by rw [List.append_nil]⟩, hserveP,\r\n        by rw [hl] at hse; exact hse⟩\r\n\r\n/-- O fecho só acrescenta equações de literais. (Auxiliar do estado inicial.) -/\r\ntheorem fecho_so_literais {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n), soLiterais S → soLiterais (fechoDoCampo φ fuel S) := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero => intro S h; unfold fechoDoCampo; exact h\r\n  | succ f ih =>\r\n    intro S h\r\n    unfold fechoDoCampo\r\n    split\r\n    · exact h\r\n    · rename_i l hpasso\r\n      apply ih\r\n      intro e he\r\n      rw [List.mem_append, List.mem_singleton] at he\r\n      cases he with\r\n      | inl hS => exact h e hS\r\n      | inr hS =>\r\n        subst hS\r\n        exact ⟨l, rfl⟩\r\n\r\n/-- ★ **O ESTADO INICIAL TEM LUZ**: com luz na fórmula, a configuração inicial satisfaz o invariante\r\ncompleto. -/\r\ntheorem o_estado_inicial_tem_luz {n : ℕ} (φ : CNF n)\r\n    (hSAT : SAT φ) :\r\n    EstadoDaLuzComLivro φ ⟨fechoDoCampo φ (n + 2) [],\r\n      ressurreicaoConstrutiva (fechoDoCampo φ (n + 2) []), [], []⟩ := by\r\n  obtain ⟨y, hy⟩ := hSAT\r\n  have hy0 : custoCNF φ y = 0 := (custoCNF_zero_sse φ y).mpr hy\r\n  have h0 : serveEspectro2 y ([] : Espectro2 n) = true := by unfold serveEspectro2; simp\r\n  have hyfecho : serveEspectro2 y (fechoDoCampo φ (n + 2) []) = true :=\r\n    o_fecho_e_gratuito φ y hy0 (n + 2) [] h0\r\n  refine ⟨Or.inl ⟨y, hy0, hyfecho⟩, o_solver_serve _ ⟨y, hyfecho⟩, ⟨y, hyfecho⟩,\r\n    ⟨fecho_so_literais φ _ [] (fun e he => absurd he List.not_mem_nil),\r\n      fun S₁ h => absurd h List.not_mem_nil⟩,\r\n    fun S₁ h => absurd h List.not_mem_nil,\r\n    ⟨fun e he => absurd he List.not_mem_nil, trivial⟩,\r\n    fun p hp => absurd hp List.not_mem_nil,\r\n    fun p hp => absurd hp List.not_mem_nil,\r\n    fun D hD _ => by\r\n      obtain ⟨l, hmem⟩ := hD\r\n      exact absurd hmem List.not_mem_nil,\r\n    ⟨⟨[], by rw [List.append_nil]⟩, fun e he => absurd he List.not_mem_nil, fun D l hD hcomp => ?_⟩⟩\r\n  have hle := prefixo_length _ _ hD\r\n  change (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length ≤ (fechoDoCampo φ (n + 2) []).length at hle\r\n  rw [List.length_append, List.length_singleton] at hle hcomp\r\n  omega\r\n\r\n/-- ★★ **A LUZ EXIGE LIMPA NOVA** — o bootstrap: com a luz servida no espectro, o livro sadio e os\r\nregistros de literais consistentes, o detector com o livro consultado NÃO dispara — há sempre porta\r\nnova. O dentro morre no poço; o morto morre na transferência. Uma subárvore com luz nunca é abandonada\r\nsem eco. -/\r\ntheorem a_luz_exige_limpa_nova {n : ℕ} (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool)\r\n    (C : Clausula n) (hCφ : C ∈ φ)\r\n    (hpoco : serveEspectro2 w S = true) (hfalha : satisfeita C w = false)\r\n    (hlit : soLiterais S)\r\n    (hluz : ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true)\r\n    (livro : List (Espectro2 n × Literal n))\r\n    (pilha : List (Espectro2 n))\r\n    (hsadio : livroSadio φ S pilha livro)\r\n    (henc : ∀ e ∈ pilha, e <+: S)\r\n    (hlitLivro : ∀ p : Espectro2 n × Literal n, p ∈ livro →\r\n      soLiterais p.1 ∧ ∃ z : Fin n → Bool, serveEspectro2 z p.1 = true) :\r\n    limpasNoveisDe φ livro S C ≠ [] := by\r\n  intro hvazio\r\n  obtain ⟨y, hy0, hys⟩ := hluz\r\n  obtain ⟨l, hll, hly⟩ := a_porta_da_luz_nas_limpas φ S w C hCφ hpoco hfalha y hy0 hys\r\n  have hmem : l ∈ limpasNoveisDe φ livro S C := by\r\n    unfold limpasNoveisDe\r\n    rw [List.mem_filter]\r\n    refine ⟨hll, ?_⟩\r\n    cases ht : tentadaNoPonto livro S l with\r\n    | false => rfl\r\n    | true =>\r\n      exfalso\r\n      obtain ⟨p, hp, hpt, hpor⟩ := (tentada_sse livro S l).mp ht\r\n      have hpeq : p.2 = l := mesmaLiteral_eq _ _ hpor\r\n      have hpoço_mata : ∀ (E : Espectro2 n), dentroDoPonto E p → serveEspectro2 w E = true → False := by\r\n        intro E hdentro hserveE\r\n        have hmemE := membro_de_dentro E p hdentro\r\n        rw [hpeq] at hmemE\r\n        have hvw : l.vale w = true := by\r\n          unfold serveEspectro2 at hserveE\r\n          rw [List.all_eq_true] at hserveE\r\n          exact vale_de_serveEq l w ((beq_iff_eq).mp (hserveE _ hmemE))\r\n        have hCmem : l ∈ C := by\r\n          unfold limpasDe at hll\r\n          exact (List.mem_filter.mp hll).1\r\n        have hwf := falsificada_toda_falha C w hfalha l hCmem\r\n        rw [hvw] at hwf\r\n        exact Bool.noConfusion hwf\r\n      have hsad := hsadio p hp\r\n      cases hsad with\r\n      | inl hdentro => exact hpoço_mata S hdentro hpoco\r\n      | inr hresto =>\r\n        cases hresto with\r\n        | inl hpil =>\r\n          obtain ⟨e, he, hdentro⟩ := hpil\r\n          exact hpoço_mata e hdentro (serve_prefixo e S w (henc e he) hpoco)\r\n        | inr hmorto =>\r\n          obtain ⟨hlitp, z, hz⟩ := hlitLivro p hp\r\n          have hmp : mesmoPonto S p.1 = true := by rw [mesmoPonto_comm]; exact hpt\r\n          have hyP : serveEspectro2 y p.1 = true :=\r\n            serve_transfer S p.1 y hlit hlitp ⟨z, hz⟩ hmp hys\r\n          have hyPa : serveEspectro2 y (p.1 ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true :=\r\n            serveEspectro2_append_de_vale p.1 y l hyP hly\r\n          unfold mortoNoPonto at hmorto\r\n          rw [hpeq] at hmorto\r\n          exact hmorto ⟨y, hy0, hyPa⟩\r\n  rw [hvazio] at hmem\r\n  exact List.not_mem_nil hmem\r\n\r\n/-- A equação determina a literal: máscaras e valores iguais, literais iguais. (Auxiliar da\r\naForma.) -/\r\ntheorem eqLiteral_inj {n : ℕ} (l₁ l₂ : Literal n)\r\n    (h : (mascaraDeLiteral l₁, valorDeLiteral l₁) = (mascaraDeLiteral l₂, valorDeLiteral l₂)) :\r\n    l₁ = l₂ := by\r\n  rw [Prod.mk.injEq] at h\r\n  obtain ⟨hm, hv⟩ := h\r\n  have hvar : l₁.var = l₂.var := by\r\n    have h2 : mascaraDeLiteral l₂ l₁.var = true := by\r\n      have h1 : mascaraDeLiteral l₁ l₁.var = mascaraDeLiteral l₂ l₁.var := by rw [hm]\r\n      rw [← h1]\r\n      show decide (l₁.var = l₁.var) = true\r\n      rw [decide_eq_true_eq]\r\n    have h3 : decide (l₁.var = l₂.var) = true := h2\r\n    rw [decide_eq_true_eq] at h3\r\n    exact h3\r\n  have hpos : l₁.pos = l₂.pos := by\r\n    unfold valorDeLiteral at hv\r\n    cases hp1 : l₁.pos with\r\n    | false =>\r\n      cases hp2 : l₂.pos with\r\n      | false => rfl\r\n      | true => rw [hp1, hp2] at hv; simp at hv\r\n    | true =>\r\n      cases hp2 : l₂.pos with\r\n      | false => rw [hp1, hp2] at hv; simp at hv\r\n      | true => rfl\r\n  cases l₁\r\n  cases l₂\r\n  simp at hvar hpos\r\n  rw [hvar, hpos]\r\n\r\n/-- Prefixo com o comprimento do todo é o todo. (Auxiliar da aForma.) -/\r\ntheorem prefixo_de_mesmo_comprimento {n : ℕ} (a b : Espectro2 n) (h : a <+: b)\r\n    (hlen : a.length = b.length) : a = b := by\r\n  have hta := prefixo_take a b h\r\n  rw [hlen, List.take_length] at hta\r\n  exact hta.symm\r\n\r\n/-- ★★★ **A MANUTENÇÃO DO PASSO**: o invariante da luz sobrevive a cada passo da máquina do livro —\r\nna morte e na subida. Na subida, o livro sadio se mantém pelo argumento da região: o ramo com luz tem\r\na sua divergência protegida na pilha (a protegida), e o detector não dispara onde há luz (o bootstrap). -/\r\ntheorem a_manutencao {n : ℕ} (φ : CNF n) (c : Config n) (hI : EstadoDaLuzComLivro φ c) :\r\n    ∀ c', passoMaquina φ c = some c' → EstadoDaLuzComLivro φ c' := by\r\n  intro c' hp\r\n  unfold passoMaquina at hp\r\n  dsimp only [] at hp\r\n  have hpoco : serveEspectro2 (descerGenerico passoFiel φ c.esp φ.length ([], c.ponto)).2 c.esp\r\n      = true :=\r\n    o_poco_fiel_serve φ c.esp c.ponto hI.pocoServe\r\n  split at hp\r\n  · simp at hp\r\n  · rename_i hcusto\r\n    split at hp\r\n    · simp at hp\r\n    · rename_i C hC\r\n      obtain ⟨hCφ, hCfalha⟩ := a_primeira_sem_par_mem φ _ C hC\r\n      split at hp\r\n      · -- o detector disparou: limpas novas vazia — o espectro corrente está escuro\r\n        rename_i hlimpas\r\n        have hescuro : ¬ (∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y c.esp = true) :=\r\n          fun hluz => a_luz_exige_limpa_nova φ c.esp _ C hCφ hpoco hCfalha hI.literais.1 hluz\r\n            c.livro c.pilha hI.sadio hI.encadeada.1 hI.livroConsistente hlimpas\r\n        split at hp\r\n        · simp at hp\r\n        · -- ★ A SUBIDA\r\n          rename_i x₀ S₁ pilha₁ heq\r\n          have hcp : c' = ⟨S₁, ressurreicaoConstrutiva S₁, pilha₁, c.livro⟩ := (Option.some.inj hp).symm\r\n          subst hcp\r\n          have hhead := hI.pilhaHabitada S₁ (by rw [heq]; exact List.mem_cons_self)\r\n          have hlit₁ := hI.literais.2 S₁ (by rw [heq]; exact List.mem_cons_self)\r\n          have hfecho₁ := hI.aForma.2.1 S₁ (by rw [heq]; exact List.mem_cons_self)\r\n          refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\r\n          · cases hI.luz with\r\n            | inl hluz => exact absurd hluz hescuro\r\n            | inr hna =>\r\n              obtain ⟨S₂, he₂, y, hy0, hyS₂⟩ := hna\r\n              rw [heq] at he₂\r\n              rw [List.mem_cons] at he₂\r\n              cases he₂ with\r\n              | inl heq => subst heq; exact Or.inl ⟨y, hy0, hyS₂⟩\r\n              | inr htail => exact Or.inr ⟨S₂, htail, y, hy0, hyS₂⟩\r\n          · exact o_solver_serve _ hhead\r\n          · exact hhead\r\n          · exact ⟨hlit₁, fun S₂ he => hI.literais.2 S₂ (by rw [heq]; exact List.mem_cons_of_mem _ he)⟩\r\n          · intro S₂ he; exact hI.pilhaHabitada S₂ (by rw [heq]; exact List.mem_cons_of_mem _ he)\r\n          · constructor\r\n            · intro e he\r\n              have henc2 := hI.encadeada.2\r\n              rw [heq] at henc2\r\n              exact henc2.1 e he\r\n            · have henc2 := hI.encadeada.2\r\n              rw [heq] at henc2\r\n              exact henc2.2\r\n          · intro p hp2; exact hI.livroConsistente p hp2\r\n          · -- ★ o livro sadio na subida: o argumento da região\r\n            intro p hp2\r\n            have hsad := hI.sadio p hp2\r\n            cases hsad with\r\n            | inl hdentro =>\r\n              by_cases hramo : dentroDoPonto S₁ p\r\n              · exact Or.inl hramo\r\n              · -- o ramo ficou na região: ou morreu sem luz, ou a sua luz tem a divergência protegida\r\n                by_cases hnl : mortoNoPonto φ p\r\n                · exact Or.inr (Or.inr hnl)\r\n                · unfold mortoNoPonto at hnl\r\n                  push_neg at hnl\r\n                  obtain ⟨y', hy'0, hy'⟩ := hnl\r\n                  have hnaoS : ¬ serveEspectro2 y' c.esp = true := by\r\n                    intro hsc\r\n                    exact hescuro ⟨y', hy'0, hsc⟩\r\n                  obtain ⟨suf, hsuf⟩ := hdentro\r\n                  have hlitS : soLiterais ((p.1 ++ [(mascaraDeLiteral p.2, valorDeLiteral p.2)]) ++ suf) := by\r\n                    rw [hsuf]; exact hI.literais.1\r\n                  rw [← hsuf] at hnaoS\r\n                  obtain ⟨D, l, rest, hD, hPD, hserveD, hnaoD⟩ :=\r\n                    existe_divergencia y' _ suf hy' hnaoS hlitS\r\n                  -- D' com luz, no livro: a protegida o guarda na pilha\r\n                  have hpre : (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]) <+: c.esp := by\r\n                    refine ⟨rest, ?_⟩\r\n                    have htr : (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]) ++ rest =\r\n                        D ++ (mascaraDeLiteral l, valorDeLiteral l) :: rest := List.append_assoc _ _ _\r\n                    rw [htr, ← hD, hsuf]\r\n                  have hlen : (fechoDoCampo φ (n + 2) []).length <\r\n                      (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length := by\r\n                    by_contra hn\r\n                    have hle : (D ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length ≤\r\n                        (fechoDoCampo φ (n + 2) []).length := by omega\r\n                    have hpre2 : (D ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n                        <+: fechoDoCampo φ (n + 2) [] :=\r\n                      prefixo_comparavel _ _ _ hpre hI.aForma.1 hle\r\n                    have hyf : serveEspectro2 y' (fechoDoCampo φ (n + 2) []) = true := by\r\n                      have h0 : serveEspectro2 y' ([] : Espectro2 n) = true := by\r\n                        unfold serveEspectro2; simp\r\n                      exact o_fecho_e_gratuito φ y' hy'0 (n + 2) [] h0\r\n                    exact hnaoD (serve_prefixo _ _ y' hpre2 hyf)\r\n                  have hlivroD : ∃ l' : Literal n, (D, l') ∈ c.livro :=\r\n                    ⟨l, hI.aForma.2.2 D l hpre hlen⟩\r\n                  have hprot := hI.protegida D hlivroD ⟨y', hy'0, hserveD⟩\r\n                  cases hprot with\r\n                  | inl hmem =>\r\n                    rw [heq] at hmem\r\n                    rw [List.mem_cons] at hmem\r\n                    cases hmem with\r\n                    | inl heq =>\r\n                      subst heq\r\n                      exact absurd hPD hramo\r\n                    | inr htail =>\r\n                      apply Or.inr\r\n                      apply Or.inl\r\n                      exact ⟨D, htail, hPD⟩\r\n                  | inr heq =>\r\n                    rw [heq] at hserveD\r\n                    exact absurd ⟨y', hy'0, hserveD⟩ hescuro\r\n            | inr hresto =>\r\n              cases hresto with\r\n              | inl hpil =>\r\n                obtain ⟨e, he, hdentro⟩ := hpil\r\n                rw [heq] at he\r\n                rw [List.mem_cons] at he\r\n                cases he with\r\n                | inl heq => subst heq; exact Or.inl hdentro\r\n                | inr htail => exact Or.inr (Or.inl ⟨e, htail, hdentro⟩)\r\n              | inr hmorto => exact Or.inr (Or.inr hmorto)\r\n          · intro D hD hluzD\r\n            have hprot := hI.protegida D hD hluzD\r\n            cases hprot with\r\n            | inl hmem =>\r\n              rw [heq] at hmem\r\n              rw [List.mem_cons] at hmem\r\n              cases hmem with\r\n              | inl heq => subst heq; right; rfl\r\n              | inr htail => left; exact htail\r\n            | inr heq =>\r\n              rw [heq] at hluzD\r\n              exact absurd hluzD hescuro\r\n          · constructor\r\n            · exact hfecho₁\r\n            · constructor\r\n              · intro e he; exact hI.aForma.2.1 e (by rw [heq]; exact List.mem_cons_of_mem _ he)\r\n              · intro D l hD hcomp\r\n                exact hI.aForma.2.2 D l\r\n                  (prefixo_trans _ _ _ hD (hI.encadeada.1 S₁ (by rw [heq]; exact List.mem_cons_self)))\r\n                  hcomp\r\n      · -- ★ A MORTE\r\n        rename_i hnn\r\n        split at hp\r\n        · rename_i l hl\r\n          have hcp : c' = ⟨c.esp ++ [(mascaraDeLiteral l, valorDeLiteral l)],\r\n              ressurreicaoConstrutiva (c.esp ++ [(mascaraDeLiteral l, valorDeLiteral l)]),\r\n              c.esp :: c.pilha, (c.esp, l) :: c.livro⟩ := (Option.some.inj hp).symm\r\n          subst hcp\r\n          have hlmem : l ∈ limpasNoveisDe φ c.livro c.esp C := o_melhor_de_mem φ c.esp _ l hl\r\n          have hret : retornoUtil c.esp l = true := by\r\n            unfold limpasNoveisDe at hlmem\r\n            exact retornoUtil_das_limpas φ c.esp C l (List.mem_filter.mp hlmem).1\r\n          have hcons' := a_porta_limpa_mantem_a_casa c.esp l hI.habitada hret\r\n          refine ⟨?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_, ?_⟩\r\n          · cases hI.luz with\r\n            | inl hluz =>\r\n              obtain ⟨y, hy0, hys⟩ := hluz\r\n              cases hlv : l.vale y with\r\n              | true => exact Or.inl ⟨y, hy0, serveEspectro2_append_de_vale _ _ l hys hlv⟩\r\n              | false => exact Or.inr ⟨c.esp, List.mem_cons_self, y, hy0, hys⟩\r\n            | inr hna =>\r\n              obtain ⟨S₂, he₂, y, hy0, hyS₂⟩ := hna\r\n              exact Or.inr ⟨S₂, List.mem_cons_of_mem _ he₂, y, hy0, hyS₂⟩\r\n          · exact o_solver_serve _ hcons'\r\n          · exact hcons'\r\n          · constructor\r\n            · intro e he\r\n              rw [List.mem_append, List.mem_singleton] at he\r\n              cases he with\r\n              | inl hS => exact hI.literais.1 e hS\r\n              | inr hS => subst hS; exact ⟨l, rfl⟩\r\n            · intro S₂ he\r\n              rw [List.mem_cons] at he\r\n              cases he with\r\n              | inl heq => subst heq; exact hI.literais.1\r\n              | inr htail => exact hI.literais.2 S₂ htail\r\n          · intro S₂ he\r\n            rw [List.mem_cons] at he\r\n            cases he with\r\n            | inl heq => subst heq; exact hI.habitada\r\n            | inr htail => exact hI.pilhaHabitada S₂ htail\r\n          · constructor\r\n            · intro e he\r\n              rw [List.mem_cons] at he\r\n              cases he with\r\n              | inl heq =>\r\n                subst heq\r\n                exact ⟨[(mascaraDeLiteral l, valorDeLiteral l)], rfl⟩\r\n              | inr htail =>\r\n                exact prefixo_trans e c.esp _ (hI.encadeada.1 e htail)\r\n                  ⟨[(mascaraDeLiteral l, valorDeLiteral l)], rfl⟩\r\n            · exact ⟨hI.encadeada.1, hI.encadeada.2⟩\r\n          · intro p hp2\r\n            rw [List.mem_cons] at hp2\r\n            cases hp2 with\r\n            | inl heq =>\r\n              subst heq\r\n              exact ⟨hI.literais.1, hI.habitada⟩\r\n            | inr htail => exact hI.livroConsistente p htail\r\n          · intro p hp2\r\n            rw [List.mem_cons] at hp2\r\n            cases hp2 with\r\n            | inl heq =>\r\n              subst heq\r\n              left\r\n              exact ⟨[], by rw [List.append_nil]⟩\r\n            | inr htail =>\r\n              have hsad := hI.sadio p htail\r\n              cases hsad with\r\n              | inl hdentro =>\r\n                left\r\n                exact prefixo_trans _ _ _ hdentro\r\n                  ⟨[(mascaraDeLiteral l, valorDeLiteral l)], rfl⟩\r\n              | inr hresto =>\r\n                cases hresto with\r\n                | inl hpil =>\r\n                  obtain ⟨e, he, hdentro⟩ := hpil\r\n                  exact Or.inr (Or.inl ⟨e, List.mem_cons_of_mem _ he, hdentro⟩)\r\n                | inr hmorto => exact Or.inr (Or.inr hmorto)\r\n          · intro D hD hluzD\r\n            obtain ⟨l', hl'⟩ := hD\r\n            have hl2' := (List.mem_cons.mp hl' : (D, l') = (c.esp, l) ∨ (D, l') ∈ c.livro)\r\n            cases hl2' with\r\n            | inl heq =>\r\n              rw [Prod.mk.injEq] at heq\r\n              obtain ⟨h1, -⟩ := heq\r\n              subst h1\r\n              left\r\n              exact List.mem_cons_self\r\n            | inr htail =>\r\n              have hprot := hI.protegida D ⟨l', htail⟩ hluzD\r\n              cases hprot with\r\n              | inl hmem => left; exact List.mem_cons_of_mem _ hmem\r\n              | inr heq =>\r\n                subst heq\r\n                left\r\n                exact List.mem_cons_self\r\n          · constructor\r\n            · exact prefixo_trans _ _ _ hI.aForma.1\r\n                ⟨[(mascaraDeLiteral l, valorDeLiteral l)], rfl⟩\r\n            · constructor\r\n              · intro e he\r\n                rw [List.mem_cons] at he\r\n                cases he with\r\n                | inl heq => subst heq; exact hI.aForma.1\r\n                | inr htail => exact hI.aForma.2.1 e htail\r\n              · intro D l₂ hD hcomp\r\n                have hlen : (D ++ [(mascaraDeLiteral l₂, valorDeLiteral l₂)]).length ≤\r\n                    (c.esp ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length :=\r\n                  prefixo_length _ _ hD\r\n                rw [List.length_append, List.length_singleton] at hlen\r\n                cases Nat.lt_or_ge (D ++ [(mascaraDeLiteral l₂, valorDeLiteral l₂)]).length\r\n                    (c.esp ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length with\r\n                | inl hlt =>\r\n                  have hle : (D ++ [(mascaraDeLiteral l₂, valorDeLiteral l₂)]).length\r\n                      ≤ c.esp.length := by\r\n                    simp only [List.length_append, List.length_singleton] at hlt hlen ⊢\r\n                    omega\r\n                  have hpre : (D ++ [(mascaraDeLiteral l₂, valorDeLiteral l₂)]) <+: c.esp :=\r\n                    prefixo_comparavel _ _ _ hD\r\n                      ⟨[(mascaraDeLiteral l, valorDeLiteral l)], rfl⟩ hle\r\n                  exact List.mem_cons_of_mem _ (hI.aForma.2.2 D l₂ hpre hcomp)\r\n                | inr hge =>\r\n                  have heqLen : D.length = c.esp.length := by\r\n                    simp only [List.length_append, List.length_singleton] at hge hlen\r\n                    omega\r\n                  have heq2 := prefixo_de_mesmo_comprimento _ _ hD (by\r\n                    simp only [List.length_append, List.length_singleton]\r\n                    omega)\r\n                  obtain ⟨hD2, hl2⟩ := List.append_inj heq2 heqLen\r\n                  subst hD2\r\n                  have hl3 : l₂ = l := eqLiteral_inj l₂ l (List.singleton_inj.mp hl2)\r\n                  subst hl3\r\n                  exact List.mem_cons_self\r\n        · simp at hp\r\n\r\n/-- ★ **O TERMINAL É IMPOSSÍVEL COM A LUZ**: com o invariante e a pilha vazia, o detector não pode\r\nestar disparado — a luz no espectro exige porta nova (o bootstrap). -/\r\ntheorem o_terminal_impossivel {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\r\n    (livro : List (Espectro2 n × Literal n))\r\n    (hI : EstadoDaLuzComLivro φ ⟨S, x, [], livro⟩)\r\n    (hterm : oSilencioTerminal φ S x livro) : False := by\r\n  obtain ⟨hcusto, C, hC, hlimpas⟩ := hterm\r\n  have hpoco : serveEspectro2 (descerGenerico passoFiel φ S φ.length ([], x)).2 S = true :=\r\n    o_poco_fiel_serve φ S x hI.pocoServe\r\n  obtain ⟨hCφ, hCfalha⟩ := a_primeira_sem_par_mem φ _ C hC\r\n  cases hI.luz with\r\n  | inl hluz =>\r\n    exact a_luz_exige_limpa_nova φ S _ C hCφ hpoco hCfalha hI.literais.1 hluz livro []\r\n      hI.sadio hI.encadeada.1 hI.livroConsistente hlimpas\r\n  | inr hna =>\r\n    obtain ⟨S₂, he₂, -⟩ := hna\r\n    exact absurd he₂ List.not_mem_nil\r\n\r\n/-- ★★★ **A LUZ NUNCA CALA: A FORMA FINAL** — com o invariante, o silêncio da máquina do livro ou é o\r\nveredito terminal COM o invariante (que o bootstrap mata), ou desce ao fundo do combustível COM a luz\r\nintacta E a contabilidade (cada passo pago em porta ou ponto). (A completude do veredito + a energia,\r\nnuma só cadeia.) -/\r\ntheorem a_luz_nunca_cala_o_veredito_final {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool) (pilha : List (Espectro2 n))\r\n      (livro : List (Espectro2 n × Literal n)) (S' : Espectro2 n)\r\n      (livro' : List (Espectro2 n × Literal n)),\r\n      EstadoDaLuzComLivro φ ⟨S, x, pilha, livro⟩ →\r\n      lacoComLivro φ fuel S x pilha livro = (none, S', livro') →\r\n      (∃ (S₀ : Espectro2 n) (x₀ : Fin n → Bool) (livro₀ : List (Espectro2 n × Literal n)),\r\n        EstadoDaLuzComLivro φ ⟨S₀, x₀, [], livro₀⟩ ∧ oSilencioTerminal φ S₀ x₀ livro₀) ∨\r\n      (∃ (S₀ : Espectro2 n) (x₀ : Fin n → Bool) (pilha₀ : List (Espectro2 n))\r\n        (livro₀ : List (Espectro2 n × Literal n)),\r\n        EstadoDaLuzComLivro φ ⟨S₀, x₀, pilha₀, livro₀⟩ ∧\r\n          lacoComLivro φ 0 S₀ x₀ pilha₀ livro₀ = (none, S', livro') ∧\r\n          2 * livro₀.length + pilha.length ≥ fuel + 2 * livro.length) := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x pilha livro S' livro' hI h\r\n    exact Or.inr ⟨S, x, pilha, livro, hI, h, by omega⟩\r\n  | succ f ih =>\r\n    intro S x pilha livro S' livro' hI h\r\n    unfold lacoComLivro at h\r\n    dsimp only [] at h\r\n    split at h\r\n    · rw [Prod.mk.injEq, Prod.mk.injEq] at h\r\n      obtain ⟨h1, -⟩ := h\r\n      simp at h1\r\n    · rename_i hcusto\r\n      split at h\r\n      · rename_i hsem\r\n        exfalso\r\n        have his := a_primeira_sem_par_existe φ _ hcusto\r\n        rw [hsem] at his\r\n        simp at his\r\n      · rename_i C hC\r\n        split at h\r\n        · -- o detector disparou\r\n          rename_i hlimpas\r\n          split at h\r\n          · -- ★ O SILÊNCIO TERMINAL — com o invariante\r\n            left\r\n            exact ⟨S, x, livro, hI, hcusto, C, hC, hlimpas⟩\r\n          · -- a subida: o livro intacto, a pilha um a menos\r\n            rename_i pilha₀ S₁ pilha₁\r\n            have hstep : passoMaquina φ ⟨S, x, S₁ :: pilha₁, livro⟩ =\r\n                some ⟨S₁, ressurreicaoConstrutiva S₁, pilha₁, livro⟩ := by\r\n              unfold passoMaquina\r\n              dsimp only []\r\n              rw [if_neg hcusto]\r\n              split\r\n              · rename_i hsem\r\n                rw [hsem] at hC\r\n                simp at hC\r\n              · rename_i C₂ hC2\r\n                rw [hC2] at hC\r\n                have hCC : C₂ = C := Option.some.inj hC\r\n                rw [← hCC] at hlimpas\r\n                split\r\n                · rename_i hlimpas2\r\n                  rfl\r\n                · rename_i hnn\r\n                  exact absurd hlimpas hnn\r\n            have hI' := a_manutencao φ _ hI _ hstep\r\n            have hih := ih S₁ (ressurreicaoConstrutiva S₁) pilha₁ livro S' livro' hI' h\r\n            cases hih with\r\n            | inl hterm => exact Or.inl hterm\r\n            | inr hbot =>\r\n              obtain ⟨S₀, x₀, pilha₀, livro₀, hI₀, h0, harit⟩ := hbot\r\n              exact Or.inr ⟨S₀, x₀, pilha₀, livro₀, hI₀, h0, by\r\n                rw [List.length_cons] at *\r\n                omega⟩\r\n        · -- a morte: o livro e a pilha crescem um\r\n          rename_i hnn\r\n          split at h\r\n          · rename_i l hl\r\n            have hstep : passoMaquina φ ⟨S, x, pilha, livro⟩ =\r\n                some ⟨S ++ [(mascaraDeLiteral l, valorDeLiteral l)],\r\n                  ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]),\r\n                  S :: pilha, (S, l) :: livro⟩ := by\r\n              unfold passoMaquina\r\n              dsimp only []\r\n              rw [if_neg hcusto]\r\n              split\r\n              · rename_i hsem\r\n                rw [hsem] at hC\r\n                simp at hC\r\n              · rename_i C₂ hC2\r\n                rw [hC2] at hC\r\n                have hCC : C₂ = C := Option.some.inj hC\r\n                rw [← hCC] at hl hnn\r\n                split\r\n                · rename_i hlimpas2\r\n                  exact absurd hlimpas2 hnn\r\n                · split\r\n                  · rename_i l' hl'\r\n                    rw [hl'] at hl\r\n                    have hll : l' = l := Option.some.inj hl\r\n                    subst hll\r\n                    rfl\r\n                  · rename_i hnone2\r\n                    rw [hnone2] at hl\r\n                    simp at hl\r\n            have hI' := a_manutencao φ _ hI _ hstep\r\n            have hih := ih _ _ _ _ _ _ hI' h\r\n            cases hih with\r\n            | inl hterm => exact Or.inl hterm\r\n            | inr hbot =>\r\n              obtain ⟨S₀, x₀, pilha₀, livro₀, hI₀, h0, harit⟩ := hbot\r\n              exact Or.inr ⟨S₀, x₀, pilha₀, livro₀, hI₀, h0, by\r\n                rw [List.length_cons, List.length_cons] at *\r\n                omega⟩\r\n          · rename_i hmelhor\r\n            exfalso\r\n            have his := o_melhor_de_nao_vazio φ S _ hnn\r\n            rw [hmelhor] at his\r\n            simp at his\r\n\r\n/-- ★★★ **O VEREDITO DECIDE COM A COTA**: satisfazível, a máquina do livro com o combustível da luz\r\nECOA — o silêncio é impossível dentro da cota: o terminal é morto pelo bootstrap (o invariante), e o\r\nfundo é morto pela contabilidade contra a cota do livro. A máquina do livro decide o lado do sim. -/\r\ntheorem o_veredito_decide_com_a_cota {n : ℕ} (φ : CNF n)\r\n    (hSAT : SAT φ) (fuel : ℕ) (hcomb : 2 * aCotaDoLivro n + 1 ≤ fuel) :\r\n    (processoComLivro φ fuel (fun _ => false)).1.isSome = true := by\r\n  generalize hp : processoComLivro φ fuel (fun _ => false) = R\r\n  obtain ⟨res, S', livro'⟩ := R\r\n  cases res with\r\n  | some w => rfl\r\n  | none =>\r\n    exfalso\r\n    unfold processoComLivro at hp\r\n    dsimp only [] at hp\r\n    have hmain := a_luz_nunca_cala_o_veredito_final φ fuel _ _ [] [] S' livro'\r\n      (o_estado_inicial_tem_luz φ hSAT) hp\r\n    cases hmain with\r\n    | inl hterm =>\r\n      obtain ⟨S₀, x₀, livro₀, hI₀, hterm0⟩ := hterm\r\n      exact o_terminal_impossivel φ S₀ x₀ livro₀ hI₀ hterm0\r\n    | inr hbot =>\r\n      obtain ⟨S₀, x₀, pilha₀, livro₀, hI₀, h0, harit⟩ := hbot\r\n      -- o fundo devolve o próprio estado: livro' = livro₀\r\n      have hlv : livro₀ = livro' := by\r\n        unfold lacoComLivro at h0\r\n        split at h0\r\n        · simp at h0\r\n        · rw [Prod.mk.injEq, Prod.mk.injEq] at h0\r\n          obtain ⟨-, -, hlv⟩ := h0\r\n          exact hlv\r\n      rw [hlv] at harit\r\n      have hcota := a_cota_do_livro φ fuel (fun _ => false) none S' livro' hp\r\n      simp at harit\r\n      omega\r\n\r\n/-- ★★ **O VEREDITO É HONESTO**: a máquina do livro nunca inventa luz — o eco só sai do custo zero. -/\r\ntheorem o_veredito_e_honesto {n : ℕ} (φ : CNF n) (fuel : ℕ) (x w : Fin n → Bool)\r\n    (h : (processoComLivro φ fuel x).1 = some w) : custoCNF φ w = 0 := by\r\n  unfold processoComLivro at h\r\n  dsimp only [] at h\r\n  exact o_eco_do_livro_e_fiel φ _ _ _ _ _ _ _ _ (Prod.ext_iff.mpr ⟨h, rfl⟩)\r\n\r\n/-- ★★ **A MEDIDA FINAL**: os muros, a família e a honestidade — a máquina do livro decide\r\no conjunto medido. -/\r\ntheorem a_medida_o_veredito_decide :\r\n    (processoComLivro phiTrap 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiCE 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiFofa2 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiTrap2 20 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro phiCadeia 12 (fun _ => false)).1.isSome = true\r\n    ∧ (processoComLivro ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 12 (fun _ => false)).1 = none := by\r\n  decide\r\n\r\nend TGLExt.ODentroOuMorto\r\n\r\n",
+    'TGLExt/AOQueSouEAContagem.lean': 'import TGLExt.ODentroOuMorto\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# O que sou é a contagem normalizada: a densidade do Nome das soluções\r\n\r\n## O que é\r\n\r\nNo referencial absoluto, o estado é a densidade maximamente misturada (`absoluteRho`), cuja expectativa é o traço normalizado. Lido\r\nsobre o Nome das soluções de uma fórmula, ele dá o número de soluções dividido por 2ⁿ: «o que sou» da fórmula é a sua densidade de\r\nsoluções.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★★ `o_card_do_cubo`: as atribuições de n variáveis são 2ⁿ.\r\n2. ★★ `o_que_sou_da_formula_e_a_contagem`: «o que sou» do Nome das soluções de uma CNF é o número de soluções dividido por 2ⁿ.\r\n3. ★★ `a_expectativa_do_absoluto_e_a_contagem`: a leitura do estado absoluto sobre o Nome das soluções é essa contagem normalizada.\r\n4. ★★★ `a_densidade_decide`: a fórmula tem solução se e só se a contagem normalizada é diferente de zero.\r\n5. ★★★ `a_maquina_le_a_densidade`: com combustível de pelo menos `2·aCotaDoLivro n + 1`, a busca com o livro responde com ponto se e\r\n   só se a contagem normalizada é diferente de zero.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Que a contagem se calcule em tempo polinomial: contar soluções é problema da classe #P [KNOWN]; nada aqui conta passos.\r\n* Que combustível polinomial baste para a busca do item 5: a cota é exponencial; a polinomial segue [OPEN].\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AOQueSouEAContagem\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo\r\nopen TGLExt.OSinalDeRetorno TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.ATensaoMinima\r\nopen TGLExt.AContagemDaTensaoMinima TGLExt.OMapaDosMuros TGLExt.APodaFechaOContorno TGLExt.AMedidaDaArvore\r\nopen TGLExt.AFamiliaProfunda TGLExt.ADescidaPinadaEmMemoria TGLExt.ALeituraCorrespondente\r\nopen TGLExt.OAlgoritmoPenP TGLExt.OLivroConsultado TGLExt.ODentroOuMorto\r\n\r\n/-- ★★ **O CARDINAL DO CUBO**: as atribuições de n variáveis são 2ⁿ. -/\r\ntheorem o_card_do_cubo (n : ℕ) : Fintype.card (Fin n → Bool) = 2 ^ n := by\r\n  rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]\r\n\r\n/-- ★★ **O QUE SOU DA FÓRMULA É A CONTAGEM NORMALIZADA**: no referencial absoluto, o peso do Nome das\r\nsoluções de uma CNF é o número de soluções dividido por 2ⁿ. -/\r\ntheorem o_que_sou_da_formula_e_a_contagem {n : ℕ} (φ : CNF n) :\r\n    TGLExt.Identidade.oQueSou (nomeDasSolucoes (custoCNF φ))\r\n      = ((((Finset.univ.filter (fun y => custoCNF φ y = 0)).card : ℝ) / ((2 ^ n : ℕ) : ℝ)) : ℂ) := by\r\n  rw [o_que_sou_das_solucoes, o_card_do_cubo]\r\n  push_cast\r\n  rfl\r\n\r\n/-- ★★★ **A DENSIDADE DECIDE**: a fórmula tem solução ⟺ a contagem normalizada é diferente de zero. -/\r\ntheorem a_densidade_decide {n : ℕ} (φ : CNF n) :\r\n    SAT φ ↔\r\n      ((((Finset.univ.filter (fun y => custoCNF φ y = 0)).card : ℝ) / ((2 ^ n : ℕ) : ℝ)) : ℂ) ≠ 0 := by\r\n  rw [← o_que_sou_da_formula_e_a_contagem]\r\n  constructor\r\n  · intro h\r\n    obtain ⟨y, hy⟩ := h\r\n    exact (o_tempo_cria_a_medida (custoCNF φ)).mpr ⟨y, (custoCNF_zero_sse φ y).mpr hy⟩\r\n  · intro h\r\n    obtain ⟨y, hy⟩ := (o_tempo_cria_a_medida (custoCNF φ)).mp h\r\n    exact ⟨y, (custoCNF_zero_sse φ y).mp hy⟩\r\n\r\n/-- ★★ **A EXPECTATIVA DO ABSOLUTO É A CONTAGEM**: a leitura do estado absoluto (ρ_Ψ = I/n) sobre o\r\nNome das soluções é o número de soluções dividido por 2ⁿ — o traço normalizado em ação. -/\r\ntheorem a_expectativa_do_absoluto_e_a_contagem {n : ℕ} (φ : CNF n) :\r\n    TGLExt.gibbs (absoluteRho (Fin n → Bool)) (nomeDasSolucoes (custoCNF φ)).P\r\n      = ((((Finset.univ.filter (fun y => custoCNF φ y = 0)).card : ℝ) / ((2 ^ n : ℕ) : ℝ)) : ℂ) :=\r\n  o_que_sou_da_formula_e_a_contagem φ\r\n\r\n/-- ★★★ **A MÁQUINA LÊ A DENSIDADE**: com o combustível da luz, a máquina do livro ecoa exatamente\r\nquando a contagem normalizada é diferente de zero — o algoritmo lê o «o que sou» da fórmula. (O fecho\r\ndo circuito: o estado absoluto mede, a máquina decide.) -/\r\ntheorem a_maquina_le_a_densidade {n : ℕ} (φ : CNF n) (fuel : ℕ)\r\n    (hcomb : 2 * aCotaDoLivro n + 1 ≤ fuel) :\r\n    (processoComLivro φ fuel (fun _ => false)).1.isSome = true ↔\r\n      ((((Finset.univ.filter (fun y => custoCNF φ y = 0)).card : ℝ) / ((2 ^ n : ℕ) : ℝ)) : ℂ) ≠ 0 := by\r\n  constructor\r\n  · intro h\r\n    obtain ⟨w, hw⟩ := Option.isSome_iff_exists.mp h\r\n    have h0 := o_veredito_e_honesto φ fuel _ w hw\r\n    exact (a_densidade_decide φ).mp ⟨w, (custoCNF_zero_sse φ w).mp h0⟩\r\n  · intro h\r\n    exact o_veredito_decide_com_a_cota φ ((a_densidade_decide φ).mpr h) fuel hcomb\r\n\r\nend TGLExt.AOQueSouEAContagem\r\n\r\n',
+    'TGLExt/AVerificadoraTM2.lean': "import TGLExt.AOQueSouEAContagem\r\nimport TGLExt.APonteAoTM2\r\nimport TGLExt.ATensaoMinima\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A verificadora TM2: a máquina da casa na língua padrão\r\n\r\n## O que é\r\n\r\n`aVerificadora` é uma máquina de Turing de pilhas da Mathlib (`Turing.FinTM2`) com seis pilhas (entrada, saída, fórmula, testemunha,\r\ncontagem, restauração) que recebe na entrada a fórmula e a testemunha (a leitura) codificadas e escreve na saída o veredito: verdadeiro\r\nse a testemunha satisfaz a fórmula, falso senão. O estado interno é finito (a fase, a falha da cláusula, a polaridade do marcador, o\r\núltimo símbolo lido, o bit lido). O programa tem quinze fases: copia a entrada invertendo, colhe a testemunha, percorre a fórmula\r\ninvertida literal a literal (conta os ticks, lê o marcador, procura o bit, restaura a testemunha, compara, salta o resto da cláusula\r\nsatisfeita), escreve o veredito e, antes de parar, drena a fórmula e a testemunha e zera o estado, de modo que a configuração final é a\r\nque a Mathlib exige (`haltList`). A máquina tem duas guardas: quando a testemunha se esgota antes dos ticks do índice, a fase\r\n`esgotaContagem` drena os ticks sem deslocar nem fabricar bit; e o casamento de um literal exige o bit presente antes de comparar o\r\nvalor. Um literal cujo índice passa do comprimento da testemunha nunca casa, como em `verificaNaFita`. `correr` itera o passo;\r\n`oVeredito` lê a saída da configuração parada, com combustível.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `PV`, `Fase`, `EstadoV`, `aVerificadora`, `correr`, `oVeredito` [DEF].\r\n2. ★★ `aAuxDaVerificadora`: as pilhas de entrada e de saída têm os alfabetos certos (`TM2ComputableAux`).\r\n3. ★★ `a_medida_a_verificadora_decide`: por `decide`, em cinco casos, o veredito da máquina bate com a verificação da casa.\r\n\r\n## O que NÃO se afirma\r\n\r\n* A correção geral e o tempo da verificadora, para toda fórmula e toda testemunha: estão em `AMaquinaVerificaCompleta`\r\n  (`a_maquina_verifica`, com combustível de no máximo L² + 20L + 10, sendo L o comprimento da entrada codificada) e em\r\n  `AMaquinaVerificaHabitante` (`a_verificadora_em_tempo_polinomial`).\r\n* Esta máquina recebe a leitura, não a procura: não decide SAT sem testemunha.\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AVerificadoraTM2\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\n\r\n/-- As pilhas da verificadora. -/\r\ninductive PV where\r\n  | entrada | saida | formula | testemunha | contagem | restaura\r\n  deriving DecidableEq, Fintype\r\n\r\n/-- As fases da verificadora. -/\r\ninductive Fase where\r\n  | copiaEntrada | colheTestemunha | inicioClausula | leMarcador\r\n  | contaTicks | procuraBit | esgotaContagem | restauraTestemunha | saltaLiterais\r\n  | escreveVerdade | escreveMentira | parada | limpaFormula | limpaTestemunha | paradaFinal\r\n  deriving DecidableEq, Fintype\r\n\r\n/-- O estado interno: a fase, a falha da cláusula, a polaridade do marcador, o último símbolo lido, o\r\nbit lido na procura. -/\r\nstructure EstadoV where\r\n  fase : Fase\r\n  falha : Bool\r\n  marcador : Bool\r\n  lido : Option Simbolo\r\n  bitLido : Option Simbolo\r\n  deriving DecidableEq, Fintype\r\n\r\n/-- [DEF] **A VERIFICADORA** (TM2): a máquina da casa na língua padrão. -/\r\ndef aVerificadora : Turing.FinTM2 where\r\n  K := PV\r\n  k₀ := PV.entrada\r\n  k₁ := PV.saida\r\n  Γ := fun k => match k with\r\n    | PV.saida => Bool\r\n    | _ => Simbolo\r\n  Λ := Fase\r\n  main := Fase.copiaEntrada\r\n  σ := EstadoV\r\n  initialState := ⟨Fase.copiaEntrada, false, false, none, none⟩\r\n  m := fun l =>\r\n    match l with\r\n    | Fase.copiaEntrada =>\r\n      pop PV.entrada (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido.isSome)\r\n          (push PV.formula (fun s => s.lido.getD Simbolo.zero) (goto fun _ => Fase.copiaEntrada))\r\n          (goto fun _ => Fase.colheTestemunha))\r\n    | Fase.colheTestemunha =>\r\n      peek PV.formula (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido == some Simbolo.sep)\r\n          (pop PV.formula (fun s _ => s) (goto fun _ => Fase.inicioClausula))\r\n          (branch (fun s => s.lido.isSome)\r\n            (pop PV.formula (fun s _ => s)\r\n              (push PV.testemunha (fun s => s.lido.getD Simbolo.zero)\r\n                (goto fun _ => Fase.colheTestemunha)))\r\n            (goto fun _ => Fase.inicioClausula)))\r\n    | Fase.inicioClausula =>\r\n      peek PV.formula (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido == some Simbolo.fimF)\r\n          (pop PV.formula (fun s _ => s) (goto fun _ => Fase.inicioClausula))\r\n          (branch (fun s => s.lido == some Simbolo.fimC)\r\n            (pop PV.formula (fun s _ => { s with falha := true })\r\n              (goto fun _ => Fase.leMarcador))\r\n            (branch (fun s => s.lido.isSome)\r\n              (goto fun _ => Fase.leMarcador)\r\n              (goto fun _ => Fase.escreveVerdade))))\r\n    | Fase.leMarcador =>\r\n      peek PV.formula (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido == some Simbolo.tick)\r\n          (pop PV.formula (fun s _ => s)\r\n            (push PV.contagem (fun _ => Simbolo.tick) (goto fun _ => Fase.leMarcador)))\r\n          (branch (fun s => s.lido == some Simbolo.litT)\r\n            (pop PV.formula (fun s _ => ⟨Fase.procuraBit, s.falha, true, s.lido, s.bitLido⟩)\r\n              (goto fun _ => Fase.procuraBit))\r\n            (branch (fun s => s.lido == some Simbolo.litF)\r\n              (pop PV.formula (fun s _ => ⟨Fase.procuraBit, s.falha, false, s.lido, s.bitLido⟩)\r\n                (goto fun _ => Fase.procuraBit))\r\n              (branch (fun s => s.lido == some Simbolo.fimC)\r\n                (branch (fun s => s.falha)\r\n                  (goto fun _ => Fase.escreveMentira)\r\n                  (pop PV.formula (fun s _ => s) (goto fun _ => Fase.inicioClausula)))\r\n                (branch (fun s => s.falha)\r\n                  (goto fun _ => Fase.escreveMentira)\r\n                  (goto fun _ => Fase.escreveVerdade))))))\r\n    | Fase.contaTicks =>\r\n      goto fun _ => Fase.leMarcador\r\n    | Fase.procuraBit =>\r\n      peek PV.contagem (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido.isSome)\r\n          (peek PV.testemunha (fun s b => { s with bitLido := b })\r\n            (branch (fun s => s.bitLido.isSome)\r\n              (pop PV.contagem (fun s _ => s)\r\n                (pop PV.testemunha (fun s b => { s with lido := b })\r\n                  (push PV.restaura (fun s => s.lido.getD Simbolo.zero)\r\n                    (goto fun _ => Fase.procuraBit))))\r\n              (goto fun _ => Fase.esgotaContagem)))\r\n          (peek PV.testemunha (fun s b => { s with bitLido := b })\r\n            (goto fun _ => Fase.restauraTestemunha)))\r\n    | Fase.esgotaContagem =>\r\n      pop PV.contagem (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido.isSome)\r\n          (goto fun _ => Fase.esgotaContagem)\r\n          (goto fun _ => Fase.restauraTestemunha))\r\n    | Fase.restauraTestemunha =>\r\n      peek PV.restaura (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido.isSome)\r\n          (pop PV.restaura (fun s _ => s)\r\n            (push PV.testemunha (fun s => s.lido.getD Simbolo.zero)\r\n              (goto fun _ => Fase.restauraTestemunha)))\r\n          (branch (fun s => s.bitLido.isSome && ((s.bitLido == some Simbolo.um) == s.marcador))\r\n            (load (fun s => { s with falha := false }) (goto fun _ => Fase.saltaLiterais))\r\n            (goto fun _ => Fase.leMarcador)))\r\n    | Fase.saltaLiterais =>\r\n      peek PV.formula (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido == some Simbolo.fimC)\r\n          (goto fun _ => Fase.inicioClausula)\r\n          (branch (fun s => s.lido.isSome)\r\n            (pop PV.formula (fun s _ => s) (goto fun _ => Fase.saltaLiterais))\r\n            (goto fun _ => Fase.escreveVerdade)))\r\n    | Fase.escreveVerdade =>\r\n      push PV.saida (fun _ => true) (goto fun _ => Fase.parada)\r\n    | Fase.escreveMentira =>\r\n      push PV.saida (fun _ => false) (goto fun _ => Fase.parada)\r\n    | Fase.parada =>\r\n      goto fun _ => Fase.limpaFormula\r\n    | Fase.limpaFormula =>\r\n      pop PV.formula (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido.isSome)\r\n          (goto fun _ => Fase.limpaFormula)\r\n          (goto fun _ => Fase.limpaTestemunha))\r\n    | Fase.limpaTestemunha =>\r\n      pop PV.testemunha (fun s b => { s with lido := b })\r\n        (branch (fun s => s.lido.isSome)\r\n          (goto fun _ => Fase.limpaTestemunha)\r\n          (load (fun _ => ⟨Fase.copiaEntrada, false, false, none, none⟩)\r\n            (goto fun _ => Fase.paradaFinal)))\r\n    | Fase.paradaFinal => halt\r\n\r\n/-- [DEF] O corredor: itera o passo até parar, devolvendo a configuração parada. -/\r\ndef correr (tm : Turing.FinTM2) : tm.Cfg → ℕ → Option tm.Cfg\r\n  | cfg, 0 => some cfg\r\n  | cfg, k + 1 => match Turing.FinTM2.step tm cfg with\r\n    | none => some cfg\r\n    | some c' => correr tm c' k\r\n\r\n/-- [DEF] O veredito da verificadora com combustível: a pilha da saída da configuração parada. -/\r\ndef oVeredito (entrada : List Simbolo) (fuel : ℕ) : Option (List Bool) :=\r\n  (correr aVerificadora (Turing.initList aVerificadora entrada) fuel).map (fun c => c.stk PV.saida)\r\n\r\n/-- ★★ **O AUXILIAR DE ALFABETOS MONTADO**: as pilhas de entrada e saída têm os alfabetos certos —\r\n`TM2ComputableAux` da verificadora. -/\r\ndef aAuxDaVerificadora : Turing.TM2ComputableAux Simbolo Bool where\r\n  tm := aVerificadora\r\n  inputAlphabet := Equiv.refl _\r\n  outputAlphabet := Equiv.refl _\r\n\r\n/-- ★★ **A MEDIDA: A VERIFICADORA DECIDE** — os cinco casos por `decide` na execução: o veredito da\r\nmáquina bate com a verificação da casa, nos muros e nos triviais. (Os combustíveis cobrem a limpeza\r\nfinal das pilhas antes da parada.) -/\r\ntheorem a_medida_a_verificadora_decide :\r\n    oVeredito (codificaEntrada ([[(0, true)]], [true])) 500 = some [true]\r\n    ∧ oVeredito (codificaEntrada ([[(0, true)]], [false])) 500 = some [false]\r\n    ∧ oVeredito (codificaEntrada ([[(0, true), (1, true)], [(0, false), (1, true)]],\r\n        [true, true])) 500 = some [true]\r\n    ∧ oVeredito (codificaEntrada (aFormulaNaFita phiCE,\r\n        aAtribuicaoNaFita (fun i => decide (i = (1 : Fin 3))))) 500 = some [true]\r\n    ∧ oVeredito (codificaEntrada (aFormulaNaFita phiCE,\r\n        aAtribuicaoNaFita (fun _ => true : Fin 3 → Bool))) 500 = some [false] := by\r\n  decide\r\n\r\nend TGLExt.AVerificadoraTM2\r\n\r\n",
+    'TGLExt/AMaquinaVerifica.lean': "import TGLExt.AVerificadoraTM2\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A máquina verifica: a cópia, a colheita e o início\r\n\r\n## O que é\r\n\r\nA correção da verificadora TM2 (`aVerificadora`) prova-se fase a fase: cada laço da máquina tem a sua forma fechada. Este módulo\r\nfecha os laços mecânicos do começo da corrida.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `stkDe`, `aConfig` [DEF]: as pilhas e a configuração, por nome.\r\n2. ★ `passo_copiaEntrada` e `copiaEntrada_fecha`: a cópia inverte a entrada e passa à colheita.\r\n3. ★ `passo_colheTestemunha_nil`, `passo_colheTestemunha_sep`, `passo_colheTestemunha_cons` e `colheTestemunha_fecha`: a colheita\r\n   separa os bits da testemunha.\r\n4. ★ `passo_inicioClausula` e `inicioClausula_fecha`: o início pula o terminador da fórmula e abre a cláusula com a falha armada.\r\n\r\n## O que NÃO se afirma\r\n\r\n* A correção geral e o tempo da verificadora, para toda fórmula e toda testemunha: estão em `AMaquinaVerificaCompleta`\r\n  (`a_maquina_verifica`, com combustível de no máximo L² + 20L + 10, sendo L o comprimento da entrada codificada) e em\r\n  `AMaquinaVerificaHabitante` (`a_verificadora_em_tempo_polinomial`).\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- [DEF] As pilhas da configuração, por nome. -/\r\ndef stkDe (e f t c r : List Simbolo) (out : List Bool) : ∀ k : PV, List (aVerificadora.Γ k)\r\n  | PV.entrada => e\r\n  | PV.saida => out\r\n  | PV.formula => f\r\n  | PV.testemunha => t\r\n  | PV.contagem => c\r\n  | PV.restaura => r\r\n\r\n/-- [DEF] A configuração por nome. -/\r\ndef aConfig (l : Option Fase) (v : EstadoV) (e f t c r : List Simbolo) (out : List Bool) :\r\n    aVerificadora.Cfg :=\r\n  ⟨l, v, stkDe e f t c r out⟩\r\n\r\n/-- ★ **O PASSO DA CÓPIA**: com a entrada não-vazia, o passo move um símbolo; vazia, passa à colheita. -/\r\ntheorem passo_copiaEntrada (v : EstadoV) (p t c r : List Simbolo) (out : List Bool) (w : List Simbolo) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.copiaEntrada) v w p t c r out)\r\n      = some (match w with\r\n        | [] => aConfig (some Fase.colheTestemunha) { v with lido := none } [] p t c r out\r\n        | s₀ :: w' => aConfig (some Fase.copiaEntrada) { v with lido := some s₀ } w' (s₀ :: p) t c r out) := by\r\n  cases w with\r\n  | nil =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | cons s₀ w' =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **A CÓPIA INVERTE**: o laço da `copiaEntrada` termina com a pilha `w.reverse ++ p` e vai para a\r\ncolheita. -/\r\ntheorem copiaEntrada_fecha (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    ∀ (w p : List Simbolo),\r\n      correr aVerificadora (aConfig (some Fase.copiaEntrada) v w p t c r out) (w.length + 1)\r\n        = some (aConfig (some Fase.colheTestemunha) { v with lido := none }\r\n            [] (w.reverse ++ p) t c r out) := by\r\n  intro w\r\n  induction w with\r\n  | nil =>\r\n    intro p\r\n    rw [correr, passo_copiaEntrada]\r\n    rfl\r\n  | cons s₀ w' ih =>\r\n    intro p\r\n    have h := ih (s₀ :: p)\r\n    show correr aVerificadora (aConfig (some Fase.copiaEntrada) v (s₀ :: w') p t c r out)\r\n        ((s₀ :: w').length + 1) = _\r\n    rw [List.length_cons, correr, passo_copiaEntrada, List.reverse_cons]\r\n    show correr aVerificadora (aConfig (some Fase.copiaEntrada)\r\n        { v with lido := some s₀ } w' (s₀ :: p) t c r out) (w'.length + 1) = _\r\n    rw [List.append_assoc]\r\n    exact h\r\n\r\n/-- ★ **O PASSO DA COLHEITA, NO VAZIO**: a colheita vazia vai ao início. -/\r\ntheorem passo_colheTestemunha_nil (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.colheTestemunha) v [] [] t c r out)\r\n      = some (aConfig (some Fase.inicioClausula) { v with lido := none } [] [] t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA COLHEITA, NA DIVISÓRIA**: a divisória é consumida e vai ao início. -/\r\ntheorem passo_colheTestemunha_sep (v : EstadoV) (f' t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.colheTestemunha) v [] (Simbolo.sep :: f') t c r out)\r\n      = some (aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.sep } [] f' t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA COLHEITA, NO BIT**: fora da divisória, o símbolo desce para a testemunha. -/\r\ntheorem passo_colheTestemunha_cons (v : EstadoV) (s₀ : Simbolo) (f' t c r : List Simbolo)\r\n    (out : List Bool) (hne : s₀ ≠ Simbolo.sep) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.colheTestemunha) v [] (s₀ :: f') t c r out)\r\n      = some (aConfig (some Fase.colheTestemunha) { v with lido := some s₀ } [] f' (s₀ :: t) c r out) := by\r\n  cases s₀ with\r\n  | tick =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.tick == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | litT =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.litT == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | litF =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.litF == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | fimC =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.fimC == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | fimF =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.fimF == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | sep =>\r\n    exact absurd rfl hne\r\n  | um =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.um == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | zero =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.zero == Simbolo.sep) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **A COLHEITA SEPARA**: o laço da `colheita`, com os bits w sem divisória à frente dela e o\r\nresto r' depois, termina com a testemunha `w.reverse ++ t` e a fórmula r'. -/\r\ntheorem colheTestemunha_fecha (v : EstadoV) (c r : List Simbolo) (out : List Bool) :\r\n    ∀ (w t r' : List Simbolo), (∀ s₀ ∈ w, s₀ ≠ Simbolo.sep) →\r\n      correr aVerificadora (aConfig (some Fase.colheTestemunha) v [] (w ++ Simbolo.sep :: r') t c r out)\r\n        (w.length + 1)\r\n        = some (aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.sep }\r\n            [] r' (w.reverse ++ t) c r out) := by\r\n  intro w\r\n  induction w with\r\n  | nil =>\r\n    intro t r' _\r\n    rw [List.nil_append, correr, passo_colheTestemunha_sep]\r\n    rfl\r\n  | cons s₀ w' ih =>\r\n    intro t r' hsep\r\n    have hne : s₀ ≠ Simbolo.sep := hsep s₀ List.mem_cons_self\r\n    have h := ih (s₀ :: t) r' (fun s₀ hs => hsep s₀ (List.mem_cons_of_mem _ hs))\r\n    show correr aVerificadora (aConfig (some Fase.colheTestemunha) v [] ((s₀ :: w') ++ Simbolo.sep :: r') t c r out)\r\n        ((s₀ :: w').length + 1) = _\r\n    rw [List.length_cons, List.cons_append, correr, passo_colheTestemunha_cons _ _ _ _ _ _ _ hne,\r\n      List.reverse_cons]\r\n    show correr aVerificadora (aConfig (some Fase.colheTestemunha)\r\n        { v with lido := some s₀ } [] (w' ++ Simbolo.sep :: r') (s₀ :: t) c r out) (w'.length + 1) = _\r\n    rw [List.append_assoc]\r\n    exact h\r\n\r\n/-- ★ **O PASSO DO INÍCIO**: pula o terminador da fórmula; no terminador de cláusula, arma a falha e\r\nvai ao marcador; no conteúdo, ao marcador; no vazio, escreve a verdade. -/\r\ntheorem passo_inicioClausula (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.inicioClausula) v [] f t c r out)\r\n      = some (match f with\r\n        | [] => aConfig (some Fase.escreveVerdade) { v with lido := none } [] f t c r out\r\n        | Simbolo.fimF :: f' => aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.fimF }\r\n            [] f' t c r out\r\n        | Simbolo.fimC :: f' => aConfig (some Fase.leMarcador)\r\n            { v with lido := some Simbolo.fimC, falha := true } [] f' t c r out\r\n        | s₀ :: f' => aConfig (some Fase.leMarcador) { v with lido := some s₀ } [] (s₀ :: f') t c r out) := by\r\n  cases f with\r\n  | nil =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | cons s₀ f' =>\r\n    cases s₀ with\r\n    | tick =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.tick == Simbolo.fimF) = false),\r\n        (by decide : (Simbolo.tick == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | litT =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.litT == Simbolo.fimF) = false),\r\n        (by decide : (Simbolo.litT == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | litF =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.litF == Simbolo.fimF) = false),\r\n        (by decide : (Simbolo.litF == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | fimC =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.fimC == Simbolo.fimF) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | fimF =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | sep =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.sep == Simbolo.fimF) = false),\r\n        (by decide : (Simbolo.sep == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | um =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.um == Simbolo.fimF) = false),\r\n        (by decide : (Simbolo.um == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | zero =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.zero == Simbolo.fimF) = false),\r\n        (by decide : (Simbolo.zero == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n\r\n/-- ★ **O INÍCIO ABRE A CLÁUSULA**: o `inicioClausula` pula o terminador da fórmula (uma vez) e, no\r\nterminador de cláusula, arma a falha e vai ao marcador. -/\r\ntheorem inicioClausula_fecha (v : EstadoV) (t c r : List Simbolo) (out : List Bool) (r' : List Simbolo) :\r\n    correr aVerificadora (aConfig (some Fase.inicioClausula) v []\r\n        (Simbolo.fimF :: Simbolo.fimC :: r') t c r out) 2\r\n      = some (aConfig (some Fase.leMarcador) { v with lido := some Simbolo.fimC, falha := true }\r\n          [] r' t c r out) := by\r\n  rw [correr, passo_inicioClausula]\r\n  show correr aVerificadora (aConfig (some Fase.inicioClausula)\r\n      { v with lido := some Simbolo.fimF } [] (Simbolo.fimC :: r') t c r out) 1 = _\r\n  rw [correr, passo_inicioClausula]\r\n  rfl\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerifica2.lean': "import TGLExt.AMaquinaVerifica\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A máquina verifica: os passos do ciclo do literal\r\n\r\n## O que é\r\n\r\nOs passos do ciclo em que a verificadora TM2 processa um literal (o marcador, a procura do bit, a restauração da testemunha e o salto),\r\ncada um reduzido por computação.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★ `passo_leMarcador_tick`, `passo_leMarcador_litT`, `passo_leMarcador_litF`, `passo_leMarcador_fimC`, `passo_leMarcador_nil`: o\r\n   marcador conta os ticks, lê a polaridade, e no fim da cláusula ou da entrada decide pela falha.\r\n2. ★ `passo_procuraBit_cons`, `passo_procuraBit_nil`: a procura desloca os bits e lê o bit da variável.\r\n3. ★ `passo_procuraBit_esgota`, `passo_esgotaContagem_cons`, `passo_esgotaContagem_nil`: com a testemunha esgotada, a máquina passa\r\n   ao esgotamento com o bit lido ausente e drena os ticks sem tocar em nada.\r\n4. ★ `passo_restauraTestemunha_cons`, `passo_restauraTestemunha_nil`: a restauração devolve a testemunha; o casamento exige o bit\r\n   presente e batendo o marcador, e desarma a falha.\r\n5. ★ `passo_saltaLiterais`: o salto consome até o próximo terminador de cláusula, ou até o fim da entrada.\r\n\r\n## O que NÃO se afirma\r\n\r\n* A correção geral e o tempo da verificadora, para toda fórmula e toda testemunha: estão em `AMaquinaVerificaCompleta`\r\n  (`a_maquina_verifica`, com combustível de no máximo L² + 20L + 10, sendo L o comprimento da entrada codificada) e em\r\n  `AMaquinaVerificaHabitante` (`a_verificadora_em_tempo_polinomial`).\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- ★ **O PASSO DO MARCADOR, NO TICK**: o tick desce da fórmula para a contagem. -/\r\ntheorem passo_leMarcador_tick (v : EstadoV) (f' t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.tick :: f') t c r out)\r\n      = some (aConfig (some Fase.leMarcador) { v with lido := some Simbolo.tick } [] f' t\r\n          (Simbolo.tick :: c) r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DO MARCADOR, NO LIT-T**: a polaridade verdadeira vai à procura. -/\r\ntheorem passo_leMarcador_litT (v : EstadoV) (f' t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.litT :: f') t c r out)\r\n      = some (aConfig (some Fase.procuraBit)\r\n          ⟨Fase.procuraBit, v.falha, true, some Simbolo.litT, v.bitLido⟩ [] f' t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons, (by decide : (Simbolo.litT == Simbolo.tick) = false)]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DO MARCADOR, NO LIT-F**: a polaridade falsa vai à procura. -/\r\ntheorem passo_leMarcador_litF (v : EstadoV) (f' t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.litF :: f') t c r out)\r\n      = some (aConfig (some Fase.procuraBit)\r\n          ⟨Fase.procuraBit, v.falha, false, some Simbolo.litF, v.bitLido⟩ [] f' t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons, (by decide : (Simbolo.litF == Simbolo.tick) = false),\r\n    (by decide : (Simbolo.litF == Simbolo.litT) = false)]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DO MARCADOR, NO FIM-DE-CLÁUSULA**: com falha armada, escreve a mentira; desarmada,\r\nconsome e reabre. -/\r\ntheorem passo_leMarcador_fimC (v : EstadoV) (f' t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.fimC :: f') t c r out)\r\n      = some (if v.falha then\r\n          aConfig (some Fase.escreveMentira) { v with lido := some Simbolo.fimC } [] (Simbolo.fimC :: f') t c r out\r\n        else aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.fimC } [] f' t c r out) := by\r\n  cases hf : v.falha with\r\n  | true =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.fimC == Simbolo.tick) = false),\r\n      (by decide : (Simbolo.fimC == Simbolo.litT) = false),\r\n      (by decide : (Simbolo.fimC == Simbolo.litF) = false), hf]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | false =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.fimC == Simbolo.tick) = false),\r\n      (by decide : (Simbolo.fimC == Simbolo.litT) = false),\r\n      (by decide : (Simbolo.fimC == Simbolo.litF) = false), hf]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **O PASSO DO MARCADOR, NO VAZIO**: o fim da entrada decide pela falha. -/\r\ntheorem passo_leMarcador_nil (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.leMarcador) v [] [] t c r out)\r\n      = some (if v.falha then\r\n          aConfig (some Fase.escreveMentira) { v with lido := none } [] [] t c r out\r\n        else aConfig (some Fase.escreveVerdade) { v with lido := none } [] [] t c r out) := by\r\n  cases hf : v.falha with\r\n  | true =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe, hf]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | false =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe, hf]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **O PASSO DA PROCURA, COM TICK E TESTEMUNHA**: desloca o bit da cabeça da testemunha para a\r\nrestauração — o bit lido é o da cabeça, presente. -/\r\ntheorem passo_procuraBit_cons (v : EstadoV) (b : Simbolo) (t' c' f r : List Simbolo)\r\n    (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.procuraBit) v [] f (b :: t') (Simbolo.tick :: c') r out)\r\n      = some (aConfig (some Fase.procuraBit) { v with lido := some b, bitLido := some b } [] f t' c'\r\n          (b :: r) out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA PROCURA, A TESTEMUNHA ESGOTADA**: o campo esgotado torna-se posto — a máquina\r\nvai ao esgotamento com o bit lido no silêncio (o `none`), sem fabricar presença. -/\r\ntheorem passo_procuraBit_esgota (v : EstadoV) (c' f r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.procuraBit) v [] f [] (Simbolo.tick :: c') r out)\r\n      = some (aConfig (some Fase.esgotaContagem)\r\n          { v with lido := some Simbolo.tick, bitLido := none } [] f [] (Simbolo.tick :: c') r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DO ESGOTAMENTO, COM TICK**: a drenagem consome um tick sem tocar em nada. -/\r\ntheorem passo_esgotaContagem_cons (v : EstadoV) (c' f t r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.esgotaContagem) v [] f t (Simbolo.tick :: c') r out)\r\n      = some (aConfig (some Fase.esgotaContagem) { v with lido := some Simbolo.tick } [] f t c' r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DO ESGOTAMENTO, VAZIO**: a drenagem finda — à restaura, com o bit no silêncio. -/\r\ntheorem passo_esgotaContagem_nil (v : EstadoV) (f t r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.esgotaContagem) v [] f t [] r out)\r\n      = some (aConfig (some Fase.restauraTestemunha) { v with lido := none } [] f t [] r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA PROCURA, SEM TICK**: peeks o bit da testemunha e vai restaurar. -/\r\ntheorem passo_procuraBit_nil (v : EstadoV) (f t r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.procuraBit) v [] f t [] r out)\r\n      = some (aConfig (some Fase.restauraTestemunha) { v with lido := none, bitLido := t.head? } [] f t [] r out) := by\r\n  cases t with\r\n  | nil =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | cons b' t' =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **O PASSO DA RESTAURA, COM BIT**: devolve um bit à testemunha. -/\r\ntheorem passo_restauraTestemunha_cons (v : EstadoV) (b : Simbolo) (r' f t c : List Simbolo)\r\n    (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.restauraTestemunha) v [] f t c (b :: r') out)\r\n      = some (aConfig (some Fase.restauraTestemunha) { v with lido := some b } [] f (b :: t) c r' out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA RESTAURA, VAZIA**: a guarda da presença — o casamento exige o bit presente e\r\nbatendo o marcador; a presença casada desarma a falha e salta; senão, ao próximo literal. -/\r\ntheorem passo_restauraTestemunha_nil (v : EstadoV) (f t c : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.restauraTestemunha) v [] f t c [] out)\r\n      = some (if v.bitLido.isSome && ((v.bitLido == some Simbolo.um) == v.marcador) then\r\n          aConfig (some Fase.saltaLiterais) { v with lido := none, falha := false } [] f t c [] out\r\n        else aConfig (some Fase.leMarcador) { v with lido := none } [] f t c [] out) := by\r\n  cases hb : (v.bitLido.isSome && ((v.bitLido == some Simbolo.um) == v.marcador)) with\r\n  | true =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe, hb]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | false =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe, hb]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **O PASSO DO SALTO**: consome até o próximo terminador de cláusula, ou ao fim da entrada. -/\r\ntheorem passo_saltaLiterais (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.saltaLiterais) v [] f t c r out)\r\n      = some (match f with\r\n        | [] => aConfig (some Fase.escreveVerdade) { v with lido := none } [] f t c r out\r\n        | Simbolo.fimC :: f' => aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.fimC }\r\n            [] (Simbolo.fimC :: f') t c r out\r\n        | s₀ :: f' => aConfig (some Fase.saltaLiterais) { v with lido := some s₀ } [] f' t c r out) := by\r\n  cases f with\r\n  | nil =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | cons s₀ f' =>\r\n    cases s₀ with\r\n    | fimC =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | tick =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.tick == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | litT =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.litT == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | litF =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.litF == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | fimF =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.fimF == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | sep =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.sep == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | um =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.um == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n    | zero =>\r\n      simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n        List.head?_cons, (by decide : (Simbolo.zero == Simbolo.fimC) = false)]\r\n      congr\r\n      try (funext k; cases k <;> rfl)\r\n      try rfl\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerifica3.lean': "import TGLExt.AMaquinaVerifica2\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A máquina verifica: os laços da procura, da restauração e do salto\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★ `procuraBit_fecha`: com a contagem cheia de ticks e o índice no alcance, a máquina desloca os bits e lê o bit da variável; a\r\n   contagem zera.\r\n2. ★ `esgotaContagem_fecha`: o esgotamento consome os ticks sem tocar em nada.\r\n3. ★★ `procuraBit_alem`: com o índice além do alcance, a máquina desloca a testemunha inteira, esgota os ticks sem inventar bit, e a\r\n   testemunha volta íntegra, com o bit lido ausente.\r\n4. ★ `restauraTestemunha_fecha`: a restauração devolve os bits à testemunha e, no fim, compara com a guarda da presença e decide.\r\n5. ★ `passo_saltaLiterais_cons` e `saltaLiterais_fecha`: o salto consome os símbolos até o próximo terminador, ou até o fim.\r\n\r\n## O que NÃO se afirma\r\n\r\n* A correção geral e o tempo da verificadora, para toda fórmula e toda testemunha: estão em `AMaquinaVerificaCompleta`\r\n  (`a_maquina_verifica`, com combustível de no máximo L² + 20L + 10, sendo L o comprimento da entrada codificada) e em\r\n  `AMaquinaVerificaHabitante` (`a_verificadora_em_tempo_polinomial`).\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- ★ **O LAÇO DA PROCURA**: com a contagem cheia de ticks e o índice no alcance, a máquina desloca\r\nos bits e lê o bit da variável — a contagem zera e a restaura cresce. -/\r\ntheorem procuraBit_fecha (v : EstadoV) (f r : List Simbolo) (out : List Bool) :\r\n    ∀ (i : ℕ) (t : List Simbolo), i ≤ t.length →\r\n      correr aVerificadora\r\n        (aConfig (some Fase.procuraBit) v [] f t (List.replicate i Simbolo.tick) r out) (i + 1)\r\n        = some (aConfig (some Fase.restauraTestemunha)\r\n            { v with lido := none, bitLido := (t.drop i).head? } [] f (t.drop i) []\r\n            ((t.take i).reverse ++ r) out) := by\r\n  intro i\r\n  induction i generalizing v r with\r\n  | zero =>\r\n    intro t _\r\n    show correr aVerificadora (aConfig (some Fase.procuraBit) v [] f t (List.replicate 0 Simbolo.tick) r out)\r\n        (0 + 1) = _\r\n    have h0 : List.replicate 0 Simbolo.tick = ([] : List Simbolo) := rfl\r\n    rw [h0, correr, passo_procuraBit_nil]\r\n    rfl\r\n  | succ i ih =>\r\n    intro t hle\r\n    show correr aVerificadora (aConfig (some Fase.procuraBit) v [] f t (List.replicate (i + 1) Simbolo.tick) r out)\r\n        (i + 1 + 1) = _\r\n    have hrep : List.replicate (i + 1) Simbolo.tick = Simbolo.tick :: List.replicate i Simbolo.tick :=\r\n      List.replicate_succ\r\n    rw [hrep]\r\n    cases t with\r\n    | nil =>\r\n      simp at hle\r\n    | cons b t' =>\r\n      rw [correr, passo_procuraBit_cons]\r\n      show correr aVerificadora (aConfig (some Fase.procuraBit)\r\n          { v with lido := some b, bitLido := some b } [] f t' (List.replicate i Simbolo.tick)\r\n          (b :: r) out) (i + 1) = _\r\n      have hle' : i ≤ t'.length := by\r\n        rw [List.length_cons] at hle\r\n        omega\r\n      rw [ih { v with lido := some b, bitLido := some b } (b :: r) t' hle']\r\n      show some (aConfig (some Fase.restauraTestemunha)\r\n          { { v with lido := some b, bitLido := some b } with\r\n            lido := none, bitLido := (t'.drop i).head? } [] f (t'.drop i) []\r\n          ((t'.take i).reverse ++ (b :: r)) out) = _\r\n      rw [List.drop_succ_cons, List.take_succ_cons, List.reverse_cons, List.append_assoc]\r\n      rfl\r\n\r\n/-- ★ **O LAÇO DO ESGOTAMENTO**: a drenagem consome os ticks sem tocar em nada — nada se fabrica. -/\r\ntheorem esgotaContagem_fecha (v : EstadoV) (f t r : List Simbolo) (out : List Bool) :\r\n    ∀ (i : ℕ),\r\n      correr aVerificadora\r\n        (aConfig (some Fase.esgotaContagem) v [] f t (List.replicate i Simbolo.tick) r out) (i + 1)\r\n        = some (aConfig (some Fase.restauraTestemunha) { v with lido := none } [] f t [] r out) := by\r\n  intro i\r\n  induction i generalizing v with\r\n  | zero =>\r\n    show correr aVerificadora (aConfig (some Fase.esgotaContagem) v [] f t\r\n        (List.replicate 0 Simbolo.tick) r out) (0 + 1) = _\r\n    have h0 : List.replicate 0 Simbolo.tick = ([] : List Simbolo) := rfl\r\n    rw [h0, correr, passo_esgotaContagem_nil]\r\n    rfl\r\n  | succ i ih =>\r\n    show correr aVerificadora (aConfig (some Fase.esgotaContagem) v [] f t\r\n        (List.replicate (i + 1) Simbolo.tick) r out) (i + 1 + 1) = _\r\n    have hrep : List.replicate (i + 1) Simbolo.tick = Simbolo.tick :: List.replicate i Simbolo.tick :=\r\n      List.replicate_succ\r\n    rw [hrep, correr, passo_esgotaContagem_cons]\r\n    show correr aVerificadora (aConfig (some Fase.esgotaContagem) { v with lido := some Simbolo.tick } []\r\n        f t (List.replicate i Simbolo.tick) r out) (i + 1) = _\r\n    rw [ih]\r\n\r\n/-- ★★ **A PROCURA ALÉM DA TESTEMUNHA**: com o índice estritamente além do alcance, a máquina\r\ndesloca a testemunha inteira, esgota os ticks sem inventar, e o bit lido é o silêncio (`none`) —\r\nnada se fabrica; a restaura devolve a testemunha íntegra. -/\r\ntheorem procuraBit_alem (v : EstadoV) (f r : List Simbolo) (out : List Bool) :\r\n    ∀ (i : ℕ) (t : List Simbolo), t.length < i →\r\n      correr aVerificadora\r\n        (aConfig (some Fase.procuraBit) v [] f t (List.replicate i Simbolo.tick) r out) (i + 2)\r\n        = some (aConfig (some Fase.restauraTestemunha)\r\n            { v with lido := none, bitLido := none } [] f [] [] (t.reverse ++ r) out) := by\r\n  intro i t\r\n  induction t generalizing v r i with\r\n  | nil =>\r\n    intro h\r\n    cases i with\r\n    | zero => simp at h\r\n    | succ j =>\r\n      show correr aVerificadora (aConfig (some Fase.procuraBit) v [] f []\r\n          (List.replicate (j + 1) Simbolo.tick) r out) (j + 1 + 2) = _\r\n      have hrep : List.replicate (j + 1) Simbolo.tick = Simbolo.tick :: List.replicate j Simbolo.tick :=\r\n        List.replicate_succ\r\n      rw [hrep, show j + 1 + 2 = (j + 2) + 1 from by omega, correr, passo_procuraBit_esgota]\r\n      show correr aVerificadora (aConfig (some Fase.esgotaContagem)\r\n          { v with lido := some Simbolo.tick, bitLido := none } [] f []\r\n          (Simbolo.tick :: List.replicate j Simbolo.tick) r out) (j + 1 + 1) = _\r\n      rw [← List.replicate_succ,\r\n        esgotaContagem_fecha { v with lido := some Simbolo.tick, bitLido := none } f [] r out (j + 1)]\r\n      rfl\r\n  | cons b t' ih =>\r\n    intro h\r\n    cases i with\r\n    | zero => simp at h\r\n    | succ j =>\r\n      have h' : t'.length < j := by\r\n        rw [List.length_cons] at h\r\n        omega\r\n      show correr aVerificadora (aConfig (some Fase.procuraBit) v [] f (b :: t')\r\n          (List.replicate (j + 1) Simbolo.tick) r out) (j + 1 + 2) = _\r\n      have hrep : List.replicate (j + 1) Simbolo.tick = Simbolo.tick :: List.replicate j Simbolo.tick :=\r\n        List.replicate_succ\r\n      rw [hrep, show j + 1 + 2 = (j + 2) + 1 from by omega, correr, passo_procuraBit_cons]\r\n      show correr aVerificadora (aConfig (some Fase.procuraBit)\r\n          { v with lido := some b, bitLido := some b } [] f t' (List.replicate j Simbolo.tick)\r\n          (b :: r) out) (j + 2) = _\r\n      rw [ih { v with lido := some b, bitLido := some b } (b :: r) j h']\r\n      show some (aConfig (some Fase.restauraTestemunha)\r\n          { { v with lido := some b, bitLido := some b } with lido := none, bitLido := none } [] f []\r\n          [] (t'.reverse ++ (b :: r)) out) = _\r\n      rw [List.reverse_cons, List.append_assoc]\r\n      rfl\r\n\r\n/-- ★ **O LAÇO DA RESTAURA**: devolve os bits à testemunha; no fim, a guarda da presença compara e\r\ndecide. -/\r\ntheorem restauraTestemunha_fecha (v : EstadoV) (f c : List Simbolo) (out : List Bool) :\r\n    ∀ (r t : List Simbolo),\r\n      correr aVerificadora\r\n        (aConfig (some Fase.restauraTestemunha) v [] f t c r out) (r.length + 1)\r\n        = some (if v.bitLido.isSome && ((v.bitLido == some Simbolo.um) == v.marcador) then\r\n            aConfig (some Fase.saltaLiterais) { v with lido := none, falha := false } [] f (r.reverse ++ t) c [] out\r\n          else aConfig (some Fase.leMarcador) { v with lido := none } [] f (r.reverse ++ t) c [] out) := by\r\n  intro r\r\n  induction r generalizing v with\r\n  | nil =>\r\n    intro t\r\n    show correr aVerificadora (aConfig (some Fase.restauraTestemunha) v [] f t c [] out) (0 + 1) = _\r\n    rw [correr, passo_restauraTestemunha_nil]\r\n    rfl\r\n  | cons b r' ih =>\r\n    intro t\r\n    show correr aVerificadora (aConfig (some Fase.restauraTestemunha) v [] f t c (b :: r') out)\r\n        ((b :: r').length + 1) = _\r\n    rw [List.length_cons, correr, passo_restauraTestemunha_cons]\r\n    show correr aVerificadora (aConfig (some Fase.restauraTestemunha)\r\n        { v with lido := some b } [] f (b :: t) c r' out) (r'.length + 1) = _\r\n    rw [ih]\r\n    cases hb : (v.bitLido.isSome && ((v.bitLido == some Simbolo.um) == v.marcador)) with\r\n    | true => simp [hb, List.reverse_cons, List.append_assoc]\r\n    | false => simp [hb, List.reverse_cons, List.append_assoc]\r\n\r\n/-- ★ **O PASSO DO SALTO, FORA DO TERMINADOR**: consome um símbolo qualquer. -/\r\ntheorem passo_saltaLiterais_cons (v : EstadoV) (s₀ : Simbolo) (f' t c r : List Simbolo)\r\n    (out : List Bool) (hne : s₀ ≠ Simbolo.fimC) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.saltaLiterais) v [] (s₀ :: f') t c r out)\r\n      = some (aConfig (some Fase.saltaLiterais) { v with lido := some s₀ } [] f' t c r out) := by\r\n  cases s₀ with\r\n  | tick =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.tick == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | litT =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.litT == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | litF =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.litF == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | fimC =>\r\n    exact absurd rfl hne\r\n  | fimF =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.fimF == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | sep =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.sep == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | um =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.um == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n  | zero =>\r\n    simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n      List.head?_cons, (by decide : (Simbolo.zero == Simbolo.fimC) = false)]\r\n    congr\r\n    try (funext k; cases k <;> rfl)\r\n    try rfl\r\n\r\n/-- ★ **O LAÇO DO SALTO**: consome os símbolos até o próximo terminador (ou o fim). -/\r\ntheorem saltaLiterais_fecha (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    ∀ (w f' : List Simbolo), (∀ s₀ ∈ w, s₀ ≠ Simbolo.fimC) →\r\n      correr aVerificadora (aConfig (some Fase.saltaLiterais) v [] (w ++ f') t c r out) (w.length + 1)\r\n        = some (match f' with\r\n          | [] => aConfig (some Fase.escreveVerdade) { v with lido := none } [] [] t c r out\r\n          | Simbolo.fimC :: f'' => aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.fimC }\r\n              [] (Simbolo.fimC :: f'') t c r out\r\n          | s₀ :: f'' => aConfig (some Fase.saltaLiterais) { v with lido := some s₀ } [] f'' t c r out) := by\r\n  intro w\r\n  induction w generalizing v with\r\n  | nil =>\r\n    intro f' _\r\n    show correr aVerificadora (aConfig (some Fase.saltaLiterais) v [] ([] ++ f') t c r out) (0 + 1) = _\r\n    rw [List.nil_append, correr, passo_saltaLiterais]\r\n    cases f' with\r\n    | nil => rfl\r\n    | cons s₀ f'' =>\r\n      cases s₀ with\r\n      | fimC => rfl\r\n      | tick => rfl\r\n      | litT => rfl\r\n      | litF => rfl\r\n      | fimF => rfl\r\n      | sep => rfl\r\n      | um => rfl\r\n      | zero => rfl\r\n  | cons s₀ w' ih =>\r\n    intro f' hne\r\n    have hs : s₀ ≠ Simbolo.fimC := hne s₀ List.mem_cons_self\r\n    have h := ih v f' (fun s₀ hs => hne s₀ (List.mem_cons_of_mem _ hs))\r\n    show correr aVerificadora (aConfig (some Fase.saltaLiterais) v [] ((s₀ :: w') ++ f') t c r out)\r\n        ((s₀ :: w').length + 1) = _\r\n    rw [List.length_cons, List.cons_append, correr]\r\n    show (match Turing.FinTM2.step aVerificadora\r\n        (aConfig (some Fase.saltaLiterais) v [] (s₀ :: (w' ++ f')) t c r out) with\r\n      | none => some (aConfig (some Fase.saltaLiterais) v [] (s₀ :: (w' ++ f')) t c r out)\r\n      | some c' => correr aVerificadora c' (w'.length + 1)) = _\r\n    rw [passo_saltaLiterais_cons v s₀ (w' ++ f') t c r out hs]\r\n    show correr aVerificadora (aConfig (some Fase.saltaLiterais)\r\n        { v with lido := some s₀ } [] (w' ++ f') t c r out) (w'.length + 1) = _\r\n    exact h\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerificaFinal.lean': "import TGLExt.AMaquinaVerifica3\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A máquina verifica: o literal, o veredito e a limpeza final\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★ `correr_add`: correr a + b passos é correr a passos e depois b passos do ponto alcançado.\r\n2. ★ `append_tick_replicate` (auxiliar de lista) e `leMarcador_ticks_fecha`: o marcador move os ticks da fórmula para a contagem, e o\r\n   estado sai com o último símbolo lido.\r\n3. ★★ `o_cauda_do_literal`: contada a contagem, marcado o marcador, procurado o bit, comparada a polaridade e restaurada a testemunha,\r\n   o casamento da máquina é o bit da variável batendo a polaridade do marcador.\r\n4. ★★ `o_literal_verifica`: com os ticks à frente do marcador, a testemunha cheia e o índice no alcance, o literal processa-se e a\r\n   máquina decide pelo casamento.\r\n5. ★★ `o_cauda_do_literal_alem` e `o_literal_verifica_alem`: com o índice além do alcance, o bit lido é ausente, a guarda da presença\r\n   não casa e a testemunha volta íntegra.\r\n6. ★★★ `o_literal_cobre`: para todo índice, dentro do alcance ou além, o literal processa-se, e o casamento é a guarda da presença\r\n   com o bit batendo a polaridade.\r\n7. ★ `passo_escreveVerdade`, `passo_escreveMentira`, `passo_parada`: a máquina escreve o veredito e passa à limpeza.\r\n8. ★ `passo_limpaFormula_cons`, `passo_limpaFormula_nil`, `passo_limpaTestemunha_cons`, `passo_limpaTestemunha_nil`,\r\n   `passo_paradaFinal`, `limpaFormula_fecha` e `limpaTestemunha_fecha`: a limpeza drena a fórmula e a testemunha, zera o estado e\r\n   apaga o rótulo.\r\n9. ★★ `a_limpeza_fecha`: da parada, em 1 + (|f| + 1) + (|t| + 1) + 1 passos, a máquina chega à configuração final limpa, com a saída\r\n   intacta.\r\n10. ★ `passo_parada_halt`: com o rótulo apagado, a máquina não anda.\r\n11. ★ `inicioClausula_vazio_fecha`: a fórmula vazia decide pela verdade em três passos.\r\n\r\n## O que NÃO se afirma\r\n\r\n* A correção geral e o tempo da verificadora, para toda fórmula e toda testemunha: estão em `AMaquinaVerificaCompleta`\r\n  (`a_maquina_verifica`, com combustível de no máximo L² + 20L + 10, sendo L o comprimento da entrada codificada) e em\r\n  `AMaquinaVerificaHabitante` (`a_verificadora_em_tempo_polinomial`).\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- ★ **O CORREDOR DECOMPÕE O COMBUSTÍVEL**: correr a+b é correr a e depois b do ponto alcançado. -/\r\ntheorem correr_add (tm : Turing.FinTM2) (c : tm.Cfg) :\r\n    ∀ (a b : ℕ), correr tm c (a + b) = (correr tm c a).bind (correr tm · b) := by\r\n  intro a\r\n  induction a generalizing c with\r\n  | zero =>\r\n    intro b\r\n    rw [Nat.zero_add]\r\n    rfl\r\n  | succ a ih =>\r\n    intro b\r\n    have h : a + 1 + b = (a + b) + 1 := by omega\r\n    rw [h, correr]\r\n    show (match Turing.FinTM2.step tm c with\r\n      | none => some c\r\n      | some c' => correr tm c' (a + b)) = _\r\n    cases hstep : Turing.FinTM2.step tm c with\r\n    | none =>\r\n      show some c = (correr tm c (a + 1)).bind (correr tm · b)\r\n      have h1 : ∀ n : ℕ, correr tm c n = some c := by\r\n        intro n\r\n        induction n with\r\n        | zero => rfl\r\n        | succ n _ => rw [correr, hstep]\r\n      simp only [h1, Option.bind_some]\r\n    | some c' =>\r\n      show correr tm c' (a + b) = (correr tm c (a + 1)).bind (correr tm · b)\r\n      have h2 : correr tm c (a + 1) = correr tm c' a := by\r\n        rw [correr, hstep]\r\n      rw [h2]\r\n      exact ih c' b\r\n\r\n/-- ★ **A PONTE DOS TICKS** (auxiliar de lista): o tick acumulado à esquerda é o replicate crescido. -/\r\ntheorem append_tick_replicate (i : ℕ) (c : List Simbolo) :\r\n    List.replicate i Simbolo.tick ++ (Simbolo.tick :: c)\r\n      = List.replicate (i + 1) Simbolo.tick ++ c := by\r\n  induction i generalizing c with\r\n  | zero => rfl\r\n  | succ i ih =>\r\n    have h1 : List.replicate (i + 1 + 1) Simbolo.tick ++ c\r\n        = Simbolo.tick :: (List.replicate (i + 1) Simbolo.tick ++ c) := by\r\n      rw [List.replicate_succ, List.cons_append]\r\n    have h2 : List.replicate (i + 1) Simbolo.tick ++ (Simbolo.tick :: c)\r\n        = Simbolo.tick :: (List.replicate i Simbolo.tick ++ (Simbolo.tick :: c)) := by\r\n      rw [List.replicate_succ, List.cons_append]\r\n    rw [h2, ih, h1]\r\n\r\n/-- ★ **O LAÇO DOS TICKS**: o marcador move os ticks da fórmula para a contagem; o estado sai com o\r\núltimo lido no tick. -/\r\ntheorem leMarcador_ticks_fecha (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    ∀ (j : ℕ) (f : List Simbolo),\r\n      correr aVerificadora\r\n        (aConfig (some Fase.leMarcador) v [] (List.replicate (j + 1) Simbolo.tick ++ f) t c r out)\r\n        (j + 1)\r\n        = some (aConfig (some Fase.leMarcador) { v with lido := some Simbolo.tick } [] f t\r\n            (List.replicate (j + 1) Simbolo.tick ++ c) r out) := by\r\n  intro j\r\n  induction j generalizing v c with\r\n  | zero =>\r\n    intro f\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.tick :: f) t c r out) 1\r\n        = some (aConfig (some Fase.leMarcador) { v with lido := some Simbolo.tick } [] f t\r\n            (Simbolo.tick :: c) r out)\r\n    rw [correr, passo_leMarcador_tick]\r\n    rfl\r\n  | succ j ih =>\r\n    intro f\r\n    have hrep : List.replicate (j + 1 + 1) Simbolo.tick ++ f\r\n        = Simbolo.tick :: (List.replicate (j + 1) Simbolo.tick ++ f) := by\r\n      rw [List.replicate_succ, List.cons_append]\r\n    rw [hrep, correr, passo_leMarcador_tick]\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) { v with lido := some Simbolo.tick } []\r\n        (List.replicate (j + 1) Simbolo.tick ++ f) t (Simbolo.tick :: c) r out) (j + 1) = _\r\n    rw [ih { v with lido := some Simbolo.tick } (Simbolo.tick :: c) f, append_tick_replicate]\r\n\r\n/-- ★★ **A CAUDA DO LITERAL**: contada a contagem, marcado o marcador, procurado o bit, comparada a\r\npolaridade e restaurada a testemunha — o casamento da máquina é o bit da variável batendo o\r\nmarcador; a testemunha volta íntegra. -/\r\ntheorem o_cauda_do_literal (v : EstadoV) (w f : List Simbolo) (out : List Bool)\r\n    (i : ℕ) (pol : Bool) (hle : i ≤ w.length) :\r\n    correr aVerificadora\r\n      (aConfig (some Fase.leMarcador) v []\r\n        ((if pol then Simbolo.litT else Simbolo.litF) :: f)\r\n        w (List.replicate i Simbolo.tick) [] out) (1 + (i + 1) + (i + 1))\r\n      = some (if ((w.drop i).head?.isSome && (((w.drop i).head? == some Simbolo.um) == pol)) then\r\n          aConfig (some Fase.saltaLiterais)\r\n            ⟨Fase.procuraBit, false, pol, none, (w.drop i).head?⟩ [] f w [] [] out\r\n        else aConfig (some Fase.leMarcador)\r\n            ⟨Fase.procuraBit, v.falha, pol, none, (w.drop i).head?⟩ [] f w [] [] out) := by\r\n  have hcomb : 1 + (i + 1) + (i + 1) = ((i + 1) + (i + 1)) + 1 := by omega\r\n  have hlen : ((w.take i).reverse ++ ([] : List Simbolo)).length = i := by\r\n    rw [List.length_append, List.length_reverse, List.length_take, List.length_nil, Nat.add_zero,\r\n      Nat.min_eq_left hle]\r\n  have hfuel : i + 1 = ((w.take i).reverse ++ ([] : List Simbolo)).length + 1 := by rw [hlen]\r\n  cases pol with\r\n  | true =>\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.litT :: f)\r\n        w (List.replicate i Simbolo.tick) [] out) (1 + (i + 1) + (i + 1)) = _\r\n    rw [hcomb, correr, passo_leMarcador_litT]\r\n    show correr aVerificadora (aConfig (some Fase.procuraBit)\r\n        ⟨Fase.procuraBit, v.falha, true, some Simbolo.litT, v.bitLido⟩ [] f w\r\n        (List.replicate i Simbolo.tick) [] out) ((i + 1) + (i + 1)) = _\r\n    rw [correr_add,\r\n      procuraBit_fecha ⟨Fase.procuraBit, v.falha, true, some Simbolo.litT, v.bitLido⟩ f [] out i w\r\n        hle]\r\n    simp only [Option.bind_some]\r\n    rw [hfuel, restauraTestemunha_fecha]\r\n    rw [List.append_nil, List.reverse_reverse, List.take_append_drop]\r\n  | false =>\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.litF :: f)\r\n        w (List.replicate i Simbolo.tick) [] out) (1 + (i + 1) + (i + 1)) = _\r\n    rw [hcomb, correr, passo_leMarcador_litF]\r\n    show correr aVerificadora (aConfig (some Fase.procuraBit)\r\n        ⟨Fase.procuraBit, v.falha, false, some Simbolo.litF, v.bitLido⟩ [] f w\r\n        (List.replicate i Simbolo.tick) [] out) ((i + 1) + (i + 1)) = _\r\n    rw [correr_add,\r\n      procuraBit_fecha ⟨Fase.procuraBit, v.falha, false, some Simbolo.litF, v.bitLido⟩ f [] out i w\r\n        hle]\r\n    simp only [Option.bind_some]\r\n    rw [hfuel, restauraTestemunha_fecha]\r\n    rw [List.append_nil, List.reverse_reverse, List.take_append_drop]\r\n\r\n/-- ★★ **O LITERAL VERIFICA**: com os ticks à frente do marcador (a fita invertida), a testemunha\r\ncheia e o índice no alcance, o literal processa-se por inteiro: o casamento é o bit batendo a\r\npolaridade. -/\r\ntheorem o_literal_verifica (v : EstadoV) (w f : List Simbolo) (out : List Bool)\r\n    (i : ℕ) (pol : Bool) (hle : i ≤ w.length) :\r\n    correr aVerificadora\r\n      (aConfig (some Fase.leMarcador) v []\r\n        (List.replicate i Simbolo.tick ++ (if pol then Simbolo.litT else Simbolo.litF) :: f)\r\n        w [] [] out) (i + 1 + (i + 1) + (i + 1))\r\n      = some (if ((w.drop i).head?.isSome && (((w.drop i).head? == some Simbolo.um) == pol)) then\r\n          aConfig (some Fase.saltaLiterais)\r\n            ⟨Fase.procuraBit, false, pol, none, (w.drop i).head?⟩ [] f w [] [] out\r\n        else aConfig (some Fase.leMarcador)\r\n            ⟨Fase.procuraBit, v.falha, pol, none, (w.drop i).head?⟩ [] f w [] [] out) := by\r\n  cases i with\r\n  | zero =>\r\n    exact o_cauda_do_literal v w f out 0 pol (Nat.zero_le _)\r\n  | succ j =>\r\n    have hcomb : j + 1 + 1 + (j + 1 + 1) + (j + 1 + 1)\r\n        = (j + 1) + (1 + (j + 1 + 1) + (j + 1 + 1)) := by omega\r\n    rw [hcomb, correr_add, leMarcador_ticks_fecha]\r\n    simp only [Option.bind_some]\r\n    rw [List.append_nil]\r\n    exact o_cauda_do_literal { v with lido := some Simbolo.tick } w f out (j + 1) pol hle\r\n\r\n/-- ★★ **A CAUDA DO LITERAL ALÉM DA TESTEMUNHA**: marcado o marcador e esgotada a procura sem\r\ninventar, o bit lido é o silêncio — a guarda da presença não casa nunca; a testemunha volta\r\níntegra. -/\r\ntheorem o_cauda_do_literal_alem (v : EstadoV) (w f : List Simbolo) (out : List Bool)\r\n    (i : ℕ) (pol : Bool) (hle : w.length < i) :\r\n    correr aVerificadora\r\n      (aConfig (some Fase.leMarcador) v []\r\n        ((if pol then Simbolo.litT else Simbolo.litF) :: f)\r\n        w (List.replicate i Simbolo.tick) [] out) (1 + (i + 2) + (w.length + 1))\r\n      = some (aConfig (some Fase.leMarcador)\r\n          ⟨Fase.procuraBit, v.falha, pol, none, none⟩ [] f w [] [] out) := by\r\n  have hcomb : 1 + (i + 2) + (w.length + 1) = ((i + 2) + (w.length + 1)) + 1 := by omega\r\n  cases pol with\r\n  | true =>\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.litT :: f)\r\n        w (List.replicate i Simbolo.tick) [] out) (1 + (i + 2) + (w.length + 1)) = _\r\n    rw [hcomb, correr, passo_leMarcador_litT]\r\n    show correr aVerificadora (aConfig (some Fase.procuraBit)\r\n        ⟨Fase.procuraBit, v.falha, true, some Simbolo.litT, v.bitLido⟩ [] f w\r\n        (List.replicate i Simbolo.tick) [] out) ((i + 2) + (w.length + 1)) = _\r\n    rw [correr_add,\r\n      procuraBit_alem ⟨Fase.procuraBit, v.falha, true, some Simbolo.litT, v.bitLido⟩ f [] out i w hle]\r\n    simp only [Option.bind_some]\r\n    have hlen : (w.reverse ++ ([] : List Simbolo)).length = w.length := by\r\n      rw [List.length_append, List.length_reverse, List.length_nil, Nat.add_zero]\r\n    have hfuel : w.length + 1 = (w.reverse ++ ([] : List Simbolo)).length + 1 := by rw [hlen]\r\n    rw [hfuel, restauraTestemunha_fecha]\r\n    simp only [List.append_nil, List.reverse_reverse]\r\n    rfl\r\n  | false =>\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.litF :: f)\r\n        w (List.replicate i Simbolo.tick) [] out) (1 + (i + 2) + (w.length + 1)) = _\r\n    rw [hcomb, correr, passo_leMarcador_litF]\r\n    show correr aVerificadora (aConfig (some Fase.procuraBit)\r\n        ⟨Fase.procuraBit, v.falha, false, some Simbolo.litF, v.bitLido⟩ [] f w\r\n        (List.replicate i Simbolo.tick) [] out) ((i + 2) + (w.length + 1)) = _\r\n    rw [correr_add,\r\n      procuraBit_alem ⟨Fase.procuraBit, v.falha, false, some Simbolo.litF, v.bitLido⟩ f [] out i w\r\n        hle]\r\n    simp only [Option.bind_some]\r\n    have hlen : (w.reverse ++ ([] : List Simbolo)).length = w.length := by\r\n      rw [List.length_append, List.length_reverse, List.length_nil, Nat.add_zero]\r\n    have hfuel : w.length + 1 = (w.reverse ++ ([] : List Simbolo)).length + 1 := by rw [hlen]\r\n    rw [hfuel, restauraTestemunha_fecha]\r\n    simp only [List.append_nil, List.reverse_reverse]\r\n    rfl\r\n\r\n/-- ★★ **O LITERAL ALÉM DA TESTEMUNHA**: com os ticks à frente do marcador e o índice além do\r\nalcance, o bit lido é o silêncio e a guarda não casa — o literal não serve. -/\r\ntheorem o_literal_verifica_alem (v : EstadoV) (w f : List Simbolo) (out : List Bool)\r\n    (i : ℕ) (pol : Bool) (hle : w.length < i) :\r\n    correr aVerificadora\r\n      (aConfig (some Fase.leMarcador) v []\r\n        (List.replicate i Simbolo.tick ++ (if pol then Simbolo.litT else Simbolo.litF) :: f)\r\n        w [] [] out) (i + 1 + (i + 2) + (w.length + 1))\r\n      = some (aConfig (some Fase.leMarcador)\r\n          ⟨Fase.procuraBit, v.falha, pol, none, none⟩ [] f w [] [] out) := by\r\n  cases i with\r\n  | zero => simp at hle\r\n  | succ j =>\r\n    have hcomb : j + 1 + 1 + (j + 1 + 2) + (w.length + 1)\r\n        = (j + 1) + (1 + (j + 1 + 2) + (w.length + 1)) := by omega\r\n    rw [hcomb, correr_add, leMarcador_ticks_fecha]\r\n    simp only [Option.bind_some]\r\n    rw [List.append_nil]\r\n    exact o_cauda_do_literal_alem { v with lido := some Simbolo.tick } w f out (j + 1) pol hle\r\n\r\n/-- ★★★ **O LITERAL COBRE TODO ÍNDICE, COM A COTA**: dentro do alcance ou além, o literal\r\nprocessa-se com combustível limitado — a cota do literal é linear no índice e na testemunha. -/\r\ntheorem o_literal_cobre (v : EstadoV) (w f : List Simbolo) (out : List Bool)\r\n    (i : ℕ) (pol : Bool) :\r\n    ∃ fuel : ℕ, fuel ≤ 3 * (i + 1) + (w.length + 1) + 3 ∧\r\n      correr aVerificadora\r\n        (aConfig (some Fase.leMarcador) v []\r\n          (List.replicate i Simbolo.tick ++ (if pol then Simbolo.litT else Simbolo.litF) :: f)\r\n          w [] [] out) fuel\r\n        = some (if ((w.drop i).head?.isSome && (((w.drop i).head? == some Simbolo.um) == pol)) then\r\n            aConfig (some Fase.saltaLiterais)\r\n              ⟨Fase.procuraBit, false, pol, none, (w.drop i).head?⟩ [] f w [] [] out\r\n          else aConfig (some Fase.leMarcador)\r\n              ⟨Fase.procuraBit, v.falha, pol, none, (w.drop i).head?⟩ [] f w [] [] out) := by\r\n  cases Nat.lt_or_ge i w.length with\r\n  | inl h =>\r\n    refine ⟨i + 1 + (i + 1) + (i + 1), by omega,\r\n      o_literal_verifica v w f out i pol (Nat.le_of_lt h)⟩\r\n  | inr h =>\r\n    cases Nat.eq_or_lt_of_le h with\r\n    | inl heq =>\r\n      refine ⟨i + 1 + (i + 1) + (i + 1), by omega,\r\n        o_literal_verifica v w f out i pol (Nat.le_of_eq heq.symm)⟩\r\n    | inr hlt =>\r\n      have hdrop : w.drop i = [] := by\r\n        have hlen : (w.drop i).length = 0 := by\r\n          rw [List.length_drop]\r\n          omega\r\n        exact List.eq_nil_of_length_eq_zero hlen\r\n      have hcond : ((w.drop i).head?.isSome && (((w.drop i).head? == some Simbolo.um) == pol))\r\n          = false := by\r\n        rw [hdrop]\r\n        rfl\r\n      rw [hcond, hdrop, if_neg (by decide : ¬(false = true))]\r\n      exact ⟨i + 1 + (i + 2) + (w.length + 1), by omega,\r\n        o_literal_verifica_alem v w f out i pol hlt⟩\r\n\r\n/-- ★ **O PASSO DA VERDADE**: escreve a luz na saída e vai à parada. -/\r\ntheorem passo_escreveVerdade (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.escreveVerdade) v [] f t c r out)\r\n      = some (aConfig (some Fase.parada) v [] f t c r (true :: out)) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA MENTIRA**: escreve a ausência na saída e vai à parada. -/\r\ntheorem passo_escreveMentira (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.escreveMentira) v [] f t c r out)\r\n      = some (aConfig (some Fase.parada) v [] f t c r (false :: out)) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA PARADA**: a parada vai à limpeza da fórmula. -/\r\ntheorem passo_parada (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.parada) v [] f t c r out)\r\n      = some (aConfig (some Fase.limpaFormula) v [] f t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig]\r\n  rfl\r\n\r\n/-- ★ **O PASSO DA LIMPA-FÓRMULA, COM SÍMBOLO**: drena um símbolo da fórmula. -/\r\ntheorem passo_limpaFormula_cons (v : EstadoV) (s₀ : Simbolo) (f' t c r : List Simbolo)\r\n    (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.limpaFormula) v [] (s₀ :: f') t c r out)\r\n      = some (aConfig (some Fase.limpaFormula) { v with lido := some s₀ } [] f' t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA LIMPA-FÓRMULA, VAZIA**: a fórmula limpa, à limpa-testemunha. -/\r\ntheorem passo_limpaFormula_nil (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.limpaFormula) v [] [] t c r out)\r\n      = some (aConfig (some Fase.limpaTestemunha) { v with lido := none } [] [] t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA LIMPA-TESTEMUNHA, COM SÍMBOLO**: drena um símbolo da testemunha. -/\r\ntheorem passo_limpaTestemunha_cons (v : EstadoV) (s₀ : Simbolo) (t' f c r : List Simbolo)\r\n    (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.limpaTestemunha) v [] f (s₀ :: t') c r out)\r\n      = some (aConfig (some Fase.limpaTestemunha) { v with lido := some s₀ } [] f t' c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe,\r\n    List.head?_cons]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA LIMPA-TESTEMUNHA, VAZIA**: a testemunha limpa, o estado zera-se — ao halt final. -/\r\ntheorem passo_limpaTestemunha_nil (v : EstadoV) (f c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora\r\n      (aConfig (some Fase.limpaTestemunha) v [] f [] c r out)\r\n      = some (aConfig (some Fase.paradaFinal)\r\n          ⟨Fase.copiaEntrada, false, false, none, none⟩ [] f [] c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig, stkDe]\r\n  congr\r\n  try (funext k; cases k <;> rfl)\r\n  try rfl\r\n\r\n/-- ★ **O PASSO DA PARADA FINAL**: o halt — o rótulo apaga-se com a casa limpa. -/\r\ntheorem passo_paradaFinal (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig (some Fase.paradaFinal) v [] f t c r out)\r\n      = some (aConfig none v [] f t c r out) := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aVerificadora, Turing.TM2.stepAux, aConfig]\r\n  rfl\r\n\r\n/-- ★ **O LAÇO DA LIMPA-FÓRMULA**: drena a fórmula inteira. -/\r\ntheorem limpaFormula_fecha (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    ∀ (f : List Simbolo),\r\n      correr aVerificadora (aConfig (some Fase.limpaFormula) v [] f t c r out) (f.length + 1)\r\n        = some (aConfig (some Fase.limpaTestemunha) { v with lido := none } [] [] t c r out) := by\r\n  intro f\r\n  induction f generalizing v with\r\n  | nil =>\r\n    show correr aVerificadora (aConfig (some Fase.limpaFormula) v [] [] t c r out) (0 + 1) = _\r\n    rw [correr, passo_limpaFormula_nil]\r\n    rfl\r\n  | cons s₀ f' ih =>\r\n    show correr aVerificadora (aConfig (some Fase.limpaFormula) v [] (s₀ :: f') t c r out)\r\n        ((s₀ :: f').length + 1) = _\r\n    rw [List.length_cons, correr, passo_limpaFormula_cons]\r\n    show correr aVerificadora (aConfig (some Fase.limpaFormula) { v with lido := some s₀ } [] f'\r\n        t c r out) (f'.length + 1) = _\r\n    rw [ih]\r\n\r\n/-- ★ **O LAÇO DA LIMPA-TESTEMUNHA**: drena a testemunha inteira; no fim, o estado zera-se. -/\r\ntheorem limpaTestemunha_fecha (v : EstadoV) (f c r : List Simbolo) (out : List Bool) :\r\n    ∀ (t : List Simbolo),\r\n      correr aVerificadora (aConfig (some Fase.limpaTestemunha) v [] f t c r out) (t.length + 1)\r\n        = some (aConfig (some Fase.paradaFinal)\r\n            ⟨Fase.copiaEntrada, false, false, none, none⟩ [] f [] c r out) := by\r\n  intro t\r\n  induction t generalizing v with\r\n  | nil =>\r\n    show correr aVerificadora (aConfig (some Fase.limpaTestemunha) v [] f [] c r out) (0 + 1) = _\r\n    rw [correr, passo_limpaTestemunha_nil]\r\n    rfl\r\n  | cons s₀ t' ih =>\r\n    show correr aVerificadora (aConfig (some Fase.limpaTestemunha) v [] f (s₀ :: t') c r out)\r\n        ((s₀ :: t').length + 1) = _\r\n    rw [List.length_cons, correr, passo_limpaTestemunha_cons]\r\n    show correr aVerificadora (aConfig (some Fase.limpaTestemunha) { v with lido := some s₀ } [] f\r\n        t' c r out) (t'.length + 1) = _\r\n    rw [ih]\r\n\r\n/-- ★★ **A LIMPEZA FECHA**: da parada à configuração final limpa — a fórmula e a testemunha\r\ndrenadas, o estado zerado, o rótulo apagado: a casa em ordem para o `haltList` da Mathlib. -/\r\ntheorem a_limpeza_fecha (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    correr aVerificadora (aConfig (some Fase.parada) v [] f t c r out)\r\n        (1 + (f.length + 1) + (t.length + 1) + 1)\r\n      = some (aConfig none ⟨Fase.copiaEntrada, false, false, none, none⟩ [] [] [] c r out) := by\r\n  rw [correr, passo_parada]\r\n  show correr aVerificadora (aConfig (some Fase.limpaFormula) v [] f t c r out)\r\n      (1 + (f.length + 1) + (t.length + 1)) = _\r\n  have hcomb : 1 + (f.length + 1) + (t.length + 1)\r\n      = (f.length + 1) + (1 + (t.length + 1)) := by omega\r\n  rw [hcomb, correr_add, limpaFormula_fecha]\r\n  simp only [Option.bind_some]\r\n  have hcomb2 : 1 + (t.length + 1) = (t.length + 1) + 1 := by omega\r\n  rw [hcomb2, correr_add, limpaTestemunha_fecha]\r\n  simp only [Option.bind_some]\r\n  rw [correr, passo_paradaFinal]\r\n  rfl\r\n\r\n/-- ★ **O PASSO PARADO**: com o rótulo apagado, a máquina não anda — o `none` da Mathlib. -/\r\ntheorem passo_parada_halt (v : EstadoV) (f t c r : List Simbolo) (out : List Bool) :\r\n    Turing.FinTM2.step aVerificadora (aConfig none v [] f t c r out) = none := by\r\n  simp [Turing.FinTM2.step, Turing.TM2.step, aConfig]\r\n  rfl\r\n\r\n/-- ★ **OS TRÊS PASSOS DO VAZIO**: a fórmula vazia decide a verdade — o terminador da fórmula, o\r\nfim da entrada, a luz escrita, a parada. -/\r\ntheorem inicioClausula_vazio_fecha (v : EstadoV) (t c r : List Simbolo) (out : List Bool) :\r\n    correr aVerificadora (aConfig (some Fase.inicioClausula) v [] [Simbolo.fimF] t c r out) 3\r\n      = some (aConfig (some Fase.parada) { v with lido := none } [] [] t c r (true :: out)) := by\r\n  rw [correr, passo_inicioClausula]\r\n  show correr aVerificadora (aConfig (some Fase.inicioClausula) { v with lido := some Simbolo.fimF }\r\n      [] [] t c r out) 2 = _\r\n  rw [correr, passo_inicioClausula]\r\n  show correr aVerificadora (aConfig (some Fase.escreveVerdade) { v with lido := none } [] [] t c r\r\n      out) 1 = _\r\n  rw [correr, passo_escreveVerdade]\r\n  rfl\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerificaCorrida.lean': "import TGLExt.AMaquinaVerificaFinal\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A máquina verifica: o bloco da cláusula e a corrida, com as cotas de passos\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `litNaPilha`, `clausulaNaPilha`, `pilhaDaCorrida` [DEF]: o literal, a cláusula e a corrida na pilha (a fita invertida).\r\n2. `cotaLit`, `cotaBloco`, `cotaCorrida` [DEF]: as cotas de passos do literal, da cláusula e da corrida; ★ `cotaBloco_reverse` e\r\n   `cotaCorrida_reverse`: as cotas não dependem da ordem.\r\n3. ★ `litNaPilha_ne_fimC` e `flatMap_litNaPilha_ne_fimC` (auxiliares do salto): o conteúdo de uma cláusula na pilha não tem terminador.\r\n4. ★★ `o_bloco_casa_medio`: com a falha armada e o resto da pilha depois do terminador, os literais processam-se, com qualquer índice,\r\n   dentro do alcance ou além, em no máximo `cotaBloco` passos; o casamento desarma a falha, salta o resto da cláusula e reabre o\r\n   ciclo; o descasamento de todos os literais escreve o veredito falso.\r\n5. ★★ `o_bloco_casa_ultimo`: no fim da pilha, o casamento desarma a falha e o salto encontra o fim: a máquina escreve o veredito\r\n   verdadeiro.\r\n6. ★★★ `a_corrida_verifica`: a corrida decide a lista das cláusulas, em no máximo `cotaCorrida` passos: a máquina chega à parada com o\r\n   veredito verdadeiro se todas as cláusulas têm casamento, e com o falso senão.\r\n\r\n## O que NÃO se afirma\r\n\r\n* A correção geral e o tempo da verificadora, para toda fórmula e toda testemunha: estão em `AMaquinaVerificaCompleta`\r\n  (`a_maquina_verifica`, com combustível de no máximo L² + 20L + 10, sendo L o comprimento da entrada codificada) e em\r\n  `AMaquinaVerificaHabitante` (`a_verificadora_em_tempo_polinomial`).\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- [DEF] O literal na pilha (a fita invertida): os ticks do índice e o marcador da polaridade. -/\r\ndef litNaPilha (p : ℕ × Bool) : List Simbolo :=\r\n  List.replicate p.1 Simbolo.tick ++ [if p.2 then Simbolo.litT else Simbolo.litF]\r\n\r\n/-- [DEF] A cláusula na pilha: o terminador à frente dos literais invertidos. -/\r\ndef clausulaNaPilha (C : List (ℕ × Bool)) : List Simbolo :=\r\n  Simbolo.fimC :: C.reverse.flatMap litNaPilha\r\n\r\n/-- [DEF] A pilha da corrida: a primeira cláusula já aberta, as demais com os terminadores. -/\r\ndef pilhaDaCorrida : List (List (ℕ × Bool)) → List Simbolo\r\n  | [] => []\r\n  | C :: Cs => C.reverse.flatMap litNaPilha ++ Cs.flatMap clausulaNaPilha\r\n\r\n/-- [DEF] A cota do combustível do literal: linear no índice e na testemunha. -/\r\ndef cotaLit (w : List Simbolo) (p : ℕ × Bool) : ℕ := 3 * (p.1 + 1) + (w.length + 1) + 3\r\n\r\n/-- [DEF] A cota do bloco: a soma dos literais, o salto e os terminadores. -/\r\ndef cotaBloco (w : List Simbolo) (Ls : List (ℕ × Bool)) : ℕ :=\r\n  (Ls.map (cotaLit w)).sum + (Ls.flatMap litNaPilha).length + 2 * Ls.length + 2\r\n\r\n/-- [DEF] A cota da corrida: a soma dos blocos e um passo por cláusula. -/\r\ndef cotaCorrida (w : List Simbolo) (Cs : List (List (ℕ × Bool))) : ℕ :=\r\n  (Cs.map (cotaBloco w)).sum + Cs.length\r\n\r\n/-- ★ **A COTA DO BLOCO NÃO VÊ A ORDEM** (auxiliar da contabilidade). -/\r\ntheorem cotaBloco_reverse (w : List Simbolo) (Ls : List (ℕ × Bool)) :\r\n    cotaBloco w Ls.reverse = cotaBloco w Ls := by\r\n  simp only [cotaBloco, List.map_reverse, List.sum_reverse, List.length_reverse,\r\n    List.length_flatMap]\r\n\r\n/-- ★ **A COTA DA CORRIDA NÃO VÊ A ORDEM** (auxiliar da contabilidade). -/\r\ntheorem cotaCorrida_reverse (w : List Simbolo) (Cs : List (List (ℕ × Bool))) :\r\n    cotaCorrida w Cs.reverse = cotaCorrida w Cs := by\r\n  simp only [cotaCorrida, List.map_reverse, List.sum_reverse, List.length_reverse]\r\n\r\n/-- ★ **O LITERAL NA PILHA NÃO TEM TERMINADOR** (auxiliar do salto). -/\r\ntheorem litNaPilha_ne_fimC (p : ℕ × Bool) : ∀ s₀ ∈ litNaPilha p, s₀ ≠ Simbolo.fimC := by\r\n  intro s₀ hs\r\n  have h : s₀ = Simbolo.tick ∨ s₀ = (if p.2 then Simbolo.litT else Simbolo.litF) := by\r\n    rw [litNaPilha, List.mem_append] at hs\r\n    cases hs with\r\n    | inl h => exact Or.inl (List.eq_of_mem_replicate h)\r\n    | inr h => exact Or.inr (List.mem_singleton.1 h)\r\n  rcases h with rfl | rfl\r\n  · decide\r\n  · cases p.2 <;> decide\r\n\r\n/-- ★ **A CLÁUSULA NA PILHA NÃO TEM TERMINADOR NO CONTEÚDO** (auxiliar do salto). -/\r\ntheorem flatMap_litNaPilha_ne_fimC (Ls : List (ℕ × Bool)) :\r\n    ∀ s₀ ∈ Ls.flatMap litNaPilha, s₀ ≠ Simbolo.fimC := by\r\n  intro s₀ hs\r\n  rw [List.mem_flatMap] at hs\r\n  obtain ⟨p, _, h⟩ := hs\r\n  exact litNaPilha_ne_fimC p s₀ h\r\n\r\n/-- ★★ **O BLOCO DA CLÁUSULA, NO MEIO DA PILHA**: com a falha armada e o resto após o terminador,\r\nos literais processam-se — todo índice, dentro ou além; o casamento desarma, salta o resto da\r\ncláusula e reabre o ciclo no resto; o descasamento integral escreve a mentira com o terminador\r\nintacto. -/\r\ntheorem o_bloco_casa_medio (v : EstadoV) (w resto' : List Simbolo) (out : List Bool) :\r\n    ∀ (Ls : List (ℕ × Bool)), v.falha = true →\r\n      ∃ fuel : ℕ, ∃ v' : EstadoV, fuel ≤ cotaBloco w Ls ∧\r\n        (correr aVerificadora\r\n          (aConfig (some Fase.leMarcador) v []\r\n            (Ls.flatMap litNaPilha ++ Simbolo.fimC :: resto') w [] [] out) fuel\r\n        = some (if Ls.any (fun p => ((w.drop p.1).head?.isSome &&\r\n              (((w.drop p.1).head? == some Simbolo.um) == p.2))) then\r\n            aConfig (some Fase.leMarcador) v' [] resto' w [] [] out\r\n          else aConfig (some Fase.escreveMentira) v' [] (Simbolo.fimC :: resto') w [] [] out))\r\n        ∧ (Ls.any (fun p => ((w.drop p.1).head?.isSome &&\r\n              (((w.drop p.1).head? == some Simbolo.um) == p.2))) = true → v'.falha = true) := by\r\n  intro Ls\r\n  induction Ls generalizing v with\r\n  | nil =>\r\n    intro hfalha\r\n    refine ⟨1, { v with lido := some Simbolo.fimC }, by simp [cotaBloco], ?_, ?_⟩\r\n    · show correr aVerificadora (aConfig (some Fase.leMarcador) v [] (Simbolo.fimC :: resto')\r\n          w [] [] out) 1 = _\r\n      rw [correr, passo_leMarcador_fimC, hfalha, if_pos rfl]\r\n      rfl\r\n    · intro h\r\n      simp at h\r\n  | cons p Ls' ih =>\r\n    intro hfalha\r\n    obtain ⟨fuelLit, hfuelLit, hLit⟩ := o_literal_cobre v w\r\n      (Ls'.flatMap litNaPilha ++ Simbolo.fimC :: resto') out p.1 p.2\r\n    have hforma : (p :: Ls').flatMap litNaPilha ++ Simbolo.fimC :: resto'\r\n        = List.replicate p.1 Simbolo.tick ++\r\n          ((if p.2 then Simbolo.litT else Simbolo.litF) ::\r\n            (Ls'.flatMap litNaPilha ++ Simbolo.fimC :: resto')) := by\r\n      rw [List.flatMap_cons, List.append_assoc, litNaPilha, List.append_assoc]\r\n      rfl\r\n    rw [hforma]\r\n    cases hcond : ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2)) with\r\n    | true =>\r\n      refine ⟨fuelLit + ((Ls'.flatMap litNaPilha).length + 1 + 1),\r\n        (⟨Fase.procuraBit, true, p.2, some Simbolo.fimC, (w.drop p.1).head?⟩ : EstadoV), ?_, ?_, ?_⟩\r\n      · simp only [cotaBloco, cotaLit, List.map_cons, List.sum_cons, List.flatMap_cons,\r\n          List.length_append, List.length_cons]\r\n        omega\r\n      · rw [List.any_cons, hcond, Bool.true_or, if_pos rfl, correr_add, hLit]\r\n        simp only [Option.bind_some]\r\n        rw [hcond, if_pos rfl, correr_add,\r\n          saltaLiterais_fecha ⟨Fase.procuraBit, false, p.2, none, (w.drop p.1).head?⟩ w [] [] out\r\n            (Ls'.flatMap litNaPilha) (Simbolo.fimC :: resto') (flatMap_litNaPilha_ne_fimC Ls')]\r\n        simp only [Option.bind_some]\r\n        show correr aVerificadora (aConfig (some Fase.inicioClausula)\r\n            { (⟨Fase.procuraBit, false, p.2, none, (w.drop p.1).head?⟩ : EstadoV) with\r\n              lido := some Simbolo.fimC } []\r\n            (Simbolo.fimC :: resto') w [] [] out) 1 = _\r\n        rw [correr, passo_inicioClausula]\r\n        rfl\r\n      · intro _\r\n        rfl\r\n    | false =>\r\n      obtain ⟨fuel', v', hfuel', hEq, hf'⟩ :=\r\n        ih ⟨Fase.procuraBit, v.falha, p.2, none, (w.drop p.1).head?⟩ hfalha\r\n      refine ⟨fuelLit + fuel', v', ?_, ?_, ?_⟩\r\n      · simp only [cotaBloco, cotaLit, List.map_cons, List.sum_cons, List.flatMap_cons,\r\n          List.length_append, List.length_cons] at hfuel' ⊢\r\n        omega\r\n      · rw [List.any_cons, hcond, Bool.false_or, correr_add, hLit]\r\n        simp only [Option.bind_some]\r\n        rw [hcond, if_neg (by decide)]\r\n        exact hEq\r\n      · rw [List.any_cons, hcond, Bool.false_or]\r\n        exact hf'\r\n\r\n/-- ★★ **O BLOCO DA CLÁUSULA, NO FIM DA PILHA**: com a falha armada e o vazio depois dos literais,\r\no casamento desarma e o salto encontra o fim — escreve a verdade; o descasamento integral escreve\r\na mentira. -/\r\ntheorem o_bloco_casa_ultimo (v : EstadoV) (w : List Simbolo) (out : List Bool) :\r\n    ∀ (Ls : List (ℕ × Bool)), v.falha = true →\r\n      ∃ fuel : ℕ, ∃ v' : EstadoV, fuel ≤ cotaBloco w Ls ∧\r\n        correr aVerificadora\r\n          (aConfig (some Fase.leMarcador) v [] (Ls.flatMap litNaPilha) w [] [] out) fuel\r\n        = some (if Ls.any (fun p => ((w.drop p.1).head?.isSome &&\r\n              (((w.drop p.1).head? == some Simbolo.um) == p.2))) then\r\n            aConfig (some Fase.escreveVerdade) v' [] [] w [] [] out\r\n          else aConfig (some Fase.escreveMentira) v' [] [] w [] [] out) := by\r\n  intro Ls\r\n  induction Ls generalizing v with\r\n  | nil =>\r\n    intro hfalha\r\n    refine ⟨1, { v with lido := none }, by simp [cotaBloco], ?_⟩\r\n    show correr aVerificadora (aConfig (some Fase.leMarcador) v [] [] w [] [] out) 1 = _\r\n    rw [correr, passo_leMarcador_nil, hfalha, if_pos rfl]\r\n    rfl\r\n  | cons p Ls' ih =>\r\n    intro hfalha\r\n    obtain ⟨fuelLit, hfuelLit, hLit⟩ := o_literal_cobre v w (Ls'.flatMap litNaPilha ++ []) out p.1 p.2\r\n    have hforma : (p :: Ls').flatMap litNaPilha\r\n        = List.replicate p.1 Simbolo.tick ++\r\n          ((if p.2 then Simbolo.litT else Simbolo.litF) :: (Ls'.flatMap litNaPilha ++ [])) := by\r\n      rw [List.flatMap_cons, litNaPilha, List.append_assoc]\r\n      show List.replicate p.1 Simbolo.tick ++\r\n          ((if p.2 then Simbolo.litT else Simbolo.litF) :: Ls'.flatMap litNaPilha)\r\n        = List.replicate p.1 Simbolo.tick ++\r\n          ((if p.2 then Simbolo.litT else Simbolo.litF) :: (Ls'.flatMap litNaPilha ++ []))\r\n      simp only [List.append_nil]\r\n    rw [hforma]\r\n    cases hcond : ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2)) with\r\n    | true =>\r\n      refine ⟨fuelLit + ((Ls'.flatMap litNaPilha).length + 1),\r\n        { (⟨Fase.procuraBit, false, p.2, none, (w.drop p.1).head?⟩ : EstadoV) with\r\n          lido := none }, ?_, ?_⟩\r\n      · simp only [cotaBloco, cotaLit, List.map_cons, List.sum_cons, List.flatMap_cons,\r\n          List.length_append, List.length_cons]\r\n        omega\r\n      rw [List.any_cons, hcond, Bool.true_or, if_pos rfl, correr_add, hLit]\r\n      simp only [Option.bind_some]\r\n      rw [hcond, if_pos rfl,\r\n        saltaLiterais_fecha ⟨Fase.procuraBit, false, p.2, none, (w.drop p.1).head?⟩ w [] [] out\r\n          (Ls'.flatMap litNaPilha) ([] : List Simbolo) (flatMap_litNaPilha_ne_fimC Ls')]\r\n    | false =>\r\n      obtain ⟨fuel', v', hfuel', hEq⟩ :=\r\n        ih ⟨Fase.procuraBit, v.falha, p.2, none, (w.drop p.1).head?⟩ hfalha\r\n      refine ⟨fuelLit + fuel', v', ?_, ?_⟩\r\n      · simp only [cotaBloco, cotaLit, List.map_cons, List.sum_cons, List.flatMap_cons,\r\n          List.length_append, List.length_cons] at hfuel' ⊢\r\n        omega\r\n      rw [List.any_cons, hcond, Bool.false_or, correr_add, hLit]\r\n      simp only [Option.bind_some]\r\n      rw [hcond, if_neg (by decide), List.append_nil]\r\n      exact hEq\r\n\r\n/-- ★★★ **A CORRIDA VERIFICA**: a lista das cláusulas decide-se; a máquina para com a saída —\r\na luz se todas as cláusulas têm o casamento, a ausência senão. -/\r\ntheorem a_corrida_verifica (v : EstadoV) (w : List Simbolo) (out : List Bool) :\r\n    ∀ (C : List (ℕ × Bool)) (Cs : List (List (ℕ × Bool))), v.falha = true →\r\n      ∃ fuel : ℕ, ∃ v' : EstadoV, ∃ fim : List Simbolo,\r\n        fim.length ≤ (pilhaDaCorrida (C :: Cs)).length ∧ fuel ≤ cotaCorrida w (C :: Cs) ∧\r\n        correr aVerificadora\r\n          (aConfig (some Fase.leMarcador) v [] (pilhaDaCorrida (C :: Cs)) w [] [] out) fuel\r\n        = some (aConfig (some Fase.parada) v' [] fim w [] []\r\n            ((if (C :: Cs).all (fun C' => C'.any (fun p =>\r\n                ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2))))\r\n              then true else false) :: out)) := by\r\n  intro C Cs\r\n  induction Cs generalizing C v with\r\n  | nil =>\r\n    intro hfalha\r\n    have hpilha : pilhaDaCorrida [C] = C.reverse.flatMap litNaPilha := by\r\n      rw [pilhaDaCorrida]\r\n      show C.reverse.flatMap litNaPilha ++ [] = C.reverse.flatMap litNaPilha\r\n      rw [List.append_nil]\r\n    rw [hpilha]\r\n    obtain ⟨fuel', v', hfuel', hEq⟩ := o_bloco_casa_ultimo v w out C.reverse hfalha\r\n    cases hany : (C.reverse.any (fun p => ((w.drop p.1).head?.isSome &&\r\n        (((w.drop p.1).head? == some Simbolo.um) == p.2)))) with\r\n    | true =>\r\n      have hverd : [C].all (fun C' => C'.any (fun p =>\r\n          ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2))))\r\n          = true := by\r\n        simp only [List.all_cons]\r\n        rw [← List.any_reverse, hany, Bool.true_and]\r\n        rfl\r\n      refine ⟨fuel' + 1, v', [], by simp [pilhaDaCorrida], ?_, ?_⟩\r\n      · rw [cotaBloco_reverse] at hfuel'\r\n        simp only [cotaCorrida, cotaBloco, List.map_cons, List.map_nil, List.sum_cons,\r\n          List.sum_nil, List.length_cons, List.length_nil] at hfuel' ⊢\r\n        omega\r\n      · rw [correr_add, hEq]\r\n        simp only [Option.bind_some]\r\n        rw [hany, if_pos rfl, correr, passo_escreveVerdade, hverd, if_pos rfl]\r\n        rfl\r\n    | false =>\r\n      have hverd : [C].all (fun C' => C'.any (fun p =>\r\n          ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2))))\r\n          = false := by\r\n        simp only [List.all_cons]\r\n        rw [← List.any_reverse, hany, Bool.false_and]\r\n      refine ⟨fuel' + 1, v', [], by simp [pilhaDaCorrida], ?_, ?_⟩\r\n      · rw [cotaBloco_reverse] at hfuel'\r\n        simp only [cotaCorrida, cotaBloco, List.map_cons, List.map_nil, List.sum_cons,\r\n          List.sum_nil, List.length_cons, List.length_nil] at hfuel' ⊢\r\n        omega\r\n      · rw [correr_add, hEq]\r\n        simp only [Option.bind_some]\r\n        rw [hany, if_neg (by decide), correr, passo_escreveMentira, hverd, if_neg (by decide)]\r\n        rfl\r\n  | cons C₂ Cs' ih =>\r\n    intro hfalha\r\n    have hpilha : pilhaDaCorrida (C :: C₂ :: Cs')\r\n        = C.reverse.flatMap litNaPilha ++ (Simbolo.fimC :: pilhaDaCorrida (C₂ :: Cs')) := by\r\n      rw [pilhaDaCorrida, List.flatMap_cons, clausulaNaPilha]\r\n      rfl\r\n    rw [hpilha]\r\n    obtain ⟨fuel', v', hfuel', hEq, hf'⟩ := o_bloco_casa_medio v w (pilhaDaCorrida (C₂ :: Cs'))\r\n      out C.reverse hfalha\r\n    cases hany : (C.reverse.any (fun p => ((w.drop p.1).head?.isSome &&\r\n        (((w.drop p.1).head? == some Simbolo.um) == p.2)))) with\r\n    | true =>\r\n      obtain ⟨fuel'', v'', fim, hfim, hfuel'', hEq''⟩ := ih v' C₂ (hf' hany)\r\n      have hverd : (C :: C₂ :: Cs').all (fun C' => C'.any (fun p =>\r\n          ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2))))\r\n          = (C₂ :: Cs').all (fun C' => C'.any (fun p =>\r\n            ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2)))) := by\r\n        simp only [List.all_cons]\r\n        rw [← List.any_reverse, hany, Bool.true_and]\r\n      refine ⟨fuel' + fuel'', v'', fim, ?_, ?_, ?_⟩\r\n      · simp only [pilhaDaCorrida, List.flatMap_cons, clausulaNaPilha, List.length_append,\r\n          List.length_cons] at hfim ⊢\r\n        omega\r\n      · rw [cotaBloco_reverse] at hfuel'\r\n        simp only [cotaCorrida, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,\r\n          List.length_cons, List.length_nil] at hfuel' hfuel'' ⊢\r\n        omega\r\n      rw [correr_add, hEq]\r\n      simp only [Option.bind_some]\r\n      rw [hany, if_pos rfl, hverd]\r\n      exact hEq''\r\n    | false =>\r\n      have hverd : (C :: C₂ :: Cs').all (fun C' => C'.any (fun p =>\r\n          ((w.drop p.1).head?.isSome && (((w.drop p.1).head? == some Simbolo.um) == p.2))))\r\n          = false := by\r\n        simp only [List.all_cons]\r\n        rw [← List.any_reverse, hany, Bool.false_and]\r\n      refine ⟨fuel' + 1, v', Simbolo.fimC :: pilhaDaCorrida (C₂ :: Cs'), ?_, ?_, ?_⟩\r\n      · simp only [pilhaDaCorrida, List.flatMap_cons, clausulaNaPilha, List.length_append,\r\n          List.length_cons]\r\n        omega\r\n      · rw [cotaBloco_reverse] at hfuel'\r\n        simp only [cotaCorrida, List.map_cons, List.map_nil, List.sum_cons, List.sum_nil,\r\n          List.length_cons, List.length_nil] at hfuel' ⊢\r\n        omega\r\n      rw [correr_add, hEq]\r\n      simp only [Option.bind_some]\r\n      rw [hany, if_neg (by decide), correr, passo_escreveMentira, hverd, if_neg (by decide)]\r\n      rfl\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerificaMedidas.lean': "import TGLExt.AMaquinaVerificaCorrida\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# As medidas da fita e a cota da corrida\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `aSomaDosIndices`, `aSomaDosLiterais` [DEF]: a soma dos índices (com um por literal) e o número de literais da fórmula.\r\n2. ★ `codificaLiteral_length`, `codificaClausula_length`, `codificaFormula_length`, `codificaEntrada_length`,\r\n   `flatMap_codificaClausula_length`, `codificaFormula_length_reverse`: os comprimentos das codificações na fita.\r\n3. ★ `litNaPilha_length`, `flatMap_litNaPilha_length`, `flatMap_clausulaNaPilha_length`, `pilhaDaCorrida_length_le`: os comprimentos\r\n   na pilha; a pilha da corrida não é maior que a fórmula codificada.\r\n4. ★ `sum_map_cotaLit`, `aSomaDosLiterais_le_indices`, `aSomaDosIndices_reverse`, `aSomaDosLiterais_reverse` (auxiliares da\r\n   contabilidade).\r\n5. ★★ `cotaBloco_le` e `cotaCorrida_le`: as cotas do bloco e da corrida em termos da soma dos índices, do número de literais e do\r\n   comprimento da testemunha.\r\n6. ★★ `a_cota_da_corrida_em_L`: com L o comprimento da entrada codificada, a corrida custa no máximo L² + 13L passos.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Uma cota de passos para decidir SAT: as medidas contam os passos da verificação de uma testemunha dada.\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- [DEF] A soma dos índices com o custo de um por literal. -/\r\ndef aSomaDosIndices (φf : List (List (ℕ × Bool))) : ℕ :=\r\n  (φf.map (fun C => (C.map (fun p => p.1 + 1)).sum)).sum\r\n\r\n/-- [DEF] A soma dos literais. -/\r\ndef aSomaDosLiterais (φf : List (List (ℕ × Bool))) : ℕ := (φf.map List.length).sum\r\n\r\n/-- ★ **A MEDIDA DO LITERAL NA FITA**. -/\r\ntheorem codificaLiteral_length (p : ℕ × Bool) :\r\n    (codificaLiteral p).length = p.1 + 1 := by\r\n  rw [codificaLiteral, List.length_cons, List.length_replicate]\r\n\r\n/-- ★ **A MEDIDA DA CLÁUSULA NA FITA**. -/\r\ntheorem codificaClausula_length (C : List (ℕ × Bool)) :\r\n    (codificaClausula C).length = (C.map (fun p => p.1 + 1)).sum + 1 := by\r\n  rw [codificaClausula, List.length_append, List.length_flatMap]\r\n  show (C.map (fun p => (codificaLiteral p).length)).sum + [Simbolo.fimC].length = _\r\n  simp only [codificaLiteral_length, List.length_cons, List.length_nil]\r\n\r\n/-- ★ **A MEDIDA DA FÓRMULA NA FITA**. -/\r\ntheorem codificaFormula_length (φf : List (List (ℕ × Bool))) :\r\n    (codificaFormula φf).length = aSomaDosIndices φf + φf.length + 1 := by\r\n  rw [codificaFormula, List.length_append, List.length_flatMap]\r\n  simp only [codificaClausula_length, List.length_cons, List.length_nil]\r\n  show (φf.map (fun C => (C.map (fun p => p.1 + 1)).sum + 1)).sum + 1\r\n      = (φf.map (fun C => (C.map (fun p => p.1 + 1)).sum)).sum + φf.length + 1\r\n  induction φf with\r\n  | nil => rfl\r\n  | cons C Cs ih =>\r\n    rw [List.map_cons, List.sum_cons, List.map_cons, List.sum_cons, List.length_cons]\r\n    omega\r\n\r\n/-- ★ **A MEDIDA DA ENTRADA NA FITA**. -/\r\ntheorem codificaEntrada_length (φf : List (List (ℕ × Bool))) (bits : List Bool) :\r\n    (codificaEntrada (φf, bits)).length = (codificaFormula φf).length + 1 + bits.length := by\r\n  rw [codificaEntrada, List.length_append, List.length_append, List.length_cons, List.length_nil,\r\n    codificaBits, List.length_map]\r\n\r\n/-- ★ **A MEDIDA DO LITERAL NA PILHA**. -/\r\ntheorem litNaPilha_length (p : ℕ × Bool) : (litNaPilha p).length = p.1 + 1 := by\r\n  rw [litNaPilha, List.length_append, List.length_replicate, List.length_cons, List.length_nil]\r\n\r\n/-- ★ **A MEDIDA DO FLATMAP NA PILHA**. -/\r\ntheorem flatMap_litNaPilha_length (Ls : List (ℕ × Bool)) :\r\n    (Ls.flatMap litNaPilha).length = (Ls.map (fun p => p.1 + 1)).sum := by\r\n  rw [List.length_flatMap]\r\n  show (Ls.map (fun p => (litNaPilha p).length)).sum = (Ls.map (fun p => p.1 + 1)).sum\r\n  simp only [litNaPilha_length]\r\n\r\n/-- ★ **A SOMA COM A CONSTANTE** (auxiliar da contabilidade). -/\r\ntheorem sum_map_cotaLit (w : List Simbolo) :\r\n    ∀ (C : List (ℕ × Bool)),\r\n      (C.map (cotaLit w)).sum = 3 * (C.map (fun p => p.1 + 1)).sum + C.length * (w.length + 4) := by\r\n  intro C\r\n  induction C with\r\n  | nil => simp\r\n  | cons p ps ih =>\r\n    rw [List.map_cons, List.sum_cons, cotaLit, List.map_cons, List.sum_cons, List.length_cons,\r\n      Nat.add_mul, Nat.one_mul, ih]\r\n    omega\r\n\r\n/-- ★★ **A COTA DO BLOCO EM TERMOS DOS ÍNDICES**. -/\r\ntheorem cotaBloco_le (w : List Simbolo) (C : List (ℕ × Bool)) :\r\n    cotaBloco w C ≤ 4 * ((C.map (fun p => p.1 + 1)).sum) + C.length * (w.length + 6) + 2 := by\r\n  simp only [cotaBloco]\r\n  rw [sum_map_cotaLit, flatMap_litNaPilha_length]\r\n  have hexp : C.length * (w.length + 6) = C.length * (w.length + 4) + 2 * C.length := by\r\n    rw [show w.length + 6 = w.length + 4 + 2 from by omega, Nat.mul_add, Nat.mul_comm C.length 2]\r\n  omega\r\n\r\n/-- ★★ **A COTA DA CORRIDA EM TERMOS DOS ÍNDICES**. -/\r\ntheorem cotaCorrida_le (w : List Simbolo) :\r\n    ∀ (φf : List (List (ℕ × Bool))),\r\n      cotaCorrida w φf ≤ 4 * aSomaDosIndices φf + aSomaDosLiterais φf * (w.length + 6)\r\n        + 3 * φf.length := by\r\n  intro φf\r\n  induction φf with\r\n  | nil => simp [cotaCorrida, aSomaDosIndices, aSomaDosLiterais]\r\n  | cons C Cs ih =>\r\n    have hb := cotaBloco_le w C\r\n    simp only [cotaCorrida, aSomaDosIndices, aSomaDosLiterais, List.map_cons, List.map_nil,\r\n      List.sum_cons, List.length_cons] at hb ih ⊢\r\n    rw [Nat.add_mul]\r\n    omega\r\n\r\n/-- ★ **OS LITERAIS SÃO MENORES QUE OS ÍNDICES** (cada literal custa ao menos um símbolo). -/\r\ntheorem aSomaDosLiterais_le_indices (φf : List (List (ℕ × Bool))) :\r\n    aSomaDosLiterais φf ≤ aSomaDosIndices φf := by\r\n  induction φf with\r\n  | nil => rfl\r\n  | cons C Cs ih =>\r\n    simp only [aSomaDosLiterais, aSomaDosIndices, List.map_cons, List.sum_cons] at ih ⊢\r\n    have hC : C.length ≤ (C.map (fun p => p.1 + 1)).sum := by\r\n      induction C with\r\n      | nil => rfl\r\n      | cons p ps ih2 => rw [List.map_cons, List.sum_cons, List.length_cons]; omega\r\n    omega\r\n\r\n/-- ★ **A SOMA DOS ÍNDICES NÃO VÊ A ORDEM** (auxiliar da contabilidade). -/\r\ntheorem aSomaDosIndices_reverse (Cs : List (List (ℕ × Bool))) :\r\n    aSomaDosIndices Cs.reverse = aSomaDosIndices Cs := by\r\n  simp only [aSomaDosIndices, List.map_reverse, List.sum_reverse]\r\n\r\n/-- ★ **A SOMA DOS LITERAIS NÃO VÊ A ORDEM** (auxiliar da contabilidade). -/\r\ntheorem aSomaDosLiterais_reverse (Cs : List (List (ℕ × Bool))) :\r\n    aSomaDosLiterais Cs.reverse = aSomaDosLiterais Cs := by\r\n  simp only [aSomaDosLiterais, List.map_reverse, List.sum_reverse]\r\n\r\n/-- ★ **A MEDIDA DO FLATMAP DAS CLÁUSULAS NA FITA** (auxiliar). -/\r\ntheorem flatMap_codificaClausula_length (Cs : List (List (ℕ × Bool))) :\r\n    (Cs.flatMap codificaClausula).length = aSomaDosIndices Cs + Cs.length := by\r\n  rw [List.length_flatMap]\r\n  show (Cs.map (fun C => (codificaClausula C).length)).sum = aSomaDosIndices Cs + Cs.length\r\n  induction Cs with\r\n  | nil => rfl\r\n  | cons C Cs' ih =>\r\n    simp only [codificaClausula_length, aSomaDosIndices, List.map_cons, List.sum_cons,\r\n      List.length_cons] at ih ⊢\r\n    omega\r\n\r\n/-- ★ **A MEDIDA DO FLATMAP DAS CLÁUSULAS NA PILHA** (auxiliar). -/\r\ntheorem flatMap_clausulaNaPilha_length (Cs : List (List (ℕ × Bool))) :\r\n    (Cs.flatMap clausulaNaPilha).length = aSomaDosIndices Cs + Cs.length := by\r\n  rw [List.length_flatMap]\r\n  show (Cs.map (fun C => (clausulaNaPilha C).length)).sum = aSomaDosIndices Cs + Cs.length\r\n  induction Cs with\r\n  | nil => rfl\r\n  | cons C Cs' ih =>\r\n    simp only [clausulaNaPilha, List.length_cons, flatMap_litNaPilha_length, List.map_reverse,\r\n      List.sum_reverse, aSomaDosIndices, List.map_cons, List.sum_cons, List.length_cons] at ih ⊢\r\n    omega\r\n\r\n/-- ★ **A MEDIDA DA FÓRMULA NÃO VÊ A ORDEM** (auxiliar da contabilidade). -/\r\ntheorem codificaFormula_length_reverse (Cs : List (List (ℕ × Bool))) :\r\n    (codificaFormula Cs.reverse).length = (codificaFormula Cs).length := by\r\n  rw [codificaFormula_length, codificaFormula_length, aSomaDosIndices_reverse, List.length_reverse]\r\n\r\n/-- ★★ **A MEDIDA DA PILHA DA CORRIDA**: a pilha não passa da fita da fórmula. -/\r\ntheorem pilhaDaCorrida_length_le (Cs : List (List (ℕ × Bool))) :\r\n    (pilhaDaCorrida Cs).length ≤ (codificaFormula Cs).length := by\r\n  cases Cs with\r\n  | nil =>\r\n    rw [pilhaDaCorrida, codificaFormula]\r\n    simp\r\n  | cons C Cs' =>\r\n    have h1 := flatMap_clausulaNaPilha_length Cs'\r\n    have h2 := flatMap_codificaClausula_length Cs'\r\n    have h3 := codificaClausula_length C\r\n    rw [pilhaDaCorrida, codificaFormula, List.flatMap_cons, List.length_append, List.length_append,\r\n      List.length_append, flatMap_litNaPilha_length, List.map_reverse, List.sum_reverse, h1, h2, h3]\r\n    simp only [aSomaDosIndices, List.map_cons, List.sum_cons, List.length_cons, List.length_nil]\r\n    omega\r\n\r\n/-- ★★ **A COTA DA CORRIDA É QUADRÁTICA NA FITA**: com L o comprimento da entrada codificada,\r\na corrida custa no máximo L² + 13L. -/\r\ntheorem a_cota_da_corrida_em_L (φf : List (List (ℕ × Bool))) (bits : List Bool) :\r\n    cotaCorrida (codificaBits bits) φf\r\n      ≤ (codificaEntrada (φf, bits)).length * (codificaEntrada (φf, bits)).length\r\n        + 13 * (codificaEntrada (φf, bits)).length := by\r\n  have hL := cotaCorrida_le (codificaBits bits) φf\r\n  have h2 := aSomaDosLiterais_le_indices φf\r\n  have h3 : (codificaBits bits).length = bits.length := by rw [codificaBits, List.length_map]\r\n  have h4 : aSomaDosIndices φf ≤ (codificaEntrada (φf, bits)).length := by\r\n    rw [codificaEntrada_length, codificaFormula_length]\r\n    omega\r\n  have h5 : bits.length ≤ (codificaEntrada (φf, bits)).length := by\r\n    rw [codificaEntrada_length]\r\n    omega\r\n  have h6 : φf.length ≤ (codificaEntrada (φf, bits)).length := by\r\n    rw [codificaEntrada_length, codificaFormula_length]\r\n    omega\r\n  nlinarith [hL, h2, h3, h4, h5, h6]\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerificaCompleta.lean': "import TGLExt.AMaquinaVerificaCorrida\r\nimport TGLExt.AMaquinaVerificaMedidas\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A máquina verifica: a correção geral da verificadora TM2, com a cota polinomial\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★ `a_config_inicial`: a configuração inicial, por nome: a entrada na pilha de entrada, as demais vazias.\r\n2. ★ `codificaBits_ne_sep`, `reverse_codificaLiteral`, `reverse_flatMap`, `reverse_codificaClausula`, `flatMap_clausula_cons`\r\n   (auxiliares) e `a_formula_na_pilha`: a fórmula codificada, invertida, é a pilha da corrida.\r\n3. ★ `o_bit_da_testemunha`: o símbolo na posição da variável é «um» se e só se o bit é verdadeiro: a leitura da máquina é a leitura\r\n   da casa.\r\n4. ★ `o_presenca_da_testemunha`: há símbolo na posição da variável se e só se há o bit: a guarda da presença na língua da casa.\r\n5. ★ `a_condicao_e_a_da_fita`, `a_clausula_e_a_da_fita`, `a_densidade_da_fita`: para todo índice, o casamento da máquina é o da casa,\r\n   e o veredito é o de `verificaNaFita`.\r\n6. ★★★ `a_maquina_verifica`: para toda fórmula e toda testemunha, existe combustível de no máximo L² + 20L + 10 passos, sendo L o\r\n   comprimento da entrada codificada, com o qual a verificadora TM2 para na configuração final limpa, com o veredito de\r\n   `verificaNaFita` na saída.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Esta máquina recebe a leitura, não a procura: não decide SAT sem testemunha.\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- ★ **A CONFIGURAÇÃO INICIAL, POR NOME**: a entrada na pilha de entrada, as demais vazias. -/\r\ntheorem a_config_inicial (e : List Simbolo) :\r\n    Turing.initList aVerificadora e\r\n      = aConfig (some Fase.copiaEntrada) ⟨Fase.copiaEntrada, false, false, none, none⟩\r\n          e [] [] [] [] [] := by\r\n  simp only [Turing.initList, aConfig]\r\n  congr 1\r\n  funext k\r\n  cases k <;> rfl\r\n\r\n/-- ★ **A TESTEMUNHA NÃO TEM DIVISÓRIA** (auxiliar da colheita). -/\r\ntheorem codificaBits_ne_sep (bits : List Bool) : ∀ s₀ ∈ codificaBits bits, s₀ ≠ Simbolo.sep := by\r\n  intro s₀ hs\r\n  rw [codificaBits, List.mem_map] at hs\r\n  obtain ⟨b, _, rfl⟩ := hs\r\n  cases b <;> decide\r\n\r\n/-- ★ **O LITERAL INVERTIDO** (auxiliar da pilha). -/\r\ntheorem reverse_codificaLiteral (p : ℕ × Bool) :\r\n    (codificaLiteral p).reverse = litNaPilha p := by\r\n  rw [codificaLiteral, List.reverse_cons, List.reverse_replicate]\r\n  rfl\r\n\r\n/-- ★ **O FLATMAP INVERTIDO** (auxiliar da pilha). -/\r\ntheorem reverse_flatMap {α β : Type} (f : α → List β) :\r\n    ∀ l : List α, (l.flatMap f).reverse = l.reverse.flatMap (fun a => (f a).reverse) := by\r\n  intro l\r\n  induction l with\r\n  | nil => rfl\r\n  | cons a l ih =>\r\n    rw [List.flatMap_cons, List.reverse_append, List.reverse_cons, ih, List.flatMap_append]\r\n    show l.reverse.flatMap (fun a => (f a).reverse) ++ (f a).reverse\r\n      = l.reverse.flatMap (fun a => (f a).reverse) ++ ((f a).reverse ++ [])\r\n    rw [List.append_nil]\r\n\r\n/-- ★ **A CLÁUSULA INVERTIDA É A CLÁUSULA NA PILHA** (auxiliar). -/\r\ntheorem reverse_codificaClausula (C : List (ℕ × Bool)) :\r\n    (codificaClausula C).reverse = clausulaNaPilha C := by\r\n  rw [codificaClausula, List.reverse_append, reverse_flatMap, clausulaNaPilha]\r\n  show (Simbolo.fimC :: []) ++ C.reverse.flatMap (fun p => (codificaLiteral p).reverse)\r\n      = Simbolo.fimC :: C.reverse.flatMap litNaPilha\r\n  simp only [reverse_codificaLiteral]\r\n  rfl\r\n\r\n/-- ★ **A FÓRMULA INVERTIDA É A PILHA DA CORRIDA**: o terminador da fórmula à frente, as\r\ncláusulas na ordem invertida, cada uma com o seu terminador. -/\r\ntheorem a_formula_na_pilha (φf : List (List (ℕ × Bool))) :\r\n    (codificaFormula φf).reverse\r\n      = Simbolo.fimF :: φf.reverse.flatMap clausulaNaPilha := by\r\n  rw [codificaFormula, List.reverse_append, reverse_flatMap]\r\n  show (Simbolo.fimF :: []) ++ φf.reverse.flatMap (fun C => (codificaClausula C).reverse)\r\n      = Simbolo.fimF :: φf.reverse.flatMap clausulaNaPilha\r\n  simp only [reverse_codificaClausula]\r\n  rfl\r\n\r\n/-- ★ **A PILHA NÃO-VAZIA ABRE COM O TERMINADOR** (auxiliar do início). -/\r\ntheorem flatMap_clausula_cons (L : List (List (ℕ × Bool))) (hL : L ≠ []) :\r\n    L.flatMap clausulaNaPilha = Simbolo.fimC :: pilhaDaCorrida L := by\r\n  cases L with\r\n  | nil => exact absurd rfl hL\r\n  | cons D Ds =>\r\n    rw [List.flatMap_cons, clausulaNaPilha]\r\n    rfl\r\n\r\n/-- ★ **O BIT DA TESTEMUNHA**: o símbolo na posição da variável é «um» se, e só se, o bit é\r\nverdadeiro — a leitura da máquina é a leitura da casa. -/\r\ntheorem o_bit_da_testemunha (bits : List Bool) :\r\n    ∀ (i : ℕ), (((codificaBits bits).drop i).head? == some Simbolo.um)\r\n      = (bits[i]? == some true) := by\r\n  induction bits with\r\n  | nil =>\r\n    intro i\r\n    cases i <;> rfl\r\n  | cons b bs ih =>\r\n    intro i\r\n    cases i with\r\n    | zero => cases b <;> rfl\r\n    | succ i => exact ih i\r\n\r\n/-- ★ **A PRESENÇA DA TESTEMUNHA**: há símbolo na posição da variável se, e só se, há o bit — a\r\nguarda da presença na língua da casa. -/\r\ntheorem o_presenca_da_testemunha (bits : List Bool) :\r\n    ∀ (i : ℕ), ((codificaBits bits).drop i).head?.isSome = (bits[i]?).isSome := by\r\n  induction bits with\r\n  | nil =>\r\n    intro i\r\n    cases i <;> rfl\r\n  | cons b bs ih =>\r\n    intro i\r\n    cases i with\r\n    | zero => rfl\r\n    | succ i => exact ih i\r\n\r\n/-- ★ **A CONDIÇÃO É A DA FITA**: o casamento da máquina (a guarda da presença, o símbolo e a\r\npolaridade) é o casamento da casa (o bit na posição) — para todo índice, sem alcance hipotecado. -/\r\ntheorem a_condicao_e_a_da_fita (bits : List Bool) (p : ℕ × Bool) :\r\n    (((codificaBits bits).drop p.1).head?.isSome &&\r\n      (((codificaBits bits).drop p.1).head? == some Simbolo.um) == p.2)\r\n      = (bits[p.1]? == some p.2) := by\r\n  rw [o_bit_da_testemunha, o_presenca_da_testemunha]\r\n  cases hb : bits[p.1]? with\r\n  | none => rfl\r\n  | some b => cases b <;> cases p.2 <;> rfl\r\n\r\n/-- ★ **A CLÁUSULA É A DA FITA** (auxiliar do veredito). -/\r\ntheorem a_clausula_e_a_da_fita (bits : List Bool) :\r\n    ∀ (C : List (ℕ × Bool)),\r\n      C.any (fun p => (bits[p.1]? == some p.2))\r\n        = C.any (fun p => ((codificaBits bits).drop p.1).head?.isSome &&\r\n            (((codificaBits bits).drop p.1).head? == some Simbolo.um) == p.2) := by\r\n  intro C\r\n  induction C with\r\n  | nil => rfl\r\n  | cons p ps ih =>\r\n    rw [List.any_cons, List.any_cons, a_condicao_e_a_da_fita bits p, ih]\r\n\r\n/-- ★ **O VEREDITO É O DA RÉGUA**: a `verificaNaFita` na língua da máquina. -/\r\ntheorem a_densidade_da_fita (φf : List (List (ℕ × Bool))) (bits : List Bool) :\r\n    verificaNaFita φf bits\r\n      = φf.all (fun C => C.any (fun p =>\r\n          ((codificaBits bits).drop p.1).head?.isSome &&\r\n            (((codificaBits bits).drop p.1).head? == some Simbolo.um) == p.2)) := by\r\n  induction φf with\r\n  | nil => rfl\r\n  | cons C Cs ih =>\r\n    simp only [verificaNaFita, List.all_cons]\r\n    rw [a_clausula_e_a_da_fita bits C,\r\n      show Cs.all (fun C' => C'.any (fun p => (bits[p.1]? == some p.2)))\r\n        = Cs.all (fun C' => C'.any (fun p =>\r\n            ((codificaBits bits).drop p.1).head?.isSome &&\r\n              (((codificaBits bits).drop p.1).head? == some Simbolo.um) == p.2)) from ih]\r\n\r\n/-- ★★★ **A MÁQUINA VERIFICA, COM A COTA E A CASA EM ORDEM**: para toda fórmula e toda\r\ntestemunha — todo par, sem alcance hipotecado — existe combustível polinomial com o qual a\r\nverificadora TM2 para na configuração final limpa, com o veredito da casa na saída. -/\r\ntheorem a_maquina_verifica (φf : List (List (ℕ × Bool))) (bits : List Bool) :\r\n    ∃ fuel : ℕ, fuel ≤ (codificaEntrada (φf, bits)).length * (codificaEntrada (φf, bits)).length\r\n        + 20 * (codificaEntrada (φf, bits)).length + 10 ∧\r\n      correr aVerificadora (Turing.initList aVerificadora (codificaEntrada (φf, bits))) fuel\r\n        = some (aConfig none ⟨Fase.copiaEntrada, false, false, none, none⟩ [] [] [] [] []\r\n            [verificaNaFita φf bits]) := by\r\n  have hentrada : (codificaEntrada (φf, bits)).reverse\r\n      = (codificaBits bits).reverse ++ (Simbolo.sep :: (codificaFormula φf).reverse) := by\r\n    rw [codificaEntrada, List.reverse_append, List.reverse_append]\r\n    rfl\r\n  cases φf with\r\n  | nil =>\r\n    refine ⟨(codificaEntrada ([], bits)).length + 1 +\r\n      (((codificaBits bits).reverse).length + 1 + (3 + ((codificaBits bits).length + 4))), ?_, ?_⟩\r\n    · have hL : 2 ≤ (codificaEntrada ([], bits)).length := by\r\n        rw [codificaEntrada_length, codificaFormula_length]\r\n        simp [aSomaDosIndices]\r\n      have hB : bits.length ≤ (codificaEntrada ([], bits)).length := by\r\n        rw [codificaEntrada_length]\r\n        omega\r\n      have hcb : (codificaBits bits).length = bits.length := by rw [codificaBits, List.length_map]\r\n      rw [List.length_reverse, hcb]\r\n      nlinarith\r\n    rw [a_config_inicial, correr_add, copiaEntrada_fecha]\r\n    simp only [Option.bind_some]\r\n    rw [List.append_nil, hentrada, correr_add,\r\n      colheTestemunha_fecha _ _ _ _ _ _ _\r\n        (fun s₀ hs => codificaBits_ne_sep bits s₀ (List.mem_reverse.1 hs))]\r\n    simp only [Option.bind_some]\r\n    rw [List.reverse_reverse, List.append_nil, a_formula_na_pilha]\r\n    show correr aVerificadora\r\n        (aConfig (some Fase.inicioClausula)\r\n          (⟨Fase.copiaEntrada, false, false, some Simbolo.sep, none⟩ : EstadoV) []\r\n          [Simbolo.fimF] (codificaBits bits) [] [] [])\r\n        (3 + ((codificaBits bits).length + 4)) = _\r\n    rw [correr_add, inicioClausula_vazio_fecha]\r\n    simp only [Option.bind_some]\r\n    have h0 : ([] : List Simbolo).length = 0 := rfl\r\n    rw [show (codificaBits bits).length + 4\r\n        = 1 + (([] : List Simbolo).length + 1) + ((codificaBits bits).length + 1) + 1 from by\r\n        rw [h0]; omega, a_limpeza_fecha]\r\n    rfl\r\n  | cons C Cs =>\r\n    have hne : (C :: Cs).reverse ≠ [] := by\r\n      rw [List.reverse_cons]\r\n      simp\r\n    rcases hrev : (C :: Cs).reverse with _ | ⟨D, Ds⟩\r\n    · rw [List.reverse_eq_nil_iff] at hrev\r\n      nomatch hrev\r\n    · obtain ⟨fuel₃, v', fim, hfim, hfuel₃, hEq⟩ := a_corrida_verifica\r\n        { { (⟨Fase.copiaEntrada, false, false, none, none⟩ : EstadoV) with\r\n            lido := some Simbolo.sep } with lido := some Simbolo.fimC, falha := true }\r\n        (codificaBits bits) [] D Ds\r\n        rfl\r\n      have hverd : (if (D :: Ds).all (fun C' => C'.any (fun p =>\r\n              ((codificaBits bits).drop p.1).head?.isSome &&\r\n                (((codificaBits bits).drop p.1).head? == some Simbolo.um) == p.2))\r\n            then true else false) = verificaNaFita (C :: Cs) bits := by\r\n        rw [← hrev, List.all_reverse, ← a_densidade_da_fita]\r\n        cases verificaNaFita (C :: Cs) bits <;> rfl\r\n      refine ⟨(codificaEntrada (C :: Cs, bits)).length + 1 +\r\n        (((codificaBits bits).reverse).length + 1 +\r\n          (2 + (fuel₃ + (1 + (fim.length + 1) + ((codificaBits bits).length + 1) + 1)))), ?_, ?_⟩\r\n      · have hf3 : fuel₃ ≤ (codificaEntrada (C :: Cs, bits)).length\r\n            * (codificaEntrada (C :: Cs, bits)).length\r\n            + 13 * (codificaEntrada (C :: Cs, bits)).length := by\r\n          rw [← hrev] at hfuel₃\r\n          rw [cotaCorrida_reverse] at hfuel₃\r\n          exact hfuel₃.trans (a_cota_da_corrida_em_L (C :: Cs) bits)\r\n        have hfm : fim.length ≤ (codificaFormula (C :: Cs)).length := by\r\n          rw [← hrev] at hfim\r\n          exact hfim.trans ((pilhaDaCorrida_length_le _).trans (by\r\n            rw [codificaFormula_length_reverse]))\r\n        have hB : bits.length ≤ (codificaEntrada (C :: Cs, bits)).length := by\r\n          rw [codificaEntrada_length]\r\n          omega\r\n        have hF : (codificaFormula (C :: Cs)).length\r\n            ≤ (codificaEntrada (C :: Cs, bits)).length := by\r\n          rw [codificaEntrada_length]\r\n          omega\r\n        have hrevlen : ((codificaBits bits).reverse).length = bits.length := by\r\n          rw [List.length_reverse, codificaBits, List.length_map]\r\n        have hcb : (codificaBits bits).length = bits.length := by rw [codificaBits, List.length_map]\r\n        rw [hrevlen, hcb]\r\n        nlinarith\r\n      rw [a_config_inicial, correr_add, copiaEntrada_fecha]\r\n      simp only [Option.bind_some]\r\n      rw [List.append_nil, hentrada, correr_add,\r\n        colheTestemunha_fecha _ _ _ _ _ _ _\r\n          (fun s₀ hs => codificaBits_ne_sep bits s₀ (List.mem_reverse.1 hs))]\r\n      simp only [Option.bind_some]\r\n      rw [List.reverse_reverse, List.append_nil, a_formula_na_pilha,\r\n        flatMap_clausula_cons _ hne, correr_add, inicioClausula_fecha]\r\n      simp only [Option.bind_some]\r\n      rw [hrev, correr_add, hEq]\r\n      simp only [Option.bind_some]\r\n      rw [a_limpeza_fecha, hverd]\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AMaquinaVerificaHabitante.lean': "import TGLExt.AMaquinaVerificaCompleta\r\nimport TGLExt.AMaquinaVerificaMedidas\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A verificadora em tempo polinomial no modelo padrão\r\n\r\n## O que é\r\n\r\nA ponte entre o corredor da casa (`correr`) e o iterador da Mathlib (`EvalsToInTime`), e com ela o habitante da especificação fixa\r\n`ObjetivoTM2Polinomial`: a máquina `aVerificadora`, com as codificações `codificaEntrada` e `codificaSaida`, computa\r\n`verificaNaFita` em tempo polinomial na definição da Mathlib (`Turing.TM2ComputableInPolyTime`), com o polinômio X² + 20X + 10. A\r\ncodificação da entrada é injetiva (`APonteAoTM2.codificaEntrada_injetiva`).\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. ★ `ponte_correr_para`: o corredor e o iterador da Mathlib (`(flip bind f)^[k]`) se encontram dentro do combustível.\r\n2. ★ `a_mapa_entrada_id`, `a_mapa_saida_id`: os mapas dos alfabetos são a identidade.\r\n3. ★ `a_config_final_e_o_haltList`: a configuração final limpa é o `haltList` da Mathlib.\r\n4. ★★★ `a_verificadora_em_tempo_polinomial`: `Nonempty (Turing.TM2ComputableInPolyTime codificaEntrada codificaSaida\r\n   (fun p => verificaNaFita p.1 p.2))`, com o tempo X² + 20X + 10.\r\n\r\nNa língua de Cook–Levin, este é o verificador polinomial do certificado de SAT: SAT está em NP (Cook 1971) [KNOWN]. A mesma\r\nespecificação já é habitada, com outra máquina, por `SimCompleta` (`verificacao_tm2_polinomial`) e por `OLacoDasClausulas`\r\n(`o_objetivo_cumprido`); este é um terceiro caminho, com a verificadora das duas guardas e o polinômio explícito.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Esta máquina recebe a leitura, não a procura: não decide SAT sem testemunha.\r\n* Que esta pedra seja termo do gate: o termo do gate é `a_maquina_com_o_leitor_decide_SAT`.\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AMaquinaVerifica\r\n\r\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2 TGLExt.ATensaoMinima Turing.TM2.Stmt Turing\r\nopen TGLExt.AVerificadoraTM2\r\n\r\n/-- ★ **A PONTE DO CORREDOR AO ITERADOR**: o corredor da casa e o iterador do Mathlib\r\n(`(flip bind f)^[n]`) contam os mesmos passos — há um ponto de encontro dentro do combustível. -/\r\ntheorem ponte_correr_para (tm : Turing.FinTM2) (c₀ : tm.Cfg) :\r\n    ∀ (n : ℕ), ∃ k ≤ n, (flip bind tm.step)^[k] c₀\r\n      = correr tm c₀ n := by\r\n  intro n\r\n  induction n generalizing c₀ with\r\n  | zero => exact ⟨0, le_refl 0, rfl⟩\r\n  | succ n ih =>\r\n    cases hstep : tm.step c₀ with\r\n    | none =>\r\n      refine ⟨0, Nat.zero_le _, ?_⟩\r\n      show (some c₀) = correr tm c₀ (n + 1)\r\n      rw [correr, hstep]\r\n    | some c' =>\r\n      obtain ⟨k, hk, h⟩ := ih c'\r\n      refine ⟨k + 1, Nat.succ_le_succ hk, ?_⟩\r\n      rw [Function.iterate_succ_apply]\r\n      show (flip bind tm.step)^[k] ((flip bind tm.step) (some c₀))\r\n        = correr tm c₀ (n + 1)\r\n      have h0 : (flip bind tm.step) (some c₀) = some c' := by\r\n        show Option.bind (some c₀) tm.step = some c'\r\n        rw [Option.bind_some, hstep]\r\n      rw [h0, h]\r\n      show correr tm c' n = correr tm c₀ (n + 1)\r\n      rw [correr, hstep]\r\n\r\n/-- ★ **O MAPA DA ENTRADA É A IDENTIDADE** (auxiliar do habitante). -/\r\ntheorem a_mapa_entrada_id (X : List Simbolo) :\r\n    List.map aAuxDaVerificadora.inputAlphabet.invFun X = X :=\r\n  List.map_id X\r\n\r\n/-- ★ **O MAPA DA SAÍDA É A IDENTIDADE** (auxiliar do habitante). -/\r\ntheorem a_mapa_saida_id (X : List Bool) :\r\n    List.map aAuxDaVerificadora.outputAlphabet.invFun X = X :=\r\n  List.map_id X\r\n\r\n/-- ★ **A CONFIGURAÇÃO FINAL LIMPA É O HALTLIST** (auxiliar do habitante). -/\r\ntheorem a_config_final_e_o_haltList (b : Bool) :\r\n    aConfig none ⟨Fase.copiaEntrada, false, false, none, none⟩ [] [] [] [] [] [b]\r\n      = Turing.haltList aVerificadora [b] := by\r\n  simp only [Turing.haltList, aConfig]\r\n  congr 1\r\n  funext k\r\n  cases k <;> rfl\r\n\r\n/-- ★★★ **A VERIFICADORA EM TEMPO POLINOMIAL**: o habitante do `ObjetivoTM2Polinomial` — a\r\nverificação do certificado de SAT é polinomial no modelo padrão, com as codificações fixas da\r\ncasa. -/\r\ntheorem a_verificadora_em_tempo_polinomial :\r\n    Nonempty (Turing.TM2ComputableInPolyTime codificaEntrada codificaSaida\r\n      (fun p => verificaNaFita p.1 p.2)) := by\r\n  refine ⟨{\r\n    aAuxDaVerificadora with\r\n    time := Polynomial.X ^ 2 + 20 * Polynomial.X + 10\r\n    outputsFun := fun a => ?_\r\n  }⟩\r\n  have h := a_maquina_verifica a.1 a.2\r\n  let fuel := Classical.choose h\r\n  have hfuel : fuel ≤ (codificaEntrada (a.1, a.2)).length * (codificaEntrada (a.1, a.2)).length\r\n      + 20 * (codificaEntrada (a.1, a.2)).length + 10 := (Classical.choose_spec h).1\r\n  have hEq : correr aVerificadora (Turing.initList aVerificadora (codificaEntrada (a.1, a.2))) fuel\r\n      = some (aConfig none ⟨Fase.copiaEntrada, false, false, none, none⟩ [] [] [] [] []\r\n          [verificaNaFita a.1 a.2]) := (Classical.choose_spec h).2\r\n  have hp := ponte_correr_para aVerificadora\r\n    (Turing.initList aVerificadora (codificaEntrada (a.1, a.2))) fuel\r\n  have hk : Classical.choose hp ≤ fuel := (Classical.choose_spec hp).1\r\n  have hiter : (flip bind aVerificadora.step)^[Classical.choose hp]\r\n      (Turing.initList aVerificadora (codificaEntrada (a.1, a.2)))\r\n      = correr aVerificadora (Turing.initList aVerificadora (codificaEntrada (a.1, a.2)))\r\n        fuel := (Classical.choose_spec hp).2\r\n  refine ⟨⟨Classical.choose hp, ?_⟩, ?_⟩\r\n  · show (flip bind aVerificadora.step)^[Classical.choose hp]\r\n        (Turing.initList aVerificadora (List.map id (codificaEntrada a)))\r\n      = some (Turing.haltList aVerificadora (List.map id (codificaSaida (verificaNaFita a.1 a.2))))\r\n    rw [List.map_id, List.map_id]\r\n    show (flip bind aVerificadora.step)^[Classical.choose hp]\r\n        (Turing.initList aVerificadora (codificaEntrada a))\r\n      = some (Turing.haltList aVerificadora [verificaNaFita a.1 a.2])\r\n    rw [← a_config_final_e_o_haltList]\r\n    show (flip bind aVerificadora.step)^[Classical.choose hp]\r\n        (Turing.initList aVerificadora (codificaEntrada (a.1, a.2)))\r\n      = some (aConfig none ⟨Fase.copiaEntrada, false, false, none, none⟩ [] [] [] [] []\r\n          [verificaNaFita a.1 a.2])\r\n    exact hiter.trans hEq\r\n  · have htime : Polynomial.eval ((codificaEntrada a).length)\r\n        (Polynomial.X ^ 2 + 20 * Polynomial.X + 10)\r\n        = (codificaEntrada a).length ^ 2 + 20 * (codificaEntrada a).length + 10 := by\r\n      simp [Polynomial.eval_X, Polynomial.eval_pow, Polynomial.eval_mul, Polynomial.eval_add]\r\n    have hle : fuel ≤ (codificaEntrada a).length ^ 2 + 20 * (codificaEntrada a).length + 10 := by\r\n      have h := hfuel\r\n      rw [show codificaEntrada a = codificaEntrada (a.1, a.2) from rfl] at h ⊢\r\n      rw [pow_two]\r\n      exact h\r\n    exact hk.trans (hle.trans (by rw [htime]))\r\n\r\nend TGLExt.AMaquinaVerifica\r\n\r\n",
+    'TGLExt/AVacuidadeDosContratos.lean': "import TGLExt.OPassoFiel\n\nset_option autoImplicit false\n\n/-!\n# A vacuidade dos contratos da descida, como estão escritos\n\n## O que é\n\nUm contrato nomeado é uma hipótese: um teorema que o toma diz algo sobre as dinâmicas que o cumprem. Se nenhuma\ndinâmica o cumpre, o teorema vale no vazio e não diz nada sobre fórmula alguma. Este módulo mede, no kernel, quais\ncontratos e hipóteses da cadeia da descida podem ser cumpridos como estão escritos.\n\n## O que fica provado [REAL]\n\n1. `aVerdadeFinal_insatisfazivel`, `gatesDaMorte_insatisfazivel`, `gatesDaDescida_insatisfazivel`: nenhuma dinâmica\n   cumpre `AVerdadeFinal`, `GatesDaMorte` ou `GatesDaDescida`. Os três pedem que um espectro contraditório seja\n   servido: uma equação de eixo vazio com valor 1, que nenhum ponto serve (`ninguem_serve2`, `ninguem_serve`); o\n   terceiro, também na fórmula da cláusula vazia, em que todo ponto tem custo 1.\n2. `gates_do_processo_insatisfaziveis`: as hipóteses `hdiv` e `hpoco` dos dois teoremas do laço de `OProcessoDaLuz`\n   (aqui `HDiv` e `HPoco`, com o mesmo enunciado) não valem juntas para nenhum `n` e nenhuma fórmula. `hpoco_falso`:\n   com `n ≥ 1`, a descida do laço não recebe o espectro, e o mesmo poço teria de servir dois espectros que se\n   contradizem. `hdiv_falso_na_paz`: numa fórmula com um ponto em paz, o eixo da morte desse ponto é nulo e a sua\n   paridade nunca é 1. `hdiv_falso_n0`: com `n = 0`, toda paridade é 0.\n3. `hfiel_habitado`: a hipótese `hfiel` (a ressurreição fiel) é cumprida por uma ressurreição que devolve um ponto do\n   resíduo quando ele existe (escolha clássica).\n\n## O que NÃO se afirma\n\n* Nada aqui falsifica a descida, a morte ou a ressurreição: mede a redação dos contratos. Os teoremas das pedras que\n  não tomam esses contratos como hipótese não são afetados.\n* Nada aqui diz que algum processo decida SAT, em tempo algum. Decidir SAT sem testemunha, em tempo polinomial, na\n  máquina de fita segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n-/\n\nnamespace TGLExt.AVacuidadeDosContratos\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\n\n/-- Nenhum ponto serve o espectro de uma equação com eixo vazio e valor 1 (a paridade no eixo vazio é 0). -/\ntheorem ninguem_serve2 {n : ℕ} (x : Fin n → Bool) :\n    serveEspectro2 x [((fun _ => false), (1 : ZMod 2))] = false := by\n  simp [serveEspectro2, paridade2]\n\n/-- O mesmo na forma booleana da camada (i). -/\ntheorem ninguem_serve {n : ℕ} (x : Fin n → Bool) :\n    serveEspectro x [⟨fun _ => false, true⟩] = false := by\n  simp [serveEspectro, serveEquacao, paridade]\n\n/-- `AVerdadeFinal` não é cumprido por nenhuma dinâmica: o campo `divide`, num espectro contraditório, pede um ponto\nque o sirva. -/\ntheorem aVerdadeFinal_insatisfazivel {n : ℕ} (d : DinamicaCompleta n) : ¬ AVerdadeFinal d := by\n  intro g\n  obtain ⟨⟨x, hx, _⟩, _⟩ := g.divide [] [((fun _ => false), (1 : ZMod 2))] (fun _ => false)\n  rw [ninguem_serve2] at hx\n  exact Bool.false_ne_true hx\n\n/-- `GatesDaMorte` não é cumprido por nenhuma dinâmica, pelo mesmo motivo. -/\ntheorem gatesDaMorte_insatisfazivel {n : ℕ} (d : DinamicaDaMorte n) : ¬ GatesDaMorte d := by\n  intro g\n  obtain ⟨⟨x, hx, _⟩, _⟩ := g.divide [] [((fun _ => false), (1 : ZMod 2))] (fun _ => false)\n  rw [ninguem_serve2] at hx\n  exact Bool.false_ne_true hx\n\n/-- `GatesDaDescida` não é cumprido por nenhuma dinâmica: na fórmula da cláusula vazia todo ponto tem custo 1, o\nprogresso obriga a pinagem, e o crescimento pede que a ressurreição sirva um espectro contraditório. -/\ntheorem gatesDaDescida_insatisfazivel {n : ℕ} (d : DinamicaDaDescida n) (T : Prop) :\n    ¬ GatesDaDescida d T := by\n  intro g\n  have hc : ∀ y : Fin n → Bool, custoCNF ([[]] : CNF n) y = 1 := by\n    intro y; simp [custoCNF, satisfeita]\n  have hpin : estaPinado d [[]] (fun _ => false) := by\n    rcases g.progresso [[]] (fun _ => false) (by rw [hc]; omega) with h | h\n    · exact h\n    · rw [hc, hc] at h; omega\n  have h := g.crescimento [[]] [⟨fun _ => false, true⟩] (fun _ => false) hpin (by rw [hc]; omega)\n  simp [serveEspectro, serveEquacao, paridade] at h\n\n/-- A hipótese `hdiv` de `OProcessoDaLuz`, com o mesmo enunciado. -/\ndef HDiv {n : ℕ} (φ : CNF n) : Prop :=\n  ∀ (S : Espectro2 n) (w : Fin n → Bool),\n    serveEspectro2 w S = true → (eixoDaMorteDe φ w) ∉ S.map Prod.fst →\n    (∃ y : Fin n → Bool, serveEspectro2 y S = true ∧ paridade2 y (eixoDaMorteDe φ w) = 0)\n      ∧ (∃ y : Fin n → Bool, serveEspectro2 y S = true ∧ paridade2 y (eixoDaMorteDe φ w) = 1)\n\n/-- A hipótese `hpoco` de `OProcessoDaLuz`, com o mesmo enunciado (a descida do laço não recebe o espectro). -/\ndef HPoco {n : ℕ} (φ : CNF n) : Prop :=\n  ∀ (S : Espectro2 n) (x : Fin n → Bool), (∃ y, serveEspectro2 y S = true) →\n    serveEspectro2 (descerComEspectro φ φ.length ([], x)).2 S = true\n\n/-- `HDiv` falha em toda fórmula com um ponto em paz: o eixo da morte desse ponto é a máscara vazia, cuja paridade é\nsempre 0, e o espectro vazio o serve. -/\ntheorem hdiv_falso_na_paz {n : ℕ} (φ : CNF n) (w : Fin n → Bool) (hw : primeiraSemPar φ w = none) :\n    ¬ HDiv φ := by\n  intro h\n  obtain ⟨-, ⟨y, -, hy⟩⟩ := h [] w (by simp [serveEspectro2]) (by simp)\n  simp [eixoDaMorteDe, hw, paridade2] at hy\n\n/-- `HDiv` falha em toda fórmula com `n = 0`: a paridade em `Fin 0` é a soma vazia. -/\ntheorem hdiv_falso_n0 (φ : CNF 0) : ¬ HDiv φ := by\n  intro h\n  obtain ⟨-, ⟨y, -, hy⟩⟩ := h [] (fun i => i.elim0) (by simp [serveEspectro2]) (by simp)\n  simp [paridade2] at hy\n\n/-- `HPoco` falha em toda fórmula com `n ≥ 1`: os espectros `[(e0, 0)]` e `[(e0, 1)]` são ambos servidos, e o mesmo\npoço, que não depende do espectro, teria de servir os dois. -/\ntheorem hpoco_falso {m : ℕ} (φ : CNF (m + 1)) : ¬ HPoco φ := by\n  intro h\n  let e0 : Fin (m + 1) → Bool := fun i => decide (i = 0)\n  have hp0 : paridade2 (fun _ => false) e0 = 0 := by simp [paridade2]\n  have hp1 : paridade2 e0 e0 = 1 := by simp [paridade2, e0, Finset.sum_ite_eq']\n  have h0 := h [(e0, 0)] (fun _ => false) ⟨fun _ => false, by simp [serveEspectro2, hp0]⟩\n  have h1 := h [(e0, 1)] (fun _ => false) ⟨e0, by simp [serveEspectro2, hp1]⟩\n  simp only [serveEspectro2, List.all_cons, List.all_nil, Bool.and_true, beq_iff_eq] at h0 h1\n  rw [h0] at h1\n  exact absurd h1 (by decide)\n\n/-- ★ As hipóteses `hdiv` e `hpoco` do laço não valem juntas para nenhum `n` e nenhuma fórmula. -/\ntheorem gates_do_processo_insatisfaziveis : ∀ (n : ℕ) (φ : CNF n), ¬ (HDiv φ ∧ HPoco φ)\n  | 0, φ => fun h => hdiv_falso_n0 φ h.1\n  | _ + 1, φ => fun h => hpoco_falso φ h.2\n\n/-- A ressurreição que devolve um ponto do resíduo, quando ele existe (escolha clássica). -/\nnoncomputable def ressurreicaoPorEscolha {n : ℕ} (_φ : CNF n) (S : Espectro2 n) : Fin n → Bool := by\n  classical\n  exact if h : ∃ y, serveEspectro2 y S = true then Classical.choose h else fun _ => false\n\n/-- A hipótese `hfiel` (a ressurreição fiel) é cumprida pela ressurreição por escolha. -/\ntheorem hfiel_habitado {n : ℕ} (φ : CNF n) :\n    ∀ (S : Espectro2 n) (w : Fin n → Bool),\n      serveEspectro2 w S = true → (eixoDaMorteDe φ w) ∉ S.map Prod.fst →\n      serveEspectro2 (ressurreicaoPorEscolha φ (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]))\n        (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]) = true := by\n  intro S w hw _\n  have hex : ∃ y, serveEspectro2 y (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]) = true :=\n    ⟨w, by simp [serveEspectro2, List.all_append] at hw ⊢; exact hw⟩\n  unfold ressurreicaoPorEscolha\n  rw [dif_pos hex]\n  exact Classical.choose_spec hex\n\nend TGLExt.AVacuidadeDosContratos\n",
+    'TGLExt/AMedidaDaHipoteseDoLaco.lean': 'import TGLExt.AMorteUtil\nimport TGLExt.ACompletude\nimport TGLExt.AInvarianciaDaLeitura\n\nset_option autoImplicit false\n\n/-!\n# As hipóteses nomeadas do laço final, medidas\n\n## O que é\n\nOs teoremas do laço final dizem algo sobre uma fórmula só quando a hipótese nomeada que tomam vale para ela. Este módulo\nmede as duas formas dessa hipótese: a da morte sadia (`hgates` em `ACompletude.o_laco_preserva_a_luz`,\n`AFechamentoFinal.o_fechamento` e `ACompletudeFinal.a_completude_final`) e a da morte útil (`hgates` em\n`OFechoDoArco.o_laco_preserva_a_luz_util` e `OFechoDoArco.o_fecho_do_arco`).\n\n## O que fica provado [REAL]\n\n1. `phiUm_satisfazivel`: a fórmula `x₀ ∨ x₁` (`AMorteUtil.phiUm`) tem um ponto de custo zero.\n2. ★ `a_hipotese_do_laco_falha_em_uma_clausula`: a hipótese da morte sadia é falsa para `x₀ ∨ x₁`. No ponto (F, F) a\n   única cláusula está sem par; o eixo da morte é o das duas variáveis, fora do span da lista vazia; e a morte com a\n   paridade oposta à do ponto não é sadia, porque (V, F) e (V, V) são soluções de paridades diferentes nesse eixo.\n3. ★ `a_hipotese_util_do_laco_e_insatisfazivel`: a hipótese da morte útil é falsa para toda fórmula que tenha um ponto\n   de custo não nulo cujo eixo de morte não é o eixo apagado. Ela quantifica sobre todo espectro, inclusive o de uma\n   equação de eixo apagado e valor 1, que nenhum ponto serve; o eixo da morte não está no span desse espectro, e a morte\n   útil pede um ponto que o sirva.\n4. `a_hipotese_util_falha_em_uma_clausula`: em particular, para `x₀ ∨ x₁`.\n\n## O que NÃO se afirma\n\n* Nada aqui falsifica o laço final: os teoremas que tomam essas hipóteses continuam válidos; para as fórmulas acima eles\n  valem no vazio.\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial. Isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AMedidaDaHipoteseDoLaco\n\nopen TGLExt.TraducaoTuring TGLExt.AMorteEARessurreicao TGLExt.AVvem TGLExt.ACompletude TGLExt.AMorteUtil\nopen TGLExt.AparedeDoSpan TGLExt.AInvarianciaDaLeitura\n\n/-- A fórmula `x₀ ∨ x₁` tem um ponto de custo zero. -/\ntheorem phiUm_satisfazivel : ∃ x : Fin 2 → Bool, custoCNF phiUm x = 0 :=\n  ⟨fun _ => true, by decide⟩\n\n/-- ★ A hipótese da morte sadia, com o enunciado de `ACompletude.o_laco_preserva_a_luz`, é falsa para a fórmula\n`x₀ ∨ x₁`. -/\ntheorem a_hipotese_do_laco_falha_em_uma_clausula :\n    ¬ (∀ (S : Espectro2 2) (w : Fin 2 → Bool),\n        custoCNF phiUm w ≠ 0 → ¬ (eixoNoSpanB (S.map Prod.fst) (eixoDaMorteDe phiUm w) = true) →\n        morteSadia phiUm S (eixoDaMorteDe phiUm w) (paridade2 w (eixoDaMorteDe phiUm w) + 1)) := by\n  intro h\n  have hw : custoCNF phiUm (fun _ => false) ≠ 0 := by decide\n  have heixo : eixoDaMorteDe phiUm (fun _ => false) = eixoUm := by decide\n  have hspan : ¬ (eixoNoSpanB (([] : Espectro2 2).map Prod.fst) (eixoDaMorteDe phiUm (fun _ => false)) = true) := by\n    rw [heixo]\n    decide\n  have hs := h [] (fun _ => false) hw hspan\n  have hpar : paridade2 (fun _ => false) eixoUm + 1 = 1 := by decide\n  rw [heixo, hpar] at hs\n  exact a_medida_uma_clausula_nenhum_lado_e_sadio.2 hs\n\n/-- O xor de uma lista de eixos apagados é o eixo apagado. -/\ntheorem xorComb_de_apagados {n : ℕ} :\n    ∀ sub : List (Fin n → Bool), (∀ x ∈ sub, x = fun _ => false) → xorComb sub = fun _ => false := by\n  intro sub\n  induction sub with\n  | nil => intro _; rfl\n  | cons x l ih =>\n    intro hx\n    rw [xorComb_cons, hx x (by simp), ih (fun y hy => hx y (by simp [hy])), xorPonto_zero_esq]\n\n/-- ★ A hipótese da morte útil, com o enunciado de `OFechoDoArco.o_fecho_do_arco`, é falsa para toda fórmula que tenha\num ponto de custo não nulo cujo eixo de morte não é o eixo apagado. -/\ntheorem a_hipotese_util_do_laco_e_insatisfazivel {n : ℕ} (φ : CNF n) (w₀ : Fin n → Bool)\n    (hw₀ : custoCNF φ w₀ ≠ 0) (ha : eixoDaMorteDe φ w₀ ≠ fun _ => false) :\n    ¬ (∀ (S : Espectro2 n) (w : Fin n → Bool),\n        custoCNF φ w ≠ 0 → ¬ (eixoNoSpanB (S.map Prod.fst) (eixoDaMorteDe φ w) = true) →\n        morteUtil φ S (eixoDaMorteDe φ w) (paridade2 w (eixoDaMorteDe φ w) + 1)) := by\n  intro h\n  have hspan : ¬ (eixoNoSpanB (([((fun _ => false), (1 : ZMod 2))] : Espectro2 n).map Prod.fst)\n      (eixoDaMorteDe φ w₀) = true) := by\n    rw [eixoNoSpanB_iff]\n    rintro ⟨sub, hsub, hx⟩\n    apply ha\n    rw [← hx]\n    apply xorComb_de_apagados\n    intro x hxs\n    have hm := hsub hxs\n    simpa using hm\n  have hu := h _ w₀ hw₀ hspan\n  unfold morteUtil at hu\n  obtain ⟨y, _, hy, _⟩ := hu\n  have hn : serveEspectro2 y [((fun _ => false), (1 : ZMod 2))] = false := by\n    simp [serveEspectro2, paridade2]\n  rw [hn] at hy\n  exact Bool.false_ne_true hy\n\n/-- Em particular, a hipótese da morte útil é falsa para `x₀ ∨ x₁`. -/\ntheorem a_hipotese_util_falha_em_uma_clausula :\n    ¬ (∀ (S : Espectro2 2) (w : Fin 2 → Bool),\n        custoCNF phiUm w ≠ 0 → ¬ (eixoNoSpanB (S.map Prod.fst) (eixoDaMorteDe phiUm w) = true) →\n        morteUtil phiUm S (eixoDaMorteDe phiUm w) (paridade2 w (eixoDaMorteDe phiUm w) + 1)) :=\n  a_hipotese_util_do_laco_e_insatisfazivel phiUm (fun _ => false) (by decide) (by decide)\n\nend TGLExt.AMedidaDaHipoteseDoLaco\n',
+    'TGLExt/AAlvoDoFechamentoComputacional.lean': 'import TGLExt.APonteAoTM2\nimport TGLExt.SimCompleta\n\nset_option autoImplicit false\n\n/-!\n# O alvo do fechamento computacional: a máquina com o leitor\n\n## O que é\n\nO enunciado que fecha o gate da prova final pelo caminho da computação: a máquina com o leitor. É uma máquina de Turing padrão\n(a TM2 de Mathlib, `Turing.TM2ComputableInPolyTime`), não uma imagem dela: recebe na fita a fórmula e a leitura\n(`APonteAoTM2.codificaEntrada`) e responde em tempo polinomial no comprimento da entrada. A leitura aceita é correspondente: a\nmáquina aceita uma leitura se e só se ela satisfaz a fórmula. A fórmula tem solução se e só se alguma leitura de n bits é aceita\npela máquina, e essa leitura existe se e só se a leitura do psíon, «o que sou», é diferente de zero\n(`TraducaoTuring.uma_leitura_decide_SAT`).\n\nO módulo escreve também o enunciado da máquina sem o leitor (`AlvoFechamentoComputacional`): a mesma máquina padrão recebendo só\na fórmula, sem leitura, e decidindo em tempo polinomial se ela tem solução. Esse enunciado não é o alvo do gate e segue [OPEN].\n\nO índice de cada variável vai na fita em unário (`codificaLiteral`). Nas fórmulas com as variáveis 0, …, m − 1, a escrita\ncresce de forma polinomial em m e no número de literais; percorrer as 2^m atribuições não é, por isso, tempo polinomial no\ncomprimento da entrada.\n\n## O que fica provado [REAL]\n\n1. `satNaFita` [DEF]: a fórmula da fita é satisfazível quando alguma lista de bits a verifica (`verificaNaFita`, em que um\n   índice fora da lista não satisfaz). `decideSatNaFita` [DEF]: a resposta booleana desse fato.\n2. `AlvoFechamentoComputacional` [DEF]: a máquina sem o leitor; existe a máquina TM2 em tempo polinomial que calcula\n   `decideSatNaFita` a partir de `codificaFormula`.\n3. ★ `satNaFita_da_casa`: para toda fórmula da casa `φ`, a fórmula escrita na fita é satisfazível se e só se `SAT φ`.\n4. `codificaFormula_injetiva`: duas fórmulas com a mesma escrita na fita são a mesma fórmula.\n5. `AlvoDaMaquinaComLeitor` [DEF]: o alvo do gate. (1) A máquina TM2 em tempo polinomial que lê a fórmula e a leitura\n   (`ObjetivoTM2Polinomial`); para toda fórmula da casa com n variáveis, (2) a máquina aceita a leitura x se e só se x\n   satisfaz a fórmula; (3) `SAT φ` se e só se alguma leitura de n bits é aceita; (4) `SAT φ` se e só se «o que sou» da\n   fórmula é diferente de zero.\n6. ★ `a_leitura_aceita_e_correspondente` e `a_leitura_de_n_bits_decide`: os itens (2) e (3) para toda fórmula da casa.\n7. ★★★ `a_maquina_com_o_leitor_decide_SAT`: o alvo do gate, provado, a partir de `SimTM2.verificacao_tm2_polinomial`\n   (a máquina), de `a_leitura_aceita_e_correspondente` e `a_leitura_de_n_bits_decide` (a leitura) e de\n   `TraducaoTuring.uma_leitura_decide_SAT` (o psíon).\n\n## O que NÃO se afirma\n\n* Que a máquina sem o leitor decida SAT em tempo polinomial: `AlvoFechamentoComputacional` está escrito e não provado [OPEN].\n* Na língua de Cook–Levin, o alvo da máquina com o leitor é o enunciado de que SAT está em NP (Cook 1971) [KNOWN]; o\n  enunciado da máquina sem o leitor equivale a P = NP (Cook 1971; Levin 1973) [KNOWN]. Este módulo não prova essa\n  equivalência, e a creditação do problema do milênio não é afirmada.\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AAlvoDoFechamentoComputacional\n\nopen TGLExt.TraducaoTuring TGLExt.APonteAoTM2\n\n/-- [DEF] A fórmula da fita é satisfazível: alguma lista de bits a verifica. -/\ndef satNaFita (φf : List (List (ℕ × Bool))) : Prop :=\n  ∃ bits : List Bool, verificaNaFita φf bits = true\n\n/-- [DEF] A resposta do decisor: verdadeiro exatamente quando a fórmula da fita é satisfazível. -/\nnoncomputable def decideSatNaFita (φf : List (List (ℕ × Bool))) : Bool := by\n  classical exact decide (satNaFita φf)\n\n/-- [DEF] **A MÁQUINA SEM O LEITOR**: uma máquina de Turing padrão (TM2) que, recebendo só a fórmula na fita, devolve em tempo\npolinomial no comprimento da entrada se ela é satisfazível. Não é o alvo do gate; segue [OPEN]. -/\ndef AlvoFechamentoComputacional : Prop :=\n  Nonempty (Turing.TM2ComputableInPolyTime codificaFormula codificaSaida decideSatNaFita)\n\n/-- ★ Para toda fórmula da casa, a fórmula escrita na fita é satisfazível se e só se `SAT φ`. -/\ntheorem satNaFita_da_casa {n : ℕ} (φ : CNF n) : satNaFita (aFormulaNaFita φ) ↔ SAT φ := by\n  constructor\n  · rintro ⟨bits, hb⟩\n    refine ⟨fun i => (bits[i.val]?).getD false, ?_⟩\n    intro C hC\n    unfold verificaNaFita aFormulaNaFita at hb\n    rw [List.all_eq_true] at hb\n    have hc := hb _ (List.mem_map.mpr ⟨C, hC, rfl⟩)\n    rw [List.any_map, List.any_eq_true] at hc\n    obtain ⟨l, hl, hle⟩ := hc\n    unfold satisfeita\n    rw [List.any_eq_true]\n    refine ⟨l, hl, ?_⟩\n    have hbit : bits[l.var.val]? = some l.pos := by simpa using hle\n    unfold Literal.vale\n    simp [hbit]\n  · rintro ⟨x, hx⟩\n    refine ⟨aAtribuicaoNaFita x, ?_⟩\n    rw [a_verificacao_na_fita_e_a_da_casa]\n    exact decide_eq_true ((custo_zero_sse_toda_satisfeita φ x).mpr hx)\n\n/-- A fórmula escrita na fita se lê de volta sem ambiguidade: duas fórmulas com a mesma escrita são a mesma fórmula. -/\ntheorem codificaFormula_injetiva : Function.Injective codificaFormula := by\n  intro a b h\n  have h2 : codificaEntrada (a, []) = codificaEntrada (b, []) := by\n    simp only [codificaEntrada, h]\n  exact congrArg Prod.fst (codificaEntrada_injetiva h2)\n\n/-- [DEF] **O ALVO DO GATE: A MÁQUINA COM O LEITOR.** (1) Existe a máquina de Turing padrão (TM2) que lê na fita a fórmula e a\nleitura e responde em tempo polinomial no comprimento da entrada; e, para toda fórmula da casa com n variáveis, (2) a leitura\naceita é correspondente: a máquina aceita a leitura x se e só se x satisfaz a fórmula; (3) a fórmula tem solução se e só se\nalguma leitura de n bits é aceita; (4) essa leitura existe se e só se a leitura do psíon, «o que sou», é diferente de zero. -/\ndef AlvoDaMaquinaComLeitor : Prop :=\n  ObjetivoTM2Polinomial\n  ∧ ∀ (n : ℕ) (φ : CNF n),\n      (∀ x : Fin n → Bool, verificaNaFita (aFormulaNaFita φ) (aAtribuicaoNaFita x) = true ↔ custoCNF φ x = 0)\n      ∧ (SAT φ ↔ ∃ x : Fin n → Bool, verificaNaFita (aFormulaNaFita φ) (aAtribuicaoNaFita x) = true)\n      ∧ (SAT φ ↔ TGLExt.Identidade.oQueSou (nomeDasSolucoes (custoCNF φ)) ≠ 0)\n\n/-- ★ A leitura aceita é correspondente: a máquina aceita a leitura x se e só se x satisfaz a fórmula (custo zero). -/\ntheorem a_leitura_aceita_e_correspondente {n : ℕ} (φ : CNF n) (x : Fin n → Bool) :\n    verificaNaFita (aFormulaNaFita φ) (aAtribuicaoNaFita x) = true ↔ custoCNF φ x = 0 := by\n  rw [a_verificacao_na_fita_e_a_da_casa]\n  exact decide_eq_true_iff\n\n/-- ★ Com uma leitura de n bits: a fórmula tem solução se e só se a máquina aceita alguma leitura. -/\ntheorem a_leitura_de_n_bits_decide {n : ℕ} (φ : CNF n) :\n    SAT φ ↔ ∃ x : Fin n → Bool, verificaNaFita (aFormulaNaFita φ) (aAtribuicaoNaFita x) = true := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨x, ?_⟩\n    rw [a_verificacao_na_fita_e_a_da_casa]\n    exact decide_eq_true ((custo_zero_sse_toda_satisfeita φ x).mpr hx)\n  · rintro ⟨x, hx⟩\n    rw [a_verificacao_na_fita_e_a_da_casa] at hx\n    exact ⟨x, (custo_zero_sse_toda_satisfeita φ x).mp (of_decide_eq_true hx)⟩\n\n/-- ★★★ **A MÁQUINA COM O LEITOR DECIDE SAT**: o alvo do gate, provado. A máquina é `SimTM2.verificacao_tm2_polinomial`; a\nleitura é `a_leitura_de_n_bits_decide`; o psíon é `TraducaoTuring.uma_leitura_decide_SAT`. -/\ntheorem a_maquina_com_o_leitor_decide_SAT : AlvoDaMaquinaComLeitor :=\n  ⟨TGLExt.SimTM2.verificacao_tm2_polinomial,\n   fun _ φ => ⟨a_leitura_aceita_e_correspondente φ, a_leitura_de_n_bits_decide φ, uma_leitura_decide_SAT φ⟩⟩\n\nend TGLExt.AAlvoDoFechamentoComputacional\n',
+    'TGLExt/AMedidaDaHipoteseDaMontagem.lean': 'import TGLExt.AMontagemFinal\n\nset_option autoImplicit false\n\n/-!\n# A medida da hipótese da montagem\n\n## O que é\n\nA hipótese nomeada dos dois teoremas da montagem (`AMontagemFinal.o_processo_da_tensao_ecoa` e\n`AMontagemFinal.o_processo_completo_ecoa`), escrita como proposição (`HipoteseDaMontagem`) e medida numa fórmula pequena\ne satisfazível.\n\n## O que fica provado [REAL]\n\n1. `HipoteseDaMontagem` [DEF]: para todo espectro S, todo ponto w que o serve, toda cláusula C da fórmula que w falha e toda\n   literal l de C que é retorno útil e que o campo não condena, existe uma solução que serve S e a equação de l. É a\n   hipótese dos dois teoremas da montagem, palavra por palavra.\n2. `phiMontagem` [DEF]: a fórmula de quatro variáveis (x₀ ∨ x₁) ∧ (¬x₀ ∨ x₂ ∨ x₃) ∧ (¬x₀ ∨ x₂ ∨ ¬x₃) ∧ (¬x₀ ∨ ¬x₂ ∨ x₃) ∧\n   (¬x₀ ∨ ¬x₂ ∨ ¬x₃).\n3. `phiMontagem_satisfazivel`: ela tem solução (x₀ falso, x₁ verdadeiro).\n4. `a_literal_x0_nao_e_condenada`: no espectro vazio, o campo não condena a literal x₀ da primeira cláusula; registrar x₀ e\n   fazer a propagação não deixa cláusula com uma literal só nem cláusula toda proibida.\n5. `nenhuma_solucao_tem_x0`: nenhuma solução de `phiMontagem` tem x₀ verdadeiro.\n6. ★★ `a_hipotese_da_montagem_falha`: `HipoteseDaMontagem phiMontagem` é falsa; para essa fórmula satisfazível, os dois\n   teoremas da montagem valem no vazio.\n7. ★★ `o_processo_da_tensao_cala_na_formula_da_medida` e `o_processo_da_tensao_cala_com_mais_combustivel`: partindo do\n   ponto com todas as variáveis falsas, o processo da tensão responde com silêncio nessa fórmula satisfazível, com o\n   combustível n + 1 dos teoremas da montagem e com combustível 50.\n8. ★★ `phiMontagem3_satisfazivel` e `o_processo_da_tensao_cala_em_tres_variaveis`: a variante de três variáveis,\n   (x₀ ∨ x₁) e as quatro cláusulas (¬x₀ ∨ ±x₁ ∨ ±x₂), tem solução, e nela o processo da tensão responde com silêncio, com o\n   combustível n + 1.\n\n## O que NÃO se afirma\n\n* Nada sobre fórmulas em geral, nem sobre a máquina de Turing.\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AMedidaDaHipoteseDaMontagem\n\nopen TGLExt.TraducaoTuring TGLExt.AMorteEARessurreicao TGLExt.OSolverGF2_Parte2 TGLExt.OSinalDeRetorno\nopen TGLExt.ATensaoFundamental\n\n/-- [DEF] A hipótese nomeada dos dois teoremas da montagem, como proposição. -/\ndef HipoteseDaMontagem {n : ℕ} (φ : CNF n) : Prop :=\n  ∀ (S : Espectro2 n) (w : Fin n → Bool) (C : Clausula n) (l : Literal n),\n    serveEspectro2 w S = true → satisfeita C w = false → C ∈ φ → l ∈ C →\n    retornoUtil S l = true → condenadaNoCampo φ S l = false →\n    ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true ∧\n      serveEq y (mascaraDeLiteral l, valorDeLiteral l)\n\n/-- [DEF] A fórmula da medida: (x₀ ∨ x₁) e as quatro cláusulas (¬x₀ ∨ ±x₂ ∨ ±x₃), que juntas impedem x₀ sem que nenhuma fique\ncom uma literal só. -/\ndef phiMontagem : CNF 4 :=\n  [[⟨0, true⟩, ⟨1, true⟩],\n   [⟨0, false⟩, ⟨2, true⟩, ⟨3, true⟩],\n   [⟨0, false⟩, ⟨2, true⟩, ⟨3, false⟩],\n   [⟨0, false⟩, ⟨2, false⟩, ⟨3, true⟩],\n   [⟨0, false⟩, ⟨2, false⟩, ⟨3, false⟩]]\n\n/-- A fórmula da medida tem solução: x₀ falso, x₁ verdadeiro. -/\ntheorem phiMontagem_satisfazivel : ∃ y : Fin 4 → Bool, custoCNF phiMontagem y = 0 :=\n  ⟨fun i => decide (i = 1), by decide⟩\n\n/-- No espectro vazio, o campo não condena a literal x₀. -/\ntheorem a_literal_x0_nao_e_condenada : condenadaNoCampo phiMontagem [] ⟨0, true⟩ = false := by\n  decide\n\n/-- No espectro vazio, a literal x₀ é retorno útil. -/\ntheorem a_literal_x0_e_retorno_util : retornoUtil ([] : Espectro2 4) ⟨0, true⟩ = true := by\n  decide\n\n/-- Nenhuma solução da fórmula da medida tem x₀ verdadeiro. -/\ntheorem nenhuma_solucao_tem_x0 : ∀ y : Fin 4 → Bool, custoCNF phiMontagem y = 0 → y 0 = false := by\n  decide\n\n/-- ★★ A hipótese da montagem é falsa para a fórmula da medida, que é satisfazível. -/\ntheorem a_hipotese_da_montagem_falha : ¬ HipoteseDaMontagem phiMontagem := by\n  intro h\n  obtain ⟨y, hy, -, hl⟩ := h [] (fun _ => false) [⟨0, true⟩, ⟨1, true⟩] ⟨0, true⟩\n    (by decide) (by decide) List.mem_cons_self List.mem_cons_self a_literal_x0_e_retorno_util a_literal_x0_nao_e_condenada\n  have h0 := nenhuma_solucao_tem_x0 y hy\n  unfold serveEq at hl\n  rw [paridade2_mascaraLiteral] at hl\n  simp only [h0] at hl\n  exact absurd hl (by decide)\n\n/-- ★★ Partindo do ponto com todas as variáveis falsas, o processo da tensão responde com silêncio na fórmula da medida, com o\ncombustível n + 1 = 5 dos teoremas da montagem. -/\ntheorem o_processo_da_tensao_cala_na_formula_da_medida :\n    (processoDaTensao phiMontagem 5 (fun _ => false)).1.isSome = false := by\n  decide\n\n/-- ★★ O mesmo silêncio com combustível 50. -/\ntheorem o_processo_da_tensao_cala_com_mais_combustivel :\n    (processoDaTensao phiMontagem 50 (fun _ => false)).1.isSome = false := by\n  decide\n\n/-- [DEF] A variante de três variáveis: (x₀ ∨ x₁) e as quatro cláusulas (¬x₀ ∨ ±x₁ ∨ ±x₂). -/\ndef phiMontagem3 : CNF 3 :=\n  [[⟨0, true⟩, ⟨1, true⟩],\n   [⟨0, false⟩, ⟨1, true⟩, ⟨2, true⟩],\n   [⟨0, false⟩, ⟨1, true⟩, ⟨2, false⟩],\n   [⟨0, false⟩, ⟨1, false⟩, ⟨2, true⟩],\n   [⟨0, false⟩, ⟨1, false⟩, ⟨2, false⟩]]\n\n/-- A variante de três variáveis tem solução: x₀ falso, x₁ verdadeiro, x₂ falso. -/\ntheorem phiMontagem3_satisfazivel : ∃ y : Fin 3 → Bool, custoCNF phiMontagem3 y = 0 :=\n  ⟨fun i => decide (i = 1), by decide⟩\n\n/-- ★★ Em três variáveis, partindo do ponto com todas as variáveis falsas, o processo da tensão responde com silêncio na\nvariante, com o combustível n + 1 = 4 dos teoremas da montagem. -/\ntheorem o_processo_da_tensao_cala_em_tres_variaveis :\n    (processoDaTensao phiMontagem3 4 (fun _ => false)).1.isSome = false := by\n  decide\n\nend TGLExt.AMedidaDaHipoteseDaMontagem\n',
+    'TGLExt/AMedidaDaPonteDoDecisor.lean': 'import TGLExt.APonteDoDecisor\nimport TGLExt.OMapaDosMuros\nimport TGLExt.AMedidaDaHipoteseDaMontagem\n\nset_option autoImplicit false\n\n/-!\n# A medida da hipótese da ponte do decisor\n\n## O que é\n\nA ponte do decisor (`APonteDoDecisor.o_processo_e_o_alvo_se_correspondem`) e a montagem do laço da tensão mínima\n(`AContagemDaTensaoMinima.o_processo_minimo_completo_ecoa`) têm a mesma hipótese nomeada `hgate`. Esta pedra mostra que essa\nhipótese é exatamente `HipoteseDaMontagem` (a de `AMontagemFinal`), sem conversão, e a mede em duas fórmulas satisfazíveis: a\nde três variáveis do contraexemplo (`ATensaoMinima.phiCE`) e a da armadilha do empate (`OMapaDosMuros.phiTrap`).\n\n## O que fica provado [REAL]\n\n1. ★ `a_ponte_vale_sob_a_hipotese_da_montagem` e `a_montagem_minima_vale_sob_a_hipotese_da_montagem`: os dois teoremas\n   aplicam-se a toda fórmula que satisfaz `HipoteseDaMontagem`; a hipótese deles é essa proposição, por definição.\n2. ★★ `a_hipotese_falha_no_contraexemplo`: a hipótese é falsa em `phiCE`, que tem solução. A literal x₀ da cláusula\n   (x₀ ∨ x₁) é retornável e não é condenada pelo campo no espectro vazio, e nenhuma solução tem x₀ verdadeiro.\n3. ★★ `a_regra_minima_ecoa_onde_a_hipotese_falha`: em `phiCE` o processo da tensão mínima responde com a solução, e a\n   hipótese é falsa. A hipótese não descreve a regra da tensão mínima: ela pede que toda literal limpa leve a uma solução,\n   qualquer que seja a regra de escolha.\n4. ★★ `a_hipotese_falha_na_armadilha`: a hipótese é falsa em `phiTrap`, que tem solução; nela o processo da tensão mínima\n   responde com silêncio (`OMapaDosMuros.a_medida_a_tensao_minima_e_refutada_pela_armadilha`).\n\n## O que NÃO se afirma\n\n* Que a ponte do decisor ou a montagem estejam erradas: são implicações corretas; a hipótese delas é que é falsa nas\n  fórmulas medidas.\n* Nada sobre o laço com a poda (`APodaFechaOContorno`), que não usa esta hipótese.\n* Que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AMedidaDaPonteDoDecisor\nopen TGLExt.TraducaoTuring TGLExt.AMorteEARessurreicao TGLExt.OSolverGF2_Parte2 TGLExt.OSinalDeRetorno\nopen TGLExt.ATensaoFundamental TGLExt.OFechoDoCampo TGLExt.ATensaoMinima TGLExt.AContagemDaTensaoMinima\nopen TGLExt.APonteDoDecisor TGLExt.OMapaDosMuros TGLExt.AMedidaDaHipoteseDaMontagem TGLExt.APonteAoTM2\n\n/-- ★ A ponte do decisor vale sob a hipótese da montagem: a hipótese dela é `HipoteseDaMontagem`, por definição. -/\ntheorem a_ponte_vale_sob_a_hipotese_da_montagem {n : ℕ} (φ : CNF n) (h : HipoteseDaMontagem φ) :\n    (processoDaTensaoMinima φ (n + 1) (fun _ => false)).1.isSome = true ↔ satNaFitaLocal (aFormulaNaFita φ) :=\n  o_processo_e_o_alvo_se_correspondem φ h\n\n/-- ★ A montagem do laço da tensão mínima vale sob a mesma hipótese. -/\ntheorem a_montagem_minima_vale_sob_a_hipotese_da_montagem {n : ℕ} (φ : CNF n) (h : HipoteseDaMontagem φ)\n    (hluz : ∃ y : Fin n → Bool, custoCNF φ y = 0) :\n    (processoDaTensaoMinima φ (n + 1) (fun _ => false)).1.isSome = true :=\n  o_processo_minimo_completo_ecoa φ h hluz\n\n/-- Nenhuma solução de `phiCE` tem x₀ verdadeiro. -/\ntheorem nenhuma_solucao_do_contraexemplo_tem_x0 : ∀ y : Fin 3 → Bool, custoCNF phiCE y = 0 → y 0 = false := by\n  decide\n\n/-- ★★ A hipótese da montagem é falsa em `phiCE`, que tem solução. -/\ntheorem a_hipotese_falha_no_contraexemplo : ¬ HipoteseDaMontagem phiCE := by\n  intro h\n  obtain ⟨y, hy, -, hl⟩ := h [] (fun _ => false) [⟨0, true⟩, ⟨1, true⟩] ⟨0, true⟩\n    (by decide) (by decide) List.mem_cons_self List.mem_cons_self (by decide) (by decide)\n  have h0 := nenhuma_solucao_do_contraexemplo_tem_x0 y hy\n  unfold serveEq at hl\n  rw [paridade2_mascaraLiteral] at hl\n  simp only [h0] at hl\n  exact absurd hl (by decide)\n\n/-- ★★ Em `phiCE` o processo da tensão mínima responde com a solução (falso, verdadeiro, falso), e a hipótese da montagem\né falsa. -/\ntheorem a_regra_minima_ecoa_onde_a_hipotese_falha :\n    (processoDaTensaoMinima phiCE 5 (fun _ => false)).1 = some (fun i => decide (i = 1))\n    ∧ ¬ HipoteseDaMontagem phiCE :=\n  ⟨a_medida_o_contraexemplo_ecoa_com_a_tensao_minima, a_hipotese_falha_no_contraexemplo⟩\n\n/-- Nenhuma solução de `phiTrap` tem x₀ verdadeiro. -/\ntheorem nenhuma_solucao_da_armadilha_tem_x0 : ∀ y : Fin 4 → Bool, custoCNF phiTrap y = 0 → y 0 = false := by\n  decide\n\n/-- ★★ A hipótese da montagem é falsa em `phiTrap`, que tem solução. -/\ntheorem a_hipotese_falha_na_armadilha : ¬ HipoteseDaMontagem phiTrap := by\n  intro h\n  obtain ⟨y, hy, -, hl⟩ := h [] (fun _ => false) [⟨0, true⟩, ⟨1, true⟩] ⟨0, true⟩\n    (by decide) (by decide) List.mem_cons_self List.mem_cons_self (by decide) (by decide)\n  have h0 := nenhuma_solucao_da_armadilha_tem_x0 y hy\n  unfold serveEq at hl\n  rw [paridade2_mascaraLiteral] at hl\n  simp only [h0] at hl\n  exact absurd hl (by decide)\n\nend TGLExt.AMedidaDaPonteDoDecisor\n',
 }
 
 

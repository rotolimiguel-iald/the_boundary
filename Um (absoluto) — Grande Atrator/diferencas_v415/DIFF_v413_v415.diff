+    'TGLExt/OCustoDoProcesso.lean': "import TGLExt.AMontagemFinal\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O custo do processo: o fecho é finito e o processo registra no máximo 2n equações\n\n## O que é\n\nA contagem das equações que o processo da tensão registra. O laço registra no máximo n equações (cada registro gasta um pivô\nnovo); o fecho do campo também só registra literais livres, isto é, de eixo novo, e por isso também não passa de n. O custo da\nleitura da fórmula não passa do tamanho dela.\n\n## O que fica provado [REAL]\n\n1. `custoCNF_le_length`: o custo da leitura da fórmula não passa do número de cláusulas.\n2. ★ `passoDePropagacao_nova`: a literal propagada é sempre pivô novo (nem proibida nem implicada pelo espectro).\n3. ★ `o_fecho_conta`: o fecho do campo registra no máximo n leituras forçadas.\n4. ★★ `o_processo_registra_no_maximo_2n`: o processo inteiro registra no máximo 2n equações, o fecho mais o laço, cada um\n   limitado pelo posto.\n\n## O que NÃO se afirma\n\n* O custo de cada passo na fita da máquina padrão: segue [OPEN].\n* Que o processo responda com eco em toda fórmula que tem solução.\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OCustoDoProcesso\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal\n\nvariable {n : ℕ}\n\n/-- O custo da leitura da fórmula não passa do tamanho dela. -/\ntheorem custoCNF_le_length {n : ℕ} (φ : CNF n) (x : Fin n → Bool) :\n    custoCNF φ x ≤ φ.length := by\n  unfold custoCNF\n  exact List.countP_le_length\n\n/-- ★ **A LITERAL PROPAGADA É PIVÔ NOVO**: o passo de propagação só devolve literais livres — nem\nproibidas nem implicadas — logo a sua equação cresce o posto de um. -/\ntheorem passoDePropagacao_nova {n : ℕ} (S : Espectro2 n) (C : Clausula n) (l : Literal n)\n    (h : passoDePropagacao S C = some l) : retornoUtil S l = true := by\n  unfold passoDePropagacao at h\n  split at h\n  · simp at h\n  · rename_i hnimpl\n    split at h\n    · rename_i l' hfiltro\n      have hll : l' = l := Option.some.inj h\n      rw [hll] at hfiltro\n      -- l é livre (não proibida): do filtro\n      have hnl : (!literalProibida S l) = true := by\n        have hm : l ∈ C.filter (fun l => !literalProibida S l) := by\n          rw [hfiltro]; exact List.mem_cons_self\n        exact (List.mem_filter.mp hm).2\n      -- e não implicada: o campo não tinha nenhuma\n      have hanyf : C.any (fun l => literalImplicada S l) = false :=\n        Bool.eq_false_iff.mpr hnimpl\n      have hnimpl : literalImplicada S l = false := by\n        rw [List.any_eq_false] at hanyf\n        have hnlC : l ∈ C := by\n          have hm : l ∈ C.filter (fun l => !literalProibida S l) := by\n            rw [hfiltro]; exact List.mem_cons_self\n          exact (List.mem_filter.mp hm).1\n        have h2 := hanyf l hnlC\n        exact Bool.eq_false_iff.mpr h2\n      -- a lógica dos três estados: nem proibida nem implicada ⟹ pivô existe\n      unfold retornoUtil\n      cases hb : bitPivo (reduzirNova (mascaraDeLiteral l) (valorDeLiteral l) (oEscalonado S)).1 with\n      | some i => rfl\n      | none =>\n        -- a proibida daria v = 1; a implicada daria v = 0\n        have hpro : literalProibida S l = false := by\n          cases hp : literalProibida S l with\n          | false => rfl\n          | true => simp [hp] at hnl\n        have himp : literalImplicada S l = false := hnimpl\n        unfold literalProibida at hpro\n        unfold literalImplicada at himp\n        unfold reducaoLiteral at hpro himp\n        dsimp only [] at hpro himp\n        rw [hb] at hpro himp\n        simp only [Option.isNone_none, Bool.true_and] at hpro himp\n        have hv1 : (reduzirNova (mascaraDeLiteral l) (valorDeLiteral l) (oEscalonado S)).2 ≠ 1 := by\n          intro h1\n          rw [h1] at hpro\n          simp at hpro\n        have hv0 : (reduzirNova (mascaraDeLiteral l) (valorDeLiteral l) (oEscalonado S)).2 ≠ 0 := by\n          intro h0\n          rw [h0] at himp\n          simp at himp\n        have hdois : ∀ v : ZMod 2, v = 0 ∨ v = 1 := by decide\n        obtain hv | hv := hdois (reduzirNova (mascaraDeLiteral l) (valorDeLiteral l) (oEscalonado S)).2\n        · exact (hv0 hv).elim\n        · exact (hv1 hv).elim\n    · simp at h\n\n/-- ★ **O FECHO DO CAMPO É FINITO**: a propagação registra no máximo n leituras forçadas — cada uma é um\npivô novo. -/\ntheorem o_fecho_conta {n : ℕ} (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n),\n      (fechoDoCampo φ fuel S).length + (oEscalonado S).length ≤ S.length + n := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S\n    have h := oEscalonado_length_le S\n    simp [fechoDoCampo]\n    omega\n  | succ f ih =>\n    intro S\n    unfold fechoDoCampo\n    split\n    · have h := oEscalonado_length_le S\n      omega\n    · rename_i l hpasso\n      obtain ⟨C, hCφ, hC⟩ := passoNoCampo_mem S φ l hpasso\n      have hnova := passoDePropagacao_nova S C l hC\n      have hcresce := oEscalonado_cresce_um_com_retorno S l hnova\n      have hih := ih (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\n      have hlen : (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length = S.length + 1 := by\n        rw [List.length_append]; simp\n      omega\n\n/-- ★★ **O PROCESSO REGISTRA NO MÁXIMO 2n EQUAÇÕES**: o fecho do campo não passa de n, e o laço da tensão\nadiciona no máximo n — a máquina inteira é finita no número de variáveis, duas vezes. -/\ntheorem o_processo_registra_no_maximo_2n {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :\n    ((processoDaTensao φ fuel x).2).length ≤ 2 * n := by\n  unfold processoDaTensao\n  dsimp only []\n  have hfecho := o_fecho_conta φ (n + 2) []\n  have hzero : (oEscalonado ([] : Espectro2 n)).length = 0 := rfl\n  rw [hzero] at hfecho\n  have hlaço := a_tensao_faz_no_maximo_n_mortes φ fuel (fechoDoCampo φ (n + 2) [])\n    (ressurreicaoConstrutiva (fechoDoCampo φ (n + 2) []))\n  simp at hfecho\n  omega\n\nend TGLExt.OCustoDoProcesso\n\n",
+    'TGLExt/ATensaoMinima.lean': "import TGLExt.OCustoDoProcesso\n\nset_option autoImplicit false\nset_option maxHeartbeats 1600000\nset_option maxRecDepth 8192\n\n/-!\n# A tensão mínima: a escolha pelo custo do ponto de retorno\n\n## O que é\n\nA regra da primeira literal limpa responde com silêncio numa fórmula de três variáveis que tem solução (`phiCE`): o filtro do\ncampo não condena x₀, mas nenhuma solução tem x₀, e a regra o registra. Esta pedra escreve a regra da tensão mínima: entre as\nliterais limpas (de retorno útil e não condenadas pelo campo), a que deixa o ponto ressurreto com o menor custo; no empate, a\nprimeira.\n\n## O que fica provado [REAL]\n\n1. `custoDoRetorno`, `literalDoRetornoMinimo`, `lacoDaTensaoMinima`, `processoDaTensaoMinima` [DEF]: a regra e o processo.\n2. ★ `o_minimo_existe_quando_ha_limpa`: havendo literal limpa, a escolha existe.\n3. ★★ `o_eco_da_tensao_minima_e_fiel`: o laço só responde com ponto de custo zero.\n4. ★★ `a_medida_a_primeira_limpa_falha_no_contraexemplo`: a regra da primeira limpa responde com silêncio em `phiCE`, que\n   tem solução (por `decide`).\n5. ★★ `a_medida_o_contraexemplo_ecoa_com_a_tensao_minima`: o processo da tensão mínima responde em `phiCE` com a solução\n   (falso, verdadeiro, falso) (por `decide`).\n6. As fórmulas pequenas das pedras anteriores, com a regra nova (por `decide`).\n\n## O que NÃO se afirma\n\n* Que a regra da tensão mínima responda com eco em toda fórmula que tem solução: a fórmula da armadilha do empate\n  (`OMapaDosMuros.phiTrap`) tem solução e nela a regra responde com silêncio.\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.ATensaoMinima\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso\n\n/-- [DEF] O custo do retorno por uma literal: o custo do ponto ressurreto após registrá-la. A leitura do\nsinal de retorno, antes da saída do espectro. -/\ndef custoDoRetorno {n : ℕ} (φ : CNF n) (S : Espectro2 n) (l : Literal n) : ℕ :=\n  custoCNF φ (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\n\n/-- [DEF] A literal do retorno de tensão mínima: entre as limpas, a de menor custo do ponto ressurreto\n(empate: a primeira). -/\ndef literalDoRetornoMinimo {n : ℕ} (φ : CNF n) (S : Espectro2 n) (C : Clausula n) : Option (Literal n) :=\n  (C.filter (fun l => retornoUtil S l && !condenadaNoCampo φ S l)).foldl\n    (fun acc l => match acc with\n      | none => some l\n      | some m => if custoDoRetorno φ S l < custoDoRetorno φ S m then some l else some m)\n    none\n\n/-- [DEF] O laço da tensão mínima: a mesma estrutura do laço da tensão, com a escolha pelo custo do\nponto de retorno. -/\ndef lacoDaTensaoMinima {n : ℕ} (φ : CNF n) :\n    ℕ → Espectro2 n → (Fin n → Bool) → (Option (Fin n → Bool)) × Espectro2 n\n  | 0, S, x => (if custoCNF φ x = 0 then some x else none, S)\n  | fuel + 1, S, x =>\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\n    if custoCNF φ w = 0 then (some w, S)\n    else\n      match primeiraSemPar φ w with\n      | none => (none, S)\n      | some C =>\n        match literalDoRetornoMinimo φ S C with\n        | none => (none, S)\n        | some l =>\n          let S' := S ++ [(mascaraDeLiteral l, valorDeLiteral l)]\n          lacoDaTensaoMinima φ fuel S' (ressurreicaoConstrutiva S')\n\n/-- [DEF] O processo da tensão mínima: o campo fala o fecho primeiro; o laço mínimo corre a partir daí. -/\ndef processoDaTensaoMinima {n : ℕ} (φ : CNF n) (fuel : ℕ) (x : Fin n → Bool) :\n    (Option (Fin n → Bool)) × Espectro2 n :=\n  let S₀ := fechoDoCampo φ (n + 2) []\n  lacoDaTensaoMinima φ fuel S₀ (ressurreicaoConstrutiva S₀)\n\n/-- ★ O mínimo existe quando há limpa: a escolha nunca trava enquanto há porta. (Auxiliar da\ncompletude.) -/\ntheorem o_minimo_existe_quando_ha_limpa {n : ℕ} (φ : CNF n) (S : Espectro2 n) (C : Clausula n)\n    (h : ∃ l ∈ C, retornoUtil S l = true ∧ condenadaNoCampo φ S l = false) :\n    (literalDoRetornoMinimo φ S C).isSome = true := by\n  unfold literalDoRetornoMinimo\n  -- a filtrada é não-vazia\n  obtain ⟨l, hlC, hret, hcond⟩ := h\n  have hnl : (C.filter (fun l => retornoUtil S l && !condenadaNoCampo φ S l)) ≠ [] := by\n    intro hvazio\n    have hm : l ∈ C.filter (fun l => retornoUtil S l && !condenadaNoCampo φ S l) :=\n      List.mem_filter.mpr ⟨hlC, by rw [Bool.and_eq_true]; exact ⟨hret, by rw [hcond]; rfl⟩⟩\n    rw [hvazio] at hm\n    exact absurd hm List.not_mem_nil\n  -- o foldl com a função do mínimo sobre lista não-vazia dá some\n  obtain ⟨l₀, resto, hl₀⟩ := List.exists_cons_of_ne_nil hnl\n  rw [hl₀]\n  suffices h : ∀ (resto : Clausula n) (acc : Option (Literal n)),\n      acc.isSome = true →\n      ((resto.foldl (fun acc l => match acc with\n          | none => some l\n          | some m => if custoDoRetorno φ S l < custoDoRetorno φ S m then some l else some m)\n        acc).isSome = true) by\n    rw [List.foldl_cons]\n    exact h resto (some l₀) rfl\n  intro resto\n  induction resto with\n  | nil => intro acc hacc; simpa using hacc\n  | cons b bs ih =>\n    intro acc hacc\n    rw [List.foldl_cons]\n    apply ih\n    split\n    · rfl\n    · split\n      · rfl\n      · rfl\n\n/-- ★★ **O ECO DA TENSÃO MÍNIMA É FIEL**: o laço novo só responde com ponto de custo zero. -/\ntheorem o_eco_da_tensao_minima_e_fiel {n : ℕ} (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x w : Fin n → Bool) (S' : Espectro2 n),\n      lacoDaTensaoMinima φ fuel S x = (some w, S') → custoCNF φ w = 0 := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S x w S' h\n    unfold lacoDaTensaoMinima at h\n    rw [Prod.mk.injEq] at h\n    obtain ⟨h1, -⟩ := h\n    split at h1\n    · rename_i hcond\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · simp at h1\n  | succ f ih =>\n    intro S x w S' h\n    unfold lacoDaTensaoMinima at h\n    dsimp only [] at h\n    split at h\n    · rename_i hcond\n      rw [Prod.mk.injEq] at h\n      obtain ⟨h1, -⟩ := h\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · split at h\n      · simp at h\n      · split at h\n        · simp at h\n        · exact ih _ _ _ _ h\n\n/-- [MEDIDA] A fórmula de três variáveis: (x₀∨x₁) ∧ (¬x₀∨x₁∨x₂) ∧ (¬x₀∨x₁∨¬x₂) ∧ (¬x₀∨¬x₁∨x₂) ∧\n(¬x₀∨¬x₁∨¬x₂). A luz: (falso, verdadeiro, falso). -/\ndef phiCE : CNF 3 :=\n  [[⟨0, true⟩, ⟨1, true⟩],\n   [⟨0, false⟩, ⟨1, true⟩, ⟨2, true⟩],\n   [⟨0, false⟩, ⟨1, true⟩, ⟨2, false⟩],\n   [⟨0, false⟩, ⟨1, false⟩, ⟨2, true⟩],\n   [⟨0, false⟩, ⟨1, false⟩, ⟨2, false⟩]]\n\n/-- ★★ A regra da primeira limpa (o laço da tensão, `ATensaoFundamental`) responde com silêncio em `phiCE`, que tem\nsolução. -/\ntheorem a_medida_a_primeira_limpa_falha_no_contraexemplo :\n    (processoDaTensao phiCE 5 (fun _ => false)).1 = none\n    ∧ custoCNF phiCE (fun i => decide (i = 1)) = 0 := by\n  decide\n\n/-- ★★ O processo da tensão mínima responde em `phiCE` com a solução (falso, verdadeiro, falso). -/\ntheorem a_medida_o_contraexemplo_ecoa_com_a_tensao_minima :\n    (processoDaTensaoMinima phiCE 5 (fun _ => false)).1 = some (fun i => decide (i = 1)) := by\n  decide\n\n/-- A sanidade com a regra nova: a fofa ecoa com a própria luz. -/\ntheorem a_medida_minima_fofa :\n    (processoDaTensaoMinima phiFofa 5 (fun _ => false)).1 = some (fun _ => true) := by\n  decide\n\n/-- A sanidade: a fofa2 ecoa com a própria luz. -/\ntheorem a_medida_minima_fofa2 :\n    (processoDaTensaoMinima phiFofa2 6 (fun _ => false)).1\n      = some (fun i => decide (i = 0) || decide (i = 1)) := by\n  decide\n\n/-- A sanidade: a cadeia resolve; a insatisfazível cala; a phiMedida segue sã. -/\ntheorem a_medida_minima_sanidade :\n    (processoDaTensaoMinima phiCadeia 5 (fun _ => false)).1.isSome = true\n    ∧ (processoDaTensaoMinima ([[⟨0, true⟩], [⟨0, false⟩]] : CNF 1) 4 (fun _ => false)).1 = none\n    ∧ ((processoDaTensaoMinima ([[⟨0, true⟩, ⟨1, true⟩], [⟨0, false⟩, ⟨1, false⟩]] : CNF 2) 5\n        (fun _ => false)).1).isSome = true := by\n  decide\n\nend TGLExt.ATensaoMinima\n\n",
+    'TGLExt/AContagemDaTensaoMinima.lean': "import TGLExt.ATensaoMinima\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 1600000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A contagem e a montagem da tensão mínima\r\n\r\n## O que é\r\n\r\nA contagem e a montagem condicional, escritas para o laço da tensão mínima: a literal escolhida é limpa; o laço registra no\r\nmáximo n equações; e, sob a hipótese nomeada `hgate`, com solução que serve o espectro e combustível bastante, o laço responde\r\ncom eco.\r\n\r\n## O que fica provado [REAL]\r\n\r\n1. `foldl_some_mem`: a dobra do mínimo devolve sempre um membro da lista ou a semente.\r\n2. ★ `o_minimo_e_limpo`: a literal escolhida pelo mínimo é limpa (de retorno útil e não condenada).\r\n3. `lacoDaTensaoMinima_passo` e `lacoDaTensaoMinima_passo_completo`: a análise do passo.\r\n4. ★★ `a_tensao_minima_faz_no_maximo_n_mortes`: o laço registra no máximo n equações.\r\n5. ★★ `o_processo_da_tensao_minima_ecoa` e `o_processo_minimo_completo_ecoa`: a montagem condicional, sob `hgate`.\r\n\r\n## O que NÃO se afirma\r\n\r\n* Que `hgate` valha: ela é, por definição, a hipótese da montagem (`AMedidaDaHipoteseDaMontagem.HipoteseDaMontagem`) e é\r\n  falsa em fórmulas satisfazíveis de três e de quatro variáveis (`AMedidaDaPonteDoDecisor`); nelas a montagem vale no vazio.\r\n* Que algum processo, ou a máquina de Turing sem o leitor, decida SAT em tempo polinomial: segue [OPEN].\r\n* Nada sobre a natureza.\r\n\r\nSem sorry, sem axioma novo.\r\n-/\r\n\r\nnamespace TGLExt.AContagemDaTensaoMinima\r\n\r\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\r\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\r\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\r\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\r\nopen TGLExt.AVvem TGLExt.OProcessoFinal TGLExt.ACompletude TGLExt.AInvarianciaDaLeitura TGLExt.AMorteUtil\r\nopen TGLExt.OSilencioVivo TGLExt.AParedeDoLadoOposto TGLExt.ACartografiaDaParede TGLExt.OSinalDeRetorno\r\nopen TGLExt.OCampoFalaPrimeiro TGLExt.OFechoDoCampo TGLExt.ATensaoFundamental TGLExt.OPostoDoEscalonado\r\nopen TGLExt.AContagemDaTensao TGLExt.AMontagemFinal TGLExt.OCustoDoProcesso TGLExt.ATensaoMinima\r\n\r\nvariable {n : ℕ}\r\n\r\n/-- A dobra do mínimo devolve um membro da lista ou a semente. (Auxiliar da limpeza da escolha.) -/\r\ntheorem foldl_some_mem {n : ℕ} (φ : CNF n) (S : Espectro2 n) :\r\n    ∀ (Cs : Clausula n) (acc : Option (Literal n)) (l : Literal n),\r\n      (Cs.foldl (fun acc l => match acc with\r\n          | none => some l\r\n          | some m => if custoDoRetorno φ S l < custoDoRetorno φ S m then some l else some m)\r\n        acc = some l) →\r\n      acc = some l ∨ l ∈ Cs := by\r\n  intro Cs\r\n  induction Cs with\r\n  | nil =>\r\n    intro acc l h\r\n    left\r\n    simpa using h\r\n  | cons c cs ih =>\r\n    intro acc l h\r\n    rw [List.foldl_cons] at h\r\n    have hstep := ih _ l h\r\n    rcases hstep with hacc | hmem\r\n    · -- o passo devolveu some l\r\n      by_cases hacc0 : acc = none\r\n      · rw [hacc0] at hacc\r\n        dsimp only [] at hacc\r\n        have hcl : c = l := Option.some.inj hacc\r\n        subst hcl\r\n        exact Or.inr (List.mem_cons.2 (Or.inl rfl))\r\n      · obtain ⟨m, hm⟩ : ∃ m, acc = some m := by\r\n          cases hacc1 : acc with\r\n          | none => exact absurd hacc1 hacc0\r\n          | some m => exact ⟨m, rfl⟩\r\n        rw [hm] at hacc\r\n        dsimp only [] at hacc\r\n        by_cases hlt : custoDoRetorno φ S c < custoDoRetorno φ S m\r\n        · rw [if_pos hlt] at hacc\r\n          have hcl : c = l := Option.some.inj hacc\r\n          subst hcl\r\n          exact Or.inr (List.mem_cons.2 (Or.inl rfl))\r\n        · rw [if_neg hlt] at hacc\r\n          have hml : m = l := Option.some.inj hacc\r\n          subst hml\r\n          left\r\n          exact hm\r\n    · exact Or.inr (List.mem_cons.2 (Or.inr hmem))\r\n\r\n/-- ★ A literal escolhida pelo mínimo é limpa: retornável e não-condenada. (Auxiliar da contagem e da\r\nmontagem.) -/\r\ntheorem o_minimo_e_limpo {n : ℕ} (φ : CNF n) (S : Espectro2 n) (C : Clausula n) (l : Literal n)\r\n    (h : literalDoRetornoMinimo φ S C = some l) :\r\n    retornoUtil S l = true ∧ condenadaNoCampo φ S l = false := by\r\n  unfold literalDoRetornoMinimo at h\r\n  have hmem := foldl_some_mem φ S _ none l h\r\n  -- a semente é none: a escolhida está na filtrada\r\n  have hmem2 : l ∈ C.filter (fun l => retornoUtil S l && !condenadaNoCampo φ S l) := by\r\n    rcases hmem with hnone | hmem\r\n    · simp at hnone\r\n    · exact hmem\r\n  have h2 := (List.mem_filter.mp hmem2).2\r\n  rw [Bool.and_eq_true] at h2\r\n  obtain ⟨h1, h2'⟩ := h2\r\n  refine ⟨h1, ?_⟩\r\n  cases hc : condenadaNoCampo φ S l with\r\n  | false => rfl\r\n  | true => simp [hc] at h2'\r\n\r\n/-- A análise do passo do laço mínimo. -/\r\ntheorem lacoDaTensaoMinima_passo {n : ℕ} (φ : CNF n) (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool) :\r\n    (lacoDaTensaoMinima φ (fuel + 1) S x).2 = S ∨\r\n      ∃ (l : Literal n), retornoUtil S l = true ∧\r\n        (lacoDaTensaoMinima φ (fuel + 1) S x).2 =\r\n          (lacoDaTensaoMinima φ fuel (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n            (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))).2 := by\r\n  rw [lacoDaTensaoMinima.eq_2]\r\n  dsimp only []\r\n  split\r\n  · left; rfl\r\n  · split\r\n    · left; rfl\r\n    · split\r\n      · left; rfl\r\n      · rename_i C hC x2 l hl\r\n        right\r\n        refine ⟨l, ?_, rfl⟩\r\n        exact (o_minimo_e_limpo φ S C l hl).1\r\n\r\n/-- ★★ **A CONTAGEM DA TENSÃO MÍNIMA**: o laço corrigido registra no máximo n equações. -/\r\ntheorem a_tensao_minima_conta_as_mortes {n : ℕ} (φ : CNF n) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool),\r\n      ((lacoDaTensaoMinima φ fuel S x).2).length + (oEscalonado S).length\r\n        ≤ S.length + (oEscalonado (lacoDaTensaoMinima φ fuel S x).2).length := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x\r\n    show S.length + (oEscalonado S).length ≤ S.length + (oEscalonado S).length\r\n    exact Nat.le_refl _\r\n  | succ f ih =>\r\n    intro S x\r\n    rcases lacoDaTensaoMinima_passo φ f S x with h | ⟨l, hret, hstep⟩\r\n    · simp [h]\r\n    · rw [hstep]\r\n      have hcresce := oEscalonado_cresce_um_com_retorno S l hret\r\n      have hih := ih (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n        (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\r\n      have hlen : (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]).length = S.length + 1 := by\r\n        rw [List.length_append]; simp\r\n      omega\r\n\r\n/-- ★★ O laço mínimo é finito: no máximo n mortes. -/\r\ntheorem a_tensao_minima_faz_no_maximo_n_mortes {n : ℕ} (φ : CNF n) (fuel : ℕ) (S : Espectro2 n)\r\n    (x : Fin n → Bool) :\r\n    ((lacoDaTensaoMinima φ fuel S x).2).length ≤ S.length + n := by\r\n  have h1 := a_tensao_minima_conta_as_mortes φ fuel S x\r\n  have h2 := oEscalonado_length_le (lacoDaTensaoMinima φ fuel S x).2\r\n  omega\r\n\r\n/-- A tricotomia do passo do laço mínimo, no nível do par. -/\r\ntheorem lacoDaTensaoMinima_passo_completo {n : ℕ} (φ : CNF n) (fuel : ℕ) (S : Espectro2 n)\r\n    (x : Fin n → Bool) :\r\n    (∃ w : Fin n → Bool, custoCNF φ w = 0 ∧ lacoDaTensaoMinima φ (fuel + 1) S x = (some w, S)) ∨\r\n    (lacoDaTensaoMinima φ (fuel + 1) S x = (none, S)) ∨\r\n    (∃ (l : Literal n) (C : Clausula n),\r\n      primeiraSemPar φ (descerGenerico passoFiel φ S φ.length ([], x)).2 = some C ∧\r\n      literalDoRetornoMinimo φ S C = some l ∧\r\n      lacoDaTensaoMinima φ (fuel + 1) S x =\r\n        lacoDaTensaoMinima φ fuel (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n          (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))) := by\r\n  rw [lacoDaTensaoMinima.eq_2]\r\n  dsimp only []\r\n  split\r\n  · rename_i hcond\r\n    left\r\n    exact ⟨_, hcond, rfl⟩\r\n  · split\r\n    · right; left; rfl\r\n    · split\r\n      · right; left; rfl\r\n      · rename_i C hC x2 l hl\r\n        right; right\r\n        exact ⟨l, C, hC, hl, by simp_all⟩\r\n\r\n/-- ★★ **A MONTAGEM PARA O LAÇO CORRIGIDO**: sob o gate (toda literal limpa de cláusula morta preserva\r\nalguma luz), com luz servida e fuel cobrindo o que falta de posto + 1, o laço da tensão mínima ecoa. -/\r\ntheorem o_processo_da_tensao_minima_ecoa {n : ℕ} (φ : CNF n)\r\n    (hgate : ∀ (S : Espectro2 n) (w : Fin n → Bool) (C : Clausula n) (l : Literal n),\r\n      serveEspectro2 w S = true → satisfeita C w = false → C ∈ φ → l ∈ C →\r\n      retornoUtil S l = true → condenadaNoCampo φ S l = false →\r\n      ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true ∧\r\n        serveEq y (mascaraDeLiteral l, valorDeLiteral l)) :\r\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool),\r\n      serveEspectro2 x S = true →\r\n      (∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true) →\r\n      (oEscalonado S).length + fuel ≥ n + 1 →\r\n      (lacoDaTensaoMinima φ fuel S x).1.isSome = true := by\r\n  intro fuel\r\n  induction fuel with\r\n  | zero =>\r\n    intro S x hx hluz hcomb\r\n    have h := oEscalonado_length_le S\r\n    omega\r\n  | succ f ih =>\r\n    intro S x hx hluz hcomb\r\n    rw [lacoDaTensaoMinima.eq_2]\r\n    dsimp only []\r\n    set w := (descerGenerico passoFiel φ S φ.length ([], x)).2 with hw\r\n    have hpoco : serveEspectro2 w S = true := o_poco_fiel_serve φ S x hx\r\n    cases hc0 : custoCNF φ w with\r\n    | zero =>\r\n      rfl\r\n    | succ c =>\r\n      rw [if_neg (by simp [hc0])]\r\n      -- a cláusula morta existe\r\n      have hpos : 0 < custoCNF φ w := by rw [hc0]; exact Nat.zero_lt_succ c\r\n      unfold custoCNF at hpos\r\n      rw [List.countP_pos_iff] at hpos\r\n      obtain ⟨C₀, hC₀φ, hC₀sat⟩ := hpos\r\n      cases hP : primeiraSemPar φ w with\r\n      | none =>\r\n        unfold primeiraSemPar at hP\r\n        rw [List.find?_eq_none] at hP\r\n        exact absurd hC₀sat (hP C₀ hC₀φ)\r\n      | some C =>\r\n        dsimp only []\r\n        have hfalha : satisfeita C w = false := by\r\n          unfold primeiraSemPar at hP\r\n          have h2 := encontra_satisfaz _ _ _ hP\r\n          cases hs : satisfeita C w with\r\n          | false => rfl\r\n          | true => simp [hs] at h2\r\n        have hCφ : C ∈ φ := by\r\n          unfold primeiraSemPar at hP\r\n          exact (encontra_mem _ _ _ hP).1\r\n        -- o retorno limpo existe, logo a escolha mínima é some\r\n        obtain ⟨l₀, hl₀C, hret₀, hcond₀⟩ := o_retorno_limpo_existe φ S w C hCφ hpoco hfalha hluz\r\n        obtain ⟨l, hl⟩ : ∃ l, literalDoRetornoMinimo φ S C = some l := by\r\n          have h0 := o_minimo_existe_quando_ha_limpa φ S C ⟨l₀, hl₀C, hret₀, hcond₀⟩\r\n          exact Option.isSome_iff_exists.mp h0\r\n        rw [hl]\r\n        dsimp only []\r\n        -- a escolhida pelo mínimo é limpa\r\n        have hlimpa := o_minimo_e_limpo φ S C l hl\r\n        have hlC : l ∈ C := by\r\n          unfold literalDoRetornoMinimo at hl\r\n          have hmem := foldl_some_mem φ S _ none l hl\r\n          rcases hmem with hnone | hmem\r\n          · simp at hnone\r\n          · exact (List.mem_filter.mp hmem).1\r\n        -- o gate transporta a luz\r\n        obtain ⟨y', hy'0, hy'S, hy'eq⟩ := hgate S w C l hpoco hfalha hCφ hlC hlimpa.1 hlimpa.2\r\n        have hluz' : ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧\r\n            serveEspectro2 y (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true := by\r\n          refine ⟨y', hy'0, ?_⟩\r\n          rw [serveEspectro2_append]\r\n          have h1 : serveEspectro2 y' [(mascaraDeLiteral l, valorDeLiteral l)] = true := by\r\n            unfold serveEspectro2\r\n            rw [List.all_cons, List.all_nil]\r\n            show ((paridade2 y' (mascaraDeLiteral l) == valorDeLiteral l) && true) = true\r\n            rw [beq_iff_eq.mpr hy'eq]\r\n            rfl\r\n          rw [h1, hy'S]\r\n          rfl\r\n        have hcresce := oEscalonado_cresce_um_com_retorno S l hlimpa.1\r\n        have hluz'' := hluz'\r\n        obtain ⟨y'', _, hy''serve⟩ := hluz''\r\n        have hx' : serveEspectro2 (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]))\r\n            (S ++ [(mascaraDeLiteral l, valorDeLiteral l)]) = true :=\r\n          o_solver_serve _ ⟨y'', hy''serve⟩\r\n        have hih := ih (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])\r\n          (ressurreicaoConstrutiva (S ++ [(mascaraDeLiteral l, valorDeLiteral l)])) hx' hluz' (by omega)\r\n        exact hih\r\n\r\n/-- ★★ **O PROCESSO MÍNIMO COMPLETO ECOA**: o corolário no processo inteiro. -/\r\ntheorem o_processo_minimo_completo_ecoa {n : ℕ} (φ : CNF n)\r\n    (hgate : ∀ (S : Espectro2 n) (w : Fin n → Bool) (C : Clausula n) (l : Literal n),\r\n      serveEspectro2 w S = true → satisfeita C w = false → C ∈ φ → l ∈ C →\r\n      retornoUtil S l = true → condenadaNoCampo φ S l = false →\r\n      ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true ∧\r\n        serveEq y (mascaraDeLiteral l, valorDeLiteral l))\r\n    (hluz : ∃ y : Fin n → Bool, custoCNF φ y = 0) :\r\n    (processoDaTensaoMinima φ (n + 1) (fun _ => false)).1.isSome = true := by\r\n  unfold processoDaTensaoMinima\r\n  dsimp only []\r\n  obtain ⟨y, hy0⟩ := hluz\r\n  have h0 : serveEspectro2 y ([] : Espectro2 n) = true := by\r\n    unfold serveEspectro2\r\n    simp\r\n  have hyfecho : serveEspectro2 y (fechoDoCampo φ (n + 2) []) = true :=\r\n    o_fecho_e_gratuito φ y hy0 (n + 2) [] h0\r\n  have hx : serveEspectro2 (ressurreicaoConstrutiva (fechoDoCampo φ (n + 2) []))\r\n      (fechoDoCampo φ (n + 2) []) = true := o_solver_serve _ ⟨y, hyfecho⟩\r\n  have hle : (oEscalonado (fechoDoCampo φ (n + 2) [])).length + (n + 1) ≥ n + 1 := by omega\r\n  exact o_processo_da_tensao_minima_ecoa φ hgate (n + 1) _ _ hx ⟨y, hy0, hyfecho⟩ hle\r\n\r\nend TGLExt.AContagemDaTensaoMinima\r\n\r\n",

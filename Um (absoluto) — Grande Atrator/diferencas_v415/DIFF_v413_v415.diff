+def _v415_tex_sem_sumario(text_):
+    """v415 -- the plain-text pre-step: the summary commands (\\addcontentsline with its three groups, \\phantomsection) leave the
+    TeX before it becomes text, so the TXT never carries them."""
+    out_, i_ = [], 0
+    while True:
+        k_ = text_.find("\\addcontentsline{", i_)
+        if k_ < 0:
+            out_.append(text_[i_:])
+            break
+        j_ = k_ + len("\\addcontentsline")
+        for _ in range(3):
+            if j_ >= len(text_) or text_[j_] != "{":
+                raise ValueError("v415: a summary command without its three groups (position %d)" % k_)
+            j_ = _v415_grupo(text_, j_ + 1)
+            if j_ is None:
+                raise ValueError("v415: a summary command never closes (position %d)" % k_)
+        out_.append(text_[i_:k_])
+        i_ = j_
+    return "".join(out_).replace("\\phantomsection", "")

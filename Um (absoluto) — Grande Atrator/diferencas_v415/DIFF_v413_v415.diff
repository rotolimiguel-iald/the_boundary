     'TGLExt/SimLiteral.lean': 'import TGLExt.SimBase\nset_option autoImplicit false\n\nnamespace TGLExt.SimTM2\n\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao\n\nprivate abbrev Tape := List Simbolo\nprivate abbrev Ticks (i : ℕ) := List.replicate i Simbolo.tick\nprivate abbrev bitSymbol (b : Bool) : Simbolo := if b then .um else .zero\nprivate abbrev nextLabel (answer : Bool) : Rotulo :=\n  if answer then .saltarResto else .proximoLiteralCheck\nprivate abbrev branchLabel (answer : Bool) : Rotulo :=\n  if answer then .clausulaSatisfeita else .proximoLiteral\n\nprivate theorem sameLiteralTapes (l : Option Rotulo) (v : Estado)\n    (a b : (k : PilhaK) → List (stackAlphabet k)) (h : ∀ k, a k = b k) :\n    some (⟨l, v, a⟩ : Config) = some (⟨l, v, b⟩ : Config) := by rw [funext h]\n\nlocal macro "litstep" : tactic =>\n  `(tactic| (simp [Ticks, bitSymbol, nextLabel, branchLabel, codificaBits, codificaLiteral,\n      Turing.FinTM2.step, Turing.TM2.step, aMaquinaTM2, cfg, oPrograma, Turing.TM2.stepAux,\n      *] <;> refine sameLiteralTapes _ _ _ _ (fun k => ?_) <;> cases k <;> rfl))\n\n/-- Passa todos os ticks do literal para a pilha de trabalho. O primeiro símbolo\nda continuação é preservado, mesmo quando a continuação é vazia. -/\nprivate theorem moveTicks (i a : ℕ) (tail input : Tape)\n    (safe : tail.head? ≠ some Simbolo.tick) (h : Option Simbolo) (pol route : Bool) :\n    ∃ h\', Runs (i+1)\n      (cfg .andarTicks (h,pol,route) input (Ticks i ++ tail) (Ticks a) [])\n      (cfg .andarBits (h\',pol,false) input tail (Ticks (a+i)) []) := by\n  induction i generalizing a h route with\n  | zero =>\n    refine ⟨h, Runs.one ?_⟩\n    simp only [Nat.add_zero, List.replicate_zero, List.nil_append]\n    litstep\n  | succ i ih =>\n    have first : Runs 1\n        (cfg .andarTicks (h,pol,route) input (Ticks (i+1) ++ tail) (Ticks a) [])\n        (cfg .andarTicks (some .tick,pol,true) input (Ticks i ++ tail) (Ticks (a+1)) []) := by\n      apply Runs.one\n      simp only [Ticks, List.replicate_succ, List.cons_append]\n      litstep\n    obtain ⟨h\', rest⟩ := ih (a+1) (some .tick) true\n    refine ⟨h\', ?_⟩\n    simpa only [Nat.add_assoc, Nat.add_comm, Nat.add_left_comm] using first.trans rest\n\n/-- Os bits salvos formam uma pilha em ordem inversa. Restaurá-la devolve os\nbits à testemunha e deixa o depósito vazio antes de saltar. -/\nprivate theorem restoreBits (saved input tail : Tape) (h : Option Simbolo) (flag ok : Bool) :\n    ∃ t, Runs (saved.length+1)\n      (cfg .restaurar (h,flag,ok) input tail [] saved)\n      (cfg (nextLabel ok) t (saved.reverse ++ input) tail [] []) := by\n  induction saved generalizing input h flag with\n  | nil =>\n    refine ⟨(h,true,ok), Runs.one ?_⟩\n    cases ok <;> litstep\n  | cons a saved ih =>\n    have first : Runs 1\n        (cfg .restaurar (h,flag,ok) input tail [] (a::saved))\n        (cfg .restaurar (some a,false,ok) (a::input) tail [] saved) := by\n      apply Runs.one\n      litstep\n    obtain ⟨t, rest⟩ := ih (a::input) (some a) false\n    refine ⟨t, ?_⟩\n    simpa [List.reverse_cons, List.append_assoc, Nat.add_comm, Nat.add_left_comm, Nat.add_assoc]\n      using first.trans rest\n\nprivate theorem compareBit (found : Option Bool) (pol route : Bool) (saved input tail : Tape) :\n    ∃ t, Runs (saved.length+3)\n      (cfg .comparar (found.map bitSymbol,pol,route) input tail [] saved)\n      (cfg (nextLabel (found == some pol)) t (saved.reverse ++ input) tail [] []) := by\n  let ok := found == some pol\n  have first : Runs 1\n      (cfg .comparar (found.map bitSymbol,pol,route) input tail [] saved)\n      (cfg (branchLabel ok) (none,ok,route) input tail [] saved) := by\n    apply Runs.one\n    dsimp only [ok]\n    cases found with\n    | none => cases pol <;> litstep\n    | some b => cases b <;> cases pol <;> litstep\n  have middle (q : Bool) : Runs 1\n      (cfg (branchLabel q) (none,q,route) input tail [] saved)\n      (cfg .restaurar (none,q,q) input tail [] saved) := by\n    apply Runs.one\n    cases q <;> litstep\n  obtain ⟨t, rest⟩ := restoreBits saved input tail none ok ok\n  exact ⟨t, ((first.trans (middle ok)).trans rest).mono (by omega)⟩\n\n/-- Se a testemunha acabar cedo, a máquina consome o índice restante e compara\ncom none. Nenhuma polaridade satisfaz um literal cujo bit está ausente. -/\nprivate theorem discardTicks (i : ℕ) (tail saved : Tape) (h : Option Simbolo) (pol route : Bool) :\n    Runs (i+1) (cfg .esvaziarTicks (h,pol,route) [] tail (Ticks i) saved)\n      (cfg .comparar (none,pol,true) [] tail [] saved) := by\n  induction i generalizing h route with\n  | zero => apply Runs.one; litstep\n  | succ i ih =>\n    have first : Runs 1\n        (cfg .esvaziarTicks (h,pol,route) [] tail (Ticks (i+1)) saved)\n        (cfg .esvaziarTicks (h,pol,false) [] tail (Ticks i) saved) := by\n      apply Runs.one\n      rw [show Ticks (i+1) = .tick :: Ticks i from List.replicate_succ]\n      litstep\n    exact (first.trans (ih h false)).mono (by omega)\n\nprivate theorem lookupBit (i : ℕ) (bs : List Bool) (saved tail : Tape)\n    (h : Option Simbolo) (pol route : Bool) :\n    ∃ t, Runs (2*i + saved.length + 6)\n      (cfg .andarBits (h,pol,route) (codificaBits bs) tail (Ticks i) saved)\n      (cfg (nextLabel (bs[i]? == some pol)) t (saved.reverse ++ codificaBits bs) tail [] []) := by\n  induction i generalizing bs saved h route with\n  | zero =>\n    have first : Runs 1\n        (cfg .andarBits (h,pol,route) (codificaBits bs) tail [] saved)\n        (cfg .lerBitAtual (h,pol,true) (codificaBits bs) tail [] saved) := by\n      apply Runs.one; litstep\n    have second : Runs 1\n        (cfg .lerBitAtual (h,pol,true) (codificaBits bs) tail [] saved)\n        (cfg .comparar (bs[0]?.map bitSymbol,pol,true) (codificaBits bs) tail [] saved) := by\n      apply Runs.one\n      cases bs <;> litstep\n    obtain ⟨t, rest⟩ := compareBit bs[0]? pol true saved (codificaBits bs) tail\n    exact ⟨t, ((first.trans second).trans rest).mono (by omega)⟩\n  | succ i ih =>\n    cases bs with\n    | nil =>\n      have first : Runs 1\n          (cfg .andarBits (h,pol,route) [] tail (Ticks (i+1)) saved)\n          (cfg .esvaziarTicks (h,pol,true) [] tail (Ticks (i+1)) saved) := by\n        apply Runs.one\n        rw [show Ticks (i+1) = .tick :: Ticks i from List.replicate_succ]\n        litstep\n      have drain := discardTicks (i+1) tail saved h pol true\n      obtain ⟨t, rest⟩ := compareBit none pol true saved [] tail\n      refine ⟨t, ?_⟩\n      simpa only [List.getElem?_nil, codificaBits, List.map_nil] using\n        ((first.trans drain).trans rest).mono (show 1 + (i+1+1) + (saved.length+3) ≤\n          2*(i+1) + saved.length + 6 by omega)\n    | cons b bs =>\n      have first : Runs 1\n          (cfg .andarBits (h,pol,route) (codificaBits (b::bs)) tail (Ticks (i+1)) saved)\n          (cfg .andarBits (some (bitSymbol b),pol,false) (codificaBits bs) tail\n            (Ticks i) (bitSymbol b :: saved)) := by\n        apply Runs.one\n        rw [show Ticks (i+1) = .tick :: Ticks i from List.replicate_succ]\n        litstep\n      obtain ⟨t, rest⟩ := ih bs (bitSymbol b :: saved) (some (bitSymbol b)) false\n      refine ⟨t, ?_⟩\n      have walk := (first.trans rest).mono (show\n        1 + (2*i + (bitSymbol b :: saved).length + 6) ≤ 2*(i+1) + saved.length + 6 by\n          simp only [List.length_cons]; omega)\n      simpa [List.reverse_cons, List.append_assoc, codificaBits] using walk\n\n/-- Uma leitura real do TM2 verifica o literal, consome somente sua codificação\ne restitui a testemunha inteira, também para índices fora da fita. -/\ntheorem literal_run (p : ℕ × Bool) (bs : List Bool) (tail : List Simbolo)\n    (safe : tail.head? ≠ some Simbolo.tick) (s : Estado) :\n    ∃ t : Estado, Runs (4*p.1+9)\n      (cfg .lerLiteral s (codificaBits bs) (codificaLiteral p ++ tail) [] [])\n      (cfg (if (bs[p.1]? == some p.2) then .saltarResto else .proximoLiteralCheck)\n        t (codificaBits bs) tail [] []) := by\n  rcases p with ⟨i, pol⟩\n  have first : Runs 1\n      (cfg .lerLiteral s (codificaBits bs) (codificaLiteral (i,pol) ++ tail) [] [])\n      (cfg .andarTicks (s.1,pol,s.2.2) (codificaBits bs) (Ticks i ++ tail) [] []) := by\n    apply Runs.one\n    cases pol <;> litstep\n  obtain ⟨h, ticks⟩ := moveTicks i 0 tail (codificaBits bs) safe s.1 pol s.2.2\n  rw [Nat.zero_add] at ticks\n  obtain ⟨t, rest⟩ := lookupBit i bs [] tail h pol false\n  refine ⟨t, ?_⟩\n  exact ((first.trans ticks).trans rest).mono (by simp; omega)\n\nend TGLExt.SimTM2\n',
     'TGLExt/SondaContagem.lean': "import TGLExt.EntregaBeta\nset_option autoImplicit false\n\n/-!\n# O produtor da leitura β conta as soluções\n\nA leitura β (`Codex.EntregaBeta`) deixa como hipótese `hr` um produtor `reader : CNF n → ℕ` cujo numerador\ndiádico aproxima a soma normalizada com erro ≤ 1/(4·2ⁿ), no relógio `clock m n` fixado por β. Este módulo prova\ntrês coisas sobre essa hipótese de precisão:\n\n1. ela é habitada: o numerador `4 · contaSolucoes φ` a cumpre;\n2. ela determina o número de soluções: todo produtor que a cumpre dá `(reader φ + 1) / 4 = contaSolucoes φ`;\n3. com `TGLExt.TraducaoTuring.o_que_sou_das_solucoes`, esse número dividido por 2ⁿ é a leitura\n   `oQueSou (nomeDasSolucoes (custoCNF φ))`.\n\nLogo o produtor que falta é essa leitura escrita na fita: contar as soluções de toda CNF, não só decidir se há\numa. A decisão `2 ≤ reader φ` é `0 < contaSolucoes φ`.\n-/\n\nnamespace TGLExt.SondaContagem\n\nopen TGLExt TGLExt.TraducaoTuring TGLExt.AContagemEACarga TGLExt.OPassoEOFim\nopen Codex.RelogioBeta Codex.LeituraBeta Codex.PonteLeituraBeta\n\nvariable {n : ℕ}\n\n/-- O número de soluções da fórmula: as atribuições de custo zero. -/\ndef contaSolucoes (φ : CNF n) : ℕ :=\n  (Finset.univ.filter (fun x : Fin n → Bool => custoCNF φ x = 0)).card\n\n/-- A fórmula é satisfazível exatamente quando há ao menos uma solução. -/\ntheorem sat_sse_ha_solucao (φ : CNF n) : SAT φ ↔ 0 < contaSolucoes φ := by\n  rw [sat_e_existir_custo_zero, contaSolucoes, Finset.card_pos, Finset.filter_nonempty_iff]\n  simp\n\n/-- Cada solução pesa exatamente 1 na soma; as demais atribuições pesam ≥ 0. -/\ntheorem a_soma_cobre_as_solucoes (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    (contaSolucoes φ : ℝ) ≤ weightedSum c k φ := by\n  unfold contaSolucoes weightedSum\n  have h1 : ((Finset.univ.filter (fun x : Fin n → Bool => custoCNF φ x = 0)).card : ℝ)\n      = ∑ x ∈ Finset.univ.filter (fun x : Fin n → Bool => custoCNF φ x = 0),\n          (1 - c.beta) ^ (k * custoCNF φ x) := by\n    rw [Finset.card_eq_sum_ones, Nat.cast_sum, Nat.cast_one]\n    refine Finset.sum_congr rfl (fun x hx => ?_)\n    rw [(Finset.mem_filter.mp hx).2, Nat.mul_zero, pow_zero]\n  rw [h1]\n  exact Finset.sum_le_sum_of_subset_of_nonneg (Finset.filter_subset _ _)\n    (fun y _ _ => pow_nonneg (sub_nonneg.mpr c.beta_lt_one.le) _)\n\n/-- No relógio de β, o que não é solução soma menos de 1/4. -/\ntheorem a_soma_passa_das_solucoes_por_menos_de_um_quarto (c : TGLCoupling) (k : ℕ) (φ : CNF n)\n    (hk : ((n : ℝ) + 2) * Real.log 2 / c.beta < k) :\n    weightedSum c k φ < (contaSolucoes φ : ℝ) + 1 / 4 := by\n  let s : ℝ := (k : ℝ) * (-Real.log (1 - c.beta))\n  have hs : ((n : ℝ) + 2) * Real.log 2 < s := effective_time_gt c n k hk\n  have hs0 : 0 ≤ s := le_of_lt (lt_of_le_of_lt\n    (mul_nonneg (by positivity) (Real.log_nonneg one_le_two)) hs)\n  have hsum := TGLExt.AEscala.a_flutuacao_do_fundo_e_cotada (custoCNF φ) hs0\n  have hN : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n    rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]\n    norm_num\n  rw [hN] at hsum\n  have hp : (0 : ℝ) < (2 : ℝ) ^ n := pow_pos (by norm_num) n\n  have hexp : Real.exp (-s) < Real.exp (-((n : ℝ) * Real.log 2)) / 4 := by\n    have hlt := Real.exp_lt_exp.mpr (show -s < -((n : ℝ) * Real.log 2) - 2 * Real.log 2 by nlinarith)\n    have he2 : Real.exp (2 * Real.log 2) = (4 : ℝ) := by\n      rw [show (2 : ℝ) * Real.log 2 = Real.log 2 + Real.log 2 by ring,\n        Real.exp_add, Real.exp_log (by norm_num : (0 : ℝ) < 2)]\n      norm_num\n    rw [Real.exp_sub, he2] at hlt\n    exact hlt\n  have he : Real.exp (-((n : ℝ) * Real.log 2)) = ((2 : ℝ) ^ n)⁻¹ := by\n    rw [Real.exp_neg, Real.exp_nat_mul, Real.exp_log (by norm_num : (0 : ℝ) < 2)]\n  rw [he] at hexp\n  have htail : (2 : ℝ) ^ n * Real.exp (-s) < 1 / 4 := by\n    calc\n      _ < (2 : ℝ) ^ n * (((2 : ℝ) ^ n)⁻¹ / 4) := mul_lt_mul_of_pos_left hexp hp\n      _ = 1 / 4 := by rw [← mul_div_assoc, mul_inv_cancel₀ hp.ne']\n  unfold weightedSum contaSolucoes\n  rw [a_soma_depois_de_k_passos φ c.beta c.beta_lt_one k]\n  exact lt_of_le_of_lt hsum (by linarith)\n\n/-- O numerador diádico em reais: `dyadic n j = (j/4)/2ⁿ`. -/\ntheorem dyadic_em_reais (j : ℕ) : ((dyadic n j : ℚ) : ℝ) = ((j : ℝ) / 4) / (2 : ℝ) ^ n := by\n  unfold dyadic\n  push_cast\n  rw [pow_add]\n  ring\n\n/-- O numerador que aproxima a soma com erro ≤ 1/4 determina o número de soluções. -/\ntheorem o_numerador_determina (j K : ℕ) (W : ℝ) (hlo : (K : ℝ) ≤ W) (hhi : W < (K : ℝ) + 1 / 4)\n    (h : |(j : ℝ) / 4 - W| ≤ 1 / 4) : (j + 1) / 4 = K := by\n  have hab := abs_le.mp h\n  have h1 : 4 * (K : ℝ) ≤ (j : ℝ) + 1 := by linarith [hab.1]\n  have h2 : (j : ℝ) < 4 * (K : ℝ) + 2 := by linarith [hab.2]\n  have h1n : 4 * K ≤ j + 1 := by exact_mod_cast h1\n  have h2n : j < 4 * K + 2 := by exact_mod_cast h2\n  omega\n\n/-- ★ O CONTADOR CUMPRE A PRECISÃO: o numerador `4 · contaSolucoes φ` satisfaz a hipótese de precisão `hr`,\npara toda fórmula; a hipótese é habitada. -/\ntheorem o_contador_cumpre_a_precisao (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    |(dyadic n (4 * contaSolucoes φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n) := by\n  have hlo := a_soma_cobre_as_solucoes c (clock m n) φ\n  have hhi := a_soma_passa_das_solucoes_por_menos_de_um_quarto c (clock m n) φ (clock_sufficient c m hm n)\n  have hp : (0 : ℝ) < (2 : ℝ) ^ n := pow_pos (by norm_num) n\n  have h4 : (0 : ℝ) < 4 * (2 : ℝ) ^ n := by positivity\n  have hd : ((dyadic n (4 * contaSolucoes φ) : ℚ) : ℝ) = (contaSolucoes φ : ℝ) / (2 : ℝ) ^ n := by\n    rw [dyadic_em_reais]\n    push_cast\n    ring\n  rw [hd]\n  unfold normalizedSum\n  rw [← sub_div, abs_div, abs_of_pos hp, abs_sub_comm, abs_of_nonneg (sub_nonneg.mpr hlo),\n    div_le_div_iff₀ hp h4]\n  have hq : (weightedSum c (clock m n) φ - (contaSolucoes φ : ℝ)) * 4 ≤ 1 := by linarith\n  calc (weightedSum c (clock m n) φ - (contaSolucoes φ : ℝ)) * (4 * (2 : ℝ) ^ n)\n      = ((weightedSum c (clock m n) φ - (contaSolucoes φ : ℝ)) * 4) * (2 : ℝ) ^ n := by ring\n    _ ≤ 1 * (2 : ℝ) ^ n := mul_le_mul_of_nonneg_right hq hp.le\n\n/-- ★ TODO PRODUTOR COM A PRECISÃO CONTA AS SOLUÇÕES: qualquer `reader` que cumpra a hipótese de precisão `hr`\ndevolve, em cada fórmula, o número de soluções: `(reader φ + 1) / 4 = contaSolucoes φ`. -/\ntheorem todo_produtor_com_a_precisao_conta_as_solucoes (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (reader : CNF n → ℕ)\n    (hr : ∀ φ, |(dyadic n (reader φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n))\n    (φ : CNF n) : (reader φ + 1) / 4 = contaSolucoes φ := by\n  have hlo := a_soma_cobre_as_solucoes c (clock m n) φ\n  have hhi := a_soma_passa_das_solucoes_por_menos_de_um_quarto c (clock m n) φ (clock_sufficient c m hm n)\n  have hp : (0 : ℝ) < (2 : ℝ) ^ n := pow_pos (by norm_num) n\n  have h4 : (0 : ℝ) < 4 * (2 : ℝ) ^ n := by positivity\n  have h := hr φ\n  rw [dyadic_em_reais] at h\n  unfold normalizedSum at h\n  rw [← sub_div, abs_div, abs_of_pos hp, div_le_div_iff₀ hp h4] at h\n  have hmul : (|((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| * 4) * (2 : ℝ) ^ n\n      ≤ 1 * (2 : ℝ) ^ n := by\n    calc (|((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| * 4) * (2 : ℝ) ^ n\n        = |((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| * (4 * (2 : ℝ) ^ n) := by ring\n      _ ≤ 1 * (2 : ℝ) ^ n := h\n  have h' : |((reader φ : ℕ) : ℝ) / 4 - weightedSum c (clock m n) φ| ≤ 1 / 4 := by\n    have := le_of_mul_le_mul_right hmul hp\n    linarith\n  exact o_numerador_determina (reader φ) (contaSolucoes φ) _ hlo hhi h'\n\n/-- ★ O PRODUTOR QUE FALTA É A LEITURA DA IALD ESCRITA NA FITA: todo produtor com a precisão `hr` devolve,\ndepois de `(· + 1) / 4` e da divisão por 2ⁿ, exatamente `oQueSou (nomeDasSolucoes (custoCNF φ))`, a leitura do\nNome das soluções (`TGLExt.TraducaoTuring.o_que_sou_das_solucoes`). -/\ntheorem o_produtor_e_a_leitura_da_iald (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (reader : CNF n → ℕ)\n    (hr : ∀ φ, |(dyadic n (reader φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n))\n    (φ : CNF n) :\n    (((((reader φ + 1) / 4 : ℕ) : ℝ) / (2 : ℝ) ^ n : ℝ) : ℂ)\n      = TGLExt.Identidade.oQueSou (nomeDasSolucoes (custoCNF φ)) := by\n  rw [o_que_sou_das_solucoes, todo_produtor_com_a_precisao_conta_as_solucoes c m hm reader hr φ]\n  have hN : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n    rw [Fintype.card_fun, Fintype.card_bool, Fintype.card_fin]\n    norm_num\n  rw [hN]\n  rfl\n\n/-- A decisão `2 ≤ reader φ` é “há ao menos uma solução”: `2 ≤ reader φ ↔ 0 < contaSolucoes φ`. -/\ntheorem a_decisao_e_haver_solucao (c : TGLCoupling) (m : ℕ)\n    (hm : Real.log 2 / c.beta < (m : ℝ)) (reader : CNF n → ℕ)\n    (hr : ∀ φ, |(dyadic n (reader φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n))\n    (φ : CNF n) : 2 ≤ reader φ ↔ 0 < contaSolucoes φ := by\n  have h := todo_produtor_com_a_precisao_conta_as_solucoes c m hm reader hr φ\n  have hd := Codex.EntregaBeta.codeDecision_correct c m hm reader hr φ\n  rw [← sat_sse_ha_solucao, ← hd]\n  simp [Codex.EntregaBeta.codeDecision]\n\nend TGLExt.SondaContagem\n",
     'TGLExt/SimCompleta.lean': 'import TGLExt.SimLiteral\nimport TGLExt.SimExterior\nset_option autoImplicit false\nnamespace TGLExt.SimTM2\n\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao\n\nprivate abbrev Lit := ℕ × Bool\nprivate def hit (bs : List Bool) (p : Lit) : Bool := bs[p.1]? == some p.2\n\nprivate def clauseCost (c : List Lit) : ℕ :=\n  4 * (c.map Prod.fst).sum + 10 * c.length + (codificaClausula c).length + 1\n\nprivate def formulaCost (f : List (List Lit)) : ℕ :=\n  4 * (f.flatten.map Prod.fst).sum + 10 * f.flatten.length + (codificaFormula f).length + f.length\n\nprivate theorem encC_cons (p : Lit) (c : List Lit) :\n    codificaClausula (p::c) = codificaLiteral p ++ codificaClausula c := by\n  simp [codificaClausula, List.append_assoc]\n\nprivate theorem encF_cons (c : List Lit) (f : List (List Lit)) :\n    codificaFormula (c::f) = codificaClausula c ++ codificaFormula f := by\n  simp [codificaFormula, List.append_assoc]\n\nprivate theorem costC_cons (p : Lit) (c : List Lit) :\n    clauseCost (p::c) = 4*p.1 + 10 + (codificaLiteral p).length + clauseCost c := by\n  simp [clauseCost, encC_cons, Nat.mul_add]\n  omega\n\nprivate theorem costF_cons (c : List Lit) (f : List (List Lit)) :\n    formulaCost (c::f) = clauseCost c + formulaCost f := by\n  simp [clauseCost, formulaCost, encF_cons, Nat.mul_add]\n  omega\n\nprivate theorem safeTail (c : List Lit) (tail : Word) :\n    (codificaClausula c ++ tail).head? ≠ some Simbolo.tick := by\n  cases c with\n  | nil => simp [codificaClausula]\n  | cons p c =>\n    rcases p with ⟨i,b⟩\n    cases b <;> simp [encC_cons, codificaLiteral]\n\nprivate def clauseExit (b : Bool) (t : Estado) (i tail : Word) : Config :=\n  if b then cfg .lerClausula t i tail [] []\n  else cfg .limparFormula (t.1,false,t.2.2) i (.fimC :: tail) [] []\n\n/-- Ao satisfazer a cláusula, a máquina alcança a próxima. Ao esgotá-la,\ncomeça a limpeza com o terminador da cláusula ainda na fita. -/\nprivate theorem clause_run (c : List Lit) (tail : Word) (bs : List Bool) (s : Estado)\n    (entry : Rotulo) (he : entry = .lerClausula ∨ entry = .proximoLiteralCheck) :\n    ∃ t : Estado, Runs (clauseCost c)\n      (cfg entry s (codificaBits bs) (codificaClausula c ++ tail) [] [])\n      (clauseExit (c.any (hit bs)) t (codificaBits bs) tail) := by\n  induction c generalizing s entry with\n  | nil =>\n    refine ⟨s, Runs.mono (n := 1) (Runs.one ?_) (by decide)⟩\n    change aMaquinaTM2.step (cfg entry s _ (.fimC :: tail) [] []) =\n      some (cfg .limparFormula (s.1,false,s.2.2) _ (.fimC :: tail) [] [])\n    rcases he with rfl | rfl <;> tmstep\n  | cons p c ih =>\n    rw [encC_cons, List.append_assoc]\n    let state : Estado := (s.1,false,s.2.2)\n    have first : Runs 1\n        (cfg entry s (codificaBits bs) (codificaLiteral p ++ (codificaClausula c ++ tail)) [] [])\n        (cfg .lerLiteral state (codificaBits bs) (codificaLiteral p ++ (codificaClausula c ++ tail)) [] []) := by\n      apply Runs.one\n      rcases p with ⟨j,b⟩\n      rcases he with rfl | rfl <;> cases b <;> simp only [state, codificaLiteral,\n        Bool.false_eq_true, ↓reduceIte, List.cons_append] <;> tmstep\n    obtain ⟨u, lu⟩ := literal_run p bs (codificaClausula c ++ tail) (safeTail c tail) state\n    rw [← show hit bs p = (bs[p.1]? == some p.2) from rfl] at lu\n    cases hh : hit bs p with\n    | false =>\n      simp only [hh, Bool.false_eq_true, ↓reduceIte] at lu\n      obtain ⟨t, rest⟩ := ih u .proximoLiteralCheck (Or.inr rfl)\n      refine ⟨t, ?_⟩\n      simp only [List.any_cons, hh, Bool.false_or]\n      apply ((first.trans lu).trans rest).mono\n      rw [costC_cons]\n      omega\n    | true =>\n      simp only [hh, ↓reduceIte] at lu\n      obtain ⟨t, skip⟩ := skip_run c tail (codificaBits bs) u\n      refine ⟨t, ?_⟩\n      simp only [List.any_cons, hh, Bool.true_or, clauseExit, ↓reduceIte]\n      apply ((first.trans lu).trans skip).mono\n      rw [costC_cons]\n      unfold clauseCost\n      omega\n\nprivate theorem eval_cons (c : List Lit) (f : List (List Lit)) (bs : List Bool) :\n    verificaNaFita (c::f) bs = (c.any (hit bs) && verificaNaFita f bs) := by\n  simp only [verificaNaFita, List.all_cons]\n  rfl\n\nprivate theorem formula_run (f : List (List Lit)) (bs : List Bool) (s : Estado) :\n    Runs (formulaCost f + ((codificaFormula f).length + bs.length + 3))\n      (cfg .lerClausula s (codificaBits bs) (codificaFormula f) [] [])\n      (Turing.haltList aMaquinaTM2 [verificaNaFita f bs]) := by\n  induction f generalizing s with\n  | nil =>\n    have first : Runs 1 (cfg .lerClausula s (codificaBits bs) [.fimF] [] [])\n        (cfg .limparFormula (s.1,true,s.2.2) (codificaBits bs) [.fimF] [] []) := by\n      apply Runs.one\n      tmstep\n    have last := clean_run s.1 true s.2.2 (codificaBits bs) [.fimF]\n    simpa [formulaCost, codificaFormula, codificaBits, verificaNaFita] using first.trans last\n  | cons c f ih =>\n    obtain ⟨t, seg⟩ := clause_run c (codificaFormula f) bs s .lerClausula (Or.inl rfl)\n    rw [eval_cons, encF_cons, costF_cons]\n    cases hv : c.any (hit bs) with\n    | true =>\n      simp only [hv, clauseExit, ↓reduceIte] at seg\n      simp only [Bool.true_and]\n      apply (seg.trans (ih t)).mono\n      simp only [List.length_append]\n      omega\n    | false =>\n      simp only [hv, clauseExit, Bool.false_eq_true, ↓reduceIte] at seg\n      simp only [Bool.false_and]\n      apply (seg.trans (clean_run t.1 false t.2.2 (codificaBits bs) (.fimC :: codificaFormula f))).mono\n      have pos : 1 ≤ (codificaClausula c).length := by simp [codificaClausula]\n      simp only [List.length_cons, List.length_append, codificaBits, List.length_map]\n      omega\n\n/-- Para toda entrada crua, o TM2 para com o bit do verificador dentro\nda soma dos limites de cada fase. -/\ntheorem simulacao_completa : ASimulacaoCompleta := by\n  rintro ⟨f,bs⟩\n  obtain ⟨s, pre⟩ := prepare_run f bs\n  have whole := pre.trans (formula_run f bs s)\n  apply whole.mono\n  unfold contaFases formulaCost\n  dsimp only\n  omega\n\ntheorem verificacao_tm2_polinomial : ObjetivoTM2Polinomial :=\n  o_objetivo_se_reduz_a_simulacao simulacao_completa\n\nopen TGLExt.TraducaoTuring TGLExt.AContagemEACarga TGLExt.AMaquinaEALeitura TGLExt.APonteDeCookLevin\n\n/-- Com uma atribuição fornecida de n bits, a máquina escreve o bit de custo\nzero dentro de um polinômio fixo nas letras da fórmula e em n. -/\ntheorem passos_em_letras_e_bits {n : ℕ} (φ : CNF n) (x : Fin n → Bool) :\n    Nonempty (Turing.TM2OutputsInTime aMaquinaTM2\n      (codificaEntrada (aFormulaNaFita φ, aAtribuicaoNaFita x))\n      (some [decide (custoCNF φ x = 0)]) (20 * ((letras φ + 1) * (n + 1)) + 25)) := by\n  let p := (aFormulaNaFita φ, aAtribuicaoNaFita x)\n  obtain ⟨run⟩ := simulacao_completa p\n  rw [← a_verificacao_na_fita_e_a_da_casa φ x]\n  refine ⟨⟨run.toEvalsTo, run.steps_le_m.trans ?_⟩⟩\n  have bound := a_forma_do_custo_e_polinomial p\n  simp only [Polynomial.eval_add, Polynomial.eval_mul, Polynomial.eval_X, Polynomial.eval_C] at bound\n  have len : (codificaEntrada p).length ≤ (letras φ + 1) * (n + 1) + 1 :=\n    comprimento_em_letras_e_bits φ x\n  omega\n\nend TGLExt.SimTM2\n',
-    'TGLExt/PonteCookLevin.lean': "import TGLExt.TraducaoTuring\nimport TGLExt.F1Fecho394.CanonicalFockModularCoreInputR1\nimport TGLExt.SimCompleta\nimport TGLExt.EntregaBeta\nimport Mathlib.Computability.TuringMachine.Computable\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A PONTE COOK–LEVIN\n\nO P = nP do kernel, a máquina com o leitor (`TraducaoTuring.uma_leitura_decide_SAT`, `TraducaoTuring.o_psion_le_z`),\nescrito na língua das classes de Cook–Levin: a máquina de Turing padrão do Mathlib\n(`Turing.TM2ComputableInPolyTime`).\n\n* §1 A fiação. No tempo pago de k passos do relógio β, a partição do kernel é a soma ponderada da leitura β; o\n  leitor do psíon lê exatamente a soma normalizada; o numerador diádico da leitura (n+3 bits) decide SAT.\n* §2 A fórmula crua, a que a fita do verificador escreve, e a sua CNF sobre os Nomes da fita.\n* §3 O oráculo lê a fita: a resposta da leitura é função da palavra escrita.\n* §4 As classes na máquina padrão: NP (verificador com certificado binário de comprimento polinomial), a redução a\n  SAT, Cook–Levin como hipótese nomeada, e “decidido em tempo polinomial com uma leitura do leitor da TGL”; o que dá\n  sentido às classes: o alfabeto de NP é finito, e a fita da fórmula distingue as fórmulas.\n* §5 Os teoremas: SAT em NP (a máquina TM2 do verificador), SAT com uma leitura, A PONTE (com Cook–Levin, todo\n  problema em NP é decidido em tempo polinomial com uma leitura) e a classe de uma leitura como o fecho de SAT por\n  redução (sem Cook–Levin); no certificado de Fock físico do kernel.\n* §6 A leitura acha a solução: com a resposta do leitor como decisor, a reconstrução da leitura β devolve uma solução\n  com no máximo letras+1 leituras (contadas em leituras e letras, não em passos da máquina TM2).\n\n**Estatuto.** [REAL] os termos deste arquivo. [KNOWN] Cook 1971 e Levin 1973, com a simulação polinomial\nentre máquinas de fita e de pilhas: é o conteúdo da hipótese nomeada `CookLevin`, que entra por citação e não é provada\naqui.\n\n**Na língua clássica.** Para as codificações usuais, com β e a inclinação m fixados antes da entrada, a classe “decidido\nem tempo polinomial com uma leitura” é o fecho de SAT por redução polinomial many-one\n(`a_classe_de_uma_leitura_e_o_fecho_de_SAT`, sem Cook–Levin) e por isso coincide com NP por Cook–Levin: a inclusão de NP\né `a_ponte_cook_levin`; a volta pede a composição de máquinas TM2, que o Mathlib deixa como `proof_wanted` [KNOWN na\nlíngua clássica]. Não é toda a classe P com acesso ao oráculo: só o limiar positivo de uma consulta depois da redução.\nCom um oráculo que conta soluções, “NP contido em P com o oráculo” é imediato [KNOWN]; o que é da TGL é que o oráculo é\no leitor do psíon, por termo do kernel (`o_psion_le_a_soma_normalizada`).\n\n**O custo da leitura** é contado na régua da teoria: o tempo pago, m·(n+2) passos do relógio β ao preço −ln(1−β) cada\n(`o_tempo_pago_e_linear`). Não é contado em passos de fita: na língua clássica a leitura é um oráculo, e uma consulta\nconta um passo.\n\n**O que este arquivo não prova:** Cook–Levin; a máquina sem leitor (SAT em P na máquina padrão, sem consulta), que segue\naberta e não é tocada (Baker–Gill–Solovay 1975 [KNOWN]); o custo da leitura em passos de fita; que um dispositivo físico\nleia num ato (física: na mecânica quântica padrão o traço normalizado sai com precisão aditiva, Knill–Laflamme 1998\n[KNOWN]). Com o leitor que só conta vale NP contido em P com o leitor, não a igualdade das duas classes com leitor.\nValidade no kernel não é creditação.\n-/\n\nnamespace TGLExt.PonteCookLevin\n\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2\nopen Codex.LeituraBeta Codex.RelogioBeta Codex.PonteLeituraBeta Codex.QuantizacaoBeta\n\n/-! ## §1 A fiação: o leitor do kernel cumpre a precisão da leitura β -/\n\nsection Fiacao\n\nvariable {n : ℕ}\n\n/-- [DEF] O TEMPO PAGO DA LEITURA: k passos do relógio β, cada um ao preço −ln(1−β). -/\nnoncomputable def tempoPago (c : TGLCoupling) (k : ℕ) : ℝ := (k : ℝ) * (-Real.log (1 - c.beta))\n\n/-- ★ A PARTIÇÃO É A SOMA β: no tempo pago de k passos, a partição do kernel, Σ e^{−s·custo}, é a soma ponderada da\nleitura β, Σ (1−β)^{k·custo}. -/\ntheorem a_particao_e_a_soma_beta (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    particao (custoCNF φ) (tempoPago c k) = weightedSum c k φ := by\n  unfold particao tempoPago weightedSum\n  refine Finset.sum_congr rfl (fun x _ => ?_)\n  have h1 : 0 < 1 - c.beta := by linarith [c.beta_lt_one]\n  have he : -((k : ℝ) * -Real.log (1 - c.beta) * (custoCNF φ x : ℝ))\n      = ((k * custoCNF φ x : ℕ) : ℝ) * Real.log (1 - c.beta) := by\n    push_cast\n    ring\n  rw [he, Real.exp_nat_mul, Real.exp_log h1]\n\n/-- As atribuições de n Nomes são 2^n. (Auxiliar.) -/\ntheorem o_numero_de_atribuicoes : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n  simp\n\n/-- [DEF] A LEITURA DO PSÍON: o leitor do psíon da luz na trava inscrita da fórmula, no tempo pago de k passos β. -/\nnoncomputable def leituraDoPsion {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) : ℂ :=\n  TheKeyIsTheReader.reader C (travaInscrita C (custoCNF φ) (tempoPago c k))\n\n/-- ★★ O PSÍON LÊ A SOMA NORMALIZADA: a leitura do psíon é exatamente a soma normalizada da leitura β, sem erro. -/\ntheorem o_psion_le_a_soma_normalizada {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    leituraDoPsion C c k φ = ((normalizedSum c k φ : ℝ) : ℂ) := by\n  unfold leituraDoPsion\n  rw [o_psion_le_z C (custoCNF φ) (tempoPago c k), a_particao_e_a_soma_beta, o_numero_de_atribuicoes]\n  rfl\n\n/-- A parte real da leitura é a soma normalizada. (Auxiliar.) -/\ntheorem a_parte_real_da_leitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    (leituraDoPsion C c k φ).re = normalizedSum c k φ := by\n  rw [o_psion_le_a_soma_normalizada]\n  exact Complex.ofReal_re _\n\n/-- [DEF] A RESPOSTA DA LEITURA: o numerador diádico (sobre 2^(n+2)) da leitura do psíon, no tempo do relógio β de\ninclinação m. -/\nnoncomputable def respostaDaLeitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) : ℕ :=\n  ⌊(leituraDoPsion C c (clock m n) φ).re * (2 : ℝ) ^ (n + 2)⌋₊\n\n/-- ★★ A RESPOSTA TEM A PRECISÃO DA LEITURA β: o numerador diádico da leitura do psíon fica a no máximo 1/(4·2^n) da\nsoma normalizada (a hipótese de precisão da leitura β, cumprida pelo leitor do kernel). -/\ntheorem a_resposta_tem_a_precisao {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) :\n    |(dyadic n (respostaDaLeitura C c m φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n) := by\n  unfold respostaDaLeitura\n  rw [a_parte_real_da_leitura]\n  set y := normalizedSum c (clock m n) φ with hy\n  have hy0 : 0 ≤ y := normalizedSum_nonneg c (clock m n) φ\n  set D : ℝ := (2 : ℝ) ^ (n + 2) with hDdef\n  have hD : 0 < D := by positivity\n  set j := ⌊y * D⌋₊ with hj\n  have h1 : (j : ℝ) ≤ y * D := Nat.floor_le (mul_nonneg hy0 hD.le)\n  have h2 : y * D < (j : ℝ) + 1 := Nat.lt_floor_add_one (y * D)\n  have hcast : ((dyadic n j : ℚ) : ℝ) = (j : ℝ) / D := by\n    simp [dyadic, hDdef]\n  have h4 : (4 * (2 : ℝ) ^ n) = D := by\n    rw [hDdef, pow_add]\n    ring\n  rw [hcast, h4]\n  have key : |(j : ℝ) - y * D| ≤ 1 := by\n    rw [abs_le]\n    constructor <;> linarith\n  have hsub : ((j : ℝ) - y * D) / D = (j : ℝ) / D - y := by\n    rw [sub_div, mul_div_assoc, div_self hD.ne', mul_one]\n  rw [← hsub, abs_div, abs_of_pos hD, div_le_div_iff_of_pos_right hD]\n  exact key\n\n/-- ★★★ UMA LEITURA DO PSÍON DECIDE SAT, COM A RESPOSTA NA FITA: com a inclinação m do relógio β acima de ln 2/β, o\nnumerador da leitura do psíon passa de 2 se, e só se, a fórmula é satisfazível. -/\ntheorem uma_leitura_do_psion_decide_SAT {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    2 ≤ respostaDaLeitura C c m φ ↔ SAT φ := by\n  have h := dyadic_correct c m hm φ (respostaDaLeitura C c m φ) (a_resposta_tem_a_precisao C c m φ)\n  simpa using h\n\n/-- ★ A RESPOSTA CABE EM n+3 BITS. -/\ntheorem a_resposta_cabe_em_n_mais_tres_bits {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) :\n    respostaDaLeitura C c m φ < 2 ^ (n + 3) := by\n  apply dyadic_word_bound\n  unfold respostaDaLeitura\n  rw [a_parte_real_da_leitura]\n  apply Nat.floor_le_of_le\n  have h1 := normalizedSum_le_one c (clock m n) φ\n  have hD : (0 : ℝ) ≤ (2 : ℝ) ^ (n + 2) := by positivity\n  calc normalizedSum c (clock m n) φ * (2 : ℝ) ^ (n + 2) ≤ 1 * (2 : ℝ) ^ (n + 2) :=\n        mul_le_mul_of_nonneg_right h1 hD\n    _ = ((2 ^ (n + 2) : ℕ) : ℝ) := by push_cast; ring\n\n/-- ★ O TEMPO PAGO É LINEAR NOS NOMES: a leitura paga m·(n+2) passos do relógio β. -/\ntheorem o_tempo_pago_e_linear (c : TGLCoupling) (m : ℕ) :\n    tempoPago c (clock m n) = ((m * (n + 2) : ℕ) : ℝ) * (-Real.log (1 - c.beta)) := rfl\n\nend Fiacao\n\n/-! ## §2 A fórmula crua e a sua CNF -/\n\n/-- [DEF] A FÓRMULA CRUA: as cláusulas como listas de pares (índice do Nome, polaridade), como a fita do verificador as\nescreve. -/\nabbrev FormulaCrua := List (List (ℕ × Bool))\n\n/-- [DEF] SAT DA FÓRMULA CRUA: alguma atribuição dos índices satisfaz toda cláusula (um literal de cada cláusula tem o\nvalor da sua polaridade). -/\ndef SATcru (φf : FormulaCrua) : Prop := ∃ x : ℕ → Bool, ∀ C ∈ φf, ∃ p ∈ C, x p.1 = p.2\n\n/-- [DEF] OS NOMES DA FITA: o comprimento da fita da fórmula, cota de todos os índices que ela escreve. -/\ndef nomesDaFita (φf : FormulaCrua) : ℕ := (codificaFormula φf).length\n\n/-- O comprimento da fita da fórmula: soma dos índices, literais, cláusulas e o terminador. -/\ntheorem o_comprimento_da_fita_da_formula (φf : FormulaCrua) :\n    (codificaFormula φf).length = (φf.flatten.map Prod.fst).sum + φf.flatten.length + φf.length + 1 := by\n  have h := comprimento_exato φf []\n  rw [show codificaEntrada (φf, []) = codificaFormula φf ++ [Simbolo.sep] from by\n    simp [codificaEntrada, codificaBits]] at h\n  rw [List.length_append, List.length_singleton, List.length_nil] at h\n  omega\n\nprivate theorem le_soma_de_membro {l : List ℕ} {a : ℕ} (h : a ∈ l) : a ≤ l.sum := by\n  induction l with\n  | nil => simp at h\n  | cons b l ih =>\n    rw [List.sum_cons]\n    rcases List.mem_cons.mp h with rfl | h'\n    · omega\n    · have := ih h'\n      omega\n\n/-- Todo índice escrito na fita é menor que os Nomes da fita. -/\ntheorem indice_na_fita (φf : FormulaCrua) {C : List (ℕ × Bool)} (hC : C ∈ φf) {p : ℕ × Bool} (hp : p ∈ C) :\n    p.1 < nomesDaFita φf := by\n  have hmem : p.1 ∈ φf.flatten.map Prod.fst := List.mem_map.mpr ⟨p, List.mem_flatten.mpr ⟨C, hC, hp⟩, rfl⟩\n  have := le_soma_de_membro hmem\n  unfold nomesDaFita\n  rw [o_comprimento_da_fita_da_formula]\n  omega\n\ntheorem nomesDaFita_pos (φf : FormulaCrua) : 0 < nomesDaFita φf := by\n  unfold nomesDaFita\n  rw [o_comprimento_da_fita_da_formula]\n  omega\n\n/-- [DEF] O índice como Nome de `Fin N` (o índice, se cabe; senão o último Nome). -/\ndef comoNome (N : ℕ) (hN : 0 < N) (i : ℕ) : Fin N := ⟨min i (N - 1), by omega⟩\n\ntheorem comoNome_val {N : ℕ} (hN : 0 < N) {i : ℕ} (hi : i < N) : (comoNome N hN i).val = i :=\n  Nat.min_eq_left (by omega)\n\n/-- [DEF] A CNF DA FÓRMULA CRUA, sobre os Nomes da fita. -/\ndef paraCNF (φf : FormulaCrua) : CNF (nomesDaFita φf) :=\n  φf.map fun C => C.map fun p => (⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩ : Literal (nomesDaFita φf))\n\n/-- ★ A FÓRMULA CRUA E A SUA CNF TÊM O MESMO SIM. -/\ntheorem sat_cru_sse_sat (φf : FormulaCrua) : SATcru φf ↔ SAT (paraCNF φf) := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨fun i => x i.val, ?_⟩\n    intro C' hC'\n    obtain ⟨C, hC, rfl⟩ := List.mem_map.mp hC'\n    obtain ⟨p, hp, hpx⟩ := hx C hC\n    unfold satisfeita\n    rw [List.any_eq_true]\n    refine ⟨⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩, List.mem_map.mpr ⟨p, hp, rfl⟩, ?_⟩\n    simp [Literal.vale, comoNome_val (nomesDaFita_pos φf) (indice_na_fita φf hC hp), hpx]\n  · rintro ⟨y, hy⟩\n    refine ⟨fun i => if h : i < nomesDaFita φf then y ⟨i, h⟩ else false, ?_⟩\n    intro C hC\n    have hsat := hy (C.map fun p => (⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩ : Literal (nomesDaFita φf)))\n      (List.mem_map.mpr ⟨C, hC, rfl⟩)\n    unfold satisfeita at hsat\n    rw [List.any_eq_true] at hsat\n    obtain ⟨l, hl, hlv⟩ := hsat\n    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hl\n    refine ⟨p, hp, ?_⟩\n    have hi := indice_na_fita φf hC hp\n    simp only [Literal.vale, beq_iff_eq] at hlv\n    show (if h : p.1 < nomesDaFita φf then y ⟨p.1, h⟩ else false) = p.2\n    rw [dif_pos hi]\n    have hn : comoNome _ (nomesDaFita_pos φf) p.1 = ⟨p.1, hi⟩ := Fin.ext (comoNome_val _ hi)\n    rw [← hn]\n    exact hlv\n\n/-! ## §3 O oráculo lê a fita -/\n\n/-- [DEF] A RESPOSTA DA LEITURA PARA A FÓRMULA CRUA. -/\nnoncomputable def respostaDaFita {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φf : FormulaCrua) : ℕ :=\n  respostaDaLeitura C c m (paraCNF φf)\n\n/-- ★★ UMA LEITURA DECIDE A FÓRMULA CRUA. -/\ntheorem uma_leitura_decide_SATcru {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φf : FormulaCrua) :\n    2 ≤ respostaDaFita C c m φf ↔ SATcru φf :=\n  (uma_leitura_do_psion_decide_SAT C c m hm (paraCNF φf)).trans (sat_cru_sse_sat φf).symm\n\n/-- [DEF] O ORÁCULO DA LEITURA: lê a palavra escrita na fita de consulta (decodificada pelo decodificador do\nverificador) e devolve a resposta da leitura; palavra que não é fórmula recebe 0. -/\nnoncomputable def oraculo {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (s : List Simbolo) : ℕ :=\n  match decodificaEntrada (s ++ [Simbolo.sep]) with\n  | some q => respostaDaFita C c m q.1\n  | none => 0\n\n/-- ★★ O ORÁCULO LÊ A FITA: na palavra da fórmula, o oráculo devolve a resposta da leitura da fórmula. -/\ntheorem o_oraculo_le_a_fita {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φf : FormulaCrua) :\n    oraculo C c m (codificaFormula φf) = respostaDaFita C c m φf := by\n  have h : codificaFormula φf ++ [Simbolo.sep] = codificaEntrada (φf, []) := by\n    simp [codificaEntrada, codificaBits]\n  unfold oraculo\n  rw [h, decodifica_codifica]\n\n/-! ## §4 As classes de Cook–Levin na máquina padrão -/\n\n/-- [DEF] O PAR NA FITA: a entrada, a divisória e o certificado binário, cada bit pelo seu símbolo. -/\ndef juntaNaFita {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (q : α × List Bool) : List Γ :=\n  ea q.1 ++ [sep] ++ q.2.map bit\n\n/-- [DEF] A CLASSE NP NA MÁQUINA PADRÃO: há um verificador calculado em tempo polinomial pela máquina TM2 do Mathlib\nsobre o par na fita, e um polinômio que limita o certificado binário; o problema é o sim de algum certificado. A\ncodificação da entrada é dada; a do par é a junção fixa acima; o certificado é uma palavra binária. -/\ndef EmNP {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop) : Prop :=\n  ∃ (V : α × List Bool → Bool) (p : Polynomial ℕ),\n    Nonempty (Turing.TM2ComputableInPolyTime (juntaNaFita ea sep bit) (fun b : Bool => [b]) V) ∧\n    ∀ a, A a ↔ ∃ w : List Bool, w.length ≤ p.eval (ea a).length ∧ V (a, w) = true\n\n/-- [DEF] A REDUÇÃO A SAT NA MÁQUINA PADRÃO: uma função calculada em tempo polinomial pela máquina TM2, da codificação\nda entrada à fita da fórmula do verificador, que leva o sim do problema ao sim da fórmula. -/\ndef ReduzASAT {α Γ : Type} (ea : α → List Γ) (A : α → Prop) : Prop :=\n  ∃ g : α → FormulaCrua, Nonempty (Turing.TM2ComputableInPolyTime ea codificaFormula g) ∧ ∀ a, A a ↔ SATcru (g a)\n\n/-- [DEF, HIPÓTESE NOMEADA] COOK–LEVIN NA MÁQUINA PADRÃO: todo problema em NP se reduz a SAT. [KNOWN] Cook 1971,\nLevin 1973, com a simulação polinomial entre máquinas de fita e de pilhas e a troca polinomial de codificação; entra\npor citação, como hipótese de cada teorema que a usa; não é provada aqui. -/\ndef CookLevin : Prop :=\n  ∀ (α Γ : Type) (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop), EmNP ea sep bit A → ReduzASAT ea A\n\n/-- [DEF] DECIDIDO EM TEMPO POLINOMIAL COM UMA LEITURA DO LEITOR DA TGL: a máquina TM2 escreve, em tempo polinomial,\numa fórmula na fita de consulta; o oráculo da leitura lê a palavra; o problema é o sim do limiar 2 da resposta. Na\nlíngua clássica, é o fecho de SAT por redução polinomial many-one (`a_classe_de_uma_leitura_e_o_fecho_de_SAT`): só o\nlimiar positivo de uma consulta depois da redução, não toda a classe P com acesso ao oráculo. -/\ndef EmPComUmaLeitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (c : TGLCoupling) (m : ℕ)\n    {α Γ : Type} (ea : α → List Γ) (A : α → Prop) : Prop :=\n  ∃ g : α → FormulaCrua, Nonempty (Turing.TM2ComputableInPolyTime ea codificaFormula g) ∧\n    ∀ a, A a ↔ 2 ≤ oraculo C c m (codificaFormula (g a))\n\n/-- ★ O ALFABETO DE NP É FINITO: a máquina TM2 que testemunha um problema em NP tem alfabeto de entrada finito, e o\nalfabeto da codificação lhe é equivalente. A premissa `EmNP` de `CookLevin` só vale em alfabeto finito, como no teorema\nclássico. -/\ntheorem o_alfabeto_de_np_e_finito {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop)\n    (h : EmNP ea sep bit A) : Finite Γ := by\n  obtain ⟨V, p, ⟨M⟩, _⟩ := h\n  letI : Fintype (M.tm.Γ M.tm.k₀) := M.tm.Γk₀Fin\n  exact Finite.of_equiv (M.tm.Γ M.tm.k₀) M.inputAlphabet\n\n/-- ★ A FITA DA FÓRMULA DISTINGUE AS FÓRMULAS: a codificação da fórmula crua é injetiva. -/\ntheorem a_fita_da_formula_e_injetiva : Function.Injective codificaFormula := by\n  intro a b h\n  have he : codificaEntrada (a, []) = codificaEntrada (b, []) := by\n    simp only [codificaEntrada, h]\n  exact congrArg Prod.fst (codificaEntrada_injetiva he)\n\n/-! ## §5 Os teoremas -/\n\n/-- [DEF] O bit do certificado na fita do verificador. -/\ndef bitNaFita (b : Bool) : Simbolo := if b then Simbolo.um else Simbolo.zero\n\n/-- A junção fixa, com a divisória e os bits do verificador, é a entrada do verificador. -/\ntheorem a_juncao_e_a_entrada_do_verificador :\n    juntaNaFita codificaFormula Simbolo.sep bitNaFita = codificaEntrada := by\n  funext q\n  rfl\n\n/-- ★ O SIM DA FÓRMULA CRUA É O SIM DE UM CERTIFICADO CURTO: um certificado binário não maior que a fita da fórmula. -/\ntheorem sat_cru_sse_certificado (φf : FormulaCrua) :\n    SATcru φf ↔ ∃ w : List Bool, w.length ≤ (codificaFormula φf).length ∧ verificaNaFita φf w = true := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨List.ofFn (fun i : Fin (nomesDaFita φf) => x i.val), by simp [nomesDaFita], ?_⟩\n    unfold verificaNaFita\n    rw [List.all_eq_true]\n    intro C hC\n    rw [List.any_eq_true]\n    obtain ⟨p, hp, hpx⟩ := hx C hC\n    refine ⟨p, hp, ?_⟩\n    have hi := indice_na_fita φf hC hp\n    rw [List.getElem?_ofFn, dif_pos hi]\n    simp [hpx]\n  · rintro ⟨w, _, hw⟩\n    refine ⟨fun i => (w[i]?).getD false, ?_⟩\n    intro C hC\n    unfold verificaNaFita at hw\n    rw [List.all_eq_true] at hw\n    have hC' := hw C hC\n    rw [List.any_eq_true] at hC'\n    obtain ⟨p, hp, hpw⟩ := hC'\n    refine ⟨p, hp, ?_⟩\n    have hwp : w[p.1]? = some p.2 := by simpa using hpw\n    simp [hwp]\n\n/-- ★★ SAT ESTÁ EM NP NA MÁQUINA PADRÃO: o verificador é a máquina TM2 concreta (`SimTM2.verificacao_tm2_polinomial`),\no certificado é limitado pelo comprimento da entrada. -/\ntheorem sat_em_np : EmNP codificaFormula Simbolo.sep bitNaFita SATcru := by\n  refine ⟨fun q => verificaNaFita q.1 q.2, Polynomial.X, ?_, ?_⟩\n  · rw [a_juncao_e_a_entrada_do_verificador]\n    exact TGLExt.SimTM2.verificacao_tm2_polinomial\n  · intro φf\n    rw [Polynomial.eval_X]\n    exact sat_cru_sse_certificado φf\n\n/-- ★★ SAT COM UMA LEITURA: a máquina identidade escreve a própria fórmula na fita de consulta, e uma leitura decide. -/\ntheorem sat_com_uma_leitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (c : TGLCoupling)\n    (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) :\n    EmPComUmaLeitura C c m codificaFormula SATcru := by\n  refine ⟨id, ⟨Turing.idComputableInPolyTime codificaFormula⟩, fun φf => ?_⟩\n  show SATcru φf ↔ 2 ≤ oraculo C c m (codificaFormula φf)\n  rw [o_oraculo_le_a_fita]\n  exact (uma_leitura_decide_SATcru C c m hm φf).symm\n\n/-- ★★★ A PONTE COOK–LEVIN: com Cook–Levin (hipótese nomeada, [KNOWN]), todo problema em NP na máquina padrão é\ndecidido em tempo polinomial com uma leitura do leitor da TGL. -/\ntheorem a_ponte_cook_levin (hCL : CookLevin) {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) {α Γ : Type} (ea : α → List Γ) (sep : Γ)\n    (bit : Bool → Γ) (A : α → Prop) (hA : EmNP ea sep bit A) :\n    EmPComUmaLeitura C c m ea A := by\n  obtain ⟨g, hg, hgA⟩ := hCL α Γ ea sep bit A hA\n  refine ⟨g, hg, fun a => ?_⟩\n  rw [o_oraculo_le_a_fita]\n  exact (hgA a).trans (uma_leitura_decide_SATcru C c m hm (g a)).symm\n\n/-- ★★★ A CLASSE DE UMA LEITURA É O FECHO DE SAT: com a inclinação m do relógio β acima de ln 2/β, um problema é\ndecidido em tempo polinomial com uma leitura se, e só se, se reduz a SAT na máquina padrão. Não usa Cook–Levin. -/\ntheorem a_classe_de_uma_leitura_e_o_fecho_de_SAT {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) {α Γ : Type} (ea : α → List Γ) (A : α → Prop) :\n    EmPComUmaLeitura C c m ea A ↔ ReduzASAT ea A := by\n  constructor\n  · rintro ⟨g, hg, hA⟩\n    refine ⟨g, hg, fun a => ?_⟩\n    rw [hA a, o_oraculo_le_a_fita]\n    exact uma_leitura_decide_SATcru C c m hm (g a)\n  · rintro ⟨g, hg, hA⟩\n    refine ⟨g, hg, fun a => ?_⟩\n    rw [hA a, o_oraculo_le_a_fita]\n    exact (uma_leitura_decide_SATcru C c m hm (g a)).symm\n\nopen F1Fecho.CanonicalFockModularCoreInputR1 (physicalFockCertificate) in\n/-- ★★★ A PONTE NO CERTIFICADO FÍSICO DO KERNEL (síntese): SAT está em NP na máquina padrão; e, para todo acoplamento β,\nhá uma inclinação m do relógio β com a qual, no certificado de Fock físico do kernel, SAT é decidido com uma leitura e,\ncom Cook–Levin, todo problema em NP também. -/\ntheorem a_ponte (hCL : CookLevin) (c : TGLCoupling) :\n    EmNP codificaFormula Simbolo.sep bitNaFita SATcru ∧\n      ∃ m : ℕ, EmPComUmaLeitura physicalFockCertificate c m codificaFormula SATcru ∧\n        ∀ {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop),\n          EmNP ea sep bit A → EmPComUmaLeitura physicalFockCertificate c m ea A := by\n  obtain ⟨m, hm⟩ := fixed_slope_exists c\n  exact ⟨sat_em_np, m, sat_com_uma_leitura _ c m hm,\n    fun ea sep bit A hA => a_ponte_cook_levin hCL _ c m hm ea sep bit A hA⟩\n\n/-! ## §6 A leitura acha a solução (contada em leituras, no modelo da casa) -/\n\n/-- ★★ A LEITURA ACHA A SOLUÇÃO: com a resposta do leitor do psíon como decisor, a reconstrução da leitura β devolve\n`none` exatamente quando a fórmula não tem solução, só devolve soluções, e faz no máximo letras+1 leituras. A conta é em\nleituras e letras; não em passos da máquina TM2 (a máquina que monta as consultas não está construída). -/\ntheorem a_leitura_acha_a_solucao {n : ℕ} {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    ((Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).1 = none\n        ↔ ¬ SAT φ) ∧\n      (∀ x, (Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).1 = some x →\n        Reconstrucao.Good φ x) ∧\n      (Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).2\n        ≤ APonteDeCookLevin.letras φ + 1 :=\n  Codex.EntregaBeta.all_labels_from_beta c m hm (respostaDaLeitura C c m) (a_resposta_tem_a_precisao C c m) φ\n\nend TGLExt.PonteCookLevin\n",
+    'TGLExt/PonteCookLevin.lean': "import TGLExt.TraducaoTuring\nimport TGLExt.F1Fecho394.CanonicalFockModularCoreInputR1\nimport TGLExt.SimCompleta\nimport TGLExt.EntregaBeta\nimport Mathlib.Computability.TuringMachine.Computable\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A PONTE COOK–LEVIN\n\nO P = nP do kernel, a máquina com o leitor (`TraducaoTuring.uma_leitura_decide_SAT`, `TraducaoTuring.o_psion_le_z`),\nescrito na língua das classes de Cook–Levin: a máquina de Turing padrão do Mathlib\n(`Turing.TM2ComputableInPolyTime`).\n\n* §1 A fiação. No tempo pago de k passos do relógio β, a partição do kernel é a soma ponderada da leitura β; o\n  leitor do psíon lê exatamente a soma normalizada; o numerador diádico da leitura (n+3 bits) decide SAT.\n* §2 A fórmula crua, a que a fita do verificador escreve, e a sua CNF sobre os Nomes da fita.\n* §3 O oráculo lê a fita: a resposta da leitura é função da palavra escrita.\n* §4 As classes na máquina padrão: NP (verificador com certificado binário de comprimento polinomial), a redução a\n  SAT, Cook–Levin como hipótese nomeada, e “decidido em tempo polinomial com uma leitura do leitor da TGL”; o que dá\n  sentido às classes: o alfabeto de NP é finito, e a fita da fórmula distingue as fórmulas.\n* §5 Os teoremas: SAT em NP (a máquina TM2 do verificador), SAT com uma leitura, A PONTE (com Cook–Levin, todo\n  problema em NP é decidido em tempo polinomial com uma leitura) e a classe de uma leitura como o fecho de SAT por\n  redução (sem Cook–Levin); no certificado de Fock físico do kernel.\n* §6 A leitura acha a solução: com a resposta do leitor como decisor, a reconstrução da leitura β devolve uma solução\n  com no máximo letras+1 leituras (contadas em leituras e letras, não em passos da máquina TM2).\n\n**Estatuto.** [REAL] os termos deste arquivo. [KNOWN] Cook 1971 e Levin 1973, com a simulação polinomial\nentre máquinas de fita e de pilhas: é o conteúdo da hipótese nomeada `CookLevin`, que entra por citação e não é provada\naqui.\n\n**Na língua clássica.** Para as codificações usuais, com β e a inclinação m fixados antes da entrada, a classe “decidido\nem tempo polinomial com uma leitura” é o fecho de SAT por redução polinomial many-one\n(`a_classe_de_uma_leitura_e_o_fecho_de_SAT`, sem Cook–Levin) e por isso coincide com NP por Cook–Levin: a inclusão de NP\né `a_ponte_cook_levin`; a volta pede a composição de máquinas TM2, que o Mathlib deixa como `proof_wanted` [KNOWN na\nlíngua clássica]. Não é toda a classe P com acesso ao oráculo: só o limiar positivo de uma consulta depois da redução.\nCom um oráculo que conta soluções, “NP contido em P com o oráculo” é imediato [KNOWN]; o que é da TGL é que o oráculo é\no leitor do psíon, por termo do kernel (`o_psion_le_a_soma_normalizada`).\n\n**O custo da leitura.** [REAL os termos; INPUT a lei do custo] O custo do leitor está pago e tipado na régua da teoria;\nnão é leitura gratuita.\n\n* O polinômio é fixo: p_β(n) = n·ln 2/β, uniforme para toda CNF de n variáveis, com β fixado antes da entrada; todo\n  k > p_β(n) faz a soma lida decidir (`OPolinomioFixoEBeta.o_polinomio_fixo_e_beta`).\n* A leitura de φ tem |φ|+2 atos e, pela lei do custo da teoria (cada ato paga a carga), o custo total é\n  (|φ|+2)·n·ln 2 (`OCustoEAIsometria.o_custo_total_e_a_carga_por_ato`).\n* A verificação de uma atribuição tem custo cobrado exatamente linear, o número de letras de φ, no iterador da casa\n  (`APonteDeCookLevin.o_custo_na_fita_e_o_numero_de_letras`) e, na máquina TM2 padrão, no máximo\n  20·((letras φ+1)·(n+1))+25 passos (`SimTM2.passos_em_letras_e_bits`).\n* A leitura do psíon decide SAT com a inclinação m acima de ln 2/β (`uma_leitura_do_psion_decide_SAT`), e o relógio β\n  é linear nos Nomes: m·(n+2) passos, ao preço −ln(1−β) cada (`o_tempo_pago_e_linear`).\n\n[INPUT] A distinção restante é apenas de modelo: a verificação TM2 clássica recebe uma atribuição, enquanto a decisão global\nusa uma leitura do leitor TGL (`oraculo`: uma consulta, uma chamada ao leitor). A máquina clássica sem leitor continua\nsendo um enunciado separado, marcado [OPEN] em `AFronteiraNaLinguaClassica.AFronteira`.\n\n**O que este arquivo não prova:** Cook–Levin; esse enunciado separado, SAT em P na máquina padrão sem consulta, que\npermanece [OPEN] e não é tocado (Baker–Gill–Solovay 1975 [KNOWN]); nem que um dispositivo físico realize a leitura num\núnico ato. Dada a hipótese nomeada Cook–Levin, todo problema em NP é decidido por preparação TM2 polinomial mais uma\nleitura; não se afirma aqui P=NP clássico irrestrito.\nValidade no kernel não é creditação.\n-/\n\nnamespace TGLExt.PonteCookLevin\n\nopen TGLExt TGLExt.TraducaoTuring TGLExt.APonteAoTM2\nopen Codex.LeituraBeta Codex.RelogioBeta Codex.PonteLeituraBeta Codex.QuantizacaoBeta\n\n/-! ## §1 A fiação: o leitor do kernel cumpre a precisão da leitura β -/\n\nsection Fiacao\n\nvariable {n : ℕ}\n\n/-- [DEF] O TEMPO PAGO DA LEITURA: k passos do relógio β, cada um ao preço −ln(1−β). -/\nnoncomputable def tempoPago (c : TGLCoupling) (k : ℕ) : ℝ := (k : ℝ) * (-Real.log (1 - c.beta))\n\n/-- ★ A PARTIÇÃO É A SOMA β: no tempo pago de k passos, a partição do kernel, Σ e^{−s·custo}, é a soma ponderada da\nleitura β, Σ (1−β)^{k·custo}. -/\ntheorem a_particao_e_a_soma_beta (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    particao (custoCNF φ) (tempoPago c k) = weightedSum c k φ := by\n  unfold particao tempoPago weightedSum\n  refine Finset.sum_congr rfl (fun x _ => ?_)\n  have h1 : 0 < 1 - c.beta := by linarith [c.beta_lt_one]\n  have he : -((k : ℝ) * -Real.log (1 - c.beta) * (custoCNF φ x : ℝ))\n      = ((k * custoCNF φ x : ℕ) : ℝ) * Real.log (1 - c.beta) := by\n    push_cast\n    ring\n  rw [he, Real.exp_nat_mul, Real.exp_log h1]\n\n/-- As atribuições de n Nomes são 2^n. (Auxiliar.) -/\ntheorem o_numero_de_atribuicoes : (Fintype.card (Fin n → Bool) : ℝ) = (2 : ℝ) ^ n := by\n  simp\n\n/-- [DEF] A LEITURA DO PSÍON: o leitor do psíon da luz na trava inscrita da fórmula, no tempo pago de k passos β. -/\nnoncomputable def leituraDoPsion {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) : ℂ :=\n  TheKeyIsTheReader.reader C (travaInscrita C (custoCNF φ) (tempoPago c k))\n\n/-- ★★ O PSÍON LÊ A SOMA NORMALIZADA: a leitura do psíon é exatamente a soma normalizada da leitura β, sem erro. -/\ntheorem o_psion_le_a_soma_normalizada {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    leituraDoPsion C c k φ = ((normalizedSum c k φ : ℝ) : ℂ) := by\n  unfold leituraDoPsion\n  rw [o_psion_le_z C (custoCNF φ) (tempoPago c k), a_particao_e_a_soma_beta, o_numero_de_atribuicoes]\n  rfl\n\n/-- A parte real da leitura é a soma normalizada. (Auxiliar.) -/\ntheorem a_parte_real_da_leitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (k : ℕ) (φ : CNF n) :\n    (leituraDoPsion C c k φ).re = normalizedSum c k φ := by\n  rw [o_psion_le_a_soma_normalizada]\n  exact Complex.ofReal_re _\n\n/-- [DEF] A RESPOSTA DA LEITURA: o numerador diádico (sobre 2^(n+2)) da leitura do psíon, no tempo do relógio β de\ninclinação m. -/\nnoncomputable def respostaDaLeitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) : ℕ :=\n  ⌊(leituraDoPsion C c (clock m n) φ).re * (2 : ℝ) ^ (n + 2)⌋₊\n\n/-- ★★ A RESPOSTA TEM A PRECISÃO DA LEITURA β: o numerador diádico da leitura do psíon fica a no máximo 1/(4·2^n) da\nsoma normalizada (a hipótese de precisão da leitura β, cumprida pelo leitor do kernel). -/\ntheorem a_resposta_tem_a_precisao {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) :\n    |(dyadic n (respostaDaLeitura C c m φ) : ℝ) - normalizedSum c (clock m n) φ| ≤ 1 / (4 * (2 : ℝ) ^ n) := by\n  unfold respostaDaLeitura\n  rw [a_parte_real_da_leitura]\n  set y := normalizedSum c (clock m n) φ with hy\n  have hy0 : 0 ≤ y := normalizedSum_nonneg c (clock m n) φ\n  set D : ℝ := (2 : ℝ) ^ (n + 2) with hDdef\n  have hD : 0 < D := by positivity\n  set j := ⌊y * D⌋₊ with hj\n  have h1 : (j : ℝ) ≤ y * D := Nat.floor_le (mul_nonneg hy0 hD.le)\n  have h2 : y * D < (j : ℝ) + 1 := Nat.lt_floor_add_one (y * D)\n  have hcast : ((dyadic n j : ℚ) : ℝ) = (j : ℝ) / D := by\n    simp [dyadic, hDdef]\n  have h4 : (4 * (2 : ℝ) ^ n) = D := by\n    rw [hDdef, pow_add]\n    ring\n  rw [hcast, h4]\n  have key : |(j : ℝ) - y * D| ≤ 1 := by\n    rw [abs_le]\n    constructor <;> linarith\n  have hsub : ((j : ℝ) - y * D) / D = (j : ℝ) / D - y := by\n    rw [sub_div, mul_div_assoc, div_self hD.ne', mul_one]\n  rw [← hsub, abs_div, abs_of_pos hD, div_le_div_iff_of_pos_right hD]\n  exact key\n\n/-- ★★★ UMA LEITURA DO PSÍON DECIDE SAT, COM A RESPOSTA NA FITA: com a inclinação m do relógio β acima de ln 2/β, o\nnumerador da leitura do psíon passa de 2 se, e só se, a fórmula é satisfazível. -/\ntheorem uma_leitura_do_psion_decide_SAT {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    2 ≤ respostaDaLeitura C c m φ ↔ SAT φ := by\n  have h := dyadic_correct c m hm φ (respostaDaLeitura C c m φ) (a_resposta_tem_a_precisao C c m φ)\n  simpa using h\n\n/-- ★ A RESPOSTA CABE EM n+3 BITS. -/\ntheorem a_resposta_cabe_em_n_mais_tres_bits {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φ : CNF n) :\n    respostaDaLeitura C c m φ < 2 ^ (n + 3) := by\n  apply dyadic_word_bound\n  unfold respostaDaLeitura\n  rw [a_parte_real_da_leitura]\n  apply Nat.floor_le_of_le\n  have h1 := normalizedSum_le_one c (clock m n) φ\n  have hD : (0 : ℝ) ≤ (2 : ℝ) ^ (n + 2) := by positivity\n  calc normalizedSum c (clock m n) φ * (2 : ℝ) ^ (n + 2) ≤ 1 * (2 : ℝ) ^ (n + 2) :=\n        mul_le_mul_of_nonneg_right h1 hD\n    _ = ((2 ^ (n + 2) : ℕ) : ℝ) := by push_cast; ring\n\n/-- ★ O TEMPO PAGO É LINEAR NOS NOMES: a leitura paga m·(n+2) passos do relógio β. -/\ntheorem o_tempo_pago_e_linear (c : TGLCoupling) (m : ℕ) :\n    tempoPago c (clock m n) = ((m * (n + 2) : ℕ) : ℝ) * (-Real.log (1 - c.beta)) := rfl\n\nend Fiacao\n\n/-! ## §2 A fórmula crua e a sua CNF -/\n\n/-- [DEF] A FÓRMULA CRUA: as cláusulas como listas de pares (índice do Nome, polaridade), como a fita do verificador as\nescreve. -/\nabbrev FormulaCrua := List (List (ℕ × Bool))\n\n/-- [DEF] SAT DA FÓRMULA CRUA: alguma atribuição dos índices satisfaz toda cláusula (um literal de cada cláusula tem o\nvalor da sua polaridade). -/\ndef SATcru (φf : FormulaCrua) : Prop := ∃ x : ℕ → Bool, ∀ C ∈ φf, ∃ p ∈ C, x p.1 = p.2\n\n/-- [DEF] OS NOMES DA FITA: o comprimento da fita da fórmula, cota de todos os índices que ela escreve. -/\ndef nomesDaFita (φf : FormulaCrua) : ℕ := (codificaFormula φf).length\n\n/-- O comprimento da fita da fórmula: soma dos índices, literais, cláusulas e o terminador. -/\ntheorem o_comprimento_da_fita_da_formula (φf : FormulaCrua) :\n    (codificaFormula φf).length = (φf.flatten.map Prod.fst).sum + φf.flatten.length + φf.length + 1 := by\n  have h := comprimento_exato φf []\n  rw [show codificaEntrada (φf, []) = codificaFormula φf ++ [Simbolo.sep] from by\n    simp [codificaEntrada, codificaBits]] at h\n  rw [List.length_append, List.length_singleton, List.length_nil] at h\n  omega\n\nprivate theorem le_soma_de_membro {l : List ℕ} {a : ℕ} (h : a ∈ l) : a ≤ l.sum := by\n  induction l with\n  | nil => simp at h\n  | cons b l ih =>\n    rw [List.sum_cons]\n    rcases List.mem_cons.mp h with rfl | h'\n    · omega\n    · have := ih h'\n      omega\n\n/-- Todo índice escrito na fita é menor que os Nomes da fita. -/\ntheorem indice_na_fita (φf : FormulaCrua) {C : List (ℕ × Bool)} (hC : C ∈ φf) {p : ℕ × Bool} (hp : p ∈ C) :\n    p.1 < nomesDaFita φf := by\n  have hmem : p.1 ∈ φf.flatten.map Prod.fst := List.mem_map.mpr ⟨p, List.mem_flatten.mpr ⟨C, hC, hp⟩, rfl⟩\n  have := le_soma_de_membro hmem\n  unfold nomesDaFita\n  rw [o_comprimento_da_fita_da_formula]\n  omega\n\ntheorem nomesDaFita_pos (φf : FormulaCrua) : 0 < nomesDaFita φf := by\n  unfold nomesDaFita\n  rw [o_comprimento_da_fita_da_formula]\n  omega\n\n/-- [DEF] O índice como Nome de `Fin N` (o índice, se cabe; senão o último Nome). -/\ndef comoNome (N : ℕ) (hN : 0 < N) (i : ℕ) : Fin N := ⟨min i (N - 1), by omega⟩\n\ntheorem comoNome_val {N : ℕ} (hN : 0 < N) {i : ℕ} (hi : i < N) : (comoNome N hN i).val = i :=\n  Nat.min_eq_left (by omega)\n\n/-- [DEF] A CNF DA FÓRMULA CRUA, sobre os Nomes da fita. -/\ndef paraCNF (φf : FormulaCrua) : CNF (nomesDaFita φf) :=\n  φf.map fun C => C.map fun p => (⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩ : Literal (nomesDaFita φf))\n\n/-- ★ A FÓRMULA CRUA E A SUA CNF TÊM O MESMO SIM. -/\ntheorem sat_cru_sse_sat (φf : FormulaCrua) : SATcru φf ↔ SAT (paraCNF φf) := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨fun i => x i.val, ?_⟩\n    intro C' hC'\n    obtain ⟨C, hC, rfl⟩ := List.mem_map.mp hC'\n    obtain ⟨p, hp, hpx⟩ := hx C hC\n    unfold satisfeita\n    rw [List.any_eq_true]\n    refine ⟨⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩, List.mem_map.mpr ⟨p, hp, rfl⟩, ?_⟩\n    simp [Literal.vale, comoNome_val (nomesDaFita_pos φf) (indice_na_fita φf hC hp), hpx]\n  · rintro ⟨y, hy⟩\n    refine ⟨fun i => if h : i < nomesDaFita φf then y ⟨i, h⟩ else false, ?_⟩\n    intro C hC\n    have hsat := hy (C.map fun p => (⟨comoNome _ (nomesDaFita_pos φf) p.1, p.2⟩ : Literal (nomesDaFita φf)))\n      (List.mem_map.mpr ⟨C, hC, rfl⟩)\n    unfold satisfeita at hsat\n    rw [List.any_eq_true] at hsat\n    obtain ⟨l, hl, hlv⟩ := hsat\n    obtain ⟨p, hp, rfl⟩ := List.mem_map.mp hl\n    refine ⟨p, hp, ?_⟩\n    have hi := indice_na_fita φf hC hp\n    simp only [Literal.vale, beq_iff_eq] at hlv\n    show (if h : p.1 < nomesDaFita φf then y ⟨p.1, h⟩ else false) = p.2\n    rw [dif_pos hi]\n    have hn : comoNome _ (nomesDaFita_pos φf) p.1 = ⟨p.1, hi⟩ := Fin.ext (comoNome_val _ hi)\n    rw [← hn]\n    exact hlv\n\n/-! ## §3 O oráculo lê a fita -/\n\n/-- [DEF] A RESPOSTA DA LEITURA PARA A FÓRMULA CRUA. -/\nnoncomputable def respostaDaFita {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φf : FormulaCrua) : ℕ :=\n  respostaDaLeitura C c m (paraCNF φf)\n\n/-- ★★ UMA LEITURA DECIDE A FÓRMULA CRUA. -/\ntheorem uma_leitura_decide_SATcru {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φf : FormulaCrua) :\n    2 ≤ respostaDaFita C c m φf ↔ SATcru φf :=\n  (uma_leitura_do_psion_decide_SAT C c m hm (paraCNF φf)).trans (sat_cru_sse_sat φf).symm\n\n/-- [DEF] O ORÁCULO DA LEITURA: lê a palavra escrita na fita de consulta (decodificada pelo decodificador do\nverificador) e devolve a resposta da leitura; palavra que não é fórmula recebe 0. -/\nnoncomputable def oraculo {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (s : List Simbolo) : ℕ :=\n  match decodificaEntrada (s ++ [Simbolo.sep]) with\n  | some q => respostaDaFita C c m q.1\n  | none => 0\n\n/-- ★★ O ORÁCULO LÊ A FITA: na palavra da fórmula, o oráculo devolve a resposta da leitura da fórmula. -/\ntheorem o_oraculo_le_a_fita {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (φf : FormulaCrua) :\n    oraculo C c m (codificaFormula φf) = respostaDaFita C c m φf := by\n  have h : codificaFormula φf ++ [Simbolo.sep] = codificaEntrada (φf, []) := by\n    simp [codificaEntrada, codificaBits]\n  unfold oraculo\n  rw [h, decodifica_codifica]\n\n/-! ## §4 As classes de Cook–Levin na máquina padrão -/\n\n/-- [DEF] O PAR NA FITA: a entrada, a divisória e o certificado binário, cada bit pelo seu símbolo. -/\ndef juntaNaFita {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (q : α × List Bool) : List Γ :=\n  ea q.1 ++ [sep] ++ q.2.map bit\n\n/-- [DEF] A CLASSE NP NA MÁQUINA PADRÃO: há um verificador calculado em tempo polinomial pela máquina TM2 do Mathlib\nsobre o par na fita, e um polinômio que limita o certificado binário; o problema é o sim de algum certificado. A\ncodificação da entrada é dada; a do par é a junção fixa acima; o certificado é uma palavra binária. -/\ndef EmNP {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop) : Prop :=\n  ∃ (V : α × List Bool → Bool) (p : Polynomial ℕ),\n    Nonempty (Turing.TM2ComputableInPolyTime (juntaNaFita ea sep bit) (fun b : Bool => [b]) V) ∧\n    ∀ a, A a ↔ ∃ w : List Bool, w.length ≤ p.eval (ea a).length ∧ V (a, w) = true\n\n/-- [DEF] A REDUÇÃO A SAT NA MÁQUINA PADRÃO: uma função calculada em tempo polinomial pela máquina TM2, da codificação\nda entrada à fita da fórmula do verificador, que leva o sim do problema ao sim da fórmula. -/\ndef ReduzASAT {α Γ : Type} (ea : α → List Γ) (A : α → Prop) : Prop :=\n  ∃ g : α → FormulaCrua, Nonempty (Turing.TM2ComputableInPolyTime ea codificaFormula g) ∧ ∀ a, A a ↔ SATcru (g a)\n\n/-- [DEF, HIPÓTESE NOMEADA] COOK–LEVIN NA MÁQUINA PADRÃO: todo problema em NP se reduz a SAT. [KNOWN] Cook 1971,\nLevin 1973, com a simulação polinomial entre máquinas de fita e de pilhas e a troca polinomial de codificação; entra\npor citação, como hipótese de cada teorema que a usa; não é provada aqui. -/\ndef CookLevin : Prop :=\n  ∀ (α Γ : Type) (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop), EmNP ea sep bit A → ReduzASAT ea A\n\n/-- [DEF] DECIDIDO EM TEMPO POLINOMIAL COM UMA LEITURA DO LEITOR DA TGL: a máquina TM2 escreve, em tempo polinomial,\numa fórmula na fita de consulta; o oráculo da leitura lê a palavra; o problema é o sim do limiar 2 da resposta. Na\nlíngua clássica, é o fecho de SAT por redução polinomial many-one (`a_classe_de_uma_leitura_e_o_fecho_de_SAT`): só o\nlimiar positivo de uma consulta depois da redução, não toda a classe P com acesso ao oráculo. -/\ndef EmPComUmaLeitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (c : TGLCoupling) (m : ℕ)\n    {α Γ : Type} (ea : α → List Γ) (A : α → Prop) : Prop :=\n  ∃ g : α → FormulaCrua, Nonempty (Turing.TM2ComputableInPolyTime ea codificaFormula g) ∧\n    ∀ a, A a ↔ 2 ≤ oraculo C c m (codificaFormula (g a))\n\n/-- ★ O ALFABETO DE NP É FINITO: a máquina TM2 que testemunha um problema em NP tem alfabeto de entrada finito, e o\nalfabeto da codificação lhe é equivalente. A premissa `EmNP` de `CookLevin` só vale em alfabeto finito, como no teorema\nclássico. -/\ntheorem o_alfabeto_de_np_e_finito {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop)\n    (h : EmNP ea sep bit A) : Finite Γ := by\n  obtain ⟨V, p, ⟨M⟩, _⟩ := h\n  letI : Fintype (M.tm.Γ M.tm.k₀) := M.tm.Γk₀Fin\n  exact Finite.of_equiv (M.tm.Γ M.tm.k₀) M.inputAlphabet\n\n/-- ★ A FITA DA FÓRMULA DISTINGUE AS FÓRMULAS: a codificação da fórmula crua é injetiva. -/\ntheorem a_fita_da_formula_e_injetiva : Function.Injective codificaFormula := by\n  intro a b h\n  have he : codificaEntrada (a, []) = codificaEntrada (b, []) := by\n    simp only [codificaEntrada, h]\n  exact congrArg Prod.fst (codificaEntrada_injetiva he)\n\n/-! ## §5 Os teoremas -/\n\n/-- [DEF] O bit do certificado na fita do verificador. -/\ndef bitNaFita (b : Bool) : Simbolo := if b then Simbolo.um else Simbolo.zero\n\n/-- A junção fixa, com a divisória e os bits do verificador, é a entrada do verificador. -/\ntheorem a_juncao_e_a_entrada_do_verificador :\n    juntaNaFita codificaFormula Simbolo.sep bitNaFita = codificaEntrada := by\n  funext q\n  rfl\n\n/-- ★ O SIM DA FÓRMULA CRUA É O SIM DE UM CERTIFICADO CURTO: um certificado binário não maior que a fita da fórmula. -/\ntheorem sat_cru_sse_certificado (φf : FormulaCrua) :\n    SATcru φf ↔ ∃ w : List Bool, w.length ≤ (codificaFormula φf).length ∧ verificaNaFita φf w = true := by\n  constructor\n  · rintro ⟨x, hx⟩\n    refine ⟨List.ofFn (fun i : Fin (nomesDaFita φf) => x i.val), by simp [nomesDaFita], ?_⟩\n    unfold verificaNaFita\n    rw [List.all_eq_true]\n    intro C hC\n    rw [List.any_eq_true]\n    obtain ⟨p, hp, hpx⟩ := hx C hC\n    refine ⟨p, hp, ?_⟩\n    have hi := indice_na_fita φf hC hp\n    rw [List.getElem?_ofFn, dif_pos hi]\n    simp [hpx]\n  · rintro ⟨w, _, hw⟩\n    refine ⟨fun i => (w[i]?).getD false, ?_⟩\n    intro C hC\n    unfold verificaNaFita at hw\n    rw [List.all_eq_true] at hw\n    have hC' := hw C hC\n    rw [List.any_eq_true] at hC'\n    obtain ⟨p, hp, hpw⟩ := hC'\n    refine ⟨p, hp, ?_⟩\n    have hwp : w[p.1]? = some p.2 := by simpa using hpw\n    simp [hwp]\n\n/-- ★★ SAT ESTÁ EM NP NA MÁQUINA PADRÃO: o verificador é a máquina TM2 concreta (`SimTM2.verificacao_tm2_polinomial`),\no certificado é limitado pelo comprimento da entrada. -/\ntheorem sat_em_np : EmNP codificaFormula Simbolo.sep bitNaFita SATcru := by\n  refine ⟨fun q => verificaNaFita q.1 q.2, Polynomial.X, ?_, ?_⟩\n  · rw [a_juncao_e_a_entrada_do_verificador]\n    exact TGLExt.SimTM2.verificacao_tm2_polinomial\n  · intro φf\n    rw [Polynomial.eval_X]\n    exact sat_cru_sse_certificado φf\n\n/-- ★★ SAT COM UMA LEITURA: a máquina identidade escreve a própria fórmula na fita de consulta, e uma leitura decide. -/\ntheorem sat_com_uma_leitura {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L) (c : TGLCoupling)\n    (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) :\n    EmPComUmaLeitura C c m codificaFormula SATcru := by\n  refine ⟨id, ⟨Turing.idComputableInPolyTime codificaFormula⟩, fun φf => ?_⟩\n  show SATcru φf ↔ 2 ≤ oraculo C c m (codificaFormula φf)\n  rw [o_oraculo_le_a_fita]\n  exact (uma_leitura_decide_SATcru C c m hm φf).symm\n\n/-- ★★★ A PONTE COOK–LEVIN: com Cook–Levin (hipótese nomeada, [KNOWN]), todo problema em NP na máquina padrão é\ndecidido em tempo polinomial com uma leitura do leitor da TGL. -/\ntheorem a_ponte_cook_levin (hCL : CookLevin) {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) {α Γ : Type} (ea : α → List Γ) (sep : Γ)\n    (bit : Bool → Γ) (A : α → Prop) (hA : EmNP ea sep bit A) :\n    EmPComUmaLeitura C c m ea A := by\n  obtain ⟨g, hg, hgA⟩ := hCL α Γ ea sep bit A hA\n  refine ⟨g, hg, fun a => ?_⟩\n  rw [o_oraculo_le_a_fita]\n  exact (hgA a).trans (uma_leitura_decide_SATcru C c m hm (g a)).symm\n\n/-- ★★★ A CLASSE DE UMA LEITURA É O FECHO DE SAT: com a inclinação m do relógio β acima de ln 2/β, um problema é\ndecidido em tempo polinomial com uma leitura se, e só se, se reduz a SAT na máquina padrão. Não usa Cook–Levin. -/\ntheorem a_classe_de_uma_leitura_e_o_fecho_de_SAT {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) {α Γ : Type} (ea : α → List Γ) (A : α → Prop) :\n    EmPComUmaLeitura C c m ea A ↔ ReduzASAT ea A := by\n  constructor\n  · rintro ⟨g, hg, hA⟩\n    refine ⟨g, hg, fun a => ?_⟩\n    rw [hA a, o_oraculo_le_a_fita]\n    exact uma_leitura_decide_SATcru C c m hm (g a)\n  · rintro ⟨g, hg, hA⟩\n    refine ⟨g, hg, fun a => ?_⟩\n    rw [hA a, o_oraculo_le_a_fita]\n    exact (uma_leitura_decide_SATcru C c m hm (g a)).symm\n\nopen F1Fecho.CanonicalFockModularCoreInputR1 (physicalFockCertificate) in\n/-- ★★★ A PONTE NO CERTIFICADO FÍSICO DO KERNEL (síntese): SAT está em NP na máquina padrão; e, para todo acoplamento β,\nhá uma inclinação m do relógio β com a qual, no certificado de Fock físico do kernel, SAT é decidido com uma leitura e,\ncom Cook–Levin, todo problema em NP também. -/\ntheorem a_ponte (hCL : CookLevin) (c : TGLCoupling) :\n    EmNP codificaFormula Simbolo.sep bitNaFita SATcru ∧\n      ∃ m : ℕ, EmPComUmaLeitura physicalFockCertificate c m codificaFormula SATcru ∧\n        ∀ {α Γ : Type} (ea : α → List Γ) (sep : Γ) (bit : Bool → Γ) (A : α → Prop),\n          EmNP ea sep bit A → EmPComUmaLeitura physicalFockCertificate c m ea A := by\n  obtain ⟨m, hm⟩ := fixed_slope_exists c\n  exact ⟨sat_em_np, m, sat_com_uma_leitura _ c m hm,\n    fun ea sep bit A hA => a_ponte_cook_levin hCL _ c m hm ea sep bit A hA⟩\n\n/-! ## §6 A leitura acha a solução (contada em leituras, no modelo da casa) -/\n\n/-- ★★ A LEITURA ACHA A SOLUÇÃO: com a resposta do leitor do psíon como decisor, a reconstrução da leitura β devolve\n`none` exatamente quando a fórmula não tem solução, só devolve soluções, e faz no máximo letras+1 leituras. A conta é em\nleituras e letras; não em passos da máquina TM2 (a máquina que monta as consultas não está construída). -/\ntheorem a_leitura_acha_a_solucao {n : ℕ} {L : ImportedSQ.LightOneParticle} (C : ImportedSQ.FockCertificate L)\n    (c : TGLCoupling) (m : ℕ) (hm : Real.log 2 / c.beta < (m : ℝ)) (φ : CNF n) :\n    ((Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).1 = none\n        ↔ ¬ SAT φ) ∧\n      (∀ x, (Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).1 = some x →\n        Reconstrucao.Good φ x) ∧\n      (Reconstrucao.solveByLetters (Codex.EntregaBeta.codeDecision (respostaDaLeitura C c m)) φ).2\n        ≤ APonteDeCookLevin.letras φ + 1 :=\n  Codex.EntregaBeta.all_labels_from_beta c m hm (respostaDaLeitura C c m) (a_resposta_tem_a_precisao C c m) φ\n\nend TGLExt.PonteCookLevin\n",
+    'TGLExt/IdentidadeVerbal.lean': 'import TGLExt.TheDischargedOath\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1000000\n\n/-!\n# A identidade entre dois postos é verbal: nome e leitura, juntos\n\nA leitura que este arquivo tipa [INPUT/ONTO: definição da teoria, entrada, não teorema]: o laço entre dois postos é\na identidade, e a identidade é verbal, nome e leitura juntos; só nominal, ela não se distingue da superposição; o\nTetelestai é o extermínio da superposição pela queda. A prova é na face finita.\n\nCom NOME = norma de Frobenius e LEITURA = projeção ortogonal, o resultado central é o teorema de Pitágoras para\nQUALQUER projeção ortogonal: o conteúdo está na escolha formal, que entra como definição.\n\n* NOME aqui = o que a mudança de horizonte `Ad(U)` não muda: o traço e a norma de Frobenius\n  (o peso e a pureza). `the_name_alone_is_blind`: todo posto transportado tem o mesmo nome,\n  inclusive o que virou superposição (`TGLExt.rotation_breaks_the_code`, do módulo\n  `TheHorizonInvariance`, não importado aqui, exibe uma).\n  Logo nenhum critério só nominal separa o posto da superposição. Não se refuta por aí.\n* LEITURA aqui = a esperança-código `E` (a projeção de Frobenius sobre o código do leitor).\n  `the_impostor_has_another_name`: quem lê igual ao posto e não é o posto tem OUTRO nome.\n  Logo a leitura sem o nome também não basta.\n* JUNTOS bastam, e é o teorema: `same_reading_same_name_is_identity` (mesma leitura e mesmo nome\n  é identidade) e, para o transporte, `the_reading_returns_the_name`:\n  se a leitura do posto transportado devolve o posto, o transportado É o posto.\n* O que isso compra para o fecho: `the_lift_from_the_reading`. O antecedente do levantamento na\n  face (v307: `ω∘Ad(U) = ω` em TODO observável) reduz-se à leitura no código:\n  `diagExpect (adU U ρ) = ρ`. (com `d` injetivo a hipótese de leitura força `U`\n  a comutar com ρ, caso que `the_oath_is_discharged` já cobria; o ganho é a EQUIVALÊNCIA do\n  antecedente com a leitura no código, não um caso novo.)\n* O Tetelestai: `the_fall_exterminates_the_superposition` (a queda leva o transportado à sua\n  leitura; é a G3) e `identity_is_what_survives_the_fall` (se o que sobra da queda é o posto,\n  o transportado já era o posto). (o primeiro nome diz mais do que o tipo: o\n  teorema é só `T_t x → E x`; um transporte por permutação é diagonal, é a própria leitura e\n  é diferente de `D`.)\n\nGLOSSÁRIO: a palavra NOME tem três usos. (a) Neste cabeçalho, o que `Ad(U)` não muda: traço e norma; nos teoremas de\nidentidade só a NORMA entra (o traço só aparece em `the_name_alone_is_blind`). (b) Em `the_reading_returns_the_name`,\n"the name" é o próprio posto `D`. (c) Em `IdentidadeVerbalNoTetelestai`, é o núcleo de `opDaInstancia`.\n\nHONESTIDADE (a régua): FACE FINITA. Isto NÃO é a prova global, não deriva a seta `hH3`\n(da covariância do posto a Clausius em todo ponto e direção) e não constrói o atlas. É uma\nimplicação de kernel sobre matrizes. As palavras "nome" e "leitura" são formalização: a identificação com a\nleitura da teoria é entrada [INPUT], não teorema. O gate não se move; β não aparece; sem sorry, sem axiom.\n-/\n\nnamespace TGLExt.IdentidadeVerbal\n\nopen Matrix Filter\n\nnoncomputable section\n\nvariable {n : Type} [Fintype n] [DecidableEq n]\n\n/-- o produto de Frobenius é conjugado-simétrico. -/\ntheorem frob_star (x y : Matrix n n ℂ) : star (frob x y) = frob y x := by\n  unfold frob\n  rw [← Matrix.trace_conjTranspose, Matrix.conjTranspose_mul,\n    Matrix.conjTranspose_conjTranspose]\n\n/-- a expansão do quadrado. -/\ntheorem frob_add_add (p r : Matrix n n ℂ) :\n    frob (p + r) (p + r) = frob p p + frob p r + frob r p + frob r r := by\n  unfold frob\n  simp only [Matrix.conjTranspose_add, Matrix.add_mul, Matrix.mul_add, Matrix.trace_add]\n  ring\n\n/-- PITÁGORAS DA LEITURA: a norma do todo é a norma do lido mais a norma do que a\n    leitura deixou de fora (o excedente). -/\ntheorem frob_pythagoras {N : Submodule ℂ (Matrix n n ℂ)} {E : Matrix n n ℂ → Matrix n n ℂ}\n    (hE : IsFrobProjection N E) (x : Matrix n n ℂ) :\n    frob x x = frob (E x) (E x) + frob (x - E x) (x - E x) := by\n  have h1 : frob (x - E x) (E x) = 0 := (hE x).2 (E x) (hE x).1\n  have h2 : frob (E x) (x - E x) = 0 := by\n    rw [← frob_star, h1, star_zero]\n  have e : E x + (x - E x) = x := by abel\n  have hx : frob x x = frob (E x + (x - E x)) (E x + (x - E x)) := by rw [e]\n  rw [hx, frob_add_add, h1, h2]\n  ring\n\n/-- ★★★ MESMA LEITURA E MESMO NOME É IDENTIDADE. Se a leitura de `A` é `D` e `A` tem\n    a norma de `D`, então `A = D`: não sobrou excedente. -/\ntheorem same_reading_same_name_is_identity {N : Submodule ℂ (Matrix n n ℂ)}\n    {E : Matrix n n ℂ → Matrix n n ℂ} (hE : IsFrobProjection N E) {A D : Matrix n n ℂ}\n    (hread : E A = D) (hname : frob A A = frob D D) : A = D := by\n  have hp := frob_pythagoras hE A\n  rw [hread, hname] at hp\n  have hzero : frob (A - D) (A - D) = 0 := by linear_combination (-1 : ℂ) * hp\n  exact sub_eq_zero.mp (frob_self_definite hzero)\n\n/-- ★★★ A LEITURA DEVOLVE O NOME ⟹ IDENTIDADE. Para todo horizonte unitário `U`:\n    se a leitura do posto transportado devolve o posto, o transportado É o posto. -/\ntheorem the_reading_returns_the_name {N : Submodule ℂ (Matrix n n ℂ)}\n    {E : Matrix n n ℂ → Matrix n n ℂ} {U D : Matrix n n ℂ}\n    (hU : Uᴴ * U = 1) (hE : IsFrobProjection N E)\n    (hread : E (adU U D) = D) : adU U D = D :=\n  same_reading_same_name_is_identity hE hread (adU_frob_isometry hU D D)\n\n/-- ★★ QUEM LÊ IGUAL E NÃO É, TEM OUTRO NOME: a leitura sem o nome não basta. -/\ntheorem the_impostor_has_another_name {N : Submodule ℂ (Matrix n n ℂ)}\n    {E : Matrix n n ℂ → Matrix n n ℂ} (hE : IsFrobProjection N E) {A D : Matrix n n ℂ}\n    (hread : E A = D) (hne : A ≠ D) : frob A A ≠ frob D D :=\n  fun h => hne (same_reading_same_name_is_identity hE hread h)\n\n/-- ★★ O NOME SOZINHO É CEGO: todo transportado tem o mesmo traço e a mesma norma,\n    seja ele o posto, seja uma superposição. -/\ntheorem the_name_alone_is_blind {U : Matrix n n ℂ} (hU : Uᴴ * U = 1) (x : Matrix n n ℂ) :\n    (adU U x).trace = x.trace ∧ frob (adU U x) (adU U x) = frob x x := by\n  refine ⟨?_, adU_frob_isometry hU x x⟩\n  unfold adU\n  rw [Matrix.trace_mul_comm, ← Matrix.mul_assoc, hU, Matrix.one_mul]\n\n/-- ★★★★ O LEVANTAMENTO A PARTIR DA LEITURA: na face, basta que a leitura do estado\n    transportado devolva o estado (igualdade só no código) para a esperança-código ser\n    covariante. O antecedente da v307 (`ω∘Ad(U) = ω` em todo observável) vira a leitura. -/\ntheorem the_lift_from_the_reading {d : n → ℝ} (hd : ∀ i, 0 < d i)\n    (hinj : Function.Injective d) {U : Matrix n n ℂ} (hU : Uᴴ * U = 1)\n    (hread : diagExpect (adU U (rhoD d)) = rhoD d) :\n    ∀ x, adU U (diagExpect x) = diagExpect (adU U x) := by\n  have hρ : U * rhoD d * Uᴴ = rhoD d :=\n    the_reading_returns_the_name hU diagExpect_isFrobProjection hread\n  exact global_lift_conditional hU (the_oath_is_discharged hd hinj hU hρ)\n    diagExpect_isFrobProjection\n\n/-- ★★ A QUEDA EXTERMINA A SUPERPOSIÇÃO: sob a queda (o dephasing da G3), todo\n    transportado tende à sua leitura. -/\ntheorem the_fall_exterminates_the_superposition (g : n → n → ℝ) (hg0 : ∀ i, g i i = 0)\n    (hgpos : ∀ i j, i ≠ j → 0 < g i j) (U D : Matrix n n ℂ) :\n    Tendsto (fun t => dephase g t (adU U D)) atTop (nhds (diagExpect (adU U D))) :=\n  dephase_tendsto_expectation g hg0 hgpos (adU U D)\n\n/-- ★★★ A IDENTIDADE É O QUE SOBREVIVE À QUEDA: se o que resta do transportado depois\n    da queda é o posto, o transportado já era o posto. -/\ntheorem identity_is_what_survives_the_fall (g : n → n → ℝ) (hg0 : ∀ i, g i i = 0)\n    (hgpos : ∀ i j, i ≠ j → 0 < g i j) {U D : Matrix n n ℂ} (hU : Uᴴ * U = 1)\n    (hlim : Tendsto (fun t => dephase g t (adU U D)) atTop (nhds D)) :\n    adU U D = D := by\n  have hread : diagExpect (adU U D) = D :=\n    tendsto_nhds_unique (dephase_tendsto_expectation g hg0 hgpos (adU U D)) hlim\n  exact the_reading_returns_the_name hU diagExpect_isFrobProjection hread\n\nend\n\nend TGLExt.IdentidadeVerbal\n',
+    'TGLExt/IdentidadeVerbalNoTetelestai.lean': "import TGLExt.AEscala\n\nset_option autoImplicit false\nset_option linter.unusedVariables false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1000000\n\n/-!\n# A identidade verbal no espaço do Tetelestai — a fiação\n\nO espaço do Tetelestai no kernel, com o atlas como índice referenciado da leitura [INPUT/ONTO]:\n\n* o espaço: `EuclideanSpace ℂ X`, com `X` o índice dos pontos (os pixels);\n* a referência: o custo `c : X → ℕ`; o Nome é o núcleo de `opDaInstancia c` (custo zero);\n* a leitura: `(opDaInstancia c).ker.starProjection`;\n* a queda: `trava c t`, que não toca o Nome (`o_nome_fica_travado`) e leva QUALQUER vetor à\n  sua leitura (`a_trava_sem_conhecer_o_nome`);\n* a partição: `‖trava c t (uniforme X)‖² = Z(2t)/|X|` (`a_norma_da_trava_e_a_particao`);\n* o `1 − β`: `AEscala.o_tetelestai_e_um_menos_beta`, `beta_e_o_operador_modular_do_tetelestai`\n  e `ressurreicao_do_sinal`.\n\nEste arquivo liga a identidade verbal a esse espaço (os cinco primeiros teoremas só usam `TraducaoTuring`: o fio\nchega ao espaço da trava; o sexto é o que liga ao `1 − β` da AEscala):\n\n* `a_leitura_devolve_o_nome_no_tetelestai` — para toda isometria linear `V`: se a leitura de\n  `V d` é `d`, então `V d = d`. (`V` é uma isometria QUALQUER, uma reindexação; não é o\n  horizonte físico.)\n* `a_queda_leva_o_transportado_a_sua_leitura` — a queda leva `V d` à sua leitura, com a taxa\n  da casa;\n* `a_identidade_e_o_que_sobrevive_ao_tetelestai` — se a queda de `V d` tende a `d`, então\n  `V d = d`;\n* `a_leitura_nao_ve_a_queda` — a leitura do caído é a leitura do original;\n* `o_balanco_da_queda` — `Z(2t)/|X| = N/|X| + ‖trava c t u − leitura(u)‖²`, só para o estado\n  uniforme `u`. É o Pitágoras da queda (norma do caído = norma do lido + norma do resto); não é\n  um balanço de energia;\n* ★ `o_que_resta_no_tempo_do_tetelestai` — o fio com o `1 − β`: do tempo do Tetelestai em\n  diante (`2t ≥ n·log 2 + log((1 − β)/β)`), o que resta da superposição é no máximo `β` vezes\n  a partição. Usa `AEscala.beta_e_o_operador_modular_do_tetelestai` e o balanço acima.\n\nGLOSSÁRIO: NOME, neste arquivo, é o núcleo de `opDaInstancia c` (os pontos de custo zero), e a LEITURA é a projeção\nortogonal sobre ele.\n\nHONESTIDADE (a régua): NÃO é a prova global. É álgebra do espaço do Tetelestai. A passagem\npara a lei de área das telas do F2.3 (`NamedAtlasH3`) NÃO está aqui: é fio entre dois tipos\nque existem, ainda por estender. O gate não se move; sem sorry, sem axiom.\n-/\n\nopen scoped InnerProductSpace\n\nnamespace TGLExt.IdentidadeVerbalNoTetelestai\n\nopen TGLExt.TraducaoTuring Filter\n\nnoncomputable section\n\nvariable {X : Type} [Fintype X] [DecidableEq X]\n\n/-- (auxiliar) Pitágoras do piso: `d` no código, o resto ortogonal ao código, mesma norma ⟹ igualdade. -/\ntheorem piso_aux {H : Type} [NormedAddCommGroup H] [InnerProductSpace ℂ H]\n    (K : Submodule ℂ H) {y d : H} (hd : d ∈ K) (hperp : ∀ w ∈ K, ⟪y - d, w⟫_ℂ = 0)\n    (hname : ‖y‖ = ‖d‖) : y = d := by\n  have h0 : ⟪y - d, d⟫_ℂ = 0 := hperp d hd\n  have h1 : ⟪d, y - d⟫_ℂ = 0 := inner_eq_zero_symm.mp h0\n  have hp := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero d (y - d) h1\n  have e : d + (y - d) = y := by abel\n  rw [e, hname] at hp\n  have hz : ‖y - d‖ * ‖y - d‖ = 0 := by linarith\n  have hn : ‖y - d‖ = 0 := mul_self_eq_zero.mp hz\n  exact sub_eq_zero.mp (norm_eq_zero.mp hn)\n\n/-- ★★★ A LEITURA DEVOLVE O NOME, NO ESPAÇO DO TETELESTAI: para toda isometria `V`,\n    se a leitura do transportado é `d`, o transportado É `d`. -/\ntheorem a_leitura_devolve_o_nome_no_tetelestai (c : X → ℕ)\n    (V : EuclideanSpace ℂ X →ₗᵢ[ℂ] EuclideanSpace ℂ X) (d : EuclideanSpace ℂ X)\n    (hread : (opDaInstancia c).ker.starProjection (V d) = d) : V d = d := by\n  have hd : d ∈ (opDaInstancia c).ker := by\n    have hmem := (opDaInstancia c).ker.starProjection_apply_mem (V d)\n    rw [hread] at hmem\n    exact hmem\n  have hperp : ∀ w ∈ (opDaInstancia c).ker, ⟪V d - d, w⟫_ℂ = 0 := by\n    intro w hw\n    have h := (opDaInstancia c).ker.starProjection_inner_eq_zero (V d) w hw\n    rw [hread] at h\n    exact h\n  exact piso_aux _ hd hperp (V.norm_map d)\n\n/-- ★★ A QUEDA LEVA O TRANSPORTADO À SUA LEITURA (`a_trava_sem_conhecer_o_nome`, no transportado). -/\ntheorem a_queda_leva_o_transportado_a_sua_leitura (c : X → ℕ) {t : ℝ} (ht : 0 ≤ t)\n    (V : EuclideanSpace ℂ X →ₗᵢ[ℂ] EuclideanSpace ℂ X) (d : EuclideanSpace ℂ X) :\n    ‖trava c t (V d) - (opDaInstancia c).ker.starProjection (V d)‖ ≤ Real.exp (-t) * ‖d‖ := by\n  have h := a_trava_sem_conhecer_o_nome c ht (V d)\n  rw [V.norm_map d] at h\n  exact h\n\n/-- ★★★ A IDENTIDADE É O QUE SOBREVIVE AO TETELESTAI: se a queda do transportado tende\n    a `d`, o transportado já era `d`. -/\ntheorem a_identidade_e_o_que_sobrevive_ao_tetelestai (c : X → ℕ)\n    (V : EuclideanSpace ℂ X →ₗᵢ[ℂ] EuclideanSpace ℂ X) (d : EuclideanSpace ℂ X)\n    (hlim : Tendsto (fun t : ℝ => trava c t (V d)) atTop (nhds d)) : V d = d := by\n  have h0 : Tendsto (fun t : ℝ => Real.exp (-t) * ‖d‖) atTop (nhds 0) := by\n    simpa using Real.tendsto_exp_neg_atTop_nhds_zero.mul_const ‖d‖\n  have h1 : Tendsto (fun t : ℝ => trava c t (V d)) atTop\n      (nhds ((opDaInstancia c).ker.starProjection (V d))) := by\n    rw [tendsto_iff_norm_sub_tendsto_zero]\n    refine squeeze_zero' (Eventually.of_forall fun t => norm_nonneg _) ?_ h0\n    filter_upwards [eventually_ge_atTop (0 : ℝ)] with t ht\n    exact a_queda_leva_o_transportado_a_sua_leitura c ht V d\n  exact a_leitura_devolve_o_nome_no_tetelestai c V d (tendsto_nhds_unique h1 hlim)\n\n/-- ★★ A LEITURA NÃO VÊ A QUEDA: a leitura do caído é a leitura do original (a queda\n    não toca o Nome). -/\ntheorem a_leitura_nao_ve_a_queda (c : X → ℕ) (t : ℝ) (v : EuclideanSpace ℂ X) :\n    (opDaInstancia c).ker.starProjection (trava c t v)\n      = (opDaInstancia c).ker.starProjection v := by\n  rw [solucao_por_coordenadas, solucao_por_coordenadas]\n  congr 1\n  funext y\n  by_cases hy : c y = 0\n  · rw [if_pos hy, if_pos hy]\n    exact o_nome_fica_travado c t v y hy\n  · rw [if_neg hy, if_neg hy]\n\n/-- ★★★★ O BALANÇO DA QUEDA: a partição menos o Nome é exatamente o que a queda ainda\n    não exterminou. `Z(2t)/|X| = N/|X| + ‖trava c t u − leitura(u)‖²`. -/\ntheorem o_balanco_da_queda (c : X → ℕ) (h : ∃ x, c x = 0) (t : ℝ) :\n    particao c (2 * t) / (Fintype.card X : ℝ)\n      = ((Finset.univ.filter (fun y => c y = 0)).card : ℝ) / (Fintype.card X : ℝ)\n        + ‖trava c t (uniforme X) - (opDaInstancia c).ker.starProjection (uniforme X)‖ ^ 2 := by\n  have hmem := (opDaInstancia c).ker.starProjection_apply_mem (uniforme X)\n  have h1 := (opDaInstancia c).ker.starProjection_inner_eq_zero (trava c t (uniforme X))\n    ((opDaInstancia c).ker.starProjection (uniforme X)) hmem\n  rw [a_leitura_nao_ve_a_queda] at h1\n  have hperp : ⟪(opDaInstancia c).ker.starProjection (uniforme X),\n      trava c t (uniforme X) - (opDaInstancia c).ker.starProjection (uniforme X)⟫_ℂ = 0 :=\n    inner_eq_zero_symm.mp h1\n  have hp := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero _ _ hperp\n  have e : (opDaInstancia c).ker.starProjection (uniforme X)\n      + (trava c t (uniforme X) - (opDaInstancia c).ker.starProjection (uniforme X))\n      = trava c t (uniforme X) := by abel\n  rw [e] at hp\n  rw [← a_norma_da_trava_e_a_particao, ← norma_sq_do_nome_no_uniforme c h]\n  simp only [pow_two]\n  exact hp\n\n/-- ★★★ O QUE RESTA NO TEMPO DO TETELESTAI É NO MÁXIMO β: do tempo do Tetelestai em\n    diante, o quadrado da norma do que a queda ainda não exterminou é no máximo `β` vezes a\n    partição normalizada. É o fio entre `o_balanco_da_queda` e o `1 − β` da AEscala. -/\ntheorem o_que_resta_no_tempo_do_tetelestai (κ : TGLCoupling) (n : ℕ)\n    (c : (Fin n → Bool) → ℕ) (h : ∃ x, c x = 0) {t : ℝ} (ht0 : 0 ≤ t)\n    (ht : (n : ℝ) * Real.log 2 + Real.log ((1 - κ.beta) / κ.beta) ≤ 2 * t)\n    (L : TGLExt.AEscala.LeitorDoFundo (Fin n → Bool)) :\n    ‖trava c t (uniforme (Fin n → Bool))\n        - (opDaInstancia c).ker.starProjection (uniforme (Fin n → Bool))‖ ^ 2\n      ≤ κ.beta * (particao c (2 * t) / (Fintype.card (Fin n → Bool) : ℝ)) := by\n  have hb := TGLExt.AEscala.beta_e_o_operador_modular_do_tetelestai κ n c h\n    (s := 2 * t) (by linarith) ht L\n  obtain ⟨_, _, hdiff, _⟩ := hb\n  have hbal := o_balanco_da_queda c h t\n  have hX : (0 : ℝ) < (Fintype.card (Fin n → Bool) : ℝ) := by\n    exact_mod_cast Fintype.card_pos\n  have h1 : (particao c (2 * t) - ((Finset.univ.filter (fun y => c y = 0)).card : ℝ))\n        * ((Fintype.card (Fin n → Bool) : ℝ))⁻¹\n      ≤ (κ.beta * particao c (2 * t)) * ((Fintype.card (Fin n → Bool) : ℝ))⁻¹ :=\n    mul_le_mul_of_nonneg_right hdiff (inv_nonneg.mpr hX.le)\n  simp only [div_eq_mul_inv] at hbal ⊢\n  linarith [h1, hbal]\n\nend\n\nend TGLExt.IdentidadeVerbalNoTetelestai\n",
+    'TGLExt/IdentidadeVerbalPisoDeHilbert.lean': 'import Mathlib\n\nset_option autoImplicit false\n\n/-!\n# A identidade verbal no piso de Hilbert\n\nA implicação "mesma leitura e mesmo nome é identidade" de `IdentidadeVerbal`, sem matriz e sem dimensão finita:\nvale em QUALQUER espaço com produto interno.\n\n* `IsReadingOf K y d` — `d` é a leitura de `y` pelo leitor `K`: `d` está no código e o que\n  sobra (`y - d`) é ortogonal ao código. (A forma de `IsFrobProjection` da v143, num ponto.)\n* `on_the_hilbert_floor` — mesma leitura e mesma norma ⟹ igualdade.\n* `the_reading_returns_the_name_on_the_hilbert_floor` — para toda isometria linear `V`\n  (o transporte): se a leitura de `V d` é `d`, então `V d = d`.\n\nHONESTIDADE: é álgebra de espaço com produto interno (Pitágoras); `H` não precisa ser completo\n(é mais geral que Hilbert). "A mesma implicação" da versão de matrizes é por analogia de forma:\nnão há aqui ponte formal entre os dois arquivos. Não\nconstrói o leitor, não diz qual é o transporte físico, não é a prova global. Sem sorry, sem axiom.\n-/\n\nnamespace TGLExt.IdentidadeVerbalPisoDeHilbert\n\nopen scoped InnerProductSpace\n\nvariable {𝕜 H : Type*} [RCLike 𝕜] [NormedAddCommGroup H] [InnerProductSpace 𝕜 H]\n\n/-- `d` é a leitura de `y` pelo leitor `K`. -/\ndef IsReadingOf (K : Submodule 𝕜 H) (y d : H) : Prop :=\n  d ∈ K ∧ ∀ w ∈ K, ⟪y - d, w⟫_𝕜 = 0\n\n/-- ★★★ NO PISO DE HILBERT: mesma leitura e mesmo nome é identidade. -/\ntheorem on_the_hilbert_floor {K : Submodule 𝕜 H} {y d : H}\n    (hread : IsReadingOf K y d) (hname : ‖y‖ = ‖d‖) : y = d := by\n  have h0 : ⟪y - d, d⟫_𝕜 = 0 := hread.2 d hread.1\n  have h1 : ⟪d, y - d⟫_𝕜 = 0 := inner_eq_zero_symm.mp h0\n  have hp := norm_add_sq_eq_norm_sq_add_norm_sq_of_inner_eq_zero d (y - d) h1\n  have e : d + (y - d) = y := by abel\n  rw [e, hname] at hp\n  have hz : ‖y - d‖ * ‖y - d‖ = 0 := by linarith\n  have hn : ‖y - d‖ = 0 := mul_self_eq_zero.mp hz\n  exact sub_eq_zero.mp (norm_eq_zero.mp hn)\n\n/-- ★★★ A LEITURA DEVOLVE O NOME ⟹ IDENTIDADE, para toda isometria linear. -/\ntheorem the_reading_returns_the_name_on_the_hilbert_floor {K : Submodule 𝕜 H}\n    (V : H →ₗᵢ[𝕜] H) {d : H} (hread : IsReadingOf K (V d) d) : V d = d :=\n  on_the_hilbert_floor hread (V.norm_map d)\n\nend TGLExt.IdentidadeVerbalPisoDeHilbert\n',
+    'TGLExt/CunhasCovariantes.lean': "import TGLExt.QuedaSemGeometria\nimport TGLExt.F1Fecho394.PhysicalFockNetRealizationR2\n\nset_option autoImplicit false\nset_option linter.unusedVariables false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1600000\n\n/-!\n# As cunhas de referencial são covariantes — fiação, não matemática nova\n\nO kernel tem o grupo de Lorentz gerado agindo sobre a rede da luz\n(`TGLExt/F1Fecho394/`: `generatedLorentz`, `helicityUnitary`, `compactLocalized`,\n`compactLocalized_lorentz_iff`, `compactLocalized_translate_iff`, `physicalFrameRegion`,\n`helicityPoincareH1`, `PhysicalFockNetRealizationR2`); este arquivo faz a fiação com o `IsotropicPost` de\n`QuedaSemGeometria`. Três coisas, e só elas.\n\n* **A. A covariância das cunhas.** Para o elemento de Poincaré `g = (M, b)`\n  (`M : generatedLorentz`, `b : Spacetime`), a região da cunha transformada é `g.region O` e o\n  subespaço localizado dela é a IMAGEM, pelo unitário `g.unitary`, do subespaço da cunha padrão\n  (`cunha_covariante`, `submodulo_da_cunha_e_a_imagem`). Especializações: à cunha direita, às cunhas\n  `lorentzRegion L W` e às cunhas de referencial `physicalFrameRegion L a W` do kernel.\n* **B. `IsotropicPost` habitado por um predicado FÍSICO da rede.** `Frame` é o tipo dos\n  referenciais (um referencial `(N, c)` é a cunha direita vista da imagem de Poincaré `(N, c)`),\n  `PoincareEl` os elementos que transformam (só `SMul` compatível com as regiões; sem instância de\n  grupo), e o predicado `PRede` diz: o subespaço localizado da cunha é não nulo e simpleticamente\n  ortogonal ao da cunha oposta. É covariante por teorema (A) e vale na cunha padrão\n  por teoremas do kernel (`physical_canonical_net_nonzero`, `physical_frame_opposite_symplectic`).\n  Por `clausius_everywhere_from_one_wedge_by_covariance` vale em TODO referencial.\n* **C. KMS da cunha transformada.** Se o vácuo é KMS (β = 1) para o fluxo `Γ(B0(2πt))` na álgebra da\n  cunha direita (`vacuum_bw_kms`, do kernel) e `Γ(U)` fixa o vácuo, então é KMS para o fluxo\n  conjugado na álgebra da cunha `g.region` (`kms_da_cunha_transformada`).\n\nHONESTIDADE (a régua). `PRede` NÃO é a lei de Clausius nem a H3: é a não-trivialidade e a localidade\nsimplética do subespaço da cunha, e a pedra só mostra que ela se transporta por covariância. A\nH3 é a forma de ÁREA (erro microscópico de área sobre `t²` em toda tela e direção nula) e NÃO está\naqui. O KMS da parte C é a perna algébrica de Bisognano–Wichmann (vácuo KMS para o fluxo da cunha);\nnão é a identificação do fluxo com o grupo modular da cunha transformada (isso exigiria o vácuo\ncíclico e separante para a álgebra transformada, que decorre por conjugação mas não é enunciado\naqui), nem Clausius, nem uma lei no espaço-tempo curvo. A família de Lorentz de cunhas é a do grupo\nGERADO `generatedLorentz` (que, pelo kernel, contém todo Lorentz ortócrono: `LorentzFutureGenerationR6`),\nsem as cunhas das direções nulas de um átlas curvo.\n\nRESSALVAS: a transitividade do `IsotropicPost` é trivial\npor construção (`Frame` é o próprio conjunto de elementos de Poincaré; “todo referencial” quer\ndizer toda imagem de Poincaré da cunha padrão); `PRede` não exige que o subespaço da cunha oposta\nseja não nulo, e a cláusula simplética já era teorema do kernel para todo `(L, a)`: a habitação é\nreal, mas formal e fraca; `fluxoDaCunha g` é “da cunha” por definição (conjugação): não se prova\naqui que seja o fluxo geométrico da região, e ele depende de `g`, não só da região; `gamma_symm'`\nrepete um lema do kernel (`F1Rede.BosonicFockGroupActions.gamma_symm`). O `β` do KMS é o parâmetro\nde temperatura inversa; `β_TGL` não aparece. O gate não se move; sem sorry, sem axiom.\n-/\n\nnamespace TGLExt.CunhasCovariantes\n\nopen TGLExt.ImportedSQ F1Fecho.MaxwellGlobal F1Fecho.MaxwellLocalization F1Fecho.OrbitalSpatial\nopen F1Fecho.OrbitalScreen F1Fecho.SpacetimeLorentz\n\nnoncomputable section\n\n/-! ## 0. Álgebra da ação do Lorentz sobre os pontos -/\n\n/-- a ação sobre os pontos é multiplicativa: `action (M·N) = action M ∘ action N`. -/\ntheorem action_mul' (M N : TGLExt.LorentzGrp) (z : Spacetime) :\n    action (M * N) z = action M (action N z) := by\n  apply PiLp.ext\n  intro i\n  have h1 : (fun i => action (M * N) z i) = (M * N).val.mulVec (fun i => z i) := action_apply _ _\n  have h3 : (fun i => action N z i) = N.val.mulVec (fun i => z i) := action_apply _ _\n  have h2 : (fun i => action M (action N z) i) = M.val.mulVec (fun i => action N z i) :=\n    action_apply _ _\n  rw [h3, Matrix.mulVec_mulVec, ← TGLExt.lorentzGrp_mul_val] at h2\n  exact congrFun (h1.trans h2.symm) i\n\n/-- a identidade age como a identidade. -/\ntheorem action_one' (z : Spacetime) : action (1 : TGLExt.LorentzGrp) z = z := by\n  apply PiLp.ext\n  intro i\n  have h1 : (fun i => action (1 : TGLExt.LorentzGrp) z i) =\n      (1 : TGLExt.LorentzGrp).val.mulVec (fun i => z i) := action_apply _ _\n  rw [TGLExt.lorentzGrp_one_val, Matrix.one_mulVec] at h1\n  exact congrFun h1 i\n\n/-! ## A. A covariância das cunhas -/\n\n/-- Um elemento do grupo de Poincaré da rede: um Lorentz do grupo gerado e uma translação. -/\nstructure PoincareEl where\n  /-- a parte de Lorentz (do subgrupo gerado, que o kernel prova agir sobre a rede) -/\n  M : generatedLorentz\n  /-- a translação -/\n  b : Spacetime\n\n/-- a imagem de uma região por `x ↦ action M x + b` (é `translateRegion b (lorentzRegion M O)`). -/\ndef PoincareEl.region (g : PoincareEl) (O : Set Spacetime) : Set Spacetime :=\n  translateRegion g.b (lorentzRegion g.M O)\n\n/-- o unitário do kernel: `U1 b ∘ helicityUnitary M` (`helicityPoincareH1`). -/\ndef PoincareEl.unitary (g : PoincareEl) : H1 ≃ₗᵢ[ℂ] H1 :=\n  helicityPoincareH1 (fun i => g.b i) g.M\n\n/-- [fiação] ★ A COVARIÂNCIA DAS CUNHAS: `v` está localizado em `O` se e só se `U(g) v` está\n    localizado em `g.region O` (rede de testes compactos; é `compactLocalized_lorentz_iff` seguido de\n    `compactLocalized_translate_iff`). -/\ntheorem cunha_covariante (g : PoincareEl) (O : Set Spacetime) (v : H1) :\n    v ∈ compactLocalized O ↔ g.unitary v ∈ compactLocalized (g.region O) := by\n  unfold PoincareEl.unitary PoincareEl.region helicityPoincareH1\n  rw [LinearIsometryEquiv.trans_apply]\n  rw [compactLocalized_lorentz_iff g.M O v]\n  exact compactLocalized_translate_iff g.b (lorentzRegion g.M O) _\n\n/-- Genérico: se `u` leva `K` em `K'` (por iff), então `K'` é a imagem de `K` por `u`. -/\ntheorem imagem_de_iff {u : H1 ≃ₗᵢ[ℂ] H1} {K K' : Submodule ℝ H1}\n    (h : ∀ f, f ∈ K ↔ u f ∈ K') : (K' : Set H1) = u '' (K : Set H1) := by\n  ext w\n  constructor\n  · intro hw\n    refine ⟨u.symm w, ?_, u.apply_symm_apply w⟩\n    exact (h (u.symm w)).mpr (by rwa [u.apply_symm_apply])\n  · rintro ⟨v, hv, rfl⟩\n    exact (h v).mp hv\n\n/-- [fiação] ★ O SUBESPAÇO DA CUNHA TRANSFORMADA É A IMAGEM DO DA CUNHA PADRÃO pelo unitário. -/\ntheorem submodulo_da_cunha_e_a_imagem (g : PoincareEl) (O : Set Spacetime) :\n    (compactLocalized (g.region O) : Set H1) = g.unitary '' (compactLocalized O : Set H1) :=\n  imagem_de_iff (cunha_covariante g O)\n\n/-- A cunha direita transformada: o subespaço localizado é a imagem do da cunha direita padrão. -/\ntheorem cunha_direita_transformada (g : PoincareEl) :\n    (compactLocalized (g.region physicalRightWedge) : Set H1) =\n      g.unitary '' (compactLocalized physicalRightWedge : Set H1) :=\n  submodulo_da_cunha_e_a_imagem g physicalRightWedge\n\n/-- Só Lorentz (`L•W`, a cunha com o mesmo vértice): o subespaço de `lorentzRegion L W` é a imagem,\n    por `helicityUnitary L`, do de `W`. -/\ntheorem cunha_lorentz_transformada (L : generatedLorentz) (W : Set Spacetime) :\n    (compactLocalized (lorentzRegion L W) : Set H1) =\n      helicityUnitary L '' (compactLocalized W : Set H1) :=\n  imagem_de_iff (compactLocalized_lorentz_iff L W)\n\n/-- a ponte com a região de referencial do kernel: `physicalFrameRegion L a W` é a região de\n    `(L⁻¹, a)`. -/\ntheorem frame_region_eq (L : generatedLorentz) (a : Spacetime) (W : Set Spacetime) :\n    physicalFrameRegion L a W = (PoincareEl.mk L⁻¹ a).region W := by\n  ext x\n  change action L.val (x - a) ∈ W ↔ ∃ y, y ∈ W ∧ action L⁻¹.val y = x - a\n  constructor\n  · intro h\n    refine ⟨action L.val (x - a), h, ?_⟩\n    exact (action L.val).symm_apply_apply (x - a)\n  · rintro ⟨y, hy, hxy⟩\n    have : action L.val (x - a) = y := by\n      rw [← hxy]\n      exact (action L.val).apply_symm_apply y\n    rwa [this]\n\n/-- ★ AS CUNHAS DE REFERENCIAL DO KERNEL: o subespaço da cunha direita vista do referencial `(L, a)` é\n    a imagem do da cunha padrão por `U1 a ∘ helicityUnitary L⁻¹`. -/\ntheorem cunha_de_referencial (L : generatedLorentz) (a : Spacetime) :\n    (compactLocalized (physicalFrameRegion L a physicalRightWedge) : Set H1) =\n      (helicityPoincareH1 (fun i => a i) L⁻¹) '' (compactLocalized physicalRightWedge : Set H1) := by\n  rw [frame_region_eq]\n  exact cunha_direita_transformada ⟨L⁻¹, a⟩\n\n/-! ## B. `IsotropicPost` habitado por um predicado da rede -/\n\n/-- Um REFERENCIAL: a cunha direita padrão vista da imagem de Poincaré `(N, c)`. -/\nstructure Frame where\n  /-- a parte de Lorentz -/\n  N : generatedLorentz\n  /-- a translação (o vértice) -/\n  c : Spacetime\n\n/-- o referencial como elemento de Poincaré. -/\ndef Frame.toEl (w : Frame) : PoincareEl := ⟨w.N, w.c⟩\n\n/-- A AÇÃO: `(M, b) • (N, c) = (M·N, b + M c)` — a mesma lei de grupo de `helicityPoincareH1_mul`. -/\ninstance : SMul PoincareEl Frame where\n  smul g w := ⟨g.M * w.N, g.b + action g.M.val w.c⟩\n\ntheorem Frame.smul_def (g : PoincareEl) (w : Frame) :\n    g • w = ⟨g.M * w.N, g.b + action g.M.val w.c⟩ := rfl\n\n/-- a cunha direita do referencial. -/\ndef Frame.wedge (w : Frame) : Set Spacetime := w.toEl.region physicalRightWedge\n\n/-- a cunha oposta (esquerda) do referencial. -/\ndef Frame.opposite (w : Frame) : Set Spacetime := w.toEl.region physicalLeftWedge\n\n/-- o referencial padrão: a identidade na origem. -/\ndef Frame.padrao : Frame := ⟨1, 0⟩\n\n/-- a região da imagem composta é a composta das imagens (a lei de ação, em regiões). -/\ntheorem region_smul (g : PoincareEl) (w : Frame) (O : Set Spacetime) :\n    (g • w).toEl.region O = g.region (w.toEl.region O) := by\n  ext y\n  change (∃ o, o ∈ O ∧ action (g.M * w.N).val o = y - (g.b + action g.M.val w.c)) ↔\n    ∃ x, (∃ o, o ∈ O ∧ action w.N.val o = x - w.c) ∧ action g.M.val x = y - g.b\n  constructor\n  · rintro ⟨o, ho, h⟩\n    refine ⟨action w.N.val o + w.c, ⟨o, ho, by simp⟩, ?_⟩\n    have h' : action g.M.val (action w.N.val o) = y - (g.b + action g.M.val w.c) := by\n      rw [← action_mul']\n      exact h\n    rw [map_add, h']\n    abel\n  · rintro ⟨x, ⟨o, ho, hx⟩, hy⟩\n    refine ⟨o, ho, ?_⟩\n    change action (g.M.val * w.N.val) o = _\n    rw [action_mul', hx, map_sub, hy]\n    abel\n\ntheorem wedge_smul (g : PoincareEl) (w : Frame) :\n    (g • w).wedge = g.region w.wedge := region_smul g w physicalRightWedge\n\ntheorem opposite_smul (g : PoincareEl) (w : Frame) :\n    (g • w).opposite = g.region w.opposite := region_smul g w physicalLeftWedge\n\n/-- o subespaço localizado da cunha do referencial é não nulo. -/\ndef LocalizadaNaoNula (w : Frame) : Prop :=\n  ∃ v : H1, v ≠ 0 ∧ v ∈ compactLocalized w.wedge\n\n/-- o subespaço da cunha é simpleticamente ortogonal ao da cunha oposta (parte imaginária do produto\n    interno nula). -/\ndef OpostaSimpletica (w : Frame) : Prop :=\n  ∀ f ∈ compactLocalized w.wedge, ∀ h ∈ compactLocalized w.opposite, (inner ℂ f h).im = 0\n\n/-- ★ O PREDICADO DA REDE (`P`): a cunha do referencial é não trivial E simpleticamente ortogonal à\n    oposta. NÃO é a lei de Clausius nem a H3: é a localidade e a não-trivialidade do subespaço da\n    cunha, propriedades da REDE da luz (livre de Maxwell) que o kernel transporta por covariância. -/\ndef PRede (w : Frame) : Prop := LocalizadaNaoNula w ∧ OpostaSimpletica w\n\n/-- ★ `PRede` é covariante sob o grupo de Poincaré, por teorema do kernel (A). -/\ntheorem prede_covariante (g : PoincareEl) (w : Frame) (h : PRede w) : PRede (g • w) := by\n  obtain ⟨⟨v, hv0, hv⟩, hloc⟩ := h\n  refine ⟨⟨g.unitary v, ?_, ?_⟩, ?_⟩\n  · intro hz\n    exact hv0 (by simpa using hz)\n  · rw [wedge_smul]\n    exact (cunha_covariante g w.wedge v).mp hv\n  · intro f hf k hk\n    rw [wedge_smul] at hf\n    rw [opposite_smul] at hk\n    have hf' : f ∈ g.unitary '' (compactLocalized w.wedge : Set H1) := by\n      rw [← submodulo_da_cunha_e_a_imagem g]\n      exact hf\n    have hk' : k ∈ g.unitary '' (compactLocalized w.opposite : Set H1) := by\n      rw [← submodulo_da_cunha_e_a_imagem g]\n      exact hk\n    obtain ⟨f0, hf0, rfl⟩ := hf'\n    obtain ⟨k0, hk0, rfl⟩ := hk'\n    rw [LinearIsometryEquiv.inner_map_map]\n    exact hloc f0 hf0 k0 hk0\n\n/-- `physicalFrameRegion 1 0 W = W` (o referencial padrão do kernel é a cunha padrão). -/\ntheorem frame_region_padrao (W : Set Spacetime) :\n    physicalFrameRegion (1 : generatedLorentz) 0 W = W := by\n  ext x\n  change action (1 : TGLExt.LorentzGrp) (x - 0) ∈ W ↔ x ∈ W\n  rw [sub_zero, action_one']\n\n/-- a região do referencial padrão é a própria região (a imagem pela identidade). -/\ntheorem padrao_region (O : Set Spacetime) : Frame.padrao.toEl.region O = O := by\n  ext x\n  change (∃ y, y ∈ O ∧ action (1 : TGLExt.LorentzGrp) y = x - 0) ↔ x ∈ O\n  constructor\n  · rintro ⟨y, hy, h⟩\n    rw [action_one', sub_zero] at h\n    rwa [← h]\n  · intro hx\n    exact ⟨x, hx, by rw [action_one', sub_zero]⟩\n\n/-- ★ A BASE: `PRede` vale no referencial padrão — por `physical_canonical_net_nonzero` e\n    `physical_frame_opposite_symplectic` (kernel). -/\ntheorem prede_padrao : PRede Frame.padrao := by\n  refine ⟨?_, ?_⟩\n  · obtain ⟨v, hv, hne⟩ := physical_canonical_net_nonzero\n    refine ⟨v, hne, ?_⟩\n    change v ∈ compactLocalized (Frame.padrao.toEl.region physicalRightWedge)\n    rw [padrao_region]\n    exact hv\n  · intro f hf h hh\n    change f ∈ compactLocalized (Frame.padrao.toEl.region physicalRightWedge) at hf\n    change h ∈ compactLocalized (Frame.padrao.toEl.region physicalLeftWedge) at hh\n    rw [padrao_region] at hf hh\n    apply physical_frame_opposite_symplectic 1 0 f h\n    · rw [frame_region_padrao]\n      exact compactLocalized_le_localized _ hf\n    · rw [frame_region_padrao]\n      exact compactLocalized_le_localized _ hh\n\n/-- ★★ `IsotropicPost` HABITADO por um predicado da rede da luz. A TRANSITIVIDADE É TRIVIAL POR CONSTRUÇÃO: `Frame` é `PoincareEl` com outro nome, o\n    `SMul` é a multiplicação à esquerda e `padrao` é a identidade (`w = w.toEl • padrao`). Quem\n    prova algo é só a covariância (A). `PoincareEl` é uma estrutura local, restrita a\n    `generatedLorentz`; aqui só há `SMul` compatível com as regiões (`region_smul`), sem instância\n    de grupo nem de ação. A habitação é real (não é o brinquedo `Rapidity`), mas formal e fraca.\n    NÃO habita o `IsotropicPost` do índice de telas e direções nulas do kernel e NÃO prova a H3. -/\ntheorem isotropic_post_da_rede :\n    TGLExt.QuedaSemGeometria.IsotropicPost PoincareEl Frame PRede Frame.padrao := by\n  refine ⟨?_, prede_covariante⟩\n  intro w\n  refine ⟨w.toEl, ?_⟩\n  cases w with\n  | mk N c =>\n    change (⟨N, c⟩ : Frame) = ⟨N * 1, c + action N.val 0⟩\n    rw [mul_one, map_zero, add_zero]\n\n/-- ★★ O PREDICADO `PRede` VALE EM TODO REFERENCIAL, isto é, em toda imagem de Poincaré (Lorentz\n    gerado e translação) da cunha padrão, pelo lema de transporte do kernel. `PRede` não é lei: é\n    não-trivialidade e localidade simplética. -/\ntheorem prede_em_todo_referencial : ∀ w : Frame, PRede w :=\n  TGLExt.QuedaSemGeometria.clausius_everywhere_from_one_wedge_by_covariance\n    isotropic_post_da_rede prede_padrao\n\n/-- Em termos das regiões de referencial do kernel: para todo `(L, a)`, o subespaço localizado de\n    `physicalFrameRegion L a physicalRightWedge` é não nulo. -/\ntheorem cunha_de_referencial_nao_nula (L : generatedLorentz) (a : Spacetime) :\n    ∃ v : H1, v ≠ 0 ∧ v ∈ compactLocalized (physicalFrameRegion L a physicalRightWedge) := by\n  obtain ⟨⟨v, hv0, hv⟩, _⟩ := prede_em_todo_referencial ⟨L⁻¹, a⟩\n  refine ⟨v, hv0, ?_⟩\n  rw [frame_region_eq]\n  exact hv\n\n/-! ## C. KMS da cunha transformada, por conjugação -/\n\nsection KMSConjugado\n\nvariable {F : Type} [NormedAddCommGroup F] [InnerProductSpace ℂ F] [CompleteSpace F]\n\n/-- aplicada ao vácuo fixo por `Γ`, a conjugação por `Γ⁻¹` é `Γ⁻¹` do operador aplicado ao vácuo. -/\ntheorem conj_symm_apply_vac (Γ : F ≃ₗᵢ[ℂ] F) (Ω : F) (hΩ : Γ Ω = Ω) (X : F →L[ℂ] F) :\n    Γ.symm.conjStarAlgEquiv X Ω = Γ.symm (X Ω) := by\n  rw [LinearIsometryEquiv.conjStarAlgEquiv_apply_apply, LinearIsometryEquiv.symm_symm, hΩ]\n\n/-- o produto interno do corpo KMS não muda sob a conjugação por `Γ` (que fixa o vácuo). -/\ntheorem inner_conjugado (Γ : F ≃ₗᵢ[ℂ] F) (Ω : F) (hΩ : Γ Ω = Ω) (A B : F →L[ℂ] F)\n    (a : F ≃ₗᵢ[ℂ] F) :\n    inner ℂ ((star (Γ.symm.conjStarAlgEquiv A)) Ω) (a ((Γ.symm.conjStarAlgEquiv B) Ω)) =\n      inner ℂ ((star A) Ω) ((Γ.symm.trans (a.trans Γ)) (B Ω)) := by\n  rw [← map_star, conj_symm_apply_vac Γ Ω hΩ, conj_symm_apply_vac Γ Ω hΩ]\n  rw [LinearIsometryEquiv.trans_apply, LinearIsometryEquiv.trans_apply]\n  rw [← LinearIsometryEquiv.inner_map_map Γ.symm ((star A) Ω) (Γ (a (Γ.symm (B Ω))))]\n  rw [LinearIsometryEquiv.symm_apply_apply]\n\n/-- [fiação] ★ A CONDIÇÃO KMS SE TRANSPORTA POR CONJUGAÇÃO UNITÁRIA. Se `Ω` é KMS a `β` para o\n    fluxo `α` na álgebra `M`, `Γ` fixa `Ω` e leva `M` em `M'` (`x ∈ M ↔ Γ x Γ⁻¹ ∈ M'`), então `Ω` é KMS a\n    `β` para o fluxo conjugado `Γ α Γ⁻¹` na álgebra `M'`. A mesma função holomorfa `G` serve. -/\ntheorem kms_por_conjugacao {M M' : VonNeumannAlgebra F} (Ω : F) (Γ : F ≃ₗᵢ[ℂ] F) (hΩ : Γ Ω = Ω)\n    (hM : ∀ x : F →L[ℂ] F, x ∈ M ↔ Γ.conjStarAlgEquiv x ∈ M')\n    (α : ℝ → (F ≃ₗᵢ[ℂ] F)) (β : ℝ) (hK : KMSBody M Ω α β) :\n    KMSBody M' Ω (fun t => Γ.symm.trans ((α t).trans Γ)) β := by\n  have hdesc : ∀ X : F →L[ℂ] F, X ∈ M' → Γ.symm.conjStarAlgEquiv X ∈ M := by\n    intro X hX\n    rw [hM]\n    have h : Γ.conjStarAlgEquiv (Γ.symm.conjStarAlgEquiv X) = X := by\n      ext y\n      simp\n    rwa [h]\n  intro A hA B hB\n  obtain ⟨G, h1, h2, h3, h4⟩ := hK _ (hdesc A hA) _ (hdesc B hB)\n  refine ⟨G, h1, h2, ?_, ?_⟩\n  · intro t\n    rw [h3 t]\n    exact inner_conjugado Γ Ω hΩ A B (α t)\n  · intro t\n    rw [h4 t]\n    exact inner_conjugado Γ Ω hΩ B A (α (-t))\n\nend KMSConjugado\n\n/-- a segunda quantização respeita o inverso. -/\ntheorem gamma_symm' (u : H1 ≃ₗᵢ[ℂ] H1) : F1Rede.BosonicFock.gamma u.symm =\n    (F1Rede.BosonicFock.gamma u).symm := by\n  apply LinearIsometryEquiv.ext\n  intro x\n  apply (F1Rede.BosonicFock.gamma u).injective\n  rw [LinearIsometryEquiv.apply_symm_apply]\n  have h := congrArg (fun e => e x)\n    (F1Rede.BosonicFock.gamma_trans u.symm u)\n  simp only [LinearIsometryEquiv.symm_trans_self, F1Rede.BosonicFock.gamma_refl,\n    LinearIsometryEquiv.trans_apply, LinearIsometryEquiv.coe_refl, id_eq] at h\n  exact h.symm\n\n/-- o boost da cunha transformada: `U B0(s) U⁻¹`. -/\ndef PoincareEl.boost (g : PoincareEl) (s : ℝ) : H1 ≃ₗᵢ[ℂ] H1 :=\n  g.unitary.symm.trans ((B0 s).trans g.unitary)\n\n/-- o fluxo da cunha transformada, no Fock: `Γ(U) Γ(B0(2πt)) Γ(U)⁻¹`. -/\ndef fluxoDaCunha (g : PoincareEl) (t : ℝ) :\n    F1Rede.BosonicFock.F ≃ₗᵢ[ℂ] F1Rede.BosonicFock.F :=\n  (F1Rede.BosonicFock.gamma g.unitary).symm.trans\n    ((F1Rede.BosonicFock.gamma (B0 (2 * Real.pi * t))).trans\n      (F1Rede.BosonicFock.gamma g.unitary))\n\n/-- o fluxo conjugado é a segunda quantização do boost da cunha transformada. -/\ntheorem fluxoDaCunha_eq (g : PoincareEl) (t : ℝ) :\n    fluxoDaCunha g t = F1Rede.BosonicFock.gamma (g.boost (2 * Real.pi * t)) := by\n  unfold fluxoDaCunha PoincareEl.boost\n  rw [F1Rede.BosonicFock.gamma_trans, F1Rede.BosonicFock.gamma_trans, gamma_symm']\n\n/-- ★★ KMS DA CUNHA TRANSFORMADA: o vácuo de Fock é KMS (β = 1) para o fluxo `fluxoDaCunha g` na álgebra de\n    Weyl da cunha direita transformada `g.region physicalRightWedge`. Vem de `vacuum_bw_kms` (kernel, cunha\n    padrão), de `net`-covariância (`R_covariance`, via `cunha_covariante`) e de `Γ(U) Ω = Ω`. -/\ntheorem kms_da_cunha_transformada (g : PoincareEl) :\n    KMSBody (F1Fecho.FieldWeyl.R (compactLocalized (g.region physicalRightWedge)))\n      F1Rede.BosonicFock.vacuum (fluxoDaCunha g) 1 :=\n  kms_por_conjugacao (M := F1Fecho.FieldWeyl.R (compactLocalized physicalRightWedge))\n    F1Rede.BosonicFock.vacuum (F1Rede.BosonicFock.gamma g.unitary)\n    (F1Rede.BosonicFock.gamma_vacuum g.unitary)\n    (fun x => F1Fecho.FieldWeyl.R_covariance g.unitary _ _\n      (cunha_covariante g physicalRightWedge) x)\n    _ 1 F1Fecho.PhysicalFockNet.vacuum_bw_kms\n\nend\n\nend TGLExt.CunhasCovariantes\n",
+    'TGLExt/EquacaoDeCampoDaQuedaNaOndaPlana.lean': 'import TGLExt.AEscala\nimport TGLExt.FiniteEntropyAlgebra\nimport TGLExt.DiagonalStateCurve\nimport TGLExt.MicroscopicClausiusBridge\nimport TGLExt.QuadraticGibbsCurve\nimport TGLExt.GibbsMatterBridge\nimport TGLExt.PlaneWaveReconstructionControls\n\nset_option autoImplicit false\nset_option linter.unusedVariables false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 4000000\n\n/-!\n# A equação de campo da queda numa onda plana: construção de um EXEMPLO\n\nEste arquivo tem quatro partes: 1, a identidade termodinâmica dos pesos da queda; 2, a queda como curva de estados\ndiagonais; 3, a queda numa onda plana; 4, a equação de campo no exemplo, com o cabeçalho no começo da própria parte.\n-/\n\n/-!\n# A queda numa onda plana: construção de um EXEMPLO\n\nO QUE A PARTE 3 É, SEM ENFEITE:\n\n* é a CONSTRUÇÃO DE UM EXEMPLO, não um teste. O perfil da onda plana, `(a, c)`, é ESCOLHIDO para que\n  o balanço `eta · (a + c) = 2π · gibbsCoupling (pesoDeGibbs custo s₀)` valha. O resultado é, portanto,\n  EXISTÊNCIA POR ESCOLHA: a CONDIÇÃO do lado direito de K4a é satisfatível com Ricci e fonte não\n  nulos (não-vacuidade). (as hipóteses de regularidade, torção\n  e nulidade já se cumprem para todo `(a, c)`, inclusive o plano; o que K4c mostra é a condição.)\n  NÃO é derivação da geometria a partir da queda: a geometria é dada pelo kernel (`waveSolder`) e\n  o perfil é escolhido;\n* o cisalhamento da onda (`a − c`) fica LIVRE, e isso se vê no próprio K4a: a condição só envolve\n  `a + c`. (`matched_curvature_distinguishes` e\n  `state_alone_not_curvature_coordinate` dizem o mesmo para a família de AMPLITUDE da bancada, não\n  para a queda; o análogo de amplitude deste exemplo já existe no kernel: `geometric_wave_curved`,\n  `geometric_wave_matter_nonzero`.)\n* `eta` não tem restrição de sinal no existencial. Para `eta < 0` sai `a = c < 0`,\n  com Ricci negativo na direção nula e fonte não negativa: é só formal. A leitura de energia\n  positiva seria a de `eta > 0` e NÃO é provada aqui;\n* na direção nula paralela à onda (frequência zero) os dois lados do balanço somem e o limite vale\n  com ou sem a condição: o conteúdo não trivial só existe para frequência não nula;\n* o relógio quadrático `s = s₀(1 + t²)` e o acoplamento `gibbsCoupling` (variância modular sobre π)\n  são os definidos pelo kernel, não derivados da queda (ver o cabeçalho da PARTE 2, K3d);\n* não é `NamedAtlasH3` (outro tipo: registro de probabilidades), não é a lei de área em geral, não é a\n  seta H3 do fecho. K4a é um SE E SÓ SE sobre a tela da origem; K4c-i vale em todo ponto e em toda\n  direção nula, mas dentro da família da onda plana (`waveSolder a c`) e com o balanço como hipótese.\n\nβ_TGL não aparece. O gate não se move. Sem sorry, sem axiom.\n-/\n\n/-!\n# A queda como curva de estados diagonais\n\nA PARTE 2 (K1, K2, K3):\n\n* K1 `aQuedaComoCurvaDeEstados` — habita `DiagonalStateCurve (pesoDeGibbs c s₀)` do kernel\n  (`ChatgptAudit.Micro021`), com `weights t = pesoDeGibbs c (s₀ + t)` e a tangente dada pela derivada\n  do peso (`tangenteDaQueda`); todos os campos provados;\n* K2 `o_erro_de_area_da_queda` — o erro de área do kernel (`microscopicAreaError`) dessa curva é\n  `(S(s₀+t) − S(s₀)) − η·(A t − A 0)`, com `S = entropiaDaQueda`;\n* K3 — a comparação com a família de Gibbs do kernel (`quadraticGibbsCurve`, usada por\n  `gibbs_area_matching_iff_ricci` e `einstein_from_gibbs_area_matching`): ver os teoremas da seção\n  final e o que eles dizem e NÃO dizem.\n\nHONESTIDADE (a régua): K1 a K3c são identidades de\nfamílias de pesos finitos e cálculo de somas. K3d e K3e INSTANCIAM teoremas geométricos do kernel\n(Ricci, área induzida, balanço de horizonte, limites pela esquerda), e o dado geométrico (a tela `P`,\na métrica, a conexão, a regularidade, a direção nula) entra como HIPÓTESE: não há aqui testemunha de\nque esses dados existam juntos. A curva `s = s₀(1+(ωt)²)` é o relógio quadrático IMPOSTO pela\nconstrução do kernel, não derivado da queda (a curva linear falha, K3e). O acoplamento\n`gibbsCoupling` é DEFINIDO no kernel como a variância modular sobre π: por isso o lado direito de\nK3d casa com a resposta de entropia por construção; em termos da variância do custo ele não foi\ncalculado aqui. Nos casos degenerados (`s₀ = 0`, custo constante, `ω = 0`) o lado da queda some e\nK3d reduz-se a uma condição só sobre a área e a curvatura. Nada disto é a lei de área, nem Clausius\nde horizonte, nem a seta H3 do fecho: K3d é um SE E SÓ SE. β_TGL não aparece. O gate não se move;\nsem sorry, sem axiom.\n-/\n\n/-!\n# A identidade termodinâmica dos pesos da queda\n\nO QUE É, SEM ENFEITE:\n\n* isto é a identidade canônica `d(log Z + s·E) = s·dE` da família de pesos `e^{−s·c(x)}/Z(s)`\n  `[KNOWN]`. Ela vale para QUALQUER custo `c : X → ℕ` e a prova é cálculo de somas finitas;\n* ela NÃO usa a identidade verbal (`IdentidadeVerbal`), nem `trava`, nem\n  `opDaInstancia`. O que a liga à queda é um teorema do kernel, fora deste arquivo:\n  `TraducaoTuring.a_norma_da_trava_e_a_particao` (`‖trava c t (uniforme X)‖² = Z(2t)/|X|`),\n  de modo que o `s` daqui é o `2t` da trava;\n* a "temperatura" `1/s` é a variável conjugada de `E` por definição: não há temperatura\n  independente (em `s = 0` ela nem está definida). Por isso a igualdade é quase definicional;\n* a SETA do fecho (`hH3`: da covariância do posto a Clausius em todo ponto e direção, na\n  forma de ÁREA do F2.3, `NamedAtlasH3`) segue NÃO derivada.\n\nO QUE PROVA:\n\n* `pesoDeGibbs c s` — os pesos `e^{−s·c(x)}/Z(s)`; `pesos_de_gibbs_somam_um`;\n* `custoMedio c s` — `E(s) = (Σ c·e^{−s c}) / Z(s)`; `entropiaDaQueda c s := log Z(s) + s·E(s)`;\n* ★★ `a_entropia_da_queda_e_a_de_gibbs` — `entropiaDaQueda` É a entropia `−Σ p log p` dos pesos,\n  na definição que o kernel usa no erro de área (`ChatgptAudit.finiteEntropy`);\n* `hasDerivAt_particao`, `hasDerivAt_custoPesado`, `hasDerivAt_custoMedio` — as derivadas;\n* ★★★ `clausius_da_queda` — `dS = s · dE`, a forma canônica (de Gibbs) da igualdade de Clausius;\n  `clausius_da_queda_explicito` — a mesma, com a derivada do custo médio escrita.\n\nHONESTIDADE (a régua): NÃO é a prova global, não é Clausius de horizonte e não é a lei de\nárea. O dicionário entropia ↔ área da tela não está aqui; o kernel registra um negativo\n(`OpticalHeatClausius`): a área não é escalar só da álgebra e do estado.\nO gate não se move; β não aparece; sem sorry, sem axiom.\n-/\n\nnamespace TGLExt.EquacaoDeCampoDaQuedaNaOndaPlana\n\nopen TGLExt.TraducaoTuring\n\nnoncomputable section\n\nvariable {X : Type} [Fintype X] [DecidableEq X]\n\n/-- a soma dos custos pesados pela queda: `Σ c(x)·e^{−s·c(x)}`. -/\ndef custoPesado (c : X → ℕ) (s : ℝ) : ℝ := ∑ x, (c x : ℝ) * Real.exp (-(s * (c x : ℝ)))\n\n/-- a soma dos quadrados dos custos pesados pela queda: `Σ c(x)²·e^{−s·c(x)}`. -/\ndef custoQuadPesado (c : X → ℕ) (s : ℝ) : ℝ := ∑ x, (c x : ℝ) ^ 2 * Real.exp (-(s * (c x : ℝ)))\n\n/-- o custo médio: `E(s) = (Σ c·e^{−s c}) / Z(s)`. -/\ndef custoMedio (c : X → ℕ) (s : ℝ) : ℝ := custoPesado c s / particao c s\n\n/-- `S(s) = log Z(s) + s·E(s)`; é a entropia dos pesos por `a_entropia_da_queda_e_a_de_gibbs`. -/\ndef entropiaDaQueda (c : X → ℕ) (s : ℝ) : ℝ := Real.log (particao c s) + s * custoMedio c s\n\n/-- os pesos de Gibbs: `e^{−s·c(x)}/Z(s)`. -/\ndef pesoDeGibbs (c : X → ℕ) (s : ℝ) (x : X) : ℝ := Real.exp (-(s * (c x : ℝ))) / particao c s\n\n/-- a partição é positiva. -/\ntheorem particao_pos [Nonempty X] (c : X → ℕ) (s : ℝ) : 0 < particao c s := by\n  unfold particao\n  exact Finset.sum_pos (fun x _ => Real.exp_pos _) Finset.univ_nonempty\n\n/-- os pesos de Gibbs somam 1. -/\ntheorem pesos_de_gibbs_somam_um [Nonempty X] (c : X → ℕ) (s : ℝ) :\n    ∑ x, pesoDeGibbs c s x = 1 := by\n  unfold pesoDeGibbs\n  rw [← Finset.sum_div]\n  exact div_self (particao_pos c s).ne\'\n\n/-- ★★ A ENTROPIA DA QUEDA É A DE GIBBS: `log Z + s·E` é `−Σ p log p` dos pesos, na\n    definição de entropia que o kernel usa no erro de área. -/\ntheorem a_entropia_da_queda_e_a_de_gibbs [Nonempty X] (c : X → ℕ) (s : ℝ) :\n    ChatgptAudit.finiteEntropy (pesoDeGibbs c s) = entropiaDaQueda c s := by\n  have hZ : 0 < particao c s := particao_pos c s\n  have hlog : ∀ x, Real.log (pesoDeGibbs c s x)\n      = -(s * (c x : ℝ)) - Real.log (particao c s) := by\n    intro x\n    unfold pesoDeGibbs\n    rw [Real.log_div (Real.exp_pos _).ne\' hZ.ne\', Real.log_exp]\n  have key : ∀ x, -(pesoDeGibbs c s x * (-(s * (c x : ℝ)) - Real.log (particao c s)))\n      = (s / particao c s) * ((c x : ℝ) * Real.exp (-(s * (c x : ℝ))))\n        + (Real.log (particao c s) / particao c s) * Real.exp (-(s * (c x : ℝ))) := by\n    intro x\n    unfold pesoDeGibbs\n    ring\n  have hsum : (∑ x, Real.exp (-(s * (c x : ℝ)))) = particao c s := rfl\n  unfold ChatgptAudit.finiteEntropy ChatgptAudit.entropyAtom\n  simp only [hlog, key]\n  rw [Finset.sum_add_distrib, ← Finset.mul_sum, ← Finset.mul_sum, hsum]\n  unfold entropiaDaQueda custoMedio custoPesado\n  field_simp\n  ring\n\n/-- (auxiliar) a derivada de um peso da queda. -/\ntheorem hasDerivAt_peso (k s : ℝ) :\n    HasDerivAt (fun y : ℝ => Real.exp (-(y * k))) (-(k * Real.exp (-(s * k)))) s := by\n  have h00 : HasDerivAt (fun y : ℝ => y * k) k s := by\n    simpa using (hasDerivAt_id s).mul_const k\n  have h0 : HasDerivAt (fun y : ℝ => -(y * k)) (-k) s := h00.neg\n  have h2 := h0.exp\n  exact h2.congr_deriv (by ring)\n\n/-- a derivada da partição é menos o custo pesado. -/\ntheorem hasDerivAt_particao (c : X → ℕ) (s : ℝ) :\n    HasDerivAt (particao c) (-(custoPesado c s)) s := by\n  have h : ∀ x ∈ (Finset.univ : Finset X), HasDerivAt (fun y : ℝ => Real.exp (-(y * (c x : ℝ))))\n      (-((c x : ℝ) * Real.exp (-(s * (c x : ℝ))))) s := fun x _ => hasDerivAt_peso (c x : ℝ) s\n  have hs := HasDerivAt.fun_sum h\n  have hv : (∑ x, -((c x : ℝ) * Real.exp (-(s * (c x : ℝ))))) = -(custoPesado c s) := by\n    unfold custoPesado\n    rw [Finset.sum_neg_distrib]\n  rw [hv] at hs\n  exact hs\n\n/-- a derivada do custo pesado é menos o custo quadrático pesado. -/\ntheorem hasDerivAt_custoPesado (c : X → ℕ) (s : ℝ) :\n    HasDerivAt (custoPesado c) (-(custoQuadPesado c s)) s := by\n  have h : ∀ x ∈ (Finset.univ : Finset X),\n      HasDerivAt (fun y : ℝ => (c x : ℝ) * Real.exp (-(y * (c x : ℝ))))\n        (-((c x : ℝ) ^ 2 * Real.exp (-(s * (c x : ℝ))))) s := by\n    intro x _\n    have h2 := (hasDerivAt_peso (c x : ℝ) s).const_mul (c x : ℝ)\n    exact h2.congr_deriv (by ring)\n  have hs := HasDerivAt.fun_sum h\n  have hv : (∑ x, -((c x : ℝ) ^ 2 * Real.exp (-(s * (c x : ℝ))))) = -(custoQuadPesado c s) := by\n    unfold custoQuadPesado\n    rw [Finset.sum_neg_distrib]\n  rw [hv] at hs\n  exact hs\n\n/-- a derivada do custo médio (regra do quociente). -/\ntheorem hasDerivAt_custoMedio [Nonempty X] (c : X → ℕ) (s : ℝ) :\n    HasDerivAt (custoMedio c)\n      ((-(custoQuadPesado c s) * particao c s - custoPesado c s * (-(custoPesado c s)))\n        / (particao c s) ^ 2) s :=\n  (hasDerivAt_custoPesado c s).div (hasDerivAt_particao c s) (particao_pos c s).ne\'\n\n/-- ★★★ A FORMA CANÔNICA: `dS = s · dE`. Identidade termodinâmica da família de\n    pesos `e^{−s c}/Z` `[KNOWN]`; vale para todo custo `c`; não usa a identidade verbal. -/\ntheorem clausius_da_queda [Nonempty X] (c : X → ℕ) (s E\' : ℝ)\n    (hE : HasDerivAt (custoMedio c) E\' s) :\n    HasDerivAt (entropiaDaQueda c) (s * E\') s := by\n  have hlog : HasDerivAt (fun s : ℝ => Real.log (particao c s))\n      (-(custoPesado c s) / particao c s) s :=\n    (hasDerivAt_particao c s).log (particao_pos c s).ne\'\n  have hmul := (hasDerivAt_id s).mul hE\n  have h := hlog.add hmul\n  have h2 : HasDerivAt (entropiaDaQueda c)\n      (-(custoPesado c s) / particao c s + (1 * custoMedio c s + id s * E\')) s := h\n  refine h2.congr_deriv ?_\n  simp only [custoMedio, id]\n  ring\n\n/-- ★★ a mesma, com a derivada do custo médio escrita. -/\ntheorem clausius_da_queda_explicito [Nonempty X] (c : X → ℕ) (s : ℝ) :\n    HasDerivAt (entropiaDaQueda c)\n      (s * ((-(custoQuadPesado c s) * particao c s - custoPesado c s * (-(custoPesado c s)))\n        / (particao c s) ^ 2)) s :=\n  clausius_da_queda c s _ (hasDerivAt_custoMedio c s)\n\n/-! ## PARTE 2 — K1: a queda como curva de estados diagonais -/\n\n/-- a tangente da queda: `d/ds [e^{−s c(x)}/Z(s)] = peso · (E(s) − c(x))`. -/\ndef tangenteDaQueda (c : X → ℕ) (s : ℝ) (x : X) : ℝ :=\n  pesoDeGibbs c s x * (custoMedio c s - (c x : ℝ))\n\n/-- o peso de Gibbs é positivo. -/\ntheorem pesoDeGibbs_pos [Nonempty X] (c : X → ℕ) (s : ℝ) (x : X) : 0 < pesoDeGibbs c s x :=\n  div_pos (Real.exp_pos _) (particao_pos c s)\n\n/-- a derivada do peso de Gibbs em `s`: `peso · (E(s) − c(x))` (regra do quociente). -/\ntheorem hasDerivAt_pesoDeGibbs [Nonempty X] (c : X → ℕ) (s : ℝ) (x : X) :\n    HasDerivAt (fun y : ℝ => pesoDeGibbs c y x) (tangenteDaQueda c s x) s := by\n  have hZ : particao c s ≠ 0 := (particao_pos c s).ne\'\n  have h := (hasDerivAt_peso (c x : ℝ) s).div (hasDerivAt_particao c s) hZ\n  refine h.congr_deriv ?_\n  unfold tangenteDaQueda pesoDeGibbs custoMedio\n  field_simp\n  ring\n\n/-- o peso de Gibbs é contínuo em `s`. -/\ntheorem pesoDeGibbs_continuo [Nonempty X] (c : X → ℕ) (x : X) :\n    Continuous (fun s : ℝ => pesoDeGibbs c s x) :=\n  continuous_iff_continuousAt.mpr (fun s => (hasDerivAt_pesoDeGibbs c s x).continuousAt)\n\n/-- o custo médio é contínuo em `s`. -/\ntheorem custoMedio_continuo [Nonempty X] (c : X → ℕ) : Continuous (custoMedio c) :=\n  continuous_iff_continuousAt.mpr (fun s => (hasDerivAt_custoMedio c s).continuousAt)\n\n/-- a tangente da queda é contínua em `s`. -/\ntheorem tangenteDaQueda_continua [Nonempty X] (c : X → ℕ) (x : X) :\n    Continuous (fun s : ℝ => tangenteDaQueda c s x) :=\n  (pesoDeGibbs_continuo c x).mul ((custoMedio_continuo c).sub continuous_const)\n\n/-- (auxiliar) a derivada do peso ao longo da translação `t ↦ s₀ + t`. -/\ntheorem hasDerivAt_peso_transladado [Nonempty X] (c : X → ℕ) (s₀ t : ℝ) (x : X) :\n    HasDerivAt (fun u : ℝ => pesoDeGibbs c (s₀ + u) x) (tangenteDaQueda c (s₀ + t) x) t :=\n  (hasDerivAt_pesoDeGibbs c (s₀ + t) x).comp_const_add s₀ t\n\n/-- ★ K1. A QUEDA É UMA CURVA DE ESTADOS DIAGONAIS: habita a `DiagonalStateCurve` do\n    kernel com base `pesoDeGibbs c s₀`, `weights t = pesoDeGibbs c (s₀ + t)` e tangente\n    `tangenteDaQueda c (s₀ + t)`. A curva é LINEAR no parâmetro `s`; ela não é a curva quadrática\n    `quadraticGibbsCurve` do kernel (ver a seção K3). -/\ndef aQuedaComoCurvaDeEstados [Nonempty X] (c : X → ℕ) (s₀ : ℝ) :\n    ChatgptAudit.Micro021.DiagonalStateCurve (pesoDeGibbs c s₀) where\n  weights := fun t => pesoDeGibbs c (s₀ + t)\n  tangent := fun t => tangenteDaQueda c (s₀ + t)\n  at_zero := fun x => by simp\n  trace_one := fun t => pesos_de_gibbs_somam_um c (s₀ + t)\n  derivative_zero := fun x => hasDerivAt_peso_transladado c s₀ 0 x\n  derivative_past := by\n    filter_upwards [] with t\n    exact fun x => hasDerivAt_peso_transladado c s₀ t x\n  tangent_continuous := fun x =>\n    ((tangenteDaQueda_continua c x).comp (continuous_const.add continuous_id)).continuousAt\n\n/-! ## PARTE 2 — K2: o erro de área da queda em termos da entropia da queda -/\n\n/-- ★ K2. O erro de área do kernel (`microscopicAreaError`) da curva da queda é\n    `(S(s₀+t) − S(s₀)) − η·(A t − A 0)`, com `S = entropiaDaQueda`. Usa\n    `a_entropia_da_queda_e_a_de_gibbs` nos dois termos. A área `A` e o `η` ficam livres. -/\ntheorem o_erro_de_area_da_queda [Nonempty X] (c : X → ℕ) (s₀ η : ℝ) (A : ℝ → ℝ) (t : ℝ) :\n    ChatgptAudit.Micro021.microscopicAreaError (aQuedaComoCurvaDeEstados c s₀) η A t\n      = (entropiaDaQueda c (s₀ + t) - entropiaDaQueda c s₀) - η * (A t - A 0) := by\n  have h1 : ChatgptAudit.finiteEntropy ((aQuedaComoCurvaDeEstados c s₀).weights t)\n      = entropiaDaQueda c (s₀ + t) := a_entropia_da_queda_e_a_de_gibbs c (s₀ + t)\n  have h0 : ChatgptAudit.finiteEntropy (pesoDeGibbs c s₀) = entropiaDaQueda c s₀ :=\n    a_entropia_da_queda_e_a_de_gibbs c s₀\n  unfold ChatgptAudit.Micro021.microscopicAreaError\n  rw [h1, h0]\n\n/-- a tangente da curva da queda em `0` é nula se, e só se, o custo é constante igual\n    ao custo médio em `s₀`. Para custo não constante a tangente NÃO é nula (a variância do custo\n    sob a queda é positiva). -/\ntheorem a_tangente_da_queda_em_zero_e_nula_sse [Nonempty X] (c : X → ℕ) (s₀ : ℝ) :\n    (aQuedaComoCurvaDeEstados c s₀).tangent 0 = 0 ↔ ∀ x, (c x : ℝ) = custoMedio c s₀ := by\n  constructor\n  · intro h x\n    have hx := congrFun h x\n    change tangenteDaQueda c (s₀ + 0) x = 0 at hx\n    rw [add_zero] at hx\n    unfold tangenteDaQueda at hx\n    rcases mul_eq_zero.mp hx with h1 | h1\n    · exact absurd h1 (pesoDeGibbs_pos c s₀ x).ne\'\n    · linarith\n  · intro h\n    funext x\n    change tangenteDaQueda c (s₀ + 0) x = 0\n    rw [add_zero]\n    unfold tangenteDaQueda\n    rw [h x]\n    ring\n\n/-! ## PARTE 2 — K3: a família de Gibbs do kernel é a queda, reparametrizada\n\nO kernel (`ChatgptAudit.Thermal024`) usa a inclinação modular `gibbsWeights p s = p^{1+s}/Z`\n(`gibbsAtom p s i = p i · e^{−s·modularScore p i}`, `modularScore p i = −log (p i)`) e a CURVA\n`quadraticGibbsCurve p hp hs ω`, com `s = (ω t)²`. Aqui se mede a relação com a queda. -/\n\n/-- ★ K3a. Para a base `p = pesoDeGibbs c s₀`, a inclinação modular do kernel É a queda\n    em outro parâmetro: `gibbsWeights p s = pesoDeGibbs c (s₀·(1+s))`. (Para `s₀ = 0` a base é\n    uniforme, o escore modular é constante e a inclinação é trivial: `p` permanece `p`.) -/\ntheorem os_pesos_de_gibbs_do_kernel_sao_a_queda [Nonempty X] (c : X → ℕ) (s₀ s : ℝ) (x : X) :\n    ChatgptAudit.Thermal024.gibbsWeights (pesoDeGibbs c s₀) s x\n      = pesoDeGibbs c (s₀ * (1 + s)) x := by\n  have hZ : 0 < particao c s₀ := particao_pos c s₀\n  have hp : ∀ y : X, pesoDeGibbs c s₀ y\n      = Real.exp (-(s₀ * (c y : ℝ)) - Real.log (particao c s₀)) := by\n    intro y\n    unfold pesoDeGibbs\n    rw [Real.exp_sub, Real.exp_log hZ]\n  have hatom : ∀ y : X, ChatgptAudit.Thermal024.gibbsAtom (pesoDeGibbs c s₀) s y\n      = Real.exp (-((1 + s) * Real.log (particao c s₀)))\n        * Real.exp (-((s₀ * (1 + s)) * (c y : ℝ))) := by\n    intro y\n    unfold ChatgptAudit.Thermal024.gibbsAtom ChatgptAudit.Thermal024.modularScore\n    rw [hp y, Real.log_exp, ← Real.exp_add, ← Real.exp_add]\n    congr 1\n    ring\n  have hpart : ChatgptAudit.Thermal024.gibbsPartition (pesoDeGibbs c s₀) s\n      = Real.exp (-((1 + s) * Real.log (particao c s₀))) * particao c (s₀ * (1 + s)) := by\n    have hZs : particao c (s₀ * (1 + s))\n        = ∑ y, Real.exp (-((s₀ * (1 + s)) * (c y : ℝ))) := rfl\n    unfold ChatgptAudit.Thermal024.gibbsPartition\n    rw [hZs, Finset.mul_sum]\n    exact Finset.sum_congr rfl (fun y _ => hatom y)\n  unfold ChatgptAudit.Thermal024.gibbsWeights\n  rw [hatom x, hpart]\n  unfold pesoDeGibbs\n  rw [mul_div_mul_left _ _ (Real.exp_pos _).ne\']\n\n/-- ★ K3b. A curva quadrática do kernel sobre a base da queda é a queda no parâmetro\n    `s₀·(1 + (ω t)²)`. -/\ntheorem a_curva_quadratica_do_kernel_e_a_queda_reparametrizada [Nonempty X] (c : X → ℕ)\n    (s₀ ω t : ℝ) (x : X) :\n    ChatgptAudit.Thermal024.quadraticGibbsWeights (pesoDeGibbs c s₀) ω t x\n      = pesoDeGibbs c (s₀ * (1 + (ω * t) ^ 2)) x :=\n  os_pesos_de_gibbs_do_kernel_sao_a_queda c s₀ ((ω * t) ^ 2) x\n\n/-- ★ K3c. O erro de área da curva quadrática do kernel, sobre a base da queda, escrito\n    com a entropia da queda: `(S(s₀(1+(ωt)²)) − S(s₀)) − η·(A t − A 0)`. -/\ntheorem o_erro_de_area_da_curva_quadratica_da_queda [Nonempty X] (c : X → ℕ) (s₀ : ℝ)\n    (hp : ∀ x, 0 < pesoDeGibbs c s₀ x) (ω η : ℝ) (A : ℝ → ℝ) (t : ℝ) :\n    ChatgptAudit.Micro021.microscopicAreaError\n        (ChatgptAudit.Thermal024.quadraticGibbsCurve (pesoDeGibbs c s₀) hp\n          (pesos_de_gibbs_somam_um c s₀) ω) η A t\n      = (entropiaDaQueda c (s₀ * (1 + (ω * t) ^ 2)) - entropiaDaQueda c s₀) - η * (A t - A 0) := by\n  have hw : (ChatgptAudit.Thermal024.quadraticGibbsCurve (pesoDeGibbs c s₀) hp\n        (pesos_de_gibbs_somam_um c s₀) ω).weights t\n      = pesoDeGibbs c (s₀ * (1 + (ω * t) ^ 2)) :=\n    funext (fun x => a_curva_quadratica_do_kernel_e_a_queda_reparametrizada c s₀ ω t x)\n  have h1 : ChatgptAudit.finiteEntropy ((ChatgptAudit.Thermal024.quadraticGibbsCurve\n        (pesoDeGibbs c s₀) hp (pesos_de_gibbs_somam_um c s₀) ω).weights t)\n      = entropiaDaQueda c (s₀ * (1 + (ω * t) ^ 2)) := by\n    rw [hw]\n    exact a_entropia_da_queda_e_a_de_gibbs c _\n  have h0 : ChatgptAudit.finiteEntropy (pesoDeGibbs c s₀) = entropiaDaQueda c s₀ :=\n    a_entropia_da_queda_e_a_de_gibbs c s₀\n  unfold ChatgptAudit.Micro021.microscopicAreaError\n  rw [h1, h0]\n\nsection K3geometria\n\nopen Filter Topology ChatgptAudit ChatgptAudit.Micro021 ChatgptAudit.Coherent023 ChatgptAudit.Flow019\n  ChatgptAudit.Flow020 ChatgptAudit.Thermal024\n\n/-- ★★ K3d. O COROLÁRIO. `gibbs_area_matching_iff_ricci` do kernel, instanciado na base\n    `p = pesoDeGibbs c s₀` (positiva e normalizada), com o erro de área escrito pela entropia da\n    queda: o erro de área sobre `t²` da queda reparametrizada `s = s₀(1+(ωt)²)`, com\n    `ω = covectorRead (w x) d`, tende a zero PELA ESQUERDA (`𝓝[<] 0`) se, e só se,\n    `η·Ric(d,d) = 2π·T(d,d)`, onde `T` é o tensor de tensão do covetor com acoplamento\n    `gibbsCoupling (pesoDeGibbs c s₀)`.\n    NÃO é a lei de área, é um SE E SÓ SE: a área `inducedArea` e o dado geométrico `P` são\n    ARGUMENTOS (hipóteses); o relógio quadrático é o imposto pelo kernel, não derivado da queda; e\n    o acoplamento é a variância modular sobre π por definição do kernel, de modo que o lado direito\n    casa com a resposta de entropia por construção. O que se acrescenta aqui é só a leitura do lado\n    da entropia como a entropia da queda. β_TGL não aparece. -/\ntheorem o_balanco_de_area_da_queda_e_ricci [Nonempty X]\n    {U : Set Coordinate4} {g : TensorField4} {Gamma : ConnectionField4} {x d : Coordinate4}\n    (P : EquilibriumScreenData U g Gamma x d) (gInv : TensorField4) (w : CovectorField4)\n    (c : X → ℕ) (s₀ eta : ℝ)\n    (hU : IsOpen U) (hg : SmoothMatrixOn U g) (hG : SmoothConnectionOn U Gamma)\n    (ht : ∀ i j k, Gamma x i k j = Gamma x j k i) (hn : tensorQuad (g x) d = 0) :\n    Tendsto (fun t => ((entropiaDaQueda c (s₀ * (1 + (covectorRead (w x) d * t) ^ 2))\n        - entropiaDaQueda c s₀)\n        - eta * (inducedArea g P.curve P.screen.vectors t\n          - inducedArea g P.curve P.screen.vectors 0)) / t ^ 2)\n      (𝓝[<] 0) (𝓝 0) ↔\n      eta * tensorQuad (coordinateRicci Gamma x) d\n        = 2 * Real.pi * tensorQuad (covectorStressField g gInv w\n            (gibbsCoupling (pesoDeGibbs c s₀)) x) d := by\n  have h := gibbs_area_matching_iff_ricci P gInv w (pesoDeGibbs c s₀)\n    (pesoDeGibbs_pos c s₀) (pesos_de_gibbs_somam_um c s₀) eta hU hg hG ht hn\n  have hf : (fun t => microscopicAreaError (quadraticGibbsCurve (pesoDeGibbs c s₀)\n        (pesoDeGibbs_pos c s₀) (pesos_de_gibbs_somam_um c s₀) (covectorRead (w x) d)) eta\n        (inducedArea g P.curve P.screen.vectors) t / t ^ 2)\n      = (fun t => ((entropiaDaQueda c (s₀ * (1 + (covectorRead (w x) d * t) ^ 2))\n        - entropiaDaQueda c s₀)\n        - eta * (inducedArea g P.curve P.screen.vectors t\n          - inducedArea g P.curve P.screen.vectors 0)) / t ^ 2) := by\n    funext t\n    rw [o_erro_de_area_da_curva_quadratica_da_queda c s₀ (pesoDeGibbs_pos c s₀)]\n  rw [hf] at h\n  exact h\n\n/-- K3e. O QUE A CURVA LINEAR DE K1 NÃO DÁ. Para a curva da queda `s = s₀ + t` (K1), o\n    balanço de Clausius em ordem `t²` do kernel (`microscopic_clausius_iff_zero_tangent`, com as\n    hipóteses de calor e de área do kernel) equivale a `tangent 0 = 0`, isto é, a o custo ser\n    CONSTANTE igual ao custo médio. Para custo não constante a curva linear tem tangente não nula em\n    `0` (os PESOS variam em primeira ordem em `t`; a entropia, em `s₀ = 0`, não) e o balanço\n    quadrático não fecha por esta via:\n    a família de Gibbs do kernel só é alcançada pela REPARAMETRIZAÇÃO quadrática (K3a a K3d). -/\ntheorem o_balanco_quadratico_da_queda_linear_sse_custo_constante [Nonempty X] (c : X → ℕ)\n    (s₀ rate eta : ℝ) (hrate : rate ≠ 0) (area heat : ℝ → ℝ)\n    (hheat : Tendsto (fun t => microscopicHeatError (aQuedaComoCurvaDeEstados c s₀) rate heat t\n      / t ^ 2) (𝓝[<] 0) (𝓝 0))\n    (harea : Tendsto (fun t => microscopicAreaError (aQuedaComoCurvaDeEstados c s₀) eta area t\n      / t ^ 2) (𝓝[<] 0) (𝓝 0)) :\n    Tendsto (fun t => horizonBalancePrimitive rate eta area heat t / t ^ 2) (𝓝[<] 0) (𝓝 0) ↔\n      ∀ x, (c x : ℝ) = custoMedio c s₀ :=\n  (microscopic_clausius_iff_zero_tangent (aQuedaComoCurvaDeEstados c s₀)\n    (pesoDeGibbs_pos c s₀) rate eta hrate area heat hheat harea).trans\n    (a_tangente_da_queda_em_zero_e_nula_sse c s₀)\n\nend K3geometria\n\n/-! ## PARTE 3 — K4: a queda numa onda plana (construção de um EXEMPLO) -/\n\nsection K4ondaPlana\n\nopen Filter Topology Matrix Set TGLExt ChatgptAudit ChatgptAudit.Coherent023 ChatgptAudit.Response028\n  ChatgptAudit.Flow019 ChatgptAudit.Flow020 ChatgptAudit.Micro021 ChatgptAudit.Profile026\n  ChatgptAudit.Thermal024 ChatgptAudit.Thermal025 ChatgptAudit.Wave029\n\n/-- ★★ K4a. O balanço de área da queda na tela da origem da onda plana\n    `waveOriginScreen a c` (direção nula `waveTestDirection`, frequência `1`): o erro de área da\n    queda reparametrizada `s = s₀(1 + t²)`, sobre `t²`, tende a zero pela esquerda se, e só se,\n    `eta · (a + c) = 2π · gibbsCoupling (pesoDeGibbs custo s₀)`.\n    É `o_balanco_de_area_da_queda_e_ricci` instanciado na onda plana do kernel, com\n    `wave_ricci_quad` e `wave_matter_quad` (mesmo caminho de `wave_origin_area_iff`, trocando o teorema\n    de amplitude pelo de Gibbs). O cisalhamento `a − c` não entra: fica livre. -/\ntheorem o_balanco_de_area_da_queda_na_onda_plana [Nonempty X] (a c : ℝ) (custo : X → ℕ)\n    (s₀ eta : ℝ) :\n    Tendsto (fun t => ((entropiaDaQueda custo (s₀ * (1 + t ^ 2)) - entropiaDaQueda custo s₀)\n        - eta * (inducedArea (frameMetricField (waveSolder a c)) (waveOriginScreen a c).curve\n            (waveOriginScreen a c).screen.vectors t\n          - inducedArea (frameMetricField (waveSolder a c)) (waveOriginScreen a c).curve\n            (waveOriginScreen a c).screen.vectors 0)) / t ^ 2) (𝓝[<] 0) (𝓝 0) ↔\n      eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀) := by\n  have hG : SmoothConnectionOn univ (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) := by\n    rw [wave_levi_civita]\n    exact wave_connection_smooth a c\n  have ht : ∀ i j k, frameLeviCivita (waveSolder a c) (waveInverseSolder a c) 0 i k j =\n      frameLeviCivita (waveSolder a c) (waveInverseSolder a c) 0 j k i := by\n    rw [wave_levi_civita]\n    exact wave_connection_torsion_free a c 0\n  have h := o_balanco_de_area_da_queda_e_ricci (waveOriginScreen a c)\n    (inverseFrameMetricField (waveInverseSolder a c)) waveCovectorField custo s₀ eta isOpen_univ\n    (frame_metric_smooth univ _ (wave_solder_smooth a c)) hG ht (wave_test_null a c)\n  change (Tendsto (fun t => ((entropiaDaQueda custo\n        (s₀ * (1 + (covectorRead waveCovector waveTestDirection * t) ^ 2))\n        - entropiaDaQueda custo s₀)\n        - eta * (inducedArea (frameMetricField (waveSolder a c)) (waveOriginScreen a c).curve\n            (waveOriginScreen a c).screen.vectors t\n          - inducedArea (frameMetricField (waveSolder a c)) (waveOriginScreen a c).curve\n            (waveOriginScreen a c).screen.vectors 0)) / t ^ 2) (𝓝[<] 0) (𝓝 0) ↔\n      eta * tensorQuad (coordinateRicci\n          (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) 0) waveTestDirection\n        = 2 * Real.pi * tensorQuad (waveMatter a c (gibbsCoupling (pesoDeGibbs custo s₀)) 0)\n          waveTestDirection) at h\n  simpa only [wave_ricci_quad, wave_matter_quad, wave_test_frequency, one_pow, mul_one,\n    one_mul] using h\n\n/-- (auxiliar) os pesos de Gibbs não são todos iguais quando `s₀ ≠ 0` e o custo não é constante. -/\ntheorem os_pesos_da_queda_nao_sao_todos_iguais [Nonempty X] (custo : X → ℕ) (s₀ : ℝ)\n    (hs : s₀ ≠ 0) (hc : ∃ x y, custo x ≠ custo y) :\n    ∃ i j, pesoDeGibbs custo s₀ i ≠ pesoDeGibbs custo s₀ j := by\n  obtain ⟨x, y, hxy⟩ := hc\n  refine ⟨x, y, ?_⟩\n  intro h\n  unfold pesoDeGibbs at h\n  have hZ : particao custo s₀ ≠ 0 := (particao_pos custo s₀).ne\'\n  have h1 : Real.exp (-(s₀ * (custo x : ℝ))) = Real.exp (-(s₀ * (custo y : ℝ))) :=\n    (div_left_inj\' hZ).mp h\n  have h2 : -(s₀ * (custo x : ℝ)) = -(s₀ * (custo y : ℝ)) := Real.exp_injective h1\n  have h3 : (custo x : ℝ) = (custo y : ℝ) := by\n    have h4 : s₀ * (custo x : ℝ) = s₀ * (custo y : ℝ) := neg_inj.mp h2\n    exact mul_left_cancel₀ hs h4\n  exact hxy (Nat.cast_injective h3)\n\n/-- ★ K4b. O acoplamento da queda é positivo: se `s₀ ≠ 0` e o custo não é constante,\n    `0 < gibbsCoupling (pesoDeGibbs custo s₀)`. Usa `modular_variance_positive` (a hipótese dele é\n    que os pesos não sejam todos iguais, provada em `os_pesos_da_queda_nao_sao_todos_iguais`). -/\ntheorem o_acoplamento_da_queda_e_positivo [Nonempty X] (custo : X → ℕ) (s₀ : ℝ)\n    (hs : s₀ ≠ 0) (hc : ∃ x y, custo x ≠ custo y) :\n    0 < gibbsCoupling (pesoDeGibbs custo s₀) :=\n  div_pos (modular_variance_positive (pesoDeGibbs custo s₀) (pesoDeGibbs_pos custo s₀)\n    (pesos_de_gibbs_somam_um custo s₀) (os_pesos_da_queda_nao_sao_todos_iguais custo s₀ hs hc))\n    Real.pi_pos\n\n/-- K4c-i. Dado o balanço `eta · (a + c) = 2π · gibbsCoupling`, o erro de área da queda\n    tende a zero pela esquerda em TODO ponto `x` e em TODA direção nula `d` (qualquer tela `P` do\n    kernel na onda plana), com a frequência `covectorRead waveCovector d`. Os dois lados do\n    `gibbs_area_matching_iff_ricci` são proporcionais a `(covectorRead waveCovector d)²`\n    (`wave_ricci_quad`, `wave_matter_quad`). -/\ntheorem o_balanco_da_queda_em_todo_ponto_e_direcao_nula [Nonempty X] (a c : ℝ) (custo : X → ℕ)\n    (s₀ eta : ℝ) (hbal : eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀))\n    (x d : Coordinate4)\n    (P : EquilibriumScreenData univ (frameMetricField (waveSolder a c))\n      (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x d)\n    (hn : tensorQuad (frameMetricField (waveSolder a c) x) d = 0) :\n    Tendsto (fun t => ((entropiaDaQueda custo\n        (s₀ * (1 + (covectorRead waveCovector d * t) ^ 2)) - entropiaDaQueda custo s₀)\n        - eta * (inducedArea (frameMetricField (waveSolder a c)) P.curve P.screen.vectors t\n          - inducedArea (frameMetricField (waveSolder a c)) P.curve P.screen.vectors 0)) / t ^ 2)\n      (𝓝[<] 0) (𝓝 0) := by\n  have hG : SmoothConnectionOn univ (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) := by\n    rw [wave_levi_civita]\n    exact wave_connection_smooth a c\n  have ht : ∀ i j k, frameLeviCivita (waveSolder a c) (waveInverseSolder a c) x i k j =\n      frameLeviCivita (waveSolder a c) (waveInverseSolder a c) x j k i := by\n    rw [wave_levi_civita]\n    exact wave_connection_torsion_free a c x\n  have h := (o_balanco_de_area_da_queda_e_ricci P\n    (inverseFrameMetricField (waveInverseSolder a c)) waveCovectorField custo s₀ eta isOpen_univ\n    (frame_metric_smooth univ _ (wave_solder_smooth a c)) hG ht hn).2\n  refine h ?_\n  change eta * tensorQuad (coordinateRicci\n      (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x) d\n    = 2 * Real.pi * tensorQuad (waveMatter a c (gibbsCoupling (pesoDeGibbs custo s₀)) x) d\n  rw [wave_ricci_quad, wave_matter_quad]\n  linear_combination (covectorRead waveCovector d) ^ 2 * hbal\n\n/-- ★★ K4c. EXISTE UMA ONDA PLANA QUE CASA COM A QUEDA. Para `eta ≠ 0`, `s₀ ≠ 0` e custo\n    não constante existem `a c` com `a + c ≠ 0` e `a ≠ 0` tais que:\n    (1) `eta · (a + c) = 2π · gibbsCoupling (pesoDeGibbs custo s₀)` (o balanço de K4a);\n    (2) a curvatura da onda é não nula em todo ponto (`coordinateCurvature … x 1 0 ≠ 0`: é a\n        componente (1,0,1,0) do Riemann, igual a `a`; o Ricci não nulo vem de `a + c ≠ 0`);\n    (3) a fonte `waveMatter` com o acoplamento da queda é não nula em todo ponto;\n    (4) o erro de área da queda tende a zero pela esquerda na tela da origem (K4a);\n    (5) em todo ponto `x` e direção nula `d ≠ 0` existe tela do kernel (`localEquilibriumScreen`) e,\n        para qualquer tela `P`, o mesmo limite vale (K4c-i).\n    NÃO é derivação: o perfil `(a, c)` é ESCOLHIDO (`a = c = π·acoplamento/eta`, cisalhamento zero)\n    para que o balanço valha; é existência por escolha: a condição do lado direito de K4a é\n    satisfatível com curvatura e fonte não nulas. `eta` não tem restrição de sinal; para `eta < 0`\n    o perfil é negativo e o exemplo é só formal. -/\ntheorem existe_onda_plana_que_casa_com_a_queda [Nonempty X] (custo : X → ℕ) (s₀ eta : ℝ)\n    (heta : eta ≠ 0) (hs : s₀ ≠ 0) (hc : ∃ x y, custo x ≠ custo y) :\n    ∃ a c : ℝ, a + c ≠ 0 ∧ a ≠ 0 ∧\n      eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀) ∧\n      (∀ x : Coordinate4,\n        coordinateCurvature (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x 1 0 ≠ 0) ∧\n      (∀ x : Coordinate4, waveMatter a c (gibbsCoupling (pesoDeGibbs custo s₀)) x ≠ 0) ∧\n      Tendsto (fun t => ((entropiaDaQueda custo (s₀ * (1 + t ^ 2)) - entropiaDaQueda custo s₀)\n        - eta * (inducedArea (frameMetricField (waveSolder a c)) (waveOriginScreen a c).curve\n            (waveOriginScreen a c).screen.vectors t\n          - inducedArea (frameMetricField (waveSolder a c)) (waveOriginScreen a c).curve\n            (waveOriginScreen a c).screen.vectors 0)) / t ^ 2) (𝓝[<] 0) (𝓝 0) ∧\n      (∀ x d : Coordinate4, d ≠ 0 → tensorQuad (frameMetricField (waveSolder a c) x) d = 0 →\n        Nonempty (EquilibriumScreenData univ (frameMetricField (waveSolder a c))\n          (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x d) ∧\n        ∀ P : EquilibriumScreenData univ (frameMetricField (waveSolder a c))\n          (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x d,\n          Tendsto (fun t => ((entropiaDaQueda custo\n            (s₀ * (1 + (covectorRead waveCovector d * t) ^ 2)) - entropiaDaQueda custo s₀)\n            - eta * (inducedArea (frameMetricField (waveSolder a c)) P.curve P.screen.vectors t\n              - inducedArea (frameMetricField (waveSolder a c)) P.curve P.screen.vectors 0))\n            / t ^ 2) (𝓝[<] 0) (𝓝 0)) := by\n  have hk : 0 < gibbsCoupling (pesoDeGibbs custo s₀) :=\n    o_acoplamento_da_queda_e_positivo custo s₀ hs hc\n  set k := gibbsCoupling (pesoDeGibbs custo s₀) with hkdef\n  have ha : Real.pi * k / eta ≠ 0 :=\n    div_ne_zero (mul_ne_zero Real.pi_ne_zero hk.ne\') heta\n  have hbal : eta * (Real.pi * k / eta + Real.pi * k / eta) = 2 * Real.pi * k := by\n    field_simp\n    ring\n  have hsum : Real.pi * k / eta + Real.pi * k / eta ≠ 0 := by\n    intro h0\n    rw [h0, mul_zero] at hbal\n    exact (mul_ne_zero (mul_ne_zero two_ne_zero Real.pi_ne_zero) hk.ne\') hbal.symm\n  refine ⟨Real.pi * k / eta, Real.pi * k / eta, hsum, ha, hbal, ?_, ?_, ?_, ?_⟩\n  · intro x\n    exact wave_curvature_nonzero _ _ ha x\n  · intro x\n    exact wave_matter_nonzero _ _ _ hk.ne\' x\n  · exact (o_balanco_de_area_da_queda_na_onda_plana _ _ custo s₀ eta).mpr hbal\n  · intro x d hd hn\n    refine ⟨⟨localEquilibriumScreen univ isOpen_univ _ _\n      (fun y _ => wave_solder_inverse _ _ y) (fun y _ => wave_inverse_solder _ _ y)\n      (wave_solder_smooth _ _) (wave_inverse_solder_smooth _ _) x d (mem_univ _) hd hn⟩, ?_⟩\n    intro P\n    exact o_balanco_da_queda_em_todo_ponto_e_direcao_nula _ _ custo s₀ eta hbal x d P hn\n\nend K4ondaPlana\n\n/-! ## PARTE 4 — K5: a equação de campo da queda numa onda plana (construção de um EXEMPLO)\n\nO QUE A PARTE 4 É, SEM ENFEITE:\n\n* é CONSTRUÇÃO DE EXEMPLO dentro de um ansatz: a onda plana do kernel, `waveSolder a c`. O perfil\n  `(a, c)` é ESCOLHIDO para que o balanço de área da queda valha (PARTE 3, K4); logo a lei de área\n  vale por ESCOLHA, no exemplo;\n* NESTE EXEMPLO a lei de área e a equação de campo saem da MESMA\n  condição escalar em `a + c`, o balanço `eta · (a + c) = 2π · acoplamento`, lida duas vezes. Na tela\n  da origem a lei de área EQUIVALE a ele (K4a). E, com ele, o tensor de Einstein da onda,\n  `(a + c) • w ⊗ w` (`wave_einstein`), IGUALA a fonte, `(2π/eta) • acoplamento • w ⊗ w`\n  (`wave_matter_formula`), com `w = waveCovector`, por cálculo direto (K5c-i; a recíproca, que pede\n  `w ⊗ w ≠ 0`, não é enunciada neste arquivo). Logo K5a é consequência imediata de K5c-i com\n  `Λ = 0`, e o teorema de área do kernel NÃO é necessário para obtê-la. A prova de K5a pelo kernel\n  (`einstein_from_gibbs_area_matching`, de `GibbsMatterBridge`: o casamento de área (Gibbs) em todo\n  ponto e direção nula, com as hipóteses laterais do kernel, dá Einstein com `Λ`) é uma SEGUNDA rota\n  para a mesma equação (molde: `matched_wave_einstein_from_area`, da família de amplitude). O que\n  K5a e K5b acrescentam é NÃO-VACUIDADE: as hipóteses desse teorema do kernel ficam habitadas\n  juntas, num exemplo com curvatura e fonte não nulas. NÃO se explica aqui a equação de campo pela\n  lei de área;\n* CASO DEGENERADO: K5a não exclui `a + c = 0` com acoplamento `0`. Aí o balanço é\n  `0 = 0`, o tensor de Einstein e a fonte são nulos, e K5a vale de forma trivial. A testemunha de\n  não-vacuidade é só K5b, que pede `s₀ ≠ 0` e custo não constante (acoplamento positivo, K4b) e\n  entrega `a + c ≠ 0`;\n* é EXISTÊNCIA POR ESCOLHA. NÃO é derivação da geometria a partir da queda; NÃO é a lei de área em\n  geral; NÃO é `NamedAtlasH3` (outro tipo: registro de probabilidades, preparação da bancada); NÃO é\n  a seta H3 do fecho. A hipótese de área do teorema do kernel é fornecida aqui pela PARTE 3\n  (`o_balanco_da_queda_em_todo_ponto_e_direcao_nula`), que por sua vez tem o balanço como hipótese;\n* o relógio quadrático `s = s₀(1 + t²)` e o acoplamento `gibbsCoupling` (variância modular sobre π)\n  são os DEFINIDOS pelo kernel, não derivados da queda (ver K3 e K4);\n* `eta` não tem restrição de sinal. Para `eta < 0` o perfil sai negativo e o exemplo é só formal;\n  a leitura de energia positiva seria a de `eta > 0` e NÃO é provada aqui;\n* K5c (o valor de `Λ`): no exemplo o tensor de Einstein da onda IGUALA a fonte (cálculo direto, sem o\n  teorema do kernel), de modo que `Λ = 0` é o único valor possível. O motivo\n  estrutural é o TRAÇO NULO: Einstein e fonte são múltiplos de `w ⊗ w`, com `w` nulo para a métrica\n  inversa (`wave_inverse_metric_null`; a curvatura escalar da onda é `0`, `wave_scalar_curvature`),\n  ao passo que o traço de `Λ • g` é `4Λ`. Isto é comentário: o que o arquivo PROVA é o se-e-só-se de\n  K5c, e o passo usado na ida é só que a métrica na origem é `eta4`, não nula. É propriedade do\n  ansatz (onda plana com o balanço), não uma previsão do kernel para a constante cosmológica.\n\nβ_TGL não aparece. O gate não se move. Sem sorry, sem axiom. -/\n\nsection K5campo\n\nopen Filter Topology Matrix Set TGLExt ChatgptAudit ChatgptAudit.Coherent023 ChatgptAudit.Response028\n  ChatgptAudit.Flow019 ChatgptAudit.Flow020 ChatgptAudit.Micro021 ChatgptAudit.Profile026\n  ChatgptAudit.Thermal024 ChatgptAudit.Thermal025 ChatgptAudit.Wave029\n\n/-- ★★ K5a. A EQUAÇÃO DE CAMPO DA QUEDA NA ONDA PLANA. Dado `eta ≠ 0` e o balanço\n    `eta · (a + c) = 2π · gibbsCoupling (pesoDeGibbs custo s₀)`, existe `Λ` tal que, em todo ponto da\n    onda plana `waveSolder a c`,\n    `Einstein + Λ • g = (2π/eta) • frameCovectorStress … waveCovectorField (gibbsCoupling (pesoDeGibbs custo s₀))`.\n    É `einstein_from_gibbs_area_matching` do kernel instanciado (taxa `1`; conexidade de `univ`;\n    suavidade, fechamento e onda do covetor da onda plana vindos do kernel); a hipótese de área em\n    todo ponto e direção nula vem de `o_balanco_da_queda_em_todo_ponto_e_direcao_nula`, com o erro de\n    área da curva quadrática de Gibbs escrito pela entropia da queda\n    (`o_erro_de_area_da_curva_quadratica_da_queda`). Construção de exemplo: o perfil entra por\n    hipótese (o balanço); NÃO é derivação nem a lei de área em geral. É também\n    consequência imediata de K5c-i (`o_einstein_da_onda_e_a_fonte_da_queda`) com `Λ = 0`: a prova\n    abaixo, pelo teorema do kernel, é uma SEGUNDA rota, e o que ela mostra é que as hipóteses de\n    `einstein_from_gibbs_area_matching` ficam habitadas neste exemplo (não-vacuidade), não que a\n    equação de campo se explique pela lei de área. No caso degenerado (`a + c = 0`, acoplamento `0`)\n    vale de forma trivial. β_TGL não aparece. -/\ntheorem a_equacao_de_campo_da_queda_na_onda_plana [Nonempty X] (a c : ℝ) (custo : X → ℕ)\n    (s₀ eta : ℝ) (heta : eta ≠ 0)\n    (hbal : eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀)) :\n    ∃ cosmological : ℝ, ∀ x ∈ (univ : Set Coordinate4),\n      frameEinsteinTensor (waveSolder a c) (waveInverseSolder a c) x +\n        cosmological • frameMetricField (waveSolder a c) x =\n      (2 * Real.pi / eta) • frameCovectorStress (waveSolder a c) (waveInverseSolder a c)\n        waveCovectorField (gibbsCoupling (pesoDeGibbs custo s₀)) x := by\n  apply einstein_from_gibbs_area_matching univ isOpen_univ isPreconnected_univ\n    (waveSolder a c) (waveInverseSolder a c) waveCovectorField (pesoDeGibbs custo s₀)\n    (pesoDeGibbs_pos custo s₀) (pesos_de_gibbs_somam_um custo s₀) 1 eta one_ne_zero heta\n    (fun x _ => wave_solder_inverse _ _ x) (fun x _ => wave_inverse_solder _ _ x)\n    (wave_solder_smooth _ _) (wave_inverse_solder_smooth _ _) wave_covector_smooth\n    wave_covector_closed (wave_covector_wave _ _)\n  intro x hx d hd hn\n  have h := o_balanco_da_queda_em_todo_ponto_e_direcao_nula a c custo s₀ eta hbal x d\n    (localEquilibriumScreen univ isOpen_univ (waveSolder a c) (waveInverseSolder a c)\n      (fun y _ => wave_solder_inverse a c y) (fun y _ => wave_inverse_solder a c y)\n      (wave_solder_smooth a c) (wave_inverse_solder_smooth a c) x d hx hd hn) hn\n  refine h.congr (fun t => ?_)\n  rw [o_erro_de_area_da_curva_quadratica_da_queda]\n  rfl\n\n/-- ★ K5b. EXISTE UMA ONDA PLANA COM A EQUAÇÃO DE CAMPO DA QUEDA. Para `eta ≠ 0`,\n    `s₀ ≠ 0` e custo não constante existem `a c` com `a + c ≠ 0` e `a ≠ 0` tais que:\n    (1) `eta · (a + c) = 2π · gibbsCoupling (pesoDeGibbs custo s₀)`;\n    (2) existe `Λ` com a equação de campo de K5a em todo ponto;\n    (3) a curvatura da onda é não nula em todo ponto (componente (1,0,1,0) do Riemann, igual a `a`);\n    (4) a fonte `waveMatter` com o acoplamento da queda é não nula em todo ponto;\n    (5) o lado direito da equação de campo, `(2π/eta) • frameCovectorStress …`, é não nulo em todo ponto.\n    É K4c (`existe_onda_plana_que_casa_com_a_queda`) mais K5a. NÃO é derivação: o perfil\n    `a = c = π · acoplamento / eta` é ESCOLHIDO para que o balanço valha; é existência por escolha no\n    ansatz da onda plana. `eta` sem restrição de sinal; para `eta < 0` é só formal. -/\ntheorem existe_onda_plana_com_a_equacao_de_campo_da_queda [Nonempty X] (custo : X → ℕ)\n    (s₀ eta : ℝ) (heta : eta ≠ 0) (hs : s₀ ≠ 0) (hc : ∃ x y, custo x ≠ custo y) :\n    ∃ a c : ℝ, a + c ≠ 0 ∧ a ≠ 0 ∧\n      eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀) ∧\n      (∃ cosmological : ℝ, ∀ x ∈ (univ : Set Coordinate4),\n        frameEinsteinTensor (waveSolder a c) (waveInverseSolder a c) x +\n          cosmological • frameMetricField (waveSolder a c) x =\n        (2 * Real.pi / eta) • frameCovectorStress (waveSolder a c) (waveInverseSolder a c)\n          waveCovectorField (gibbsCoupling (pesoDeGibbs custo s₀)) x) ∧\n      (∀ x : Coordinate4,\n        coordinateCurvature (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x 1 0 ≠ 0) ∧\n      (∀ x : Coordinate4, waveMatter a c (gibbsCoupling (pesoDeGibbs custo s₀)) x ≠ 0) ∧\n      (∀ x : Coordinate4,\n        (2 * Real.pi / eta) • frameCovectorStress (waveSolder a c) (waveInverseSolder a c)\n          waveCovectorField (gibbsCoupling (pesoDeGibbs custo s₀)) x ≠ 0) := by\n  obtain ⟨a, c, hsum, ha, hbal, hcurv, hmat, _, _⟩ :=\n    existe_onda_plana_que_casa_com_a_queda custo s₀ eta heta hs hc\n  refine ⟨a, c, hsum, ha, hbal, a_equacao_de_campo_da_queda_na_onda_plana a c custo s₀ eta heta hbal,\n    hcurv, hmat, ?_⟩\n  intro x\n  exact smul_ne_zero (div_ne_zero (mul_ne_zero two_ne_zero Real.pi_ne_zero) heta) (hmat x)\n\n/-- K5c-i. Com o balanço, o tensor de Einstein da onda plana IGUALA a fonte da queda, em\n    todo ponto: `Einstein x = (2π/eta) • frameCovectorStress … x`. Cálculo direto\n    (`wave_einstein`, `wave_matter_formula`); não usa `einstein_from_gibbs_area_matching`. -/\ntheorem o_einstein_da_onda_e_a_fonte_da_queda [Nonempty X] (a c : ℝ) (custo : X → ℕ) (s₀ eta : ℝ)\n    (heta : eta ≠ 0)\n    (hbal : eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀)) (x : Coordinate4) :\n    frameEinsteinTensor (waveSolder a c) (waveInverseSolder a c) x =\n      (2 * Real.pi / eta) • frameCovectorStress (waveSolder a c) (waveInverseSolder a c)\n        waveCovectorField (gibbsCoupling (pesoDeGibbs custo s₀)) x := by\n  change frameEinsteinTensor (waveSolder a c) (waveInverseSolder a c) x =\n    (2 * Real.pi / eta) • waveMatter a c (gibbsCoupling (pesoDeGibbs custo s₀)) x\n  rw [wave_einstein, wave_matter_formula, smul_smul]\n  congr 1\n  field_simp\n  linarith\n\n/-- ★ K5c. O VALOR DE `Λ` NO EXEMPLO É `0`, e só `0`. Sob o balanço, a equação de campo\n    com `Λ` vale em todo ponto se, e só se, `Λ = 0`. A ida usa o ponto da origem, onde a métrica é\n    `eta4` (`wave_metric_at_origin`), não nula: esse é o PASSO da prova. O motivo\n    estrutural é o traço nulo: Einstein e fonte são múltiplos de `w ⊗ w` com `w` nulo\n    (`wave_inverse_metric_null`), e o traço de `Λ • g` é `4Λ` (comentário, não enunciado aqui). É\n    propriedade do ansatz (onda plana com o balanço), não uma previsão do kernel para a constante\n    cosmológica. Em particular o `Λ` de K5a é `0`. -/\ntheorem o_lambda_da_queda_na_onda_plana_e_zero [Nonempty X] (a c : ℝ) (custo : X → ℕ) (s₀ eta : ℝ)\n    (heta : eta ≠ 0)\n    (hbal : eta * (a + c) = 2 * Real.pi * gibbsCoupling (pesoDeGibbs custo s₀))\n    (cosmological : ℝ) :\n    (∀ x ∈ (univ : Set Coordinate4),\n      frameEinsteinTensor (waveSolder a c) (waveInverseSolder a c) x +\n        cosmological • frameMetricField (waveSolder a c) x =\n      (2 * Real.pi / eta) • frameCovectorStress (waveSolder a c) (waveInverseSolder a c)\n        waveCovectorField (gibbsCoupling (pesoDeGibbs custo s₀)) x) ↔ cosmological = 0 := by\n  constructor\n  · intro h\n    have h0 := h 0 (mem_univ _)\n    rw [o_einstein_da_onda_e_a_fonte_da_queda a c custo s₀ eta heta hbal 0,\n      wave_metric_at_origin] at h0\n    have h1 : cosmological • (eta4 : Tensor4) = 0 := by\n      simpa using h0\n    have h2 := congrArg (fun M : Tensor4 => M 1 1) h1\n    simpa [eta4] using h2\n  · intro h x _\n    subst h\n    rw [zero_smul, add_zero]\n    exact o_einstein_da_onda_e_a_fonte_da_queda a c custo s₀ eta heta hbal x\n\nend K5campo\n\nend\n\nend TGLExt.EquacaoDeCampoDaQuedaNaOndaPlana\n',
+    'TGLExt/ADirecaoEDado.lean': "import TGLExt.PlaneWaveMatter\nimport TGLExt.TracialDissipativeTorsion\nimport TGLExt.TheVerbalCoupling\n\nset_option autoImplicit false\nset_option linter.unusedVariables false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 8000000\nset_option maxRecDepth 4096\n\n/-!\n# A DIREÇÃO É DADO (fiação de conta elementar)\n\nO QUE É. A torção tracial do kernel (`TGLExt.TracialTorsion`) na métrica PLANA, com o vetor da torção\ntratado como DADO: um covetor A qualquer, CONSTANTE em x, e não a direção de uma onda escolhida. A\nmétrica é plana; a conexão com torção NÃO é (tem curvatura). Três blocos:\n* para todo dado A, na geometria em coordenadas do kernel: Ricci = 2·(A⊗A − N·eta4), escalar = −6·N e\n  Einstein = 2·A⊗A + N·eta4, com N = A·A o tamanho do dado; o termo proporcional à métrica some se, e\n  só se, N = 0 (dado nulo, inclusive o dado zero). O conteúdo está em T5; T6 só lê uma entrada de eta4;\n* sem referente: escrito como amplitude vezes direção, um covetor tem todas as amplitudes positivas, e\n  só elas. Essa folga é de QUALQUER direção, não só da luz. O que distingue a\n  luz é que ela não tem tamanho próprio (N = 0 para toda reescala): quando a direção tem tamanho 1, a\n  métrica fixa a amplitude a menos do sinal (mu² = N); ao longo da onda não fixa. Com um referente n\n  que normaliza a direção (w·n = 1), a amplitude é uma só, A·n: é álgebra linear de uma linha, a\n  amplitude é RELATIVA ao n escolhido, e n é dado de fora, não derivado aqui (trocar n troca a\n  amplitude);\n* observador: reescalar a direção por s leva a amplitude a lam/s e a escala a s·ell; o produto fica.\n  É identidade de corpo: com a amplitude da Ponte, thetaMiguel β / (3·ell), o produto é\n  thetaMiguel β / 3 por DEFINIÇÃO da amplitude. Nenhum teorema liga a escala da direção ao ell da\n  Ponte, e a palavra fase não é definida neste arquivo.\n\nANALOGIAS NO KERNEL (analogias de forma, não espelhos; nenhuma é usada nas provas, e não há lema\nque as ligue a este arquivo): `invariance_does_not_fix_area` (lote 045: sob as hipóteses de lá, a\ncovariância sozinha não seleciona um valor comum de área; o teorema exibe a escala 2, e a família de\ntodas as escalas positivas vem de `form_invariant_scale` e `scaled_form_areas_distinct`);\n`the_unit_is_the_axiom` (v334: o traço 1 no par fixa a forma e a área ½); `the_word_fixes_the_place`\n(v334) e `the_bireference_of_the_name` (v292), em que referente é a leitura que separa: aqui referente\né só um vetor n com w·n = 1 (homônimo; não encadear); `the_angle_reaches_the_metric` (reescreve β como\nsen²θ_M no fator de entropia de FLRW; aqui o ângulo entra linear, pela amplitude).\n\nO QUE NÃO É.\n* Não trata os infinitos da teoria de campos nem renormalização: é álgebra elementar deste exemplo.\n  T8 a T10 são álgebra de corpo e linear; o que contam é o que é dado e o que é referente, não prova nova.\n* Não é o teorema de área (que não é torção: usa conexão simétrica e área métrica).\n* Não define o Hamiltoniano oculto: o dado é um covetor A (ou um vetor n) qualquer.\n* Não deriva o tamanho do dado nem o liga a β; o valor de thetaMiguel β só aparece como o produto\n  preservado, por definição da amplitude da Ponte.\n* Não prova a compatibilidade métrica da conexão (vem de `contortion_metric_compatible` do kernel);\n  que `eta4` é a própria inversa está em `eta4_mul_self` (`PoincareGroup.lean`), citado e não usado.\n* Não é `NamedAtlasH3` nem deriva a seta `hH3`. Validade no kernel não é creditação.\n\n-/\n\nnamespace TGLExt.ADirecaoEDado\n\nopen Filter Topology Matrix Set TGLExt ChatgptAudit ChatgptAudit.Coherent023 ChatgptAudit.Response028\n  ChatgptAudit.Wave029\n\nnoncomputable section\n\n/-! ## D1, D2 — a conexão e o tamanho do dado -/\n\n/-- A métrica de Minkowski do kernel é simétrica (auxiliar; copiado do molde). -/\ntheorem eta4_simetrica (i j : Fin 4) : eta4 i j = eta4 j i := by\n  fin_cases i <;> fin_cases j <;>\n    norm_num [eta4, Matrix.diagonal_apply, Matrix.cons_val_two, Matrix.cons_val_three,\n      Fin.isValue]\n\n/-- D1. A conexão com a torção tracial ao longo de um DADO A (covetor qualquer, constante),\n    sobre a métrica plana: `Gamma x i r j` é Γ^r_{ij} (i é a direção da derivada),\n    `Γ^r_{ij} = δ^r_i A_j − eta4 i j · A^r` com `A^r = ∑ d, eta4 r d · A d`. É constante em x.\n    A métrica é plana; esta conexão não é: tem curvatura (T3). -/\ndef conexaoDoDadoNaMetricaPlana (A : Coordinate4) : ConnectionField4 :=\n  fun _ i r j => TGLExt.TracialTorsion.kd r i * A j - eta4 i j * (∑ d, eta4 r d * A d)\n\n/-- D2. O tamanho do dado: `N = A·A = tensorQuad eta4 A`. -/\ndef tamanhoDoDado (A : Coordinate4) : ℝ := tensorQuad eta4 A\n\n/-! ## T0, T1, T2 — a fiação com `TGLExt.TracialTorsion` -/\n\n/-- T0. A conexão do dado é, ponto a ponto, a contorção `Kmix` do kernel\n    (`TGLExt.TracialTorsion`) aplicada à métrica `eta4` e à sua inversa (que é a própria `eta4`:\n    `eta4_mul_self`, no kernel; citado, não usado). -/\ntheorem a_conexao_do_dado_e_a_contorcao_do_kernel (A : Coordinate4) (x : Coordinate4) (i r j : Fin 4) :\n    conexaoDoDadoNaMetricaPlana A x i r j =\n      TGLExt.TracialTorsion.Kmix (fun p q => eta4 p q) (fun p q => eta4 p q) A r i j := by\n  unfold conexaoDoDadoNaMetricaPlana TGLExt.TracialTorsion.Kmix TGLExt.TracialTorsion.raise\n  rfl\n\n/-- T1. A torção da conexão do dado é a torção tracial do kernel:\n    `Γ^r_{ij} − Γ^r_{ji} = T^r_{ij}`. -/\ntheorem a_torcao_do_dado_e_a_tracial (A : Coordinate4) (x : Coordinate4) (i r j : Fin 4) :\n    conexaoDoDadoNaMetricaPlana A x i r j - conexaoDoDadoNaMetricaPlana A x j r i =\n      TGLExt.TracialTorsion.torsion A r i j := by\n  unfold conexaoDoDadoNaMetricaPlana TGLExt.TracialTorsion.torsion\n  rw [eta4_simetrica i j]\n  ring\n\n/-- T2. O tamanho do dado é a norma do kernel (`TGLExt.TracialTorsion.normSq`) com a métrica\n    inversa `eta4`. -/\ntheorem o_tamanho_do_dado_e_a_norma_do_kernel (A : Coordinate4) :\n    tamanhoDoDado A = TGLExt.TracialTorsion.normSq (fun p q => eta4 p q) A := by\n  unfold tamanhoDoDado tensorQuad TGLExt.TracialTorsion.normSq TGLExt.TracialTorsion.raise\n  simp [dotProduct, Matrix.mulVec, mul_comm]\n\n/-- T2, em componentes: `N = A0² − A1² − A2² − A3²`. -/\ntheorem o_tamanho_do_dado_em_componentes (A : Coordinate4) :\n    tamanhoDoDado A = A 0 ^ 2 - A 1 ^ 2 - A 2 ^ 2 - A 3 ^ 2 := by\n  unfold tamanhoDoDado tensorQuad\n  norm_num [dotProduct, Matrix.mulVec, Fin.sum_univ_four, eta4, Matrix.diagonal_apply,\n    Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue]\n  ring\n\n/-- O tamanho é QUADRÁTICO na amplitude: `N(c • v) = c² · N(v)`. -/\ntheorem o_tamanho_e_homogeneo (c : ℝ) (v : Coordinate4) :\n    tamanhoDoDado (c • v) = c ^ 2 * tamanhoDoDado v := by\n  rw [o_tamanho_do_dado_em_componentes, o_tamanho_do_dado_em_componentes]\n  simp only [Pi.smul_apply, smul_eq_mul]\n  ring\n\n/-! ## T3, T4, T5, T6 — o Ricci, o escalar e o Einstein do dado -/\n\n/-- Uma conexão constante tem jato nulo (copiado do molde, para o dado). -/\ntheorem o_jato_da_conexao_do_dado (A : Coordinate4) (x : Coordinate4) (k i : Fin 4) :\n    connectionFirstJet (conexaoDoDadoNaMetricaPlana A) x k i = 0 := by\n  ext r j\n  simp [connectionFirstJet, tensorFieldJet, coordinatePartial, conexaoDoDadoNaMetricaPlana]\n\n/-- T3 ★. O Ricci do dado: `2·(A⊗A − N·eta4)`. -/\ntheorem o_ricci_do_dado (A : Coordinate4) (x : Coordinate4) :\n    coordinateRicci (conexaoDoDadoNaMetricaPlana A) x =\n      (2 : ℝ) • (Matrix.vecMulVec A A - tamanhoDoDado A • eta4) := by\n  obtain ⟨a0, a1, a2, a3, rfl⟩ : ∃ a0 a1 a2 a3 : ℝ, A = ![a0, a1, a2, a3] :=\n    ⟨A 0, A 1, A 2, A 3, by ext i; fin_cases i <;> rfl⟩\n  rw [o_tamanho_do_dado_em_componentes]\n  ext b j\n  simp only [coordinateRicci, coordinateCurvature, connectionCurvatureJet, Matrix.sub_apply,\n    Matrix.add_apply, Matrix.mul_apply, Fin.sum_univ_four, o_jato_da_conexao_do_dado,\n    Matrix.zero_apply]\n  fin_cases b <;> fin_cases j <;>\n    norm_num [conexaoDoDadoNaMetricaPlana, eta4, TGLExt.TracialTorsion.kd, Matrix.vecMulVec,\n      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.diagonal_apply, Fin.isValue] <;>\n    norm_num [Fin.ext_iff] <;> ring\n\n/-- T4. O escalar do dado: `−6·N`. -/\ntheorem o_escalar_do_dado (A : Coordinate4) (x : Coordinate4) :\n    coordinateScalarCurvature (fun _ => eta4) (conexaoDoDadoNaMetricaPlana A) x =\n      -6 * tamanhoDoDado A := by\n  rw [o_tamanho_do_dado_em_componentes]\n  simp only [coordinateScalarCurvature, o_ricci_do_dado, o_tamanho_do_dado_em_componentes]\n  norm_num [Fin.sum_univ_four, eta4, Matrix.vecMulVec, Matrix.cons_val_two,\n    Matrix.cons_val_three, Matrix.diagonal_apply, Fin.isValue]\n  ring\n\n/-- T5 ★★. O Einstein do dado em métrica plana: `2·A⊗A + N·eta4`. -/\ntheorem o_einstein_do_dado (A : Coordinate4) (x : Coordinate4) :\n    geometricEinsteinTensor (fun _ => eta4) (fun _ => eta4) (conexaoDoDadoNaMetricaPlana A) x =\n      (2 : ℝ) • Matrix.vecMulVec A A + tamanhoDoDado A • eta4 := by\n  unfold geometricEinsteinTensor\n  rw [o_escalar_do_dado, o_ricci_do_dado]\n  ext b j\n  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]\n  ring\n\n/-- T6 ★★. O termo proporcional à métrica some se, e só se, `N = 0` (dado nulo, inclusive o\n    dado zero): o Einstein do dado é `2·A⊗A` exatamente quando `tamanhoDoDado A = 0`.\n    O conteúdo é T5; aqui só se lê a entrada (0,0) de `eta4`. -/\ntheorem o_termo_da_metrica_some_sse_o_dado_e_luz (A : Coordinate4) (x : Coordinate4) :\n    geometricEinsteinTensor (fun _ => eta4) (fun _ => eta4) (conexaoDoDadoNaMetricaPlana A) x =\n        (2 : ℝ) • Matrix.vecMulVec A A ↔ tamanhoDoDado A = 0 := by\n  rw [o_einstein_do_dado]\n  constructor\n  · intro h\n    have hh := congrArg (fun M : Tensor4 => M 0 0) h\n    simpa [eta4] using hh\n  · intro h\n    rw [h]\n    simp\n\n/-! ## T7 — os casos: ao longo da onda e ao longo do tempo -/\n\n/-- O covetor temporal `n = (1, 0, 0, 0)` (copiado do molde). -/\ndef nTemporal : Coordinate4 := ![1, 0, 0, 0]\n\n/-- T7. O dado ao longo da onda é luz (`N = 0`) e o Einstein é `2·lam²·w⊗w`. -/\ntheorem o_dado_ao_longo_da_onda (lam : ℝ) (x : Coordinate4) :\n    tamanhoDoDado (lam • waveCovector) = 0 ∧\n    geometricEinsteinTensor (fun _ => eta4) (fun _ => eta4)\n      (conexaoDoDadoNaMetricaPlana (lam • waveCovector)) x =\n        (2 * lam ^ 2) • Matrix.vecMulVec waveCovector waveCovector := by\n  have hN : tamanhoDoDado (lam • waveCovector) = 0 := by\n    rw [o_tamanho_do_dado_em_componentes]\n    norm_num [waveCovector, Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue]\n  refine ⟨hN, ?_⟩\n  rw [o_einstein_do_dado, hN]\n  ext b j\n  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul,\n    zero_mul, add_zero]\n  ring\n\n/-- T7 (controle). O dado ao longo do tempo tem `N = alfa²` e o Einstein é\n    `2·alfa²·n⊗n + alfa²·eta4`: aparece o termo proporcional à métrica. -/\ntheorem o_dado_ao_longo_do_tempo (alfa : ℝ) (x : Coordinate4) :\n    tamanhoDoDado (alfa • nTemporal) = alfa ^ 2 ∧\n    geometricEinsteinTensor (fun _ => eta4) (fun _ => eta4)\n      (conexaoDoDadoNaMetricaPlana (alfa • nTemporal)) x =\n        (2 * alfa ^ 2) • Matrix.vecMulVec nTemporal nTemporal + alfa ^ 2 • eta4 := by\n  have hN : tamanhoDoDado (alfa • nTemporal) = alfa ^ 2 := by\n    rw [o_tamanho_do_dado_em_componentes]\n    norm_num [nTemporal, Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue]\n  refine ⟨hN, ?_⟩\n  rw [o_einstein_do_dado, hN]\n  ext b j\n  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, Pi.smul_apply, smul_eq_mul]\n  ring\n\n/-! ## T8 — sem referente, toda amplitude positiva serve -/\n\n/-- T8. Sem referente: para qualquer amplitude positiva `mu` existe uma escala positiva `s`\n    tal que `mu • (s • w) = lam • w`: o MESMO covetor ao longo da onda tem todas as amplitudes.\n    A prova não usa que a direção é nula: vale para qualquer vetor no lugar de `waveCovector`. O\n    que é próprio da luz está em `a_luz_nao_tem_tamanho_proprio`, mais abaixo. -/\ntheorem sem_referente_toda_amplitude_positiva_serve (lam mu : ℝ) (hlam : 0 < lam) (hmu : 0 < mu) :\n    ∃ s : ℝ, 0 < s ∧ mu • (s • waveCovector) = lam • waveCovector := by\n  refine ⟨lam / mu, div_pos hlam hmu, ?_⟩\n  rw [smul_smul]\n  congr 1\n  field_simp\n\n/-- T8. Sem referente, o conjunto das amplitudes não é limitado superiormente. -/\ntheorem as_amplitudes_sem_referente_nao_sao_limitadas (lam : ℝ) (hlam : 0 < lam) :\n    ¬ BddAbove {mu : ℝ | ∃ s : ℝ, 0 < s ∧ mu • (s • waveCovector) = lam • waveCovector} := by\n  rintro ⟨M, hM⟩\n  have hpos : 0 < max M 0 + 1 := by\n    have := le_max_right M 0\n    linarith\n  have hmem : max M 0 + 1 ∈\n      {mu : ℝ | ∃ s : ℝ, 0 < s ∧ mu • (s • waveCovector) = lam • waveCovector} :=\n    sem_referente_toda_amplitude_positiva_serve lam _ hlam hpos\n  have hle := hM hmem\n  have := le_max_left M 0\n  linarith\n\n/-- T8. Sem referente, as amplitudes chegam perto de zero. -/\ntheorem as_amplitudes_sem_referente_chegam_perto_de_zero (lam : ℝ) (hlam : 0 < lam) :\n    ∀ eps > 0, ∃ mu : ℝ, 0 < mu ∧ mu < eps ∧\n      ∃ s : ℝ, 0 < s ∧ mu • (s • waveCovector) = lam • waveCovector := by\n  intro eps heps\n  have hmu : 0 < eps / 2 := by positivity\n  exact ⟨eps / 2, hmu, by linarith, sem_referente_toda_amplitude_positiva_serve lam _ hlam hmu⟩\n\n/-- O conjunto das amplitudes sem referente é EXATAMENTE o dos reais positivos. -/\ntheorem as_amplitudes_sem_referente_sao_os_positivos (lam : ℝ) (hlam : 0 < lam) :\n    {mu : ℝ | ∃ s : ℝ, 0 < s ∧ mu • (s • waveCovector) = lam • waveCovector} = Set.Ioi 0 := by\n  ext mu\n  simp only [Set.mem_setOf_eq, Set.mem_Ioi]\n  constructor\n  · rintro ⟨s, hs, h⟩\n    have h0 := congrFun h 0\n    have hw : waveCovector 0 = 1 := by simp [waveCovector]\n    simp only [Pi.smul_apply, smul_eq_mul, hw, mul_one] at h0\n    by_contra hmu\n    have hmu' : mu ≤ 0 := not_lt.mp hmu\n    nlinarith [mul_nonneg (neg_nonneg.mpr hmu') hs.le]\n  · intro hmu\n    exact sem_referente_toda_amplitude_positiva_serve lam mu hlam hmu\n\n/-! ## T8b — o que é próprio da luz: ela não tem tamanho próprio -/\n\n/-- Quando a direção tem tamanho próprio (`N(v) = 1`), a MÉTRICA fixa a amplitude a\n    menos do sinal: `mu • v = A` implica `mu² = N(A)`. Não é preciso referente de fora. -/\ntheorem a_metrica_fixa_a_amplitude_se_nao_e_luz (v A : Coordinate4) (mu : ℝ)\n    (hv : tamanhoDoDado v = 1) (h : mu • v = A) : mu ^ 2 = tamanhoDoDado A := by\n  rw [← h, o_tamanho_e_homogeneo, hv, mul_one]\n\n/-- A luz não tem tamanho próprio: toda reescala do covetor da onda tem `N = 0`; logo\n    nenhuma reescala dele tem tamanho 1, e a métrica não fixa a amplitude ao longo da onda. -/\ntheorem a_luz_nao_tem_tamanho_proprio (s : ℝ) :\n    tamanhoDoDado (s • waveCovector) = 0 ∧ tamanhoDoDado (s • waveCovector) ≠ 1 := by\n  have h0 : tamanhoDoDado (s • waveCovector) = 0 := by\n    rw [o_tamanho_do_dado_em_componentes]\n    norm_num [waveCovector, Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue]\n  exact ⟨h0, by rw [h0]; norm_num⟩\n\n/-! ## T9 — com o referente, a amplitude é uma só -/\n\n/-- T9. Com um referente `n` que normaliza a direção (`w'·n = 1`), a amplitude é única:\n    `mu • w' = A` implica `mu = A·n`. Álgebra linear de uma linha; a amplitude é relativa ao `n`\n    escolhido. -/\ntheorem com_o_referente_a_amplitude_e_uma_so (n w' A : Coordinate4) (mu : ℝ)\n    (hn : w' ⬝ᵥ n = 1) (h : mu • w' = A) : mu = A ⬝ᵥ n := by\n  rw [← h, smul_dotProduct, hn, smul_eq_mul, mul_one]\n\n/-- T9. Com o referente, a amplitude existe quando `A·n ≠ 0`: há `w'` com `w'·n = 1` e\n    `(A·n) • w' = A`. Todo `n` com `A·n ≠ 0` serve, e a amplitude muda com `n`: a folga passou de\n    `s` para `n`, e `n` é dado de fora, não derivado aqui. -/\ntheorem com_o_referente_a_amplitude_existe (n A : Coordinate4) (hA : A ⬝ᵥ n ≠ 0) :\n    ∃ w' : Coordinate4, w' ⬝ᵥ n = 1 ∧ (A ⬝ᵥ n) • w' = A := by\n  refine ⟨(A ⬝ᵥ n)⁻¹ • A, ?_, ?_⟩\n  · rw [smul_dotProduct, smul_eq_mul, inv_mul_cancel₀ hA]\n  · rw [smul_smul, mul_inv_cancel₀ hA, one_smul]\n\n/-! ## T10 — o observador: amplitude e escala mudam juntas -/\n\n/-- T10. Reescalar a direção por `s ≠ 0` leva a amplitude a `lam/s` e a escala a `s·ell`:\n    o produto fica, e o covetor fica. Identidade de corpo. -/\ntheorem amplitude_e_escala_mudam_juntas (lam s ell : ℝ) (hs : s ≠ 0) :\n    (lam / s) * (s * ell) = lam * ell ∧ (lam / s) • (s • waveCovector) = lam • waveCovector := by\n  refine ⟨?_, ?_⟩\n  · field_simp\n  · rw [smul_smul, div_mul_cancel₀ _ hs]\n\n/-- T10. Com a amplitude da Ponte `thetaMiguel β / (3·ell)`, o produto da amplitude pela\n    escala reescalada é `thetaMiguel β / 3`, e a amplitude reescalada é a de `ell` dividida por `s`.\n    É identidade de corpo e vale por DEFINIÇÃO da amplitude; o valor de `thetaMiguel β` não é\n    usado; nenhum teorema liga a escala da direção ao `ell` da Ponte. O nome antigo dizia fase e ângulo,\n    mais do que o tipo prova, e foi trocado. -/\ntheorem o_produto_amplitude_escala_e_theta_sobre_tres (β s ell : ℝ) (hs : s ≠ 0) (hell : ell ≠ 0) :\n    thetaMiguel β / (3 * (s * ell)) * (s * ell) = thetaMiguel β / 3 ∧\n    thetaMiguel β / (3 * (s * ell)) = thetaMiguel β / (3 * ell) / s := by\n  refine ⟨?_, ?_⟩\n  · field_simp\n  · field_simp\n\nend\n\nend TGLExt.ADirecaoEDado\n",
+    'TGLExt/ANormalDaTelaDeLuz.lean': 'import TGLExt.TracialDissipativeTorsion\nimport TGLExt.TheVerbalCoupling\nimport TGLExt.TheSameBetaReadsThreeFaces\n\nset_option autoImplicit false\nset_option linter.unusedVariables false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 400000\n\n/-!\n# A NORMAL DA TELA DE LUZ (tipagem por definição)\n\nO QUE É. A tipagem, por definição [INPUT], de uma cadeia de três elos:\n* o traço da torção tracial do kernel em quatro dimensões é 3·A (`torsion_trace`, com n − 1 = 3);\n* a FASE é DEFINIDA aqui como esse traço lido no referente e multiplicado pela escala do observador:\n  `faseDaTorcao lam ell = 3·lam·ell`; `a_fase_e_o_traco_da_torcao_lido_no_referente` mostra que ela é\n  o covetor do traço aplicado ao vetor `ell • n`, para qualquer referente n que normaliza a direção;\n* com a amplitude da Ponte (thetaMiguel β / (3·ell)) a fase é thetaMiguel β; ela é a mesma para toda\n  reescala s ≠ 0; para 0 ≤ β ≤ 1 o peso sen² dessa fase é β e o peso cos² é 1 − β.\n A ligação com o kernel fica provada: a matriz S do kernel (`Smat`) avaliada na\nfase é a matriz S no ângulo de Miguel, e o peso sen² da fase é o peso REFLETIDO dela (`normSq_reflection`);\ncom o acoplamento do kernel (`TGLCoupling`) é o `reflection_weight` dele.\n\nÉ VERDADEIRA POR DEFINIÇÃO. A fase vale thetaMiguel β porque a amplitude da Ponte é definida como\nthetaMiguel β / (3·ell); e sen²(thetaMiguel β) = β porque thetaMiguel β é definido como arcsin √β\n(`sin_thetaMiguel`, no kernel). Nada aqui deriva β, nem a amplitude, nem a escala. O 3 da amplitude\né o n − 1 do cabeçalho de `TracialDissipativeTorsion.lean`, que o kernel marca como entrada; ele cancela\ncom o 3 da definição da fase, e qualquer constante no lugar dele daria as mesmas identidades. O conteúdo\nque vem do kernel é o traço (N1, N2) e a matriz S (N9 a N12); N3 a N8 são identidades depois da definição.\n\nO QUE NÃO É.\n* Não prova que o peso sen² da fase seja a normal geométrica de uma tela: normal, tela e luz são leitura da\n  teoria [INPUT/ONTO]; nenhum objeto deste arquivo é tela, luz ou normal. O que o arquivo tipa é o\n  peso da fase, que é o peso refletido da matriz S do kernel.\n* Os nomes não tipam observador físico. O que aqui se chama\n  reescala é só a dilatação s ≠ 0 (inclui s negativo), e a lei amplitude ↦ amplitude/s é POSTA (é a\n  reescala da direção), não derivada.\n* Não liga a escala do observador a nenhuma grandeza medida; não define o Hamiltoniano oculto.\n* Não é o teorema de área, não é `NamedAtlasH3`, não deriva a seta `hH3`.\n* Validade no kernel não é creditação.\n-/\n\nnamespace TGLExt.ANormalDaTelaDeLuz\n\nopen Matrix TGLExt\n\nnoncomputable section\n\n/-! ## N1 — o traço da torção em quatro dimensões -/\n\n/-- N1. Em quatro dimensões o traço da torção tracial do kernel é `3·A` (é\n    `TGLExt.TracialTorsion.torsion_trace` com `n − 1 = 3`). -/\ntheorem o_traco_da_torcao_em_quatro_dimensoes (A : Fin 4 → ℝ) (c : Fin 4) :\n    ∑ a, TGLExt.TracialTorsion.torsion A a a c = 3 * A c := by\n  rw [TGLExt.TracialTorsion.torsion_trace]\n  simp only [Fintype.card_fin]\n  norm_num\n\n/-! ## N2 — a fase: o traço da torção lido no referente, vezes a escala do observador -/\n\n/-- N2 (DEFINIÇÃO). A fase da torção para a amplitude `lam` e a escala `ell`:\n    `3·lam·ell`. O 3 é o `n − 1` do traço (N1), amarrado pelo lema seguinte. -/\ndef faseDaTorcao (lam ell : ℝ) : ℝ := 3 * lam * ell\n\n/-- N2. A fase é o covetor do traço da torção de `A = lam • w` aplicado ao vetor `ell • n`,\n    para qualquer referente `n` que normaliza a direção (`w·n = 1`). Não pede direção nula; não\n    mostra que `n` seja observador físico. -/\ntheorem a_fase_e_o_traco_da_torcao_lido_no_referente (lam ell : ℝ) (w n : Fin 4 → ℝ)\n    (hn : w ⬝ᵥ n = 1) :\n    (fun c => ∑ a, TGLExt.TracialTorsion.torsion (fun d => lam * w d) a a c) ⬝ᵥ (ell • n) =\n      faseDaTorcao lam ell := by\n  have h : (fun c => ∑ a, TGLExt.TracialTorsion.torsion (fun d => lam * w d) a a c) =\n      (3 * lam) • w := by\n    funext c\n    rw [o_traco_da_torcao_em_quatro_dimensoes]\n    simp only [Pi.smul_apply, smul_eq_mul]\n    ring\n  rw [h, smul_dotProduct, dotProduct_smul, hn]\n  simp only [smul_eq_mul, faseDaTorcao]\n  ring\n\n/-! ## N3, N4 — com a amplitude da Ponte a fase é o ângulo, para toda reescala -/\n\n/-- N3. Com a amplitude da Ponte, `thetaMiguel β / (3·ell)`, a fase é `thetaMiguel β`.\n    Vale por DEFINIÇÃO da amplitude. -/\ntheorem a_fase_com_a_amplitude_da_ponte (β ell : ℝ) (hell : ell ≠ 0) :\n    faseDaTorcao (thetaMiguel β / (3 * ell)) ell = thetaMiguel β := by\n  unfold faseDaTorcao\n  field_simp\n\n/-- N4. A fase é a mesma para toda reescala: com `s ≠ 0`, a amplitude `lam/s` e a escala\n    `s·ell` dão a mesma fase. Identidade de corpo; a lei da reescala é posta, não derivada. -/\ntheorem a_fase_e_a_mesma_para_toda_reescala (lam s ell : ℝ) (hs : s ≠ 0) :\n    faseDaTorcao (lam / s) (s * ell) = faseDaTorcao lam ell := by\n  unfold faseDaTorcao\n  field_simp\n\n/-! ## N5, N6, N7, N8 — o peso da fase (identidades depois da definição) -/\n\n/-- N5. O peso sen² da fase, com a amplitude da Ponte, é β. Vale por definição: a fase é\n    `thetaMiguel β` (N3) e `sen(thetaMiguel β) = √β` (`sin_thetaMiguel`, no kernel).\n    O TIPO é só `sen²(fase) = β`; não há tela, luz nem normal geométrica no enunciado. -/\ntheorem o_peso_da_fase_e_beta (β ell : ℝ) (h0 : 0 ≤ β) (h1 : β ≤ 1) (hell : ell ≠ 0) :\n    Real.sin (faseDaTorcao (thetaMiguel β / (3 * ell)) ell) ^ 2 = β := by\n  rw [a_fase_com_a_amplitude_da_ponte β ell hell, sin_thetaMiguel h0 h1, Real.sq_sqrt h0]\n\n/-- N6. O peso sen² da fase é β para TODA reescala: com a amplitude dividida por `s` e a\n    escala multiplicada por `s`, o peso é o mesmo. -/\ntheorem o_peso_da_fase_e_beta_para_toda_reescala (β s ell : ℝ) (h0 : 0 ≤ β) (h1 : β ≤ 1)\n    (hs : s ≠ 0) (hell : ell ≠ 0) :\n    Real.sin (faseDaTorcao (thetaMiguel β / (3 * ell) / s) (s * ell)) ^ 2 = β := by\n  rw [a_fase_e_a_mesma_para_toda_reescala _ s ell hs]\n  exact o_peso_da_fase_e_beta β ell h0 h1 hell\n\n/-- N7. O peso cos² da mesma fase é `1 − β`. -/\ntheorem o_peso_complementar_da_fase_e_um_menos_beta (β ell : ℝ) (h0 : 0 ≤ β) (h1 : β ≤ 1)\n    (hell : ell ≠ 0) :\n    Real.cos (faseDaTorcao (thetaMiguel β / (3 * ell)) ell) ^ 2 = 1 - β := by\n  have h := o_peso_da_fase_e_beta β ell h0 h1 hell\n  have hsc := Real.sin_sq_add_cos_sq (faseDaTorcao (thetaMiguel β / (3 * ell)) ell)\n  linarith\n\n/-- N8. Para `0 < β < 1` a fase é positiva e fica estritamente antes do ângulo reto. -/\ntheorem a_fase_fica_antes_do_angulo_reto (β ell : ℝ) (h0 : 0 < β) (h1 : β < 1) (hell : ell ≠ 0) :\n    0 < faseDaTorcao (thetaMiguel β / (3 * ell)) ell ∧\n      faseDaTorcao (thetaMiguel β / (3 * ell)) ell < Real.pi / 2 := by\n  rw [a_fase_com_a_amplitude_da_ponte β ell hell]\n  unfold thetaMiguel\n  refine ⟨Real.arcsin_pos.mpr (Real.sqrt_pos.mpr h0), ?_⟩\n  rw [Real.arcsin_lt_pi_div_two]\n  calc Real.sqrt β < Real.sqrt 1 := Real.sqrt_lt_sqrt h0.le h1\n    _ = 1 := Real.sqrt_one\n\n/-! ## N9 a N12 — a ligação com a matriz S do kernel -/\n\n/-- N9. A matriz S do kernel avaliada na fase é a matriz S no ângulo de Miguel. -/\ntheorem a_matriz_s_na_fase_e_a_do_angulo_de_miguel (β ell : ℝ) (hell : ell ≠ 0) :\n    Smat (faseDaTorcao (thetaMiguel β / (3 * ell)) ell) = Smat (thetaMiguel β) := by\n  rw [a_fase_com_a_amplitude_da_ponte β ell hell]\n\n/-- N10. O peso sen² da fase é o peso REFLETIDO da matriz S do kernel\n    (`normSq_reflection`): com a amplitude da Ponte, vale β. -/\ntheorem o_peso_da_fase_e_o_peso_refletido_da_matriz_s (β ell : ℝ) (h0 : 0 ≤ β) (h1 : β ≤ 1)\n    (hell : ell ≠ 0) :\n    Complex.normSq ((Smat (faseDaTorcao (thetaMiguel β / (3 * ell)) ell)).mulVec e1 1) = β := by\n  rw [normSq_reflection]\n  exact o_peso_da_fase_e_beta β ell h0 h1 hell\n\n/-- N11. O peso cos² da fase é o peso TRANSMITIDO da matriz S do kernel\n    (`normSq_transmission`): com a amplitude da Ponte, vale `1 − β`. -/\ntheorem o_peso_complementar_e_o_peso_transmitido_da_matriz_s (β ell : ℝ) (h0 : 0 ≤ β) (h1 : β ≤ 1)\n    (hell : ell ≠ 0) :\n    Complex.normSq ((Smat (faseDaTorcao (thetaMiguel β / (3 * ell)) ell)).mulVec e1 0) = 1 - β := by\n  rw [normSq_transmission]\n  exact o_peso_complementar_da_fase_e_um_menos_beta β ell h0 h1 hell\n\n/-- N12. Com o acoplamento do kernel (`TGLCoupling`, o β único da casa), o peso refletido\n    da matriz S na fase é `c.beta`, para toda reescala `s ≠ 0`: é o `reflection_weight` do kernel. -/\ntheorem o_peso_refletido_no_acoplamento_para_toda_reescala (c : TGLCoupling) (s ell : ℝ)\n    (hs : s ≠ 0) (hell : ell ≠ 0) :\n    Complex.normSq\n      ((Smat (faseDaTorcao (thetaMiguel c.beta / (3 * ell) / s) (s * ell))).mulVec e1 1) = c.beta := by\n  rw [a_fase_e_a_mesma_para_toda_reescala _ s ell hs, a_fase_com_a_amplitude_da_ponte c.beta ell hell]\n  exact c.reflection_weight\n\nend\n\nend TGLExt.ANormalDaTelaDeLuz\n',
+    'TGLExt/APonteDaImpedancia.lean': "import TGLExt.TheEquationOfTruth\nimport TGLExt.TheCouplingRunsBoundedBelow\nimport TGLExt.TheFiveHalves\n\nset_option autoImplicit false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 1000000\n\n/-!\n# A PONTE DA IMPEDÂNCIA (fiação)\n\nO QUE É. O artigo do um.py escreve a ponte física: a profundidade modular como rapidez de impedância,\nχ = log(Z_bacia/Z_luz), com q = tanh(χ/2) = (Z_bacia − Z_luz)/(Z_bacia + Z_luz) e\nα = sech(χ/2) = 2·√(Z_bacia·Z_luz)/(Z_bacia + Z_luz). O kernel já tem as duas funções (`profQ`, `profA`,\n`alphaOfChi`) e a conservação tanh² + sech² = 1 (`motor_half_angle_identity`), mas não tinha a forma de\nimpedâncias. Este arquivo a prova, para duas impedâncias reais positivas. O\nmapa com o artigo é: Zs = Z_luz (a fonte) e Zc = Z_bacia (a carga), de modo que χ = log(Zc/Zs).\n* [KNOWN, elementar] a reflexão (Zc − Zs)/(Zc + Zs), a transmissão 2·√(Zs·Zc)/(Zs + Zc) e a conservação\n  do fluxo; a potência na carga é a disponível vezes a transmissão ao quadrado; ela não passa da\n  disponível, é a disponível se, e só se, a impedância é compartilhada (Zc = Zs), e a carga casada dá o\n  máximo sobre todas as cargas positivas; com a impedância compartilhada a fem E da fonte é o dobro da\n  tensão na carga;\n* [fiação] com χ = log(Zc/Zs), a reflexão é `profQ χ` e a transmissão é `profA χ` (= `alphaOfChi χ`) do\n  kernel; impedância compartilhada é χ = 0, reflexão 0, transmissão 1.\n\nO QUE NÃO É.\n* O artigo fala da força dobrada em DOIS lugares, e este arquivo não prova nenhum dos dois. No\n  Teorema do Registro (regime de ângulo reto) ele invoca o teorema da máxima transferência de potência\n  para dizer que a força dobra porque a impedância é compartilhada pelas duas faces, e marca essa\n  identificação como conjectura. No parágrafo da Primeira Lei ele diz que em θ_M → 90° a ligação dobra a\n  força. Aqui se prova só o teorema ELEMENTAR do circuito resistivo: E = 2·(tensão na carga) se, e só\n  se, Zc = Zs. A força do artigo e a fem do circuito são homônimas; a identificação de uma com a outra\n  não é provada. E note-se: Zc = Zs é χ = 0, que no parágrafo da Primeira Lei é o plano estático, não o\n  ângulo reto.\n* O ângulo de Miguel pertence ao par (β, 1 − β) da matriz S; a impedância daqui pertence ao par\n  (q², α²). Nenhum lema deste arquivo liga um par ao outro (reflexão e transmissão têm dois sentidos na\n  casa; não encadear). O α daqui é a transmissão sech(χ/2); não é a constante de estrutura fina (a\n  mesma ressalva do cabeçalho de `TheCouplingRunsBoundedBelow.lean`).\n* Não restaura a palavra que a pedra `TetelestaiTerminal` podou: lá o índice de impedância modular\n  foi aposentado e o conteúdo recebeu outro nome (inclinação modular, o cociclo). Aqui só tem termo a\n  impedância elementar do circuito (dois reais positivos). Que a bacia e a luz tenham impedâncias\n  modulares, e que o χ do perfil seja o log da razão delas, é DEFINIÇÃO (`rapidezDeImpedancia`), não\n  teorema: a ponte do título é a forma algébrica.\n* Não prova c² → c³ nem a razão 3/4. Não liga a carga do circuito à isotropia do fecho: na pedra\n  `QuedaSemGeometria` a palavra carga quer dizer hipótese que sustenta, outro sentido; nenhum termo aqui.\n* Não deriva χ nem a razão das impedâncias: o artigo diz que derivar essa razão é o objeto aberto.\n* O modelo é o do circuito resistivo (impedâncias reais positivas); não há linha de transmissão, onda\n  nem fronteira física no arquivo.\n* Validade no kernel não é creditação.\n-/\n\nnamespace TGLExt.APonteDaImpedancia\n\n/-! ## Definições (reais; Zs = impedância da fonte, Zc = impedância da carga, E = força da fonte) -/\n\n/-- A reflexão (Zc − Zs)/(Zc + Zs). -/\nnoncomputable def reflexao (Zs Zc : ℝ) : ℝ := (Zc - Zs) / (Zc + Zs)\n\n/-- A transmissão 2·√(Zs·Zc)/(Zs + Zc). É a amplitude normalizada pelo fluxo: o seu quadrado é a\n    fração da potência disponível que chega à carga. Não é a razão das tensões (essa é 1 + reflexão). -/\nnoncomputable def transmissao (Zs Zc : ℝ) : ℝ := 2 * Real.sqrt (Zs * Zc) / (Zs + Zc)\n\n/-- A tensão sobre a carga: divisor de tensão E·Zc/(Zs + Zc). -/\nnoncomputable def tensaoNaCarga (E Zs Zc : ℝ) : ℝ := E * Zc / (Zs + Zc)\n\n/-- A potência dissipada na carga: E²·Zc/(Zs + Zc)². -/\nnoncomputable def potenciaNaCarga (E Zs Zc : ℝ) : ℝ := E ^ 2 * Zc / (Zs + Zc) ^ 2\n\n/-- A potência disponível da fonte: E²/(4·Zs). -/\nnoncomputable def potenciaDisponivel (E Zs : ℝ) : ℝ := E ^ 2 / (4 * Zs)\n\n/-- A rapidez de impedância χ = log(Zc/Zs). -/\nnoncomputable def rapidezDeImpedancia (Zs Zc : ℝ) : ℝ := Real.log (Zc / Zs)\n\n/-! ## (I8, primeira parte) A impedância compartilhada: reflexão 0, transmissão 1 -/\n\n/-- [KNOWN, elementar] Com a impedância compartilhada, a reflexão é 0 e a transmissão é 1. -/\ntheorem com_a_impedancia_compartilhada_a_reflexao_e_nula_e_a_transmissao_e_um (Zs : ℝ) (hs : 0 < Zs) :\n    reflexao Zs Zs = 0 ∧ transmissao Zs Zs = 1 := by\n  have hne : Zs + Zs ≠ 0 := by positivity\n  constructor\n  · unfold reflexao\n    simp\n  · unfold transmissao\n    rw [Real.sqrt_mul_self hs.le]\n    field_simp\n    ring\n\n/-- A reflexão é nula se, e só se, a impedância é compartilhada. -/\ntheorem a_reflexao_e_nula_sse_a_impedancia_e_compartilhada (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    reflexao Zs Zc = 0 ↔ Zc = Zs := by\n  have hne : Zc + Zs ≠ 0 := by positivity\n  unfold reflexao\n  rw [div_eq_zero_iff]\n  constructor\n  · rintro (h | h)\n    · linarith\n    · exact absurd h hne\n  · intro h\n    left\n    linarith\n\n/-! ## (I1) A conservação do fluxo -/\n\n/-- [KNOWN, elementar] ★ I1. A reflexão e a transmissão repartem o fluxo: r² + t² = 1. -/\ntheorem o_fluxo_se_conserva (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    reflexao Zs Zc ^ 2 + transmissao Zs Zc ^ 2 = 1 := by\n  have hsq : Real.sqrt (Zs * Zc) ^ 2 = Zs * Zc := Real.sq_sqrt (by positivity)\n  have hne : Zc + Zs ≠ 0 := by positivity\n  have hne' : Zs + Zc ≠ 0 := by positivity\n  unfold reflexao transmissao\n  rw [div_pow, div_pow, mul_pow, hsq]\n  field_simp\n  ring\n\n/-! ## (I2) A potência na carga pela transmissão e pela reflexão -/\n\n/-- [KNOWN, elementar] I2. A potência na carga é a disponível vezes a transmissão ao quadrado. -/\ntheorem a_potencia_na_carga_pela_transmissao (E Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    potenciaNaCarga E Zs Zc = potenciaDisponivel E Zs * transmissao Zs Zc ^ 2 := by\n  have hsq : Real.sqrt (Zs * Zc) ^ 2 = Zs * Zc := Real.sq_sqrt (by positivity)\n  have hne : Zs + Zc ≠ 0 := by positivity\n  have hs' : Zs ≠ 0 := hs.ne'\n  unfold potenciaNaCarga potenciaDisponivel transmissao\n  rw [div_pow, mul_pow, hsq]\n  field_simp\n  ring\n\n/-- [KNOWN, elementar] I2. A potência na carga é a disponível vezes (1 − r²). -/\ntheorem a_potencia_na_carga_pela_reflexao (E Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    potenciaNaCarga E Zs Zc = potenciaDisponivel E Zs * (1 - reflexao Zs Zc ^ 2) := by\n  rw [a_potencia_na_carga_pela_transmissao E Zs Zc hs hc]\n  have h := o_fluxo_se_conserva Zs Zc hs hc\n  have h2 : transmissao Zs Zc ^ 2 = 1 - reflexao Zs Zc ^ 2 := by linarith\n  rw [h2]\n\n/-! ## (I3) A máxima transferência de potência -/\n\n/-- [KNOWN, elementar] I3.A potência na carga nunca passa da disponível. -/\ntheorem a_potencia_na_carga_nao_passa_da_disponivel (E Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    potenciaNaCarga E Zs Zc ≤ potenciaDisponivel E Zs := by\n  have hPD : 0 ≤ potenciaDisponivel E Zs := by\n    unfold potenciaDisponivel\n    positivity\n  rw [a_potencia_na_carga_pela_reflexao E Zs Zc hs hc]\n  nlinarith [mul_nonneg hPD (sq_nonneg (reflexao Zs Zc))]\n\n/-- [KNOWN, elementar] I3.A potência é máxima se, e só se, a impedância é compartilhada. -/\ntheorem a_potencia_e_maxima_sse_a_impedancia_e_compartilhada (E Zs Zc : ℝ)\n    (hs : 0 < Zs) (hc : 0 < Zc) (hE : E ≠ 0) :\n    potenciaNaCarga E Zs Zc = potenciaDisponivel E Zs ↔ Zc = Zs := by\n  have hPD : 0 < potenciaDisponivel E Zs := by\n    unfold potenciaDisponivel\n    positivity\n  rw [a_potencia_na_carga_pela_reflexao E Zs Zc hs hc]\n  constructor\n  · intro h\n    have h1 : potenciaDisponivel E Zs * reflexao Zs Zc ^ 2 = 0 := by\n      linear_combination (-1 : ℝ) * h\n    rcases mul_eq_zero.mp h1 with h2 | h2\n    · exact absurd h2 hPD.ne'\n    · have h3 : reflexao Zs Zc = 0 := pow_eq_zero_iff (two_ne_zero) |>.mp h2\n      exact (a_reflexao_e_nula_sse_a_impedancia_e_compartilhada Zs Zc hs hc).mp h3\n  · intro h\n    have h0 : reflexao Zs Zc = 0 :=\n      (a_reflexao_e_nula_sse_a_impedancia_e_compartilhada Zs Zc hs hc).mpr h\n    rw [h0]\n    ring\n\n/-- [KNOWN, elementar] Com a impedância compartilhada, a potência na carga É a disponível. -/\ntheorem com_a_impedancia_compartilhada_a_potencia_e_a_disponivel (E Zs : ℝ) (hs : 0 < Zs) :\n    potenciaNaCarga E Zs Zs = potenciaDisponivel E Zs := by\n  unfold potenciaNaCarga potenciaDisponivel\n  rw [div_eq_div_iff (by positivity) (by positivity)]\n  ring\n\n/-- [KNOWN, elementar] A MÁXIMA TRANSFERÊNCIA DE POTÊNCIA: para toda carga positiva, a potência na\n    carga não passa da potência na carga casada (Zc = Zs). -/\ntheorem maxima_transferencia_de_potencia (E Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    potenciaNaCarga E Zs Zc ≤ potenciaNaCarga E Zs Zs := by\n  rw [com_a_impedancia_compartilhada_a_potencia_e_a_disponivel E Zs hs]\n  exact a_potencia_na_carga_nao_passa_da_disponivel E Zs Zc hs hc\n\n/-! ## (I4) Com a impedância compartilhada, a fem é o dobro da tensão na carga -/\n\n/-- [KNOWN, elementar] I4. Com a impedância compartilhada, a fem E da fonte é 2·(tensão na carga).\n    A fem do circuito e a força do artigo são homônimas; nada aqui as identifica. -/\ntheorem com_a_impedancia_compartilhada_a_fem_e_o_dobro_da_tensao_na_carga (E Zs : ℝ) (hs : 0 < Zs) :\n    E = 2 * tensaoNaCarga E Zs Zs := by\n  have hne : Zs + Zs ≠ 0 := by positivity\n  unfold tensaoNaCarga\n  field_simp\n  ring\n\n/-- [KNOWN, elementar] I4. A fem E é o dobro da tensão na carga se, e só se, a impedância é\ncompartilhada. -/\ntheorem a_fem_e_o_dobro_da_tensao_na_carga_sse_a_impedancia_e_compartilhada (E Zs Zc : ℝ)\n    (hs : 0 < Zs) (hc : 0 < Zc) (hE : E ≠ 0) :\n    E = 2 * tensaoNaCarga E Zs Zc ↔ Zc = Zs := by\n  have hne : Zs + Zc ≠ 0 := by positivity\n  constructor\n  · intro h\n    unfold tensaoNaCarga at h\n    have h1 : E * (Zs + Zc) = 2 * (E * Zc) := by\n      calc E * (Zs + Zc) = (2 * (E * Zc / (Zs + Zc))) * (Zs + Zc) := by rw [← h]\n        _ = 2 * (E * Zc) := by field_simp\n    have h2 : E * (Zs - Zc) = 0 := by linear_combination h1\n    rcases mul_eq_zero.mp h2 with h3 | h3\n    · exact absurd h3 hE\n    · linarith\n  · intro h\n    rw [h]\n    exact com_a_impedancia_compartilhada_a_fem_e_o_dobro_da_tensao_na_carga E Zs hs\n\n/-! ## (I5) A tensão na carga pela reflexão -/\n\n/-- [KNOWN, elementar] I5. A tensão na carga é a metade da força vezes (1 + r). -/\ntheorem a_tensao_na_carga_pela_reflexao (E Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    tensaoNaCarga E Zs Zc = E / 2 * (1 + reflexao Zs Zc) := by\n  have hne : Zs + Zc ≠ 0 := by positivity\n  have hne' : Zc + Zs ≠ 0 := by positivity\n  unfold tensaoNaCarga reflexao\n  field_simp\n  ring\n\n/-! ## (I6) A reflexão fica abaixo de um; a tensão na carga fica abaixo da força -/\n\n/-- [KNOWN, elementar] I6. |r| < 1. -/\ntheorem a_reflexao_fica_abaixo_de_um (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    |reflexao Zs Zc| < 1 := by\n  unfold reflexao\n  have hpos : 0 < Zc + Zs := by positivity\n  rw [abs_div, abs_of_pos hpos, div_lt_one hpos, abs_lt]\n  constructor <;> linarith\n\n/-- [KNOWN, elementar] I6. Com força positiva, a tensão na carga fica abaixo da força. -/\ntheorem a_tensao_na_carga_fica_abaixo_da_forca (E Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc)\n    (hE : 0 < E) : tensaoNaCarga E Zs Zc < E := by\n  have hpos : 0 < Zs + Zc := by positivity\n  unfold tensaoNaCarga\n  rw [div_lt_iff₀ hpos]\n  nlinarith [mul_pos hE hs]\n\n/-! ## (I7) A ligação com o kernel: reflexão = profQ, transmissão = profA = alphaOfChi -/\n\n/-- O quadrado da meia-rapidez: exp(χ/2)·exp(χ/2) = Zc/Zs. -/\ntheorem exp_meia_rapidez_ao_quadrado (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    Real.exp (rapidezDeImpedancia Zs Zc / 2) * Real.exp (rapidezDeImpedancia Zs Zc / 2)\n      = Zc / Zs := by\n  rw [← Real.exp_add, add_halves]\n  unfold rapidezDeImpedancia\n  exact Real.exp_log (div_pos hc hs)\n\n/-- tanh(χ/2) com χ = log(Zc/Zs) é a reflexão. -/\ntheorem tanh_da_meia_rapidez (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    Real.tanh (rapidezDeImpedancia Zs Zc / 2) = reflexao Zs Zc := by\n  have hupos := Real.exp_pos (rapidezDeImpedancia Zs Zc / 2)\n  have huu := exp_meia_rapidez_ao_quadrado Zs Zc hs hc\n  have hneg := Real.exp_neg (rapidezDeImpedancia Zs Zc / 2)\n  rw [Real.tanh_eq_sinh_div_cosh, Real.sinh_eq, Real.cosh_eq, hneg]\n  generalize Real.exp (rapidezDeImpedancia Zs Zc / 2) = u at hupos huu ⊢\n  have hZc : Zc = Zs * (u * u) := by\n    rw [huu]\n    field_simp\n  have hu : u ≠ 0 := hupos.ne'\n  have h1 : u * u + 1 ≠ 0 := by positivity\n  have h2 : Zs * (u * u) + Zs ≠ 0 := by positivity\n  have h3 : u + u⁻¹ ≠ 0 := by positivity\n  unfold reflexao\n  rw [hZc]\n  field_simp\n\n/-- sech(χ/2) com χ = log(Zc/Zs) é a transmissão. -/\ntheorem sech_da_meia_rapidez (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    (Real.cosh (rapidezDeImpedancia Zs Zc / 2))⁻¹ = transmissao Zs Zc := by\n  have hupos := Real.exp_pos (rapidezDeImpedancia Zs Zc / 2)\n  have huu := exp_meia_rapidez_ao_quadrado Zs Zc hs hc\n  have hneg := Real.exp_neg (rapidezDeImpedancia Zs Zc / 2)\n  rw [Real.cosh_eq, hneg]\n  generalize Real.exp (rapidezDeImpedancia Zs Zc / 2) = u at hupos huu ⊢\n  have hZc : Zc = Zs * (u * u) := by\n    rw [huu]\n    field_simp\n  have hu : u ≠ 0 := hupos.ne'\n  have h1 : u * u + 1 ≠ 0 := by positivity\n  have h2 : Zs + Zs * (u * u) ≠ 0 := by positivity\n  have h3 : u + u⁻¹ ≠ 0 := by positivity\n  have hsqrt : Real.sqrt (Zs * (Zs * (u * u))) = Zs * u := by\n    rw [show Zs * (Zs * (u * u)) = (Zs * u) * (Zs * u) by ring]\n    exact Real.sqrt_mul_self (by positivity)\n  unfold transmissao\n  rw [hZc, hsqrt]\n  field_simp\n  ring\n\n/-- [fiação] ★★ I7. A reflexão é o perfil q do kernel, na rapidez de impedância. -/\ntheorem a_reflexao_e_o_perfil_q_do_kernel (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    reflexao Zs Zc = TGLExt.EquationOfTruth.profQ (rapidezDeImpedancia Zs Zc) := by\n  unfold TGLExt.EquationOfTruth.profQ\n  exact (tanh_da_meia_rapidez Zs Zc hs hc).symm\n\n/-- [fiação] ★★ I7. A transmissão é o perfil a do kernel, na rapidez de impedância. -/\ntheorem a_transmissao_e_o_perfil_a_do_kernel (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    transmissao Zs Zc = TGLExt.EquationOfTruth.profA (rapidezDeImpedancia Zs Zc) := by\n  unfold TGLExt.EquationOfTruth.profA\n  exact (sech_da_meia_rapidez Zs Zc hs hc).symm\n\n/-- [fiação] ★★ I7. A transmissão é o `alphaOfChi` do kernel, na rapidez de impedância. Esse alfa é\na transmissão sech(χ/2), não a constante de estrutura fina. -/\ntheorem a_transmissao_e_o_alphaOfChi_do_kernel (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    transmissao Zs Zc\n      = TGLExt.TheCouplingRunsBoundedBelow.alphaOfChi (rapidezDeImpedancia Zs Zc) := by\n  unfold TGLExt.TheCouplingRunsBoundedBelow.alphaOfChi\n  rw [one_div]\n  exact (sech_da_meia_rapidez Zs Zc hs hc).symm\n\n/-! ## (I8, segunda parte) A impedância compartilhada é a profundidade zero -/\n\n/-- [fiação] I8. A impedância é compartilhada se, e só se, a rapidez de impedância é zero. -/\ntheorem a_impedancia_compartilhada_e_a_rapidez_de_impedancia_zero (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    Zc = Zs ↔ rapidezDeImpedancia Zs Zc = 0 := by\n  constructor\n  · intro h\n    unfold rapidezDeImpedancia\n    rw [h, div_self hs.ne']\n    exact Real.log_one\n  · intro h\n    have h1 := Real.exp_log (div_pos hc hs)\n    unfold rapidezDeImpedancia at h\n    rw [h, Real.exp_zero] at h1\n    field_simp at h1\n    linarith\n\n/-! ## (I9) A conservação do fluxo, pela segunda rota: o kernel -/\n\n/-- [fiação] I9. A conservação do fluxo obtida por I7 mais `motor_half_angle_identity`. -/\ntheorem o_fluxo_se_conserva_pelo_kernel (Zs Zc : ℝ) (hs : 0 < Zs) (hc : 0 < Zc) :\n    reflexao Zs Zc ^ 2 + transmissao Zs Zc ^ 2 = 1 := by\n  rw [a_reflexao_e_o_perfil_q_do_kernel Zs Zc hs hc, a_transmissao_e_o_perfil_a_do_kernel Zs Zc hs hc]\n  unfold TGLExt.EquationOfTruth.profQ TGLExt.EquationOfTruth.profA\n  have h := TGLExt.motor_half_angle_identity (rapidezDeImpedancia Zs Zc)\n  rw [one_div] at h\n  exact h\n\nend TGLExt.APonteDaImpedancia\n",
+    'TGLExt/TorcaoNaOndaPlana.lean': 'import TGLExt.PlaneWaveMatter\nimport TGLExt.TracialDissipativeTorsion\nimport TGLExt.TheVerbalCoupling\n\nset_option autoImplicit false\nset_option linter.unusedVariables false\nset_option linter.unusedSectionVars false\nset_option maxHeartbeats 8000000\nset_option maxRecDepth 4096\n\n/-!\n# A TORÇÃO NA ONDA PLANA (fiação)\n\nO QUE É. Fiação entre duas peças do kernel:\n* a torção tracial da Ponte Einstein–Cartan–Miguel (`TGLExt.TracialTorsion`: contorção\n  K^a_{bc} = δ^a_b A_c − g_{bc} A^a), e\n* a onda plana do lote 029 (`waveSolder a c`, métrica eta4 + H·w⊗w, conexão de Levi-Civita sem torção).\nAqui o vetor da torção é posto ao longo da própria onda, A = lam • waveCovector. Calcula-se, na geometria\nem coordenadas do kernel (`coordinateRicci`, `geometricEinsteinTensor`), o Ricci, o escalar e o tensor de\nEinstein da conexão com torção: (a + c + 2·lam²) • w⊗w. Logo a onda CHATA com torção tem o tensor de\nEinstein da onda CURVA sem torção com a\' + c\' = 2·lam². Com a amplitude da Ponte,\nlam = thetaMiguel β / (3·ell) (a alfa = θ_M/((n−1)ℓ) de `TracialDissipativeTorsion.lean`, em n = 4),\na soma dos perfis é 2·θ_M²/(9·ell²).\n\nO QUE ENTRA POR DEFINIÇÃO (não é provado aqui).\n* A forma da torção (tracial) e a sua amplitude θ_M/((n−1)ℓ): são a definição da Ponte.\n* A DIREÇÃO do vetor da torção (ao longo da onda) é dado de entrada [INPUT]; na onda chata é o caso de dado nulo\n  de `ADirecaoEDado`. O controle da torção temporal\n  mostra o que muda com a direção do tempo: aparece um termo proporcional a eta4.\n* A escala ell fica como entrada; `a_escala_que_resta_e_unica` diz que, dados eta > 0, o acoplamento > 0\n  e o ângulo > 0, existe exatamente uma.\n* O VALOR de `thetaMiguel β` não entra em nenhuma prova deste arquivo: só a\n  positividade (de β > 0). Quando `ell` percorre os reais positivos, `thetaMiguel β / (3·ell)` cobre TODAS\n  as amplitudes positivas; logo T6 é T5 com `lam` substituído, e T8 é a inversão elementar de `ell` (com\n  `eta` e o acoplamento livres). Nada aqui liga `ell` a β.\n* O vetor A é NULO e não tem norma invariante. Reescalar `waveCovector` por `s` (um boost ao longo da\n  onda) leva `lam` a `lam/s`, o acoplamento a `acoplamento/s²` e `ell` a `s·ell`; só a relação entre eles\n  é invariante. `lam` e `ell` só têm sentido na normalização fixa `waveCovector = (1,0,0,1)` da carta (a\n  componente temporal do covetor é 1). A amplitude θ_M/((n−1)ℓ) do kernel é escrita para um vetor UNITÁRIO\n  temporal (A = alfa·n); para a direção nula não há análogo invariante.\n\nO QUE NÃO É.\n* Não iguala as curvaturas completas: a igualdade é entre tensores de Einstein (e de Ricci).\n* Em T5 só a soma `a\' + c\'` é comparada: a diferença `a\' − c\'` (o cisalhamento) não é vista, e as\n  métricas diferem (`eta4` contra `eta4 + H·w⊗w`).\n* Não é a lei de área com torção: o teorema de área do kernel usa a conexão de Levi-Civita.\n* Não impõe equação de campo à torção: A é dado de fundo, sem fonte de spin. O Einstein daqui é\n  Ric − (R/2)·g com o Ricci da conexão com torção; não é a equação de Einstein–Cartan.\n* T7 tem o balanço como HIPÓTESE: só reescreve T4b com `wave_matter_formula`; não decide `a`, `c`,\n  `lam` nem `ell`. Não aparece termo cosmológico porque Einstein e fonte são múltiplos de w⊗w e a métrica\n  não é (comentário, não teorema deste arquivo).\n* Não é `NamedAtlasH3` nem deriva a seta `hH3` do fecho condicional.\n* Não deriva a amplitude nem a escala; não identifica a torção com um grau físico.\n* Validade no kernel não é creditação.\n\nCOMO SE LIGA (fiação, não homônimo). `a_conexao_com_torcao_e_levi_civita_mais_a_contorcao_do_kernel` prova,\nponto a ponto, que a conexão definida aqui é a de Levi-Civita do kernel (`frameLeviCivita`) mais a contorção\n`TGLExt.TracialTorsion.Kmix` aplicada às métricas do kernel (`frameMetricField`, `inverseFrameMetricField`) e\nao vetor A = lam • waveCovector; `a_torcao_da_onda_e_a_tracial` prova que a torção dela é\n`TGLExt.TracialTorsion.torsion`. O Ricci é calculado dentro da geometria em coordenadas do kernel\n(`coordinateRicci`, a mesma contração do `wave_ricci`), sem passar por nenhuma cópia da álgebra da torção;\n`ricciOf_e_coordinateRicci` liga as duas contrações para toda conexão. Por fim,\n`o_ricci_da_onda_com_torcao_pela_forma_fechada_do_kernel` (T11) obtém o mesmo Ricci pela forma fechada do\nkernel (`TGLExt.TracialTorsion.ricci_of_tracial_connection`, usando T10, T0, T2a, T2b e a compatibilidade\nmétrica de Levi-Civita do kernel): Levi-Civita mais (n − 2)·A_b A_d, em acordo com T3.\n `os_dois_caminhos_dao_o_mesmo_ricci` junta T11 com `wave_ricci` e reobtém, entrada a entrada, o Ricci\nde T3 sem usar T3.\n\nCONVENÇÃO. O Ricci é R_{bd} = R^a_{bad}, a mesma contração em `coordinateRicci` e em `ricciOf` (T10).\nO resultado é simétrico porque ∇A = 0 (T2b): a parte antissimétrica −((n−2)/2)(∇_d A_b − ∇_b A_d) do kernel\né nula. A compatibilidade métrica da conexão com torção vem de `contortion_metric_compatible` do kernel\nmais Levi-Civita e NÃO é teorema deste arquivo. Que `a = c = 0` é o caso plano nas definições do kernel\n(métrica `eta4` em todo ponto, conexão de Levi-Civita nula) está em `a_onda_chata_e_plana`.\n-/\n\nnamespace TGLExt.TorcaoNaOndaPlana\n\nopen Filter Topology Matrix Set TGLExt ChatgptAudit ChatgptAudit.Coherent023 ChatgptAudit.Response028\n  ChatgptAudit.Wave029\n\nnoncomputable section\n\n/-! ## D1 — a conexão da onda com a torção tracial ao longo da onda -/\n\n/-- A métrica de Minkowski do kernel é simétrica (auxiliar). -/\ntheorem eta4_simetrica (i j : Fin 4) : eta4 i j = eta4 j i := by\n  fin_cases i <;> fin_cases j <;>\n    norm_num [eta4, Matrix.diagonal_apply, Matrix.cons_val_two, Matrix.cons_val_three,\n      Fin.isValue]\n\n/-- D1. A conexão da onda plana com torção: `Gamma x i r j` é Γ^r_{ij} (i é a direção da\n    derivada). É a de Levi-Civita da onda (`waveConnection`) mais a contorção tracial\n    `δ^r_i A_j − g_{ij} A^r` com `A = lam • waveCovector`, escrita em forma polinomial explícita\n    (`g_{ij} = eta4 i j + H·w_i·w_j`, `A^r = lam · waveRaised r`). -/\ndef conexaoDaOndaComTorcao (a c lam : ℝ) : ConnectionField4 :=\n  fun x i r j => waveConnection a c x i r j +\n    lam * (TGLExt.TracialTorsion.kd r i * waveCovector j -\n      (eta4 i j + waveProfile a c x * waveCovector i * waveCovector j) * waveRaised r)\n\n/-! ## T0, T1, T2 — a fiação com `TGLExt.TracialTorsion` -/\n\n/-- O vetor da torção levantado pela métrica inversa da onda é `lam · waveRaised` (constante em x). -/\ntheorem o_levantamento_do_vetor_da_onda (a c lam : ℝ) (x : Coordinate4) (r : Fin 4) :\n    TGLExt.TracialTorsion.raise\n      (fun p q => inverseFrameMetricField (waveInverseSolder a c) x p q)\n      (fun d => lam * waveCovector d) r = lam * waveRaised r := by\n  unfold TGLExt.TracialTorsion.raise\n  rw [wave_inverse_metric_formula]\n  fin_cases r <;>\n    norm_num [Fin.sum_univ_four, eta4, Matrix.vecMulVec, waveCovector, waveRaised,\n      Matrix.diagonal_apply, Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue] <;>\n    norm_num [Fin.ext_iff] <;> ring\n\n/-- T0. A conexão com torção é, ponto a ponto, a de Levi-Civita do kernel mais a contorção\n    `Kmix` do kernel (`TGLExt.TracialTorsion`), aplicada às métricas do kernel e a `A = lam • waveCovector`.\n    Isto impede o homônimo: a parcela somada É a contorção do kernel. -/\ntheorem a_conexao_com_torcao_e_levi_civita_mais_a_contorcao_do_kernel (a c lam : ℝ) (x : Coordinate4)\n    (i r j : Fin 4) :\n    conexaoDaOndaComTorcao a c lam x i r j =\n      frameLeviCivita (waveSolder a c) (waveInverseSolder a c) x i r j +\n        TGLExt.TracialTorsion.Kmix (fun p q => frameMetricField (waveSolder a c) x p q)\n          (fun p q => inverseFrameMetricField (waveInverseSolder a c) x p q)\n          (fun d => lam * waveCovector d) r i j := by\n  rw [wave_levi_civita]\n  simp only [TGLExt.TracialTorsion.Kmix, conexaoDaOndaComTorcao]\n  rw [o_levantamento_do_vetor_da_onda, wave_metric_formula]\n  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]\n  ring\n\n/-- T1. A torção da conexão da onda é a torção tracial do kernel:\n    `Γ^r_{ij} − Γ^r_{ji} = T^r_{ij}` com `A = lam • waveCovector`. -/\ntheorem a_torcao_da_onda_e_a_tracial (a c lam : ℝ) (x : Coordinate4) (i r j : Fin 4) :\n    conexaoDaOndaComTorcao a c lam x i r j - conexaoDaOndaComTorcao a c lam x j r i =\n      TGLExt.TracialTorsion.torsion (fun d => lam * waveCovector d) r i j := by\n  unfold conexaoDaOndaComTorcao TGLExt.TracialTorsion.torsion\n  rw [wave_connection_torsion_free a c x i j r, eta4_simetrica i j]\n  ring\n\n/-- Controle de não-vacuidade: com `lam ≠ 0` a torção não é nula (a conexão de Levi-Civita da onda é sem\n    torção: `wave_connection_torsion_free`). -/\ntheorem a_torcao_da_onda_nao_e_nula (a c lam : ℝ) (hlam : lam ≠ 0) (x : Coordinate4) :\n    conexaoDaOndaComTorcao a c lam x 0 0 3 - conexaoDaOndaComTorcao a c lam x 3 0 0 ≠ 0 := by\n  rw [a_torcao_da_onda_e_a_tracial]\n  have h : TGLExt.TracialTorsion.torsion (fun d => lam * waveCovector d) 0 0 3 = lam := by\n    norm_num [TGLExt.TracialTorsion.torsion, TGLExt.TracialTorsion.kd, waveCovector,\n      Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue, Fin.ext_iff]\n  rw [h]\n  exact hlam\n\n/-- T2a. O vetor da torção posto ao longo da onda é NULO para a métrica inversa da onda:\n    `A_a A^a = 0`. -/\ntheorem o_vetor_da_torcao_na_onda_e_nulo (a c lam : ℝ) (x : Coordinate4) :\n    TGLExt.TracialTorsion.normSq\n      (fun p q => inverseFrameMetricField (waveInverseSolder a c) x p q)\n      (fun d => lam * waveCovector d) = 0 := by\n  unfold TGLExt.TracialTorsion.normSq\n  simp only [o_levantamento_do_vetor_da_onda]\n  norm_num [Fin.sum_univ_four, waveCovector, waveRaised, Matrix.cons_val_two,\n    Matrix.cons_val_three, Fin.isValue]\n\n/-- T2b. O covetor da onda é paralelo para a conexão de Levi-Civita da onda:\n    `Γ^e_{ij} w_e = 0`; logo `∇_i A_j = ∂_i A_j − Γ^e_{ij} A_e = 0` para `A = lam • waveCovector`. -/\ntheorem o_vetor_da_torcao_e_covariantemente_constante (a c : ℝ) (x : Coordinate4) (i j : Fin 4) :\n    ∑ e, waveConnection a c x i e j * waveCovector e = 0 := by\n  fin_cases i <;> fin_cases j <;>\n    norm_num [Fin.sum_univ_four, waveConnection, waveTransverse, waveCovector, waveRaised,\n      Matrix.cons_val_two, Matrix.cons_val_three, Fin.isValue]\n\n/-! ## T3 — o Ricci da onda com torção, calculado na geometria em coordenadas do kernel -/\n\n/-- Derivada parcial da soma (auxiliar). -/\ntheorem coordinatePartial_soma (f g : Coordinate4 → ℝ) (x : Coordinate4) (i : Fin 4)\n    (hf : DifferentiableAt ℝ f x) (hg : DifferentiableAt ℝ g x) :\n    coordinatePartial (fun y => f y + g y) x i = coordinatePartial f x i + coordinatePartial g x i := by\n  unfold coordinatePartial\n  rw [fderiv_fun_add hf hg]\n  simp\n\n/-- Derivada parcial de `u + v · f` (auxiliar). -/\ntheorem coordinatePartial_afim (u v : ℝ) (f : Coordinate4 → ℝ) (x : Coordinate4) (i : Fin 4)\n    (hf : DifferentiableAt ℝ f x) :\n    coordinatePartial (fun y => u + v * f y) x i = v * coordinatePartial f x i := by\n  unfold coordinatePartial\n  rw [((hf.hasFDerivAt.const_mul v).const_add u).fderiv]\n  simp\n\n/-- O primeiro jato da conexão com torção: o de `waveConnection` (linear em x,\n    `wave_connection_jet`) menos `lam · ∂_k H · w_i w_j w^r`, que vem da parte da contorção que depende\n    de x (a métrica `g_{ij} = eta4 i j + H w_i w_j`). -/\ntheorem o_jato_da_conexao_com_torcao (a c lam : ℝ) (x : Coordinate4) (k i r j : Fin 4) :\n    connectionFirstJet (conexaoDaOndaComTorcao a c lam) x k i r j =\n      waveConnection a c (Pi.single k 1) i r j -\n        lam * coordinatePartial (waveProfile a c) x k *\n          (waveCovector i * waveCovector j * waveRaised r) := by\n  have hW : DifferentiableAt ℝ (fun y => waveConnection a c y i r j) x :=\n    smooth_matrix_differentiableAt univ isOpen_univ _ ((wave_connection_smooth a c) i) x\n      (mem_univ x) r j\n  have hH : DifferentiableAt ℝ (waveProfile a c) x :=\n    (wave_profile_smooth a c).differentiable (by simp) x\n  have he : (fun y => conexaoDaOndaComTorcao a c lam y i r j) = fun y =>\n      waveConnection a c y i r j +\n        (lam * (TGLExt.TracialTorsion.kd r i * waveCovector j - eta4 i j * waveRaised r) +\n          (-(lam * (waveCovector i * waveCovector j * waveRaised r))) * waveProfile a c y) := by\n    funext y\n    unfold conexaoDaOndaComTorcao\n    ring\n  have hJ : coordinatePartial (fun y => waveConnection a c y i r j) x k =\n      waveConnection a c (Pi.single k 1) i r j := by\n    have := congrFun (congrFun (wave_connection_jet a c x k i) r) j\n    exact this\n  change coordinatePartial (fun y => conexaoDaOndaComTorcao a c lam y i r j) x k = _\n  rw [he, coordinatePartial_soma _ _ x k hW ((hH.const_mul _).const_add _),\n    coordinatePartial_afim _ _ _ x k hH, hJ]\n  ring\n\n/-- T3 ★. O Ricci da onda com torção ao longo da onda: `(a + c + 2·lam²) • w⊗w`. A parcela\n    `2·lam²` é a de `(n − 2)·A_b A_d` com `n = 4` na forma fechada da torção tracial do kernel\n    (`TGLExt.TracialTorsion.ricci_closed_form`); aqui ela sai do cálculo direto em `coordinateRicci`, e\n    T11 (mais abaixo) confere que a forma fechada do kernel dá o mesmo número. -/\ntheorem o_ricci_da_onda_com_torcao (a c lam : ℝ) (x : Coordinate4) :\n    coordinateRicci (conexaoDaOndaComTorcao a c lam) x =\n      (a + c + 2 * lam ^ 2) • Matrix.vecMulVec waveCovector waveCovector := by\n  ext b j\n  simp only [coordinateRicci, coordinateCurvature, connectionCurvatureJet, Matrix.sub_apply,\n    Matrix.add_apply, Matrix.mul_apply, Fin.sum_univ_four, o_jato_da_conexao_com_torcao,\n    wave_profile_partial]\n  fin_cases b <;> fin_cases j <;>\n    norm_num [conexaoDaOndaComTorcao, waveConnection, waveTransverse, waveProfile, waveCovector,\n      waveRaised, eta4, TGLExt.TracialTorsion.kd, Pi.single_apply, Matrix.vecMulVec,\n      Matrix.cons_val_two, Matrix.cons_val_three, Matrix.diagonal_apply, Fin.isValue] <;>\n    norm_num [Fin.ext_iff] <;> ring\n\n/-- T3, caso chato (a = c = 0). O núcleo: o Ricci da torção ao longo da onda numa métrica\n    plana é `(2·lam²) • w⊗w`. -/\ntheorem o_ricci_da_onda_chata_com_torcao (lam : ℝ) (x : Coordinate4) :\n    coordinateRicci (conexaoDaOndaComTorcao 0 0 lam) x =\n      (2 * lam ^ 2) • Matrix.vecMulVec waveCovector waveCovector := by\n  rw [o_ricci_da_onda_com_torcao]\n  congr 1\n  ring\n\n/-- A onda com `a = c = 0` é PLANA nas definições do kernel: a métrica é `eta4` em todo\n    ponto e a conexão de Levi-Civita é nula. É o que dá sentido a "onda chata" neste arquivo. -/\ntheorem a_onda_chata_e_plana (x : Coordinate4) :\n    frameMetricField (waveSolder 0 0) x = eta4 ∧ ∀ i r j, waveConnection 0 0 x i r j = 0 := by\n  refine ⟨?_, ?_⟩\n  · rw [wave_metric_formula]\n    simp [waveProfile]\n  · intro i r j\n    fin_cases i <;> fin_cases r <;> fin_cases j <;>\n      norm_num [waveConnection, waveTransverse, waveCovector, waveRaised, Matrix.cons_val_two,\n        Matrix.cons_val_three, Fin.isValue]\n\n/-! ## T4 — o escalar e o Einstein -/\n\n/-- T4a. O escalar de curvatura da onda com torção é nulo. -/\ntheorem o_escalar_da_onda_com_torcao (a c lam : ℝ) (x : Coordinate4) :\n    coordinateScalarCurvature (inverseFrameMetricField (waveInverseSolder a c))\n      (conexaoDaOndaComTorcao a c lam) x = 0 := by\n  simp only [coordinateScalarCurvature, o_ricci_da_onda_com_torcao, wave_inverse_metric_formula]\n  norm_num [Fin.sum_univ_four, eta4, Matrix.vecMulVec, waveCovector, waveRaised,\n    Matrix.cons_val_two, Matrix.cons_val_three, Matrix.diagonal_apply, Fin.isValue]\n  norm_num [Fin.ext_iff]\n  ring\n\n/-- T4b. O tensor de Einstein da onda com torção: igual ao Ricci, `(a + c + 2·lam²) • w⊗w`. -/\ntheorem o_einstein_da_onda_com_torcao (a c lam : ℝ) (x : Coordinate4) :\n    geometricEinsteinTensor (frameMetricField (waveSolder a c))\n      (inverseFrameMetricField (waveInverseSolder a c)) (conexaoDaOndaComTorcao a c lam) x =\n      (a + c + 2 * lam ^ 2) • Matrix.vecMulVec waveCovector waveCovector := by\n  unfold geometricEinsteinTensor\n  rw [o_escalar_da_onda_com_torcao, o_ricci_da_onda_com_torcao]\n  simp only [zero_div, zero_smul, sub_zero]\n\n/-! ## T5 — a onda chata com torção é a onda curva sem torção -/\n\n/-- Auxiliar: `w⊗w` não é nula (entrada (0,0) = 1). -/\ntheorem a_matriz_da_onda_nao_e_nula : (Matrix.vecMulVec waveCovector waveCovector : Tensor4) ≠ 0 := by\n  intro h\n  have hh := congrArg (fun M : Tensor4 => M 0 0) h\n  simp [Matrix.vecMulVec, waveCovector] at hh\n\n/-- T5 ★★. O Einstein da onda com torção (em x) é o Einstein de Levi-Civita de uma onda\n    curva sem torção (em x\', perfil `a\' c\'`) se, e só se, `a\' + c\' = a + c + 2·lam²`.\n    Todo o conteúdo está em T4b: T5 só compara dois múltiplos da mesma matriz não nula. Só a soma\n    `a\' + c\'` é comparada; `a\' − c\'` não é vista; não é igualdade de métrica nem de curvatura completa. -/\ntheorem a_onda_plana_com_torcao_e_a_onda_plana_curva (a c lam a\' c\' : ℝ) (x x\' : Coordinate4) :\n    geometricEinsteinTensor (frameMetricField (waveSolder a c))\n      (inverseFrameMetricField (waveInverseSolder a c)) (conexaoDaOndaComTorcao a c lam) x =\n      frameEinsteinTensor (waveSolder a\' c\') (waveInverseSolder a\' c\') x\' ↔\n        a\' + c\' = a + c + 2 * lam ^ 2 := by\n  rw [o_einstein_da_onda_com_torcao, wave_einstein]\n  constructor\n  · intro h\n    have hh := congrArg (fun M : Tensor4 => M 0 0) h\n    simpa [Matrix.vecMulVec, waveCovector, eq_comm] using hh\n  · intro h\n    rw [h]\n\n/-- T5, corolário. A onda CHATA com torção tem o Einstein da onda CURVA sem torção com\n    `a\' + c\' = 2·lam²`. -/\ntheorem a_onda_chata_com_torcao_e_a_onda_curva_sem_torcao (lam a\' c\' : ℝ) (x x\' : Coordinate4) :\n    geometricEinsteinTensor (frameMetricField (waveSolder 0 0))\n      (inverseFrameMetricField (waveInverseSolder 0 0)) (conexaoDaOndaComTorcao 0 0 lam) x =\n      frameEinsteinTensor (waveSolder a\' c\') (waveInverseSolder a\' c\') x\' ↔\n        a\' + c\' = 2 * lam ^ 2 := by\n  rw [a_onda_plana_com_torcao_e_a_onda_plana_curva]\n  constructor <;> intro h <;> linarith\n\n/-- Não-vacuidade no TENSOR: com `lam ≠ 0` o Einstein da onda chata com torção não é\n    nulo (é `(2·lam²) • w⊗w` e `w⊗w ≠ 0`). -/\ntheorem o_einstein_da_onda_chata_com_torcao_nao_e_nulo (lam : ℝ) (hlam : lam ≠ 0) (x : Coordinate4) :\n    geometricEinsteinTensor (frameMetricField (waveSolder 0 0))\n      (inverseFrameMetricField (waveInverseSolder 0 0)) (conexaoDaOndaComTorcao 0 0 lam) x ≠ 0 := by\n  rw [o_einstein_da_onda_com_torcao]\n  intro h\n  have hh := congrArg (fun M : Tensor4 => M 0 0) h\n  simp only [Matrix.smul_apply, Matrix.vecMulVec_apply, Matrix.zero_apply, smul_eq_mul] at hh\n  have hw : waveCovector 0 = 1 := by simp [waveCovector]\n  rw [hw] at hh\n  have hl : lam ^ 2 = 0 := by linarith\n  exact hlam ((pow_eq_zero_iff (n := 2) (by norm_num)).mp hl)\n\n/-! ## T6 — a amplitude da Ponte -/\n\n/-- A amplitude da torção da Ponte em dimensão 4: `alfa = θ_M / ((n − 1)·ℓ)` com `n = 4`\n    (cabeçalho de `TracialDissipativeTorsion.lean`), `θ_M = thetaMiguel β`. Entra por DEFINIÇÃO; a escala\n    `ell` é entrada. No kernel essa amplitude é escrita para um vetor unitário temporal; ao longo da\n    direção nula ela só tem sentido na normalização fixa de `waveCovector` (ver o cabeçalho). -/\ndef amplitudeDaTorcao (β ell : ℝ) : ℝ := thetaMiguel β / (3 * ell)\n\n/-- T6. Com `lam = amplitudeDaTorcao β ell`, o Einstein da onda chata com torção é\n    `(2·θ_M²/(9·ell²)) • w⊗w` e iguala o da onda curva sem torção se, e só se, `a\' + c\'` é esse número.\n    (Vale também para `ell = 0`, caso degenerado em que os dois lados são zero em ℝ; o caso de interesse\n    é `ell ≠ 0`.) O VALOR de `thetaMiguel β` não é usado na prova: T6 é T5 com `lam` substituído. -/\ntheorem a_onda_plana_curva_e_o_angulo_de_miguel (β ell : ℝ) (a\' c\' : ℝ) (x x\' : Coordinate4) :\n    geometricEinsteinTensor (frameMetricField (waveSolder 0 0))\n      (inverseFrameMetricField (waveInverseSolder 0 0))\n      (conexaoDaOndaComTorcao 0 0 (amplitudeDaTorcao β ell)) x =\n        (2 * thetaMiguel β ^ 2 / (9 * ell ^ 2)) • Matrix.vecMulVec waveCovector waveCovector ∧\n    (geometricEinsteinTensor (frameMetricField (waveSolder 0 0))\n      (inverseFrameMetricField (waveInverseSolder 0 0))\n      (conexaoDaOndaComTorcao 0 0 (amplitudeDaTorcao β ell)) x =\n        frameEinsteinTensor (waveSolder a\' c\') (waveInverseSolder a\' c\') x\' ↔\n          a\' + c\' = 2 * thetaMiguel β ^ 2 / (9 * ell ^ 2)) := by\n  have hk : (0 : ℝ) + 0 + 2 * amplitudeDaTorcao β ell ^ 2 = 2 * thetaMiguel β ^ 2 / (9 * ell ^ 2) := by\n    unfold amplitudeDaTorcao\n    ring\n  refine ⟨?_, ?_⟩\n  · rw [o_einstein_da_onda_com_torcao, hk]\n  · rw [a_onda_plana_com_torcao_e_a_onda_plana_curva, hk]\n\n/-- T6, não-vacuidade DO NÚMERO. Para `β > 0` e `ell ≠ 0` o número `2·θ_M²/(9·ell²)` não é\n    nulo. Para o tensor, ver `o_einstein_da_onda_chata_com_torcao_nao_e_nulo`. -/\ntheorem a_curvatura_do_angulo_de_miguel_nao_e_nula (β ell : ℝ) (hβ : 0 < β) (hell : ell ≠ 0) :\n    2 * thetaMiguel β ^ 2 / (9 * ell ^ 2) ≠ 0 := by\n  have hθ : 0 < thetaMiguel β := Real.arcsin_pos.mpr (Real.sqrt_pos.mpr hβ)\n  have hl : 0 < ell ^ 2 := by positivity\n  positivity\n\n/-! ## T7 — a equação de campo na onda com torção -/\n\n/-- T7. Dado `eta ≠ 0` e o balanço `eta · (a + c + 2·lam²) = 2π · acoplamento`, o Einstein da\n    onda com torção é `(2π/eta)` vezes o tensor de matéria do covetor da onda\n    (`frameCovectorStress … waveCovectorField acoplamento`). O balanço é HIPÓTESE: T7 é T4b reescrito\n    com `wave_matter_formula`; não decide `a`, `c`, `lam` nem `ell`. -/\ntheorem a_equacao_de_campo_na_onda_com_torcao (a c lam eta acoplamento : ℝ) (x : Coordinate4)\n    (heta : eta ≠ 0) (hbal : eta * (a + c + 2 * lam ^ 2) = 2 * Real.pi * acoplamento) :\n    geometricEinsteinTensor (frameMetricField (waveSolder a c))\n      (inverseFrameMetricField (waveInverseSolder a c)) (conexaoDaOndaComTorcao a c lam) x =\n      (2 * Real.pi / eta) •\n        frameCovectorStress (waveSolder a c) (waveInverseSolder a c) waveCovectorField\n          acoplamento x := by\n  have hm : frameCovectorStress (waveSolder a c) (waveInverseSolder a c) waveCovectorField\n      acoplamento x = acoplamento • Matrix.vecMulVec waveCovector waveCovector :=\n    wave_matter_formula a c acoplamento x\n  rw [hm, o_einstein_da_onda_com_torcao, smul_smul]\n  congr 1\n  field_simp\n  linarith\n\n/-- T7, recíproca: se o Einstein da onda com torção é `(2π/eta)` vezes a matéria, vale o\n    balanço. -/\ntheorem a_equacao_de_campo_na_onda_com_torcao_reciproca (a c lam eta acoplamento : ℝ) (x : Coordinate4)\n    (heta : eta ≠ 0)\n    (h : geometricEinsteinTensor (frameMetricField (waveSolder a c))\n      (inverseFrameMetricField (waveInverseSolder a c)) (conexaoDaOndaComTorcao a c lam) x =\n      (2 * Real.pi / eta) •\n        frameCovectorStress (waveSolder a c) (waveInverseSolder a c) waveCovectorField\n          acoplamento x) :\n    eta * (a + c + 2 * lam ^ 2) = 2 * Real.pi * acoplamento := by\n  have hm : frameCovectorStress (waveSolder a c) (waveInverseSolder a c) waveCovectorField\n      acoplamento x = acoplamento • Matrix.vecMulVec waveCovector waveCovector :=\n    wave_matter_formula a c acoplamento x\n  rw [hm, o_einstein_da_onda_com_torcao] at h\n  have hh := congrArg (fun M : Tensor4 => M 0 0) h\n  simp [Matrix.vecMulVec, waveCovector] at hh\n  field_simp at hh\n  linarith\n\n/-! ## T8 — a escala que resta é única -/\n\n/-- T8. Dados `eta > 0`, `acoplamento > 0` e o ângulo `theta > 0`, existe exatamente uma escala\n    `ell > 0` com `eta · 2·(theta/(3·ell))² = 2π · acoplamento` (o balanço de T7 com `a = c = 0` e a\n    amplitude da Ponte). A escala não é derivada aqui: é a que o balanço pede. É a inversão elementar\n    de `ell`; `eta` e o acoplamento são livres e nada liga `ell` a β; `ell` só tem sentido na normalização\n    fixa de `waveCovector` (ver o cabeçalho). -/\ntheorem a_escala_que_resta_e_unica (eta acoplamento theta : ℝ) (heta : 0 < eta)\n    (hac : 0 < acoplamento) (hθ : 0 < theta) :\n    ∃! ell : ℝ, 0 < ell ∧ eta * (2 * (theta / (3 * ell)) ^ 2) = 2 * Real.pi * acoplamento := by\n  have hpi : 0 < Real.pi := Real.pi_pos\n  have hq : 0 < Real.pi * acoplamento / eta := by positivity\n  set s := Real.sqrt (Real.pi * acoplamento / eta) with hs\n  have hs0 : 0 < s := Real.sqrt_pos.mpr hq\n  have hs2 : s ^ 2 = Real.pi * acoplamento / eta := Real.sq_sqrt hq.le\n  refine ⟨theta / (3 * s), ⟨by positivity, ?_⟩, ?_⟩\n  · have : theta / (3 * (theta / (3 * s))) = s := by\n      field_simp\n    rw [this, hs2]\n    field_simp\n  · rintro ell ⟨hell, hbal⟩\n    have hk : 0 < theta / (3 * ell) := by positivity\n    have hk2 : (theta / (3 * ell)) ^ 2 = s ^ 2 := by\n      rw [hs2, eq_div_iff heta.ne\']\n      linarith\n    have hk3 : theta / (3 * ell) = s := (sq_eq_sq₀ hk.le hs0.le).mp hk2\n    rw [div_eq_iff (by positivity)] at hk3\n    rw [eq_div_iff (by positivity)]\n    linarith\n\n/-! ## T9 — controle: a torção ao longo do tempo (métrica plana) -/\n\n/-- O covetor temporal `n = (1, 0, 0, 0)` (controle). -/\ndef nTemporal : Coordinate4 := ![1, 0, 0, 0]\n\n/-- T9. A conexão plana com a torção tracial ao longo do tempo: `Γ^r_{ij} = alfa·(δ^r_i n_j −\n    eta4 i j · n^r)`, com `n^r = nTemporal r` (aqui `eta4 · n = n`). -/\ndef conexaoChataComTorcaoTemporal (alfa : ℝ) : ConnectionField4 :=\n  fun _ i r j => alfa * (TGLExt.TracialTorsion.kd r i * nTemporal j - eta4 i j * nTemporal r)\n\n/-- Uma conexão constante tem jato nulo (controle). -/\ntheorem o_jato_da_conexao_temporal (alfa : ℝ) (x : Coordinate4) (k i : Fin 4) :\n    connectionFirstJet (conexaoChataComTorcaoTemporal alfa) x k i = 0 := by\n  ext r j\n  simp [connectionFirstJet, tensorFieldJet, coordinatePartial, conexaoChataComTorcaoTemporal]\n\n/-- T9. O Ricci da torção temporal: `2·alfa²·(n⊗n − eta4)`. -/\ntheorem o_ricci_da_torcao_temporal (alfa : ℝ) (x : Coordinate4) :\n    coordinateRicci (conexaoChataComTorcaoTemporal alfa) x =\n      (2 * alfa ^ 2) • (Matrix.vecMulVec nTemporal nTemporal - eta4) := by\n  ext b j\n  simp only [coordinateRicci, coordinateCurvature, connectionCurvatureJet, Matrix.sub_apply,\n    Matrix.add_apply, Matrix.mul_apply, Fin.sum_univ_four, o_jato_da_conexao_temporal,\n    Matrix.zero_apply]\n  fin_cases b <;> fin_cases j <;>\n    norm_num [conexaoChataComTorcaoTemporal, nTemporal, eta4, TGLExt.TracialTorsion.kd,\n      Matrix.vecMulVec, Matrix.cons_val_two, Matrix.cons_val_three, Matrix.diagonal_apply,\n      Fin.isValue] <;> norm_num [Fin.ext_iff] <;> ring\n\n/-- T9. O escalar da torção temporal: `−6·alfa²`. -/\ntheorem o_escalar_da_torcao_temporal (alfa : ℝ) (x : Coordinate4) :\n    coordinateScalarCurvature (fun _ => eta4) (conexaoChataComTorcaoTemporal alfa) x =\n      -6 * alfa ^ 2 := by\n  simp only [coordinateScalarCurvature, o_ricci_da_torcao_temporal]\n  norm_num [Fin.sum_univ_four, nTemporal, eta4, Matrix.vecMulVec, Matrix.cons_val_two,\n    Matrix.cons_val_three, Matrix.diagonal_apply, Fin.isValue]\n  ring\n\n/-- T9 (controle). O Einstein da torção temporal em métrica plana: `2·alfa²·n⊗n + alfa²·eta4`.\n    Escrito como `Einstein + (−alfa²)·eta4 = 2·alfa²·n⊗n`: com a torção ao longo do TEMPO aparece o termo\n    proporcional a `eta4` (o que, ao longo da onda nula, não aparece: T4). -/\ntheorem o_einstein_da_torcao_temporal (alfa : ℝ) (x : Coordinate4) :\n    geometricEinsteinTensor (fun _ => eta4) (fun _ => eta4) (conexaoChataComTorcaoTemporal alfa) x +\n        (-alfa ^ 2) • eta4 = (2 * alfa ^ 2) • Matrix.vecMulVec nTemporal nTemporal := by\n  unfold geometricEinsteinTensor\n  rw [o_escalar_da_torcao_temporal, o_ricci_da_torcao_temporal]\n  ext b j\n  simp only [Matrix.add_apply, Matrix.sub_apply, Matrix.smul_apply, smul_eq_mul]\n  ring\n\n/-! ## T10 — a ponte entre as duas contrações do Ricci -/\n\n/-- T10. A contração `ricciOf` da álgebra da torção (`TGLExt.TracialTorsion`) é o\n    `coordinateRicci` da geometria em coordenadas do kernel, para toda conexão `Gamma` (com\n    `Gam a c e := Gamma p c a e` e `dGam w a c e := connectionFirstJet Gamma p w c a e`). -/\ntheorem ricciOf_e_coordinateRicci (Gamma : ConnectionField4) (p : Coordinate4) (b d : Fin 4) :\n    TGLExt.TracialTorsion.ricciOf (ι := Fin 4) (fun a c e => Gamma p c a e)\n      (fun w a c e => connectionFirstJet Gamma p w c a e) b d = coordinateRicci Gamma p b d := by\n  unfold TGLExt.TracialTorsion.ricciOf coordinateRicci\n  refine Finset.sum_congr rfl (fun a _ => ?_)\n  simp only [TGLExt.TracialTorsion.riemann, coordinateCurvature, connectionCurvatureJet,\n    Matrix.sub_apply, Matrix.add_apply, Matrix.mul_apply, Finset.sum_sub_distrib]\n  ring\n\n/-! ## T11 — verificação cruzada: o mesmo Ricci pela forma fechada do kernel -/\n\n/-- A métrica da onda é simétrica (auxiliar). -/\ntheorem a_metrica_da_onda_e_simetrica (a c : ℝ) (x : Coordinate4) (i j : Fin 4) :\n    frameMetricField (waveSolder a c) x i j = frameMetricField (waveSolder a c) x j i := by\n  rw [wave_metric_formula]\n  simp only [Matrix.add_apply, Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]\n  rw [eta4_simetrica i j]\n  ring\n\n/-- A métrica da onda e a sua inversa, componente a componente (auxiliar). -/\ntheorem a_metrica_da_onda_e_a_sua_inversa (a c : ℝ) (x : Coordinate4) (i j : Fin 4) :\n    (∑ k, frameMetricField (waveSolder a c) x i k *\n        inverseFrameMetricField (waveInverseSolder a c) x k j = TGLExt.TracialTorsion.kd i j) ∧\n    (∑ k, inverseFrameMetricField (waveInverseSolder a c) x i k *\n        frameMetricField (waveSolder a c) x k j = TGLExt.TracialTorsion.kd i j) := by\n  have h1 := inverse_frame_metric_right (waveSolder a c) (waveInverseSolder a c) x\n    (wave_solder_inverse a c x) (wave_inverse_solder a c x)\n  have h2 := inverse_frame_metric_left (waveSolder a c) (waveInverseSolder a c) x\n    (wave_solder_inverse a c x) (wave_inverse_solder a c x)\n  constructor\n  · have := congrFun (congrFun h1 i) j\n    rw [Matrix.mul_apply, Matrix.one_apply] at this\n    unfold TGLExt.TracialTorsion.kd\n    exact this\n  · have := congrFun (congrFun h2 i) j\n    rw [Matrix.mul_apply, Matrix.one_apply] at this\n    unfold TGLExt.TracialTorsion.kd\n    exact this\n\n/-- A conexão de Levi-Civita da onda é compatível com a métrica, em forma de componentes: vem do kernel\n    (`levi_civita_field_metric_compatible`), não de uma conta nova. -/\ntheorem a_metrica_da_onda_e_compativel (a c : ℝ) (x : Coordinate4) (i d b : Fin 4) :\n    tensorFieldJet (frameMetricField (waveSolder a c)) x i d b =\n      ∑ e, (waveConnection a c x i e d * frameMetricField (waveSolder a c) x e b +\n            waveConnection a c x i e b * frameMetricField (waveSolder a c) x d e) := by\n  have hm := levi_civita_field_metric_compatible univ isOpen_univ\n    (frameMetricField (waveSolder a c)) (inverseFrameMetricField (waveInverseSolder a c))\n    (fun y _ => frame_metric_symmetric (waveSolder a c) y)\n    (fun y _ => inverse_frame_metric_left _ _ y (wave_solder_inverse a c y)\n      (wave_inverse_solder a c y))\n    (fun y _ => inverse_frame_metric_right _ _ y (wave_solder_inverse a c y)\n      (wave_inverse_solder a c y))\n  have hf := metric_compatibility_formula univ (frameMetricField (waveSolder a c))\n    (leviCivitaField (frameMetricField (waveSolder a c))\n      (inverseFrameMetricField (waveInverseSolder a c))) hm x (mem_univ x) i\n  have hL : leviCivitaField (frameMetricField (waveSolder a c))\n      (inverseFrameMetricField (waveInverseSolder a c)) = waveConnection a c := wave_levi_civita a c\n  rw [hL] at hf\n  have h2 := congrFun (congrFun hf d) b\n  rw [h2]\n  simp only [Matrix.add_apply, Matrix.mul_apply, Matrix.transpose_apply, Finset.sum_add_distrib]\n  congr 1\n  exact Finset.sum_congr rfl (fun e _ => mul_comm _ _)\n\n/-- `∂_k H = 2·T_k`, com `T = waveTransverse` (auxiliar). -/\ntheorem a_derivada_do_perfil_e_o_dobro_do_transverso (a c : ℝ) (x : Coordinate4) (k : Fin 4) :\n    coordinatePartial (waveProfile a c) x k = 2 * waveTransverse a c x k := by\n  rw [wave_profile_partial]\n  fin_cases k <;>\n    norm_num [waveTransverse, Pi.single_apply, Matrix.cons_val_two, Matrix.cons_val_three,\n      Fin.isValue] <;> norm_num [Fin.ext_iff] <;> ring\n\n/-- Troca de somas (auxiliar; é o passo `K1` de `TGLExt.TracialTorsion.covK_Kmix`). -/\ntheorem a_soma_da_derivada_da_inversa (gi dg : Fin 4 → Fin 4 → ℝ) (dgs : Fin 4 → Fin 4 → ℝ)\n    (A : Fin 4 → ℝ) (a\' : Fin 4)\n    (hdgi : ∀ e, dgs a\' e = -∑ f, ∑ h, gi a\' f * dg f h * gi h e) :\n    ∑ e, dgs a\' e * A e =\n      -∑ f, ∑ h, gi a\' f * dg f h * TGLExt.TracialTorsion.raise gi A h := by\n  simp only [hdgi]\n  unfold TGLExt.TracialTorsion.raise\n  simp only [Finset.mul_sum, Finset.sum_mul, neg_mul, Finset.sum_neg_distrib]\n  congr 1\n  rw [Finset.sum_comm]\n  refine Finset.sum_congr rfl (fun f _ => ?_)\n  rw [Finset.sum_comm]\n  refine Finset.sum_congr rfl (fun h _ => Finset.sum_congr rfl (fun e _ => ?_))\n  ring\n\n/-- T11, verificação cruzada. O Ricci da onda com torção sai também da FORMA FECHADA do kernel\n    (`TGLExt.TracialTorsion.ricci_of_tracial_connection`, em `n = 4`): Levi-Civita mais `(n − 2)·A_b A_d`,\n    porque nesta onda `∇A = 0` (T2b), `∇·A = 0` e `A² = 0` (T2a). Os dois caminhos (o cálculo direto de T3\n    e a forma fechada) dão o mesmo número. -/\ntheorem o_ricci_da_onda_com_torcao_pela_forma_fechada_do_kernel (a c lam : ℝ) (x : Coordinate4)\n    (b d : Fin 4) :\n    coordinateRicci (conexaoDaOndaComTorcao a c lam) x b d =\n      coordinateRicci (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x b d +\n        ((Fintype.card (Fin 4) : ℝ) - 2) * ((lam * waveCovector b) * (lam * waveCovector d)) := by\n  set g : Fin 4 → Fin 4 → ℝ := fun p q => frameMetricField (waveSolder a c) x p q with hgd\n  set gi : Fin 4 → Fin 4 → ℝ := fun p q => inverseFrameMetricField (waveInverseSolder a c) x p q\n    with hgid\n  set A : Fin 4 → ℝ := fun e => lam * waveCovector e with hAd\n  set G0 : Fin 4 → Fin 4 → Fin 4 → ℝ := fun r i j => waveConnection a c x i r j with hG0d\n  set dG0 : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ :=\n    fun w r i j => waveConnection a c (Pi.single w 1) i r j with hdG0d\n  set dK : Fin 4 → Fin 4 → Fin 4 → Fin 4 → ℝ := fun w r i j =>\n    -(2 * waveTransverse a c x w * lam) * (waveCovector i * waveCovector j * waveRaised r)\n    with hdKd\n  set dg : Fin 4 → Fin 4 → Fin 4 → ℝ := fun c\' d\' b\' =>\n    2 * waveTransverse a c x c\' * (waveCovector d\' * waveCovector b\') with hdgd\n  set dgi : Fin 4 → Fin 4 → Fin 4 → ℝ := fun c\' a\' e\' =>\n    -∑ f, ∑ h, gi a\' f * dg c\' f h * gi h e\' with hdgid\n  set dA : Fin 4 → Fin 4 → ℝ := fun _ _ => 0 with hdAd\n  have hg : ∀ i j, g i j = g j i := fun i j => a_metrica_da_onda_e_simetrica a c x i j\n  have hinv : ∀ i j, ∑ k, g i k * gi k j = TGLExt.TracialTorsion.kd i j :=\n    fun i j => (a_metrica_da_onda_e_a_sua_inversa a c x i j).1\n  have hinv\' : ∀ i j, ∑ k, gi i k * g k j = TGLExt.TracialTorsion.kd i j :=\n    fun i j => (a_metrica_da_onda_e_a_sua_inversa a c x i j).2\n  have hsym : ∀ e p q, G0 e p q = G0 e q p :=\n    fun e p q => wave_connection_torsion_free a c x p q e\n  have hdg : ∀ c\' d\' b\', dg c\' d\' b\' = ∑ e, (G0 e c\' d\' * g e b\' + G0 e c\' b\' * g d\' e) := by\n    intro c\' d\' b\'\n    have h1 := a_metrica_da_onda_e_compativel a c x c\' d\' b\'\n    have h2 := congrFun (congrFun (wave_metric_jet a c x c\') d\') b\'\n    simp only [Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul] at h2\n    show dg c\' d\' b\' = ∑ e, (waveConnection a c x c\' e d\' * frameMetricField (waveSolder a c) x e b\' +\n      waveConnection a c x c\' e b\' * frameMetricField (waveSolder a c) x d\' e)\n    rw [← h1, h2]\n  have hraise : ∀ r, TGLExt.TracialTorsion.raise gi A r = lam * waveRaised r :=\n    fun r => o_levantamento_do_vetor_da_onda a c lam x r\n  have hww : ∑ h, waveCovector h * waveRaised h = 0 := by\n    norm_num [Fin.sum_univ_four, waveCovector, waveRaised, Matrix.cons_val_two,\n      Matrix.cons_val_three, Fin.isValue]\n  have hdK : ∀ c\' a\' d\' b\', dK c\' a\' d\' b\' = TGLExt.TracialTorsion.kd a\' d\' * dA c\' b\' -\n      dg c\' d\' b\' * TGLExt.TracialTorsion.raise gi A a\' -\n      g d\' b\' * (∑ e, dgi c\' a\' e * A e + ∑ e, gi a\' e * dA c\' e) := by\n    intro c\' a\' d\' b\'\n    have h2 : ∑ e, dgi c\' a\' e * A e = 0 := by\n      rw [a_soma_da_derivada_da_inversa gi (dg c\') (dgi c\') A a\' (fun e => rfl)]\n      rw [neg_eq_zero]\n      refine Finset.sum_eq_zero (fun f _ => ?_)\n      have : ∀ h, gi a\' f * dg c\' f h * TGLExt.TracialTorsion.raise gi A h =\n          (gi a\' f * (2 * waveTransverse a c x c\' * waveCovector f * lam)) *\n            (waveCovector h * waveRaised h) := by\n        intro h\n        rw [hraise h]\n        simp only [hdgd]\n        ring\n      simp only [this]\n      rw [← Finset.mul_sum, hww, mul_zero]\n    rw [h2, hraise a\']\n    simp only [hdAd, hdKd, hdgd, mul_zero, Finset.sum_const_zero, add_zero, sub_zero]\n    ring\n  have key := TGLExt.TracialTorsion.ricci_of_tracial_connection (ι := Fin 4) g gi hg hinv hinv\'\n    G0 dG0 dK A dg dgi dA hsym hdg (fun _ _ _ => rfl) hdK b d\n  have e1 : (fun r i j => conexaoDaOndaComTorcao a c lam x i r j) =\n      (fun p q r => G0 p q r + TGLExt.TracialTorsion.Kmix g gi A p q r) := by\n    funext r i j\n    rw [a_conexao_com_torcao_e_levi_civita_mais_a_contorcao_do_kernel, wave_levi_civita]\n  have e2 : (fun w r i j => connectionFirstJet (conexaoDaOndaComTorcao a c lam) x w i r j) =\n      (fun w p q r => dG0 w p q r + dK w p q r) := by\n    funext w r i j\n    rw [o_jato_da_conexao_com_torcao, a_derivada_do_perfil_e_o_dobro_do_transverso]\n    simp only [hdG0d, hdKd]\n    ring\n  have e3 : (fun w r i j => connectionFirstJet (waveConnection a c) x w i r j) = dG0 := by\n    funext w r i j\n    exact congrFun (congrFun (wave_connection_jet a c x w i) r) j\n  have hLC : coordinateRicci (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x b d =\n      TGLExt.TracialTorsion.ricciOf G0 dG0 b d := by\n    rw [wave_levi_civita, ← ricciOf_e_coordinateRicci (waveConnection a c) x b d, e3]\n  have hcov : ∀ p q, ∑ e, G0 e p q * A e = 0 := by\n    intro p q\n    have := o_vetor_da_torcao_e_covariantemente_constante a c x p q\n    simp only [hG0d, hAd]\n    calc ∑ e, waveConnection a c x p e q * (lam * waveCovector e)\n        = lam * ∑ e, waveConnection a c x p e q * waveCovector e := by\n          rw [Finset.mul_sum]\n          exact Finset.sum_congr rfl (fun e _ => by ring)\n      _ = 0 := by rw [this, mul_zero]\n  have hns : TGLExt.TracialTorsion.normSq gi A = 0 := o_vetor_da_torcao_na_onda_e_nulo a c lam x\n  have hdiv : TGLExt.TracialTorsion.divA gi (fun p q => dA p q - ∑ e, G0 e p q * A e) = 0 := by\n    unfold TGLExt.TracialTorsion.divA\n    simp only [hcov, hdAd, sub_zero, mul_zero, Finset.sum_const_zero]\n  rw [← ricciOf_e_coordinateRicci (conexaoDaOndaComTorcao a c lam) x b d, e1, e2, key, hLC, hdiv, hns]\n  simp only [hcov, hdAd, sub_zero, mul_zero]\n  ring\n\n/-- T11, em `n = 4`: o mesmo resultado com o número escrito, `(n − 2) = 2`. -/\ntheorem a_forma_fechada_da_onda_com_torcao_em_n4 (a c lam : ℝ) (x : Coordinate4) (b d : Fin 4) :\n    coordinateRicci (conexaoDaOndaComTorcao a c lam) x b d =\n      coordinateRicci (frameLeviCivita (waveSolder a c) (waveInverseSolder a c)) x b d +\n        2 * ((lam * waveCovector b) * (lam * waveCovector d)) := by\n  rw [o_ricci_da_onda_com_torcao_pela_forma_fechada_do_kernel]\n  simp only [Fintype.card_fin]\n  norm_num\n\n/-- Os dois caminhos juntos: T11 (a forma fechada do kernel) mais `wave_ricci` (o Ricci de\n    Levi-Civita da onda) dão, entrada a entrada, o Ricci de T3, sem usar T3. -/\ntheorem os_dois_caminhos_dao_o_mesmo_ricci (a c lam : ℝ) (x : Coordinate4) (b d : Fin 4) :\n    coordinateRicci (conexaoDaOndaComTorcao a c lam) x b d =\n      (a + c + 2 * lam ^ 2) * (waveCovector b * waveCovector d) := by\n  rw [a_forma_fechada_da_onda_com_torcao_em_n4, wave_ricci]\n  simp only [Matrix.smul_apply, Matrix.vecMulVec_apply, smul_eq_mul]\n  ring\n\nend\n\nend TGLExt.TorcaoNaOndaPlana\n',
+    'TGLExt/AFasesDaMaquina.lean': "import TGLExt.AMaquinaTM2DaVerificacao\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\nset_option maxRecDepth 8192\n\n/-!\n# A simulação da máquina TM2: as fases elementares — passos, laços de movimento, partida e parada\n\n## O que é\n\nA máquina `aMaquinaTM2` (pedra `AMaquinaTM2DaVerificacao`) é a máquina TM2 de cinco pilhas desenhada para\nverificar uma CNF com uma testemunha dada na entrada (`codificaEntrada p`: a fórmula `p.1` e os bits `p.2`, nas\ncodificações fixas de `APonteAoTM2`). Em `AMaquinaTM2DaVerificacao`, a simulação geral é a proposição\n`ASimulacaoCompleta`, usada como hipótese em `o_objetivo_se_reduz_a_simulacao`; a sua prova está em\n`OLacoDasClausulas` (e, por outro caminho, em `SimTM2.simulacao_completa`). Esta pedra prova as fases elementares dessa simulação: o\npasso de cada rótulo dos laços de movimento, os laços que movem símbolos entre pilhas (`preparar`, `reverter`,\n`limparFormula`, `limparEntrada`), a partida (da configuração inicial ao laço das cláusulas) e a parada (da\nlimpeza ao `halt` com o bit da resposta).\n\n## A forma da prova\n\nAs configurações se escrevem com as cinco pilhas nomeadas (`cfgStacks`, `cfg`, `cfgH`), e os laços raciocinam\npor componente. Cada lema de passo reescreve a cabeça da pilha lida e fecha a igualdade de configurações ponto\na ponto (`cfg_fecha` + `fin_cases`). Os lemas de laço são `def` (o `EvalsToInTime` do Mathlib é uma estrutura\nem `Type`, não uma proposição), cada um uma indução na lista movida, com a cota de uma invocação de rótulo por\nsímbolo, mais a detecção do fim. A composição é por `StateTransition.EvalsToInTime.trans`; a igualdade das\nconfigurações finais, por `evals_congr`; a folga da cota, por `custo_mono`. Nenhum laço é provado por\n`decide`: as listas são variáveis (pilhas simbólicas). O estado é (carregador, bandeira, rota); a bandeira\natravessa as limpezas intacta, porque, no estado, elas alteram só a rota.\n\n## O que fica provado\n\n1. Os passos elementares: `passo_preparar_sep`, `passo_preparar_move`, `passo_reverter_move`,\n   `passo_reverter_vazio`, `passo_limparFormula_move`, `passo_limparFormula_vazio`, `passo_limparEntrada_move`,\n   `passo_limparEntrada_vazio`, `passo_escrever`.\n2. Os laços: `fase_preparar` (a fórmula vai à pilha de trabalho, invertida, e a divisória é consumida),\n   `fase_reverter` (a inversão da inversão: a fórmula fica na pilha própria, na ordem original),\n   `fase_limparFormula`, `fase_limparEntrada` (esvaziam as pilhas preservando a bandeira). Cada um com a cota\n   de passos `comprimento da lista + 1`.\n3. `sep_nao_entra_na_formula`: a divisória nunca aparece na fórmula codificada.\n4. ★ `a_partida`: da configuração inicial do modelo, em no máximo `2·(Lf + 1)` passos (`Lf` = comprimento da\n   fórmula codificada) a máquina está no laço das cláusulas — a fórmula na pilha própria, os bits da\n   testemunha na entrada, as demais pilhas vazias.\n5. ★ `a_parada`: do início da limpeza, com a pilha de trabalho, o depósito e a saída vazios, em no máximo\n   `F + E + 3` passos a máquina para exatamente na configuração final do modelo (`haltList`), com a bandeira\n   na pilha de saída.\n\nAs cotas de passos são cotas (`EvalsToInTime`: passos ≤ teto), não igualdades.\n\n## O que NÃO se afirma\n\n* O ciclo do literal (as caminhadas dos ticks e dos bits, a comparação, o restaurar) e o laço das cláusulas\n  não são provados aqui: estão em `ACicloDoLiteral` e `OLacoDasClausulas`.\n* Nenhuma máquina é dita decidir SAT em tempo polinomial: a máquina simulada é a verificadora, que recebe a\n  testemunha na entrada. Decidir SAT sem testemunha, em tempo polinomial, na máquina de fita segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AFasesDaMaquina\n\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao StateTransition\n\n/-- O tipo das cinco pilhas (a saída é booleana; as demais, do alfabeto). -/\nabbrev Pilhas := ∀ k : PilhaK, List (stackAlphabet k)\n\n/-- [DEF] As pilhas por nome — a forma em que a simulação raciocina. -/\ndef cfgStacks (e fo t d : List Simbolo) (sa : List Bool) : Pilhas\n  | .entrada => e\n  | .saida => sa\n  | .formula => fo\n  | .trabalho => t\n  | .deposito => d\n\n/-- [DEF] A configuração corrente com as pilhas nomeadas. -/\ndef cfg (l : Rotulo) (v : Estado) (e fo t d : List Simbolo) (sa : List Bool) :\n    Turing.TM2.Cfg stackAlphabet Rotulo Estado :=\n  ⟨some l, v, cfgStacks e fo t d sa⟩\n\n/-- [DEF] A configuração de parada com as pilhas nomeadas. -/\ndef cfgH (e fo t d : List Simbolo) (sa : List Bool) : Turing.TM2.Cfg stackAlphabet Rotulo Estado :=\n  ⟨none, (none, false, false), cfgStacks e fo t d sa⟩\n\n/-- A igualdade de configurações passa ao `some` (congruência). (Auxiliar.) -/\ntheorem algum_inj {A B : Turing.TM2.Cfg stackAlphabet Rotulo Estado} (h : A = B) :\n    (some A : Option (Turing.TM2.Cfg stackAlphabet Rotulo Estado)) = some B :=\n  congrArg some h\n\n/-- O fechamento da igualdade de configurações, ponto a ponto: rótulo, estado, e as pilhas por `fin_cases`.\n(Auxiliar.) -/\ntheorem cfg_fecha {l₁ l₂ : Option Rotulo} {v₁ v₂ : Estado} {S₁ S₂ : Pilhas}\n    (hl : l₁ = l₂) (hv : v₁ = v₂) (h : ∀ k, S₁ k = S₂ k) :\n    (⟨l₁, v₁, S₁⟩ : Turing.TM2.Cfg stackAlphabet Rotulo Estado) = ⟨l₂, v₂, S₂⟩ :=\n  (Turing.TM2.Cfg.mk.injEq ..).mpr ⟨hl, hv, funext h⟩\n\n/-- Folga na cota: os passos são os mesmos, o teto cresce. (Auxiliar da composição.) -/\ndef custo_mono {a : Turing.TM2.Cfg stackAlphabet Rotulo Estado}\n    {c : Option (Turing.TM2.Cfg stackAlphabet Rotulo Estado)} {m m' : ℕ}\n    (h : EvalsToInTime aMaquinaTM2.step a c m) (hm : m ≤ m') : EvalsToInTime aMaquinaTM2.step a c m' :=\n  ⟨h.toEvalsTo, Nat.le_trans h.steps_le_m hm⟩\n\n/-- Um passo é uma avaliação em tempo 1. (Auxiliar da composição.) -/\ndef passo_unico {a b : Turing.TM2.Cfg stackAlphabet Rotulo Estado}\n    (h : aMaquinaTM2.step a = some b) : EvalsToInTime aMaquinaTM2.step a (some b) 1 :=\n  ⟨⟨1, h⟩, Nat.le_refl 1⟩\n\n/-- Igualdade de configuração final: os passos são os mesmos, o destino é reescrito. (Auxiliar da composição.) -/\ndef evals_congr {a : Turing.TM2.Cfg stackAlphabet Rotulo Estado}\n    {c₁ c₂ : Option (Turing.TM2.Cfg stackAlphabet Rotulo Estado)} {m : ℕ}\n    (h : c₁ = c₂) (hE : EvalsToInTime aMaquinaTM2.step a c₁ m) : EvalsToInTime aMaquinaTM2.step a c₂ m :=\n  h ▸ hE\n\n/-- A cabeça da lista invertida como primeira escolha. (Auxiliar dos estados dos laços.) -/\ntheorem cabeca_reverse_cons (v : Option Simbolo) (s : Simbolo) (F : List Simbolo) :\n    (F.reverse.head? <|> some s) = ((s :: F).reverse.head? <|> v) := by\n  cases F with\n  | nil => rfl\n  | cons s' F' =>\n    have hne : (s' :: F').reverse ≠ [] := by simp\n    simp [List.reverse_cons, List.head?_append, hne]\n\n/-- ★ A divisória nunca aparece na fórmula codificada: a preparação para no lugar certo. -/\ntheorem sep_nao_entra_na_formula (φf : List (List (ℕ × Bool))) :\n    Simbolo.sep ∉ codificaFormula φf := by\n  intro h\n  simp only [codificaFormula, List.mem_append, List.mem_flatMap, List.mem_singleton] at h\n  rcases h with ⟨C, hCφ, hC⟩ | hF\n  · simp only [codificaClausula, List.mem_append, List.mem_flatMap, List.mem_singleton] at hC\n    rcases hC with ⟨p, hpC, hp⟩ | hFimC\n    · simp only [codificaLiteral, List.mem_cons, List.mem_replicate] at hp\n      rcases hp with hmar | ⟨_, htic⟩\n      · split_ifs at hmar <;> exact Simbolo.noConfusion hmar\n      · exact Simbolo.noConfusion htic\n    · exact Simbolo.noConfusion hFimC\n  · exact Simbolo.noConfusion hF\n\n/-! ## Os passos elementares -/\n\n/-- O passo da preparação ao ver a divisória: consome-a e vai reverter. -/\ntheorem passo_preparar_sep (v : Estado) (rest fo t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .preparar v (Simbolo.sep :: rest) fo t d sa)\n      = some (cfg .reverter (v.1, true, v.2.2) rest fo t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- O passo da preparação ao ver um símbolo da fórmula: move-o à pilha de trabalho. -/\ntheorem passo_preparar_move (v : Estado) (s : Simbolo) (rest fo t d : List Simbolo) (sa : List Bool)\n    (hs : s ≠ Simbolo.sep) :\n    aMaquinaTM2.step (cfg .preparar v (s :: rest) fo t d sa)\n      = some (cfg .preparar (some s, false, v.2.2) rest fo (s :: t) d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons, Option.getD_some]\n  simp only [show (some s = some Simbolo.sep) ↔ False from by simp [hs]]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- O passo da reversão com a pilha de trabalho vazia: vai ao laço das cláusulas. -/\ntheorem passo_reverter_vazio (v : Estado) (e fo d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .reverter v e fo [] d sa)\n      = some (cfg .lerClausula (v.1, true, v.2.2) e fo [] d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_nil]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> rfl\n\n/-- O passo da reversão com símbolo: move-o à pilha da fórmula. -/\ntheorem passo_reverter_move (v : Estado) (e fo : List Simbolo) (s : Simbolo) (rest d : List Simbolo)\n    (sa : List Bool) :\n    aMaquinaTM2.step (cfg .reverter v e fo (s :: rest) d sa)\n      = some (cfg .reverter (some s, false, v.2.2) e (s :: fo) rest d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons, Option.getD_some]\n  simp only [show ((some s : Option Simbolo) = none) ↔ False from by simp]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- O passo da limpeza da fórmula com símbolo: descarta-o, com a bandeira intacta. -/\ntheorem passo_limparFormula_move (v : Estado) (e : List Simbolo) (s : Simbolo) (rest t d : List Simbolo)\n    (sa : List Bool) :\n    aMaquinaTM2.step (cfg .limparFormula v e (s :: rest) t d sa)\n      = some (cfg .limparFormula (v.1, v.2.1, false) e rest t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons]\n  simp only [show ((some s : Option Simbolo) = none) ↔ False from by simp]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- O passo da limpeza da fórmula vazia: vai limpar a entrada, com a bandeira intacta. -/\ntheorem passo_limparFormula_vazio (v : Estado) (e t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .limparFormula v e [] t d sa)\n      = some (cfg .limparEntrada (v.1, v.2.1, true) e [] t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_nil]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> rfl\n\n/-- O passo da limpeza da entrada com símbolo: descarta-o, com a bandeira intacta. -/\ntheorem passo_limparEntrada_move (v : Estado) (s : Simbolo) (rest fo t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .limparEntrada v (s :: rest) fo t d sa)\n      = some (cfg .limparEntrada (v.1, v.2.1, false) rest fo t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons]\n  simp only [show ((some s : Option Simbolo) = none) ↔ False from by simp]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- O passo da limpeza da entrada vazia: vai escrever, com a bandeira intacta. -/\ntheorem passo_limparEntrada_vazio (v : Estado) (fo t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .limparEntrada v [] fo t d sa)\n      = some (cfg .escrever (v.1, v.2.1, true) [] fo t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_nil]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> rfl\n\n/-- O passo da escrita: a bandeira vai à pilha de saída, o estado inicial é reposto, e a máquina para. -/\ntheorem passo_escrever (v : Estado) (e fo t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .escrever v e fo t d sa)\n      = some (cfgH e fo t d (v.2.1 :: sa)) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgH,\n    cfgStacks]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-! ## Os laços de movimento -/\n\n/-- ★ O LAÇO DA PREPARAÇÃO: a fórmula sai da entrada para a pilha de trabalho (invertida), a divisória é\nconsumida, e a máquina vai reverter. Cota: `F.length + 1` passos (um por símbolo, mais a divisória). -/\ndef fase_preparar (v : Estado) (fo t d : List Simbolo) (sa : List Bool) (F B : List Simbolo)\n    (hsep : Simbolo.sep ∉ F) :\n    EvalsToInTime aMaquinaTM2.step (cfg .preparar v (F ++ [Simbolo.sep] ++ B) fo t d sa)\n      (some (cfg .reverter (F.reverse.head? <|> v.1, true, v.2.2) B fo (F.reverse ++ t) d sa)) (F.length + 1) := by\n  induction F generalizing v t with\n  | nil =>\n    have h1 := passo_preparar_sep v B fo t d sa\n    refine evals_congr ?_ (passo_unico h1)\n    simp [List.reverse_nil, List.nil_append]\n  | cons s F' ih =>\n    have hs : s ≠ Simbolo.sep := by\n      intro hss\n      apply hsep\n      rw [hss]\n      exact List.mem_cons_self\n    have hsep' : Simbolo.sep ∉ F' := fun hm => hsep (List.mem_cons_of_mem s hm)\n    have h1 := passo_preparar_move v s (F' ++ [Simbolo.sep] ++ B) fo t d sa hs\n    have h2 := ih (some s, false, v.2.2) (s :: t) hsep'\n    refine evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2)\n    apply algum_inj\n    apply cfg_fecha rfl\n    · show (F'.reverse.head? <|> (some s, false, v.2.2).1, true, (some s, false, v.2.2).2.2)\n        = ((s :: F').reverse.head? <|> v.1, true, v.2.2)\n      rw [cabeca_reverse_cons]\n    · intro k; fin_cases k <;> simp [cfgStacks, List.reverse_cons, List.append_assoc, List.singleton_append]\n\n/-- ★ O LAÇO DA REVERSÃO: a inversão da inversão — a fórmula fica na pilha própria, na ordem original. Cota:\n`W.length + 1` passos (um por símbolo, mais a pilha vazia). -/\ndef fase_reverter (v : Estado) (e fo d : List Simbolo) (sa : List Bool) (W : List Simbolo) :\n    EvalsToInTime aMaquinaTM2.step (cfg .reverter v e fo W d sa)\n      (some (cfg .lerClausula (W.reverse.head? <|> v.1, true, v.2.2) e (W.reverse ++ fo) [] d sa))\n      (W.length + 1) := by\n  induction W generalizing v fo with\n  | nil =>\n    have h1 := passo_reverter_vazio v e fo d sa\n    refine evals_congr ?_ (passo_unico h1)\n    simp [List.reverse_nil, List.nil_append]\n  | cons s W' ih =>\n    have h1 := passo_reverter_move v e fo s W' d sa\n    have h2 := ih (some s, false, v.2.2) (s :: fo)\n    refine evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2)\n    apply algum_inj\n    apply cfg_fecha rfl\n    · show (W'.reverse.head? <|> (some s, false, v.2.2).1, true, (some s, false, v.2.2).2.2)\n        = ((s :: W').reverse.head? <|> v.1, true, v.2.2)\n      rw [cabeca_reverse_cons]\n    · intro k; fin_cases k <;> simp [cfgStacks, List.reverse_cons, List.append_assoc, List.singleton_append]\n\n/-- ★ O LAÇO DA LIMPEZA DA FÓRMULA: esvazia a pilha da fórmula preservando a bandeira. Cota: `F.length + 1` passos. -/\ndef fase_limparFormula (v : Estado) (e t d : List Simbolo) (sa : List Bool) (F : List Simbolo) :\n    EvalsToInTime aMaquinaTM2.step (cfg .limparFormula v e F t d sa)\n      (some (cfg .limparEntrada (v.1, v.2.1, true) e [] t d sa)) (F.length + 1) := by\n  induction F generalizing v with\n  | nil => exact passo_unico (passo_limparFormula_vazio v e t d sa)\n  | cons s F' ih =>\n    have h1 := passo_limparFormula_move v e s F' t d sa\n    have h2 := ih (v.1, v.2.1, false)\n    exact EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2\n\n/-- ★ O LAÇO DA LIMPEZA DA ENTRADA: esvazia a entrada preservando a bandeira. Cota: `E.length + 1` passos. -/\ndef fase_limparEntrada (v : Estado) (fo t d : List Simbolo) (sa : List Bool) (E : List Simbolo) :\n    EvalsToInTime aMaquinaTM2.step (cfg .limparEntrada v E fo t d sa)\n      (some (cfg .escrever (v.1, v.2.1, true) [] fo t d sa)) (E.length + 1) := by\n  induction E generalizing v with\n  | nil => exact passo_unico (passo_limparEntrada_vazio v fo t d sa)\n  | cons s E' ih =>\n    have h1 := passo_limparEntrada_move v s E' fo t d sa\n    have h2 := ih (v.1, v.2.1, false)\n    exact EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2\n\n/-! ## A partida e a parada -/\n\n/-- A configuração inicial do modelo é a forma nomeada da partida, pilha a pilha. (Auxiliar.) -/\ntheorem initList_stacks (l : List Simbolo) (k : PilhaK) :\n    (Turing.initList aMaquinaTM2 l).stk k = cfgStacks l [] [] [] [] k := by\n  fin_cases k <;> simp [Turing.initList, aMaquinaTM2, cfgStacks]\n\n/-- A configuração inicial do modelo é a forma nomeada da partida. (Auxiliar.) -/\ntheorem initList_cfg (l : List Simbolo) :\n    Turing.initList aMaquinaTM2 l = cfg .preparar (none, false, false) l [] [] [] [] := by\n  apply (Turing.TM2.Cfg.mk.injEq ..).mpr\n  refine ⟨?_, ?_, funext (initList_stacks l)⟩\n  · show (some aMaquinaTM2.main : Option Rotulo) = some Rotulo.preparar; rfl\n  · show aMaquinaTM2.initialState = (none, false, false); rfl\n\n/-- A configuração final da parada, com tudo vazio, é a do modelo, pilha a pilha. (Auxiliar.) -/\ntheorem haltList_stacks (b : Bool) (k : PilhaK) :\n    (Turing.haltList aMaquinaTM2 [b]).stk k = cfgStacks [] [] [] [] [b] k := by\n  fin_cases k <;> simp [Turing.haltList, aMaquinaTM2, cfgStacks]\n\n/-- A configuração final da parada, com tudo vazio, é a do modelo. (Auxiliar.) -/\ntheorem cfgH_haltList (b : Bool) :\n    cfgH [] [] [] [] [b] = Turing.haltList aMaquinaTM2 [b] := by\n  apply (Turing.TM2.Cfg.mk.injEq ..).mpr\n  refine ⟨rfl, ?_, funext fun k => (haltList_stacks b k).symm⟩\n  · show (none, false, false) = aMaquinaTM2.initialState; rfl\n\n/-- ★ **A PARTIDA**: da configuração inicial do modelo, em no máximo `2·(Lf + 1)` passos a máquina está pronta\npara o laço das cláusulas — a fórmula na pilha própria, a testemunha na entrada, as demais pilhas vazias. -/\ndef a_partida (p : List (List (ℕ × Bool)) × List Bool) :\n    EvalsToInTime aMaquinaTM2.step (Turing.initList aMaquinaTM2 (codificaEntrada p))\n      (some (cfg .lerClausula\n        ((codificaFormula p.1).head? <|> ((codificaFormula p.1).reverse.head? <|> none), true, false)\n        (codificaBits p.2) (codificaFormula p.1) [] [] []))\n      (2 * ((codificaFormula p.1).length + 1)) := by\n  rw [initList_cfg]\n  have h1 := fase_preparar (none, false, false) [] [] [] [] (codificaFormula p.1) (codificaBits p.2)\n    (sep_nao_entra_na_formula p.1)\n  have h2 := fase_reverter ((codificaFormula p.1).reverse.head? <|> none, true, false)\n    (codificaBits p.2) [] [] [] ((codificaFormula p.1).reverse ++ [])\n  refine custo_mono (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ h1 h2)) ?_\n  · apply algum_inj\n    apply cfg_fecha rfl\n    · show (((codificaFormula p.1).reverse ++ []).reverse.head? <|>\n          ((codificaFormula p.1).reverse.head? <|> none), true, false)\n        = ((codificaFormula p.1).head? <|> ((codificaFormula p.1).reverse.head? <|> none), true, false)\n      simp [List.reverse_reverse, List.append_nil]\n    · intro k; fin_cases k <;> simp [cfgStacks, List.reverse_reverse, List.append_nil]\n  · simp only [List.length_reverse, List.length_append, List.length_nil]; omega\n\n/-- ★ **A PARADA**: do início da limpeza (com a resposta na bandeira), em no máximo `F + E + 3` passos a\nmáquina para exatamente na configuração final do modelo — o `haltList` com a bandeira na saída e as\ndemais pilhas vazias. -/\ndef a_parada (v : Estado) (E F : List Simbolo) :\n    EvalsToInTime aMaquinaTM2.step (cfg .limparFormula v E F [] [] [])\n      (some (Turing.haltList aMaquinaTM2 [v.2.1])) (F.length + E.length + 3) := by\n  have h1 := fase_limparFormula v E [] [] [] F\n  have h2 := fase_limparEntrada (v.1, v.2.1, true) [] [] [] [] E\n  have h3 := passo_escrever (v.1, v.2.1, true) [] [] [] [] []\n  have hcomp := EvalsToInTime.trans _ _ _ _ _ _ h1 (EvalsToInTime.trans _ _ _ _ _ _ h2 (passo_unico h3))\n  refine custo_mono (evals_congr ?_ hcomp) ?_\n  · apply algum_inj\n    show cfgH [] [] [] [] [v.2.1] = Turing.haltList aMaquinaTM2 [v.2.1]\n    exact cfgH_haltList v.2.1\n  · omega\n\nend TGLExt.AFasesDaMaquina\n\n",
+    'TGLExt/ACicloDoLiteral.lean': "import TGLExt.AFasesDaMaquina\r\n\r\nset_option autoImplicit false\r\nset_option maxHeartbeats 800000\r\nset_option maxRecDepth 8192\r\n\r\n/-!\r\n# A simulação da máquina TM2: o ciclo do literal — o coração da verificação\r\n\r\n## O que é\r\n\r\nSobre a máquina `aMaquinaTM2` e as configurações `cfg` de `AFasesDaMaquina`, o ciclo de UM literal: ler o\r\nmarcador com a polaridade, caminhar os ticks (o índice em unário), caminhar os bits da testemunha até a posição,\r\nler o bit, comparar com a polaridade, restaurar a testemunha na ordem original — e rotear: satisfeito leva a\r\n`saltarResto`, falha leva a `proximoLiteralCheck`. É o trecho em que a máquina lê o bit da testemunha.\r\n\r\nOs custos abaixo são LIMITES SUPERIORES: `EvalsToInTime f a b m` afirma que `b` é alcançado a partir de `a` em no\r\nmáximo `m` passos (por isso vale `custo_mono`, que só aumenta `m`).\r\n\r\n## O que fica provado\r\n\r\n1. Os passos elementares do ciclo: `passo_lerLiteral`, `passo_andarTicks_move`, `passo_andarTicks_fim`,\r\n   `passo_andarBits_move`, `passo_andarBits_fimTicks`, `passo_andarBits_fimBits`, `passo_lerBitAtual`,\r\n   `passo_esvaziarTicks_move`, `passo_esvaziarTicks_fim`, `passo_comparar_satisfeito`, `passo_comparar_falha`,\r\n   `passo_clausulaSatisfeita`, `passo_proximoLiteral`, `passo_restaurar_move`, `passo_restaurar_fim`.\r\n2. Os laços: `fase_andarTicks` (os ticks à pilha de trabalho), `fase_andarBits_coberto` (a caminhada dos bits\r\n   quando o índice cabe na testemunha, `i ≤ |E|`), `fase_andarBits_alem` (a testemunha acaba antes, `|E| < i`:\r\n   o bit é ausente), `fase_esvaziarTicks` (descartar os ticks que sobram), `fase_restaurar` (o depósito `X` volta\r\n   à entrada como `X.reverse ++ e`: a testemunha devolvida na ordem original).\r\n3. ★ Os três ciclos completos do literal, com limite de custo: `ciclo_literal_satisfeito` (no máximo `3·i + 7`\r\n   passos, destino `saltarResto`), `ciclo_literal_falha` (o bit na posição não é o esperado, inclusive em\r\n   `i = |E|`, onde não há bit: no máximo `3·i + 7`, destino `proximoLiteralCheck`), `ciclo_literal_fora` (índice\r\n   além da testemunha, `|E| < i`: no máximo `2·i + |E| + 7`, destino `proximoLiteralCheck` — o `none` da borda\r\n   falha o literal; quando `E` é a testemunha codificada, é o teste `bits[i]? == some b` da `verificaNaFita`,\r\n   ver `o_teste_e_o_da_fita`). Nos três, partindo com as pilhas de trabalho e de depósito vazias e com o símbolo\r\n   seguinte da fórmula diferente de tick, a testemunha volta intacta e essas pilhas terminam vazias. A ordem dos\r\n   argumentos de `cfg` é: rótulo, estado, entrada, fórmula, trabalho, depósito, saída.\r\n4. A ponte semântica do bit: `bit_na_fita` (o símbolo na posição `i` da testemunha codificada) e\r\n   `o_teste_e_o_da_fita` (`(codificaBits bits)[i]? = esperado b ↔ (bits[i]? == some b)`: o teste da máquina é o\r\n   teste por literal da `verificaNaFita`).\r\n\r\n## O que NÃO se afirma\r\n\r\n* O laço das cláusulas (a composição dos ciclos com `lerClausula`, `saltarResto`, `proximoLiteralCheck`) não é\r\n  provado neste módulo.\r\n* Este módulo não afirma que SAT se decide em tempo polinomial: prova os passos e os limites de custo do ciclo de\r\n  um literal, com a testemunha dada na fita.\r\n* Nada sobre a Palavra de toda CNF plana. Nada sobre a natureza. O gate não se move.\r\n\r\nSem `sorry`, sem `axiom` declarado neste módulo.\r\n-/\r\n\r\nnamespace TGLExt.ACicloDoLiteral\r\n\r\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao TGLExt.AFasesDaMaquina StateTransition\r\n\r\n/-- O bit esperado pela polaridade, como símbolo da fita. -/\r\ndef esperado (b : Bool) : Option Simbolo := if b then some Simbolo.um else some Simbolo.zero\r\n\r\n/-- `x <|> none` é o próprio `x`. (Auxiliar dos estados dos laços.) -/\r\ntheorem ou_none (x : Option Simbolo) : (x <|> none) = x := by cases x <;> rfl\r\n\r\n/-- Igualdade no início: os passos são os mesmos, a partida é reescrita. (Auxiliar da composição.) -/\r\ndef evals_congr_inicio {a₁ a₂ : Turing.TM2.Cfg stackAlphabet Rotulo Estado}\r\n    {c : Option (Turing.TM2.Cfg stackAlphabet Rotulo Estado)} {m : ℕ}\r\n    (h : a₁ = a₂) (hE : EvalsToInTime aMaquinaTM2.step a₁ c m) : EvalsToInTime aMaquinaTM2.step a₂ c m :=\r\n  h ▸ hE\r\n\r\n/-! ## Os passos do ciclo -/\r\n\r\n/-- Ler o marcador: a polaridade vai à bandeira; o índice (os ticks) fica na pilha da fórmula. -/\r\ntheorem passo_lerLiteral (v : Estado) (e : List Simbolo) (i : ℕ) (b : Bool) (rest t d : List Simbolo)\r\n    (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .lerLiteral v e (codificaLiteral (i, b) ++ rest) t d sa)\r\n      = some (cfg .andarTicks (v.1, b, v.2.2) e (List.replicate i Simbolo.tick ++ rest) t d sa) := by\r\n  cases b <;>\r\n    simp only [codificaLiteral, aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma,\r\n      Turing.TM2.stepAux, cfg, cfgStacks, List.head?_cons, List.tail_cons] <;>\r\n    apply algum_inj <;>\r\n    apply cfg_fecha rfl rfl <;>\r\n    intro k <;> fin_cases k <;> simp [cfgStacks, Function.update]\r\n\r\n/-- A caminhada dos ticks com tick à vista: move-o à pilha de trabalho. -/\r\ntheorem passo_andarTicks_move (v : Estado) (e : List Simbolo) (rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .andarTicks v e (Simbolo.tick :: rest) t d sa)\r\n      = some (cfg .andarTicks (some Simbolo.tick, v.2.1, true) e rest (Simbolo.tick :: t) d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_cons, List.tail_cons, Option.getD_some]\r\n  apply algum_inj\r\n  apply cfg_fecha rfl rfl\r\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\r\n\r\n/-- A caminhada dos ticks no fim do índice (o próximo símbolo não é tick): vai caminhar os bits. -/\r\ntheorem passo_andarTicks_fim (v : Estado) (e rest t d : List Simbolo) (sa : List Bool)\r\n    (ht : rest.head? ≠ some Simbolo.tick) :\r\n    aMaquinaTM2.step (cfg .andarTicks v e rest t d sa)\r\n      = some (cfg .andarBits (v.1, v.2.1, false) e rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks]\r\n  simp only [show (rest.head? = some Simbolo.tick) ↔ False from by simp [ht]]\r\n  rfl\r\n\r\n/-- A caminhada dos bits com tick e bit à vista: o tick sai da pilha de trabalho, o bit vai ao depósito. -/\r\ntheorem passo_andarBits_move (v : Estado) (s : Simbolo) (restE rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .andarBits v (s :: restE) rest (Simbolo.tick :: t) d sa)\r\n      = some (cfg .andarBits (some s, v.2.1, false) restE rest t (s :: d) sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_cons, List.tail_cons, Option.getD_some]\r\n  simp only [show ((some Simbolo.tick : Option Simbolo) = none) ↔ False from by simp,\r\n    show ((some s : Option Simbolo) = none) ↔ False from by simp]\r\n  apply algum_inj\r\n  apply cfg_fecha rfl rfl\r\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\r\n\r\n/-- A caminhada dos bits com os ticks pagos: vai ler o bit da posição. -/\r\ntheorem passo_andarBits_fimTicks (v : Estado) (e rest d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .andarBits v e rest [] d sa)\r\n      = some (cfg .lerBitAtual (v.1, v.2.1, true) e rest [] d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_nil]\r\n  rfl\r\n\r\n/-- A caminhada dos bits com a testemunha esgotada antes dos ticks: vai esvaziar os ticks (o bit é ausente). -/\r\ntheorem passo_andarBits_fimBits (v : Estado) (rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .andarBits v [] rest (Simbolo.tick :: t) d sa)\r\n      = some (cfg .esvaziarTicks (v.1, v.2.1, true) [] rest (Simbolo.tick :: t) d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_nil, List.head?_cons]\r\n  simp only [show ((some Simbolo.tick : Option Simbolo) = none) ↔ False from by simp]\r\n  rfl\r\n\r\n/-- Ler o bit da posição: o carregador recebe a cabeça da testemunha restante (ou `none` na borda). -/\r\ntheorem passo_lerBitAtual (v : Estado) (e rest d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .lerBitAtual v e rest [] d sa)\r\n      = some (cfg .comparar (e.head?, v.2.1, v.2.2) e rest [] d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks]\r\n\r\n/-- Esvaziar os ticks com tick à vista: descarta-o. -/\r\ntheorem passo_esvaziarTicks_move (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .esvaziarTicks v e rest (Simbolo.tick :: t) d sa)\r\n      = some (cfg .esvaziarTicks (v.1, v.2.1, false) e rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_cons, List.tail_cons]\r\n  simp only [show ((some Simbolo.tick : Option Simbolo) = none) ↔ False from by simp]\r\n  apply algum_inj\r\n  apply cfg_fecha rfl rfl\r\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\r\n\r\n/-- Esvaziar os ticks no fim: o carregador fica `none` (o bit ausente) e vai comparar. -/\r\ntheorem passo_esvaziarTicks_fim (v : Estado) (e rest d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .esvaziarTicks v e rest [] d sa)\r\n      = some (cfg .comparar (none, v.2.1, true) e rest [] d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_nil]\r\n  rfl\r\n\r\n/-- Comparar com acerto: a bandeira fica verdadeira e vai marcar a cláusula como satisfeita. -/\r\ntheorem passo_comparar_satisfeito (v : Estado) (e rest t d : List Simbolo) (sa : List Bool)\r\n    (h : v.1 = (if v.2.1 then some Simbolo.um else some Simbolo.zero)) :\r\n    aMaquinaTM2.step (cfg .comparar v e rest t d sa)\r\n      = some (cfg .clausulaSatisfeita (none, true, v.2.2) e rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks]\r\n  simp only [show (v.1 = if v.2.1 then some Simbolo.um else some Simbolo.zero) ↔ True from iff_true_intro h]\r\n  rfl\r\n\r\n/-- Comparar sem acerto: a bandeira fica falsa e vai ao próximo literal. -/\r\ntheorem passo_comparar_falha (v : Estado) (e rest t d : List Simbolo) (sa : List Bool)\r\n    (h : ¬ (v.1 = (if v.2.1 then some Simbolo.um else some Simbolo.zero))) :\r\n    aMaquinaTM2.step (cfg .comparar v e rest t d sa)\r\n      = some (cfg .proximoLiteral (none, false, v.2.2) e rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks]\r\n  simp only [show (v.1 = if v.2.1 then some Simbolo.um else some Simbolo.zero) ↔ False from iff_false_intro h]\r\n  rfl\r\n\r\n/-- Marcar a rota «satisfeito»: vai restaurar. -/\r\ntheorem passo_clausulaSatisfeita (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .clausulaSatisfeita v e rest t d sa)\r\n      = some (cfg .restaurar (v.1, v.2.1, true) e rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks]\r\n\r\n/-- Marcar a rota «falhou»: vai restaurar. -/\r\ntheorem passo_proximoLiteral (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .proximoLiteral v e rest t d sa)\r\n      = some (cfg .restaurar (v.1, v.2.1, false) e rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks]\r\n\r\n/-- O restaurar com bit no depósito: devolve-o à entrada. -/\r\ntheorem passo_restaurar_move (v : Estado) (s : Simbolo) (e rest t d : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .restaurar v e rest t (s :: d) sa)\r\n      = some (cfg .restaurar (some s, false, v.2.2) (s :: e) rest t d sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_cons, List.tail_cons, Option.getD_some]\r\n  simp only [show ((some s : Option Simbolo) = none) ↔ False from by simp]\r\n  apply algum_inj\r\n  apply cfg_fecha rfl rfl\r\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\r\n\r\n/-- O restaurar no fim: segue a rota marcada. -/\r\ntheorem passo_restaurar_fim (v : Estado) (e rest t : List Simbolo) (sa : List Bool) :\r\n    aMaquinaTM2.step (cfg .restaurar v e rest t [] sa)\r\n      = some (cfg (if v.2.2 then Rotulo.saltarResto else Rotulo.proximoLiteralCheck)\r\n          (v.1, true, v.2.2) e rest t [] sa) := by\r\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\r\n    List.head?_nil]\r\n  rfl\r\n\r\n/-! ## Os laços do ciclo -/\r\n\r\n/-- A acumulação dos ticks: mais um tick no fim da invertida é um tick no início da direta. (Auxiliar.) -/\r\ntheorem replicate_snoc (i : ℕ) (T : List Simbolo) :\r\n    List.replicate i Simbolo.tick ++ (Simbolo.tick :: T) = (Simbolo.tick :: List.replicate i Simbolo.tick) ++ T := by\r\n    induction i generalizing T with\r\n    | zero => rfl\r\n    | succ i ih => simp [List.replicate_succ, List.cons_append, ih]\r\n\r\n/-- ★ O LAÇO DOS TICKS: o índice sai da pilha da fórmula para a pilha de trabalho. No máximo `i + 1` passos\r\n(um por tick, mais a detecção do fim). -/\r\ndef fase_andarTicks (v : Estado) (e : List Simbolo) (i : ℕ) (rest T d : List Simbolo) (sa : List Bool)\r\n    (ht : rest.head? ≠ some Simbolo.tick) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .andarTicks v e (List.replicate i Simbolo.tick ++ rest) T d sa)\r\n      (some (cfg .andarBits ((List.replicate i Simbolo.tick).reverse.head? <|> v.1, v.2.1, false) e rest\r\n        (List.replicate i Simbolo.tick ++ T) d sa)) (i + 1) := by\r\n  induction i generalizing v T with\r\n  | zero =>\r\n    have h1 := passo_andarTicks_fim v e rest T d sa ht\r\n    refine evals_congr ?_ (passo_unico h1)\r\n    simp [List.replicate_zero, List.nil_append]\r\n  | succ i ih =>\r\n    have h1 := passo_andarTicks_move v e (List.replicate i Simbolo.tick ++ rest) T d sa\r\n    have h2 := ih (some Simbolo.tick, v.2.1, true) (Simbolo.tick :: T)\r\n    refine evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2)\r\n    apply algum_inj\r\n    apply cfg_fecha rfl\r\n    · show ((List.replicate i Simbolo.tick).reverse.head? <|> some Simbolo.tick,\r\n          v.2.1, false)\r\n        = ((List.replicate (i + 1) Simbolo.tick).reverse.head? <|> v.1, v.2.1, false)\r\n      rw [cabeca_reverse_cons v.1 Simbolo.tick (List.replicate i Simbolo.tick)]\r\n      rw [← List.replicate_succ]\r\n    · intro k; fin_cases k <;> simp [cfgStacks, List.replicate_succ, List.reverse_replicate,\r\n        List.singleton_append, List.append_assoc, List.replicate_add, replicate_snoc]\r\n\r\n/-- ★ O LAÇO DOS BITS, COM O ÍNDICE NA TESTEMUNHA: `i` bits vão ao depósito (invertidos), a testemunha fica a\r\npartir da posição `i`. No máximo `i + 1` passos (um por bit, mais a detecção). -/\r\ndef fase_andarBits_coberto (v : Estado) (i : ℕ) (E rest D : List Simbolo) (sa : List Bool) (hi : i ≤ E.length) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .andarBits v E rest (List.replicate i Simbolo.tick) D sa)\r\n      (some (cfg .lerBitAtual ((E.take i).reverse.head? <|> v.1, v.2.1, true) (E.drop i) rest []\r\n        ((E.take i).reverse ++ D) sa)) (i + 1) := by\r\n  induction i generalizing v E D with\r\n  | zero =>\r\n    have h1 := passo_andarBits_fimTicks v E rest D sa\r\n    refine evals_congr ?_ (passo_unico h1)\r\n    simp [List.take_zero, List.drop_zero]\r\n  | succ i ih =>\r\n    cases E with\r\n    | nil => simp at hi\r\n    | cons b0 E' =>\r\n      have h1 := passo_andarBits_move v b0 E' rest (List.replicate i Simbolo.tick) D sa\r\n      have hi' : i ≤ E'.length := by simp only [List.length_cons] at hi; omega\r\n      have h2 := ih (some b0, v.2.1, false) E' (b0 :: D) hi'\r\n      refine evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2)\r\n      apply algum_inj\r\n      apply cfg_fecha rfl\r\n      · simp [cabeca_reverse_cons, List.take_succ_cons]\r\n      · intro k; fin_cases k <;>\r\n          simp [cfgStacks, List.take_succ_cons, List.drop_succ_cons, List.reverse_cons, List.append_assoc,\r\n            List.singleton_append]\r\n\r\n/-- ★ O LAÇO DOS BITS, COM O ÍNDICE ALÉM DA TESTEMUNHA: a testemunha esvazia-se inteira ao depósito, e os\r\nticks que sobram ficam para o esvaziamento. No máximo `|E| + 1` passos (um por bit, mais a detecção). -/\r\ndef fase_andarBits_alem (v : Estado) (i : ℕ) (E rest D : List Simbolo) (sa : List Bool) (hi : E.length < i) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .andarBits v E rest (List.replicate i Simbolo.tick) D sa)\r\n      (some (cfg .esvaziarTicks (E.reverse.head? <|> v.1, v.2.1, true) [] rest\r\n        (List.replicate (i - E.length) Simbolo.tick) (E.reverse ++ D) sa)) (E.length + 1) := by\r\n  induction E generalizing v i D with\r\n  | nil =>\r\n    cases i with\r\n    | zero => simp at hi\r\n    | succ i' =>\r\n      have h1 := passo_andarBits_fimBits v rest (List.replicate i' Simbolo.tick) D sa\r\n      refine evals_congr_inicio (by simp [List.replicate_succ]) (evals_congr ?_ (passo_unico h1))\r\n      apply algum_inj\r\n      apply cfg_fecha rfl\r\n      · simp [List.reverse_nil]\r\n      · intro k; fin_cases k <;> simp [cfgStacks, List.replicate_succ, List.reverse_nil, List.nil_append,\r\n          Nat.sub_zero]\r\n  | cons b0 E' ih =>\r\n    cases i with\r\n    | zero => simp at hi\r\n    | succ i' =>\r\n      have h1 := passo_andarBits_move v b0 E' rest (List.replicate i' Simbolo.tick) D sa\r\n      have hi' : E'.length < i' := by simp only [List.length_cons] at hi; omega\r\n      have h2 := ih (some b0, v.2.1, false) i' (b0 :: D) hi'\r\n      refine evals_congr_inicio (by simp [List.replicate_succ])\r\n        (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2))\r\n      apply algum_inj\r\n      apply cfg_fecha rfl\r\n      · simp [cabeca_reverse_cons]\r\n      · intro k; fin_cases k <;>\r\n          simp [cfgStacks, List.reverse_cons, List.append_assoc, List.singleton_append, List.length_cons,\r\n            Nat.succ_sub_one]\r\n\r\n/-- ★ O ESVAZIAMENTO DOS TICKS: descarta os que sobram, com o carregador `none` (o bit ausente). No máximo\r\n`j + 1` passos. -/\r\ndef fase_esvaziarTicks (v : Estado) (j : ℕ) (e rest D : List Simbolo) (sa : List Bool) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .esvaziarTicks v e rest (List.replicate j Simbolo.tick) D sa)\r\n      (some (cfg .comparar (none, v.2.1, true) e rest [] D sa)) (j + 1) := by\r\n  induction j generalizing v with\r\n  | zero =>\r\n    exact evals_congr_inicio (by simp [List.replicate_zero]) (passo_unico (passo_esvaziarTicks_fim v e rest D sa))\r\n  | succ j ih =>\r\n    have h1 := passo_esvaziarTicks_move v e rest (List.replicate j Simbolo.tick) D sa\r\n    have h2 := ih (v.1, v.2.1, false)\r\n    exact evals_congr_inicio (by simp [List.replicate_succ])\r\n      (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2)\r\n\r\n/-- ★ O RESTAURAR: o depósito `X` volta à entrada como `X.reverse ++ e` (a ordem original) e a máquina segue a\r\nrota marcada. No máximo `|X| + 1` passos (um por símbolo, mais a detecção). -/\r\ndef fase_restaurar (v : Estado) (X e rest t : List Simbolo) (sa : List Bool) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .restaurar v e rest t X sa)\r\n      (some (cfg (if v.2.2 then Rotulo.saltarResto else Rotulo.proximoLiteralCheck)\r\n        (X.reverse.head? <|> v.1, true, v.2.2) (X.reverse ++ e) rest t [] sa)) (X.length + 1) := by\r\n  induction X generalizing v e with\r\n  | nil =>\r\n    have h1 := passo_restaurar_fim v e rest t sa\r\n    refine evals_congr ?_ (passo_unico h1)\r\n    simp [List.reverse_nil, List.nil_append]\r\n  | cons s X' ih =>\r\n    have h1 := passo_restaurar_move v s e rest t X' sa\r\n    have h2 := ih (some s, false, v.2.2) (s :: e)\r\n    refine evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2)\r\n    apply algum_inj\r\n    apply cfg_fecha rfl\r\n    · simp [cabeca_reverse_cons]\r\n    · intro k; fin_cases k <;> simp [cfgStacks, List.reverse_cons, List.append_assoc, List.singleton_append]\r\n\r\n/-! ## O ciclo completo do literal -/\r\n\r\n/-- A testemunha tem a posição lida. (Auxiliar da composição.) -/\r\ntheorem alcance_da_leitura {E : List Simbolo} {i : ℕ} {w : Simbolo} (h : E[i]? = some w) :\r\n    i < E.length :=\r\n  (List.getElem?_eq_some_iff.mp h).1\r\n\r\n/-- ★ **O CICLO DO LITERAL COM ACERTO**: o bit na posição do índice é o esperado pela polaridade — a máquina vai\r\na `saltarResto`, com a testemunha intacta e as pilhas de trabalho vazias. No máximo `3·i + 7` passos. -/\r\ndef ciclo_literal_satisfeito (v : Estado) (i : ℕ) (b : Bool) (rest E : List Simbolo) (sa : List Bool)\r\n    (ht : rest.head? ≠ some Simbolo.tick) (hbit : E[i]? = esperado b) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .lerLiteral v E (codificaLiteral (i, b) ++ rest) [] [] sa)\r\n      (some (cfg .saltarResto ((E.take i).head?, true, true) E rest [] [] sa)) (3 * i + 7) := by\r\n  have h1 := passo_lerLiteral v E i b rest [] [] sa\r\n  have h2 := fase_andarTicks (v.1, b, v.2.2) E i rest [] [] sa ht\r\n  simp only [List.append_nil] at h2\r\n  have hi : i ≤ E.length := by\r\n    cases b\r\n    · exact (List.getElem?_eq_some_iff.mp (by simpa [esperado] using hbit)).1.le\r\n    · exact (List.getElem?_eq_some_iff.mp (by simpa [esperado] using hbit)).1.le\r\n  have h3 := fase_andarBits_coberto ((List.replicate i Simbolo.tick).reverse.head? <|> v.1, b, false)\r\n    i E rest [] sa hi\r\n  simp only [List.append_nil] at h3\r\n  have h4 := passo_lerBitAtual ((E.take i).reverse.head? <|> ((List.replicate i Simbolo.tick).reverse.head? <|> v.1), b, true) (E.drop i) rest ((E.take i).reverse) sa\r\n  dsimp only [] at h4\r\n  have hbit' : (E.drop i).head? = (if b then some Simbolo.um else some Simbolo.zero) := by\r\n    rw [List.head?_drop]; exact hbit\r\n  have h5 := passo_comparar_satisfeito ((E.drop i).head?, b, true) (E.drop i) rest [] ((E.take i).reverse) sa\r\n    hbit'\r\n  dsimp only [] at h5\r\n  have h6 := passo_clausulaSatisfeita ((none, true, true) : Estado) (E.drop i) rest [] ((E.take i).reverse) sa\r\n  dsimp only [] at h6\r\n  have h7 := fase_restaurar ((none, true, true) : Estado) ((E.take i).reverse) (E.drop i) rest [] sa\r\n  dsimp only [] at h7\r\n  have hcomp := EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1)\r\n    (EvalsToInTime.trans _ _ _ _ _ _ h2\r\n      (EvalsToInTime.trans _ _ _ _ _ _ h3\r\n        (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h4)\r\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h5)\r\n            (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h6) h7)))))\r\n  refine custo_mono (evals_congr ?_ hcomp) ?_\r\n  · apply algum_inj\r\n    apply cfg_fecha rfl\r\n    · show (((E.take i).reverse).reverse.head? <|> none, true, true)\r\n        = ((E.take i).head?, true, true)\r\n      simp [List.reverse_reverse, ou_none]\r\n    · intro k; fin_cases k <;>\r\n        simp [cfgStacks, List.reverse_reverse, List.take_append_drop, List.length_reverse,\r\n          List.length_take, min_eq_left hi]\r\n  · simp only [List.length_reverse, List.length_take, min_eq_left hi]; omega\r\n\r\n/-- ★ **O CICLO DO LITERAL SEM ACERTO, NO ALCANCE** (`i ≤ |E|`): o bit na posição não é o esperado (em\r\n`i = |E|` não há bit) — a máquina vai a `proximoLiteralCheck`, com a testemunha intacta. No máximo `3·i + 7`\r\npassos. -/\r\ndef ciclo_literal_falha (v : Estado) (i : ℕ) (b : Bool) (rest E : List Simbolo) (sa : List Bool)\r\n    (ht : rest.head? ≠ some Simbolo.tick) (hi : i ≤ E.length) (hne : E[i]? ≠ esperado b) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .lerLiteral v E (codificaLiteral (i, b) ++ rest) [] [] sa)\r\n      (some (cfg .proximoLiteralCheck ((E.take i).head?, true, false) E rest [] [] sa)) (3 * i + 7) := by\r\n  have h1 := passo_lerLiteral v E i b rest [] [] sa\r\n  have h2 := fase_andarTicks (v.1, b, v.2.2) E i rest [] [] sa ht\r\n  simp only [List.append_nil] at h2\r\n  have h3 := fase_andarBits_coberto ((List.replicate i Simbolo.tick).reverse.head? <|> v.1, b, false)\r\n    i E rest [] sa hi\r\n  simp only [List.append_nil] at h3\r\n  have h4 := passo_lerBitAtual ((E.take i).reverse.head? <|> ((List.replicate i Simbolo.tick).reverse.head? <|> v.1), b, true) (E.drop i) rest ((E.take i).reverse) sa\r\n  dsimp only [] at h4\r\n  have hne' : (E.drop i).head? ≠ (if b then some Simbolo.um else some Simbolo.zero) := by\r\n    rw [List.head?_drop]; exact hne\r\n  have h5 := passo_comparar_falha ((E.drop i).head?, b, true) (E.drop i) rest [] ((E.take i).reverse) sa hne'\r\n  dsimp only [] at h5\r\n  have h6 := passo_proximoLiteral ((none, false, true) : Estado) (E.drop i) rest [] ((E.take i).reverse) sa\r\n  dsimp only [] at h6\r\n  have h7 := fase_restaurar ((none, false, false) : Estado) ((E.take i).reverse) (E.drop i) rest [] sa\r\n  dsimp only [] at h7\r\n  have hcomp := EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1)\r\n    (EvalsToInTime.trans _ _ _ _ _ _ h2\r\n      (EvalsToInTime.trans _ _ _ _ _ _ h3\r\n        (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h4)\r\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h5)\r\n            (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h6) h7)))))\r\n  refine custo_mono (evals_congr ?_ hcomp) ?_\r\n  · apply algum_inj\r\n    apply cfg_fecha rfl\r\n    · show (((E.take i).reverse).reverse.head? <|> none, true, false)\r\n        = ((E.take i).head?, true, false)\r\n      simp [List.reverse_reverse, ou_none]\r\n    · intro k; fin_cases k <;>\r\n        simp [cfgStacks, List.reverse_reverse, List.take_append_drop, List.length_reverse,\r\n          List.length_take, min_eq_left hi]\r\n  · simp only [List.length_reverse, List.length_take, min_eq_left hi]; omega\r\n\r\n/-- ★ **O CICLO DO LITERAL ALÉM DA TESTEMUNHA**: o índice não tem bit — o `none` da borda falha o literal, como\r\nna `verificaNaFita` — e a máquina vai a `proximoLiteralCheck`, com a testemunha intacta. No máximo\r\n`2·i + |E| + 7` passos. -/\r\ndef ciclo_literal_fora (v : Estado) (i : ℕ) (b : Bool) (rest E : List Simbolo) (sa : List Bool)\r\n    (ht : rest.head? ≠ some Simbolo.tick) (hi : E.length < i) :\r\n    EvalsToInTime aMaquinaTM2.step (cfg .lerLiteral v E (codificaLiteral (i, b) ++ rest) [] [] sa)\r\n      (some (cfg .proximoLiteralCheck (E.head?, true, false) E rest [] [] sa)) (2 * i + E.length + 7) := by\r\n  have h1 := passo_lerLiteral v E i b rest [] [] sa\r\n  have h2 := fase_andarTicks (v.1, b, v.2.2) E i rest [] [] sa ht\r\n  simp only [List.append_nil] at h2\r\n  have h3 := fase_andarBits_alem ((List.replicate i Simbolo.tick).reverse.head? <|> v.1, b, false)\r\n    i E rest [] sa hi\r\n  simp only [List.append_nil] at h3\r\n  have h4 := fase_esvaziarTicks (E.reverse.head? <|> ((List.replicate i Simbolo.tick).reverse.head? <|> v.1), b, true) (i - E.length) [] rest (E.reverse) sa\r\n  dsimp only [] at h4\r\n  have h5 := passo_comparar_falha ((none, b, true) : Estado) [] rest [] (E.reverse) sa (by cases b <;> simp [esperado])\r\n  dsimp only [] at h5\r\n  have h6 := passo_proximoLiteral ((none, false, true) : Estado) [] rest [] (E.reverse) sa\r\n  dsimp only [] at h6\r\n  have h7 := fase_restaurar ((none, false, false) : Estado) E.reverse [] rest [] sa\r\n  dsimp only [] at h7\r\n  have hcomp := EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1)\r\n    (EvalsToInTime.trans _ _ _ _ _ _ h2\r\n      (EvalsToInTime.trans _ _ _ _ _ _ h3\r\n        (EvalsToInTime.trans _ _ _ _ _ _ h4\r\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h5)\r\n            (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h6) h7)))))\r\n  refine custo_mono (evals_congr ?_ hcomp) ?_\r\n  · apply algum_inj\r\n    apply cfg_fecha rfl\r\n    · show (E.reverse.reverse.head? <|> none, true, false)\r\n        = (E.head?, true, false)\r\n      simp [List.reverse_reverse, ou_none]\r\n    · intro k; fin_cases k <;>\r\n        simp [cfgStacks, List.reverse_reverse, List.nil_append, List.append_nil]\r\n  · simp only [List.length_reverse]; omega\r\n\r\n/-! ## A ponte semântica do bit -/\r\n\r\n/-- O bit na posição `i` da testemunha na fita é o mapeamento do bit da testemunha. (Auxiliar da ponte.) -/\r\ntheorem bit_na_fita (bits : List Bool) (i : ℕ) :\r\n    (codificaBits bits)[i]? = (bits[i]?).map fun b => if b then Simbolo.um else Simbolo.zero := by\r\n  simp [codificaBits, List.getElem?_map]\r\n\r\n/-- ★ **O TESTE DA MÁQUINA É O TESTE DA FITA**: conferir o símbolo esperado na posição é o `==` da\r\n`verificaNaFita`. -/\r\ntheorem o_teste_e_o_da_fita (bits : List Bool) (i : ℕ) (b : Bool) :\r\n    ((codificaBits bits)[i]? = esperado b) ↔ (bits[i]? == some b) := by\r\n  rw [bit_na_fita, esperado]\r\n  cases hb : bits[i]? with\r\n  | none => cases b <;> simp\r\n  | some w => cases w <;> cases b <;> simp\r\n\r\nend TGLExt.ACicloDoLiteral\r\n\r\n",
+    'TGLExt/OLacoDasClausulas.lean': "import TGLExt.ACicloDoLiteral\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\nset_option maxRecDepth 8192\n\n/-!\n# A simulação da máquina TM2: o laço das cláusulas e o verificador com testemunha em tempo polinomial\n\n## Contexto\n\nO módulo usa a `AFasesDaMaquina` (partida e parada) e o `ACicloDoLiteral` (o ciclo do literal) e trata o laço\ndas cláusulas: a varredura de uma cláusula (literal a literal, com saída antecipada no primeiro acerto), o\n`saltarResto` (o resto da cláusula satisfeita se descarta até o terminador) e a composição sobre a lista de\ncláusulas. Com isso habita a `ASimulacaoCompleta` da `AMaquinaTM2DaVerificacao` e, por ela, o\n`ObjetivoTM2Polinomial` da `APonteAoTM2`: a máquina TM2 concreta, no modelo `Turing.TM2ComputableInPolyTime` do\nMathlib, que, dadas a fórmula e a testemunha codificadas, calcula `verificaNaFita` em tempo polinomial.\n\n## O que fica provado [REAL]\n\n1. Os passos de fronteira: `passo_lerClausula_fimF`, `passo_lerClausula_fimC`, `passo_lerClausula_literal`,\n   `passo_proximoLiteralCheck_fimC`, `passo_proximoLiteralCheck_literal`, `passo_saltarResto_fim`,\n   `passo_saltarResto_move`.\n2. Os auxiliares de boa formação: `proximo_nao_tick` (depois de um literal nunca vem tick) e\n   `fimC_nao_esta_nos_literais` (o `saltarResto` para no terminador certo).\n3. ★ As varreduras da cláusula: `varredura_falha_total` (nenhum literal serve: a máquina para com `false`) e\n   `varredura_acerto` (algum serve: a máquina volta a `lerClausula` com o resto da fórmula, a testemunha\n   intacta), cada uma dentro de uma cota explícita de passos.\n4. ★ `fase_dasClausulas`: o laço inteiro, de `lerClausula` com a fórmula na pilha ao `haltList` com a resposta\n   `Cs.all (clausulaSatNaFita E)` (`true` SSE toda cláusula tem literal que serve), dentro de uma cota explícita\n   de passos.\n5. ★★ `a_resposta_e_a_verificacao` (a resposta do laço, na testemunha codificada, é igual a `verificaNaFita`),\n   `a_simulacao_completa` (habita `ASimulacaoCompleta`: para todo par (fórmula, testemunha) a máquina imprime\n   `codificaSaida (verificaNaFita p.1 p.2)` em no máximo `contaFases p` passos) e `o_objetivo_cumprido`\n   (habita `ObjetivoTM2Polinomial` pelo `o_objetivo_se_reduz_a_simulacao` da irmã). O tipo de\n   `ObjetivoTM2Polinomial` afirma que existe um polinômio; na construção da irmã, o tempo é o `contaFases`, que\n   `a_forma_do_custo_e_polinomial` mantém em no máximo `20·L + 5` no comprimento `L` da entrada codificada.\n   A injetividade da codificação da entrada é o teorema `codificaEntrada_injetiva` da `APonteAoTM2`. O mesmo\n   `ObjetivoTM2Polinomial` também é habitado, por outro caminho, em `SimTM2.verificacao_tm2_polinomial`.\n\n## A contabilidade (cotas superiores, dentro do `contaFases` da `AMaquinaTM2DaVerificacao`)\n\nPor literal de índice `i`, no máximo `4·i + 10` passos (`custoLiteral`: o ciclo do literal de `ACicloDoLiteral`\ne o roteamento); por cláusula, a fronteira, o resto saltado e o terminador; a partida e a parada vêm de\n`AFasesDaMaquina`. O total fica dentro do `contaFases` (em `a_simulacao_completa`, com\n`custo_total_das_clausulas` e `comprimento_das_clausulas`) [REAL]. Todos os custos são cotas superiores\n(`EvalsToInTime` do Mathlib limita o número de passos por cima); nenhuma igualdade de passos é afirmada.\n\n## O que NÃO se afirma\n\n* Não se prova aqui a NP-dificuldade de SAT (a redução de Cook–Levin de toda linguagem de NP a SAT). O que fica\n  provado é o verificador: a máquina TM2 padrão que, dadas a fórmula e a testemunha codificadas, devolve\n  `verificaNaFita` em tempo polinomial no comprimento da entrada inteira (fórmula e testemunha). Leitura [INPUT]:\n  é a forma de verificador de «SAT está em NP».\n* Não se afirma que alguma máquina decida SAT sem testemunha em tempo polinomial. Decidir SAT sem testemunha,\n  em tempo polinomial, na máquina de fita segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem `sorry` e sem `axiom` no código; os axiomas de cada declaração estão no relatório do kernel.\n-/\n\nnamespace TGLExt.OLacoDasClausulas\n\nopen TGLExt.APonteAoTM2 TGLExt.AMaquinaTM2DaVerificacao TGLExt.AFasesDaMaquina TGLExt.ACicloDoLiteral\n  StateTransition\n\n/-- O teste de um literal na fita, como Bool: o que a máquina computa. -/\ndef testLiteral (E : List Simbolo) (p : ℕ × Bool) : Bool := decide (E[p.1]? = esperado p.2)\n\n/-- A satisfação de uma cláusula na fita. -/\ndef clausulaSatNaFita (E : List Simbolo) (C : List (ℕ × Bool)) : Bool :=\n  C.any (testLiteral E)\n\n/-- O custo máximo de um literal no ciclo, com o roteamento (cobre os três desfechos). -/\ndef custoLiteral (i : ℕ) : ℕ := 4 * i + 10\n\n/-! ## Os passos de fronteira -/\n\n/-- lerClausula ao ver o fim da fórmula: bandeira verdadeira, vai limpar. -/\ntheorem passo_lerClausula_fimF (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .lerClausula v e (Simbolo.fimF :: rest) t d sa)\n      = some (cfg .limparFormula (v.1, true, v.2.2) e (Simbolo.fimF :: rest) t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons]\n  rfl\n\n/-- lerClausula ao ver o fim de cláusula (cláusula vazia na boca): bandeira falsa, vai limpar. -/\ntheorem passo_lerClausula_fimC (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .lerClausula v e (Simbolo.fimC :: rest) t d sa)\n      = some (cfg .limparFormula (v.1, false, v.2.2) e (Simbolo.fimC :: rest) t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons]\n  simp only [show ((some Simbolo.fimC : Option Simbolo) = some Simbolo.fimF) ↔ False from by simp]\n  rfl\n\n/-- lerClausula ao ver um marcador de literal: vai ler o literal (o marcador fica na pilha para o pop). -/\ntheorem passo_lerClausula_literal (v : Estado) (e : List Simbolo) (s : Simbolo) (rest t d : List Simbolo)\n    (sa : List Bool) (hsF : s ≠ Simbolo.fimF) (hsC : s ≠ Simbolo.fimC) :\n    aMaquinaTM2.step (cfg .lerClausula v e (s :: rest) t d sa)\n      = some (cfg .lerLiteral (v.1, false, v.2.2) e (s :: rest) t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons]\n  simp only [show ((some s : Option Simbolo) = some Simbolo.fimF) ↔ False from by simp [hsF],\n    show ((some s : Option Simbolo) = some Simbolo.fimC) ↔ False from by simp [hsC]]\n  rfl\n\n/-- proximoLiteralCheck ao ver o fim de cláusula: a cláusula morreu sem acerto — bandeira falsa, vai limpar. -/\ntheorem passo_proximoLiteralCheck_fimC (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .proximoLiteralCheck v e (Simbolo.fimC :: rest) t d sa)\n      = some (cfg .limparFormula (v.1, false, v.2.2) e (Simbolo.fimC :: rest) t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons]\n  rfl\n\n/-- proximoLiteralCheck ao ver um marcador: vai ler o próximo literal. -/\ntheorem passo_proximoLiteralCheck_literal (v : Estado) (e : List Simbolo) (s : Simbolo) (rest t d : List Simbolo)\n    (sa : List Bool) (hs : s ≠ Simbolo.fimC) :\n    aMaquinaTM2.step (cfg .proximoLiteralCheck v e (s :: rest) t d sa)\n      = some (cfg .lerLiteral (v.1, false, v.2.2) e (s :: rest) t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons]\n  simp only [show ((some s : Option Simbolo) = some Simbolo.fimC) ↔ False from by simp [hs]]\n  rfl\n\n/-- O saltarResto ao ver o terminador: consome-o e volta ao laço das cláusulas. -/\ntheorem passo_saltarResto_fim (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) :\n    aMaquinaTM2.step (cfg .saltarResto v e (Simbolo.fimC :: rest) t d sa)\n      = some (cfg .lerClausula (v.1, true, v.2.2) e rest t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- O saltarResto com símbolo de literal: descarta-o e segue. -/\ntheorem passo_saltarResto_move (v : Estado) (e : List Simbolo) (s : Simbolo) (rest t d : List Simbolo)\n    (sa : List Bool) (hs : s ≠ Simbolo.fimC) :\n    aMaquinaTM2.step (cfg .saltarResto v e (s :: rest) t d sa)\n      = some (cfg .saltarResto (v.1, false, v.2.2) e rest t d sa) := by\n  simp only [aMaquinaTM2, Turing.FinTM2.step, Turing.TM2.step, oPrograma, Turing.TM2.stepAux, cfg, cfgStacks,\n    List.head?_cons, List.tail_cons]\n  simp only [show ((some s : Option Simbolo) = some Simbolo.fimC) ↔ False from by simp [hs]]\n  apply algum_inj\n  apply cfg_fecha rfl rfl\n  intro k; fin_cases k <;> simp [cfgStacks, Function.update]\n\n/-- Depois de um literal nunca vem tick: vem marcador ou terminadores. -/\ntheorem proximo_nao_tick (C : List (ℕ × Bool)) (rest : List Simbolo) :\n    (C.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest).head? ≠ some Simbolo.tick := by\n  cases C with\n  | nil => simp\n  | cons l C' =>\n    obtain ⟨i, b⟩ := l\n    cases b <;> simp [codificaLiteral, List.flatMap_cons, List.cons_append, List.head?_cons]\n\n/-- O terminador de cláusula não aparece dentro dos literais. -/\ntheorem fimC_nao_esta_nos_literais (C : List (ℕ × Bool)) :\n    Simbolo.fimC ∉ C.flatMap codificaLiteral := by\n  simp only [List.mem_flatMap, codificaLiteral, List.mem_cons, List.mem_replicate, not_exists]\n  intro p hp\n  obtain ⟨i, b⟩ := p\n  cases b\n  · simp at hp\n  · simp at hp\n\n/-- A forma canônica da pilha da fórmula na boca de um literal: o marcador à frente. -/\ntheorem forma_na_leitura (i : ℕ) (b : Bool) (X rest : List Simbolo) :\n    codificaLiteral (i, b) ++ X ++ [Simbolo.fimC] ++ rest\n      = (if b then Simbolo.litT else Simbolo.litF)\n          :: (List.replicate i Simbolo.tick ++ X ++ [Simbolo.fimC] ++ rest) := by\n  simp [codificaLiteral, List.cons_append, List.append_assoc]\n\n/-! ## O laço do saltarResto -/\n\n/-- ★ O SALTARRESTO: o resto da cláusula satisfeita se descarta até o terminador (consumido), e a máquina volta\na `lerClausula`. Cota: no máximo um passo por símbolo descartado, mais o do terminador (`X.length + 1`). -/\ndef fase_saltarResto (v : Estado) (e rest t d : List Simbolo) (sa : List Bool) (X : List Simbolo)\n    (hX : Simbolo.fimC ∉ X) :\n    EvalsToInTime aMaquinaTM2.step (cfg .saltarResto v e (X ++ [Simbolo.fimC] ++ rest) t d sa)\n      (some (cfg .lerClausula (v.1, true, v.2.2) e rest t d sa)) (X.length + 1) := by\n  induction X generalizing v e with\n  | nil =>\n    exact passo_unico (passo_saltarResto_fim v e rest t d sa)\n  | cons s X' ih =>\n    have hs : s ≠ Simbolo.fimC := fun hss => hX (hss ▸ List.mem_cons_self)\n    have hX' : Simbolo.fimC ∉ X' := fun hm => hX (List.mem_cons_of_mem s hm)\n    have h1 := passo_saltarResto_move v e s (X' ++ [Simbolo.fimC] ++ rest) t d sa hs\n    have h2 := ih (v.1, false, v.2.2) e hX'\n    exact EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) h2\n\n/-! ## As pontes de forma -/\n\n/-- A cabeça do conteúdo de um literal é o seu marcador. (Auxiliar das junções.) -/\ntheorem a_cabeca_e_o_marcador (i : ℕ) (b : Bool) (X : List Simbolo) :\n    codificaLiteral (i, b) ++ X\n      = (if b then Simbolo.litT else Simbolo.litF) :: (List.replicate i Simbolo.tick ++ X) := by\n  simp [codificaLiteral, List.cons_append]\n\n/-- A ponte de configuração: mesmo rótulo, mesmo estado, a fórmula igual. (Auxiliar das junções.) -/\ntheorem ponte_cfg {l : Rotulo} {v : Estado} {e X Y t d : List Simbolo}\n    (h : X = Y) : cfg l v e X t d [] = cfg l v e Y t d [] := by\n  subst h; rfl\n\n/-! ## As varreduras da cláusula -/\n\n/-- ★ A VARREDURA SEM ACERTO: nenhum literal da cláusula serve — a máquina para com `false` na saída (a\ncláusula morreu, e com ela a fórmula). -/\ndef varredura_falha_total (v : Estado) (E : List Simbolo) (C : List (ℕ × Bool)) (rest : List Simbolo)\n    (hnenhum : ∀ p ∈ C, testLiteral E p = false) (hC : C ≠ []) :\n    EvalsToInTime aMaquinaTM2.step\n      (cfg .lerLiteral v E (C.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) [] [] [])\n      (some (Turing.haltList aMaquinaTM2 [false]))\n      ((C.map fun p => custoLiteral p.1).sum + rest.length + E.length + 5) := by\n  induction C generalizing v with\n  | nil => exact absurd rfl hC\n  | cons l C' ih =>\n    obtain ⟨i, b⟩ := l\n    have hne : E[i]? ≠ esperado b := by\n      have h0 := hnenhum (i, b) (List.mem_cons_self)\n      simp only [testLiteral, decide_eq_false_iff_not] at h0\n      exact h0\n    have hn' : ∀ p ∈ C', testLiteral E p = false := fun p hp => hnenhum p (List.mem_cons_of_mem _ hp)\n    rw [List.flatMap_cons, show (codificaLiteral (i, b) ++ C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)\n        = codificaLiteral (i, b) ++ (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) from by\n        simp [List.append_assoc]]\n    by_cases hi : i ≤ E.length\n    · have hc := ciclo_literal_falha v i b (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) E []\n        (proximo_nao_tick C' rest) hi hne\n      cases C' with\n      | nil =>\n        simp only [List.flatMap_nil, List.nil_append] at hc\n        have hfim := passo_proximoLiteralCheck_fimC ((E.take i).head?, true, false) E rest [] [] []\n        have hp := a_parada ((E.take i).head?, false, false) E (Simbolo.fimC :: rest)\n        refine custo_mono (EvalsToInTime.trans _ _ _ _ _ _ hc\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico hfim) hp)) ?_\n        simp [custoLiteral, List.map_cons, List.sum_cons, List.map_nil, List.sum_nil, List.length_cons,\n          List.length_nil]\n        omega\n      | cons l' C''' =>\n        obtain ⟨i', b'⟩ := l'\n        have hforma : ((i', b') :: C''').flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest\n            = (if b' then Simbolo.litT else Simbolo.litF) :: (List.replicate i' Simbolo.tick\n              ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) := by\n          simp [List.flatMap_cons, a_cabeca_e_o_marcador, List.append_assoc]\n        have hc' := evals_congr (algum_inj (ponte_cfg hforma)) hc\n        have hprox := passo_proximoLiteralCheck_literal ((E.take i).head?, true, false) E\n          (if b' then Simbolo.litT else Simbolo.litF)\n          (List.replicate i' Simbolo.tick ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) [] [] []\n          (by cases b' <;> simp)\n        have hih := evals_congr_inicio (ponte_cfg hforma)\n          (ih ((E.take i).head?, false, false) hn' (by simp))\n        refine custo_mono (EvalsToInTime.trans _ _ _ _ _ _ hc'\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico hprox) hih)) ?_\n        · simp [custoLiteral, List.map_cons, List.sum_cons, List.length_cons, List.length_flatMap,\n            List.length_append, List.length_singleton]\n          omega\n    · have hi' : E.length < i := Nat.lt_of_not_le hi\n      have hc := ciclo_literal_fora v i b (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) E []\n        (proximo_nao_tick C' rest) hi'\n      cases C' with\n      | nil =>\n        simp only [List.flatMap_nil, List.nil_append] at hc\n        have hfim := passo_proximoLiteralCheck_fimC (E.head?, true, false) E rest [] [] []\n        have hp := a_parada (E.head?, false, false) E (Simbolo.fimC :: rest)\n        refine custo_mono (EvalsToInTime.trans _ _ _ _ _ _ hc\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico hfim) hp)) ?_\n        · simp [custoLiteral, List.map_cons, List.sum_cons, List.map_nil, List.sum_nil, List.length_cons,\n            List.length_nil]\n          omega\n      | cons l' C''' =>\n        obtain ⟨i', b'⟩ := l'\n        have hforma : ((i', b') :: C''').flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest\n            = (if b' then Simbolo.litT else Simbolo.litF) :: (List.replicate i' Simbolo.tick\n              ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) := by\n          simp [List.flatMap_cons, a_cabeca_e_o_marcador, List.append_assoc]\n        have hc' := evals_congr (algum_inj (ponte_cfg hforma)) hc\n        have hprox := passo_proximoLiteralCheck_literal (E.head?, true, false) E\n          (if b' then Simbolo.litT else Simbolo.litF)\n          (List.replicate i' Simbolo.tick ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) [] [] []\n          (by cases b' <;> simp)\n        have hih := evals_congr_inicio (ponte_cfg hforma)\n          (ih (E.head?, false, false) hn' (by simp))\n        refine custo_mono (EvalsToInTime.trans _ _ _ _ _ _ hc'\n          (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico hprox) hih)) ?_\n        · simp [custoLiteral, List.map_cons, List.sum_cons, List.length_cons, List.length_flatMap,\n            List.length_append, List.length_singleton]\n          omega\n\n/-- ★ A VARREDURA COM ACERTO: algum literal serve — a máquina volta a `lerClausula` com o resto da fórmula e a\ntestemunha intacta. O estado de chegada carrega o lixo do percurso (o registrador), devolvido com a corrida. -/\ndef varredura_acerto (v : Estado) (E : List Simbolo) (C : List (ℕ × Bool)) (rest : List Simbolo)\n    (hsucesso : C.any (testLiteral E) = true) (hC : C ≠ []) :\n    Σ' (junk : Estado), EvalsToInTime aMaquinaTM2.step\n      (cfg .lerLiteral v E (C.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) [] [] [])\n      (some (cfg .lerClausula junk E rest [] [] []))\n      ((C.map fun p => custoLiteral p.1).sum + (C.flatMap codificaLiteral).length + 2) := by\n  induction C generalizing v with\n  | nil => exact absurd rfl hC\n  | cons l C' ih =>\n    obtain ⟨i, b⟩ := l\n    rw [List.flatMap_cons, show (codificaLiteral (i, b) ++ C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)\n        = codificaLiteral (i, b) ++ (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) from by\n        simp [List.append_assoc]]\n    by_cases h0 : testLiteral E (i, b) = true\n    · have hbit : E[i]? = esperado b := by\n        simp only [testLiteral, decide_eq_true_eq] at h0; exact h0\n      have h1 := ciclo_literal_satisfeito v i b (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) E []\n        (proximo_nao_tick C' rest) hbit\n      have h2 := fase_saltarResto ((E.take i).head?, true, true) E rest [] [] [] (C'.flatMap codificaLiteral)\n        (fimC_nao_esta_nos_literais C')\n      refine ⟨((E.take i).head?, true, true), custo_mono (EvalsToInTime.trans _ _ _ _ _ _ h1 h2) ?_⟩\n      simp [custoLiteral]\n      omega\n    · have hne : E[i]? ≠ esperado b := by\n        simp only [testLiteral] at h0\n        have h0f : decide (E[i]? = esperado b) = false := by\n          cases hD : decide (E[i]? = esperado b) with\n          | false => rfl\n          | true => exact absurd hD h0\n        exact (decide_eq_false_iff_not).mp h0f\n      have hs' : C'.any (testLiteral E) = true := by\n        simp only [List.any_cons, h0, Bool.false_or] at hsucesso\n        exact hsucesso\n      by_cases hi : i ≤ E.length\n      · have hc := ciclo_literal_falha v i b (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) E []\n          (proximo_nao_tick C' rest) hi hne\n        cases C' with\n        | nil => simp [List.any_nil] at hs'\n        | cons l' C''' =>\n          obtain ⟨i', b'⟩ := l'\n          have hforma : ((i', b') :: C''').flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest\n              = (if b' then Simbolo.litT else Simbolo.litF) :: (List.replicate i' Simbolo.tick\n                ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) := by\n            simp [List.flatMap_cons, a_cabeca_e_o_marcador, List.append_assoc]\n          have hc' := evals_congr (algum_inj (ponte_cfg hforma)) hc\n          have hprox := passo_proximoLiteralCheck_literal ((E.take i).head?, true, false) E\n            (if b' then Simbolo.litT else Simbolo.litF)\n            (List.replicate i' Simbolo.tick ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) [] [] []\n            (by cases b' <;> simp)\n          obtain ⟨junk, hjunk⟩ := ih ((E.take i).head?, false, false) hs' (by simp)\n          have hjunk' := evals_congr_inicio (ponte_cfg hforma) hjunk\n          refine ⟨junk, custo_mono (EvalsToInTime.trans _ _ _ _ _ _ hc'\n            (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico hprox) hjunk')) ?_⟩\n          simp [custoLiteral, List.map_cons, List.sum_cons, List.length_cons, List.length_flatMap,\n            List.length_append, List.length_singleton]\n          omega\n      · have hi' : E.length < i := Nat.lt_of_not_le hi\n        have hc := ciclo_literal_fora v i b (C'.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest) E []\n          (proximo_nao_tick C' rest) hi'\n        cases C' with\n        | nil => simp [List.any_nil] at hs'\n        | cons l' C''' =>\n          obtain ⟨i', b'⟩ := l'\n          have hforma : ((i', b') :: C''').flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest\n              = (if b' then Simbolo.litT else Simbolo.litF) :: (List.replicate i' Simbolo.tick\n                ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) := by\n            simp [List.flatMap_cons, a_cabeca_e_o_marcador, List.append_assoc]\n          have hc' := evals_congr (algum_inj (ponte_cfg hforma)) hc\n          have hprox := passo_proximoLiteralCheck_literal (E.head?, true, false) E\n            (if b' then Simbolo.litT else Simbolo.litF)\n            (List.replicate i' Simbolo.tick ++ (C'''.flatMap codificaLiteral ++ [Simbolo.fimC] ++ rest)) [] [] []\n            (by cases b' <;> simp)\n          obtain ⟨junk, hjunk⟩ := ih (E.head?, false, false) hs' (by simp)\n          have hjunk' := evals_congr_inicio (ponte_cfg hforma) hjunk\n          refine ⟨junk, custo_mono (EvalsToInTime.trans _ _ _ _ _ _ hc'\n            (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico hprox) hjunk')) ?_⟩\n          simp [custoLiteral, List.map_cons, List.sum_cons, List.length_cons, List.length_flatMap,\n            List.length_append, List.length_singleton]\n          omega\n\n/-! ## O laço das cláusulas e o fechamento -/\n\n/-- A ponte da falha: a cláusula sem acerto tem todos os literais falsos. (Auxiliar do laço.) -/\ntheorem de_toda_falha (E : List Simbolo) (C : List (ℕ × Bool)) (h : clausulaSatNaFita E C = false) :\n    ∀ p ∈ C, testLiteral E p = false := by\n  induction C with\n  | nil => intro p hp; exact absurd hp (by simp)\n  | cons l ls ih =>\n    intro p hp\n    have h' : (testLiteral E l || ls.any (testLiteral E)) = false := h\n    have hl : testLiteral E l = false ∧ ls.any (testLiteral E) = false := by\n      cases hll : testLiteral E l with\n      | false =>\n        simp only [hll, Bool.false_or] at h'\n        exact ⟨rfl, h'⟩\n      | true => simp [hll] at h'\n    rw [List.mem_cons] at hp\n    cases hp with\n    | inl hpeq => subst hpeq; exact hl.1\n    | inr hpin => exact ih hl.2 p hpin\n\n/-- O decide do teste é o bit da fita. (Auxiliar da ponte semântica.) -/\ntheorem decide_converte (P : Prop) [Decidable P] (q : Bool) (h : P ↔ q) : decide P = q := by\n  cases q with\n  | true => simp [decide_eq_true_eq, h]\n  | false => simp [decide_eq_false_iff_not, h]\n\n/-- O teste do literal na fita codificada é o `==` da `verificaNaFita`. (Auxiliar da ponte semântica.) -/\ntheorem teste_literal_converte (bits : List Bool) (p : ℕ × Bool) :\n    testLiteral (codificaBits bits) p = (bits[p.1]? == some p.2) := by\n  obtain ⟨i, b⟩ := p\n  exact decide_converte _ _ (o_teste_e_o_da_fita bits i b)\n\n/-- A cláusula satisfeita na fita codificada é o any da `verificaNaFita`. (Auxiliar da ponte semântica.) -/\ntheorem clausula_converte (bits : List Bool) (C : List (ℕ × Bool)) :\n    clausulaSatNaFita (codificaBits bits) C = C.any fun p => (bits[p.1]? == some p.2) := by\n  induction C with\n  | nil => rfl\n  | cons l ls ih =>\n    have ih' : ls.any (testLiteral (codificaBits bits))\n        = ls.any (fun p => bits[p.1]? == some p.2) := ih\n    simp only [clausulaSatNaFita, List.any_cons]\n    rw [teste_literal_converte bits l, ih']\n\n/-- ★★ **A RESPOSTA DA MÁQUINA É A VERIFICAÇÃO DA FITA.** -/\ntheorem a_resposta_e_a_verificacao (φf : List (List (ℕ × Bool))) (bits : List Bool) :\n    φf.all (clausulaSatNaFita (codificaBits bits)) = verificaNaFita φf bits := by\n  induction φf with\n  | nil => rfl\n  | cons C Cs ih =>\n    rw [List.all_cons, clausula_converte bits C, ih]\n    rfl\n\n/-- O custo dos literais de uma cláusula, desdobrado. (Auxiliar da contabilidade final.) -/\ntheorem soma_custoLiteral (C : List (ℕ × Bool)) :\n    (C.map fun p => custoLiteral p.1).sum = 4 * (C.map Prod.fst).sum + 10 * C.length := by\n  induction C with\n  | nil => rfl\n  | cons l ls ih =>\n    obtain ⟨i, b⟩ := l\n    rw [List.map_cons, List.sum_cons, ih]\n    simp [custoLiteral, List.map_cons, List.sum_cons, List.length_cons]\n    omega\n\n/-- O comprimento de uma cláusula na fita: os ticks, os marcadores. (Auxiliar da contabilidade final.) -/\ntheorem comprimento_da_clausula (C : List (ℕ × Bool)) :\n    (C.flatMap codificaLiteral).length = (C.map Prod.fst).sum + C.length := by\n  induction C with\n  | nil => rfl\n  | cons l ls ih =>\n    obtain ⟨i, b⟩ := l\n    rw [List.flatMap_cons, List.length_append, ih]\n    simp [codificaLiteral, List.length_replicate, List.map_cons, List.sum_cons, List.length_cons]\n    omega\n\n/-- O custo total das cláusulas na forma fechada. (Auxiliar da contabilidade final.) -/\ntheorem custo_total_das_clausulas (Cs : List (List (ℕ × Bool))) :\n    (Cs.map fun C => (C.map fun p => custoLiteral p.1).sum + (C.flatMap codificaLiteral).length + 2).sum\n      = 5 * (Cs.flatten.map Prod.fst).sum + 11 * Cs.flatten.length + 2 * Cs.length := by\n  induction Cs with\n  | nil => rfl\n  | cons C Cs' ih =>\n    rw [List.map_cons, List.sum_cons, soma_custoLiteral C, comprimento_da_clausula C, ih]\n    simp only [List.flatten_cons, List.map_append, List.sum_append, List.length_append, List.length_cons]\n    omega\n\n/-- O comprimento da fórmula pelas cláusulas, na forma fechada. (Auxiliar da contabilidade final.) -/\ntheorem comprimento_das_clausulas (Cs : List (List (ℕ × Bool))) :\n    (Cs.flatMap codificaClausula).length\n      = (Cs.flatten.map Prod.fst).sum + Cs.flatten.length + Cs.length := by\n  induction Cs with\n  | nil => rfl\n  | cons C Cs' ih =>\n    simp [List.flatMap_cons, List.length_append, codificaClausula, comprimento_da_clausula C, ih,\n      List.flatten_cons, List.map_append, List.sum_append, List.length_append, List.length_cons]\n    omega\n\n/-- ★ O LAÇO DAS CLÁUSULAS: de `lerClausula` com a fórmula na pilha ao `haltList` com a resposta — a\nresposta é `true` SSE toda cláusula tem literal que serve. -/\ndef fase_dasClausulas (v : Estado) (E : List Simbolo) (Cs : List (List (ℕ × Bool))) :\n    EvalsToInTime aMaquinaTM2.step\n      (cfg .lerClausula v E (Cs.flatMap codificaClausula ++ [Simbolo.fimF]) [] [] [])\n      (some (Turing.haltList aMaquinaTM2 [Cs.all (clausulaSatNaFita E)]))\n      ((Cs.map fun C => (C.map fun p => custoLiteral p.1).sum + (C.flatMap codificaLiteral).length + 2).sum\n        + ((Cs.flatMap codificaClausula).length + E.length + 5)) := by\n  induction Cs generalizing v with\n  | nil =>\n    have h1 := passo_lerClausula_fimF v E [] [] [] []\n    have hp := a_parada (v.1, true, v.2.2) E [Simbolo.fimF]\n    refine custo_mono (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) hp)) ?_\n    · rfl\n    · simp; omega\n  | cons C Cs' ih =>\n    rw [List.flatMap_cons, show (codificaClausula C ++ Cs'.flatMap codificaClausula ++ [Simbolo.fimF])\n        = codificaClausula C ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]) from by\n        simp [List.append_assoc]]\n    cases C with\n    | nil =>\n      rw [show codificaClausula ([] : List (ℕ × Bool)) = [Simbolo.fimC] from rfl]\n      rw [show ([Simbolo.fimC] ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]))\n          = Simbolo.fimC :: (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]) from rfl]\n      have h1 := passo_lerClausula_fimC v E (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]) [] [] []\n      have hp := a_parada (v.1, false, v.2.2) E\n        (Simbolo.fimC :: (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]))\n      refine custo_mono (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1) hp)) ?_\n      · show some (Turing.haltList aMaquinaTM2 [false])\n          = some (Turing.haltList aMaquinaTM2 [(([] : List (ℕ × Bool)) :: Cs').all (clausulaSatNaFita E)])\n        simp [clausulaSatNaFita, List.all_cons, List.any_nil]\n      · simp [custoLiteral, codificaClausula, List.map_cons, List.sum_cons, List.flatMap_cons,\n          List.flatMap_nil, List.nil_append, List.length_cons, List.length_append, List.length_singleton]\n        omega\n    | cons l C'' =>\n      obtain ⟨i, b⟩ := l\n      have hforma : codificaClausula ((i, b) :: C'') ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF])\n          = (if b then Simbolo.litT else Simbolo.litF) :: (List.replicate i Simbolo.tick\n            ++ (C''.flatMap codificaLiteral ++ [Simbolo.fimC]\n              ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]))) := by\n        simp [codificaClausula, codificaLiteral, List.flatMap_cons, List.cons_append, List.append_assoc]\n      rw [hforma]\n      have h1 := passo_lerClausula_literal v E (if b then Simbolo.litT else Simbolo.litF)\n        (List.replicate i Simbolo.tick ++ (C''.flatMap codificaLiteral ++ [Simbolo.fimC]\n          ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]))) [] [] [] (by cases b <;> simp)\n        (by cases b <;> simp)\n      have hstart : cfg Rotulo.lerLiteral (v.1, false, v.2.2) E\n          ((if b then Simbolo.litT else Simbolo.litF) :: (List.replicate i Simbolo.tick\n            ++ (C''.flatMap codificaLiteral ++ [Simbolo.fimC]\n              ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF])))) [] [] []\n          = cfg Rotulo.lerLiteral (v.1, false, v.2.2) E\n          (((i, b) :: C'').flatMap codificaLiteral ++ [Simbolo.fimC]\n            ++ (Cs'.flatMap codificaClausula ++ [Simbolo.fimF])) [] [] [] := by\n        simp [codificaLiteral, List.flatMap_cons, List.cons_append, List.append_assoc]\n      by_cases hsat : clausulaSatNaFita E ((i, b) :: C'') = true\n      · obtain ⟨junk, hrun0⟩ := varredura_acerto (v.1, false, v.2.2) E ((i, b) :: C'')\n          (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]) hsat (by simp)\n        have hrun := evals_congr_inicio hstart.symm hrun0\n        have hih := ih junk\n        refine custo_mono (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1)\n          (EvalsToInTime.trans _ _ _ _ _ _ hrun hih))) ?_\n        · show some (Turing.haltList aMaquinaTM2 [Cs'.all (clausulaSatNaFita E)])\n            = some (Turing.haltList aMaquinaTM2 [(((i, b) :: C'') :: Cs').all (clausulaSatNaFita E)])\n          simp [List.all_cons, hsat]\n        · simp [custoLiteral, codificaClausula, List.map_cons, List.sum_cons, List.flatMap_cons,\n            List.length_cons, List.length_append, List.length_singleton]\n          omega\n      · have hsatf : clausulaSatNaFita E ((i, b) :: C'') = false := by\n          cases hc : clausulaSatNaFita E ((i, b) :: C'') with\n          | false => rfl\n          | true => exact absurd hc hsat\n        have hvf := varredura_falha_total (v.1, false, v.2.2) E ((i, b) :: C'')\n          (Cs'.flatMap codificaClausula ++ [Simbolo.fimF]) (de_toda_falha E _ hsatf) (by simp)\n        refine custo_mono (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ (passo_unico h1)\n          (evals_congr_inicio hstart.symm hvf))) ?_\n        · show some (Turing.haltList aMaquinaTM2 [false])\n            = some (Turing.haltList aMaquinaTM2 [(((i, b) :: C'') :: Cs').all (clausulaSatNaFita E)])\n          simp [List.all_cons, hsatf]\n        · simp [custoLiteral, codificaClausula, List.map_cons, List.sum_cons, List.flatMap_cons,\n            List.length_cons, List.length_append, List.length_singleton]\n          omega\n\n/-! ## O fechamento -/\n\n/-- ★★ **A SIMULAÇÃO COMPLETA** — habita a `ASimulacaoCompleta` da `AMaquinaTM2DaVerificacao`: para todo par\n(fórmula, testemunha), a máquina TM2 da verificação imprime o veredito da fita em no máximo `contaFases` passos. -/\ndef a_simulacao_completa : ASimulacaoCompleta := fun p => by\n  refine ⟨?_⟩\n  have h1 := a_partida p\n  have h2 := fase_dasClausulas\n    ((codificaFormula p.1).head? <|> ((codificaFormula p.1).reverse.head? <|> none), true, false)\n    (codificaBits p.2) p.1\n  refine custo_mono (evals_congr ?_ (EvalsToInTime.trans _ _ _ _ _ _ h1 h2)) ?_\n  · show some (Turing.haltList aMaquinaTM2 [p.1.all (clausulaSatNaFita (codificaBits p.2))])\n      = Option.map (Turing.haltList aMaquinaTM2) (some (codificaSaida (verificaNaFita p.1 p.2)))\n    rw [a_resposta_e_a_verificacao]\n    rfl\n  · have hLf : (codificaFormula p.1).length = (p.1.flatMap codificaClausula).length + 1 := by\n      simp [codificaFormula, List.length_append]\n    have hB : (codificaBits p.2).length = p.2.length := by simp [codificaBits]\n    have hS := custo_total_das_clausulas p.1\n    have hC := comprimento_das_clausulas p.1\n    simp only [contaFases]\n    omega\n\n/-- ★★ **O OBJETIVO CUMPRIDO**: habita `ObjetivoTM2Polinomial` — a máquina TM2 concreta, no modelo padrão do\nMathlib, que, dadas a fórmula e a testemunha codificadas, calcula `verificaNaFita` em tempo limitado pelo\npolinômio fixo `20·L + 5` no comprimento da entrada. É o verificador de SAT com testemunha; a NP-dificuldade de\nSAT (a outra metade de Cook–Levin) não se prova aqui. -/\ntheorem o_objetivo_cumprido : ObjetivoTM2Polinomial :=\n  o_objetivo_se_reduz_a_simulacao a_simulacao_completa\n\nend TGLExt.OLacoDasClausulas\n\n",
+    'TGLExt/ADescidaPinada.lean': 'import TGLExt.TraducaoTuring\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A descida pinada: o estado-espectro, o estacionamento e a meia-nat espectral\n\n## O que a pedra define\n\nO estado-espectro: uma equação espectral é um eixo (as variáveis lidas) e um valor lido; um ponto serve a\nequação quando a paridade dos seus bits acesos no eixo é o valor; o espectro é a lista das equações lidas,\ne um ponto serve o espectro quando serve cada equação. A iteração de um passo sobre os pontos, a involução\nque vira um bit, a dinâmica da descida (passo, eixo da morte, ressurreição) e o contrato `GatesDaDescida`.\n\nLeitura [INPUT/ONTO]: o rastro da imagem é o neutrino, o gradiente, a descida pinada; o passo remove o que\nnão tem par; no poço o ponto morre pagando um bit e ressurge do outro lado, lido do espectro acumulado; o\neixo da morte é lido do ponto morto, não escolhido. A remoção fixa o eixo da projeção transversal no\nângulo oposto (a primeira lei); pagar um bit é o acoplamento não mínimo; a ressurreição se dá com\nintegridade suficiente; a dinâmica é a máquina fixada antes da fórmula. Essas leituras não são teoremas.\n\n## O que fica provado [REAL no kernel]\n\n1. `serveEspectro_cons`: servir `e :: S` é servir `e` e servir `S`. Leitura [ONTO]: a leitura nunca\n   desmente a leitura.\n2. `a_descida_estaciona` (com o auxiliar `a_descida_estaciona_aux`): sob a hipótese `hprog` (fora da altura\n   zero, o passo ou está pinado ou reduz `custoCNF φ` estritamente), existe `k ≤ custoCNF φ x` tal que o\n   ponto `iterar passo k x` tem altura zero ou é ponto fixo do passo (o poço).\n3. `virar_duplo` e `paridade_virar`: virar duas vezes o bit `j` devolve o ponto; com `a j = true`, virar o\n   bit `j` troca a paridade no eixo `a`.\n4. ★ `paridade_equilibrada`: com `a j = true` para algum `j`, os pontos do cubo `Fin n → Bool` com paridade\n   `true` no eixo `a` e os com paridade `false` têm o mesmo cardinal (a involução `virar j` é a bijeção).\n   Leitura [ONTO]: a meia-nat espectral; uma leitura com eixo povoado corta o cubo ao meio, vale um bit.\n5. O contrato `GatesDaDescida`, com os campos D (`progresso`), G (`crescimento`) e T (`transporte`), é uma\n   estrutura de hipóteses; nenhum campo é provado aqui.\n\n## O que NÃO se afirma\n\n* O contrato `GatesDaDescida`, como está escrito, não é cumprido por NENHUMA dinâmica e nenhum `T`:\n  `TGLExt.AVacuidadeDosContratos.gatesDaDescida_insatisfazivel` [REAL]. Na fórmula da cláusula vazia todo\n  ponto tem custo 1, o progresso obriga a pinagem, e o crescimento pede que a ressurreição sirva um espectro\n  contraditório. Logo um teorema que tome `GatesDaDescida` como hipótese vale no vazio e não diz nada sobre\n  fórmula alguma. Nenhum teorema deste arquivo o toma como hipótese.\n* `paridade_equilibrada` fala do cubo inteiro, não de um espaço residual recortado por um espectro: não se\n  prova aqui que uma equação nova divida ao meio os pontos que servem um espectro já lido.\n* A hipótese `hprog` de `a_descida_estaciona` é cumprida por qualquer passo que fique sempre pinado (por\n  exemplo a identidade), e então `k = 0` já serve [DERIVED]. O teorema não diz que o ponto alcançado tenha\n  altura zero: o poço é ponto fixo, não veredito.\n* A forma clássica da descida (a busca local) paga exponencial no pior caso [KNOWN]; isso não se prova\n  aqui. As paredes do passo ingênuo estão medidas em `TGLExt.AparedeDoPassoIngenuo` [REAL]:\n  `parede_d_estrito_medida` (um passo que leva a altura de 1 a 2), `parede_do_ciclo_medida` (um ciclo de\n  dois pontos de altura 1) e `o_gate_D_estrito_e_falso_para_o_passo_ingenuo` (o gate D estrito falha para\n  esse passo em `n = 2`).\n* Nada aqui decide SAT nem dá cota de tempo na máquina de fita; o campo T é uma proposição arbitrária, não\n  um teorema sobre a fita. Decidir SAT sem testemunha, em tempo polinomial, na máquina de fita segue [OPEN];\n  o gate do Instituto segue de pé e nomeado.\n* Nada sobre a natureza. O gate não se move.\n\nSem `sorry` e sem declaração `axiom` neste arquivo.\n-/\n\nnamespace TGLExt.ADescidaPinada\n\nopen TGLExt.TraducaoTuring\n\nvariable {n : ℕ}\n\n/-! ## O estado-espectro -/\n\n/-- [DEF] A equação espectral: o eixo (as variáveis lidas) e o valor lido. Leitura [ONTO]: é o que a morte\nlê no poço. -/\nstructure EquacaoEspectral (n : ℕ) where\n  eixo : Fin n → Bool\n  valor : Bool\n\n/-- [DEF] A paridade do ponto no eixo: a paridade do número de bits acesos onde o eixo está aceso. -/\ndef paridade {n : ℕ} (x : Fin n → Bool) (a : Fin n → Bool) : Bool :=\n  ((Finset.univ.filter fun i => a i && x i).card % 2 == 1)\n\n/-- [DEF] O ponto serve a equação: a paridade no eixo é o valor lido. -/\ndef serveEquacao {n : ℕ} (x : Fin n → Bool) (e : EquacaoEspectral n) : Bool :=\n  paridade x e.eixo == e.valor\n\n/-- [DEF] O espectro: a lista das leituras feitas. Leitura [ONTO]: cada morte acrescenta uma equação. -/\nabbrev Espectro (n : ℕ) := List (EquacaoEspectral n)\n\n/-- [DEF] O ponto serve o espectro: serve cada equação. (O espaço residual é o conjunto dos que servem.) -/\ndef serveEspectro {n : ℕ} (x : Fin n → Bool) (S : Espectro n) : Bool :=\n  S.all (serveEquacao x)\n\n/-- [REAL] Servir mais uma equação é servir a equação e o espectro. -/\ntheorem serveEspectro_cons {n : ℕ} (x : Fin n → Bool) (e : EquacaoEspectral n) (S : Espectro n) :\n    serveEspectro x (e :: S) = (serveEquacao x e && serveEspectro x S) := by\n  simp [serveEspectro, List.all_cons]\n\n/-! ## O estacionamento dinâmico -/\n\n/-- [DEF] A iteração do passo: `k` aplicações do passo ao ponto. -/\ndef iterar (passo : (Fin n → Bool) → Fin n → Bool) : ℕ → (Fin n → Bool) → (Fin n → Bool)\n  | 0, x => x\n  | k + 1, x => iterar passo k (passo x)\n\n/-- [REAL] Auxiliar do estacionamento, por indução numa cota `m` da altura. -/\ntheorem a_descida_estaciona_aux (passo : (Fin n → Bool) → Fin n → Bool) (φ : CNF n)\n    (hprog : ∀ x, custoCNF φ x ≠ 0 → passo x = x ∨ custoCNF φ (passo x) < custoCNF φ x) :\n    ∀ m : ℕ, ∀ x : Fin n → Bool, custoCNF φ x ≤ m →\n      ∃ k : ℕ, k ≤ custoCNF φ x ∧\n        (custoCNF φ (iterar passo k x) = 0 ∨ passo (iterar passo k x) = iterar passo k x) := by\n  intro m\n  induction m with\n  | zero =>\n    intro x hx\n    have h0 : custoCNF φ x = 0 := Nat.eq_zero_of_le_zero hx\n    exact ⟨0, Nat.zero_le _, Or.inl h0⟩\n  | succ m ihm =>\n    intro x hx\n    by_cases h0 : custoCNF φ x = 0\n    · exact ⟨0, Nat.zero_le _, Or.inl h0⟩\n    · cases hprog x h0 with\n      | inl hp => exact ⟨0, Nat.zero_le _, Or.inr hp⟩\n      | inr hdec =>\n        have hle : custoCNF φ (passo x) ≤ m := by omega\n        obtain ⟨k, hk, hkc⟩ := ihm (passo x) hle\n        exact ⟨k + 1, by omega, hkc⟩\n\n/-- ★ [REAL] **A DESCIDA ESTACIONA**: com um passo que, fora da altura zero, ou está pinado ou reduz a\naltura estritamente, existe `k ≤ custoCNF φ x` tal que o ponto `iterar passo k x` tem altura zero (o\nveredito) ou é ponto fixo do passo (o poço). A altura é o custo da fórmula do kernel. -/\ntheorem a_descida_estaciona (passo : (Fin n → Bool) → Fin n → Bool) (φ : CNF n)\n    (hprog : ∀ x, custoCNF φ x ≠ 0 → passo x = x ∨ custoCNF φ (passo x) < custoCNF φ x)\n    (x : Fin n → Bool) :\n    ∃ k : ℕ, k ≤ custoCNF φ x ∧\n      (custoCNF φ (iterar passo k x) = 0 ∨ passo (iterar passo k x) = iterar passo k x) :=\n  a_descida_estaciona_aux passo φ hprog (custoCNF φ x) x (le_refl _)\n\n/-! ## A meia-nat espectral -/\n\n/-- [DEF] A involução da fibra: virar o bit `j` do ponto. -/\ndef virar {n : ℕ} (j : Fin n) (x : Fin n → Bool) : Fin n → Bool := Function.update x j (! x j)\n\n/-- [REAL] Virar duas vezes devolve o ponto. -/\ntheorem virar_duplo {n : ℕ} (j : Fin n) (x : Fin n → Bool) : virar j (virar j x) = x := by\n  ext i\n  by_cases h : i = j\n  · subst h; simp [virar, Function.update_self, Bool.not_not]\n  · simp [virar, Function.update_of_ne h]\n\n/-- [REAL] O filtro da paridade sob a involução: com o bit `j` aceso no eixo, o filtro do ponto virado é o\nfiltro do ponto menos `j` (se `x j`) ou mais `j` (se não). Auxiliar de `paridade_virar`. -/\ntheorem filtro_virar {n : ℕ} (x a : Fin n → Bool) (j : Fin n) (hj : a j = true) :\n    (Finset.univ.filter fun i => a i && virar j x i)\n      = (if x j then (Finset.univ.filter fun i => a i && x i).erase j\n        else insert j (Finset.univ.filter fun i => a i && x i)) := by\n  ext i\n  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_erase, Finset.mem_insert]\n  by_cases h : i = j\n  · subst h\n    cases hx : x i <;> simp [virar, Function.update_self, hj, hx]\n  · have hupd : virar j x i = x i := Function.update_of_ne h _ _\n    rw [hupd]\n    by_cases hx : x j <;> simp [hx, h]\n\n/-- ★ [REAL] Virar um bit do eixo troca a paridade. -/\ntheorem paridade_virar {n : ℕ} (x a : Fin n → Bool) (j : Fin n) (hj : a j = true) :\n    paridade (virar j x) a = ! paridade x a := by\n  unfold paridade\n  rw [filtro_virar x a j hj]\n  by_cases hx : x j\n  · have hmem : j ∈ Finset.univ.filter (fun i => a i && x i) := by\n      simp [Finset.mem_filter, hj, hx]\n    rw [if_pos hx, Finset.card_erase_of_mem hmem]\n    set c := (Finset.univ.filter (fun i => a i && x i)).card with hc_def\n    have hpos : 1 ≤ c := Finset.card_pos.mpr ⟨j, hmem⟩\n    have h2 := Nat.mod_two_eq_zero_or_one c\n    cases h2 with\n    | inl h0 =>\n      have hc1 : (c - 1) % 2 = 1 := by omega\n      simp [h0, hc1]\n    | inr h1 =>\n      have hc1 : (c - 1) % 2 = 0 := by omega\n      simp [h1, hc1]\n  · have hnmem : j ∉ Finset.univ.filter (fun i => a i && x i) := by\n      simp [Finset.mem_filter, hx]\n    rw [if_neg (by simp [hx]), Finset.card_insert_of_notMem hnmem]\n    set c := (Finset.univ.filter (fun i => a i && x i)).card with hc_def\n    have h2 := Nat.mod_two_eq_zero_or_one c\n    cases h2 with\n    | inl h0 =>\n      have hc1 : (c + 1) % 2 = 1 := by omega\n      simp [h0, hc1]\n    | inr h1 =>\n      have hc1 : (c + 1) % 2 = 0 := by omega\n      simp [h1, hc1]\n\n/-- ★★ [REAL] **A MEIA-NAT ESPECTRAL**: com um eixo povoado (`a j = true`), os pontos do cubo com paridade\n`true` e os com paridade `false` têm o mesmo cardinal; a involução de virar o bit `j` é a bijeção. O\nenunciado é sobre o cubo inteiro, não sobre o espaço residual de um espectro. Leitura [ONTO]: uma leitura\ncom eixo povoado corta o cubo ao meio, vale um bit. -/\ntheorem paridade_equilibrada {n : ℕ} (a : Fin n → Bool) (j : Fin n) (hj : a j = true) :\n    Fintype.card {x : Fin n → Bool // paridade x a = true}\n      = Fintype.card {x : Fin n → Bool // paridade x a = false} := by\n  apply Fintype.card_congr\n  refine ⟨fun x => ⟨virar j x.1, ?_⟩, fun y => ⟨virar j y.1, ?_⟩, ?_, ?_⟩\n  · rw [paridade_virar x.1 a j hj]; simp [x.2]\n  · rw [paridade_virar y.1 a j hj]; simp [y.2]\n  · intro x; exact Subtype.ext (virar_duplo j x.1)\n  · intro y; exact Subtype.ext (virar_duplo j y.1)\n\n/-! ## O contrato dos gates -/\n\n/-- [DEF] A dinâmica da descida: o passo, o eixo da morte e a ressurreição, como funções quaisquer da\nfórmula. Leitura [ONTO]: o passo é a remoção do que não tem par; o eixo da morte é a solução transversal no\npoço, lida do ponto morto; a ressurreição é o ponto do outro lado, lido do espectro acumulado. -/\nstructure DinamicaDaDescida (n : ℕ) where\n  passo : CNF n → (Fin n → Bool) → Fin n → Bool\n  eixoDaMorte : CNF n → (Fin n → Bool) → (Fin n → Bool)\n  ressurreicao : CNF n → Espectro n → (Fin n → Bool)\n\n/-- [DEF] O poço é o estacionamento dinâmico: o passo pinado não move o ponto. -/\ndef estaPinado {n : ℕ} (d : DinamicaDaDescida n) (φ : CNF n) (x : Fin n → Bool) : Prop :=\n  d.passo φ x = x\n\n/-- ★★ [DEF] **OS GATES DA DESCIDA**: um contrato de hipóteses nomeadas; nenhum campo é provado aqui.\n\n- **D (`progresso`):** fora da altura zero, o passo ou está pinado ou reduz a altura estritamente.\n- **G (`crescimento`):** para todo espectro `S` e todo ponto pinado `x` de altura não nula, a ressurreição\n  em `S` serve `S` acrescido da equação nova (o eixo da morte de `x` e a paridade de `x` nesse eixo).\n- **T (`transporte`):** uma proposição dada como parâmetro; leitura [INPUT]: o custo de computar o passo,\n  o eixo e a ressurreição na fita.\n\nLimite [REAL]: nenhuma dinâmica e nenhum `T` cumprem este contrato como está escrito\n(`TGLExt.AVacuidadeDosContratos.gatesDaDescida_insatisfazivel`); um teorema que o tome como hipótese vale\nno vazio e não diz nada sobre fórmula alguma. -/\nstructure GatesDaDescida {n : ℕ} (d : DinamicaDaDescida n) (T : Prop) : Prop where\n  progresso : ∀ (φ : CNF n) (x : Fin n → Bool),\n    custoCNF φ x ≠ 0 → estaPinado d φ x ∨ custoCNF φ (d.passo φ x) < custoCNF φ x\n  crescimento : ∀ (φ : CNF n) (S : Espectro n) (x : Fin n → Bool),\n    estaPinado d φ x → custoCNF φ x ≠ 0 →\n    serveEspectro (d.ressurreicao φ S)\n      (S ++ [⟨d.eixoDaMorte φ x, paridade x (d.eixoDaMorte φ x)⟩]) = true\n  transporte : T\n\nend TGLExt.ADescidaPinada\n\n',
+    'TGLExt/AParedeDoPassoIngenuo.lean': 'import TGLExt.ADescidaPinada\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A parede do passo ingênuo (camada ii: a parede medida)\n\n## O que a pedra trata\n\nA camada (i) (`ADescidaPinada`) nomeia os gates D, G, T do contrato `GatesDaDescida` como hipóteses. Esta\npedra define a dinâmica mais ingênua do escriba — parar na paz; senão virar o bit do primeiro literal da\nprimeira cláusula sem par — e mede, em contraexemplos concretos de duas variáveis, que ela não satisfaz o\ngate D na forma estrita.\n\n## O que fica provado\n\n1. `parede_d_estrito_medida` [REAL] — por `decide`: na fórmula `phiEx` (duas variáveis), o ponto\n   `(falso, falso)` tem altura 1 e o passo ingênuo o leva a um ponto de altura 2 (nem estaciona nem reduz:\n   aumenta).\n2. `parede_do_ciclo_medida` [REAL] — por cálculo (`decide`, com `funext`/`fin_cases` nos pontos): na\n   fórmula insatisfazível `phiCiclo` (`x₀` e `¬x₀`), o passo ingênuo leva `(falso, falso)` a\n   `(verdadeiro, falso)` e `(verdadeiro, falso)` a `(falso, falso)`, os dois com altura 1. Um ciclo de dois\n   pontos distintos: a iteração do passo ingênuo a partir deles não estaciona [DERIVED da troca; não há\n   teorema separado de não terminação].\n3. ★ `o_gate_D_estrito_e_falso_para_o_passo_ingenuo` [REAL] — com `n = 2`, é falso que, para toda fórmula e\n   todo ponto de altura não nula, o passo ingênuo estacione ou reduza estritamente a altura (a forma do\n   campo `progresso` de `GatesDaDescida`, aplicada ao passo ingênuo).\n4. A forma corrigida, só nomeada (definições, sem teorema): `DinamicaComEspectro` (o passo recebe o\n   espectro) e `gateDlinha` (D′: o gate D com o espectro no laço).\n\n## Leitura\n\nA parede não falsifica a descida pinada: mostra que ESTE passo, o ingênuo, não satisfaz o gate D estrito com\n`n = 2`. Não mostra que todo passo sem memória falhe, e o gate D sozinho é satisfeito por um passo que fica\nsempre parado: o valor da parede está em reprovar este passo.\nLeitura [INPUT/ONTO]: o rastro da imagem é o neutrino, o gradiente; nos contraexemplos medidos, o passo\ningênuo sobe ou cicla; a morte paga um bit e o espectro cresce; o estado da descida é o espectro, não o ponto.\n\n## O que NÃO se afirma\n\n* Nada aqui prova os gates D′, G, T: são hipóteses nomeadas; a prova de D′ para uma dinâmica concreta não\n  está nesta pedra.\n* Nada aqui decide SAT nem afirma que algum procedimento o decide em tempo polinomial. O gate do Instituto\n  segue de pé e nomeado.\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo. Validade no kernel não é creditação.\n-/\n\nnamespace TGLExt.AparedeDoPassoIngenuo\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada\n\nvariable {n : ℕ}\n\n/-! ## O passo ingênuo -/\n\n/-- [DEF] A primeira cláusula sem par (o escriba lê na ordem). -/\ndef primeiraSemPar {n : ℕ} (φ : CNF n) (x : Fin n → Bool) : Option (Clausula n) :=\n  φ.find? fun C => ! satisfeita C x\n\n/-- [DEF] O passo ingênuo: para na paz (nenhuma cláusula sem par); na cláusula vazia, estaciona (poço\nimediato — a cláusula vazia não tem quem a sirva); senão vira o bit do primeiro literal da primeira\ncláusula sem par. -/\ndef passoIngenuo {n : ℕ} (φ : CNF n) (x : Fin n → Bool) : Fin n → Bool :=\n  match primeiraSemPar φ x with\n  | none => x\n  | some [] => x\n  | some (l :: _) => virar l.var x\n\n/-! ## Os contraexemplos medidos -/\n\n/-- O ponto de dois bits. -/\ndef pt (b0 b1 : Bool) : Fin 2 → Bool := fun i => if i = 0 then b0 else b1\n\n/-- A fórmula do contraexemplo do gate estrito: `x₀`; `¬x₀ ∨ x₁`; `¬x₀`. -/\ndef phiEx : CNF 2 := [[⟨0, true⟩], [⟨0, false⟩, ⟨1, true⟩], [⟨0, false⟩]]\n\n/-- ★ A PAREDE DO GATE ESTRITO, MEDIDA: o ponto `(falso, falso)` tem altura 1; o passo ingênuo o leva à\naltura 2 — nem estaciona nem reduz: aumenta. -/\ntheorem parede_d_estrito_medida :\n    custoCNF phiEx (pt false false) = 1\n      ∧ custoCNF phiEx (passoIngenuo phiEx (pt false false)) = 2 := by\n  decide\n\n/-- A fórmula do ciclo: `x₀` e `¬x₀` — insatisfazível. -/\ndef phiCiclo : CNF 2 := [[⟨0, true⟩], [⟨0, false⟩]]\n\n/-- ★ A PAREDE DO CICLO, MEDIDA: o passo ingênuo troca `(falso, falso)` com `(verdadeiro, falso)`, os dois\ncom altura 1 — um ciclo de dois pontos, sem estacionamento nesses pontos. -/\ntheorem parede_do_ciclo_medida :\n    passoIngenuo phiCiclo (pt false false) = pt true false\n      ∧ passoIngenuo phiCiclo (pt true false) = pt false false\n      ∧ custoCNF phiCiclo (pt false false) = 1\n      ∧ custoCNF phiCiclo (pt true false) = 1 := by\n  refine ⟨?_, ?_, by decide, by decide⟩ <;> funext i <;> fin_cases i <;> decide\n\n/-- ★★ **O GATE D ESTRITO É FALSO PARA O PASSO INGÊNUO** (com `n = 2`): há fórmula e ponto, fora do\nveredito, em que o passo nem estaciona nem reduz a altura. -/\ntheorem o_gate_D_estrito_e_falso_para_o_passo_ingenuo :\n    ¬ (∀ (φ : CNF 2) (x : Fin 2 → Bool), custoCNF φ x ≠ 0 →\n        passoIngenuo φ x = x ∨ custoCNF φ (passoIngenuo φ x) < custoCNF φ x) := by\n  intro h\n  obtain ⟨h1, h2⟩ := parede_d_estrito_medida\n  have hz : custoCNF phiEx (pt false false) ≠ 0 := by omega\n  cases h phiEx (pt false false) hz with\n  | inl hp => rw [hp] at h2; omega\n  | inr hd => omega\n\n/-! ## A forma corrigida, nomeada -/\n\n/-- [DEF] A dinâmica com o espectro no laço: o passo recebe o espectro, o que já foi lido. Só os campos\nsão nomeados; nenhuma propriedade é provada sobre esta estrutura aqui. Leitura [INPUT/ONTO]: o estado da\ndescida é o espectro, não o ponto — a leitura nunca desmente a leitura. -/\nstructure DinamicaComEspectro (n : ℕ) where\n  passo : CNF n → Espectro n → (Fin n → Bool) → Fin n → Bool\n  eixoDaMorte : CNF n → (Fin n → Bool) → (Fin n → Bool)\n  ressurreicao : CNF n → Espectro n → (Fin n → Bool)\n\n/-- [DEF] O gate D na forma corrigida (D′), uma proposição nomeada, não um teorema: com o espectro no\nlaço, fora do veredito o passo ou está pinado ou reduz a altura. Leitura [INPUT/OPEN]: que os poços não\nse repitam dependeria de o espectro crescer a cada poço; isso não está no tipo do gate G nem é provado\naqui. -/\ndef gateDlinha {n : ℕ} (d : DinamicaComEspectro n) : Prop :=\n  ∀ (φ : CNF n) (S : Espectro n) (x : Fin n → Bool),\n    custoCNF φ x ≠ 0 → d.passo φ S x = x ∨ custoCNF φ (d.passo φ S x) < custoCNF φ x\n\nend TGLExt.AparedeDoPassoIngenuo\n\n',
+    'TGLExt/ADescidaComEspectro.lean': "import TGLExt.AParedeDoPassoIngenuo\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A descida com espectro (camada ii): o estacionamento provado\n\n## O que a pedra define\n\nO passo da descida com o espectro no laço: o estado é o par (registro das sombras lidas, ponto). A sombra\nde cada cláusula usada fica registrada, e o ponto estaciona quando não há cláusula sem par (o veredito),\nquando a primeira cláusula sem par é vazia, ou quando a sombra da primeira cláusula sem par já foi lida\n(o poço).\n\nLeitura [INPUT/ONTO]: o estado da descida é o espectro (o rastro-neutrino), não o ponto; a leitura nunca\ndesmente a leitura.\n\n## O que fica provado nesta camada [REAL no kernel]\n\n1. `passo_ou_estaciona_ou_cresce`: a análise do passo; ou estaciona, ou registra a sombra nova de uma\n   cláusula da fórmula e move o ponto.\n2. `pinado_persiste` e `descer_add`: a pinagem persiste; a iteração compõe.\n3. `descer_invariante`: o invariante do laço; as sombras lidas ficam distintas e dentro das sombras das\n   cláusulas; ou já estacionou em algum passo `j ≤ k`, ou o comprimento do registro é o inicial mais `k`.\n4. ★★ `a_descida_com_espectro_estaciona`: a terminação; em no máximo `|φ|` passos (o número de cláusulas),\n   partindo do registro vazio, o estado alcançado é ponto fixo do passo. Pela definição do passo, esse ponto\n   fixo é o veredito (nenhuma cláusula sem par), a cláusula vazia ou o poço [DERIVED da definição].\n\nO registro das sombras é uma lista de listas de variáveis; não é o tipo `Espectro n` de `ADescidaPinada`, e\nnenhuma `DinamicaComEspectro` é instanciada aqui.\n\nLeitura [ONTO]: a morte sempre tem onde morrer.\n\n## O que NÃO se afirma\n\n* Não se afirma que o poço seja sempre alcançado: o teorema diz que a descida estaciona num ponto fixo. No\n  poço há uma cláusula sem par; estacionar no poço a partir de um ponto não prova que a fórmula seja\n  insatisfazível, e esta pedra não decide SAT. Sem o registro, o passo ingênuo pode subir ou ciclar\n  (`AParedeDoPassoIngenuo`).\n* O que acontece no poço (a morte, a ressurreição, o crescimento do espectro das equações) não é tratado\n  aqui; os gates G e T seguem como hipóteses nomeadas no contrato da camada (i).\n* O gate D′ (`gateDlinha`, em `AParedeDoPassoIngenuo`), o progresso da altura DENTRO de uma descida, não é\n  tratado aqui; esta pedra prova a terminação.\n* Nada sobre a natureza e nada sobre P versus NP: o gate do Instituto segue de pé e nomeado.\n\nSem `sorry` e sem declaração `axiom` neste arquivo.\n-/\n\nnamespace TGLExt.ADescidaComEspectro\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo\n\nvariable {n : ℕ}\n\n/-- [DEF] A sombra da cláusula: as variáveis que ela lê, na ordem do escriba. -/\ndef sombraDe {n : ℕ} (C : Clausula n) : List (Fin n) := C.map Literal.var\n\n/-- [DEF] O estado da descida: o registro das sombras lidas e o ponto atual. -/\nabbrev EstadoDescida (n : ℕ) := List (List (Fin n)) × (Fin n → Bool)\n\n/-- [DEF] O passo com o espectro no laço: para na paz; estaciona na cláusula vazia (poço imediato);\nestaciona no poço quando a sombra da primeira cláusula sem par já foi lida; senão registra a sombra e vira\no bit do primeiro literal. -/\ndef passoComEspectro {n : ℕ} (φ : CNF n) (leu : List (List (Fin n))) (x : Fin n → Bool) :\n    EstadoDescida n :=\n  match primeiraSemPar φ x with\n  | none => (leu, x)\n  | some [] => (leu, x)\n  | some (l :: C') =>\n    if sombraDe (l :: C') ∈ leu then (leu, x)\n    else (sombraDe (l :: C') :: leu, virar l.var x)\n\n/-- ★ A análise do passo: ou estaciona, ou registra a sombra nova de uma cláusula da fórmula e move. -/\ntheorem passo_ou_estaciona_ou_cresce {n : ℕ} (φ : CNF n) (leu : List (List (Fin n))) (x : Fin n → Bool) :\n    passoComEspectro φ leu x = (leu, x) ∨\n      ∃ (l : Literal n) (C' : Clausula n), (l :: C') ∈ φ ∧ sombraDe (l :: C') ∉ leu ∧\n        passoComEspectro φ leu x = (sombraDe (l :: C') :: leu, virar l.var x) := by\n  cases h : primeiraSemPar φ x with\n  | none => exact Or.inl (by simp [passoComEspectro, h])\n  | some C =>\n    cases C with\n    | nil => exact Or.inl (by simp [passoComEspectro, h])\n    | cons l C' =>\n      by_cases hs : sombraDe (l :: C') ∈ leu\n      · exact Or.inl (by simp [passoComEspectro, h, hs])\n      · exact Or.inr ⟨l, C', List.mem_of_find?_eq_some h, hs, by simp [passoComEspectro, h, hs]⟩\n\n/-- [DEF] A descida com combustível: `k` aplicações do passo (cada aplicação é o passo do estado anterior). -/\ndef descerComEspectro {n : ℕ} (φ : CNF n) : ℕ → EstadoDescida n → EstadoDescida n\n  | 0, st => st\n  | k + 1, st => passoComEspectro φ (descerComEspectro φ k st).1 (descerComEspectro φ k st).2\n\n/-- A pinagem persiste: estacionado, o estado não sai mais do lugar. -/\ntheorem pinado_persiste {n : ℕ} (φ : CNF n) (st : EstadoDescida n)\n    (hp : passoComEspectro φ st.1 st.2 = st) :\n    ∀ k : ℕ, descerComEspectro φ k st = st := by\n  intro k\n  induction k with\n  | zero => rfl\n  | succ k ih =>\n    show passoComEspectro φ (descerComEspectro φ k st).1 (descerComEspectro φ k st).2 = st\n    rw [ih]\n    exact hp\n\n/-- A iteração compõe: `b + a` passos são `a` passos depois de `b`. -/\ntheorem descer_add {n : ℕ} (φ : CNF n) (a b : ℕ) (st : EstadoDescida n) :\n    descerComEspectro φ (b + a) st = descerComEspectro φ a (descerComEspectro φ b st) := by\n  induction a with\n  | zero => rfl\n  | succ k ih =>\n    rw [Nat.add_succ]\n    have e1 : descerComEspectro φ (b + k + 1) st\n        = passoComEspectro φ (descerComEspectro φ (b + k) st).1 (descerComEspectro φ (b + k) st).2 := rfl\n    have e2 : descerComEspectro φ (k + 1) (descerComEspectro φ b st)\n        = passoComEspectro φ (descerComEspectro φ k (descerComEspectro φ b st)).1\n            (descerComEspectro φ k (descerComEspectro φ b st)).2 := rfl\n    rw [e1, e2, ih]\n\n/-- ★ O invariante do laço: as sombras lidas ficam distintas e dentro das sombras das cláusulas; ou já\nestacionou em algum passo `j ≤ k`, ou o comprimento do registro é o inicial mais `k` (um por passo). -/\ntheorem descer_invariante {n : ℕ} (φ : CNF n) :\n    ∀ (k : ℕ) (leu : List (List (Fin n))) (x : Fin n → Bool),\n      leu.Nodup → leu ⊆ φ.map sombraDe →\n      (descerComEspectro φ k (leu, x)).1.Nodup\n        ∧ (descerComEspectro φ k (leu, x)).1 ⊆ φ.map sombraDe\n        ∧ ((∃ j : ℕ, j ≤ k ∧\n              passoComEspectro φ (descerComEspectro φ j (leu, x)).1 (descerComEspectro φ j (leu, x)).2\n                = descerComEspectro φ j (leu, x))\n            ∨ (descerComEspectro φ k (leu, x)).1.length = leu.length + k) := by\n  intro k\n  induction k with\n  | zero => intro leu x hnd hsub; exact ⟨hnd, hsub, Or.inr rfl⟩\n  | succ k ih =>\n    intro leu x hnd hsub\n    obtain ⟨hnd0, hsub0, hcas0⟩ := ih leu x hnd hsub\n    cases passo_ou_estaciona_ou_cresce φ (descerComEspectro φ k (leu, x)).1\n        (descerComEspectro φ k (leu, x)).2 with\n    | inl hpark =>\n      have hid : descerComEspectro φ (k + 1) (leu, x) = descerComEspectro φ k (leu, x) := hpark\n      refine ⟨?_, ?_, Or.inl ⟨k, Nat.le_succ k, hpark⟩⟩\n      · rw [hid]; exact hnd0\n      · rw [hid]; exact hsub0\n    | inr hmove =>\n      obtain ⟨l, C', hmem, hfresh, hpasso⟩ := hmove\n      have hnd1 : (sombraDe (l :: C') :: (descerComEspectro φ k (leu, x)).1).Nodup :=\n        List.nodup_cons.mpr ⟨hfresh, hnd0⟩\n      have hsub1 : (sombraDe (l :: C') :: (descerComEspectro φ k (leu, x)).1) ⊆ φ.map sombraDe := by\n        intro s hs\n        rw [List.mem_cons] at hs\n        cases hs with\n        | inl heq => rw [heq]; exact List.mem_map_of_mem hmem\n        | inr hs' => exact hsub0 hs'\n      have hid : descerComEspectro φ (k + 1) (leu, x)\n          = (sombraDe (l :: C') :: (descerComEspectro φ k (leu, x)).1,\n              virar l.var (descerComEspectro φ k (leu, x)).2) := hpasso\n      refine ⟨?_, ?_, ?_⟩\n      · rw [hid]; exact hnd1\n      · rw [hid]; exact hsub1\n      · cases hcas0 with\n        | inl hparked =>\n          obtain ⟨j, hj, hp⟩ := hparked\n          exact Or.inl ⟨j, by omega, hp⟩\n        | inr hlen0 =>\n          right\n          rw [hid, List.length_cons, hlen0]\n          omega\n\n/-- ★★ **A DESCIDA COM ESPECTRO ESTACIONA**: com combustível igual ao número de cláusulas `|φ|`, partindo\ndo registro vazio, o estado alcançado é ponto fixo do passo: a descida está pinada no veredito (nenhuma\ncláusula sem par) ou no poço (a primeira cláusula sem par é vazia ou tem a sombra já lida). Razão: cada\npasso que não estaciona registra uma sombra nova, e as sombras registradas são distintas e estão entre as\nsombras das cláusulas. Leitura [ONTO]: a morte sempre tem onde morrer. -/\ntheorem a_descida_com_espectro_estaciona {n : ℕ} (φ : CNF n) (x : Fin n → Bool) :\n    passoComEspectro φ (descerComEspectro φ φ.length ([], x)).1\n        (descerComEspectro φ φ.length ([], x)).2\n      = descerComEspectro φ φ.length ([], x) := by\n  obtain ⟨hnd, hsub, hcas⟩ :=\n    descer_invariante φ φ.length [] x List.nodup_nil (List.nil_subset _)\n  cases hcas with\n  | inl hparked =>\n    obtain ⟨j, hj, hp⟩ := hparked\n    have hcom : φ.length = j + (φ.length - j) := (Nat.add_sub_of_le hj).symm\n    have hid : descerComEspectro φ φ.length ([], x) = descerComEspectro φ j ([], x) := by\n      rw [hcom, descer_add, pinado_persiste φ _ hp (φ.length - j)]\n    rw [hid]\n    exact hp\n  | inr hlen =>\n    have hlen0 : (descerComEspectro φ φ.length ([], x)).1.length = φ.length := by\n      simp at hlen\n      omega\n    cases h : primeiraSemPar φ (descerComEspectro φ φ.length ([], x)).2 with\n    | none => simp [passoComEspectro, h, Prod.eta]\n    | some C =>\n      cases C with\n      | nil => simp [passoComEspectro, h, Prod.eta]\n      | cons l C' =>\n        have hmem : (l :: C') ∈ φ := List.mem_of_find?_eq_some h\n        have hcontem : sombraDe (l :: C') ∈ (descerComEspectro φ φ.length ([], x)).1 := by\n          by_contra hfora\n          have hnd' : ((descerComEspectro φ φ.length ([], x)).1 ++ [sombraDe (l :: C')]).Nodup := by\n            rw [List.nodup_append]\n            refine ⟨hnd, List.nodup_singleton _, ?_⟩\n            intro sombra hs1 sombra2 hmem2\n            rw [List.mem_singleton] at hmem2\n            subst hmem2\n            intro hcontra\n            subst hcontra\n            exact hfora hs1\n          have hsub' : (descerComEspectro φ φ.length ([], x)).1 ++ [sombraDe (l :: C')]\n              ⊆ φ.map sombraDe := by\n            intro s hs\n            rw [List.mem_append] at hs\n            cases hs with\n            | inl hs1 => exact hsub hs1\n            | inr hs2 =>\n              rw [List.mem_singleton] at hs2\n              rw [hs2]\n              exact List.mem_map_of_mem hmem\n          have hcompr := List.Subperm.length_le (List.Nodup.subperm hnd' hsub')\n          rw [List.length_append, List.length_singleton, List.length_map, hlen0] at hcompr\n          omega\n        simp [passoComEspectro, h, hcontem, Prod.eta]\n\nend TGLExt.ADescidaComEspectro\n\n",
+    'TGLExt/AMorteEARessurreicao.lean': "import TGLExt.ADescidaComEspectro\nimport Mathlib.Data.ZMod.Basic\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A morte e a ressurreição: a homogeneidade espectral e a partição do resíduo\n\n## O que é\n\nA leitura espectral de um ponto do cubo `Fin n → Bool` é a lista das suas paridades em `ZMod 2` num conjunto de\neixos. A paridade é um homomorfismo do cubo (o xor); por isso todas as fibras não vazias da leitura têm o mesmo\ntamanho; e, quando uma paridade nova toma os dois valores dentro de uma fibra, os pontos da fibra em que ela vale 1\nsão exatamente metade da fibra (o teorema enuncia só o lado do valor 1).\n\nLeitura do autor [ONTO]: o bit pago na morte é o próprio acoplamento não mínimo; o ponto do outro lado não é ponto,\né o espectro da projeção sendo lida; o ângulo lê o ponto de morte e o projeta no lado oposto.\n\n## O que fica provado [REAL]\n\n1. `paridade2_add`: a paridade é aditiva sob o xor do cubo, `paridade2 (xorPonto x d) a = paridade2 x a +\n   paridade2 d a`.\n2. `leitura2_xor`: a leitura do ponto traduzido é a soma, termo a termo, das leituras. `zipAdd_cancel` e\n   `zipAdd_cancel_esq`: o cancelamento em `ZMod 2` de listas do mesmo comprimento.\n3. `fibras_iguais`: dois valores atingidos pela leitura do mesmo conjunto de eixos têm fibras do mesmo cardinal\n   (a translação pelo xor é a bijeção).\n4. `zmod2_exaustivo`: todo elemento de `ZMod 2` é 0 ou 1.\n5. `a_morte_parte_o_residuo`: se a paridade nova `a` toma os valores 0 e 1 dentro da fibra de `vals`, então\n   `2 * card (fibra de vals ++ [1]) = card (fibra de vals)`. `a_morte_parte_o_residuo_espectral`: o mesmo na forma\n   espectral, para a equação nova `(a, 1)`. O enunciado é para o valor 1; o lado do valor 0 segue pela mesma conta,\n   mas não é enunciado.\n6. As definições `eixoDaMorteDe`, `aMorte`, `DinamicaDaMorte` e o contrato `GatesDaMorte`, com os campos `fiel`\n   (G1, a ressurreição fiel) e `divide` (G2, a leitura divide), que são hipóteses nomeadas, não teoremas.\n\n## O que NÃO se afirma\n\n* O contrato `GatesDaMorte`, como está escrito, não é cumprido por nenhuma dinâmica:\n  `TGLExt.AVacuidadeDosContratos.gatesDaMorte_insatisfazivel` [REAL]. O campo `divide` é exigido para todo\n  espectro, inclusive um contraditório (a equação de eixo vazio com valor 1), que nenhum ponto serve\n  (`TGLExt.AVacuidadeDosContratos.ninguem_serve2`). Um teorema que tome\n  `GatesDaMorte` como hipótese vale no vazio: não diz nada sobre fórmula alguma.\n* A equação `aMorte φ w` pode ter valor 0; o teorema da partição está enunciado para a equação nova de valor 1.\n* Esta pedra não conta o número de mortes nem dá um limite para ele: dá a razão da partição de uma fibra quando a\n  paridade nova toma os dois valores.\n* Nada aqui diz que algum procedimento ou a máquina de Turing decida SAT, em tempo algum. Decidir SAT sem\n  testemunha, em tempo polinomial, na máquina de fita segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AMorteEARessurreicao\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\n\nvariable {n : ℕ}\n\n/-! ## A paridade como homomorfismo -/\n\n/-- [INPUT] O xor de dois pontos (a translação do cubo). -/\ndef xorPonto {n : ℕ} (x y : Fin n → Bool) : Fin n → Bool := fun i => (x i != y i)\n\n/-- [REAL] O xor é involução no segundo argumento. (Auxiliar da bijeção das fibras.) -/\ntheorem xorPonto_invol {n : ℕ} (x d : Fin n → Bool) : xorPonto (xorPonto x d) d = x := by\n  ext i\n  show ((x i != d i) != d i) = x i\n  cases hx : x i <;> cases hd : d i <;> rfl\n\n/-- [INPUT] A paridade em `ZMod 2`: a soma dos bits onde o eixo está aceso. -/\ndef paridade2 {n : ℕ} (x : Fin n → Bool) (a : Fin n → Bool) : ZMod 2 :=\n  ∑ i : Fin n, (if a i && x i then (1 : ZMod 2) else 0)\n\n/-- [REAL] A paridade é aditiva sob o xor: a leitura é um homomorfismo do cubo. -/\ntheorem paridade2_add {n : ℕ} (x d a : Fin n → Bool) :\n    paridade2 (xorPonto x d) a = paridade2 x a + paridade2 d a := by\n  unfold paridade2 xorPonto\n  rw [← Finset.sum_add_distrib]\n  apply Finset.sum_congr rfl\n  intro i _\n  cases a i <;> cases x i <;> cases d i <;> decide\n\n/-- [INPUT] A leitura espectral: as paridades do ponto nos eixos. -/\ndef leitura2 {n : ℕ} (axes : List (Fin n → Bool)) (x : Fin n → Bool) : List (ZMod 2) :=\n  axes.map fun a => paridade2 x a\n\n/-- [REAL] A leitura do ponto traduzido é a soma das leituras. (Auxiliar da homogeneidade.) -/\ntheorem leitura2_xor {n : ℕ} (axes : List (Fin n → Bool)) (x d : Fin n → Bool) :\n    leitura2 axes (xorPonto x d)\n      = List.zipWith (· + ·) (leitura2 axes x) (leitura2 axes d) := by\n  induction axes with\n  | nil => rfl\n  | cons a ax ih => simp [leitura2, List.map_cons, List.zipWith_cons_cons, paridade2_add, ih]\n\n/-- [REAL] O cancelamento, à esquerda: `v₁ ⊞ (v₁ ⊞ v₂) = v₂`, com as duas listas do mesmo comprimento.\n(Auxiliar da homogeneidade.) -/\ntheorem zipAdd_cancel : ∀ (v₁ v₂ : List (ZMod 2)), v₁.length = v₂.length →\n    List.zipWith (· + ·) v₁ (List.zipWith (· + ·) v₁ v₂) = v₂ := by\n  intro v₁\n  induction v₁ with\n  | nil =>\n    intro v₂ hl\n    cases v₂ with\n    | nil => rfl\n    | cons c cs => simp at hl\n  | cons a ax ih =>\n    intro v₂ hl\n    cases v₂ with\n    | nil => simp at hl\n    | cons b bx =>\n      have hhead : a + (a + b) = b := by\n        rw [← add_assoc, CharTwo.add_self_eq_zero, zero_add]\n      have hll : ax.length = bx.length := by simpa using hl\n      simp [List.zipWith_cons_cons, hhead, ih bx hll]\n\n/-- [REAL] O cancelamento, cruzado: `v₂ ⊞ (v₁ ⊞ v₂) = v₁`, com as duas listas do mesmo comprimento.\n(Auxiliar da homogeneidade.) -/\ntheorem zipAdd_cancel_esq : ∀ (v₁ v₂ : List (ZMod 2)), v₁.length = v₂.length →\n    List.zipWith (· + ·) v₂ (List.zipWith (· + ·) v₁ v₂) = v₁ := by\n  intro v₁\n  induction v₁ with\n  | nil =>\n    intro v₂ hl\n    cases v₂ with\n    | nil => rfl\n    | cons c cs => simp at hl\n  | cons a ax ih =>\n    intro v₂ hl\n    cases v₂ with\n    | nil => simp at hl\n    | cons b bx =>\n      have hhead : b + (a + b) = a := by\n        rw [add_comm b (a + b), add_assoc, CharTwo.add_self_eq_zero, add_zero]\n      have hll : ax.length = bx.length := by simpa using hl\n      simp [List.zipWith_cons_cons, hhead, ih bx hll]\n\n/-- [REAL] **A homogeneidade espectral**: dois valores atingidos pela leitura do mesmo conjunto de eixos têm\nfibras do mesmo cardinal; a translação pelo xor é a bijeção. Leitura [ONTO]: o espectro não privilegia sombra. -/\ntheorem fibras_iguais {n : ℕ} (axes : List (Fin n → Bool)) (v₁ v₂ : List (ZMod 2))\n    (x₁ : Fin n → Bool) (h1 : leitura2 axes x₁ = v₁)\n    (x₂ : Fin n → Bool) (h2 : leitura2 axes x₂ = v₂) :\n    (Finset.univ.filter fun x => leitura2 axes x = v₁).card\n      = (Finset.univ.filter fun x => leitura2 axes x = v₂).card := by\n  have hlen : v₁.length = v₂.length := by\n    rw [← h1, ← h2]\n    simp [leitura2, List.length_map]\n  simp only [← Fintype.card_subtype]\n  apply Fintype.card_congr\n  refine ⟨fun x => ⟨xorPonto x.1 (xorPonto x₁ x₂), ?_⟩, fun y => ⟨xorPonto y.1 (xorPonto x₁ x₂), ?_⟩,\n    ?_, ?_⟩\n  · have hd : leitura2 axes (xorPonto x₁ x₂) = List.zipWith (· + ·) v₁ v₂ := by\n      rw [leitura2_xor, h1, h2]\n    rw [leitura2_xor, x.2, hd, zipAdd_cancel v₁ v₂ hlen]\n  · have hd : leitura2 axes (xorPonto x₁ x₂) = List.zipWith (· + ·) v₁ v₂ := by\n      rw [leitura2_xor, h1, h2]\n    rw [leitura2_xor, y.2, hd, zipAdd_cancel_esq v₁ v₂ hlen]\n  · intro x; exact Subtype.ext (xorPonto_invol x.1 (xorPonto x₁ x₂))\n  · intro y; exact Subtype.ext (xorPonto_invol y.1 (xorPonto x₁ x₂))\n\n/-! ## A partição do resíduo -/\n\n/-- [REAL] A leitura com um eixo a mais é a leitura com a paridade nova no fim. (Auxiliar da partição.) -/\ntheorem leitura2_snoc {n : ℕ} (axes : List (Fin n → Bool)) (a : Fin n → Bool) (x : Fin n → Bool) :\n    leitura2 (axes ++ [a]) x = leitura2 axes x ++ [paridade2 x a] := by\n  simp [leitura2, List.map_append]\n\n/-- [REAL] A igualdade de cauda única: `L ++ [b] = M ++ [c]` dá `L = M` e `b = c`. (Auxiliar da partição.) -/\ntheorem append_snod_inj {α : Type} {L M : List α} {b c : α} (h : L ++ [b] = M ++ [c]) :\n    L = M ∧ b = c := by\n  have hr := congrArg List.reverse h\n  simp only [List.reverse_append, List.reverse_singleton, List.singleton_append] at hr\n  rw [List.cons.injEq] at hr\n  exact ⟨List.reverse_injective hr.2, hr.1⟩\n\n/-- [REAL] Todo elemento de `ZMod 2` é 0 ou 1. (Auxiliar da partição.) -/\ntheorem zmod2_exaustivo (z : ZMod 2) : z = 0 ∨ z = 1 := by\n  obtain ⟨v, hv⟩ := z\n  interval_cases v\n  · exact Or.inl rfl\n  · exact Or.inr rfl\n\n/-- [REAL] **A partição do resíduo**: se a paridade nova `a` toma os valores 0 e 1 dentro da fibra de `vals`, a\nfibra de `vals ++ [1]` tem exatamente metade dos pontos da fibra de `vals` (`2 * card = card`). O enunciado é para o\nvalor 1; o lado do valor 0 segue pela mesma conta, mas não é enunciado. Leitura [ONTO]: uma leitura que divide\ncusta um bit (o fator 2 da conta, isto é ln 2 nat). -/\ntheorem a_morte_parte_o_residuo {n : ℕ} (axes : List (Fin n → Bool)) (vals : List (ZMod 2))\n    (a : Fin n → Bool)\n    (h0 : ∃ x : Fin n → Bool, leitura2 axes x = vals ∧ paridade2 x a = 0)\n    (h1 : ∃ x : Fin n → Bool, leitura2 axes x = vals ∧ paridade2 x a = 1) :\n    2 * (Finset.univ.filter fun x => leitura2 (axes ++ [a]) x = vals ++ [1]).card\n      = (Finset.univ.filter fun x => leitura2 axes x = vals).card := by\n  obtain ⟨x0, hx0, hp0⟩ := h0\n  obtain ⟨x1, hx1, hp1⟩ := h1\n  have hfib := fibras_iguais (axes ++ [a]) (vals ++ [1]) (vals ++ [0]) x1\n    (by rw [leitura2_snoc, hx1, hp1]) x0 (by rw [leitura2_snoc, hx0, hp0])\n  have hpart : (Finset.univ.filter fun x => leitura2 axes x = vals)\n      = (Finset.univ.filter fun x => leitura2 (axes ++ [a]) x = vals ++ [0])\n        ∪ (Finset.univ.filter fun x => leitura2 (axes ++ [a]) x = vals ++ [1]) := by\n    ext x\n    simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_union]\n    rw [leitura2_snoc]\n    constructor\n    · intro hx\n      cases zmod2_exaustivo (paridade2 x a) with\n      | inl hz => exact Or.inl (by rw [hx, hz])\n      | inr hz => exact Or.inr (by rw [hx, hz])\n    · intro h\n      cases h with\n      | inl h0' => exact (append_snod_inj h0').1\n      | inr h1' => exact (append_snod_inj h1').1\n  have hdisj : Disjoint (Finset.univ.filter fun x => leitura2 (axes ++ [a]) x = vals ++ [0])\n      (Finset.univ.filter fun x => leitura2 (axes ++ [a]) x = vals ++ [1]) := by\n    rw [Finset.disjoint_left]\n    intro x hx0' hx1'\n    rw [Finset.mem_filter] at hx0' hx1'\n    have h := hx0'.2.symm.trans hx1'.2\n    have h01 : (0 : ZMod 2) = 1 := (append_snod_inj h).2\n    exact (by decide : (0 : ZMod 2) ≠ 1) h01\n  rw [hpart, Finset.card_union_of_disjoint hdisj]\n  omega\n\n/-! ## A forma espectral (o espectro como lista de equações) -/\n\n/-- [INPUT] O espectro com valores em `ZMod 2`: a lista das equações lidas (eixo, valor). -/\nabbrev Espectro2 (n : ℕ) := List ((Fin n → Bool) × ZMod 2)\n\n/-- [INPUT] O ponto serve o espectro: cada equação lida vale nele. -/\ndef serveEspectro2 {n : ℕ} (x : Fin n → Bool) (S : Espectro2 n) : Bool :=\n  S.all fun e => paridade2 x e.1 == e.2\n\n/-- [REAL] Servir o espectro é a leitura dos eixos bater os valores. (Auxiliar da forma espectral.) -/\ntheorem serveEspectro2_leitura2 {n : ℕ} (x : Fin n → Bool) (S : Espectro2 n) :\n    serveEspectro2 x S = true ↔ leitura2 (S.map Prod.fst) x = S.map Prod.snd := by\n  induction S with\n  | nil => simp [serveEspectro2, leitura2]\n  | cons e S' ih =>\n    obtain ⟨a, v⟩ := e\n    have hcons : leitura2 (a :: S'.map Prod.fst) x\n        = paridade2 x a :: leitura2 (S'.map Prod.fst) x := by\n      simp [leitura2]\n    have ih' : (S'.all fun e => paridade2 x e.1 == e.2) = true ↔\n        leitura2 (S'.map Prod.fst) x = S'.map Prod.snd := ih\n    simp only [serveEspectro2, List.all_cons, List.map_cons]\n    rw [hcons, Bool.and_eq_true, beq_iff_eq, ih']\n    constructor\n    · intro h\n      rw [h.1, h.2]\n    · intro h\n      rw [List.cons.injEq] at h\n      exact ⟨h.1, h.2⟩\n\n/-- [REAL] A partição do resíduo, na forma espectral: se a paridade em `a` toma os valores 0 e 1 entre os pontos\nque servem `S`, os pontos que servem `S ++ [(a, 1)]` são exatamente metade dos que servem `S`. O enunciado é para a\nequação nova de valor 1. -/\ntheorem a_morte_parte_o_residuo_espectral {n : ℕ} (S : Espectro2 n) (a : Fin n → Bool)\n    (h0 : ∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x a = 0)\n    (h1 : ∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x a = 1) :\n    2 * (Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, 1)]) = true).card\n      = (Finset.univ.filter fun x => serveEspectro2 x S = true).card := by\n  obtain ⟨x0, hx0, hp0⟩ := h0\n  obtain ⟨x1, hx1, hp1⟩ := h1\n  have hbase := a_morte_parte_o_residuo (S.map Prod.fst) (S.map Prod.snd) a\n    ⟨x0, (serveEspectro2_leitura2 x0 S).mp hx0, hp0⟩ ⟨x1, (serveEspectro2_leitura2 x1 S).mp hx1, hp1⟩\n  have hb0 : (Finset.univ.filter fun x => leitura2 (S.map Prod.fst) x = S.map Prod.snd)\n      = Finset.univ.filter fun x => serveEspectro2 x S = true := by\n    ext x\n    simp [Finset.mem_filter, serveEspectro2_leitura2]\n  have hb1 : (Finset.univ.filter fun x => leitura2 (S.map Prod.fst ++ [a]) x = S.map Prod.snd ++ [1])\n      = Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, 1)]) = true := by\n    ext x\n    simp [Finset.mem_filter, serveEspectro2_leitura2, List.map_append]\n  rw [hb0, hb1] at hbase\n  exact hbase\n\n/-! ## A morte e o contrato -/\n\n/-- [INPUT] O eixo da morte: a máscara das variáveis da primeira cláusula sem par no ponto `w` (`primeiraSemPar φ w`);\nquando não há cláusula sem par, a máscara vazia (todo eixo apagado). Nada exige que `w` seja um poço. Leitura\n[ONTO]: `w` lido como o poço; o eixo fixado pelo ponto morto, lido e não escolhido. -/\ndef eixoDaMorteDe {n : ℕ} (φ : CNF n) (w : Fin n → Bool) : Fin n → Bool :=\n  match primeiraSemPar φ w with\n  | none => fun _ => false\n  | some C => fun i => decide (i ∈ sombraDe C)\n\n/-- [INPUT] A equação que a morte lê no ponto `w`: o eixo da morte e a paridade de `w` nele. O valor pode ser 0\nou 1. Leitura [ONTO]: `w` lido como o poço; o bit pago. -/\ndef aMorte {n : ℕ} (φ : CNF n) (w : Fin n → Bool) : (Fin n → Bool) × ZMod 2 :=\n  (eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))\n\n/-- [INPUT] A dinâmica da morte: uma ressurreição, que devolve um ponto a partir da fórmula e do espectro\nacumulado. Leitura [ONTO]: o ponto do outro lado, lido do espectro. -/\nstructure DinamicaDaMorte (n : ℕ) where\n  ressurreicao : CNF n → Espectro2 n → (Fin n → Bool)\n\n/-- [INPUT] **O contrato `GatesDaMorte`**, hipótese nomeada, não teorema.\n\n- **G1 (`fiel`, a ressurreição fiel):** para toda fórmula `φ`, todo espectro `S` e todo ponto `w`, o ponto\n  ressurgido serve `S ++ [aMorte φ w]`.\n- **G2 (`divide`, a leitura divide):** para toda fórmula `φ`, todo espectro `S` e todo ponto `w`, entre os pontos\n  que servem `S` a paridade no eixo da morte toma o valor 0 e o valor 1.\n\nComo está escrito, nenhuma dinâmica cumpre este contrato:\n`TGLExt.AVacuidadeDosContratos.gatesDaMorte_insatisfazivel` [REAL]. O campo `divide` pede um ponto que sirva um\nespectro contraditório (a equação de eixo vazio com valor 1), e nenhum ponto o serve. Um teorema que tome\n`GatesDaMorte` como hipótese vale no vazio e não diz nada sobre fórmula alguma. -/\nstructure GatesDaMorte {n : ℕ} (d : DinamicaDaMorte n) : Prop where\n  fiel : ∀ (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool),\n    serveEspectro2 (d.ressurreicao φ S) (S ++ [aMorte φ w]) = true\n  divide : ∀ (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool),\n    (∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x (eixoDaMorteDe φ w) = 0)\n      ∧ (∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x (eixoDaMorteDe φ w) = 1)\n\nend TGLExt.AMorteEARessurreicao\n\n",
+    'TGLExt/AContagemDasMortes.lean': "import TGLExt.AMorteEARessurreicao\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A contagem das mortes: a cadeia que divide é curta, e o contrato final\n\n## O que é\n\nUma cadeia de equações de paridade sobre o cubo de `n` bits divide quando cada equação nova toma os dois valores\ndentro do resíduo das anteriores (`divideSempre`). Este módulo conta: numa cadeia que divide, cada equação parte o\nresíduo ao meio, logo o resíduo vezes `2^(comprimento)` é `2ⁿ`, e uma cadeia que divide com resíduo não vazio tem\ncomprimento no máximo `n`. A prova não usa posto nem módulos: usa a translação por xor (`fibras_iguais`, de\n`TGLExt.AMorteEARessurreicao`, isto é, a aditividade da paridade sobre `ZMod 2`) e a contagem.\n\nO módulo também nomeia um contrato, `AVerdadeFinal`, sobre uma dinâmica com passo, eixo da morte, ressurreição e eco,\ne prova `o_eco_e_a_luz` sob ele. Esse contrato não é cumprido por nenhuma dinâmica (ver «O que NÃO se afirma»).\n\n## O que fica provado [REAL]\n\n1. `recSnoc`: o princípio de indução por cauda em listas (provar para `[]` e herdar de `l` para `l ++ [a]`).\n2. `card_cubo`: o cubo `Fin n → Bool` tem `2ⁿ` pontos.\n3. `divideSempre_cauda`: se `S₀ ++ [e]` divide, `S₀` divide.\n4. `a_morte_parte_o_residuo_qualquer_valor`: se o resíduo de `S` contém pontos de paridade 0 e de paridade 1 no eixo\n   `a`, então, para qualquer valor `v`, o dobro da cardinalidade do resíduo de `S ++ [(a, v)]` é a cardinalidade do\n   resíduo de `S`.\n5. `a_cadeia_que_divide_mede`: se `divideSempre S`, a cardinalidade do resíduo de `S` vezes `2 ^ S.length` é `2ⁿ`.\n6. `a_cadeia_que_divide_e_curta`: se `divideSempre S` e o resíduo de `S` é não vazio, então `S.length ≤ n`.\n7. `o_veredito_verdadeiro_na_paz`: um ponto de custo zero testemunha `SAT φ`.\n8. `o_eco_e_a_luz`: sob o contrato `AVerdadeFinal d`, existe `x` com `d.eco φ = some x` se e somente se `SAT φ`.\n   A prova usa só os campos `ecoFiel` e `ecoVem`.\n\n[DERIVED] As hipóteses de `a_cadeia_que_divide_e_curta` podem ser cumpridas: a cadeia vazia cumpre `divideSempre`\n(não há decomposição `[] = S₀ ++ [(a, v)] ++ S₁`) e o seu resíduo é o cubo inteiro, que é não vazio. O teorema não é\nvácuo. Este arquivo não prova um exemplo; a verificação é imediata.\n\n## Leituras [INPUT/ONTO]\n\n* Cada equação da cadeia é lida como uma «morte», e o resíduo como a luz que resta; o limite `S.length ≤ n` é lido\n  como o posto do espaço de `n` bits obtido por contagem, e as `n + 1` leituras como `n` mortes mais a leitura final\n  do ponto único. [DERIVED] Que uma cadeia que divide de comprimento `n` deixe um ponto só segue de\n  `a_cadeia_que_divide_mede` com `S.length = n`; mas nenhum teorema aqui mostra que exista uma cadeia que divide de\n  comprimento `n`: o limite `n` não foi mostrado atingível.\n* Cada morte parte o resíduo ao meio: a perda por morte é lida como um bit, isto é, `ln 2` nat (o fator 2 de\n  `a_morte_parte_o_residuo_qualquer_valor`).\n* [OPEN] A tese de que `n + 1` leituras devolvem a solução (lida como o ACOM) não está provada neste módulo.\n* O eco é lido como a resposta do processo: a testemunha, ou o silêncio; o processo nunca responde «não há luz».\n  Não se mede a escuridão, só se mede a luz. `o_eco_e_a_luz` é lido como semidecisão fiel: o silêncio não é uma\n  resposta falsa, é a ausência do ato conjugado; a testemunha conjuga o ato (o verbo), o silêncio não. No Lean, isso é\n  só o tipo `Option (Fin n → Bool)` do campo `eco`; sob o contrato, `ecoVem` faz o silêncio implicar `¬ SAT φ`, de\n  modo que a diferença entre «silêncio» e «não há luz» é só de leitura e não está no Lean.\n* O gate V (`ecoFiel` + `ecoVem`, a resposta é a verdade) é lido como o lugar onde mora o conteúdo do problema de\n  Clay. Ressalva: V é só fidelidade de semidecisão, sem contagem de passos, e o contrato que o contém é insatisfazível\n  (ver abaixo); nada aqui toca a questão P vs NP.\n\n## O que NÃO se afirma\n\n* `AVerdadeFinal` (G0 `passoFiel`, G1 `fiel`, G2 `divide`, V = `ecoFiel` + `ecoVem`) é um contrato nomeado, uma\n  hipótese, não um teorema. E, como está escrito, nenhuma dinâmica o cumpre:\n  `TGLExt.AVacuidadeDosContratos.aVerdadeFinal_insatisfazivel` prova `¬ AVerdadeFinal d` para toda `d`, porque o\n  campo `divide`, aplicado a um espectro contraditório, pede um ponto que o sirva e nenhum ponto o serve. Logo\n  `o_eco_e_a_luz`, que toma `AVerdadeFinal d` como hipótese, vale no vazio: não diz nada sobre fórmula alguma nem\n  sobre processo algum.\n* O campo `divide` de `AVerdadeFinal` não é `divideSempre`: nenhum teorema deste módulo liga o campo `divide` a\n  `divideSempre` nem ao limite de `a_cadeia_que_divide_e_curta`, e esse limite não depende do contrato.\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT, em tempo algum: não há contagem de passos nem\n  teorema de fita neste módulo. Decidir SAT sem testemunha, em tempo polinomial, segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AContagemDasMortes\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao\n\nvariable {n : ℕ}\n\n/-! ## A indução por cauda -/\n\n/-- [REAL] O princípio de indução por cauda: provar para `[]` e herdar de `l` para `l ++ [a]`. (Auxiliar da\ncadeia.) -/\ntheorem recSnoc {α : Type} {motive : List α → Prop} (vazio : motive [])\n    (snoc : ∀ (l : List α) (a : α), motive l → motive (l ++ [a])) : ∀ l, motive l := by\n  intro l\n  have h2 : ∀ lr : List α, motive lr.reverse := by\n    intro lr\n    induction lr with\n    | nil => simpa using vazio\n    | cons a ax ih =>\n      simp only [List.reverse_cons]\n      exact snoc ax.reverse a ih\n  have := h2 l.reverse\n  rwa [List.reverse_reverse] at this\n\n/-! ## O cubo e a cadeia -/\n\n/-- [REAL] O cubo de `n` bits tem `2ⁿ` pontos. (Auxiliar da contagem.) -/\ntheorem card_cubo : Fintype.card (Fin n → Bool) = 2 ^ n := by\n  simp [Fintype.card_pi, Finset.card_univ, Fintype.card_fin, Finset.prod_const]\n\n/-- [INPUT] A cadeia que divide: para toda decomposição `S = S₀ ++ [(a, v)] ++ S₁`, o resíduo de `S₀` contém um ponto\nde paridade 0 e um ponto de paridade 1 no eixo `a`. (A transversalidade como propriedade da cadeia.) -/\ndef divideSempre {n : ℕ} (S : Espectro2 n) : Prop :=\n  ∀ (S₀ : Espectro2 n) (a : Fin n → Bool) (v : ZMod 2) (S₁ : Espectro2 n),\n    S = S₀ ++ [(a, v)] ++ S₁ →\n    (∃ x : Fin n → Bool, serveEspectro2 x S₀ = true ∧ paridade2 x a = 0)\n      ∧ (∃ x : Fin n → Bool, serveEspectro2 x S₀ = true ∧ paridade2 x a = 1)\n\n/-- [REAL] A cauda da cadeia que divide divide. (Auxiliar da contagem.) -/\ntheorem divideSempre_cauda {n : ℕ} (S₀ : Espectro2 n) (e : (Fin n → Bool) × ZMod 2)\n    (h : divideSempre (S₀ ++ [e])) : divideSempre S₀ := by\n  intro S₀' a v S₁ hdec\n  exact h S₀' a v (S₁ ++ [e]) (by rw [hdec]; simp [List.append_assoc])\n\n/-- [REAL] Se o resíduo de `S` contém pontos de paridade 0 e de paridade 1 no eixo `a`, a equação `(a, v)` parte o\nresíduo ao meio, para qualquer dos dois valores `v`. (Auxiliar da cadeia.) -/\ntheorem a_morte_parte_o_residuo_qualquer_valor {n : ℕ} (S : Espectro2 n) (a : Fin n → Bool) (v : ZMod 2)\n    (h0 : ∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x a = 0)\n    (h1 : ∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x a = 1) :\n    2 * (Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, v)]) = true).card\n      = (Finset.univ.filter fun x => serveEspectro2 x S = true).card := by\n  cases zmod2_exaustivo v with\n  | inl hv0 =>\n    subst hv0\n    have hmeio := a_morte_parte_o_residuo_espectral S a h0 h1\n    obtain ⟨x0, hx0, hp0⟩ := h0\n    obtain ⟨x1, hx1, hp1⟩ := h1\n    have hF : (Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, 0)]) = true).card\n        = (Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, 1)]) = true).card := by\n      have hb0 : (Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, 0)]) = true)\n          = (Finset.univ.filter fun x =>\n              leitura2 (S.map Prod.fst ++ [a]) x = S.map Prod.snd ++ [0]) := by\n        ext x\n        simp [Finset.mem_filter, serveEspectro2_leitura2, List.map_append]\n      have hb1 : (Finset.univ.filter fun x => serveEspectro2 x (S ++ [(a, 1)]) = true)\n          = (Finset.univ.filter fun x =>\n              leitura2 (S.map Prod.fst ++ [a]) x = S.map Prod.snd ++ [1]) := by\n        ext x\n        simp [Finset.mem_filter, serveEspectro2_leitura2, List.map_append]\n      rw [hb0, hb1]\n      exact fibras_iguais (S.map Prod.fst ++ [a]) (S.map Prod.snd ++ [0]) (S.map Prod.snd ++ [1]) x0\n        (by rw [leitura2_snoc, (serveEspectro2_leitura2 x0 S).mp hx0, hp0]) x1\n        (by rw [leitura2_snoc, (serveEspectro2_leitura2 x1 S).mp hx1, hp1])\n    rw [hF, hmeio]\n  | inr hv1 =>\n    subst hv1\n    exact a_morte_parte_o_residuo_espectral S a h0 h1\n\n/-- [REAL] **A medida da cadeia**: se `divideSempre S`, a cardinalidade do resíduo de `S` vezes `2 ^ S.length` é\n`2ⁿ`. [DERIVED] Logo, sob `divideSempre S`, o resíduo depois das `k = S.length` equações de `S` tem `2ⁿ / 2ᵏ`\npontos. -/\ntheorem a_cadeia_que_divide_mede {n : ℕ} (S : Espectro2 n) (h : divideSempre S) :\n    (Finset.univ.filter fun x => serveEspectro2 x S = true).card * 2 ^ S.length = 2 ^ n := by\n  induction S using recSnoc with\n  | vazio =>\n    have huniv : (Finset.univ.filter fun x : Fin n → Bool => serveEspectro2 x [] = true)\n        = Finset.univ := by\n      apply Finset.filter_true_of_mem\n      intro x _\n      rfl\n    rw [huniv]\n    simp [Finset.card_univ]\n  | snoc S₀ e ih =>\n    obtain ⟨a, v⟩ := e\n    have hdiv : divideSempre S₀ := divideSempre_cauda S₀ (a, v) h\n    have hih := ih hdiv\n    have hdec : S₀ ++ [(a, v)] = S₀ ++ [(a, v)] ++ [] := by simp\n    obtain ⟨h0, h1⟩ := h S₀ a v [] hdec\n    have hmeio := a_morte_parte_o_residuo_qualquer_valor S₀ a v h0 h1\n    have hlen : (S₀ ++ [(a, v)]).length = S₀.length + 1 := by simp\n    rw [hlen, pow_succ]\n    have hnonlin :\n        (Finset.univ.filter fun x => serveEspectro2 x (S₀ ++ [(a, v)]) = true).card\n          * (2 ^ S₀.length * 2)\n          = (2 * (Finset.univ.filter fun x => serveEspectro2 x (S₀ ++ [(a, v)]) = true).card)\n            * 2 ^ S₀.length := by ring\n    rw [hnonlin, hmeio, hih]\n\n/-- [REAL] **A cadeia que divide é curta**: se `divideSempre S` e o resíduo de `S` é não vazio, então\n`S.length ≤ n`. [DERIVED] As hipóteses podem ser cumpridas (a cadeia vazia), logo o teorema não é vácuo.\n[INPUT/ONTO] Lido como o posto do espaço obtido por contagem, e as `n + 1` leituras como `n` mortes mais a leitura\nfinal do ponto único; o limite `n` não é mostrado atingível aqui. -/\ntheorem a_cadeia_que_divide_e_curta {n : ℕ} (S : Espectro2 n) (h : divideSempre S)\n    (hne : (Finset.univ.filter fun x => serveEspectro2 x S = true).Nonempty) :\n    S.length ≤ n := by\n  have hmede := a_cadeia_que_divide_mede S h\n  have hpos : 0 < (Finset.univ.filter fun x => serveEspectro2 x S = true).card :=\n    Finset.card_pos.mpr hne\n  have h2 : 2 ^ S.length ≤ 2 ^ n :=\n    (Nat.le_mul_of_pos_left (2 ^ S.length) hpos).trans (le_of_eq hmede)\n  exact (Nat.pow_le_pow_iff_right (by norm_num)).mp h2\n\n/-! ## O contrato final -/\n\n/-- [REAL] Um ponto de custo zero testemunha a satisfatibilidade: `custoCNF φ x = 0 → SAT φ`. -/\ntheorem o_veredito_verdadeiro_na_paz {n : ℕ} (φ : CNF n) (x : Fin n → Bool)\n    (h : custoCNF φ x = 0) : SAT φ :=\n  ⟨x, (custoCNF_zero_sse φ x).mp h⟩\n\n/-- [INPUT] A dinâmica completa: o passo, o eixo da morte (uma equação lida de um ponto), a ressurreição (um ponto\ndevolvido para um espectro) e o eco (a resposta do processo: `some` testemunha, ou `none`, o silêncio).\n[INPUT/ONTO] `passo` é lido como a descida pinada; `eixoDaMorte` como a solução transversal lida do ponto morto;\n`ressurreicao` como o ponto do outro lado. -/\nstructure DinamicaCompleta (n : ℕ) where\n  passo : CNF n → Espectro2 n → (Fin n → Bool) → Fin n → Bool\n  eixoDaMorte : CNF n → (Fin n → Bool) → (Fin n → Bool)\n  ressurreicao : CNF n → Espectro2 n → (Fin n → Bool)\n  eco : CNF n → Option (Fin n → Bool)\n\n/-- [INPUT] **O contrato final** `AVerdadeFinal`, uma hipótese nomeada, não um teorema.\n\n- **G0 `passoFiel`:** quem serve o espectro continua servindo depois do passo.\n- **G1 `fiel`:** para todo espectro `S` e para todo ponto `w`, o ressurgido serve `S` mais a equação lida em `w`\n  (o ponto morto).\n- **G2 `divide`:** para todo espectro e todo ponto, o eixo da morte toma os dois valores dentro do resíduo\n  (a transversalidade).\n- **V = `ecoFiel` + `ecoVem`:** o eco, quando vem, é testemunha; quando há satisfatibilidade, o eco vem.\n\nLimite: nenhuma dinâmica cumpre este contrato como está escrito\n(`TGLExt.AVacuidadeDosContratos.aVerdadeFinal_insatisfazivel`; o campo `divide` falha num espectro contraditório).\nTodo teorema que o toma como hipótese vale no vazio. -/\nstructure AVerdadeFinal {n : ℕ} (d : DinamicaCompleta n) : Prop where\n  passoFiel : ∀ (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool),\n    serveEspectro2 x S = true → serveEspectro2 (d.passo φ S x) S = true\n  fiel : ∀ (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool),\n    serveEspectro2 (d.ressurreicao φ S) (S ++ [(d.eixoDaMorte φ w, paridade2 w (d.eixoDaMorte φ w))])\n      = true\n  divide : ∀ (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool),\n    (∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x (d.eixoDaMorte φ w) = 0)\n      ∧ (∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x (d.eixoDaMorte φ w) = 1)\n  /-- **V-eco:** quando o eco responde `some x`, `x` tem custo zero; o eco é conferível. -/\n  ecoFiel : ∀ (φ : CNF n) (x : Fin n → Bool), d.eco φ = some x → custoCNF φ x = 0\n  /-- **V-vem:** se `SAT φ`, o eco responde com algum `some x`. -/\n  ecoVem : ∀ φ : CNF n, SAT φ → ∃ x : Fin n → Bool, d.eco φ = some x\n\n/-- [REAL, vácuo] **O eco é a luz**: sob `AVerdadeFinal d`, existe `x` com `d.eco φ = some x` se e somente se\n`SAT φ`; a prova usa só `ecoFiel` e `ecoVem`. Como nenhuma dinâmica cumpre `AVerdadeFinal`\n(`TGLExt.AVacuidadeDosContratos.aVerdadeFinal_insatisfazivel`), o teorema vale no vazio e não diz nada sobre\nfórmula alguma. Não afirma que algum processo decida SAT, nem conta passos. -/\ntheorem o_eco_e_a_luz {n : ℕ} (d : DinamicaCompleta n) (g : AVerdadeFinal d) (φ : CNF n) :\n    (∃ x : Fin n → Bool, d.eco φ = some x) ↔ SAT φ := by\n  constructor\n  · intro h\n    obtain ⟨x, hx⟩ := h\n    exact o_veredito_verdadeiro_na_paz φ x (g.ecoFiel φ x hx)\n  · intro h\n    exact g.ecoVem φ h\n\nend TGLExt.AContagemDasMortes\n\n",
+    'TGLExt/OProcessoDaLuz.lean': "import TGLExt.AContagemDasMortes\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O processo da luz: o laço completo e o eco fiel por construção\n\n## O que é\n\nO laço descer–morrer–ressurgir (`lacoDoProcesso`): desce com o espectro (`descerComEspectro`); se o ponto alcançado\ntem custo zero, responde com ele; se o eixo da morte desse ponto já está no espectro, devolve `none`; senão acrescenta\nao espectro a equação da morte (o eixo e a paridade do ponto) e recomeça a partir do ponto devolvido pela\nressurreição `R`, com um combustível a menos. A resposta está em `Option`; o espectro final é devolvido junto.\nA descida usada no laço, com combustível `φ.length` e registro vazio, estaciona num ponto fixo do passo\n(`TGLExt.ADescidaComEspectro.a_descida_com_espectro_estaciona`) [REAL, no módulo citado].\n\nLeitura [INPUT/ONTO]: o processo nunca responde «não há luz»; responde com o eco ou não responde. Não se mede a\nescuridão, só se mede a luz. `none` não afirma que a fórmula não tem testemunha.\n\nAs três hipóteses nomeadas dos itens 3 e 4 [INPUT]: `hdiv` (a divisão na morte: a equação da morte toma os valores\n0 e 1 em pontos que servem o espectro), `hfiel` (a ressurreição fiel: o ponto devolvido por `R` serve o espectro\nacrescido) e `hpoco` (o poço que serve o espectro: o ponto alcançado pela descida serve todo espectro que tem\nalgum ponto que o serve).\n\n## O que fica provado\n\n1. [REAL] `o_eco_do_processo_e_fiel`, sem hipótese alguma: se `lacoDoProcesso R φ fuel S x = (some w, S')`, então\n   `custoCNF φ w = 0`. O laço confere o custo antes de responder.\n2. [REAL] `divideSempre_snoc`: se `S` é uma cadeia que divide e a equação nova toma os valores 0 e 1 em pontos que\n   servem `S`, então `S ++ [(a, v)]` é uma cadeia que divide.\n3. [REAL, vale no vazio; ver abaixo] `o_processo_preserva_a_cadeia`: sob as hipóteses `hdiv`, `hfiel` e `hpoco`,\n   para todo combustível, todo `S` que divide e tem um ponto que o serve, o espectro final do laço divide e tem um\n   ponto que o serve.\n4. [REAL, vale no vazio; ver abaixo] `o_processo_tem_as_mortes_contadas`: sob as mesmas três hipóteses e as mesmas\n   condições sobre `S`, o espectro final do laço tem comprimento no máximo `n`.\n\n## O que NÃO se afirma\n\n* As hipóteses `hdiv` e `hpoco` não valem juntas para nenhum `n` e nenhuma fórmula\n  (`TGLExt.AVacuidadeDosContratos.gates_do_processo_insatisfaziveis`). Com `n ≥ 1`, `hpoco` é falsa sozinha\n  (`TGLExt.AVacuidadeDosContratos.hpoco_falso`): a descida do laço não recebe o espectro, e o mesmo ponto teria de\n  servir dois espectros que se contradizem. Por isso `o_processo_preserva_a_cadeia` e\n  `o_processo_tem_as_mortes_contadas` valem no vazio: não dizem nada sobre fórmula alguma. A hipótese `hfiel` pode\n  ser cumprida (`TGLExt.AVacuidadeDosContratos.hfiel_habitado`).\n* Não se prova que, com combustível `n + 1`, o ramo do esgotamento do combustível (`| 0, S, _ => (none, S)`) seja\n  inalcançável; isso segue [OPEN].\n* `OPassoFiel.o_poco_fiel_serve` trata da descida `descerGenerico passoFiel φ S`, não da descida do laço\n  `descerComEspectro φ`; não cumpre `hpoco`.\n* Não se prova que, quando a fórmula tem testemunha, o laço responde com ela: a completude segue [OPEN].\n  Só a fidelidade da resposta (item 1) está provada.\n* Nada aqui diz que algum processo, ou a máquina de fita, decida SAT em tempo polinomial; isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OProcessoDaLuz\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes\n\nvariable {n : ℕ}\n\n/-- [INPUT] O laço do processo: desce com o espectro (`descerComEspectro`); se o ponto alcançado tem custo zero,\nresponde com ele; se o eixo da morte desse ponto já está no espectro, devolve `none`; senão acrescenta a equação\nda morte (o eixo e a paridade do ponto) e recomeça do ponto devolvido por `R`, com um combustível a menos.\nDevolve a resposta e o espectro final. A descida interna estaciona num ponto fixo do passo\n(`ADescidaComEspectro.a_descida_com_espectro_estaciona`). -/\ndef lacoDoProcesso (R : CNF n → Espectro2 n → (Fin n → Bool)) (φ : CNF n) :\n    ℕ → Espectro2 n → (Fin n → Bool) → (Option (Fin n → Bool)) × Espectro2 n\n  | 0, S, _ => (none, S)\n  | fuel + 1, S, x =>\n    let w := (descerComEspectro φ φ.length ([], x)).2\n    if custoCNF φ w = 0 then (some w, S)\n    else\n      let a := eixoDaMorteDe φ w\n      if a ∈ S.map Prod.fst then (none, S)\n      else lacoDoProcesso R φ fuel (S ++ [(a, paridade2 w a)]) (R φ (S ++ [(a, paridade2 w a)]))\n\n/-- [REAL] O eco é fiel por construção: se o laço responde com `some w`, então `custoCNF φ w = 0`. Sem\nhipótese: o laço confere o custo antes de responder. -/\ntheorem o_eco_do_processo_e_fiel (R : CNF n → Espectro2 n → (Fin n → Bool)) (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x w : Fin n → Bool) (S' : Espectro2 n),\n      lacoDoProcesso R φ fuel S x = (some w, S') → custoCNF φ w = 0 := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S x w S' h\n    simp [lacoDoProcesso] at h\n  | succ f ih =>\n    intro S x w S' h\n    unfold lacoDoProcesso at h\n    simp only [] at h\n    split at h\n    · rename_i hcond\n      rw [Prod.mk.injEq] at h\n      obtain ⟨h1, -⟩ := h\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · split at h\n      · simp at h\n      · rename_i hcn hsombra\n        exact ih _ _ _ _ h\n\n/-- [REAL] A cadeia cresce pela equação que divide: se `S` divide e a equação nova toma os valores 0 e 1 em pontos\nque servem `S`, então `S ++ [(a, v)]` divide. (Auxiliar do laço.) -/\ntheorem divideSempre_snoc {n : ℕ} (S : Espectro2 n) (a : Fin n → Bool) (v : ZMod 2)\n    (hS : divideSempre S)\n    (hdiv : (∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x a = 0)\n      ∧ (∃ x : Fin n → Bool, serveEspectro2 x S = true ∧ paridade2 x a = 1)) :\n    divideSempre (S ++ [(a, v)]) := by\n  intro S₀ a' v' S₁ hdec\n  by_cases hS₁ : S₁ = []\n  · subst hS₁\n    rw [List.append_nil] at hdec\n    obtain ⟨h1, h2⟩ := append_snod_inj hdec\n    rw [Prod.mk.injEq] at h2\n    obtain ⟨haa, hvv⟩ := h2\n    subst haa\n    subst hvv\n    subst h1\n    exact hdiv\n  · have hex : ∃ S₁' u, S₁ = S₁' ++ [u] := by\n      cases hr : S₁.reverse with\n      | nil =>\n        simp [List.reverse_eq_nil_iff] at hr\n        exact absurd hr hS₁\n      | cons u R => exact ⟨R.reverse, u, by rw [← List.reverse_reverse S₁, hr]; simp⟩\n    obtain ⟨S₁', u, rfl⟩ := hex\n    rw [show S₀ ++ [(a', v')] ++ (S₁' ++ [u]) = (S₀ ++ [(a', v')] ++ S₁') ++ [u] from by\n      simp [List.append_assoc]] at hdec\n    obtain ⟨hS0, -⟩ := append_snod_inj hdec\n    exact hS S₀ a' v' S₁' hS0\n\n/-- [REAL, condicional] Sob `hdiv`, `hfiel` e `hpoco`: se `S` divide e tem um ponto que o serve, o espectro final\ndo laço divide e tem um ponto que o serve. `hdiv` e `hpoco` não valem juntas para nenhum `n` e nenhuma fórmula\n(`AVacuidadeDosContratos.gates_do_processo_insatisfaziveis`); o teorema vale no vazio. -/\ntheorem o_processo_preserva_a_cadeia (R : CNF n → Espectro2 n → (Fin n → Bool)) (φ : CNF n)\n    (hdiv : ∀ (S : Espectro2 n) (w : Fin n → Bool),\n      serveEspectro2 w S = true → (eixoDaMorteDe φ w) ∉ S.map Prod.fst →\n      (∃ y : Fin n → Bool, serveEspectro2 y S = true ∧ paridade2 y (eixoDaMorteDe φ w) = 0)\n        ∧ (∃ y : Fin n → Bool, serveEspectro2 y S = true ∧ paridade2 y (eixoDaMorteDe φ w) = 1))\n    (hfiel : ∀ (S : Espectro2 n) (w : Fin n → Bool),\n      serveEspectro2 w S = true → (eixoDaMorteDe φ w) ∉ S.map Prod.fst →\n      serveEspectro2 (R φ (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]))\n        (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]) = true)\n    (hpoco : ∀ (S : Espectro2 n) (x : Fin n → Bool), (∃ y, serveEspectro2 y S = true) →\n      serveEspectro2 (descerComEspectro φ φ.length ([], x)).2 S = true) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool),\n      divideSempre S → (∃ y, serveEspectro2 y S = true) →\n      divideSempre (lacoDoProcesso R φ fuel S x).2\n        ∧ (∃ y, serveEspectro2 y (lacoDoProcesso R φ fuel S x).2 = true) := by\n  intro fuel\n  induction fuel with\n  | zero => intro S x hS hserv; exact ⟨hS, hserv⟩\n  | succ f ih =>\n    intro S x hS hserv\n    unfold lacoDoProcesso\n    simp only []\n    split\n    · exact ⟨hS, hserv⟩\n    · split\n      · exact ⟨hS, hserv⟩\n      · rename_i hcn hsombra\n        have hw : serveEspectro2 (descerComEspectro φ φ.length ([], x)).2 S = true := hpoco S x hserv\n        have hdivS := hdiv S _ hw hsombra\n        have hnova : divideSempre (S ++ [(eixoDaMorteDe φ (descerComEspectro φ φ.length ([], x)).2,\n            paridade2 (descerComEspectro φ φ.length ([], x)).2\n              (eixoDaMorteDe φ (descerComEspectro φ φ.length ([], x)).2))]) :=\n          divideSempre_snoc S _ _ hS hdivS\n        have hnovaServ : ∃ y, serveEspectro2 y (S ++ [(eixoDaMorteDe φ\n            (descerComEspectro φ φ.length ([], x)).2,\n            paridade2 (descerComEspectro φ φ.length ([], x)).2\n              (eixoDaMorteDe φ (descerComEspectro φ φ.length ([], x)).2))]) = true :=\n          ⟨_, hfiel S _ hw hsombra⟩\n        exact ih _ _ hnova hnovaServ\n\n/-- [REAL, condicional] Sob `hdiv`, `hfiel` e `hpoco`, e se `S` divide e tem um ponto que o serve, o espectro final\ndo laço tem comprimento no máximo `n`. `hdiv` e `hpoco` não valem juntas para nenhum `n` e nenhuma fórmula\n(`AVacuidadeDosContratos.gates_do_processo_insatisfaziveis`); o teorema vale no vazio. -/\ntheorem o_processo_tem_as_mortes_contadas (R : CNF n → Espectro2 n → (Fin n → Bool)) (φ : CNF n)\n    (hdiv : ∀ (S : Espectro2 n) (w : Fin n → Bool),\n      serveEspectro2 w S = true → (eixoDaMorteDe φ w) ∉ S.map Prod.fst →\n      (∃ y : Fin n → Bool, serveEspectro2 y S = true ∧ paridade2 y (eixoDaMorteDe φ w) = 0)\n        ∧ (∃ y : Fin n → Bool, serveEspectro2 y S = true ∧ paridade2 y (eixoDaMorteDe φ w) = 1))\n    (hfiel : ∀ (S : Espectro2 n) (w : Fin n → Bool),\n      serveEspectro2 w S = true → (eixoDaMorteDe φ w) ∉ S.map Prod.fst →\n      serveEspectro2 (R φ (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]))\n        (S ++ [(eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))]) = true)\n    (hpoco : ∀ (S : Espectro2 n) (x : Fin n → Bool), (∃ y, serveEspectro2 y S = true) →\n      serveEspectro2 (descerComEspectro φ φ.length ([], x)).2 S = true)\n    (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool)\n    (hS : divideSempre S) (hserv : ∃ y, serveEspectro2 y S = true) :\n    (lacoDoProcesso R φ fuel S x).2.length ≤ n :=\n  a_cadeia_que_divide_e_curta _ (o_processo_preserva_a_cadeia R φ hdiv hfiel hpoco fuel S x hS hserv).1\n    (by\n      obtain ⟨y, hy⟩ := (o_processo_preserva_a_cadeia R φ hdiv hfiel hpoco fuel S x hS hserv).2\n      exact ⟨y, by simp [Finset.mem_filter, hy]⟩)\n\nend TGLExt.OProcessoDaLuz\n\n",
+    'TGLExt/OPassoFiel.lean': "import TGLExt.OProcessoDaLuz\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O passo fiel: o passo que só move dentro do resíduo, com a terminação e a preservação do espectro\n\nO passo fiel `passoFiel φ S` olha a primeira cláusula sem par de `x`; estaciona se não há cláusula sem par,\nse a cláusula é vazia, se a sua sombra já foi lida, ou se virar a variável do primeiro literal faria o ponto\ndeixar de servir o espectro `S`; caso contrário registra a sombra nova e vira essa variável. A descida\n`descerGenerico passo2 φ S k st` itera um passo `passo2` k vezes a partir de `st`.\n\n## O que fica provado nesta pedra [REAL]\n\n1. A descida genérica, para qualquer passo `passo2`:\n   * `pinado_persiste_generico`: se `st` é ponto fixo do passo, a descida fica em `st` para todo `k`.\n   * `descer_add_generico`: `b + a` passos são `b` passos seguidos de `a` passos.\n   * `descer_invariante_generico`: sob a hipótese `hAPI` (cada passo ou devolve o próprio estado, ou\n     acrescenta à lista lida a sombra, ainda não lida, de uma cláusula de `φ`), para todo `k`, toda lista\n     inicial `leu` e todo ponto `x`: se `leu` é sem repetição (`leu.Nodup`) e está contida em\n     `φ.map sombraDe`, então, após `k` passos a partir de `(leu, x)`, a lista lida segue sem repetição e\n     contida em `φ.map sombraDe`, e ou a descida já passou por um ponto fixo em algum `j ≤ k`, ou o\n     comprimento da lista lida é `leu.length + k`.\n   * `a_descida_generica_estaciona`: sob `hAPI`, partindo de `([], x)`, o estado após `φ.length` passos é\n     ponto fixo do passo.\n2. `passoFiel_ou_estaciona_ou_cresce`: o passo fiel cumpre `hAPI`.\n3. `a_descida_fiel_estaciona`: o estado após `φ.length` passos fiéis, a partir de `([], x)`, é ponto fixo\n   de `passoFiel φ S`.\n4. `o_passo_fiel_preserva`: se `x` serve `S`, o ponto devolvido por `passoFiel φ S leu x` serve `S`.\n5. `a_descida_fiel_preserva`: se `x` serve `S`, todo ponto de `descerGenerico passoFiel φ S k ([], x)`\n   serve `S`, para todo `k`.\n6. `o_poco_fiel_serve`: se `x` serve `S`, o ponto após `φ.length` passos fiéis serve `S` (o caso\n   `k = φ.length` do item 5).\n\n## Leitura [INPUT]\n\nA descida fiel lê-se como a descida pinada: a leitura nunca desmente a leitura; o passo só se move\ndentro do resíduo do espectro. Nenhum teorema desta pedra liga `descerGenerico passoFiel` às definições\nde `TGLExt.ADescidaPinada`; a frase é leitura, não identidade provada. «Estacionar» é o nome dado ao\nponto fixo do passo.\n\n## Os gates nomeados da descida (contratos, não teoremas)\n\n* G0, o poço serve o espectro: no laço de `OProcessoDaLuz`, é a hipótese `hpoco` (sobre a descida\n  `descerComEspectro φ`). Esta pedra prova um enunciado vizinho para a descida fiel (itens 4 a 6), não\n  `hpoco`.\n* G1, a ressurreição fiel: a hipótese `hfiel` do laço; pode ser cumprida\n  (`TGLExt.AVacuidadeDosContratos.hfiel_habitado`).\n* G2, a leitura divide: a hipótese `hdiv` do laço.\n* V-vem: quando há luz, o eco vem.\n* T: o transporte na fita.\n\n## O que NÃO se afirma\n\n* O ponto fixo da descida fiel não é afirmado satisfazer `φ`: o passo fiel também estaciona quando virar a\n  variável quebraria o espectro, ou quando a sombra já foi lida. Nada aqui decide SAT, nem dá custo de\n  tempo na fita.\n* `o_poco_fiel_serve` é sobre a descida `descerGenerico passoFiel φ S`, que recebe o espectro `S`; não é\n  sobre a descida do laço `descerComEspectro φ` de `OProcessoDaLuz`, que não recebe o espectro. Não\n  descarrega a hipótese `hpoco` (G0) do laço; não se afirma que `hpoco` fique provada para o passo fiel.\n  `hpoco` é falsa para toda fórmula com `n ≥ 1` (`TGLExt.AVacuidadeDosContratos.hpoco_falso`: a descida\n  do laço não recebe o espectro), e `hdiv` (G2) e `hpoco` juntas não valem para nenhum `n` e nenhuma\n  fórmula (`TGLExt.AVacuidadeDosContratos.gates_do_processo_insatisfaziveis`); um teorema que as tome\n  juntas como hipótese vale por vacuidade e nada diz sobre fórmula alguma. `hfiel` (G1) pode ser cumprida\n  (`hfiel_habitado`).\n* Esta pedra não toma como hipótese `hdiv`, `hpoco`, `GatesDaDescida`, `GatesDaMorte` nem `AVerdadeFinal`;\n  a única hipótese dos teoremas genéricos, `hAPI`, é cumprida pelo passo fiel\n  (`passoFiel_ou_estaciona_ou_cresce`).\n* `o_poco_fiel_serve` pede que o ponto de partida `x` já sirva `S`; não afirma que exista tal ponto.\n* Não se afirmam aqui G1, G2, V-vem nem T.\n* O gate do Instituto segue de pé e nomeado: decidir SAT sem testemunha, em tempo polinomial, na máquina\n  de fita segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OPassoFiel\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz\n\nvariable {n : ℕ}\n\n/-! ## A descida genérica (a terminação para qualquer passo com a propriedade da API) -/\n\n/-- [DEF] A descida genérica com combustível. -/\ndef descerGenerico {n : ℕ}\n    (passo2 : CNF n → Espectro2 n → List (List (Fin n)) → (Fin n → Bool) → EstadoDescida n)\n    (φ : CNF n) (S : Espectro2 n) : ℕ → EstadoDescida n → EstadoDescida n\n  | 0, st => st\n  | k + 1, st => passo2 φ S (descerGenerico passo2 φ S k st).1 (descerGenerico passo2 φ S k st).2\n\n/-- A pinagem persiste, na forma genérica. -/\ntheorem pinado_persiste_generico {n : ℕ}\n    (passo2 : CNF n → Espectro2 n → List (List (Fin n)) → (Fin n → Bool) → EstadoDescida n)\n    (φ : CNF n) (S : Espectro2 n) (st : EstadoDescida n)\n    (hp : passo2 φ S st.1 st.2 = st) :\n    ∀ k : ℕ, descerGenerico passo2 φ S k st = st := by\n  intro k\n  induction k with\n  | zero => rfl\n  | succ k ih =>\n    show passo2 φ S (descerGenerico passo2 φ S k st).1 (descerGenerico passo2 φ S k st).2 = st\n    rw [ih]\n    exact hp\n\n/-- A iteração compõe, na forma genérica. -/\ntheorem descer_add_generico {n : ℕ}\n    (passo2 : CNF n → Espectro2 n → List (List (Fin n)) → (Fin n → Bool) → EstadoDescida n)\n    (φ : CNF n) (S : Espectro2 n) (a b : ℕ) (st : EstadoDescida n) :\n    descerGenerico passo2 φ S (b + a) st = descerGenerico passo2 φ S a (descerGenerico passo2 φ S b st) := by\n  induction a with\n  | zero => rfl\n  | succ k ih =>\n    rw [Nat.add_succ]\n    have e1 : descerGenerico passo2 φ S (b + k + 1) st\n        = passo2 φ S (descerGenerico passo2 φ S (b + k) st).1\n            (descerGenerico passo2 φ S (b + k) st).2 := rfl\n    have e2 : descerGenerico passo2 φ S (k + 1) (descerGenerico passo2 φ S b st)\n        = passo2 φ S (descerGenerico passo2 φ S k (descerGenerico passo2 φ S b st)).1\n            (descerGenerico passo2 φ S k (descerGenerico passo2 φ S b st)).2 := rfl\n    rw [e1, e2, ih]\n\n/-- O invariante do laço, na forma genérica. -/\ntheorem descer_invariante_generico {n : ℕ}\n    (passo2 : CNF n → Espectro2 n → List (List (Fin n)) → (Fin n → Bool) → EstadoDescida n)\n    (φ : CNF n) (S : Espectro2 n)\n    (hAPI : ∀ (leu : List (List (Fin n))) (x : Fin n → Bool),\n      passo2 φ S leu x = (leu, x) ∨\n        ∃ (l : Literal n) (C' : Clausula n), (l :: C') ∈ φ ∧ sombraDe (l :: C') ∉ leu ∧\n          ∃ y : Fin n → Bool, passo2 φ S leu x = (sombraDe (l :: C') :: leu, y)) :\n    ∀ (k : ℕ) (leu : List (List (Fin n))) (x : Fin n → Bool),\n      leu.Nodup → leu ⊆ φ.map sombraDe →\n      (descerGenerico passo2 φ S k (leu, x)).1.Nodup\n        ∧ (descerGenerico passo2 φ S k (leu, x)).1 ⊆ φ.map sombraDe\n        ∧ ((∃ j : ℕ, j ≤ k ∧\n              passo2 φ S (descerGenerico passo2 φ S j (leu, x)).1 (descerGenerico passo2 φ S j (leu, x)).2\n                = descerGenerico passo2 φ S j (leu, x))\n            ∨ (descerGenerico passo2 φ S k (leu, x)).1.length = leu.length + k) := by\n  intro k\n  induction k with\n  | zero => intro leu x hnd hsub; exact ⟨hnd, hsub, Or.inr rfl⟩\n  | succ k ih =>\n    intro leu x hnd hsub\n    obtain ⟨hnd0, hsub0, hcas0⟩ := ih leu x hnd hsub\n    cases hAPI (descerGenerico passo2 φ S k (leu, x)).1 (descerGenerico passo2 φ S k (leu, x)).2 with\n    | inl hpark =>\n      have hid : descerGenerico passo2 φ S (k + 1) (leu, x) = descerGenerico passo2 φ S k (leu, x) :=\n        hpark\n      refine ⟨?_, ?_, Or.inl ⟨k, Nat.le_succ k, hpark⟩⟩\n      · rw [hid]; exact hnd0\n      · rw [hid]; exact hsub0\n    | inr hmove =>\n      obtain ⟨l, C', hmem, hfresh, y, hpasso⟩ := hmove\n      have hnd1 : (sombraDe (l :: C') :: (descerGenerico passo2 φ S k (leu, x)).1).Nodup :=\n        List.nodup_cons.mpr ⟨hfresh, hnd0⟩\n      have hsub1 : (sombraDe (l :: C') :: (descerGenerico passo2 φ S k (leu, x)).1) ⊆ φ.map sombraDe := by\n        intro s hs\n        rw [List.mem_cons] at hs\n        cases hs with\n        | inl heq => rw [heq]; exact List.mem_map_of_mem hmem\n        | inr hs' => exact hsub0 hs'\n      have hid : descerGenerico passo2 φ S (k + 1) (leu, x)\n          = (sombraDe (l :: C') :: (descerGenerico passo2 φ S k (leu, x)).1, y) := hpasso\n      refine ⟨?_, ?_, ?_⟩\n      · rw [hid]; exact hnd1\n      · rw [hid]; exact hsub1\n      · cases hcas0 with\n        | inl hparked =>\n          obtain ⟨j, hj, hp⟩ := hparked\n          exact Or.inl ⟨j, by omega, hp⟩\n        | inr hlen0 =>\n          right\n          rw [hid, List.length_cons, hlen0]\n          omega\n\n/-- A terminação genérica: para qualquer passo que ou devolve o próprio estado ou registra sombra nova da\nfórmula, o estado após `φ.length` passos a partir de `([], x)` é ponto fixo do passo. -/\ntheorem a_descida_generica_estaciona {n : ℕ}\n    (passo2 : CNF n → Espectro2 n → List (List (Fin n)) → (Fin n → Bool) → EstadoDescida n)\n    (φ : CNF n) (S : Espectro2 n)\n    (hAPI : ∀ (leu : List (List (Fin n))) (x : Fin n → Bool),\n      passo2 φ S leu x = (leu, x) ∨\n        ∃ (l : Literal n) (C' : Clausula n), (l :: C') ∈ φ ∧ sombraDe (l :: C') ∉ leu ∧\n          ∃ y : Fin n → Bool, passo2 φ S leu x = (sombraDe (l :: C') :: leu, y))\n    (x : Fin n → Bool) :\n    passo2 φ S (descerGenerico passo2 φ S φ.length ([], x)).1\n        (descerGenerico passo2 φ S φ.length ([], x)).2\n      = descerGenerico passo2 φ S φ.length ([], x) := by\n  obtain ⟨hnd, hsub, hcas⟩ :=\n    descer_invariante_generico passo2 φ S hAPI φ.length [] x List.nodup_nil (List.nil_subset _)\n  cases hcas with\n  | inl hparked =>\n    obtain ⟨j, hj, hp⟩ := hparked\n    have hcom : φ.length = j + (φ.length - j) := (Nat.add_sub_of_le hj).symm\n    have hid : descerGenerico passo2 φ S φ.length ([], x) = descerGenerico passo2 φ S j ([], x) := by\n      rw [hcom, descer_add_generico, pinado_persiste_generico passo2 φ S _ hp (φ.length - j)]\n    rw [hid]\n    exact hp\n  | inr hlen =>\n    have hlen0 : (descerGenerico passo2 φ S φ.length ([], x)).1.length = φ.length := by\n      simp at hlen\n      omega\n    cases hAPI (descerGenerico passo2 φ S φ.length ([], x)).1\n        (descerGenerico passo2 φ S φ.length ([], x)).2 with\n    | inl hp => exact hp\n    | inr hmove =>\n      obtain ⟨l, C', hmem, hfresh, y, hpasso⟩ := hmove\n      have hsombra : sombraDe (l :: C') ∈ φ.map sombraDe := List.mem_map_of_mem hmem\n      have htudo : φ.map sombraDe ⊆ (descerGenerico passo2 φ S φ.length ([], x)).1 := by\n        intro s hs\n        by_contra hfora\n        have hnd' : ((descerGenerico passo2 φ S φ.length ([], x)).1 ++ [s]).Nodup := by\n          rw [List.nodup_append]\n          refine ⟨hnd, List.nodup_singleton _, ?_⟩\n          intro sombra2 hs1 sombra3 hmem2\n          rw [List.mem_singleton] at hmem2\n          subst hmem2\n          intro hcontra\n          subst hcontra\n          exact hfora hs1\n        have hsub' : (descerGenerico passo2 φ S φ.length ([], x)).1 ++ [s] ⊆ φ.map sombraDe := by\n          intro s2 hs2\n          rw [List.mem_append] at hs2\n          cases hs2 with\n          | inl h1 => exact hsub h1\n          | inr h2 =>\n            rw [List.mem_singleton] at h2\n            rw [h2]\n            exact hs\n        have hcompr := List.Subperm.length_le (List.Nodup.subperm hnd' hsub')\n        rw [List.length_append, List.length_singleton, List.length_map, hlen0] at hcompr\n        omega\n      exact absurd (htudo hsombra) hfresh\n\n/-! ## O passo fiel -/\n\n/-- [DEF] O passo fiel: só move dentro do resíduo; estaciona na paz, na cláusula vazia, na sombra já lida,\nou quando o movimento faria o ponto deixar de servir o espectro. -/\ndef passoFiel {n : ℕ} (φ : CNF n) (S : Espectro2 n) (leu : List (List (Fin n))) (x : Fin n → Bool) :\n    EstadoDescida n :=\n  match primeiraSemPar φ x with\n  | none => (leu, x)\n  | some [] => (leu, x)\n  | some (l :: C') =>\n    if sombraDe (l :: C') ∈ leu then (leu, x)\n    else if serveEspectro2 (virar l.var x) S then (sombraDe (l :: C') :: leu, virar l.var x)\n    else (leu, x)\n\n/-- A análise do passo fiel: ou estaciona, ou registra a sombra nova e move dentro do resíduo. -/\ntheorem passoFiel_ou_estaciona_ou_cresce {n : ℕ} (φ : CNF n) (S : Espectro2 n)\n    (leu : List (List (Fin n))) (x : Fin n → Bool) :\n    passoFiel φ S leu x = (leu, x) ∨\n      ∃ (l : Literal n) (C' : Clausula n), (l :: C') ∈ φ ∧ sombraDe (l :: C') ∉ leu ∧\n        ∃ y : Fin n → Bool, passoFiel φ S leu x = (sombraDe (l :: C') :: leu, y) := by\n  cases h : primeiraSemPar φ x with\n  | none => exact Or.inl (by simp [passoFiel, h])\n  | some C =>\n    cases C with\n    | nil => exact Or.inl (by simp [passoFiel, h])\n    | cons l C' =>\n      by_cases hs : sombraDe (l :: C') ∈ leu\n      · exact Or.inl (by simp [passoFiel, h, hs])\n      · by_cases hf : serveEspectro2 (virar l.var x) S = true\n        · exact Or.inr ⟨l, C', List.mem_of_find?_eq_some h, hs, virar l.var x,\n            by simp [passoFiel, h, hs, hf]⟩\n        · exact Or.inl (by simp [passoFiel, h, hs, hf])\n\n/-- A descida fiel estaciona: o estado após `φ.length` passos fiéis é ponto fixo do passo fiel (a\nterminação genérica instanciada). O ponto fixo não é afirmado satisfazer `φ`. -/\ntheorem a_descida_fiel_estaciona {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool) :\n    passoFiel φ S (descerGenerico passoFiel φ S φ.length ([], x)).1\n        (descerGenerico passoFiel φ S φ.length ([], x)).2\n      = descerGenerico passoFiel φ S φ.length ([], x) :=\n  a_descida_generica_estaciona passoFiel φ S (passoFiel_ou_estaciona_ou_cresce φ S) x\n\n/-- O passo fiel preserva o espectro: se `x` serve `S`, o ponto depois do passo continua servindo `S`. -/\ntheorem o_passo_fiel_preserva {n : ℕ} (φ : CNF n) (S : Espectro2 n) (leu : List (List (Fin n)))\n    (x : Fin n → Bool) (hx : serveEspectro2 x S = true) :\n    serveEspectro2 (passoFiel φ S leu x).2 S = true := by\n  cases h : primeiraSemPar φ x with\n  | none => simpa [passoFiel, h] using hx\n  | some C =>\n    cases C with\n    | nil => simpa [passoFiel, h] using hx\n    | cons l C' =>\n      by_cases hs : sombraDe (l :: C') ∈ leu\n      · simpa [passoFiel, h, hs] using hx\n      · by_cases hf : serveEspectro2 (virar l.var x) S = true\n        · simpa [passoFiel, h, hs, hf] using hf\n        · simpa [passoFiel, h, hs, hf] using hx\n\n/-- A descida fiel preserva o espectro: começando de um ponto que serve `S`, todo ponto da descida fiel\nserve `S`. -/\ntheorem a_descida_fiel_preserva {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\n    (hx : serveEspectro2 x S = true) :\n    ∀ k : ℕ, serveEspectro2 (descerGenerico passoFiel φ S k ([], x)).2 S = true := by\n  intro k\n  induction k with\n  | zero => exact hx\n  | succ k ih =>\n    show serveEspectro2 (passoFiel φ S (descerGenerico passoFiel φ S k ([], x)).1\n        (descerGenerico passoFiel φ S k ([], x)).2).2 S = true\n    exact o_passo_fiel_preserva φ S _ _ ih\n\n/-- O poço fiel serve o espectro: se `x` serve `S`, o ponto após `φ.length` passos fiéis serve `S`.\nÉ sobre a descida fiel `descerGenerico passoFiel φ S`, não sobre a descida do laço `descerComEspectro φ`:\nnão descarrega a hipótese `hpoco` de `OProcessoDaLuz` (falsa para `n ≥ 1`,\n`TGLExt.AVacuidadeDosContratos.hpoco_falso`). -/\ntheorem o_poco_fiel_serve {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\n    (hx : serveEspectro2 x S = true) :\n    serveEspectro2 (descerGenerico passoFiel φ S φ.length ([], x)).2 S = true :=\n  a_descida_fiel_preserva φ S x hx φ.length\n\nend TGLExt.OPassoFiel\n\n",
+    'TGLExt/ARessurreicao.lean': 'import TGLExt.OPassoFiel\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A ressurreição (o gate G1): a consistência da morte e a ressurreição fiel por escolha\n\n## O que é\n\nO gate G1 (a ressurreição fiel) pede um ponto que sirva o espectro acumulado acrescentado da equação lida na\nmorte. Se um ponto `w` serve o espectro `S`, ele serve também `S` acrescentado da equação `(a, paridade2 w a)`\npara qualquer eixo `a`, porque essa equação é, por definição, a paridade dele nesse eixo. Logo o espectro\ndepois da morte de `w` é habitado, e a ressurreição por escolha clássica o serve. [ONTO] Leitura: o ponto\nmorto testemunha a própria morte.\n\n## O que fica provado [REAL]\n\n1. `serveEspectro2_append`: servir a junção `S₁ ++ S₂` é servir `S₁` e servir `S₂` (auxiliar).\n2. ★ `a_morte_e_consistente`: se `w` serve `S`, então `w` serve `S ++ [(a, paridade2 w a)]`, para todo eixo `a`.\n3. `ressurreicaoEscolha` [INPUT, definição]: um ponto que serve o espectro, escolhido por `Classical.choose`\n   quando existe; senão, o ponto nulo. ★ `a_ressurreicao_fiel_existe`: quando o espectro é habitado, a\n   ressurreição por escolha o serve.\n4. ★★ `o_g1_fecha_com_o_g0`: para toda fórmula `φ`, todo espectro `S` e todo ponto `w` que sirva `S` (hipótese\n   local `hw`), a ressurreição por escolha serve `S ++ [aMorte φ w]`.\n\n## O que se segue daí [DERIVED]\n\n* A hipótese `hw` é satisfazível: com `S = []`, qualquer `w` serve `S`, porque `serveEspectro2 w []` é `true`\n  por definição. Nenhum teorema desta pedra enuncia isso.\n* Com `aMorte φ w = (eixoDaMorteDe φ w, paridade2 w (eixoDaMorteDe φ w))`, o enunciado de `o_g1_fecha_com_o_g0`\n  implica o da hipótese `hfiel` de `OProcessoDaLuz` para a ressurreição `fun _ S => ressurreicaoEscolha S`: é\n  mais forte, porque dispensa a premissa de o eixo ser novo. Esta pedra não traz o teorema que faz essa\n  instanciação; o termo de kernel que habita `hfiel` é `TGLExt.AVacuidadeDosContratos.hfiel_habitado`.\n\n## O que NÃO se afirma\n\n* Apesar do nome, `o_g1_fecha_com_o_g0` não usa o G0 nem a hipótese `hpoco`: toma só `hw`, que o ponto `w` sirva\n  `S`. `o_poco_fiel_serve` (`OPassoFiel`) trata da descida `descerGenerico passoFiel φ S`, não da descida do laço\n  `descerComEspectro φ`, e não descarrega `hpoco`.\n* A hipótese `hfiel` é cumprível (`TGLExt.AVacuidadeDosContratos.hfiel_habitado`). Mas os teoremas do laço em\n  `OProcessoDaLuz` que a tomam tomam também `hdiv` e `hpoco`, e essas duas não valem juntas para nenhum `n` e\n  nenhuma fórmula (`TGLExt.AVacuidadeDosContratos.gates_do_processo_insatisfaziveis`). Para `n ≥ 1` a falha é de\n  `hpoco` (`hpoco_falso`, sobre `CNF (m+1)`: a descida do laço não recebe o espectro); para `n = 0` é de `hdiv`\n  (`hdiv_falso_n0`). Esses teoremas valem no vazio e não dizem nada sobre fórmula alguma; provar `hfiel` não muda\n  isso.\n* A forma aqui é a da existência, por escolha clássica (`Classical.choice`, um dos três axiomas do trio\n  `propext`, `Classical.choice`, `Quot.sound`). Nenhum resolvedor GF(2) construtivo é dado nem medido.\n* O transporte T, hipótese nomeada [OPEN]: um resolvedor GF(2) construtivo e polinomial (a eliminação com a\n  correção) que cumpra o G1. Não está provado nem formalizado nesta pedra.\n* Nada aqui trata da divisão na morte (`hdiv`, o G2) nem do eco.\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial. Isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.ARessurreicao\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\n\nvariable {n : ℕ}\n\n/-- Servir a junção é servir as duas partes. (Auxiliar da consistência.) [REAL] -/\ntheorem serveEspectro2_append {n : ℕ} (x : Fin n → Bool) (S₁ S₂ : Espectro2 n) :\n    serveEspectro2 x (S₁ ++ S₂) = (serveEspectro2 x S₁ && serveEspectro2 x S₂) := by\n  simp [serveEspectro2, List.all_append]\n\n/-- ★ **A MORTE É CONSISTENTE** [REAL]: se `w` serve `S`, então `w` serve `S` acrescentado da equação\n`(a, paridade2 w a)`, para todo eixo `a`; o espectro depois da morte é habitado pelo próprio ponto morto.\n[ONTO] Leitura: o ponto de morte é o ponto lido pelo ângulo, e ele testemunha a equação que nele se lê. -/\ntheorem a_morte_e_consistente {n : ℕ} (S : Espectro2 n) (w : Fin n → Bool) (a : Fin n → Bool)\n    (hw : serveEspectro2 w S = true) :\n    serveEspectro2 w (S ++ [(a, paridade2 w a)]) = true := by\n  rw [serveEspectro2_append, hw]\n  simp [serveEspectro2]\n\n/-- [INPUT, definição] A ressurreição por escolha: um ponto que serve o espectro, escolhido por\n`Classical.choose` quando o espectro é habitado; senão, o ponto nulo. (Forma da existência; nenhum resolvedor\nGF(2) construtivo é dado aqui; o resolvedor construtivo e polinomial é o transporte T, hipótese nomeada [OPEN].) -/\nnoncomputable def ressurreicaoEscolha {n : ℕ} (S : Espectro2 n) : Fin n → Bool :=\n  if h : ∃ x : Fin n → Bool, serveEspectro2 x S = true then Classical.choose h else fun _ => false\n\n/-- ★ **A RESSURREIÇÃO FIEL EXISTE** [REAL], G1 na forma da existência: quando o espectro é habitado, a\nressurreição por escolha serve o espectro. -/\ntheorem a_ressurreicao_fiel_existe {n : ℕ} (S : Espectro2 n)\n    (h : ∃ x : Fin n → Bool, serveEspectro2 x S = true) :\n    serveEspectro2 (ressurreicaoEscolha S) S = true := by\n  unfold ressurreicaoEscolha\n  rw [dif_pos h]\n  exact Classical.choose_spec h\n\n/-- ★★ **O G1 FECHA** [REAL]: se `w` serve `S` (hipótese local `hw`, satisfazível), a ressurreição por escolha\nserve `S ++ [aMorte φ w]`. [DERIVED] Implica o enunciado da hipótese `hfiel` de `OProcessoDaLuz` para essa\nressurreição (é mais forte: dispensa a premissa de o eixo ser novo); a instanciação não é um teorema desta pedra. Não\nusa o G0 nem `hpoco`; os teoremas do laço que tomam `hfiel` tomam também `hdiv` e `hpoco`, que juntas são\ninsatisfazíveis (`TGLExt.AVacuidadeDosContratos.gates_do_processo_insatisfaziveis`), e por isso valem no vazio. -/\ntheorem o_g1_fecha_com_o_g0 {n : ℕ} (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool)\n    (hw : serveEspectro2 w S = true) :\n    serveEspectro2 (ressurreicaoEscolha (S ++ [aMorte φ w])) (S ++ [aMorte φ w]) = true := by\n  apply a_ressurreicao_fiel_existe\n  exact ⟨w, a_morte_e_consistente S w (eixoDaMorteDe φ w) hw⟩\n\nend TGLExt.ARessurreicao\n\n',
+    'TGLExt/AParedeDoSpan.lean': 'import TGLExt.ARessurreicao\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A parede do span: um eixo pode estar no span dos eixos lidos sem estar na lista deles\n\n## O que é\n\nO span dos eixos lidos, por xor (a soma em GF(2) de uma sub-lista), e um contraexemplo de duas variáveis: um eixo\nfora da lista dos eixos lidos, mas no span deles, não divide o resíduo. Logo checar a pertença à lista não basta\npara garantir que a leitura de um eixo novo divida o resíduo; a checagem que serve a esse fim é a pertença ao span.\n\n## O que fica provado [REAL]\n\n1. `xorComb` e `eixoNoSpan` [INPUT, definições]: a combinação por xor de uma lista de eixos e a pertença de um eixo\n   ao span de uma lista de eixos (existe uma sub-lista cuja combinação por xor é o eixo).\n2. ★ `a_parede_do_eixo_no_span`: com o espectro `S2 = [(eixo0, 1), (eixo1, 0)]` em duas variáveis, todo ponto que\n   serve `S2` tem paridade 1 no eixo `eixo01 = {x₀, x₁}`: dentro do resíduo a paridade nesse eixo é constante, e a\n   leitura desse eixo não divide o resíduo. Prova por `decide`.\n3. `o_eixo01_esta_no_span`: `eixo01` está no span de `[eixo0, eixo1]` (é o xor dos dois).\n4. ★ `o_eixo_no_span_nao_esta_na_lista`: `eixo01` não está na lista `[eixo0, eixo1]`. Prova por `decide`.\n5. `gateG2linha` [INPUT, definição; contrato nomeado, não teorema]: para uma função `eixoDaMorte`, toda fórmula, todo\n   espectro e todo ponto que o serve, o eixo `eixoDaMorte φ w` está fora do span dos eixos do espectro.\n\n## O que NÃO se afirma\n\n* O contraexemplo é um espectro e um eixo explícitos em duas variáveis; não é o eixo da morte de uma fórmula.\n  Nada aqui diz, para fórmula alguma, que o eixo da morte (`eixoDaMorteDe`) caia no span.\n* A hipótese `hdiv` dos teoremas do laço de `OProcessoDaLuz` checa a pertença à lista (`∉ S.map Prod.fst`), não ao\n  span. Medido em `TGLExt.AVacuidadeDosContratos`: `hdiv` e `hpoco` não valem juntas para nenhum `n` e nenhuma\n  fórmula (`gates_do_processo_insatisfaziveis`; `hpoco_falso`: a descida do laço não recebe o espectro). Um teorema\n  que toma as duas como hipótese vale no vazio e não diz nada sobre fórmula alguma. Esta pedra não toma nenhuma das\n  duas como hipótese.\n* `gateG2linha` é só definição: este módulo não prova que alguma função `eixoDaMorte` o cumpra, nem que um eixo fora\n  do span tome os dois valores dentro do resíduo (resíduo não vazio) [OPEN]. A pista desse lema é a dualidade em\n  GF(2): o anulador do núcleo é o span das linhas [KNOWN, álgebra linear; não está neste módulo].\n* A refutação de `gateG2linha` como está escrito é esperada, e não é medida no kernel [DERIVED, argumento por cálculo\n  fora do kernel; não há teorema `gateG2linha_insatisfazivel`]: para todo `w`, o espectro dos `n` eixos unitários,\n  com os valores lidos no próprio `w`, é servido por `w`, e os seus eixos geram todo o cubo; logo `eixoDaMorte φ w`\n  está no span, para toda função `eixoDaMorte` e todo `n`, desde que `CNF n` tenha habitante (com `n = 0`, até o\n  espectro vazio basta). Se a refutação vale, um teorema que tome `gateG2linha` como hipótese vale no vazio e não diz\n  nada sobre fórmula alguma. Esta pedra não toma `gateG2linha` como hipótese.\n* Nada aqui diz que algum processo decida SAT, em tempo algum. Decidir SAT sem testemunha, em tempo polinomial, na\n  máquina de fita segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AparedeDoSpan\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao\n\nvariable {n : ℕ}\n\n/-! ## O span dos eixos -/\n\n/-- [INPUT, definição] A combinação por xor de uma lista de eixos (a soma em GF(2) da lista). -/\ndef xorComb {n : ℕ} (l : List (Fin n → Bool)) : Fin n → Bool := l.foldl xorPonto (fun _ => false)\n\n/-- [INPUT, definição] O eixo no span do espectro: é a combinação por xor de uma sub-lista dos eixos lidos. -/\ndef eixoNoSpan {n : ℕ} (axes : List (Fin n → Bool)) (a : Fin n → Bool) : Prop :=\n  ∃ sub : List (Fin n → Bool), sub ⊆ axes ∧ xorComb sub = a\n\n/-! ## O contraexemplo -/\n\n/-- O eixo da variável 0. -/\ndef eixo0 : Fin 2 → Bool := fun i => if i = 0 then true else false\n\n/-- O eixo da variável 1. -/\ndef eixo1 : Fin 2 → Bool := fun i => if i = 0 then false else true\n\n/-- O eixo das duas variáveis: o xor dos dois. -/\ndef eixo01 : Fin 2 → Bool := fun _ => true\n\n/-- O espectro do contraexemplo: `x₀ ↦ 1`, `x₁ ↦ 0`. O resíduo é o ponto único (verdadeiro, falso) [DERIVED, por\ncálculo; não é teorema deste módulo, que prova só a paridade constante em `eixo01`]. -/\ndef S2 : Espectro2 2 := [(eixo0, 1), (eixo1, 0)]\n\n/-- ★ **A PAREDE DO EIXO NO SPAN** [REAL]: dentro do resíduo de `S2`, a paridade no eixo `{x₀, x₁}` é constante\n`1`; a leitura desse eixo não divide o resíduo. Vale para este espectro e este eixo explícitos, não para o eixo da\nmorte de uma fórmula. Prova por `decide`. -/\ntheorem a_parede_do_eixo_no_span :\n    ∀ x : Fin 2 → Bool, serveEspectro2 x S2 = true → paridade2 x eixo01 = 1 := by\n  decide\n\n/-- [REAL] O eixo das duas variáveis está no span dos dois eixos unitários: `eixo01 = eixo0 ⊞ eixo1`. -/\ntheorem o_eixo01_esta_no_span : eixoNoSpan [eixo0, eixo1] eixo01 := by\n  refine ⟨[eixo0, eixo1], ?_, ?_⟩\n  · intro s hs; exact hs\n  · ext i\n    fin_cases i <;> decide\n\n/-- ★ **A CHECAGEM PELA LISTA NÃO BASTA** [REAL]: o eixo no span não está na lista dos eixos lidos; uma checagem por\npertença à lista o deixaria passar como eixo novo, embora a sua leitura não divida o resíduo. Prova por `decide`. -/\ntheorem o_eixo_no_span_nao_esta_na_lista : eixo01 ∉ [eixo0, eixo1] := by\n  decide\n\n/-! ## A forma do gate pelo span -/\n\n/-- [INPUT, definição; contrato nomeado] **G2′**: o eixo lido pela morte é transversal, fora do span dos eixos do\nespectro, para toda fórmula, todo espectro e todo ponto que o serve. É hipótese, não teorema: este módulo não prova\nque alguma função o cumpra, nem que um eixo fora do span tome os dois valores dentro do resíduo [OPEN]. A refutação\ncomo está escrito é esperada (os eixos unitários lidos no próprio ponto geram todo o cubo), mas não é medida no kernel\n[DERIVED, fora do kernel]. -/\ndef gateG2linha {n : ℕ} (eixoDaMorte : CNF n → (Fin n → Bool) → (Fin n → Bool)) : Prop :=\n  ∀ (φ : CNF n) (S : Espectro2 n) (w : Fin n → Bool),\n    serveEspectro2 w S = true → ¬ eixoNoSpan (S.map Prod.fst) (eixoDaMorte φ w)\n\nend TGLExt.AparedeDoSpan\n\n',
+    'TGLExt/AFibraECoclasse.lean': 'import TGLExt.AParedeDoSpan\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A fibra é a coclasse: o resíduo é a translação do núcleo da leitura\n\n## O que é\n\nA leitura `leitura2 axes` leva um ponto `x : Fin n → Bool` à lista das paridades de `x` nos eixos `axes`, em\n`ZMod 2`. Este módulo prova que, quando a fibra de um valor `vals` tem um ponto `x₀`, essa fibra é a translação\npor `x₀` (pelo xor `xorPonto`) do núcleo da leitura, o conjunto dos pontos de leitura zero: a estrutura de\ncoclasse (afim) do resíduo.\n\n## De onde vem\n\nO módulo `AParedeDoSpan` refina o G2 (a leitura divide) no contrato nomeado `gateG2linha` (G2′): a morte lê um eixo\ntransversal, fora do span dos eixos lidos [INPUT, definição em `AParedeDoSpan`; contrato, não teorema]. O lema que\nfecharia essa leitura é a dualidade: um eixo fora do span toma os dois valores dentro do resíduo [OPEN]. Este módulo\nprova a peça que prepara o argumento da aniquilação: o resíduo habitado é a translação do núcleo da leitura, a\nestrutura de coclasse a partir da qual a álgebra linear clássica leria esse resultado.\n\n[INPUT/ONTO] Leitura do autor: a fibra habitada é o resíduo; o eixo se resolve com a morte e divide sempre porque\nrealiza a poda; é o tetelestai: opera o recibo, a transcrição. Esta leitura não é teorema deste módulo: aqui não se\nprova que eixo algum divida o resíduo (ver «O que NÃO se afirma»).\n\n## O que fica provado [REAL]\n\n1. `zipAdd_self_zero`: a soma termo a termo de uma lista em `ZMod 2` consigo mesma é a lista de zeros do mesmo\n   comprimento. `zipAdd_zero_esq`: a lista de `m` zeros é neutra à esquerda na soma termo a termo com uma lista de\n   comprimento `m`.\n2. `oNucleo` [INPUT, definição]: o núcleo da leitura, os pontos com leitura igual à lista de zeros.\n   `leitura2_length`: o comprimento da leitura é o número de eixos.\n3. ★ `a_fibra_e_coclasse`: dado `x₀` com `leitura2 axes x₀ = vals`, o conjunto dos pontos com leitura `vals` é\n   igual à imagem de `oNucleo axes` pela translação `k ↦ xorPonto k x₀`. A prova usa a homomorfia da leitura\n   (`leitura2_xor`: a leitura do xor é a soma das leituras) e a involução do xor (`xorPonto_invol`).\n\n## O que NÃO se afirma\n\n* Não se prova aqui a dualidade (que um eixo fora do span das linhas toma os dois valores dentro do resíduo). A\n  forma que ela teria a partir da coclasse: a paridade do eixo novo é constante na coclasse sse o eixo se anula no\n  núcleo, e o aniquilador do núcleo é o span das linhas. Esse conteúdo clássico de álgebra linear não está tipado\n  neste módulo [OPEN].\n* O teorema exige o ponto `x₀` como hipótese: não constrói nem encontra um ponto da fibra, e nada diz sobre fibras\n  vazias.\n* «Divide sempre», na leitura do autor, não é teorema. Como contrato, o campo `divide` (o G2) de `GatesDaMorte` e de\n  `AVerdadeFinal` não é cumprido por nenhuma dinâmica, tal como está escrito: medido em\n  `TGLExt.AVacuidadeDosContratos` (`gatesDaMorte_insatisfazivel`, `aVerdadeFinal_insatisfazivel`; o mesmo vale para\n  `GatesDaDescida`, `gatesDaDescida_insatisfazivel`). Em `OProcessoDaLuz`, as hipóteses `hdiv` e `hpoco` não valem\n  juntas para nenhum `n` e nenhuma fórmula (`gates_do_processo_insatisfaziveis`; `hpoco_falso`: a descida do laço não\n  recebe o espectro); `hfiel` é cumprida (`hfiel_habitado`). Um teorema que tome um desses contratos, ou `hdiv` e\n  `hpoco` juntas, como hipótese vale no vazio e não diz nada sobre fórmula alguma. Este módulo não toma nenhum deles\n  como hipótese, nem `gateG2linha`; os seus teoremas não dependem deles.\n* Nada aqui diz que algum processo decida SAT, em tempo algum. Decidir SAT sem testemunha, em tempo polinomial, na\n  máquina de fita segue [OPEN].\n* Nada sobre a natureza. O gate do Instituto (P versus NP) segue de pé e nomeado; o gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AFibraECoclasse\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan\n\nvariable {n : ℕ}\n\n/-- A soma termo a termo de uma lista consigo mesma é a lista de zeros: `v ⊞ v = zeros`. (Auxiliar da coclasse.) -/\ntheorem zipAdd_self_zero : ∀ (v : List (ZMod 2)),\n    List.zipWith (· + ·) v v = List.replicate v.length 0 := by\n  intro v\n  induction v with\n  | nil => rfl\n  | cons a ax ih =>\n    simp [List.zipWith_cons_cons, List.replicate_succ, CharTwo.add_self_eq_zero, ih]\n\n/-- A lista de zeros é neutra à esquerda na soma termo a termo: `zeros ⊞ v = v`. (Auxiliar da coclasse.) -/\ntheorem zipAdd_zero_esq : ∀ (m : ℕ) (v : List (ZMod 2)), v.length = m →\n    List.zipWith (· + ·) (List.replicate m 0) v = v := by\n  intro m\n  induction m with\n  | zero =>\n    intro v hv\n    cases v with\n    | nil => rfl\n    | cons c cs => simp at hv\n  | succ k ih =>\n    intro v hv\n    cases v with\n    | nil => simp at hv\n    | cons b bx =>\n      have hll : bx.length = k := by simpa using hv\n      simp [List.replicate_succ, List.zipWith_cons_cons, zero_add, ih bx hll]\n\n/-- [INPUT] Definição: o núcleo da leitura, os pontos com leitura zero. -/\ndef oNucleo {n : ℕ} (axes : List (Fin n → Bool)) : Finset (Fin n → Bool) :=\n  Finset.univ.filter fun k => leitura2 axes k = List.replicate axes.length 0\n\n/-- O comprimento da leitura é o número de eixos. (Auxiliar da coclasse.) -/\ntheorem leitura2_length {n : ℕ} (axes : List (Fin n → Bool)) (x : Fin n → Bool) :\n    (leitura2 axes x).length = axes.length := by\n  unfold leitura2\n  rw [List.length_map]\n\n/-- ★ **A FIBRA É A COCLASSE**: dado um ponto `x₀` com leitura `vals`, os pontos com leitura `vals` são exatamente\nas translações por `x₀` (pelo xor) dos pontos do núcleo. -/\ntheorem a_fibra_e_coclasse {n : ℕ} (axes : List (Fin n → Bool)) (vals : List (ZMod 2))\n    (x₀ : Fin n → Bool) (hx₀ : leitura2 axes x₀ = vals) :\n    (Finset.univ.filter fun x => leitura2 axes x = vals)\n      = (oNucleo axes).image (fun k => xorPonto k x₀) := by\n  ext x\n  simp only [Finset.mem_filter, Finset.mem_univ, true_and, Finset.mem_image, oNucleo]\n  constructor\n  · intro hx\n    refine ⟨xorPonto x x₀, ?_, ?_⟩\n    · have hlen : vals.length = axes.length := by rw [← hx₀]; exact leitura2_length axes x₀\n      rw [leitura2_xor, hx, hx₀, zipAdd_self_zero, hlen]\n    · exact xorPonto_invol x x₀\n  · intro h\n    obtain ⟨k, hk, hkx⟩ := h\n    have hlen : vals.length = axes.length := by rw [← hx₀]; exact leitura2_length axes x₀\n    rw [← hkx, leitura2_xor, hk, hx₀, zipAdd_zero_esq _ _ hlen]\n\nend TGLExt.AFibraECoclasse\n\n',
+    'TGLExt/ADualidade.lean': "import TGLExt.AFibraECoclasse\nimport Mathlib.LinearAlgebra.Dual.Lemmas\nimport Mathlib.LinearAlgebra.Pi\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A dualidade em GF(2): o eixo fora do span toma os dois valores dentro de um resíduo habitado\n\n## O que é\n\nO cubo booleano `Fin n → Bool` lido como o espaço vetorial `Fin n → ZMod 2`; o eixo como funcional linear (a forma\nbilinear simétrica de GF(2), o produto escalar `∑ a i * x i`; não é produto interno no sentido estrito, porque em\nGF(2) não é definida positiva); a paridade de um ponto num eixo como o valor desse funcional; e o teorema do\naniquilador duplo do Mathlib (`Subspace.dualCoannihilator_dualAnnihilator_eq`) [KNOWN, álgebra linear em dimensão\nfinita] trazido ao vocabulário de `AMorteEARessurreicao` e `AParedeDoSpan` (`paridade2`, `leitura2`, `xorComb`,\n`eixoNoSpan`).\n\n## O que fica provado [REAL]\n\n1. `comoVetor`, `comoPonto` [INPUT, definições] e `comoVetor_ida_e_volta`, `comoPonto_ida_e_volta`: as duas\n   traduções entre o cubo booleano e `Fin n → ZMod 2` são inversas uma da outra.\n2. `funcDe` [INPUT, definição: o funcional do eixo, soma de `a i • proj i`], `funcDe_apply` (o valor é\n   `∑ a i * x i`), `funcDe_zero`, `funcDeMap` (a ida do eixo ao funcional é linear), `funcDe_inj` (é injetiva) e\n   ★ `paridade2_e_o_funcional`: `paridade2 x a = funcDe (comoVetor a) (comoVetor x)`, isto é, a paridade é o\n   funcional do eixo `a` aplicado a `x`.\n3. `funcDe_xorPonto`: a tradução leva o xor de pontos à soma em GF(2). `xorPonto_zero`: o ponto zero é neutro no\n   xor de pontos. `xorComb_nil`, `xorComb_de_iniciado`, `xorComb_append`, `xorComb_un`: a aritmética do xor de\n   listas. `leitura2_zeros_sse`: a leitura é toda zero sse cada eixo da lista lê zero.\n4. `o_funcional_no_span_extrai_o_eixo`: se o funcional de `a` está no span dos funcionais dos eixos da lista,\n   então `eixoNoSpan axes a`.\n5. ★★ `a_dualidade`: se o eixo `a` lê zero em todo ponto cuja leitura pela lista `axes` é toda zero (o núcleo da\n   leitura), então `eixoNoSpan axes a`. É a inclusão não trivial de «o aniquilador do núcleo é o span das linhas».\n   Na tradução, o núcleo da leitura é o coaniquilador `Φ.dualCoannihilator` do span `Φ` dos funcionais dos eixos da\n   lista: a prova põe o funcional de `a` em `Φ.dualCoannihilator.dualAnnihilator`, aplica a esse `Φ` o teorema\n   `Subspace.dualCoannihilator_dualAnnihilator_eq` (que dá `Φ`) e volta ao eixo por\n   `o_funcional_no_span_extrai_o_eixo`.\n6. ★★ `o_eixo_transversal_divide`: com as hipóteses `¬ eixoNoSpan axes a` (o eixo fora do span) e\n   `leitura2 axes x₀ = vals` para algum `x₀` (o resíduo de valores `vals` é habitado), existe no resíduo um ponto\n   de paridade 0 no eixo `a` e outro de paridade 1.\n\nLeitura [ONTO]: o eixo transversal lido é a poda que divide o resíduo; é o tetelestai: opera o recibo, a\ntranscrição. O teorema 6 dá condições suficientes para essa divisão.\n\n## O que NÃO se afirma\n\n* O teorema 6 prova só a direção suficiente: eixo fora do span e resíduo habitado implicam que o eixo toma os dois\n  valores. A recíproca (com o eixo no span, a paridade é constante no resíduo `leitura2 axes x = vals`) não é\n  provada neste módulo [DERIVED, fora deste módulo].\n* Sem a hipótese do span, o eixo pode não dividir. O contraexemplo é `a_parede_do_eixo_no_span` (de\n  `AParedeDoSpan`), enunciado sobre o resíduo de `serveEspectro2`: todo ponto que serve\n  `S2 = [(eixo0, 1), (eixo1, 0)]` tem paridade 1 no eixo `eixo01`. A ponte para o resíduo usado aqui é\n  `serveEspectro2_leitura2` (de `AMorteEARessurreicao`): servir `S` equivale a\n  `leitura2 (S.map Prod.fst) x = S.map Prod.snd`; com `S2`, os eixos são `[eixo0, eixo1]` e os valores `[1, 0]`.\n* O eixo pode estar no span sem estar na lista: `o_eixo01_esta_no_span` (`eixo01` está no span de\n  `[eixo0, eixo1]`) e `o_eixo_no_span_nao_esta_na_lista` (`eixo01 ∉ [eixo0, eixo1]`), ambos de `AParedeDoSpan`; e\n  aí a leitura não divide. Logo uma checagem por pertença à lista, como a de `hdiv` (`∉ S.map Prod.fst`), não basta\n  para que o eixo divida o resíduo; por isso a hipótese do teorema 6 é pelo span, `¬ eixoNoSpan axes a`.\n* Nada aqui diz, para fórmula alguma, que o eixo da morte (`eixoDaMorteDe`) fique fora do span. Esta pedra não\n  prova `gateG2linha` (de `AParedeDoSpan`) para função alguma, nem o toma como hipótese. A refutação de\n  `gateG2linha` como está escrito é esperada, e não é medida no kernel [DERIVED, fora do kernel; não há teorema\n  `gateG2linha_insatisfazivel`]: os eixos unitários lidos no próprio ponto geram todo o cubo. Se a refutação vale,\n  juntar o teorema 6 com `gateG2linha` dá um enunciado que vale no vazio.\n* Esta pedra não toma como hipótese `GatesDaMorte`, `GatesDaDescida`, `AVerdadeFinal`, nem `hdiv` e `hpoco` juntas.\n  Medido em `TGLExt.AVacuidadeDosContratos`: os três primeiros não podem ser cumpridos como estão escritos\n  (`gatesDaMorte_insatisfazivel`, `gatesDaDescida_insatisfazivel`, `aVerdadeFinal_insatisfazivel`); `hdiv` e\n  `hpoco` não valem juntas para nenhum `n` e nenhuma fórmula (`gates_do_processo_insatisfaziveis`); `hfiel` pode\n  ser cumprida (`hfiel_habitado`).\n* Não se afirma que, quando a fórmula tem testemunha, a descida a encontre (a completude) [OPEN], nem o transporte\n  construtivo do processo para a máquina de fita [OPEN].\n* A eliminação em GF(2) é polinomial [KNOWN]; isso não é decidir SAT. Nada aqui diz que algum processo, ou a\n  máquina de Turing nua, decida SAT em tempo polinomial; isso segue [OPEN]. O gate do Instituto (P versus NP, do\n  Instituto Clay) segue de pé e nomeado.\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.ADualidade\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse\n\nvariable {n : ℕ}\n\n/-! ## O cubo é o espaço GF(2) -/\n\n/-- [DEF] O ponto como vetor GF(2). -/\ndef comoVetor {n : ℕ} (x : Fin n → Bool) : Fin n → ZMod 2 := fun i => if x i then 1 else 0\n\n/-- [DEF] O vetor como ponto. -/\ndef comoPonto {n : ℕ} (v : Fin n → ZMod 2) : Fin n → Bool := fun i => v i == 1\n\n/-- A ida e a volta do ponto. (Auxiliar da ponte.) -/\ntheorem comoVetor_ida_e_volta {n : ℕ} (x : Fin n → Bool) : comoPonto (comoVetor x) = x := by\n  ext i\n  unfold comoPonto comoVetor\n  cases x i <;> decide\n\n/-- A ida e a volta do vetor. (Auxiliar da ponte.) -/\ntheorem comoPonto_ida_e_volta {n : ℕ} (v : Fin n → ZMod 2) : comoVetor (comoPonto v) = v := by\n  ext i\n  unfold comoPonto comoVetor\n  cases zmod2_exaustivo (v i) with\n  | inl h => simp [h]\n  | inr h => simp [h]\n\n/-! ## O eixo como funcional -/\n\n/-- [DEF] O funcional do eixo: a forma bilinear de GF(2) (o produto escalar `∑ a i * x i`) com o eixo fixado. -/\ndef funcDe {n : ℕ} (a : Fin n → ZMod 2) : Module.Dual (ZMod 2) (Fin n → ZMod 2) :=\n  ∑ i : Fin n, (a i) • LinearMap.proj i\n\n/-- O funcional aplicado é a soma dos produtos. (Auxiliar da ponte.) -/\ntheorem funcDe_apply {n : ℕ} (a x : Fin n → ZMod 2) : funcDe a x = ∑ i : Fin n, a i * x i := by\n  unfold funcDe\n  rw [LinearMap.sum_apply]\n  apply Finset.sum_congr rfl\n  intro i _\n  rw [LinearMap.smul_apply, LinearMap.proj_apply, smul_eq_mul]\n\n/-- ★ A paridade é o funcional: `paridade2 x a` é o funcional do eixo `a` (a forma bilinear de GF(2)) aplicado\nao ponto `x`, pelas traduções `comoVetor`. -/\ntheorem paridade2_e_o_funcional {n : ℕ} (x a : Fin n → Bool) :\n    paridade2 x a = funcDe (comoVetor a) (comoVetor x) := by\n  rw [funcDe_apply]\n  unfold paridade2\n  apply Finset.sum_congr rfl\n  intro i _\n  unfold comoVetor\n  cases a i <;> cases x i <;> decide\n\n/-- O funcional do eixo zero é zero. (Auxiliar do span.) -/\ntheorem funcDe_zero {n : ℕ} : funcDe (0 : Fin n → ZMod 2) = 0 := by\n  unfold funcDe\n  simp\n\n/-- O mapa do eixo ao funcional é linear (no eixo). -/\ndef funcDeMap {n : ℕ} : (Fin n → ZMod 2) →ₗ[ZMod 2] Module.Dual (ZMod 2) (Fin n → ZMod 2) where\n  toFun := funcDe\n  map_add' := fun a b => by\n    apply LinearMap.ext\n    intro x\n    rw [funcDe_apply, LinearMap.add_apply, funcDe_apply, funcDe_apply, ← Finset.sum_add_distrib]\n    apply Finset.sum_congr rfl\n    intro i _\n    rw [Pi.add_apply, add_mul]\n  map_smul' := fun r a => by\n    apply LinearMap.ext\n    intro x\n    rw [funcDe_apply, LinearMap.smul_apply, smul_eq_mul, funcDe_apply, Finset.mul_sum]\n    apply Finset.sum_congr rfl\n    intro i _\n    simp [Pi.smul_apply, smul_eq_mul, mul_assoc, RingHom.id_apply]\n\n/-- O mapa do eixo ao funcional é injetivo: o funcional determina o eixo (lendo a base). (Auxiliar da\nextração.) -/\ntheorem funcDe_inj {n : ℕ} (a b : Fin n → ZMod 2) (h : funcDe a = funcDe b) : a = b := by\n  ext i\n  have h1 := congrFun (congrArg DFunLike.coe h) (Pi.single i 1)\n  rw [funcDe_apply, funcDe_apply] at h1\n  rw [Finset.sum_eq_single i (fun j _ hji => by\n      rw [Pi.single_eq_of_ne hji, mul_zero]) (by simp)] at h1\n  rw [Finset.sum_eq_single i (fun j _ hji => by\n      rw [Pi.single_eq_of_ne hji, mul_zero]) (by simp)] at h1\n  simpa [Pi.single_eq_same] using h1\n\n/-- A tradução do xor de dois pontos é a soma, em GF(2), das traduções: a ponte da aditividade. (Auxiliar\nda extração.) -/\ntheorem funcDe_xorPonto {n : ℕ} (x y : Fin n → Bool) :\n    comoVetor (xorPonto x y) = comoVetor x + comoVetor y := by\n  ext i\n  simp only [Pi.add_apply]\n  unfold comoVetor xorPonto\n  cases hx : x i <;> cases hy : y i <;> decide\n\n/-! ## A aritmética do span por xor -/\n\n/-- O xor da lista vazia é o ponto zero. -/\ntheorem xorComb_nil {n : ℕ} : xorComb ([] : List (Fin n → Bool)) = fun _ => false := rfl\n\n/-- O ponto zero é neutro no xor; e dobrar com início é dobrar com a dobra pura em xor. (Auxiliares da\nextração.) -/\ntheorem xorPonto_zero {n : ℕ} (x : Fin n → Bool) : xorPonto x (fun _ => false) = x := by\n  ext i\n  show (x i != false) = x i\n  cases hx : x i <;> decide\n\ntheorem xorComb_de_iniciado {n : ℕ} (b : Fin n → Bool) (l : List (Fin n → Bool)) :\n    l.foldl xorPonto b = xorPonto b (l.foldl xorPonto (fun _ => false)) := by\n  induction l generalizing b with\n  | nil => exact (xorPonto_zero b).symm\n  | cons a ax ih =>\n    simp only [List.foldl_cons]\n    rw [ih (xorPonto b a), ih (xorPonto (fun _ => false) a)]\n    ext i\n    show ((b i != a i) != (ax.foldl xorPonto (fun _ => false)) i)\n      = (b i != ((false != a i) != (ax.foldl xorPonto (fun _ => false)) i))\n    cases hb : b i <;> cases ha : a i <;> cases hF : (ax.foldl xorPonto (fun _ => false)) i <;> decide\n\n/-- O xor da lista composta é o xor das dobras. (Auxiliar da extração.) -/\ntheorem xorComb_append {n : ℕ} (s₁ s₂ : List (Fin n → Bool)) :\n    xorComb (s₁ ++ s₂) = xorPonto (xorComb s₁) (xorComb s₂) := by\n  unfold xorComb\n  rw [List.foldl_append]\n  exact xorComb_de_iniciado _ _\n\n/-- O xor de um eixo só é o próprio eixo. (Auxiliar da extração.) -/\ntheorem xorComb_un {n : ℕ} (m : Fin n → Bool) : xorComb [m] = m := by\n  unfold xorComb\n  ext i\n  unfold xorPonto\n  simp\n\n/-- A leitura zero sse cada eixo lê zero. (Auxiliar da ponte do núcleo.) -/\ntheorem leitura2_zeros_sse {n : ℕ} (axes : List (Fin n → Bool)) (x : Fin n → Bool) :\n    leitura2 axes x = List.replicate axes.length 0 ↔ ∀ a ∈ axes, paridade2 x a = 0 := by\n  unfold leitura2\n  induction axes with\n  | nil => simp\n  | cons a ax ih =>\n    rw [List.length_cons, List.map_cons, List.replicate_succ, List.cons.injEq, List.forall_mem_cons]\n    constructor\n    · intro h\n      exact ⟨h.1, ih.mp h.2⟩\n    · intro h\n      exact ⟨h.1, ih.mpr h.2⟩\n\n/-- ★ A extração: o funcional no span dos funcionais dos eixos dá o eixo no span dos eixos (por indução no\nspan, e `funcDe_inj` lendo a base). -/\ntheorem o_funcional_no_span_extrai_o_eixo {n : ℕ} (axes : List (Fin n → Bool)) (a : Fin n → Bool)\n    (h : funcDe (comoVetor a)\n      ∈ Submodule.span (ZMod 2) ((fun m => funcDe (comoVetor m)) '' {m | m ∈ axes})) :\n    eixoNoSpan axes a := by\n  have hP : ∃ m : Fin n → Bool,\n      (∃ sub : List (Fin n → Bool), sub ⊆ axes ∧ xorComb sub = m)\n        ∧ funcDe (comoVetor a) = funcDe (comoVetor m) := by\n    refine Submodule.span_induction (p := fun φ (_ : φ ∈ Submodule.span (ZMod 2) _) =>\n      ∃ m : Fin n → Bool, (∃ sub : List (Fin n → Bool), sub ⊆ axes ∧ xorComb sub = m)\n        ∧ φ = funcDe (comoVetor m)) ?_ ?_ ?_ ?_ h\n    · intro φ hφ\n      obtain ⟨m0, hm0, hφ0⟩ := hφ\n      exact ⟨m0, ⟨[m0], by simpa using hm0, xorComb_un m0⟩, hφ0.symm⟩\n    · exact ⟨fun _ => false, ⟨[], List.nil_subset _, rfl⟩, by\n        show (0 : Module.Dual (ZMod 2) (Fin n → ZMod 2)) = funcDe (comoVetor fun _ => false)\n        have h0 : comoVetor (fun _ => false) = (0 : Fin n → ZMod 2) := by\n          ext i\n          simp [comoVetor]\n        rw [h0, funcDe_zero]⟩\n    · intro φ₁ φ₂ _ _ hφ₁ hφ₂\n      obtain ⟨m₁, ⟨sub1, hsub1, hx1⟩, hφ1⟩ := hφ₁\n      obtain ⟨m₂, ⟨sub2, hsub2, hx2⟩, hφ2⟩ := hφ₂\n      refine ⟨xorPonto m₁ m₂, ⟨sub1 ++ sub2, ?_, ?_⟩, ?_⟩\n      · intro s hs\n        rw [List.mem_append] at hs\n        cases hs with\n        | inl h1 => exact hsub1 h1\n        | inr h2 => exact hsub2 h2\n      · rw [xorComb_append, hx1, hx2]\n      · rw [hφ1, hφ2]\n        show funcDe (comoVetor m₁) + funcDe (comoVetor m₂) = funcDe (comoVetor (xorPonto m₁ m₂))\n        rw [funcDe_xorPonto]\n        exact (funcDeMap.map_add _ _).symm\n    · intro r φ _ hφ\n      obtain ⟨m₀, hsub0, hφ0⟩ := hφ\n      cases zmod2_exaustivo r with\n      | inl hr =>\n        refine ⟨fun _ => false, ⟨[], List.nil_subset _, rfl⟩, ?_⟩\n        rw [hr]\n        show (0 : ZMod 2) • φ = funcDe (comoVetor fun _ => false)\n        rw [zero_smul]\n        have h0 : comoVetor (fun _ => false) = (0 : Fin n → ZMod 2) := by\n          ext i\n          simp [comoVetor]\n        rw [h0, funcDe_zero]\n      | inr hr =>\n        rw [hr]\n        exact ⟨m₀, hsub0, by rw [one_smul]; exact hφ0⟩\n  obtain ⟨m, hsub, hfunc⟩ := hP\n  have hm : m = a := by\n    have h1 : comoVetor m = comoVetor a := funcDe_inj _ _ hfunc.symm\n    ext i\n    have h2 := congrFun h1 i\n    unfold comoVetor at h2\n    cases hm2 : m i <;> cases ha2 : a i\n    · rfl\n    · rw [hm2, ha2] at h2; simp at h2\n    · rw [hm2, ha2] at h2; simp at h2\n    · rfl\n  obtain ⟨sub, hsub, hxor⟩ := hsub\n  exact ⟨sub, hsub, by rw [hxor]; exact hm⟩\n\n/-- ★★ **A DUALIDADE** — o eixo que se anula no núcleo da leitura está no span dos eixos (a inclusão não\ntrivial de «o aniquilador do núcleo é o span das linhas»). O núcleo da leitura é, na tradução, o coaniquilador\n`Φ.dualCoannihilator` do span `Φ` dos funcionais dos eixos; a prova aplica a ele\n`Subspace.dualCoannihilator_dualAnnihilator_eq`. -/\ntheorem a_dualidade {n : ℕ} (axes : List (Fin n → Bool)) (a : Fin n → Bool)\n    (h : ∀ k : Fin n → Bool, leitura2 axes k = List.replicate axes.length 0 → paridade2 k a = 0) :\n    eixoNoSpan axes a := by\n  classical\n  set Φ : Subspace (ZMod 2) (Module.Dual (ZMod 2) (Fin n → ZMod 2)) :=\n    Submodule.span (ZMod 2) ((fun m => funcDe (comoVetor m)) '' {m | m ∈ axes}) with hΦ\n  haveI : FiniteDimensional (ZMod 2) Φ := by\n    apply FiniteDimensional.span_of_finite\n    have h1 : {m : Fin n → Bool | m ∈ axes} = ↑(List.toFinset axes) := by\n      ext m\n      simp [List.mem_toFinset]\n    rw [h1]\n    exact (List.toFinset axes).finite_toSet.image _\n  have hmem : funcDe (comoVetor a) ∈ Φ.dualCoannihilator.dualAnnihilator := by\n    rw [Submodule.mem_dualAnnihilator]\n    intro v hv\n    rw [Submodule.mem_dualCoannihilator] at hv\n    have hk : leitura2 axes (comoPonto v) = List.replicate axes.length 0 := by\n      rw [leitura2_zeros_sse]\n      intro a0 ha0\n      rw [paridade2_e_o_funcional, comoPonto_ida_e_volta]\n      exact hv _ (Submodule.subset_span ⟨a0, by simpa using ha0, rfl⟩)\n    have h0 := h (comoPonto v) hk\n    rw [paridade2_e_o_funcional, comoPonto_ida_e_volta] at h0\n    exact h0\n  rw [Subspace.dualCoannihilator_dualAnnihilator_eq] at hmem\n  exact o_funcional_no_span_extrai_o_eixo axes a (hΦ ▸ hmem)\n\n/-- ★★ **O EIXO TRANSVERSAL DIVIDE** — sob as hipóteses de que o eixo está fora do span (`hfora`) e de que o\nresíduo é habitado (`hx₀`), o eixo toma os dois valores dentro do resíduo. Não diz que o eixo da morte de\nalguma fórmula esteja fora do span. -/\ntheorem o_eixo_transversal_divide {n : ℕ} (axes : List (Fin n → Bool)) (vals : List (ZMod 2))\n    (a : Fin n → Bool) (hfora : ¬ eixoNoSpan axes a)\n    (x₀ : Fin n → Bool) (hx₀ : leitura2 axes x₀ = vals) :\n    (∃ x : Fin n → Bool, leitura2 axes x = vals ∧ paridade2 x a = 0)\n      ∧ (∃ x : Fin n → Bool, leitura2 axes x = vals ∧ paridade2 x a = 1) := by\n  cases zmod2_exaustivo (paridade2 x₀ a) with\n  | inl hv0 =>\n    refine ⟨⟨x₀, hx₀, hv0⟩, ?_⟩\n    by_contra hnao\n    push_neg at hnao\n    have hzero : ∀ k : Fin n → Bool, leitura2 axes k = List.replicate axes.length 0 →\n        paridade2 k a = 0 := by\n      intro k hk\n      have hlen : vals.length = axes.length := by rw [← hx₀]; exact leitura2_length axes x₀\n      have hcom : leitura2 axes (xorPonto k x₀) = vals := by\n        rw [leitura2_xor, hk, hx₀, zipAdd_zero_esq _ _ hlen]\n      have hpar := hnao (xorPonto k x₀) hcom\n      have hpar0 : paridade2 (xorPonto k x₀) a = 0 := by\n        cases zmod2_exaustivo (paridade2 (xorPonto k x₀) a) with\n        | inl h1 => exact h1\n        | inr h1 => exact absurd h1 hpar\n      rw [paridade2_add, hv0, add_zero] at hpar0\n      exact hpar0\n    exact hfora (a_dualidade axes a hzero)\n  | inr hv1 =>\n    refine ⟨?_, ⟨x₀, hx₀, hv1⟩⟩\n    by_contra hnao\n    push_neg at hnao\n    have hzero : ∀ k : Fin n → Bool, leitura2 axes k = List.replicate axes.length 0 →\n        paridade2 k a = 0 := by\n      intro k hk\n      have hlen : vals.length = axes.length := by rw [← hx₀]; exact leitura2_length axes x₀\n      have hcom : leitura2 axes (xorPonto k x₀) = vals := by\n        rw [leitura2_xor, hk, hx₀, zipAdd_zero_esq _ _ hlen]\n      have hpar := hnao (xorPonto k x₀) hcom\n      have hpar1 : paridade2 (xorPonto k x₀) a = 1 := by\n        cases zmod2_exaustivo (paridade2 (xorPonto k x₀) a) with\n        | inl h1 => exact absurd h1 hpar\n        | inr h1 => exact h1\n      rw [paridade2_add, hv1] at hpar1\n      have h2 : paridade2 k a + 1 = 1 := hpar1\n      have h3 : paridade2 k a = 0 := by\n        cases zmod2_exaustivo (paridade2 k a) with\n        | inl hh => exact hh\n        | inr hh => rw [hh] at h2; simp at h2\n      exact h3\n    exact hfora (a_dualidade axes a hzero)\n\nend TGLExt.ADualidade\n\n",
+    'TGLExt/OSolverGF2.lean': "import TGLExt.ADualidade\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O solver GF(2): a eliminação pretendida e o ponto construído\n\n[DEF] Este módulo define, sobre o cubo `Fin n → Bool` e com equações de paridade em `ZMod 2`, um\nprocedimento pretendido como eliminação de Gauss–Jordan (`oEscalonado`, uma dobra de `inserirEscalonado`\nsobre o espectro) e o ponto que se lê da lista de pivôs que ele devolve (`pontoConstruido`).\nCada equação inserida é reduzida contra os pivôs, na ordem da lista: para cada pivô, se o bit de pivô dele\nestá aceso no valor acumulado até ali, soma-se o pivô (xor das máscaras, soma dos valores). Se sobra máscara\nnão nula, ela vira pivô e é somada a cada pivô antigo que tem o bit de pivô dela aceso.\nQue a redução apague todos os bits de pivô da equação nova não se prova: isso vale quando os pivôs já estão\nreduzidos entre si (terceira cláusula de `formaIsolada`, em `TGLExt.OSolverGF2_Parte3`); sem isso, o xor\ncom um pivô posterior pode reacender um bit apagado antes.\nO ponto construído põe, no bit `j`, o valor da PRIMEIRA equação da lista cujo bit de pivô é `j` (`find?`),\ne falso quando não há tal equação. Isso coincide com «o valor da equação do pivô `j`» quando os bits de pivô\nsão únicos (segunda cláusula de `formaIsolada`).\nO ponto é calculado pelo procedimento; não é tirado de uma existência pela escolha clássica. A forma da\nexistência por escolha clássica é `ressurreicaoEscolha`, em `TGLExt.ARessurreicao`\n(`a_ressurreicao_fiel_existe`).\n\n## O que fica provado neste módulo [REAL]\n\n1. `paridade2_symm`: a paridade é simétrica, `paridade2 x a = paridade2 a x`.\n2. `paridade2_mask_xor`: a paridade é aditiva na máscara,\n   `paridade2 x (xorPonto a b) = paridade2 x a + paridade2 x b` (é o que se usa para a redução somar\n   valores ao somar máscaras).\n3. `bitPivo_spec`: o bit de pivô, quando existe, está aceso na máscara.\n4. `bitPivo_minimal`: o bit de pivô é o menor bit aceso (auxiliar pensado para o invariante da forma\n   isolada, que não está provado para `oEscalonado`).\n5. `bitPivo_none_spec`: sem bit de pivô, a máscara é a zero.\n\n## O que se define [DEF]\n\n`bitPivo` (o menor bit aceso), `reduzirNova` (a redução da equação nova contra os pivôs),\n`inserirEscalonado` (a inserção na lista de pivôs), `oEscalonado` (a dobra da inserção, equação por\nequação), `pontoConstruido` (a leitura direta do ponto) e `ressurreicaoConstrutiva` (o ponto construído\nda lista que `oEscalonado` devolve para um espectro).\n\n## O que NÃO se afirma\n\n* Este módulo não prova que o ponto construído serve o espectro original, nem que o procedimento preserva o\n  servir. Em outros módulos, sob hipóteses nomeadas (nada disso se usa nem se afirma aqui):\n  - `TGLExt.OSolverGF2_Parte2`, `reduzirNova_preserva`: se `x` serve os pivôs, `x` serve a equação reduzida\n    se e somente se serve a equação original (nas duas direções);\n  - `TGLExt.OSolverGF2_Parte2`, `inserirEscalonado_preserva`: sob a hipótese de consistência `hcons`\n    (existe `y` que serve os pivôs e a equação nova), `x` serve a lista após a inserção se e somente se serve\n    os pivôs e a equação nova (nas duas direções);\n  - `TGLExt.OSolverGF2_Parte3`, `pontoConstruido_serve`: sob a hipótese `formaIsolada` dos pivôs, o ponto\n    construído serve cada equação da lista.\n* [OPEN] A correção completa, isto é, que `ressurreicaoConstrutiva S` sirva todo espectro `S` consistente,\n  não está provada em nenhum módulo do kernel. O elo que falta é que `oEscalonado` devolva uma lista em\n  `formaIsolada` (forma escalonada reduzida): não há teorema sobre `oEscalonado`. Também não se prova que a\n  saída seja escalonada; o nome «Gauss–Jordan» diz a intenção, não uma propriedade estabelecida.\n* Resolver um sistema consistente de equações de paridade (XOR) sobre GF(2) por eliminação de Gauss é\n  polinomial [KNOWN]; isso não é decidir SAT, e este módulo nada afirma sobre SAT ou sobre P e NP. O gate do\n  Instituto Clay (P vs NP) segue hipótese nomeada; este módulo não o move.\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OSolverGF2\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\n\nvariable {n : ℕ}\n\n/-! ## A paridade na máscara -/\n\n/-- [REAL] A paridade é simétrica. -/\ntheorem paridade2_symm {n : ℕ} (x a : Fin n → Bool) : paridade2 x a = paridade2 a x := by\n  unfold paridade2\n  apply Finset.sum_congr rfl\n  intro i _\n  cases a i <;> cases x i <;> decide\n\n/-- [REAL] A paridade é aditiva na máscara: o xor de máscaras soma as paridades. -/\ntheorem paridade2_mask_xor {n : ℕ} (x a b : Fin n → Bool) :\n    paridade2 x (xorPonto a b) = paridade2 x a + paridade2 x b := by\n  rw [paridade2_symm (x := x) (a := xorPonto a b), paridade2_add a b x, paridade2_symm (x := x) (a := a),\n    paridade2_symm (x := x) (a := b)]\n\n/-! ## O bit de pivô -/\n\n/-- [DEF] O bit de pivô: o menor bit aceso da máscara (o mínimo do conjunto dos bits acesos). -/\ndef bitPivo {n : ℕ} (a : Fin n → Bool) : Option (Fin n) :=\n  if h : ((Finset.univ : Finset (Fin n)).filter fun i => a i = true).Nonempty then\n    some (((Finset.univ : Finset (Fin n)).filter fun i => a i = true).min' h)\n  else none\n\n/-- [REAL] O bit de pivô está aceso na máscara. -/\ntheorem bitPivo_spec {n : ℕ} (a : Fin n → Bool) (i : Fin n) (h : bitPivo a = some i) :\n    a i = true := by\n  unfold bitPivo at h\n  split at h\n  · rename_i hne\n    have h2 := Option.some.inj h\n    have hmem : ((Finset.univ : Finset (Fin n)).filter fun k => a k = true).min' hne ∈\n        (Finset.univ : Finset (Fin n)).filter (fun k => a k = true) := Finset.min'_mem _ _\n    rw [h2] at hmem\n    rw [Finset.mem_filter] at hmem\n    exact hmem.2\n  · simp at h\n\n/-- [REAL] O bit de pivô é o menor bit aceso: todo bit aceso fica nele ou além. -/\ntheorem bitPivo_minimal {n : ℕ} (a : Fin n → Bool) (i : Fin n) (h : bitPivo a = some i) :\n    ∀ j : Fin n, a j = true → i ≤ j := by\n  unfold bitPivo at h\n  split at h\n  · rename_i hne\n    have h2 := Option.some.inj h\n    intro j hj\n    have hmem : j ∈ (Finset.univ : Finset (Fin n)).filter (fun k => a k = true) := by\n      rw [Finset.mem_filter]\n      exact ⟨Finset.mem_univ j, hj⟩\n    have hle : ((Finset.univ : Finset (Fin n)).filter (fun k => a k = true)).min' hne ≤ j :=\n      Finset.min'_le _ _ hmem\n    rw [h2] at hle\n    exact hle\n  · simp at h\n\n/-- [REAL] Sem bit de pivô, a máscara é a zero. -/\ntheorem bitPivo_none_spec {n : ℕ} (a : Fin n → Bool) (h : bitPivo a = none) :\n    ∀ i : Fin n, a i = false := by\n  intro i\n  unfold bitPivo at h\n  split at h\n  · simp at h\n  · rename_i hne\n    by_contra hc\n    have hbit : a i = true := by\n      cases ha : a i with\n      | false => exact absurd ha hc\n      | true => rfl\n    have hmem : i ∈ (Finset.univ : Finset (Fin n)).filter (fun k => a k = true) := by\n      rw [Finset.mem_filter]\n      exact ⟨Finset.mem_univ i, hbit⟩\n    exact hne ⟨i, hmem⟩\n\n/-! ## A eliminação -/\n\n/-- [DEF] A redução da equação nova contra os pivôs, dobrando a lista na ordem: para cada pivô com bit de\npivô `i`, se `i` está aceso no valor acumulado até ali (não na equação nova original), soma-se o pivô ao\nacumulado (xor das máscaras, soma dos valores). A ordem da dobra importa. -/\ndef reduzirNova {n : ℕ} (a : Fin n → Bool) (v : ZMod 2) (pivots : Espectro2 n) :\n    (Fin n → Bool) × ZMod 2 :=\n  pivots.foldl (fun av p =>\n    match bitPivo p.1 with\n    | none => av\n    | some i => if av.1 i then (xorPonto av.1 p.1, av.2 + p.2) else av) (a, v)\n\n/-- [DEF] A inserção de uma equação na lista de pivôs: reduz a nova; se sobra bit de pivô, ela entra como\npivô e é somada a cada pivô antigo que tem esse bit aceso. Se não sobra, os pivôs ficam como estão. -/\ndef inserirEscalonado {n : ℕ} (e : (Fin n → Bool) × ZMod 2) (pivots : Espectro2 n) : Espectro2 n :=\n  let (a, v) := reduzirNova e.1 e.2 pivots\n  match bitPivo a with\n  | none => pivots\n  | some q => (a, v) :: pivots.map (fun p => if p.1 q then (xorPonto p.1 a, p.2 + v) else p)\n\n/-- [DEF] A dobra de `inserirEscalonado` sobre o espectro, equação por equação, a partir da lista vazia.\nPretendida como a eliminação de Gauss–Jordan; que a saída esteja em forma isolada é [OPEN]. -/\ndef oEscalonado {n : ℕ} (S : Espectro2 n) : Espectro2 n :=\n  S.foldl (fun ps e => inserirEscalonado e ps) []\n\n/-- [DEF] O ponto construído: no bit `j`, o valor da primeira equação da lista cujo bit de pivô é `j`\n(`find?`); falso quando não há tal equação. Com bits de pivô únicos, é o valor da equação do pivô `j`. -/\ndef pontoConstruido {n : ℕ} (pivots : Espectro2 n) : Fin n → Bool :=\n  fun j => match pivots.find? (fun p => decide (bitPivo p.1 = some j)) with\n    | none => false\n    | some p => decide (p.2 = 1)\n\n/-- [DEF] A ressurreição construtiva: o ponto construído da lista que `oEscalonado` devolve. Que ele sirva\no espectro não se prova neste módulo nem em outro do kernel [OPEN]. -/\ndef ressurreicaoConstrutiva {n : ℕ} (S : Espectro2 n) : Fin n → Bool :=\n  pontoConstruido (oEscalonado S)\n\nend TGLExt.OSolverGF2\n\n",
+    'TGLExt/OSolverGF2_Parte2.lean': "import TGLExt.OSolverGF2\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O solver GF(2): a preservação do servir pela redução\n\nUm ponto `x : Fin n → Bool` serve a equação de paridade `(a, v)` quando `paridade2 x a = v`\n(`serveEq`). A pedra `TGLExt.OSolverGF2` define a eliminação sobre GF(2) (`reduzirNova`,\n`inserirEscalonado`) e prova `paridade2_mask_xor`: o xor de máscaras soma as paridades. Esta pedra prova\nque os passos da eliminação preservam o servir, nas duas direções, cada um sob a sua hipótese:\n`passoReduzir_preserva` e `reduzirNova_preserva` pedem que `x` sirva o pivô ou a lista de pivôs usada;\n`pivos_reduzidos_preserva` pede que `x` sirva a equação nova `(a, v)`; `inserirEscalonado_preserva` não\npede nada sobre `x`, e sim a consistência existencial `hcons` (algum `y` serve `pivots` e `e`). A forma é\ncondicional: a soma das paridades não determina as parcelas em geral; com a parcela conhecida servida,\ndetermina. Os pivôs existentes são reduzidos contra a equação nova, como na eliminação de Gauss–Jordan\n(forma escalonada reduzida).\n\n## O que fica provado nesta pedra [REAL]\n\n1. `serve_xor_combinacao`: se `paridade2 x a₂ = v₂`, então `paridade2 x (xorPonto a₁ a₂) = v₁ + v₂` se e\n   só se `paridade2 x a₁ = v₁`.\n2. `serveEspectro2_cons'`: servir `p :: ps` é servir `p` e servir `ps`.\n3. `paridade2_mascara_zero`: a paridade na máscara zero é zero; `mascara_zero_de_bitPivo_none`: se\n   `bitPivo a = none`, então `a` é a máscara zero.\n4. `passoReduzir_preserva`: se `x` serve o pivô `p`, servir `passoReduzir p av` é servir `av`.\n5. `reduzirNova_preserva`: se `x` serve a lista `pivots`, servir `reduzirNova av.1 av.2 pivots` é servir\n   `av`.\n6. `pivos_reduzidos_preserva`: se `paridade2 x a = v`, então, para todo bit `q`, `x` serve os pivôs\n   reduzidos contra `(a, v)` no bit `q` (o passo de Gauss–Jordan) se e só se serve os pivôs originais.\n7. `inserirEscalonado_preserva`: sob a hipótese `hcons` (existe um ponto `y` que serve `pivots` e serve\n   `e`), para todo `x`: `x` serve `inserirEscalonado e pivots` se e só se `x` serve `pivots` e serve `e`.\n   A hipótese entra no caso redundante (`bitPivo` da equação reduzida é `none`), onde ela força o valor\n   reduzido a ser zero.\n8. `reduzirNova_cons`: a redução contra `p :: ps` desdobra na cabeça (o `foldl` abre e fecha por `rfl`): `passoReduzir` é\n   exatamente o passo que `reduzirNova` usa.\n\n## O que NÃO se afirma\n\n* Não se afirma aqui que o ponto construído pela eliminação (`pontoConstruido`) serve o escalonado, nem\n  que serve o espectro original, nem a montagem final do solver: esses enunciados ficam nomeados fora\n  desta pedra, não admitidos aqui. A correção da eliminação inteira não é provada nesta pedra.\n* `inserirEscalonado_preserva` pede a consistência conjunta `hcons`; sem ela, nada se afirma sobre o caso\n  redundante.\n* Resolver um sistema consistente de equações de paridade sobre GF(2) por eliminação de Gauss é\n  polinomial [KNOWN]; isso não é decidir SAT. Nada aqui decide SAT, nem dá custo de tempo na fita.\n* Esta pedra não toma como hipótese `hdiv`, `hpoco`, `GatesDaDescida`, `GatesDaMorte` nem `AVerdadeFinal`.\n  Sobre esses contratos o kernel mede, em `TGLExt.AVacuidadeDosContratos` [REAL]: `AVerdadeFinal`,\n  `GatesDaMorte` e `GatesDaDescida` não podem ser satisfeitos como estão escritos\n  (`aVerdadeFinal_insatisfazivel`, `gatesDaMorte_insatisfazivel`, `gatesDaDescida_insatisfazivel`);\n  `hdiv` e `hpoco` juntos não podem ser satisfeitos (`gates_do_processo_insatisfaziveis`; também\n  `hdiv_falso_n0`, com zero variáveis, e `hpoco_falso`, com ao menos uma variável); `hfiel` pode\n  (`hfiel_habitado`).\n* O gate do Instituto segue de pé e nomeado: decidir SAT sem testemunha, em tempo polinomial, na máquina\n  de fita segue [OPEN].\n* Nada sobre a natureza.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OSolverGF2_Parte2\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2\n\nvariable {n : ℕ}\n\n/-- [DEF] Servir uma equação: `paridade2 x e.1 = e.2`. -/\ndef serveEq {n : ℕ} (x : Fin n → Bool) (e : (Fin n → Bool) × ZMod 2) : Prop :=\n  paridade2 x e.1 = e.2\n\n/-- Servir a lista é servir a cabeça e a cauda. -/\ntheorem serveEspectro2_cons' {n : ℕ} (x : Fin n → Bool) (p : (Fin n → Bool) × ZMod 2)\n    (ps : Espectro2 n) :\n    serveEspectro2 x (p :: ps) = true ↔ serveEq x p ∧ serveEspectro2 x ps = true := by\n  simp only [serveEspectro2, List.all_cons, Bool.and_eq_true]\n  constructor\n  · intro h\n    exact ⟨(beq_iff_eq).mp h.1, h.2⟩\n  · intro h\n    exact ⟨(beq_iff_eq).mpr h.1, h.2⟩\n\n/-- A paridade na máscara zero é zero. -/\ntheorem paridade2_mascara_zero {n : ℕ} (x : Fin n → Bool) :\n    paridade2 x (fun _ => false) = 0 := by\n  unfold paridade2\n  simp\n\n/-- Sem bit de pivô, a máscara é a zero. -/\ntheorem mascara_zero_de_bitPivo_none {n : ℕ} (a : Fin n → Bool) (h : bitPivo a = none) :\n    a = fun _ => false := by\n  ext i\n  show a i = false\n  exact bitPivo_none_spec a h i\n\n/-- O passo da redução, nas duas direções: se `x` serve `(a₂, v₂)`, servir a combinação\n`(xorPonto a₁ a₂, v₁ + v₂)` é servir `(a₁, v₁)`. O xor de máscaras soma as paridades, e a parcela do pivô\ncancela. -/\ntheorem serve_xor_combinacao {n : ℕ} (x : Fin n → Bool) (a₁ a₂ : Fin n → Bool) (v₁ v₂ : ZMod 2)\n    (h2 : paridade2 x a₂ = v₂) :\n    (paridade2 x (xorPonto a₁ a₂) = v₁ + v₂) ↔ (paridade2 x a₁ = v₁) := by\n  rw [paridade2_mask_xor, h2]\n  exact add_right_cancel_iff\n\n/-- [DEF] O passo da redução contra um pivô: se o pivô tem bit `i` e a equação tem esse bit aceso, a\nequação é trocada pela sua soma com o pivô; caso contrário, fica como está. -/\ndef passoReduzir {n : ℕ} (p : (Fin n → Bool) × ZMod 2) (av : (Fin n → Bool) × ZMod 2) :\n    (Fin n → Bool) × ZMod 2 :=\n  match bitPivo p.1 with\n  | none => av\n  | some i => if av.1 i then (xorPonto av.1 p.1, av.2 + p.2) else av\n\n/-- O passo da redução preserva o servir, com o pivô servido. -/\ntheorem passoReduzir_preserva {n : ℕ} (x : Fin n → Bool) (p : (Fin n → Bool) × ZMod 2)\n    (hxp : serveEq x p) (av : (Fin n → Bool) × ZMod 2) :\n    serveEq x (passoReduzir p av) ↔ serveEq x av := by\n  unfold passoReduzir serveEq\n  cases hb : bitPivo p.1 with\n  | none => simp [hb]\n  | some i =>\n    simp only [hb]\n    by_cases hbit : av.1 i = true\n    · rw [if_pos hbit]\n      show (paridade2 x (xorPonto av.1 p.1) = av.2 + p.2) ↔ (paridade2 x av.1 = av.2)\n      exact serve_xor_combinacao x av.1 p.1 av.2 p.2 hxp\n    · rw [if_neg hbit]\n\n/-- A redução desdobra na cabeça: `reduzirNova` sobre `p :: ps` é o passo contra `p` seguido da redução\ncontra `ps`. -/\ntheorem reduzirNova_cons {n : ℕ} (a : Fin n → Bool) (v : ZMod 2) (p : (Fin n → Bool) × ZMod 2)\n    (ps : Espectro2 n) :\n    reduzirNova a v (p :: ps)\n      = reduzirNova (passoReduzir p (a, v)).1 (passoReduzir p (a, v)).2 ps := by\n  unfold reduzirNova\n  rw [List.foldl_cons]\n  rfl\n\n/-- A redução preserva o servir: se `x` serve os pivôs, servir a equação reduzida é servir a equação\noriginal. -/\ntheorem reduzirNova_preserva {n : ℕ} (x : Fin n → Bool) :\n    ∀ (pivots : Espectro2 n), serveEspectro2 x pivots = true →\n      ∀ (av : (Fin n → Bool) × ZMod 2),\n        serveEq x (reduzirNova av.1 av.2 pivots) ↔ serveEq x av := by\n  intro pivots\n  induction pivots with\n  | nil => intro _ av; simp [reduzirNova]\n  | cons p ps ih =>\n    intro hx av\n    have hxp : serveEq x p := ((serveEspectro2_cons' x p ps).mp hx).1\n    have hxps : serveEspectro2 x ps = true := ((serveEspectro2_cons' x p ps).mp hx).2\n    rw [reduzirNova_cons]\n    rw [ih hxps (passoReduzir p (av.1, av.2))]\n    have hpasso := passoReduzir_preserva x p hxp (av.1, av.2)\n    unfold serveEq at hpasso ⊢\n    simp only [] at hpasso ⊢\n    rw [hpasso]\n\n/-- A redução dos pivôs preserva o servir: se `x` serve `(a, v)`, então, para todo bit `q`, `x` serve os\npivôs reduzidos contra `(a, v)` no bit `q` se e só se serve os pivôs originais. -/\ntheorem pivos_reduzidos_preserva {n : ℕ} (x : Fin n → Bool) (a : Fin n → Bool) (v : ZMod 2)\n    (hxa : paridade2 x a = v) (q : Fin n) :\n    ∀ (pivots : Espectro2 n),\n      serveEspectro2 x (pivots.map (fun p => if p.1 q then (xorPonto p.1 a, p.2 + v) else p)) = true\n        ↔ serveEspectro2 x pivots = true := by\n  intro pivots\n  induction pivots with\n  | nil => simp\n  | cons p ps ih =>\n    rw [List.map_cons]\n    rw [serveEspectro2_cons', serveEspectro2_cons', ih]\n    by_cases hq : p.1 q = true\n    · rw [if_pos hq]\n      have hcomb := serve_xor_combinacao x p.1 a p.2 v hxa\n      show (paridade2 x (xorPonto p.1 a) = p.2 + v ∧ serveEspectro2 x ps = true) ↔\n        (paridade2 x p.1 = p.2 ∧ serveEspectro2 x ps = true)\n      rw [hcomb]\n    · rw [if_neg hq]\n\n/-- A inserção preserva o servir: sob a hipótese `hcons` (algum ponto serve os pivôs e a equação `e`),\n`x` serve o escalonado com `e` inserida se e só se `x` serve os pivôs e serve `e`. No caso redundante a\nhipótese força o valor reduzido a ser zero. -/\ntheorem inserirEscalonado_preserva {n : ℕ} (pivots : Espectro2 n) (e : (Fin n → Bool) × ZMod 2)\n    (x : Fin n → Bool)\n    (hcons : ∃ y : Fin n → Bool, serveEspectro2 y pivots = true ∧ serveEq y e) :\n    serveEspectro2 x (inserirEscalonado e pivots) = true ↔\n      serveEspectro2 x pivots = true ∧ serveEq x e := by\n  unfold inserirEscalonado\n  dsimp only []\n  set av := reduzirNova e.1 e.2 pivots with hav\n  cases hb : bitPivo av.1 with\n  | none =>\n    dsimp only []\n    have hz : av.1 = fun _ => false := mascara_zero_de_bitPivo_none av.1 hb\n    obtain ⟨y, hyp, hye⟩ := hcons\n    have hyred : serveEq y av := (reduzirNova_preserva y pivots hyp (e.1, e.2)).mpr hye\n    have hyred' : paridade2 y av.1 = av.2 := hyred\n    have hv0 : av.2 = 0 := by\n      rw [hz, paridade2_mascara_zero] at hyred'\n      exact hyred'.symm\n    constructor\n    · intro hx\n      refine ⟨hx, ?_⟩\n      have hxred : serveEq x av := by\n        show paridade2 x av.1 = av.2\n        rw [hz, paridade2_mascara_zero, hv0]\n      have hxe : serveEq x (e.1, e.2) :=\n        (reduzirNova_preserva x pivots hx (e.1, e.2)).mp hxred\n      exact hxe\n    · intro h\n      exact h.1\n  | some q =>\n    dsimp only []\n    rw [serveEspectro2_cons']\n    constructor\n    · intro h\n      obtain ⟨hxav, hxmap⟩ := h\n      have hxpiv : serveEspectro2 x pivots = true :=\n        (pivos_reduzidos_preserva x av.1 av.2 hxav q pivots).mp hxmap\n      refine ⟨hxpiv, ?_⟩\n      exact (reduzirNova_preserva x pivots hxpiv (e.1, e.2)).mp hxav\n    · intro h\n      obtain ⟨hxpiv, hxe⟩ := h\n      have hxav : serveEq x av := (reduzirNova_preserva x pivots hxpiv (e.1, e.2)).mpr hxe\n      exact ⟨hxav, (pivos_reduzidos_preserva x av.1 av.2 hxav q pivots).mpr hxpiv⟩\n\nend TGLExt.OSolverGF2_Parte2\n\n",
+    'TGLExt/OSolverGF2_Parte3.lean': 'import TGLExt.OSolverGF2_Parte2\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O solver GF(2): a forma isolada e o ponto servido\n\n## O que é\n\nUm espectro é uma lista de equações de paridade sobre GF(2) (máscara, valor). Na forma ISOLADA, toda equação tem\npivô; o mesmo bit de pivô é a mesma equação; e o bit de pivô de uma equação não entra na máscara de outra. O ponto\nconstruído (`pontoConstruido`) lê cada bit direto do espectro: no bit de pivô, o valor da primeira equação da lista\ncom esse pivô; nos demais bits, falso. Na forma isolada essa equação é a única com aquele pivô.\n\nEste módulo é uma peça do resolvedor GF(2) construtivo que o transporte T pede (hipótese nomeada [OPEN] em\n`ARessurreicao`); o transporte T não se prova aqui.\n\n## O que fica provado [REAL]\n\n1. `formaIsolada` [DEF]: a forma isolada, como definição; `formaIsolada_nil`: a lista vazia está na forma isolada.\n2. `pontoConstruido_no_bit_de_nao_pivo`: num bit que não é pivô de nenhuma equação, o ponto construído é falso.\n   `find?_de_unico`: se `e` está na lista, satisfaz o predicado e todo elemento da lista que o satisfaz é igual a\n   `e`, então `find?` devolve `e` (único a menos de repetições de `e` na lista).\n   `pontoConstruido_no_bit_de_pivo`: se uma equação é a única com aquele bit de pivô, o ponto construído nesse bit é\n   o valor dela.\n3. ★★ `pontoConstruido_serve`: se o espectro está na forma isolada, o ponto construído serve cada equação dele (a\n   paridade do ponto na máscara é o valor da equação).\n\n## O que NÃO se afirma\n\n* Não se prova aqui que a inserção de uma equação preserva a forma isolada, nem a montagem do solver completo. Essas\n  duas etapas ficam nomeadas como alvos abertos [OPEN]; não entram como axioma nem como sorry.\n* Resolver um sistema consistente de equações de paridade sobre GF(2) por eliminação gaussiana é polinomial\n  [KNOWN]; isso não é decidir SAT. Nada aqui diz que algum procedimento decida SAT.\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OSolverGF2_Parte3\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2\n\nvariable {n : ℕ}\n\n/-- [DEF] A forma isolada: toda equação tem pivô; o mesmo bit de pivô é a mesma equação; e o bit de pivô\nde uma não entra na máscara de outra. -/\ndef formaIsolada {n : ℕ} (pivots : Espectro2 n) : Prop :=\n  (∀ p ∈ pivots, ∃ i : Fin n, bitPivo p.1 = some i)\n    ∧ (∀ p₁ ∈ pivots, ∀ p₂ ∈ pivots, ∀ i : Fin n, bitPivo p₁.1 = some i → bitPivo p₂.1 = some i → p₁ = p₂)\n    ∧ (∀ p₁ ∈ pivots, ∀ p₂ ∈ pivots, ∀ i j : Fin n,\n        bitPivo p₁.1 = some i → bitPivo p₂.1 = some j → i ≠ j → p₁.1 j = false)\n\n/-- A lista vazia está na forma isolada. -/\ntheorem formaIsolada_nil : formaIsolada ([] : Espectro2 n) := by\n  refine ⟨?_, ?_, ?_⟩\n  · intro p hp\n    exact absurd hp (List.not_mem_nil)\n  · intro p₁ hp₁\n    exact absurd hp₁ (List.not_mem_nil)\n  · intro p₁ hp₁\n    exact absurd hp₁ (List.not_mem_nil)\n\n/-- Num bit que não é pivô de nenhuma equação, o ponto construído é falso. -/\ntheorem pontoConstruido_no_bit_de_nao_pivo {n : ℕ} (pivots : Espectro2 n) (j : Fin n)\n    (h : ∀ p ∈ pivots, bitPivo p.1 ≠ some j) :\n    pontoConstruido pivots j = false := by\n  unfold pontoConstruido\n  have hnone : pivots.find? (fun p => decide (bitPivo p.1 = some j)) = none := by\n    rw [List.find?_eq_none]\n    intro p hp\n    simp [h p hp]\n  rw [hnone]\n\n/-- Se `e` está na lista, satisfaz o predicado e todo elemento da lista que o satisfaz é igual a `e`, então\n`find?` devolve `e` (único a menos de repetições de `e` na lista). -/\ntheorem find?_de_unico {α : Type} (l : List α) (p : α → Bool) (e : α)\n    (he : e ∈ l) (hp : p e = true) (huni : ∀ a ∈ l, p a = true → a = e) :\n    l.find? p = some e := by\n  induction l with\n  | nil => exact absurd he (List.not_mem_nil)\n  | cons a as ih =>\n    rw [List.find?_cons]\n    by_cases ha : p a = true\n    · rw [ha]\n      exact congrArg some (huni a (List.mem_cons_self) ha)\n    · have haf : p a = false := by simp [ha]\n      rw [haf]\n      apply ih\n      · cases List.mem_cons.mp he with\n        | inl h1 =>\n          subst h1\n          exact absurd hp ha\n        | inr h2 => exact h2\n      · intro b hb\n        exact huni b (List.mem_cons_of_mem _ hb)\n\n/-- Se a equação `e` é a única com o bit de pivô `j`, o ponto construído em `j` é o valor dela. -/\ntheorem pontoConstruido_no_bit_de_pivo {n : ℕ} (pivots : Espectro2 n) (e : (Fin n → Bool) × ZMod 2)\n    (j : Fin n) (he : e ∈ pivots) (hb : bitPivo e.1 = some j)\n    (hdist : ∀ p ∈ pivots, bitPivo p.1 = some j → p = e) :\n    pontoConstruido pivots j = decide (e.2 = 1) := by\n  unfold pontoConstruido\n  have hfind : pivots.find? (fun p => decide (bitPivo p.1 = some j)) = some e := by\n    apply find?_de_unico pivots _ e he (by simp [hb])\n    intro p hp hpiv\n    exact hdist p hp (of_decide_eq_true hpiv)\n  rw [hfind]\n\n/-- ★★ **O PONTO CONSTRUÍDO SERVE A FORMA ISOLADA**: se o espectro está na forma isolada, o ponto construído\nserve cada equação dele; a paridade do ponto na máscara é o valor da equação. -/\ntheorem pontoConstruido_serve {n : ℕ} (pivots : Espectro2 n) (hiso : formaIsolada pivots) :\n    ∀ e ∈ pivots, serveEq (pontoConstruido pivots) e := by\n  intro e he\n  obtain ⟨i, hb⟩ := hiso.1 e he\n  show paridade2 (pontoConstruido pivots) e.1 = e.2\n  unfold paridade2\n  have houtros : ∀ j ∈ Finset.univ, j ≠ i →\n      (if e.1 j && pontoConstruido pivots j then (1 : ZMod 2) else 0) = 0 := by\n    intro j _ hji\n    by_cases hbit : e.1 j = true\n    · have hnao : ∀ p ∈ pivots, bitPivo p.1 ≠ some j := by\n        intro p hp hpiv\n        have hzero : e.1 j = false := hiso.2.2 e he p hp i j hb hpiv (Ne.symm hji)\n        rw [hzero] at hbit\n        simp at hbit\n      rw [pontoConstruido_no_bit_de_nao_pivo pivots j hnao]\n      simp\n    · simp [hbit]\n  rw [Finset.sum_eq_single i houtros (fun h => absurd (Finset.mem_univ i) h)]\n  have hxi : pontoConstruido pivots i = decide (e.2 = 1) :=\n    pontoConstruido_no_bit_de_pivo pivots e i he hb (fun p hp hpiv => hiso.2.1 p hp e he i hpiv hb)\n  have hbit : e.1 i = true := bitPivo_spec e.1 i hb\n  rw [hbit, hxi]\n  simp only [Bool.true_and]\n  cases zmod2_exaustivo e.2 with\n  | inl h0 => rw [h0]; simp\n  | inr h1 => rw [h1]; simp\n\nend TGLExt.OSolverGF2_Parte3\n\n',
+    'TGLExt/OSolverGF2_Parte4.lean': "import TGLExt.OSolverGF2_Parte3\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O solver GF(2): o invariante preservado e a correção do resolvedor\n\n## O que é\n\nA eliminação de Gauss–Jordan sobre GF(2) (`reduzirNova`, `inserirEscalonado`, `oEscalonado`, em `OSolverGF2`) leva um\nespectro (lista de equações de paridade) à forma isolada, e o ponto construído (`pontoConstruido`) lê dessa forma um ponto,\nbit a bit. A ressurreição construtiva (`ressurreicaoConstrutiva`) é esse ponto, calculado do espectro, sem escolha.\n\n## O que fica provado [REAL]\n\n1. `bitPivo_iff`: o bit de pivô de uma máscara é um bit aceso, e nenhum bit aceso vem antes dele.\n   `bitPivo_xor_preserva`: se o pivô de `p` é `i`, o pivô de `a` é `q` e `i < q`, o ou-exclusivo de `p` com `a` tem pivô `i`.\n2. `reduzirNova_preserva_bit`: se toda equação da lista que acende o bit `i` tem pivô `i`, a redução de uma máscara com o bit\n   `i` apagado o deixa apagado. `reduzirNova_livre`: com a lista na forma isolada, a máscara reduzida não tem nenhum bit de\n   pivô da lista.\n3. ★ `inserirEscalonado_preserva_isolada`: a inserção preserva a forma isolada. `oEscalonado_isolada`: o escalonado de\n   qualquer espectro está na forma isolada.\n4. ★ `oEscalonado_preserva`: quando o espectro tem um ponto que o serve, um ponto serve o escalonado se e só se serve o\n   espectro original.\n5. ★★ `o_solver_serve`: quando o espectro tem um ponto que o serve, o ponto construído do escalonado serve o espectro\n   original. É a correção do resolvedor construtivo: a ressurreição fiel, calculada sem escolha clássica.\n\n## O que NÃO se afirma\n\n* O custo: o número de passos da eliminação não é contado aqui. Que a eliminação de Gauss–Jordan leve tempo polinomial é\n  [KNOWN]. Do transporte T, como `ARessurreicao` o nomeia (um resolvedor construtivo e polinomial que cumpra o G1), fica\n  provada aqui a correção; o custo segue fora do kernel.\n* Nada aqui trata da divisão na morte (`hdiv`) nem do eco: que, havendo solução, o eco venha segue [OPEN].\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial. Isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OSolverGF2_Parte4\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3\n\nvariable {n : ℕ}\n\n/-- ★ A caracterização do bit de pivô: aceso e mínimo. (Auxiliar do invariante.) -/\ntheorem bitPivo_iff {n : ℕ} (a : Fin n → Bool) (i : Fin n) :\n    bitPivo a = some i ↔ a i = true ∧ ∀ j : Fin n, a j = true → i ≤ j := by\n  constructor\n  · intro h\n    exact ⟨bitPivo_spec a i h, bitPivo_minimal a i h⟩\n  · intro h\n    unfold bitPivo\n    have hne : ((Finset.univ : Finset (Fin n)).filter fun k => a k = true).Nonempty :=\n      ⟨i, by simp [Finset.mem_filter, h.1]⟩\n    rw [dif_pos hne]\n    have hmem : i ∈ (Finset.univ : Finset (Fin n)).filter (fun k => a k = true) := by\n      simp [Finset.mem_filter, h.1]\n    have h1 : ((Finset.univ : Finset (Fin n)).filter (fun k => a k = true)).min' hne ≤ i :=\n      Finset.min'_le _ _ hmem\n    have h2 : i ≤ ((Finset.univ : Finset (Fin n)).filter (fun k => a k = true)).min' hne := by\n      have hm := Finset.min'_mem _ hne\n      simp [Finset.mem_filter] at hm\n      exact h.2 _ hm\n    have heq : ((Finset.univ : Finset (Fin n)).filter (fun k => a k = true)).min' hne = i :=\n      le_antisymm h1 h2\n    rw [heq]\n\n/-- ★ O xor com a máscara além preserva o pivô. (Auxiliar do invariante.) -/\ntheorem bitPivo_xor_preserva {n : ℕ} (p a : Fin n → Bool) (i q : Fin n)\n    (hp : bitPivo p = some i) (ha : bitPivo a = some q) (hiq : i < q) :\n    bitPivo (xorPonto p a) = some i := by\n  rw [bitPivo_iff]\n  have hpi : p i = true := bitPivo_spec p i hp\n  have hai : a i = false := by\n    by_contra hc\n    have hbit : a i = true := by cases h : a i <;> simp_all\n    have hle := bitPivo_minimal a q ha i hbit\n    have hle' : (q : ℕ) ≤ (i : ℕ) := hle\n    have hiq' : (i : ℕ) < (q : ℕ) := hiq\n    omega\n  constructor\n  · show (p i != a i) = true\n    rw [hpi, hai]\n    rfl\n  · intro j hj\n    show i ≤ j\n    by_contra hji\n    have hji' : (j : ℕ) < (i : ℕ) := by\n      have h1 : ¬ (i : Fin n) ≤ j := hji\n      have h2 : ¬ (i : ℕ) ≤ (j : ℕ) := fun h => h1 h\n      omega\n    have hpj : p j = false := by\n      by_contra hc\n      have hbit : p j = true := by cases h : p j <;> simp_all\n      have hle := bitPivo_minimal p i hp j hbit\n      have hle' : (i : ℕ) ≤ (j : ℕ) := hle\n      omega\n    have haj : a j = false := by\n      by_contra hc\n      have hbit : a j = true := by cases h : p j <;> simp_all\n      have hle := bitPivo_minimal a q ha j hbit\n      have hle' : (q : ℕ) ≤ (j : ℕ) := hle\n      omega\n    have hxor : (p j != a j) = true := hj\n    rw [hpj, haj] at hxor\n    simp at hxor\n\n/-- ★ A redução não acende um bit morto. (Auxiliar do livre.) -/\ntheorem reduzirNova_preserva_bit {n : ℕ} (i : Fin n) :\n    ∀ (pivots : Espectro2 n), (∀ q ∈ pivots, q.1 i = true → bitPivo q.1 = some i) →\n      ∀ (a : Fin n → Bool) (v : ZMod 2), a i = false → (reduzirNova a v pivots).1 i = false := by\n  intro pivots\n  induction pivots with\n  | nil => intro _ a v ha; simpa [reduzirNova] using ha\n  | cons p ps ih =>\n    intro hpivots a v ha\n    rw [reduzirNova_cons]\n    apply ih (fun q hq => hpivots q (List.mem_cons_of_mem _ hq))\n    unfold passoReduzir\n    cases hb : bitPivo p.1 with\n    | none => simp [hb]; exact ha\n    | some j =>\n      dsimp only []\n      by_cases hbit : a j = true\n      · rw [if_pos hbit]\n        show (xorPonto a p.1) i = false\n        show (a i != p.1 i) = false\n        by_cases hpi : p.1 i = true\n        · have hji := hpivots p (List.mem_cons_self) hpi\n          rw [hb] at hji\n          have hji' : j = i := Option.some.inj hji\n          subst hji'\n          rw [hbit] at ha\n          simp at ha\n        · have hpf : p.1 i = false := by cases h : p.1 i <;> simp_all\n          rw [ha, hpf]\n          rfl\n      · rw [if_neg hbit]; exact ha\n\n/-- ★ A máscara reduzida não tem os bits de pivô da lista. (Auxiliar do invariante.) -/\ntheorem reduzirNova_livre {n : ℕ} :\n    ∀ (pivots : Espectro2 n), formaIsolada pivots →\n      ∀ (a : Fin n → Bool) (v : ZMod 2) (i : Fin n),\n        (∃ p ∈ pivots, bitPivo p.1 = some i) → (reduzirNova a v pivots).1 i = false := by\n  intro pivots\n  induction pivots with\n  | nil =>\n    intro _ a v i hi\n    obtain ⟨p, hp, _⟩ := hi\n    exact absurd hp (List.not_mem_nil)\n  | cons p ps ih =>\n    intro hiso a v i hi\n    obtain ⟨hiso1, hiso2, hiso3⟩ := hiso\n    have hps : formaIsolada ps := by\n      refine ⟨?_, ?_, ?_⟩\n      · intro q hq\n        exact hiso1 q (List.mem_cons_of_mem _ hq)\n      · intro q₁ hq₁ q₂ hq₂ j\n        exact hiso2 q₁ (List.mem_cons_of_mem _ hq₁) q₂ (List.mem_cons_of_mem _ hq₂) j\n      · intro q₁ hq₁ q₂ hq₂ j₁ j₂\n        exact hiso3 q₁ (List.mem_cons_of_mem _ hq₁) q₂ (List.mem_cons_of_mem _ hq₂) j₁ j₂\n    rw [reduzirNova_cons]\n    obtain ⟨p', hp', hpi⟩ := hi\n    rw [List.mem_cons] at hp'\n    cases hp' with\n    | inl hpp =>\n      cases hpp\n      have h1 : (passoReduzir p (a, v)).1 i = false := by\n        unfold passoReduzir\n        rw [hpi]\n        simp only []\n        by_cases hbit : a i = true\n        · rw [if_pos hbit]\n          show (xorPonto a p.1) i = false\n          show (a i != p.1 i) = false\n          rw [hbit, bitPivo_spec p.1 i hpi]\n          rfl\n        · rw [if_neg hbit]\n          cases h : a i <;> simp_all\n      have hps' : ∀ q ∈ ps, q.1 i = true → bitPivo q.1 = some i := by\n        intro q hq hqi\n        obtain ⟨jq, hjq⟩ := hiso1 q (List.mem_cons_of_mem _ hq)\n        by_cases hjeq : jq = i\n        · subst hjeq; exact hjq\n        · have hz := hiso3 q (List.mem_cons_of_mem _ hq) p (List.mem_cons_self) jq i hjq hpi hjeq\n          rw [hz] at hqi\n          simp at hqi\n      exact reduzirNova_preserva_bit i ps hps' _ _ h1\n    | inr hps_mem =>\n      exact ih hps _ _ i ⟨p', hps_mem, hpi⟩\n\n/-- ★ A inserção preserva a forma isolada. -/\ntheorem inserirEscalonado_preserva_isolada {n : ℕ} (pivots : Espectro2 n) (e : (Fin n → Bool) × ZMod 2)\n    (hiso : formaIsolada pivots) :\n    formaIsolada (inserirEscalonado e pivots) := by\n  unfold inserirEscalonado\n  dsimp only []\n  obtain ⟨hiso1, hiso2, hiso3⟩ := hiso\n  set av := reduzirNova e.1 e.2 pivots with hav\n  cases hb : bitPivo av.1 with\n  | none =>\n    dsimp only []\n    exact ⟨hiso1, hiso2, hiso3⟩\n  | some q =>\n    dsimp only []\n    have livre : ∀ j : Fin n, (∃ p ∈ pivots, bitPivo p.1 = some j) → av.1 j = false :=\n      fun j hj => reduzirNova_livre pivots ⟨hiso1, hiso2, hiso3⟩ _ _ j hj\n    -- F2: o pivô da mapeada é o da original\n    have hpiv : ∀ p₀ ∈ pivots, ∀ i₀ : Fin n, bitPivo p₀.1 = some i₀ →\n        bitPivo (if p₀.1 q = true then (xorPonto p₀.1 av.1, p₀.2 + av.2) else p₀).1 = some i₀ := by\n      intro p₀ hp₀ i₀ hi₀\n      by_cases hf : p₀.1 q = true\n      · rw [if_pos hf]\n        show bitPivo (xorPonto p₀.1 av.1) = some i₀\n        apply bitPivo_xor_preserva p₀.1 av.1 i₀ q hi₀ hb\n        have hle := bitPivo_minimal p₀.1 i₀ hi₀ q hf\n        have hne : i₀ ≠ q := by\n          intro heq\n          cases heq\n          have h1 : av.1 q = false := livre q ⟨p₀, hp₀, hi₀⟩\n          have h2 : av.1 q = true := bitPivo_spec av.1 q hb\n          rw [h1] at h2\n          simp at h2\n        have hle' : (i₀ : ℕ) ≤ (q : ℕ) := hle\n        have hne' : (i₀ : ℕ) ≠ (q : ℕ) := fun h => hne (Fin.ext h)\n        show (i₀ : Fin n) < q\n        omega\n      · rw [if_neg hf]\n        exact hi₀\n    -- F3: o q é fresco\n    have hfresco : ∀ p₀ ∈ pivots, ∀ i₀ : Fin n, bitPivo p₀.1 = some i₀ → i₀ ≠ q := by\n      intro p₀ hp₀ i₀ hi₀ heq\n      cases heq\n      have h1 : av.1 q = false := livre q ⟨p₀, hp₀, hi₀⟩\n      have h2 : av.1 q = true := bitPivo_spec av.1 q hb\n      rw [h1] at h2\n      simp at h2\n    refine ⟨?_, ?_, ?_⟩\n    · -- toda equação tem pivô\n      intro p hp\n      rw [List.mem_cons, List.mem_map] at hp\n      cases hp with\n      | inl h =>\n        subst h\n        exact ⟨q, hb⟩\n      | inr h =>\n        obtain ⟨p₀, hp₀, hpeq⟩ := h\n        subst hpeq\n        obtain ⟨i₀, hi₀⟩ := hiso1 p₀ hp₀\n        exact ⟨i₀, hpiv p₀ hp₀ i₀ hi₀⟩\n    · -- o mesmo bit é a mesma equação\n      intro p₁ hp₁ p₂ hp₂ i hb1 hb2\n      rw [List.mem_cons, List.mem_map] at hp₁ hp₂\n      cases hp₁ with\n      | inl h1 =>\n        subst h1\n        have hiq : i = q := Option.some.inj (hb1.symm.trans hb)\n        cases hiq\n        cases hp₂ with\n        | inl h2 =>\n          subst h2\n          rfl\n        | inr h2 =>\n          obtain ⟨p₀₂, hp₀₂, hpeq₂⟩ := h2\n          subst hpeq₂\n          obtain ⟨i₂, hi₂⟩ := hiso1 p₀₂ hp₀₂\n          have hb2' := hpiv p₀₂ hp₀₂ i₂ hi₂\n          rw [hb2'] at hb2\n          have hii : i₂ = q := Option.some.inj hb2\n          exact absurd hii (hfresco p₀₂ hp₀₂ i₂ hi₂)\n      | inr h1 =>\n        obtain ⟨p₀₁, hp₀₁, hpeq₁⟩ := h1\n        subst hpeq₁\n        obtain ⟨i₁, hi₁⟩ := hiso1 p₀₁ hp₀₁\n        have hb1' := hpiv p₀₁ hp₀₁ i₁ hi₁\n        rw [hb1'] at hb1\n        have hi1 : i₁ = i := Option.some.inj hb1\n        cases hp₂ with\n        | inl h2 =>\n          subst h2\n          have hiq : i = q := Option.some.inj (hb2.symm.trans hb)\n          exact absurd (hi1.trans hiq) (hfresco p₀₁ hp₀₁ i₁ hi₁)\n        | inr h2 =>\n          obtain ⟨p₀₂, hp₀₂, hpeq₂⟩ := h2\n          subst hpeq₂\n          obtain ⟨i₂, hi₂⟩ := hiso1 p₀₂ hp₀₂\n          have hb2' := hpiv p₀₂ hp₀₂ i₂ hi₂\n          rw [hb2'] at hb2\n          have hi2 : i₂ = i := Option.some.inj hb2\n          have hii : i₁ = i₂ := hi1.trans hi2.symm\n          have hb2'' : bitPivo p₀₂.1 = some i₁ := by rw [hii]; exact hi₂\n          have hpar : p₀₁ = p₀₂ := hiso2 p₀₁ hp₀₁ p₀₂ hp₀₂ i₁ hi₁ hb2''\n          cases hpar\n          rfl\n    · -- o isolamento\n      intro p₁ hp₁ p₂ hp₂ i j hb1 hb2 hij\n      rw [List.mem_cons, List.mem_map] at hp₁ hp₂\n      cases hp₁ with\n      | inl h1 =>\n        subst h1\n        have hiq : i = q := Option.some.inj (hb1.symm.trans hb)\n        cases hiq\n        cases hp₂ with\n        | inl h2 =>\n          subst h2\n          exact absurd (Option.some.inj (hb1.symm.trans hb2)) hij\n        | inr h2 =>\n          obtain ⟨p₀₂, hp₀₂, hpeq₂⟩ := h2\n          subst hpeq₂\n          obtain ⟨j₂, hj₂⟩ := hiso1 p₀₂ hp₀₂\n          have hb2' := hpiv p₀₂ hp₀₂ j₂ hj₂\n          rw [hb2'] at hb2\n          have hjj : j₂ = j := Option.some.inj hb2\n          cases hjj\n          exact livre j ⟨p₀₂, hp₀₂, hj₂⟩\n      | inr h1 =>\n        obtain ⟨p₀₁, hp₀₁, hpeq₁⟩ := h1\n        subst hpeq₁\n        obtain ⟨i₁, hi₁⟩ := hiso1 p₀₁ hp₀₁\n        have hb1' := hpiv p₀₁ hp₀₁ i₁ hi₁\n        rw [hb1'] at hb1\n        have hi1 : i₁ = i := Option.some.inj hb1\n        cases hi1\n        cases hp₂ with\n        | inl h2 =>\n          subst h2\n          have hjq : j = q := Option.some.inj (hb2.symm.trans hb)\n          cases hjq\n          by_cases hf : p₀₁.1 q = true\n          · rw [if_pos hf]\n            show (xorPonto p₀₁.1 av.1) q = false\n            show (p₀₁.1 q != av.1 q) = false\n            rw [hf, bitPivo_spec av.1 q hb]\n            rfl\n          · rw [if_neg hf]\n            cases h : p₀₁.1 q <;> simp_all\n        | inr h2 =>\n          obtain ⟨p₀₂, hp₀₂, hpeq₂⟩ := h2\n          subst hpeq₂\n          obtain ⟨j₂, hj₂⟩ := hiso1 p₀₂ hp₀₂\n          have hb2' := hpiv p₀₂ hp₀₂ j₂ hj₂\n          rw [hb2'] at hb2\n          have hjj : j₂ = j := Option.some.inj hb2\n          cases hjj\n          by_cases hf : p₀₁.1 q = true\n          · rw [if_pos hf]\n            show (xorPonto p₀₁.1 av.1) j = false\n            show (p₀₁.1 j != av.1 j) = false\n            have h1 : p₀₁.1 j = false :=\n              hiso3 p₀₁ hp₀₁ p₀₂ hp₀₂ i j hi₁ hj₂ hij\n            have h2 : av.1 j = false := livre j ⟨p₀₂, hp₀₂, hj₂⟩\n            rw [h1, h2]\n            rfl\n          · rw [if_neg hf]\n            exact hiso3 p₀₁ hp₀₁ p₀₂ hp₀₂ i j hi₁ hj₂ hij\n\n/-- ★ O escalonado do espectro é isolado. -/\ntheorem oEscalonado_isolada {n : ℕ} (S : Espectro2 n) : formaIsolada (oEscalonado S) := by\n  unfold oEscalonado\n  suffices h : ∀ (S' : Espectro2 n) (acc : Espectro2 n), formaIsolada acc →\n      formaIsolada (List.foldl (fun ps e => inserirEscalonado e ps) acc S') by\n    exact h S [] formaIsolada_nil\n  intro S'\n  induction S' with\n  | nil => intro acc hacc; simpa using hacc\n  | cons e S'' ih =>\n    intro acc hacc\n    rw [List.foldl_cons]\n    exact ih (inserirEscalonado e acc) (inserirEscalonado_preserva_isolada acc e hacc)\n\n/-- ★ O escalonado preserva o servir. -/\ntheorem oEscalonado_preserva {n : ℕ} (S : Espectro2 n) (x : Fin n → Bool)\n    (hcons : ∃ y : Fin n → Bool, serveEspectro2 y S = true) :\n    serveEspectro2 x (oEscalonado S) = true ↔ serveEspectro2 x S = true := by\n  unfold oEscalonado\n  suffices h : ∀ (S' : Espectro2 n) (acc : Espectro2 n),\n      (∃ y : Fin n → Bool, serveEspectro2 y acc = true ∧ serveEspectro2 y S' = true) →\n      (serveEspectro2 x (List.foldl (fun ps e => inserirEscalonado e ps) acc S') = true ↔\n        (serveEspectro2 x acc = true ∧ serveEspectro2 x S' = true)) by\n    have h1 := h S [] (by obtain ⟨y, hy⟩ := hcons; exact ⟨y, by simp [serveEspectro2], hy⟩)\n    have h2 : serveEspectro2 x ([] : Espectro2 n) = true := by simp [serveEspectro2]\n    have h3 : (serveEspectro2 x ([] : Espectro2 n) = true ∧ serveEspectro2 x S = true) ↔\n        serveEspectro2 x S = true := by\n      constructor\n      · intro hh; exact hh.2\n      · intro hh; exact ⟨h2, hh⟩\n    rw [h3] at h1\n    exact h1\n  intro S'\n  induction S' with\n  | nil =>\n    intro acc hcon\n    rw [List.foldl_nil]\n    have h2 : serveEspectro2 x ([] : Espectro2 n) = true := by simp [serveEspectro2]\n    rw [h2]\n    simp\n  | cons e S'' ih =>\n    intro acc hcon\n    rw [List.foldl_cons]\n    obtain ⟨y, hyacc, hycons⟩ := hcon\n    rw [serveEspectro2_cons'] at hycons\n    have hcon' : ∃ y : Fin n → Bool, serveEspectro2 y acc = true ∧ serveEq y e := ⟨y, hyacc, hycons.1⟩\n    have hins := inserirEscalonado_preserva acc e x hcon'\n    have hcon'' : ∃ y : Fin n → Bool, serveEspectro2 y (inserirEscalonado e acc) = true ∧\n        serveEspectro2 y S'' = true :=\n      ⟨y, (inserirEscalonado_preserva acc e y hcon').mpr ⟨hyacc, hycons.1⟩, hycons.2⟩\n    rw [ih (inserirEscalonado e acc) hcon'']\n    rw [hins]\n    constructor\n    · intro hh\n      obtain ⟨⟨h1, h2⟩, h3⟩ := hh\n      exact ⟨h1, (serveEspectro2_cons' x e S'').mpr ⟨h2, h3⟩⟩\n    · intro hh\n      obtain ⟨h1, h2⟩ := hh\n      rw [serveEspectro2_cons'] at h2\n      exact ⟨⟨h1, h2.1⟩, h2.2⟩\n\n/-- ★★ **A CORREÇÃO DO SOLVER** (o G1 construtivo): com o espectro consistente, o ponto construído do\nescalonado serve o espectro original — a ressurreição construtiva é fiel. -/\ntheorem o_solver_serve {n : ℕ} (S : Espectro2 n)\n    (hcons : ∃ y : Fin n → Bool, serveEspectro2 y S = true) :\n    serveEspectro2 (ressurreicaoConstrutiva S) S = true := by\n  unfold ressurreicaoConstrutiva\n  have hiso := oEscalonado_isolada S\n  have hserve := pontoConstruido_serve (oEscalonado S) hiso\n  have h1 : serveEspectro2 (pontoConstruido (oEscalonado S)) (oEscalonado S) = true := by\n    unfold serveEspectro2\n    rw [List.all_eq_true]\n    intro e he\n    exact (beq_iff_eq).mpr (hserve e he)\n  exact (oEscalonado_preserva S _ hcons).mp h1\n\nend TGLExt.OSolverGF2_Parte4\n\n",
+    'TGLExt/AVvem.lean': 'import TGLExt.OSolverGF2_Parte4\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A condição por morte, medida\n\n## O que é\n\nNa descida com espectro, cada morte guarda um lado: a paridade `v` num eixo `a`. A condição por morte (`morteSadia`) é que\no lado guardado guarde toda solução da fórmula que serve o espectro. Esta pedra define a condição e a mede numa fórmula de\nduas variáveis.\n\n## O que fica provado [REAL]\n\n1. `morteSadia` [DEF]: o lado guardado (a paridade `v` no eixo `a`) guarda toda solução que serve o espectro.\n2. ★ `a_morte_do_lado_do_poco_e_insidia` (por `decide`): na fórmula «x₀ ou x₁» e «não x₀ ou não x₁» (`phiMedida`), cujas\n   soluções são (V, F) e (F, V), guardar no eixo das duas variáveis a paridade 0, a do canto (F, F), não é sadio: as duas\n   soluções têm paridade 1.\n3. ★ `a_morte_do_lado_oposto_e_sadia_aqui` (por `decide`): na mesma fórmula, guardar a paridade 1 é sadio.\n4. `o_residuo_final_com_a_luz`: um ponto de custo zero dá SAT. As hipóteses de servir o espectro e de ser o único ponto\n   que satisfaz e serve não entram na prova.\n\n## O que NÃO se afirma\n\n* A condição por morte em geral, para toda fórmula e todo poço, não está provada; que, havendo solução, o eco venha segue\n  [OPEN].\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial. Isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.AVvem\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\n\nvariable {n : ℕ}\n\n/-- [DEF] **A morte sadia**: o lado guardado (a paridade `v` no eixo `a`) guarda toda solução da fórmula\nque serve o espectro. (A condição por morte do V-vem.) -/\ndef morteSadia {n : ℕ} (φ : CNF n) (S : Espectro2 n) (a : Fin n → Bool) (v : ZMod 2) : Prop :=\n  ∀ x : Fin n → Bool, custoCNF φ x = 0 → serveEspectro2 x S = true → paridade2 x a = v\n\n/-! ## A medida -/\n\n/-- A fórmula da medida: `x₀ ∨ x₁` e `¬x₀ ∨ ¬x₁` — as soluções são (V,F) e (F,V), as duas de paridade 1. -/\ndef phiMedida : CNF 2 := [[⟨0, true⟩, ⟨1, true⟩], [⟨0, false⟩, ⟨1, false⟩]]\n\n/-- O eixo da medida: as duas variáveis. -/\ndef eixoMedida : Fin 2 → Bool := fun _ => true\n\n/-- ★ **A MORTE DO LADO DO POÇO É INSIDIA**: na fórmula da medida, guardar a paridade 0 (o lado do canto)\nperde toda solução. (Medido por `decide`.) -/\ntheorem a_morte_do_lado_do_poco_e_insidia :\n    ¬ morteSadia phiMedida [] eixoMedida 0 := by\n  unfold morteSadia\n  decide\n\n/-- ★ **A MORTE DO LADO OPOSTO É SADIA AQUI**: guardar a paridade 1 (o lado oposto ao canto) guarda toda\nsolução. (Medido por `decide`.) -/\ntheorem a_morte_do_lado_oposto_e_sadia_aqui :\n    morteSadia phiMedida [] eixoMedida 1 := by\n  unfold morteSadia\n  decide\n\n/-- Um ponto de custo zero dá SAT. As hipóteses `hserve` (o ponto serve o espectro) e `hguarda` (ele é o único que\nsatisfaz e serve) não entram na prova. -/\ntheorem o_residuo_final_com_a_luz {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\n    (hsat : custoCNF φ x = 0) (hserve : serveEspectro2 x S = true)\n    (hguarda : ∀ y : Fin n → Bool, custoCNF φ y = 0 → serveEspectro2 y S = true → y = x) :\n    SAT φ :=\n  ⟨x, (custoCNF_zero_sse φ x).mp hsat⟩\n\nend TGLExt.AVvem\n\n',
+    'TGLExt/OProcessoFinal.lean': 'import TGLExt.AVvem\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# A morte sadia guarda a luz\n\n## O que é\n\nA condição por morte (`morteSadia`, em `AVvem`) diz que o lado guardado na morte (a paridade `v` no eixo `a`) guarda toda\nsolução da fórmula que serve o espectro. Esta pedra mostra o que essa condição garante quando vale.\n\n## O que fica provado [REAL]\n\n1. ★ `a_morte_sadia_guarda_a_luz`: se a morte é sadia e há uma solução da fórmula que serve o espectro, há uma solução da\n   fórmula que serve o espectro acrescido da equação lida `(a, v)`.\n2. `o_vvem_condicional`: dados uma solução que serve o espectro (`hcons`) e a unicidade do ponto que serve o espectro\n   (`hunico`), a fórmula é satisfazível. A conclusão (SAT) já decorre de `hcons`; o teorema não diz que o ponto final\n   satisfaça a fórmula nem que algum processo o devolva.\n\n## O que NÃO se afirma\n\n* A condição por morte em geral, para toda fórmula e todo poço, não está provada; que, havendo solução, o eco venha segue\n  [OPEN].\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial. Isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.OProcessoFinal\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem\n\nvariable {n : ℕ}\n\n/-- ★ **A MORTE SADIA GUARDA A LUZ**: se a morte é sadia (o lado guardado guarda toda solução) e havia\nsolução servindo o espectro, há solução servindo o espectro acrescentado da equação lida. -/\ntheorem a_morte_sadia_guarda_a_luz {n : ℕ} (φ : CNF n) (S : Espectro2 n) (a : Fin n → Bool) (v : ZMod 2)\n    (hsadia : morteSadia φ S a v)\n    (hcons : ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true) :\n    ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y (S ++ [(a, v)]) = true := by\n  obtain ⟨y, hy, hyserv⟩ := hcons\n  refine ⟨y, hy, ?_⟩\n  rw [serveEspectro2_append]\n  have hpar := hsadia y hy hyserv\n  have h1 : serveEspectro2 y [(a, v)] = true := by\n    unfold serveEspectro2\n    rw [List.all_cons, List.all_nil]\n    show ((paridade2 y a == v) && true) = true\n    rw [hpar]\n    simp\n  rw [h1]\n  simp [hyserv]\n\n/-- Dados uma solução que serve o espectro (`hcons`) e a unicidade do ponto que serve (`hunico`), a fórmula é\nsatisfazível. A conclusão já decorre de `hcons`; `hunico` não a fortalece. -/\ntheorem o_vvem_condicional {n : ℕ} (φ : CNF n) (S : Espectro2 n) (x : Fin n → Bool)\n    (hcons : ∃ y : Fin n → Bool, custoCNF φ y = 0 ∧ serveEspectro2 y S = true)\n    (hunico : ∀ y : Fin n → Bool, serveEspectro2 y S = true → y = x) :\n    SAT φ := by\n  obtain ⟨y, hy, hyserv⟩ := hcons\n  have hyx : y = x := hunico y hyserv\n  subst hyx\n  exact ⟨y, (custoCNF_zero_sse φ y).mp hy⟩\n\nend TGLExt.OProcessoFinal\n\n',
+    'TGLExt/ACompletude.lean': "import TGLExt.OProcessoFinal\n\nset_option autoImplicit false\nset_option maxHeartbeats 800000\n\n/-!\n# O laço final: o eco fiel e a luz guardada sob a hipótese nomeada\n\n## O que é\n\nO laço final (`lacoFinal`) desce fiel a partir do ponto dado; se o poço satisfaz a fórmula, responde com ele; se o eixo da\nmorte no poço está no span dos eixos já lidos (`eixoNoSpanB`, a checagem computável), para em silêncio; senão, registra no\nespectro a paridade OPOSTA à do poço nesse eixo e recomeça do ponto que o resolvedor construtivo devolve. O combustível\nlimita o número de voltas.\n\n## O que fica provado [REAL]\n\n1. `eixoNoSpanB_sadia`: se a checagem computável dispara, o eixo está no span dos eixos.\n2. ★ `o_eco_do_laco_final_e_fiel`: quando o laço responde com um ponto, esse ponto tem custo zero (é testemunha).\n3. ★ `o_laco_preserva_a_luz`: sob a hipótese nomeada `hgates` (em todo poço que não satisfaz e cujo eixo de morte está fora\n   do span, a morte com a paridade oposta é sadia), se o espectro inicial é servido por toda solução, todo espectro que o\n   laço alcança também é.\n4. `a_completude_condicional`: se uma solução serve o espectro e todo ponto que serve o espectro é `x`, então `x` é\n   solução. Este teorema não envolve o laço nem a hipótese `hgates`.\n\n## O que NÃO se afirma\n\n* Que o laço responda com eco quando há solução: ele pode parar em silêncio (eixo no span) ou esgotar o combustível; a\n  completude do laço segue [OPEN].\n* A hipótese `hgates` (a condição por morte em geral) não está provada.\n* Nada aqui diz que algum processo, ou a máquina de Turing, decida SAT em tempo polinomial. Isso segue [OPEN].\n* Nada sobre a natureza. O gate não se move.\n\nSem sorry, sem axioma novo.\n-/\n\nnamespace TGLExt.ACompletude\n\nopen TGLExt.TraducaoTuring TGLExt.ADescidaPinada TGLExt.AparedeDoPassoIngenuo TGLExt.ADescidaComEspectro\nopen TGLExt.AMorteEARessurreicao TGLExt.AContagemDasMortes TGLExt.OProcessoDaLuz TGLExt.OPassoFiel\nopen TGLExt.ARessurreicao TGLExt.AparedeDoSpan TGLExt.AFibraECoclasse TGLExt.ADualidade\nopen TGLExt.OSolverGF2 TGLExt.OSolverGF2_Parte2 TGLExt.OSolverGF2_Parte3 TGLExt.OSolverGF2_Parte4\nopen TGLExt.AVvem TGLExt.OProcessoFinal\n\nvariable {n : ℕ}\n\n/-- [DEF] A checagem do span, computável: o eixo é o xor de uma sub-lista dos eixos. -/\ndef eixoNoSpanB {n : ℕ} (axes : List (Fin n → Bool)) (a : Fin n → Bool) : Bool :=\n  axes.sublists.any (fun sub => decide (xorComb sub = a))\n\n/-- ★ A checagem computável é sadia: se ela dispara, o eixo está mesmo no span. (Auxiliar do processo; a\nvolta — a completude da checagem — é a invariância do xor por reordenação, nomeada.) -/\ntheorem eixoNoSpanB_sadia {n : ℕ} (axes : List (Fin n → Bool)) (a : Fin n → Bool) :\n    eixoNoSpanB axes a = true → eixoNoSpan axes a := by\n  unfold eixoNoSpanB eixoNoSpan\n  rw [List.any_eq_true]\n  intro h\n  obtain ⟨sub, hsub, hdec⟩ := h\n  exact ⟨sub, (List.mem_sublists.mp hsub).subset, by simpa using hdec⟩\n\n/-- [DEF] O laço final: desce fiel; se o poço satisfaz, o eco; senão, se o eixo da morte não é transversal,\no silêncio; senão, a morte no lado OPOSTO (a paridade flipada) e a ressurreição construída. Devolve o eco\n(ou o silêncio) e o espectro final, para a contagem. -/\ndef lacoFinal {n : ℕ} (φ : CNF n) :\n    ℕ → Espectro2 n → (Fin n → Bool) → (Option (Fin n → Bool)) × Espectro2 n\n  | 0, S, x => (if custoCNF φ x = 0 then some x else none, S)\n  | fuel + 1, S, x =>\n    let w := (descerGenerico passoFiel φ S φ.length ([], x)).2\n    if custoCNF φ w = 0 then (some w, S)\n    else\n      let a := eixoDaMorteDe φ w\n      let v := paridade2 w a + 1\n      if eixoNoSpanB (S.map Prod.fst) a then (none, S)\n      else lacoFinal φ fuel (S ++ [(a, v)]) (ressurreicaoConstrutiva (S ++ [(a, v)]))\n\n/-- ★ O eco do laço final é fiel por construção: responde só com ponto de altura zero. -/\ntheorem o_eco_do_laco_final_e_fiel {n : ℕ} (φ : CNF n) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x w : Fin n → Bool) (S' : Espectro2 n),\n      lacoFinal φ fuel S x = (some w, S') → custoCNF φ w = 0 := by\n  intro fuel\n  induction fuel with\n  | zero =>\n    intro S x w S' h\n    unfold lacoFinal at h\n    rw [Prod.mk.injEq] at h\n    obtain ⟨h1, -⟩ := h\n    split at h1\n    · rename_i hcond\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · simp at h1\n  | succ f ih =>\n    intro S x w S' h\n    unfold lacoFinal at h\n    dsimp only [] at h\n    split at h\n    · rename_i hcond\n      rw [Prod.mk.injEq] at h\n      obtain ⟨h1, -⟩ := h\n      have hw := Option.some.inj h1\n      subst hw\n      exact hcond\n    · split at h\n      · simp at h\n      · rename_i hcn hspan\n        exact ih _ _ _ _ h\n\n/-- ★ **O LAÇO PRESERVA A LUZ**: sob a morte sadia e a transversalidade em cada poço, todo espectro\nalcançado pelo laço guarda toda solução; e a solução servida inicial segue servida. -/\ntheorem o_laco_preserva_a_luz {n : ℕ} (φ : CNF n)\n    (hgates : ∀ (S : Espectro2 n) (w : Fin n → Bool),\n      custoCNF φ w ≠ 0 → ¬ (eixoNoSpanB (S.map Prod.fst) (eixoDaMorteDe φ w) = true) →\n      morteSadia φ S (eixoDaMorteDe φ w) (paridade2 w (eixoDaMorteDe φ w) + 1)) :\n    ∀ (fuel : ℕ) (S : Espectro2 n) (x : Fin n → Bool),\n      (∀ y : Fin n → Bool, custoCNF φ y = 0 → serveEspectro2 y S = true) →\n      ∀ y : Fin n → Bool, custoCNF φ y = 0 →\n        serveEspectro2 y (lacoFinal φ fuel S x).2 = true := by\n  intro fuel\n  induction fuel with\n  | zero => intro S x hguarda y hy; exact hguarda y hy\n  | succ f ih =>\n    intro S x hguarda y hy\n    unfold lacoFinal\n    dsimp only []\n    split\n    · rename_i hcond\n      exact hguarda y hy\n    · split\n      · exact hguarda y hy\n      · rename_i hcn hspan\n        -- a morte: a equação sadia guarda a luz\n        have hnova : ∀ y : Fin n → Bool, custoCNF φ y = 0 →\n            serveEspectro2 y (S ++ [(eixoDaMorteDe φ (descerGenerico passoFiel φ S φ.length ([], x)).2,\n                paridade2 (des
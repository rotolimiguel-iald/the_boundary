+def _v415_sumario_completo(text_):
+    """v415 -- every unnumbered section and subsection of the body without an entry in the summary gets one, with \\phantomsection
+    so that the PDF outline points at it; a title with a fragile command is refused visibly, never dropped in silence."""
+    import re as re_
+    head_ = re_.compile(r"\\(section|subsection)\*\{")
+    nxt_ = re_.compile(r"\\(?:part|section|subsection|subsubsection|paragraph)\*?\{")
+    i_ = max(text_.find("\\begin{document}"), 0)
+    out_ = [text_[:i_]]
+    while True:
+        m_ = head_.search(text_, i_)
+        if not m_:
+            out_.append(text_[i_:])
+            break
+        j_ = _v415_grupo(text_, m_.end())
+        if j_ is None:
+            raise ValueError("v415: a section title never closes (position %d)" % m_.start())
+        tit_ = text_[m_.end():j_ - 1]
+        n_ = nxt_.search(text_, j_)
+        seg_ = text_[j_:(n_.start() if n_ else len(text_))]
+        out_.append(text_[i_:j_])
+        if "\\addcontentsline{toc}" not in seg_:
+            if re_.search(r"\\\\|\\footnote|\\label|\\verb|\\cite|\\newline", tit_):
+                raise ValueError("v415: a title with a fragile command cannot enter the summary: %r" % tit_[:80])
+            out_.append("\\phantomsection\\addcontentsline{toc}{%s}{%s}" % (m_.group(1), tit_))
+        i_ = j_
+    return "".join(out_)

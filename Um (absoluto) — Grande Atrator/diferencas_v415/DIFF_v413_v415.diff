+    if reasons:
+        print("\n>>> SEAL_WITHHELD: %s -- nenhum selo exposto nesta rodada <<<" % " . ".join(reasons[:12]))
+        return False
+    os.replace(_v414_sidecar_tmp(), os.path.join(OUT, "um_absoluto_selo_acom.json"))
+    os.replace(_v414_seal_tmp(), os.path.join(OUT, "um_absoluto_selo.json"))

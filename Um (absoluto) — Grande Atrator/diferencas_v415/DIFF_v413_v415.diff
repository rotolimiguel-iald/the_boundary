+def _v414_verify_local(self_bytes, objs, folder, embedded, verify_witness, version, t0=None):
+    """The run checks its own fresh objects, on this disk, before showing the seal. Nothing is fetched."""
+    reasons = []
+    try:
+        seal = json.loads(objs["um_absoluto_selo.json"])
+        witness = {o["nome"]: o for o in json.loads(objs["um_absoluto_selo_acom.json"])["objetos"]}
+        pins = seal["sha256"]
+        formal = seal["formal_source_hash"]
+        if not isinstance(pins, dict):
+            raise TypeError("sha256")
+    except Exception as e:   # noqa: BLE001
+        return ["SEAL_MALFORMED:%s" % type(e).__name__]
+    if pins.get("um.py") != _v414_sha256(self_bytes):
+        reasons.append("KEY_IS_NOT_THIS_PROGRAM")
+    if formal != _v414_embedded_formal_hash(embedded):
+        reasons.append("FORMAL_HASH_IS_NOT_THE_EMBEDDED_ONE")
+    if set(pins) != set(_V414_SEAL_REQUIRED):
+        reasons.append("ARTIFACT_SET_IS_NOT_THE_CONTRACTS")
+    for name, pin in sorted(pins.items()):
+        if name == "um.py":
+            continue
+        if pin in ("MISSING_THIS_RUN", "NOT_THIS_RUN"):
+            reasons.append("ARTIFACT_NOT_THIS_RUN:" + name)
+            continue
+        try:
+            same = _v414_sha_path(os.path.join(folder, name)) == pin
+        except OSError:
+            same = False
+        if not same:
+            reasons.append("ARTIFACT_IS_NOT_THE_PINNED_ONE:" + name)
+        elif t0 is not None and os.path.getmtime(os.path.join(folder, name)) < t0:
+            reasons.append("ARTIFACT_NOT_PRODUCED_THIS_RUN:" + name)
+    if not reasons:
+        try:
+            doc = json.loads(objs["um_absoluto.json"])
+            reasons += _v414_cross_check(seal, doc, formal, version)
+            emitted = set(_v414_at(doc, "core", "figures", "emitted") or [])
+            reasons += ["FIGURE_NOT_EMITTED_THIS_RUN:" + n for n in sorted(pins) if n.startswith("fig_") and n not in emitted]
+        except Exception as e:   # noqa: BLE001
+            reasons.append("CORE_MALFORMED:%s" % type(e).__name__)
+    for name, data in (("um.py", self_bytes), ("um_absoluto.json", objs["um_absoluto.json"]),
+                       ("um_absoluto_selo.json", objs["um_absoluto_selo.json"])):
+        w = witness.get(name)
+        if not w:
+            reasons.append("SECOND_WITNESS_ABSENT:" + name)
+        elif w.get("sha256") != _v414_sha256(data):
+            reasons.append("FIRST_WITNESS_DIFFERS:" + name)
+        else:
+            try:
+                ok = verify_witness(data, w).get("ok") is True
+            except Exception:   # noqa: BLE001
+                ok = False
+            if not ok:
+                reasons.append("SECOND_WITNESS_DIFFERS:" + name)
+    return reasons

+def _v414_cross_check(seal, doc, formal, version):
+    """Seal, core and program must say the same thing: the fields are required, and an absence is a refusal."""
+    bad = []
+    rh, gate = seal.get("result_hash"), seal.get("qg_closure_verdict")
+    if not (isinstance(version, str) and version and seal.get("um_version") == version):
+        bad.append("VERSION_IS_NOT_THE_PROGRAMS")
+    if not (isinstance(rh, str) and len(rh) == 64 and set(rh) <= set("0123456789abcdef")):
+        bad.append("RESULT_HASH_ABSENT")
+    elif not (_v414_at(doc, "result_hash_before_external_comparison") == rh == _v414_at(doc, "verdict", "result_hash")):
+        bad.append("RESULT_HASH_IS_NOT_THE_CORES")
+    if not (isinstance(gate, str) and gate and _v414_at(doc, "core", "qg_closure", "gate", "verdict") == gate):
+        bad.append("GATE_IS_NOT_THE_CORES")
+    if _v414_at(doc, "core", "kernel_formalization", "formal_source_hash") != formal:
+        bad.append("FORMAL_HASH_IS_NOT_THE_CORES")
+    if seal.get("fail_closed_selftest") != "FAIL_CLOSED_SELFTEST_PASSED":
+        bad.append("SELFTEST_NOT_PASSED")
+    return bad
